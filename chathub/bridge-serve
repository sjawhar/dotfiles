#!/bin/bash
# Run one chat hub bridge: bridge-serve <instance>, where mautrix-<instance> is the
# binary and $STATE/<instance>/config.yaml was rendered by installers/chathub.sh.
set -euo pipefail

MISE="${DOTFILES_DIR:-$HOME/.dotfiles}/bin/mise"
export MISE_AUTO_INSTALL=0
export MISE_DATA_DIR="${MISE_DATA_DIR:-$HOME/.mise}"
STATE="${XDG_DATA_HOME:-$HOME/.local/share}/chathub"
name="${1:?usage: bridge-serve <instance>}"

# -n: the installer owns the config; the bridge must not rewrite it on startup.
cd "$STATE/$name"
exec "$MISE" exec -- "mautrix-$name" -c "$STATE/$name/config.yaml" -n
