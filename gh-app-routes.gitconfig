# Dynamic GitHub App credential routing.
# This file is included into git config only by agent launchers (cld/oc/omp),
# never by interactive shells. gh-app-token derives the owner from each
# credential request path (useHttpPath) and answers or quits for every
# owner-bearing github.com request: an owner with an App installation gets the
# installation token the secrets broker mints for it; an owner with no App
# installation gets a read-only token of the profile's read-owner, never a
# personal token. A push to such an owner does not ask this helper: shims/git
# runs it under the broker's GITHUB_PUBLIC_REPO_PAT with a one-shot helper of
# its own (dispatch://INFRA-2031). Any failure emits quit=1 so git stops
# instead of silently using the user's identity. Nothing is configured behind
# this helper.

[credential "https://github.com/"]
	helper =
	helper = !gh-app-token agent
