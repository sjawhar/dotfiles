{
  "cleanupPeriodDays": 14,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_METRICS_EXPORTER": "none",
    "OTEL_TRACES_EXPORTER": "none",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "https://agent-otel-public-6acxmql5za-uw.a.run.app",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "http/protobuf",
    "OTEL_EXPORTER_OTLP_LOGS_ENDPOINT": "https://agent-otel-public-6acxmql5za-uw.a.run.app/v1/logs",
    "OTEL_EXPORTER_OTLP_LOGS_PROTOCOL": "http/protobuf",
    "ENABLE_BETA_TRACING_DETAILED": "",
    "BETA_TRACING_ENDPOINT": "",
    "OTEL_LOG_USER_PROMPTS": "0",
    "OTEL_LOG_ASSISTANT_RESPONSES": "0",
    "OTEL_LOG_TOOL_DETAILS": "0",
    "OTEL_LOG_TOOL_CONTENT": "0",
    "OTEL_LOG_RAW_API_BODIES": "",
    "OTEL_EXPORTER_OTLP_HEADERS": "",
    "OTEL_EXPORTER_OTLP_TRACES_HEADERS": "",
    "OTEL_EXPORTER_OTLP_LOGS_HEADERS": "",
    "OTEL_EXPORTER_OTLP_METRICS_HEADERS": ""
  },
  "otelHeadersHelper": "h=\"$HOME/.config/agent-spend/otel-headers-helper\"; if [ -x \"$h\" ]; then exec \"$h\"; fi; echo '{}'",
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "jj root > /dev/null 2>&1 && jj st > /dev/null 2>&1; exit 0"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.dotfiles/scripts/claude-statusline"
  },
  "enabledPlugins": {
    "ralph-loop@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "notion-api@intellectronica-skills": true,
    "typescript-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "knives@knives": true,
    "gws-accounts@gws-accounts": true,
    "sjawhar@sjawhar": true,
    "claude-envoy@legion-plugins": true,
    "slack@claude-plugins-official": true,
    "ctx-memory@ctx-memory": true
  },
  "extraKnownMarketplaces": {
    "sjawhar": {
      "source": {
        "source": "github",
        "repo": "sjawhar/dotfiles"
      }
    },
    "knives": {
      "source": {
        "source": "github",
        "repo": "sjawhar/knives"
      }
    },
    "gws-accounts": {
      "source": {
        "source": "github",
        "repo": "sjawhar/gws-accounts"
      }
    },
    "legion-plugins": {
      "source": {
        "source": "github",
        "repo": "sjawhar/legion"
      }
    },
    "ctx-memory": {
      "source": {
        "source": "github",
        "repo": "sjawhar/ctx-memory",
        "ref": "v0.2.0"
      }
    }
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "skipAutoPermissionPrompt": true
}
