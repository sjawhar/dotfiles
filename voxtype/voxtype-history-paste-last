#!/bin/bash
# Paste the last voxtype transcription into the focused window.
set -euo pipefail

HISTORY_FILE="${XDG_DATA_HOME:-$HOME/.local/share}/voxtype/history.jsonl"
PASTE="${DOTFILES_DIR:-$HOME/.dotfiles}/voxtype/voxtype-paste"

if [ ! -f "$HISTORY_FILE" ]; then
    notify-send --app-name=Voxtype "No transcription history found"
    exit 0
fi

# Extract text from last JSONL entry
last=$(tail -n1 "$HISTORY_FILE" | jq -r '.text // empty')

if [ -z "$last" ]; then
    notify-send --app-name=Voxtype "History is empty"
    exit 0
fi

printf '%s' "$last" | "$PASTE"
