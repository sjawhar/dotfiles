#!/usr/bin/env python3
"""Tray indicator for voxtype recording state.

Monitors the voxtype daemon state file and provides:
- Visual state indication (idle/recording/transcribing)
- Stuck transcription detection (warns after 45s, auto-resets option)
- Force reset for recovering from hung states
- Paste Previous: the newest transcriptions, one click to paste one again
"""

import gi
import os
import subprocess
import sys
import threading
import signal
import time

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import voxtype_history  # noqa: E402

gi.require_version("Gtk", "3.0")
gi.require_version("AyatanaAppIndicator3", "0.1")
from gi.repository import AyatanaAppIndicator3, Gtk, GLib

DOTFILES_DIR = os.environ.get("DOTFILES_DIR", os.path.expanduser("~/.dotfiles"))
PASTE = os.path.join(DOTFILES_DIR, "voxtype/voxtype-paste")
RUNTIME_DIR = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")

STATE_FILE = os.path.join(RUNTIME_DIR, "voxtype", "state")
PID_FILE = os.path.join(RUNTIME_DIR, "voxtype", "pw-record.pid")
WAV_FILE = os.path.join(RUNTIME_DIR, "voxtype", "pw-record.wav")

# Seconds before warning that transcription is stuck
TRANSCRIBE_TIMEOUT_SECS = 45

# Transcriptions listed under Paste Previous, and the label length of each
PREVIOUS_COUNT = 10
PREVIOUS_LABEL_CHARS = 60

ICONS = {
    "idle": "audio-input-microphone-symbolic",
    "recording": "media-record-symbolic",
    # Deepgram streaming engine reports "streaming" while dictating
    "streaming": "media-record-symbolic",
    "transcribing": "emblem-synchronizing-symbolic",
    "error": "dialog-warning-symbolic",
}

LABELS = {
    "idle": "",
    "recording": "REC",
    "streaming": "REC",
    "transcribing": "...",
    "error": "ERR",
}


class VoxtypeTray:
    def __init__(self):
        self.indicator = AyatanaAppIndicator3.Indicator.new(
            "voxtype-tray",
            ICONS["idle"],
            AyatanaAppIndicator3.IndicatorCategory.APPLICATION_STATUS,
        )
        self.indicator.set_status(AyatanaAppIndicator3.IndicatorStatus.ACTIVE)
        self.indicator.set_label("", "")

        self.last_state = None
        self.transcribing_since = None
        self.stuck_notified = False
        self.history_stamp = None

        menu = Gtk.Menu()
        item_toggle = Gtk.MenuItem(label="Toggle Recording")
        item_toggle.connect("activate", self._toggle)
        menu.append(item_toggle)
        item_cancel = Gtk.MenuItem(label="Cancel Recording")
        item_cancel.connect("activate", self._cancel)
        menu.append(item_cancel)
        menu.append(Gtk.SeparatorMenuItem())
        item_retranscribe = Gtk.MenuItem(label="Retranscribe Last Recording")
        item_retranscribe.connect("activate", self._retranscribe_last)
        menu.append(item_retranscribe)
        item_paste_last = Gtk.MenuItem(label="Paste Last Transcription")
        item_paste_last.connect("activate", self._paste_last)
        menu.append(item_paste_last)
        item_previous = Gtk.MenuItem(label="Paste Previous")
        self.previous_menu = Gtk.Menu()
        item_previous.set_submenu(self.previous_menu)
        menu.append(item_previous)
        menu.append(Gtk.SeparatorMenuItem())
        item_reset = Gtk.MenuItem(label="Reset")
        item_reset.connect("activate", self._reset)
        menu.append(item_reset)
        menu.append(Gtk.SeparatorMenuItem())
        item_quit = Gtk.MenuItem(label="Quit Indicator")
        item_quit.connect("activate", lambda _: Gtk.main_quit())
        menu.append(item_quit)
        menu.show_all()
        self.indicator.set_menu(menu)

        self._refresh_previous()
        GLib.timeout_add(250, self._poll_state)

    def _poll_state(self):
        try:
            with open(STATE_FILE) as f:
                state = f.read().strip()
        except FileNotFoundError:
            state = "idle"

        # Track how long we've been in "transcribing" state
        if state == "transcribing":
            if self.transcribing_since is None:
                self.transcribing_since = time.monotonic()
                self.stuck_notified = False
            elif not self.stuck_notified:
                elapsed = time.monotonic() - self.transcribing_since
                if elapsed > TRANSCRIBE_TIMEOUT_SECS:
                    self._warn_stuck_transcription(elapsed)
        else:
            self.transcribing_since = None
            self.stuck_notified = False

        # Determine display state (show error icon if stuck)
        if self.stuck_notified:
            display_state = "error"
        else:
            display_state = state

        if display_state != self.last_state:
            self.last_state = display_state
            self.indicator.set_icon_full(
                ICONS.get(display_state, ICONS["idle"]), display_state
            )
            self.indicator.set_label(LABELS.get(display_state, ""), "")

        self._refresh_previous()
        return True

    def _refresh_previous(self):
        """Rebuild the Paste Previous submenu when the history file changes."""
        current = voxtype_history.stamp()
        if current == self.history_stamp:
            return
        self.history_stamp = current
        for child in self.previous_menu.get_children():
            self.previous_menu.remove(child)
        entries = voxtype_history.recent(PREVIOUS_COUNT)
        for ts, text in entries:
            snippet = voxtype_history.preview(text, PREVIOUS_LABEL_CHARS)
            item = Gtk.MenuItem(label=f"{voxtype_history.when(ts)} · {snippet}")
            item.connect("activate", self._paste_text, text)
            self.previous_menu.append(item)
        if not entries:
            empty = Gtk.MenuItem(label="No transcriptions yet")
            empty.set_sensitive(False)
            self.previous_menu.append(empty)
        self.previous_menu.show_all()

    def _warn_stuck_transcription(self, elapsed):
        """Send notification when transcription appears stuck."""
        self.stuck_notified = True
        secs = int(elapsed)
        subprocess.Popen([
            "notify-send", "--app-name=Voxtype",
            "--urgency=critical", "--expire-time=0",
            "Transcription Stuck",
            f"State has been 'transcribing' for {secs}s.\n"
            "The Deepgram stream may have hung.\n"
            "Use tray menu > Reset to recover.",
        ])

    def _toggle(self, _):
        subprocess.Popen([os.path.join(DOTFILES_DIR, "voxtype/voxtype-record"), "toggle"])

    def _cancel(self, _):
        subprocess.Popen([os.path.join(DOTFILES_DIR, "voxtype/voxtype-record"), "cancel"])

    def _retranscribe_last(self, _):
        subprocess.Popen([os.path.join(DOTFILES_DIR, "voxtype/voxtype-retranscribe-last")])

    def _paste_last(self, _):
        subprocess.Popen([os.path.join(DOTFILES_DIR, "voxtype/voxtype-history-paste-last")])

    def _paste_text(self, _, text):
        proc = subprocess.Popen([PASTE], stdin=subprocess.PIPE)
        proc.stdin.write(text.encode())
        proc.stdin.close()

    def _reset(self, _):
        """Full reset: kill orphan processes, restart PipeWire + BT, restart voxtype."""
        def _do_reset():
            GLib.idle_add(
                lambda: subprocess.Popen([
                    "notify-send", "--app-name=Voxtype", "--expire-time=3000",
                    "Resetting Voxtype", "Cleaning up, restarting audio stack...",
                ])
            )

            # Kill any orphaned pw-record processes
            try:
                result = subprocess.run(
                    ["pgrep", "-f", "pw-record.*voxtype/recordings"],
                    capture_output=True, text=True,
                )
                for pid in result.stdout.strip().split("\n"):
                    if pid:
                        try:
                            os.kill(int(pid), signal.SIGTERM)
                        except (ProcessLookupError, ValueError):
                            pass
            except FileNotFoundError:
                pass

            # Clean up runtime files
            for f in [PID_FILE, WAV_FILE]:
                try:
                    os.remove(f)
                except FileNotFoundError:
                    pass

            # Detect if default source is Bluetooth, grab the address
            bt_address = None
            try:
                result = subprocess.run(
                    ["pactl", "get-default-source"],
                    capture_output=True, text=True,
                )
                source = result.stdout.strip()
                if "bluez" in source:
                    parts = source.split(".")
                    if len(parts) >= 2:
                        bt_address = parts[1].replace("_", ":")
            except (FileNotFoundError, IndexError):
                pass

            # Stop voxtype
            subprocess.run(
                ["systemctl", "--user", "stop", "voxtype.service"],
                capture_output=True,
            )

            # Disconnect BT device so the reconnect gets a fresh handle
            if bt_address:
                subprocess.run(
                    ["bluetoothctl", "disconnect", bt_address],
                    capture_output=True, timeout=5,
                )
                time.sleep(1)

            # Restart PipeWire stack
            subprocess.run(
                ["systemctl", "--user", "restart",
                 "pipewire.service", "pipewire-pulse.service", "wireplumber.service"],
                capture_output=True,
            )
            time.sleep(2)

            # Reconnect BT device
            if bt_address:
                subprocess.run(
                    ["bluetoothctl", "connect", bt_address],
                    capture_output=True, timeout=10,
                )
                time.sleep(3)

            # Start voxtype
            subprocess.run(
                ["systemctl", "--user", "start", "voxtype.service"],
                capture_output=True,
            )

            self.transcribing_since = None
            self.stuck_notified = False
            detail = f"Reconnected {bt_address}." if bt_address else ""
            GLib.idle_add(
                lambda: subprocess.Popen([
                    "notify-send", "--app-name=Voxtype", "--expire-time=5000",
                    "Reset Complete",
                    f"Audio stack restarted, voxtype running. {detail}".rstrip(),
                ])
            )

        threading.Thread(target=_do_reset, daemon=True).start()


if __name__ == "__main__":
    signal.signal(signal.SIGINT, signal.SIG_DFL)
    VoxtypeTray()
    Gtk.main()
