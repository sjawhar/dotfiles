[pull]
        rebase = true
[alias]
    fc = ! "git fetch --prune --tags --prune-tags"
    gone = ! "git fc && git branch --format '%(refname:short) %(upstream:track)' | awk '$2 == \"[gone]\" {print $1}' | xargs git branch -D 2>/dev/null || true"
[fetch]
        prune = true
[init]
        defaultBranch = main
[push]
        autoSetupRemote = true

[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential

[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential
# Default identity. Matches jj's user.email so the two tools agree out of the
# box; per-repo overrides go through `git-identity cm`. Tools that commit with
# plain git (agent worktrees, scripts) inherit this, which is what keeps their
# commits signed and keeps jj from dropping the signature when it rewrites them.
[user]
	email = sami@trajectorylabs.net
	name = Sami Jawhar
# sjawhar/legion is public and commits as sami@thecybermonk.com: every clone of
# it, on every machine, is matched by its remote URL (`hasconfig:`, git 2.36+).
# jj's half of the rule is the repository scope in .jjconfig.toml; the two must
# agree, for the reason scripts/git-identity gives. A repo's own `git-identity`
# still wins. The path starts at ~ because git resolves a relative include path
# against ~/.gitconfig, the symlink, rather than this file.
[includeIf "hasconfig:remote.*.url:https://github.com/sjawhar/legion"]
	path = ~/.dotfiles/cybermonk-identity.gitconfig
[includeIf "hasconfig:remote.*.url:https://github.com/sjawhar/legion.git"]
	path = ~/.dotfiles/cybermonk-identity.gitconfig
[includeIf "hasconfig:remote.*.url:git@github.com:sjawhar/legion"]
	path = ~/.dotfiles/cybermonk-identity.gitconfig
[includeIf "hasconfig:remote.*.url:git@github.com:sjawhar/legion.git"]
	path = ~/.dotfiles/cybermonk-identity.gitconfig
[includeIf "hasconfig:remote.*.url:ssh://git@github.com/sjawhar/legion"]
	path = ~/.dotfiles/cybermonk-identity.gitconfig
[includeIf "hasconfig:remote.*.url:ssh://git@github.com/sjawhar/legion.git"]
	path = ~/.dotfiles/cybermonk-identity.gitconfig
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f

[credential]
	useHttpPath = true

[gh-app "agent"]
	app-id = 4943528
	key-secret = GH_AGENT_APP_PRIVATE_KEY_B64
	fallback-secret = GH_PUBLIC_REPO_PAT

# Commit signing, mirroring the jj setup in .jjconfig.toml: same key path, same
# allowed-signers file, so a commit verifies the same whether jj or plain git
# made it (agent worktrees, scripts, throwaway clones all use plain git).
#
# The key is per-machine but always at the same path, so this needs no
# machine-local override. A machine without the key fails to commit rather than
# committing unsigned -- same as jj, and the failure we want, since an unsigned
# commit under vigilant mode looks like impersonation.
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.dotfiles/jj-allowed-signers
[user]
	signingkey = ~/.ssh/jj-signing.pub
[commit]
	gpgsign = true
[tag]
	gpgsign = true
[safe]
	directory = *
[protocol "file"]
	allow = always
[http]
	postBuffer = 524288000
	lowSpeedLimit = 0
	lowSpeedTime = 999999
