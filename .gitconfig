[pull]
        rebase = true
[alias]
    fc = ! "git fetch --prune --tags --prune-tags"
    gone = ! "git fc && git branch --format '%(refname:short) %(upstream:track)' | awk '$2 == \"[gone]\" {print $1}' | xargs git branch -D 2>/dev/null || true"
[fetch]
        prune = true
[init]
        defaultBranch = main
[push]
        autoSetupRemote = true
# Shared boxes have 64 cores, and git grep's default (0) starts one thread per core.
[grep]
	threads = 8
# Paths no repository should ever track, for git and jj alike (jj reads core.excludesFile too).
# CodeGraph writes .codegraph/.gitignore holding `*` and `!.gitignore`, which leaves that one file
# visible, so jj's auto-track would snapshot it into the working change. A box sees this file and
# global.gitignore through its ~/.gitconfig and ~/.dotfiles mounts.
[core]
	excludesFile = ~/.dotfiles/global.gitignore

[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential

[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential
# Default identity. Matches jj's user.email so the two tools agree out of the
# box; per-repo overrides go through `git-identity cm|th`. Tools that commit with
# plain git (agent worktrees, scripts) inherit this, which is what keeps their
# commits signed and keeps jj from dropping the signature when it rewrites them.
[user]
	email = sami@trajectorylabs.net
	name = Sami Jawhar
# A repository's identity by rule: every clone of it, on every machine, is
# matched by its remote URL (`hasconfig:`, git 2.36+), and `/**` matches the rest
# of the URL, `.git` included. jj's half of each rule is a repository scope in
# .jjconfig.toml; the two must agree, for the reason scripts/git-identity gives.
# A repo's own `git-identity` still wins. The path starts at ~ because git
# resolves a relative include path against ~/.gitconfig, the symlink, rather
# than this file.
#
# Every theorem-labs repository commits as sami@theorem.dev.
[includeIf "hasconfig:remote.*.url:https://github.com/theorem-labs/**"]
	path = ~/.dotfiles/theorem-identity.gitconfig
[includeIf "hasconfig:remote.*.url:git@github.com:theorem-labs/**"]
	path = ~/.dotfiles/theorem-identity.gitconfig
[includeIf "hasconfig:remote.*.url:ssh://git@github.com/theorem-labs/**"]
	path = ~/.dotfiles/theorem-identity.gitconfig
# Every cybermonklabs repository is public and commits as sami@thecybermonk.com,
# never as sami@theorem.dev, which the leak check refuses there. The bracket
# classes match the organization name in any case, and the second https rule a
# URL with a user part (`user@`, `x-access-token:<token>@`). sjawhar/legion is
# cybermonklabs/legion's old name, which a clone's remote can still have. These
# come after the theorem-labs rules: where two includes set user.email the later
# one wins, so a checkout with a remote in both organizations commits as
# cybermonk. git has no condition on a remote's pushurl, so a checkout that
# fetches from theorem-labs and pushes to cybermonklabs commits as
# sami@theorem.dev; the leak check's scan of author and committer lines
# (dispatch://INFRA-4943) is what refuses its push.
[includeIf "hasconfig:remote.*.url:https://github.com/[Cc][Yy][Bb][Ee][Rr][Mm][Oo][Nn][Kk][Ll][Aa][Bb][Ss]/**"]
	path = ~/.dotfiles/cybermonk-identity.gitconfig
[includeIf "hasconfig:remote.*.url:https://*@github.com/[Cc][Yy][Bb][Ee][Rr][Mm][Oo][Nn][Kk][Ll][Aa][Bb][Ss]/**"]
	path = ~/.dotfiles/cybermonk-identity.gitconfig
[includeIf "hasconfig:remote.*.url:git@github.com:[Cc][Yy][Bb][Ee][Rr][Mm][Oo][Nn][Kk][Ll][Aa][Bb][Ss]/**"]
	path = ~/.dotfiles/cybermonk-identity.gitconfig
[includeIf "hasconfig:remote.*.url:ssh://git@github.com/[Cc][Yy][Bb][Ee][Rr][Mm][Oo][Nn][Kk][Ll][Aa][Bb][Ss]/**"]
	path = ~/.dotfiles/cybermonk-identity.gitconfig
[includeIf "hasconfig:remote.*.url:https://github.com/sjawhar/legion"]
	path = ~/.dotfiles/cybermonk-identity.gitconfig
[includeIf "hasconfig:remote.*.url:https://github.com/sjawhar/legion.git"]
	path = ~/.dotfiles/cybermonk-identity.gitconfig
[includeIf "hasconfig:remote.*.url:git@github.com:sjawhar/legion"]
	path = ~/.dotfiles/cybermonk-identity.gitconfig
[includeIf "hasconfig:remote.*.url:git@github.com:sjawhar/legion.git"]
	path = ~/.dotfiles/cybermonk-identity.gitconfig
[includeIf "hasconfig:remote.*.url:ssh://git@github.com/sjawhar/legion"]
	path = ~/.dotfiles/cybermonk-identity.gitconfig
[includeIf "hasconfig:remote.*.url:ssh://git@github.com/sjawhar/legion.git"]
	path = ~/.dotfiles/cybermonk-identity.gitconfig
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f

[credential]
	useHttpPath = true

[gh-app "agent"]
	app-id = 4943528
	broker-secret = GITHUB_APP_SJAWHAR
	fallback-secret = GH_PUBLIC_REPO_PAT

# Commit signing, mirroring the jj setup in .jjconfig.toml: same key path, same
# allowed-signers file, so a commit verifies the same whether jj or plain git
# made it (agent worktrees, scripts, throwaway clones all use plain git).
#
# The key is per-machine but always at the same path, so this needs no
# machine-local override. A machine without the key fails to commit rather than
# committing unsigned -- same as jj, and the failure we want, since an unsigned
# commit under vigilant mode looks like impersonation.
#
# Signing reads the key file and never needs the ssh agent: git runs ssh-keygen
# by name, and shims/ssh-keygen drops SSH_AUTH_SOCK for -Y, so a stuck agent
# socket cannot hang a signed commit.
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.dotfiles/jj-allowed-signers
[user]
	signingkey = ~/.ssh/jj-signing.pub
[commit]
	gpgsign = true
[tag]
	gpgsign = true
[safe]
	directory = *
[protocol "file"]
	allow = always
[http]
	postBuffer = 524288000
	lowSpeedLimit = 0
	lowSpeedTime = 999999
# The shared public leak check on every push (dispatch://BET-706 R6): this file, written last by
# the leak check's install-global-hooks.sh (devbox/sami-devbox-provision, step prepush), sets
# core.hooksPath to its global hooks dispatcher. That runs the check on a pre-push to any URL with
# a host, then the repository's own hook of every name. A repository's own core.hooksPath still
# wins (shims/git checks an agent session's push from one). git ignores a missing include, so a
# machine without the install is unchanged; `install-global-hooks.sh --remove` turns it off.
[include]
	path = ~/.local/share/public-leak-check-hooks/global.gitconfig
