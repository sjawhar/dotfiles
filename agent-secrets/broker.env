# The secrets broker (AGENTC-393), the one place its default URL is written. The helper's unit reads
# this file (EnvironmentFile); scripts/agent-secrets-session, scripts/secret-run,
# scripts/agent-secrets-login, scripts/agentbox and .bashrc source it when AGENT_SECRETS_URL is unset.
AGENT_SECRETS_URL=https://secrets.internal.trajectorylabs.com
