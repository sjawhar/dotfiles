#!/bin/bash
# agent-secrets/agent-secrets-helper: the unit's ExecStart. mise owns the binary (mise.toml
# [tools.agent-secrets]); `mise exec` resolves the pin at start, so a bump takes effect at the
# next restart — which the installer performs only when no host session is registered.
set -euo pipefail

MISE="${DOTFILES_DIR:-$HOME/.dotfiles}/bin/mise"
export MISE_AUTO_INSTALL=0
export MISE_DATA_DIR="${MISE_DATA_DIR:-$HOME/.mise}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
exec "$MISE" exec agent-secrets -- agent-secrets-helper serve
