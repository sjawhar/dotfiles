[Unit]
Description=agent-secrets helper: pins host agent sessions by pidfd and signs their secrets-broker proofs (installers/agent-secrets.sh)

[Service]
ExecStart=%h/.dotfiles/agent-secrets/agent-secrets-helper
# The production broker (broker.env, its one home); a machine-local file overrides it (a local
# broker for development), KEY=value lines.
EnvironmentFile=%h/.dotfiles/agent-secrets/broker.env
EnvironmentFile=-%h/.config/agent-secrets/env.local
# A restart keeps the enrollment and the grants of a live session that the running helper
# recorded with its key (a session registered with --session-id). It revokes those of every other
# live session. installers/agent-secrets.sh tells the cases, and refuses to restart while sessions
# are registered unless AGENT_SECRETS_HELPER_RESTART_WITH_SESSIONS=1.
# The machine login is kept in ~/.config/agent-secrets/machine.json (0600) and resumed at start,
# so a restart needs no new approval. The helper serves with or without a launcher credential
# (every launcher-route call answers "run: agent-secrets machine login" until one exists), so it
# never exits for want of one. A SIGTERM from anything but systemd (a test rig's
# `pkill -f "agent-secrets-helper serve"` matches this helper too) stops it cleanly with exit 0,
# which on-failure would leave stopped, so it restarts whenever it exits unless systemd itself
# stopped it.
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
