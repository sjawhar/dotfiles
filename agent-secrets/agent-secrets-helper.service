[Unit]
Description=agent-secrets helper: pins host agent sessions by pidfd and signs their secrets-broker proofs (installers/agent-secrets.sh)

[Service]
ExecStart=%h/.dotfiles/agent-secrets/agent-secrets-helper
# The production broker; a machine-local file overrides it (a local broker for development), KEY=value lines.
Environment=AGENT_SECRETS_URL=https://secrets.internal.trajectorylabs.com
EnvironmentFile=-%h/.config/agent-secrets/env.local
# Session keys live in this process only: a restart re-pins live sessions with fresh keys and
# revokes their old enrollments (grants go with them). installers/agent-secrets.sh refuses to
# restart while sessions are registered unless AGENT_SECRETS_HELPER_RESTART_WITH_SESSIONS=1.
# The helper always serves, with or without a launcher credential: every launcher-route call
# just answers "run: agent-secrets launcher login" until one exists. Restart=on-failure only
# matters for a genuine crash now.
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
