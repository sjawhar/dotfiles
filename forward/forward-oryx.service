[Unit]
Description=Forward daemon and Cloudflare Access connection for oryx
# Sami runs: systemctl --user status|restart forward-oryx
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=0

[Service]
EnvironmentFile=%h/.config/forward/tunnel-oryx.env
RuntimeDirectory=%N
RuntimeDirectoryMode=0700
ExecStart=%h/.dotfiles/forward/forward-oryx
Restart=always
RestartSec=5
TimeoutStopSec=10

[Install]
WantedBy=graphical-session.target
