#!/bin/bash
set -euo pipefail

MISE="${DOTFILES_DIR:-$HOME/.dotfiles}/bin/mise"
export MISE_AUTO_INSTALL=0
export MISE_DATA_DIR="${MISE_DATA_DIR:-$HOME/.mise}"

# Loopback CDP facade for the Chrome profile. The laptop's `forward` listener
# accepts only a `RELAY <token>` prefix; a session grant's devbox-local proxy
# supplies it. The extension dials ws://127.0.0.1:9224/ext itself. The relay
# exposes every tab and enforces no browser-side access boundary.
exec "$MISE" exec "github:sjawhar/oh-my-pi" -- omp browser-relay --port 9224
