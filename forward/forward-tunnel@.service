[Unit]
Description=SSH tunnel carrying forward's channels to the %i devbox (off the tailnet)
# One per pair whose laptop daemon listens on loopback; installers/forward.sh
# enables it beside forward-daemon@%i. The forwards live in Host %i-tunnel
# (~/.ssh/config.local); the login key is the 1Password agent's (Host *), so a
# reconnect waits for 1Password to be unlocked. It stops and starts with the
# graphical session, as forward-daemon@.service does.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
# ssh exits when the server sends no greeting within 30 s (ConnectTimeout), a
# forward cannot bind (ExitOnForwardFailure) or the link goes quiet
# (ServerAlive), and systemd reconnects. Without ConnectTimeout, an sshd that
# accepts TCP but never sends its greeting holds ssh with no time limit, so the
# tunnel never reconnects. A reconnect after a dead link fails until the devbox's
# sshd reaps the old session's ports, then succeeds.
ExecStart=/usr/bin/ssh -o ConnectTimeout=30 -N %i-tunnel
Restart=always
RestartSec=10

[Install]
WantedBy=graphical-session.target
