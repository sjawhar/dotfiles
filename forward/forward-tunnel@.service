[Unit]
Description=SSH tunnel carrying forward's channels to the %i devbox (off the tailnet)
# One per pair whose laptop daemon listens on loopback; installers/forward.sh
# enables it beside forward-daemon@%i. The forwards and the key live in
# Host %i-tunnel (laptop/ssh-config). It stops and starts with the graphical
# session, as forward-daemon@.service does.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
# ssh exits when a forward cannot bind (ExitOnForwardFailure) or the link goes
# quiet (ServerAlive), and systemd reconnects. A reconnect after a dead link
# fails until the devbox's sshd reaps the old session's ports, then succeeds.
ExecStart=/usr/bin/ssh -N %i-tunnel
Restart=always
RestartSec=10

[Install]
WantedBy=graphical-session.target
