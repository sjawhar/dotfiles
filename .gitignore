# local-only secrets (never committed; `secrets` reads these on top of the
# committed files in the same root)
secrets.local.env
secrets.human.d/*.local.env

# Planning artifacts stay local-only — never committed
docs/superpowers/

# Private secrets repo (its own git repo, never part of dotfiles)
.secrets/
omp/models.local.yml
# No longer read; ignored so a copy left on a machine is never snapshotted or committed.
envoy/env.local
# cosmic-config writes each setting through a temp directory beside it
# (atomicwrites), which lands in laptop/cosmic/ while COSMIC saves
laptop/cosmic/**/.atomicwrite*
