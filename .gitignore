# Eval case data — session-derived, contains verbatim messages, tool output, and
# third-party names. This repo is PUBLIC and jj auto-snapshots, so there is no
# commit moment to gate: the bodies live outside the tree entirely
# (~/.local/share/skill-evals/). These entries are the backstop for a stray copy.
**/skill-evals/cases*.jsonl
**/skill-evals/data/
**/skill-evals/**/*.eval
**/skill-evals/results*.jsonl
**/skill-evals/judged*.jsonl
**/skill-evals/baseline-*/
/.opencode-profiles/

.sisyphus/
.omo/
.tmux-workspace/

/ignore
.opencode/skills/fork-maintenance-skill-*/
.overseer/
.playwright-mcp/
.superpowers
omp/plugins/node_modules
opencode/node_modules/

# local-only secrets (never committed; `secrets` reads these on top of the
# committed files in the same root)
secrets.local.env
secrets.human.d/*.local.env

# Planning artifacts stay local-only — never committed
docs/superpowers/

# Private secrets repo (its own git repo, never part of dotfiles)
.secrets/
