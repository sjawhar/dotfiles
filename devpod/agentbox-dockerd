#!/bin/bash
# Start the box's inner dockerd (root, via sudo from /usr/local/bin/docker).
# setsid detaches the daemon from the caller's process group: the first
# `docker` call often comes from an omp tool subprocess, and a tool timeout
# kills that whole group — the daemon must survive it. Idempotent: a daemon
# that already answers means another caller won the race under the wrapper's
# lock, and there is nothing to do.
#
# The box's own processes reach the EC2 metadata forwarder on the host
# (AWS_EC2_METADATA_SERVICE_ENDPOINT); containers the box starts must not, or
# a sandbox running task content would hold the instance role. Container
# traffic leaves through FORWARD, where Docker consults DOCKER-USER first; the
# box's processes use OUTPUT and are unaffected. The forwarder address arrives
# as $1 because sudo does not forward the environment.
set -euo pipefail

forwarder="${1:-}"
[[ -n "$forwarder" ]] || { echo "agentbox-dockerd: forwarder host:port required" >&2; exit 1; }

/usr/bin/docker info >/dev/null 2>&1 && exit 0

mkdir -p /var/log
setsid /usr/bin/dockerd --host=unix:///var/run/docker.sock >/var/log/dockerd.log 2>&1 </dev/null &

for _ in $(seq 1 60); do
    /usr/bin/docker info >/dev/null 2>&1 && break
    sleep 0.5
done
if ! /usr/bin/docker info >/dev/null 2>&1; then
    echo "agentbox-dockerd: inner dockerd did not start within 30s" >&2
    tail -30 /var/log/dockerd.log >&2
    exit 1
fi

iptables -I DOCKER-USER -d "${forwarder%:*}" -p tcp --dport "${forwarder##*:}" -j DROP
# Sessions run as uid 1000; the socket is created root:root 660 before the
# docker group exists on it, so open it to the box.
chmod 666 /var/run/docker.sock
