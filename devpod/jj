#!/bin/bash
# In-box jj wrapper (box-only; the session PATH puts /usr/local/bin ahead of
# every real jj): record every successful `jj workspace add` so the host
# launcher can clean the workspace up when the box exits and recreate it on
# --resume (scripts/agentbox). `knives start` invokes jj through PATH, so its
# workspaces are recorded too. Every other invocation execs the real jj
# untouched.
set -euo pipefail

# The real jj is whatever the rest of PATH resolves — a local build in
# $DOTFILES_DIR/bin wins over the mise shim, exactly as on the host; only this
# wrapper's own directory is skipped.
self_dir="$(cd "$(dirname "$0")" && pwd)"
REAL_JJ=""
IFS=: read -ra _dirs <<<"$PATH"
for _d in "${_dirs[@]}"; do
    [[ -z "$_d" || "$_d" == "$self_dir" ]] && continue
    [[ -x "$_d/jj" ]] && { REAL_JJ="$_d/jj"; break; }
done
[[ -n "$REAL_JJ" ]] || { echo "agentbox jj: no real jj on PATH" >&2; exit 127; }

# Only a session's own `workspace add` is recorded: no session id, or an
# ephemeral --no-session run, means nothing will ever resume it.
if [[ -z "${OMP_SESSION_ID:-}" || -n "${AGENTBOX_EPHEMERAL:-}" ]]; then
    exec "$REAL_JJ" "$@"
fi

# Collect positional arguments, skipping the value of every value-taking flag
# that can appear around `workspace add` (jj's global -R/--repository,
# --at-op/--config/--color, and add's own -r/--revision, --name,
# --sparse-patterns). The first two positionals name the subcommand; the third
# is DEST.
positional=()
name=""
repo_flag=""
skip_for=""
for a in "$@"; do
    if [[ -n "$skip_for" ]]; then
        case "$skip_for" in
            name) name="$a" ;;
            repo) repo_flag="$a" ;;
        esac
        skip_for=""
        continue
    fi
    case "$a" in
        --name) skip_for=name ;;
        --name=*) name="${a#--name=}" ;;
        -R|--repository) skip_for=repo ;;
        --repository=*) repo_flag="${a#--repository=}" ;;
        -r|--revision|--sparse-patterns|--at-op|--at-operation|--color|--config|--config-file) skip_for=value ;;
        -*) ;;
        *) positional+=("$a") ;;
    esac
done

if [[ "${positional[0]:-}" != workspace || "${positional[1]:-}" != add || -z "${positional[2]:-}" ]]; then
    exec "$REAL_JJ" "$@"
fi

# Run the add first: only a workspace that was actually created is recorded.
"$REAL_JJ" "$@"

path="$(realpath -m "${positional[2]}")"
jj_root=("$REAL_JJ" root)
[[ -n "$repo_flag" ]] && jj_root=("$REAL_JJ" -R "$repo_flag" root)
root="$("${jj_root[@]}")"
# `jj root` is the root of the workspace jj ran from. A workspace created
# from inside another one is still recorded against the main repo, since that
# is what outlives the creating workspace at close (its own .jj/repo is a
# directory; a secondary workspace's .jj/repo is a file naming it).
repo="$root"
if [[ -f "$root/.jj/repo" ]]; then
    repo_store="$(<"$root/.jj/repo")"
    [[ "$repo_store" == /* ]] || repo_store="$root/.jj/$repo_store"
    repo="$(dirname "$(dirname "$(realpath -m "$repo_store")")")"
fi
[[ -n "$name" ]] || name="$(basename "$path")"
# Identity of the workspace just created (inode and birth time of its .jj):
# the launcher's close phase removes the directory only while it still
# matches, so a workspace another session put at the same path later is
# never touched. Same format as cleanup_workspaces in scripts/agentbox.
ident="$(stat -c '%i:%.9W' "$path/.jj")"

state_dir="$HOME/.local/state/agentbox"
mkdir -p "$state_dir/sessions" "$state_dir/boxes"
printf '%s\t%s\t%s\t%s\n' "$repo" "$name" "$path" "$ident" >>"$state_dir/sessions/$OMP_SESSION_ID.workspaces"
# Breadcrumb so the launcher's close phase can find this session's workspaces
# file even for a session it launched fresh (it never learns the omp id).
[[ -n "${AGENTBOX_BOX:-}" ]] && printf '%s\n' "$OMP_SESSION_ID" >"$state_dir/boxes/$AGENTBOX_BOX"
exit 0
