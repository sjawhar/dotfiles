# Shared host paths under $HOME. One <rw|ro> <relative path> per line.
# AgentBox segregates sessions, not host access. Shared state is writable.
# A missing rw directory is created. Missing config files and ro entries are skipped.
# Own-host GitHub and Azure config stays visible. App/machine defaults and approvals stay intact.
# SSH state is shared. Docker state is copied whole into the box's private home.
# Tools that use the keyring reach it through the relayed session bus.

# omp: sessions, memory, settings
rw .omp
rw .config/omp
rw .cache/omp
# Native user skills (the pinned GitHub CLI skill lives here).
rw .agents


# Share unit-file state without starting, stopping, or enabling any service.
rw .config/systemd/user

# the pinned tool store and language caches
rw .mise
rw .cache/mise
rw .config/mise
rw .bun
rw .npm
rw .cache/uv
rw .local/share/uv
rw .cargo
rw .rustup
rw .cache/ms-playwright
# hawk-token's private agent-c checkout (scripts/hawk-token): one clone on the host,
# refreshed by whichever run finds it stale, shared by every box
rw .cache/hawk-token
# the public leak check's visibility cache (one file per repository: public, private or internal).
# shims/git reads it to decide whether a jj push needs the check, and the check writes each
# visibility it reads through gh into it, from inside a box as on the host, so it is rw.
rw .cache/public-leak-check
# The OSS Verify N6 farm's run index (bin/ossv-n6-farm, N6_RUN_INDEX): one file per run naming the
# work root its directory is in. `collect`, `peaks` and `clean` of a run find it here, often from
# another session than the one that staged it, so it outlives a box.
rw .cache/ossv-n6-runs

# cloud access (AWS by design)
rw .aws
rw .kube
rw .pulumi
# Each box sees its own host's Google SDK and complete configuration unchanged.
# The default credential route remains the machine identity.
rw .gcloud
rw .config/gcloud
# Azure's default agent route uses the machine identity. User-login grants retain
# their separate authorization. The machine identity refreshes this config.
rw .azure-box-identity
rw .azure
rw .config/agent-azure

# work identities agents use (a customer platform's client config is in the private part of this
# list, .secrets/dotfiles/agentbox/mounts, so its name stays out of this public repository)
rw .config/trajectory-labs
rw .config/gws
rw .config/gh
rw .config/knives
rw .cache/knives
rw .config/opencode
rw .claude
rw .codex
rw .local/bin
rw .mcp-auth
rw .pcscd

# tool logins the CLI itself maintains (each rewrites its file: pup its site
# registry, sentry its sqlite journal, depot its update state, mailbox its
# thread refs, token cache and compose drafts, ant its profiles and credentials,
# vercel its auth, config and telemetry files)
rw .fleet
rw .sentry
rw .config/depot
rw .config/pup
rw .config/anthropic
rw .cache/mailbox
rw .local/share/com.vercel.cli

# configuration
rw .config/forward
rw .config/jj
rw .config/secretsd
rw .config/sops
rw .config/ctx
rw .config/mailbox
# the model-spend setup's endpoint, tags and session files (installers/agent-spend.sh), so box sessions export too
rw .config/agent-spend
# the transcript store's endpoint and reader/writer logins, so `tq` and the audits that read it work in a box
rw .config/transcript-store
# the grading farm's machine-local paths (installers/grade-farm.sh), so `farm` in a box given
# --dir for farm-pkg, grade-farm and boxid under /mnt/nvme/<user> uses the host's farm root and key
rw .config/grade-farm
# Dispatch and Envoy: envoy.json, which a box session without a profile of its
# own reads, and a profile's own envoy.json may link to (envoy/AGENTS.md)
rw .config/legion
rw .npmrc
rw .gitconfig
# Host SSH identities, pins, configuration, and GnuPG state are not filtered.
rw .ssh
rw .gnupg

# The public-text leak check `shims/gh` demands before `gh pr edit|create|comment`. This entry is
# the POINTER, `path`, holding the script's absolute path; the script itself lives on /mnt/nvme,
# outside every box, so `agentbox move` adds the directory holding it to a session's spec
# (move_config_dirs in scripts/agentbox). Without both, every public text write from a box is
# refused and a lead cannot work in one (dispatch://INFRA-702, 2026-11-01).
rw .config/public-leak-check
# The host-local public-text check, when its pointer names this home path.
rw .local/share/public-leak-check
