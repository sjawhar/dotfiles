# What an agent box sees of $HOME, and nothing more. scripts/agentbox binds
# each entry at its own path; `agentbox doctor` checks every entry from inside
# a box. One entry per line: <rw|ro> <path relative to $HOME>. Blank lines and
# # comments are ignored. A missing path is created (rw) or skipped (ro), so
# the list is the same on every machine.
#
# rw: state the session writes. ro: configuration.
#
# The rule for a tool login: a CLI's own login state is fine here when the box
# needs that CLI (fleetctl, sentry, depot, pup, ant, vercel); an identity that can act as
# the user on GitHub never is - no ~/.config/gh, no ssh keys, no docker login
# - so a session pushes only as its repo's GitHub App. Tools that keep their
# login in the keyring (hawk, pup's tokens, gws) need nothing here: the
# session bus is relayed into the box.

# omp: sessions, memory, settings
rw .omp
rw .config/omp
rw .cache/omp

# the pinned tool store and language caches
rw .mise
rw .cache/mise
rw .config/mise
rw .bun
rw .npm
rw .cache/uv
rw .local/share/uv
rw .cargo
rw .rustup
rw .cache/ms-playwright
# hawk-token's private agent-c checkout (scripts/hawk-token): one clone on the host,
# refreshed by whichever run finds it stale, shared by every box
rw .cache/hawk-token
# the public leak check's visibility cache (one file per repository: public, private or internal).
# shims/git reads it to decide whether a jj push needs the check, and the check writes each
# visibility it reads through gh into it, from inside a box as on the host, so it is rw.
rw .cache/public-leak-check

# cloud access (AWS by design)
rw .aws
rw .kube
rw .pulumi
# Google Cloud. The SDK install is read-only: gcloud writes only under its config dir, which is
# the next entry, and ~/.local/bin/gke-gcloud-auth-plugin is a symlink into this tree, so without
# it kubectl cannot get a GKE credential at all (dispatch://INFRA-702, a box where
# `gcloud auth list` answered "real gcloud binary not found" and the build pool was unreachable).
# The config dir is the machine's gcloud identity, not a user login: its active configuration is
# `box`, whose account is the keyless external_account dev-<name>@theorem-agent-infra that gcloud
# exchanges for a token through the metadata relay the box already has. agent-c's deploy.py also
# requires a file in it (agent-devbox-wif-adc.json), which a box now writes where the host keeps
# it instead of into an overlay that dies with the box.
ro .gcloud
rw .config/gcloud
# Azure. The machine's own identity, which shims/az gives every agent session in place of the
# user's ~/.azure login (that one is never mounted). `az login --identity` writes the profile
# and refreshes tokens in it, so it is rw.
rw .azure-box-identity

# work identities agents use (a customer platform's client config is in the private part of this
# list, .secrets/dotfiles/agentbox/mounts, so its name stays out of this public repository)
rw .config/trajectory-labs
rw .config/gws
rw .config/knives
rw .cache/knives
rw .config/opencode
rw .claude
rw .codex
rw .local/bin
rw .mcp-auth
rw .pcscd

# tool logins the CLI itself maintains (each rewrites its file: pup its site
# registry, sentry its sqlite journal, depot its update state, mailbox its
# thread refs, token cache and compose drafts, ant its profiles and credentials,
# vercel its auth, config and telemetry files)
rw .fleet
rw .sentry
rw .config/depot
rw .config/pup
rw .config/anthropic
rw .cache/mailbox
rw .local/share/com.vercel.cli

# configuration
ro .config/forward
ro .config/jj
ro .config/secretsd
ro .config/sops
ro .config/ctx
ro .config/mailbox
# the model-spend setup's endpoint, tags and session files (installers/agent-spend.sh), so box sessions export too
ro .config/agent-spend
# the transcript store's endpoint and reader/writer logins, so `tq` and the audits that read it work in a box
ro .config/transcript-store
# Dispatch and Envoy: envoy.json, which a box session without a profile of its
# own reads, and a profile's own envoy.json may link to (envoy/AGENTS.md)
ro .config/legion
ro .npmrc
ro .gitconfig
ro .ssh/jj-signing
ro .ssh/jj-signing.pub
# The Google Compute Engine ssh key gcloud makes and uses for `gcloud compute ssh`
# (dispatch://INFRA-702). It is a GCE key, not a GitHub identity: Google's guest agent puts its
# public half in the project or instance metadata, and sshd on a Compute Engine VM is the only
# thing that accepts it. The box already holds the gcloud identity that may read and write that
# metadata (`rw .config/gcloud`), so the key adds no access the box did not have - it only saves
# gcloud from making a second key per box, which would write a new public key into the project
# metadata on every launch. GitHub never sees it: `~/.ssh` as a whole is still not mounted, and
# a push from a box is still the repo's GitHub App over https.
ro .ssh/google_compute_engine
ro .ssh/google_compute_engine.pub

# The public-text leak check `shims/gh` demands before `gh pr edit|create|comment`. This entry is
# the POINTER, `path`, holding the script's absolute path; the script itself lives on /mnt/nvme,
# outside every box, so `agentbox move` adds the directory holding it to a session's spec
# (move_config_dirs in scripts/agentbox). Without both, every public text write from a box is
# refused and a lead cannot work in one (dispatch://INFRA-702, 2026-11-01).
ro .config/public-leak-check
