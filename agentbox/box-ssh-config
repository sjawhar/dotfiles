#!/bin/bash
# The ssh entries a box needs for the other machines of this tailnet, written at box start
# (agentbox/entrypoint.sh). A box has the key and the pinned known_hosts for sami-rocqperf
# (agentbox/mounts) but no entry that names the user, the port and those files, so `ssh
# sami-rocqperf` from a box connected as the box user on port 22 and was refused (the cost
# tracking lead's box on sami-devbox, 2026-11-03 15:04Z); and `ssh sami-devbox` from a box was
# refused on its host key, since a box has no known_hosts of its own (VERIFY, 19:26Z).
#
#   box-ssh-config <home> [owner]
#
# With AGENTBOX_SSH_SHARED=1, write defaults only under the box's system SSH
# directory. Read host keys and pins without changing host files. Unpinned
# first-contact keys use the box's private runtime directory. Otherwise write
# defaults under the private home too. Existing entries are not replaced.
set -uo pipefail
home="${1:-$HOME}"
owner="${2:-}"
# <machine>:<port>. sami-rocqperf and sami-leanperf answer on 443 (dispatch://INFRA-734).
hosts=("sami-rocqperf:${AGENTBOX_SSH_PORT:-443}" "sami-leanperf:${AGENTBOX_SSH_PORT:-443}" "sami-devbox:22")
user="${AGENTBOX_SSH_USER:-sami}"
system="${AGENTBOX_SSH_SYSTEM_DIR:-/etc/ssh/ssh_config.d}"
shared="${AGENTBOX_SSH_SHARED:-0}"
config_dir="$home/.ssh/config.d"
prefix=""
config_mode=600
fallback="$home/.ssh/known_hosts.agentbox"
if [[ "$shared" == 1 ]]; then
    # Host SSH state is available to the session, but startup must not rewrite it.
    config_dir="$system"
    prefix=50-agentbox-
    config_mode=644
    runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/agentbox-ssh"
    mkdir -p "$config_dir" "$runtime" || exit 1
    chmod 700 "$runtime"
    [[ -z "$owner" ]] || chown "$owner:$owner" "$runtime" 2>/dev/null || true
    fallback="$runtime/known_hosts"
else
    mkdir -p "$config_dir" || exit 1
    [[ -z "$owner" ]] || chown "$owner:$owner" "$home/.ssh" "$config_dir" 2>/dev/null || true
fi
for entry in "${hosts[@]}"; do
    h="${entry%%:*}"
    port="${entry##*:}"
    key="$home/.ssh/$h"
    conf="$config_dir/$prefix$h.conf"
    [[ -e "$conf" ]] && continue
    {
        printf 'Host %s\n' "$h"
        printf '  User %s\n  Port %s\n' "$user" "$port"
        [[ -r "$key" ]] && printf '  IdentityFile %s\n  IdentitiesOnly yes\n' "$key"
        if [[ -r "$home/.ssh/known_hosts.$h" ]]; then
            printf '  UserKnownHostsFile %s\n' "$home/.ssh/known_hosts.$h"
        else
            printf '  UserKnownHostsFile %s\n  StrictHostKeyChecking accept-new\n' "$fallback"
        fi
    } >"$conf" || continue
    chmod "$config_mode" "$conf"
    [[ "$shared" == 1 || -z "$owner" ]] || chown "$owner:$owner" "$conf" 2>/dev/null || true
done
touch "$fallback" || exit 1
[[ -z "$owner" ]] || chown "$owner:$owner" "$fallback" 2>/dev/null || true
[[ "$shared" == 1 ]] && exit 0
# Private-home mode also supplies system defaults without replacing user entries.
if [[ -d "$system" ]] || mkdir -p "$system" 2>/dev/null; then
    for entry in "${hosts[@]}"; do
        h="${entry%%:*}"
        conf="$home/.ssh/config.d/$h.conf"
        [[ -r "$conf" ]] || continue
        cp -f "$conf" "$system/50-agentbox-$h.conf" 2>/dev/null \
            && chmod 644 "$system/50-agentbox-$h.conf" 2>/dev/null || true
    done
fi
include="Include $home/.ssh/config.d/*.conf"
if [[ -d "$home/.ssh/config.d" ]] && ! grep -qxF "$include" "$home/.ssh/config" 2>/dev/null; then
    tmp="$home/.ssh/config.agentbox.$$"
    printf '%s\n' "$include" >"$tmp" || exit 1
    [[ -r "$home/.ssh/config" ]] && cat "$home/.ssh/config" >>"$tmp"
    mv "$tmp" "$home/.ssh/config" || exit 1
    chmod 600 "$home/.ssh/config"
    [[ -z "$owner" ]] || chown "$owner:$owner" "$home/.ssh/config" 2>/dev/null || true
fi
exit 0
