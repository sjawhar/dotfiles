[Unit]
Description=Count Legion READY packets carrying the human brief, for its warn-first flip
# Reports to the AGENTC-1305 coordinator (Envoy role agentc-1305), which opens the flip pull
# request. The go-criterion exits 1, so the unit goes `failed` and the journal holds the notice:
# that is the report (the omp-billing-watch.service pattern). The script reads Dispatch with the
# agent token every session resolves, from ~/.config/opencode/envoy.json under the user manager's
# HOME, and nothing from GitHub. --release-time is the brief's merge commit's committer date,
# written here once the Legion pull request has merged. Until then the script refuses the value
# below (exit 2 naming the flag) and installers/legion-brief-watch.sh refuses to arm the timer.

[Service]
Type=oneshot
WorkingDirectory=%h
# curl, jq and bash are system binaries, and the script calls scripts/envoy by path; no mise shim
# is on this PATH, so none needs MISE_DATA_DIR.
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.dotfiles/scripts/legion-brief-watch --project AGENTC --release-time UNSET-until-the-brief-merges
