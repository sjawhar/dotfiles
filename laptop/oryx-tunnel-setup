chmod 700 "$token_dir"
token_tmp="$(umask 077; mktemp "$token_dir/.tunnel-oryx-XXXXXX")"
if ! ssh oryx 'secrets CF_ACCESS_ORYX_TUNNEL_ID CF_ACCESS_ORYX_TUNNEL_SECRET -- sh -c '\''printf "TUNNEL_SERVICE_TOKEN_ID=%s\nTUNNEL_SERVICE_TOKEN_SECRET=%s\n" "$CF_ACCESS_ORYX_TUNNEL_ID" "$CF_ACCESS_ORYX_TUNNEL_SECRET"'\''' > "$token_tmp"; then
    rm -f "$token_tmp"
    stop token "could not copy the Cloudflare Access tunnel token from oryx"
fi
if ! valid_token_file "$token_tmp"; then
    rm -f "$token_tmp"
    stop token "oryx returned a malformed Cloudflare Access tunnel token file"
fi
if [[ -f "$token_file" ]] && cmp -s "$token_tmp" "$token_file"; then
    rm -f "$token_tmp"
else
    mv -f "$token_tmp" "$token_file"
fi
chmod 600 "$token_file"
leak_result="$(token_leak_result "$token_file")"
