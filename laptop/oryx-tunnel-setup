key_probe_true() {
    with_token_environment timeout 60 ssh -F "$tunnel_probe" oryx-probe true
}

key_probe_no_shell() {
    local output
    output="$(with_token_environment timeout 60 ssh -F "$tunnel_probe" oryx-probe id)" || return 1
    [[ "$output" != *uid=* ]]
}

key_probe_denied_remote_forward() {
    set +e
    with_token_environment timeout 60 ssh -F "$tunnel_probe" -o ExitOnForwardFailure=yes -N -R 127.0.0.1:12999:127.0.0.1:9 oryx-probe >/dev/null 2>&1
    local status=$?
    set -e
    [[ $status -eq 255 ]]
}

key_probe_denied_stdio() {
    set +e
    with_token_environment timeout 60 ssh -F "$tunnel_probe" -W 127.0.0.1:22 oryx-probe >/dev/null 2>&1
    local status=$?
    set -e
    [[ $status -eq 255 ]]
}

key_probe_denied_remote_socket() {
    # The listen path is on oryx: /tmp exists there, so only sshd's refusal can fail this forward.
    local socket="/tmp/oryx-probe-$RANDOM$RANDOM.sock"
    set +e
    with_token_environment timeout 60 ssh -F "$tunnel_probe" -o ExitOnForwardFailure=yes -N -R "$socket:127.0.0.1:9" oryx-probe >/dev/null 2>&1
    local status=$?
    set -e
    [[ $status -eq 255 ]]
}

key_probe_denied_local_socket() {
    local port err pid oryx_uid
    port="$(pick_free_port)" || return 1
    # The socket path is on oryx, so it names oryx's uid, not this laptop's.
    oryx_uid="$(ssh oryx 'id -u')" || return 1
    [[ "$oryx_uid" =~ ^[0-9]+$ ]] || return 1
    err="$work_dir/local-socket.err"
    with_token_environment timeout 60 ssh -F "$tunnel_probe" -N -L "127.0.0.1:$port:/run/user/$oryx_uid/forward/pulse.sock" oryx-probe > /dev/null 2> "$err" &
    pid=$!
    sleep 1
    set +e
    python3 - "$port" <<'PY'
import socket
import sys
sock = socket.create_connection(("127.0.0.1", int(sys.argv[1])), timeout=5)
received = sock.recv(1)
sock.close()
raise SystemExit(0 if received == b"" else 1)
PY
    local client_status=$?
    set -e
    kill -TERM "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
    [[ $client_status -eq 0 ]] && grep -q 'open failed' "$err"
}

key_probe_login_key() {
    local output
    output="$(timeout 60 ssh -F "$login_probe" oryx-login-probe id)" || return 1
    [[ "$output" == *uid=* ]]
}

case "${1:-}" in
