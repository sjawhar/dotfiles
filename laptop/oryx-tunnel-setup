#!/bin/bash
# Move the laptop side of the oryx forward pair to Cloudflare Access.
set -euo pipefail

DOTFILES="$HOME/.dotfiles"
PROC_ROOT="${PROC_ROOT:-/proc}"
REPORT_DIR="$HOME/.local/state/oryx-laptop"
REPORT="${ORYX_SETUP_REPORT:-$REPORT_DIR/report-$(date -u +%Y%m%dT%H%M%SZ).txt}"
REMOTE_REPORT="~/.local/state/oryx-laptop/$(basename "$REPORT")"
probe_logged_in=false
work_dir="$(mktemp -d "${TMPDIR:-/tmp}/oryx-tunnel-setup.XXXXXX")"
trap 'rm -rf -- "$work_dir"' EXIT
ssh_reference_config="$work_dir/ssh-config-without-local"
SYSTEM_SSH_CONFIG=/etc/ssh/ssh_config

mkdir -p "$REPORT_DIR"
chmod 700 "$REPORT_DIR"
if [[ ! -e "$REPORT" ]]; then
    (umask 077; : > "$REPORT")
fi
chmod 600 "$REPORT"

report_line() {
    printf '%s\n' "$*" >> "$REPORT"
}

upload_report() {
    ssh oryx "umask 077; mkdir -p ~/.local/state/oryx-laptop && cat > $REMOTE_REPORT" < "$REPORT"
}

finish_after_stop() {
    if "$probe_logged_in"; then
        if upload_report; then
            printf '%s\n' "$REMOTE_REPORT"
        else
            printf 'oryx-tunnel-setup: report: could not upload the report to oryx\n' >&2
            printf '%s\n' "$REPORT"
        fi
    else
        printf '%s\n' "$REPORT"
    fi
}

stop() {
    local step="$1"
    shift
    local why="$*"
    report_line "$step: failed: $why"
    printf 'oryx-tunnel-setup: %s: %s\n' "$step" "$why" >&2
    finish_after_stop
    exit 1
}

finish() {
    report_line "report: complete"
    if upload_report; then
        printf '%s\n' "$REMOTE_REPORT"
        return 0
    fi
    printf 'oryx-tunnel-setup: report: could not upload the report to oryx\n' >&2
    printf '%s\n' "$REPORT"
    return 1
}

process_uid() {
    local pid="$1" key uid _
    [[ -r "$PROC_ROOT/$pid/status" ]] || return 1
    while read -r key uid _; do
        [[ "$key" == "Uid:" ]] || continue
        printf '%s\n' "$uid"
        return 0
    done < "$PROC_ROOT/$pid/status"
    return 1
}

process_parent() {
    local pid="$1" key parent _
    [[ -r "$PROC_ROOT/$pid/status" ]] || return 1
    while read -r key parent _; do
        [[ "$key" == "PPid:" ]] || continue
        printf '%s\n' "$parent"
        return 0
    done < "$PROC_ROOT/$pid/status"
    return 1
}

process_is_mine() {
    [[ "$(process_uid "$1" 2>/dev/null || true)" == "$(id -u)" ]]
}

process_args() {
    local pid="$1"
    [[ -r "$PROC_ROOT/$pid/cmdline" ]] || return 1
    mapfile -d '' -t PROCESS_ARGS < "$PROC_ROOT/$pid/cmdline"
    ((${#PROCESS_ARGS[@]}))
}

terminate_and_wait() {
    local pid="$1" step="$2" elapsed=0
    kill -TERM "$pid" 2>/dev/null || return 0
    while kill -0 "$pid" 2>/dev/null; do
        ((elapsed >= 100)) && stop "$step" "process $pid did not exit after TERM"
        sleep 0.1
        ((elapsed += 1))
    done
}

stop_supervisors() {
    local entry pid path
    for entry in "$PROC_ROOT"/[0-9]*; do
        [[ -d "$entry" ]] || continue
        pid="${entry##*/}"
        process_is_mine "$pid" || continue
        process_args "$pid" || continue
        ((${#PROCESS_ARGS[@]} == 4)) || continue
        path="${PROCESS_ARGS[1]}"
        [[ "${PROCESS_ARGS[0]##*/}" == bash && "$path" == */devbox && "${PROCESS_ARGS[2]}" == --tunnel-supervisor ]] || continue
        # Removed devbox tunnel supervisors used oryx or oryx-cf as their final argument.
        case "${PROCESS_ARGS[3]}" in
            oryx|oryx-cf)
                terminate_and_wait "$pid" supervisors
                report_line "supervisors: ended $pid (${PROCESS_ARGS[3]})"
                ;;
        esac
    done
    report_line "supervisors: complete"
}

unit_main_pid() {
    systemctl --user show -p MainPID --value "$1" 2>/dev/null || true
}

pid_belongs_to_unit() {
    local pid="$1"
    shift
    local current="$pid" main parent hops=0 unit
    process_is_mine "$pid" || return 1
    while [[ "$current" =~ ^[0-9]+$ && "$current" != 0 && $hops -lt 64 ]]; do
        for unit in "$@"; do
            main="$(unit_main_pid "$unit")"
            [[ "$main" == "$current" && "$main" != 0 ]] && return 0
        done
        parent="$(process_parent "$current" 2>/dev/null || true)"
        [[ -n "$parent" && "$parent" != "$current" ]] || break
        current="$parent"
        ((hops += 1))
    done
    return 1
}

line_pids() {
    local line="$1"
    while [[ "$line" =~ pid=([0-9]+) ]]; do
        printf '%s\n' "${BASH_REMATCH[1]}"
        line="${line#*pid=${BASH_REMATCH[1]}}"
    done
}

# The port of an ss listener that would stop the tunnel from binding 127.0.0.1:<port>: one on
# 127.0.0.1 itself, or on every address (0.0.0.0, *, [::]). A listener on another address, such as
# the devbox daemon on the laptop's tailnet address or a legacy pair on 127.0.0.2, does not.
listener_port() {
    local line="$1" state receive_queue send_queue local_address peer_address port address
    read -r state receive_queue send_queue local_address peer_address _ <<< "$line"
    [[ "$local_address" == *:* ]] || return 1
    port="${local_address##*:}"
    address="${local_address%:*}"
    address="${address%%%*}"
    [[ "$port" =~ ^[0-9]+$ ]] || return 1
    case "$address" in
        127.0.0.1|0.0.0.0|'*'|'[::]'|'[::ffff:127.0.0.1]'|'[::ffff:0.0.0.0]') ;;
        *) return 1 ;;
    esac
    printf '%s\n' "$port"
}

# One listing of the laptop's TCP listeners, taken by read_listeners. A failed ss stops the
# step: a listing that could not be read must never pass as "nothing listens".
LISTENERS=""

read_listeners() {
    local step="$1"
    LISTENERS="$(ss -Hltnp)" || stop "$step" "could not list the laptop's TCP listeners with ss -Hltnp"
}

listener_lines() {
    local wanted_port="$1" line port
    while IFS= read -r line; do
        port="$(listener_port "$line" 2>/dev/null)" || continue
        [[ "$port" == "$wanted_port" ]] && printf '%s\n' "$line"
    done <<< "$LISTENERS"
}

process_is_adb() {
    local pid="$1"
    process_is_mine "$pid" || return 1
    process_args "$pid" || return 1
    ((${#PROCESS_ARGS[@]})) || return 1
    [[ "${PROCESS_ARGS[0]##*/}" == adb ]]
}

check_listener() {
    local port="$1" kind="$2" line pid saw=false
    while IFS= read -r line; do
        [[ -n "$line" ]] || continue
        saw=true
        local line_allowed=true line_has_pid=false
        while IFS= read -r pid; do
            [[ -n "$pid" ]] || continue
            line_has_pid=true
            case "$kind" in
                forward)
                    pid_belongs_to_unit "$pid" forward-daemon@oryx.service forward-tunnel@oryx.service || line_allowed=false
                    ;;
                adb)
                    pid_belongs_to_unit "$pid" adb-server.service || process_is_adb "$pid" || line_allowed=false
                    ;;
            esac
        done < <(line_pids "$line")
        if ! "$line_has_pid" || ! "$line_allowed"; then
            stop preflight "listener on 127.0.0.1:$port is not an allowed $kind process: $line"
        fi
    done < <(listener_lines "$port")
    "$saw"
}

ssh_g() {
    ssh -G "$1" 2>/dev/null
}

ssh_g_reference() {
    ssh -F "$ssh_reference_config" -G "$1" 2>/dev/null
}

ssh_field() {
    local output="$1" wanted="$2" key value
    while read -r key value; do
        [[ "$key" == "$wanted" ]] || continue
        printf '%s\n' "$value"
        return 0
    done <<< "$output"
    return 1
}

ssh_fields() {
    local output="$1" wanted="$2" key value
    while read -r key value; do
        [[ "$key" == "$wanted" ]] && printf '%s\n' "$value"
    done <<< "$output"
}

# The reference is ~/.ssh/config without its first line (Include ~/.ssh/config.local), so any
# difference from the real ssh -G comes from config.local. ssh -F skips /etc/ssh/ssh_config, which
# a plain ssh reads after the user's file, so the reference includes it in the same place.
write_ssh_reference_config() {
    local include
    {
        IFS= read -r include || return 1
        [[ "$include" == "Include ~/.ssh/config.local" ]] || return 1
        cat
        if [[ -f "$SYSTEM_SSH_CONFIG" ]]; then
            printf '\nMatch all\nInclude %s\n' "$SYSTEM_SSH_CONFIG"
        fi
    } < "$HOME/.ssh/config" > "$ssh_reference_config"
}

ssh_config_changed_values() {
    local actual="$1" expected="$2" key value actual_display expected_display
    local -a changes=()
    local -A actual_values=() expected_values=() fields=()
    while read -r key value; do
        actual_values["$key"]+="${actual_values[$key]:+$'\n'}$value"
        fields["$key"]=1
    done <<< "$actual"
    while read -r key value; do
        expected_values["$key"]+="${expected_values[$key]:+$'\n'}$value"
        fields["$key"]=1
    done <<< "$expected"
    for key in "${!fields[@]}"; do
        [[ "${actual_values[$key]-}" == "${expected_values[$key]-}" ]] && continue
        actual_display="${actual_values[$key]-}"
        expected_display="${expected_values[$key]-}"
        actual_display="${actual_display//$'\n'/, }"
        expected_display="${expected_display//$'\n'/, }"
        changes+=("$key=$actual_display (expected $expected_display)")
    done
    printf '%s; ' "${changes[@]}"
}

ssh_config_compare() {
    local host="$1" actual="$2" expected="$3" changes
    [[ "$actual" == "$expected" ]] && return 0
    changes="$(ssh_config_changed_values "$actual" "$expected")"
    ssh_config_errors+=("$host differs from ~/.ssh/config without config.local: $changes")
    return 1
}

ssh_config_errors=()
ssh_config_expect() {
    local host="$1" output="$2" field="$3" expected="$4" actual actual_display expected_display
    actual="$(ssh_fields "$output" "$field")"
    [[ "$actual" == "$expected" ]] && return 0
    actual_display="${actual//$'\n'/, }"
    expected_display="${expected//$'\n'/, }"
    ssh_config_errors+=("$host $field=$actual_display (expected $expected_display)")
    return 1
}

validate_ssh_configuration() {
    local oryx tunnel oryx_reference tunnel_reference expected
    ssh_config_errors=()
    oryx="$(ssh_g oryx)" || {
        ssh_config_errors=("could not read effective Host oryx values")
        return 1
    }
    tunnel="$(ssh_g oryx-tunnel)" || {
        ssh_config_errors=("could not read effective Host oryx-tunnel values")
        return 1
    }
    oryx_reference="$(ssh_g_reference oryx)" || {
        ssh_config_errors=("could not read reference Host oryx values")
        return 1
    }
    tunnel_reference="$(ssh_g_reference oryx-tunnel)" || {
        ssh_config_errors=("could not read reference Host oryx-tunnel values")
        return 1
    }
    ssh_config_compare oryx "$oryx" "$oryx_reference" || true
    ssh_config_compare oryx-tunnel "$tunnel" "$tunnel_reference" || true

    ssh_config_expect oryx "$oryx" hostname oryx.thecybermonk.com || true
    ssh_config_expect oryx "$oryx" user agent || true
    ssh_config_expect oryx "$oryx" proxycommand 'cloudflared access ssh --hostname %h' || true
    # This tailnet name is only the label under which known_hosts holds oryx's key.
    ssh_config_expect oryx "$oryx" hostkeyalias oryx.tail12ec1c.ts.net || true
    ssh_config_expect oryx "$oryx" localforward '' || true
    ssh_config_expect oryx "$oryx" remoteforward '' || true

    ssh_config_expect oryx-tunnel "$tunnel" hostname oryx-pcsc.thecybermonk.com || true
    ssh_config_expect oryx-tunnel "$tunnel" user agent || true
    ssh_config_expect oryx-tunnel "$tunnel" proxycommand 'cloudflared access ssh --hostname %h' || true
    # This tailnet name is only the label under which known_hosts holds oryx's key.
    ssh_config_expect oryx-tunnel "$tunnel" hostkeyalias oryx.tail12ec1c.ts.net || true
    ssh_config_expect oryx-tunnel "$tunnel" stricthostkeychecking true || true
    ssh_config_expect oryx-tunnel "$tunnel" identityfile '~/.ssh/oryx-tunnel' || true
    ssh_config_expect oryx-tunnel "$tunnel" identitiesonly yes || true
    ssh_config_expect oryx-tunnel "$tunnel" identityagent none || true
    ssh_config_expect oryx-tunnel "$tunnel" batchmode yes || true
    ssh_config_expect oryx-tunnel "$tunnel" controlmaster false || true
    [[ -z "$(ssh_fields "$tunnel" controlpath)" ]] || ssh_config_errors+=("oryx-tunnel controlpath=$(ssh_fields "$tunnel" controlpath) (expected none)")
    ssh_config_expect oryx-tunnel "$tunnel" exitonforwardfailure yes || true
    ssh_config_expect oryx-tunnel "$tunnel" serveraliveinterval 15 || true
    ssh_config_expect oryx-tunnel "$tunnel" serveralivecountmax 4 || true

    expected="$(printf '%s\n' \
        'localforward 127.0.0.1:12801 127.0.0.1:12801' \
        'localforward 127.0.0.1:12802 127.0.0.1:12802' \
        'localforward 127.0.0.1:12805 127.0.0.1:12805' \
        'remoteforward 127.0.0.1:12800 127.0.0.1:12800' \
        'remoteforward 127.0.0.1:12803 127.0.0.1:12803' \
        'remoteforward 127.0.0.1:12804 127.0.0.1:12804' \
        'remoteforward 127.0.0.1:12806 127.0.0.1:12806' \
        'remoteforward 127.0.0.1:2223 sami-devbox:22' \
        'remoteforward 127.0.0.1:2224 ghost-wispr:22' \
        'remoteforward 127.0.0.1:5038 127.0.0.1:5037' | sort)"
    actual="$(
        while IFS= read -r line; do
            [[ "$line" =~ ^(localforward|remoteforward)\  ]] || continue
            line="${line//[/}"
            line="${line//]/}"
            printf '%s\n' "$line"
        done <<< "$tunnel" | sort
    )"
    [[ "$actual" == "$expected" ]] || ssh_config_errors+=("oryx-tunnel forwards=$actual (expected $expected)")

    ((${#ssh_config_errors[@]} == 0))
}

valid_token_file() {
    local -a lines
    mapfile -t lines < "$1"
    ((${#lines[@]} == 2)) || return 1
    [[ "${lines[0]}" =~ ^TUNNEL_SERVICE_TOKEN_ID=[A-Za-z0-9._-]+$ ]] || return 1
    [[ "${lines[1]}" =~ ^TUNNEL_SERVICE_TOKEN_SECRET=[A-Za-z0-9._-]+$ ]] || return 1
}

token_leak_result() {
    local token_file="$1" status
    if grep -rqF -f <(
        while IFS='=' read -r name value; do
            [[ "$name" == TUNNEL_SERVICE_TOKEN_ID || "$name" == TUNNEL_SERVICE_TOKEN_SECRET ]] && printf '%s\n' "$value"
        done < "$token_file"
    ) "$DOTFILES" 2>/dev/null; then
        printf 'FOUND\n'
        return 0
    else
        status=$?
    fi
    case "$status" in
        1) printf 'none\n' ;;
        *) printf 'UNKNOWN\n' ;;
    esac
}

find_adb() {
    local sdk_adb="$HOME/Android/sdk/platform-tools/adb"
    if [[ -x "$sdk_adb" ]]; then
        printf '%s\n' "$sdk_adb"
    else
        command -v adb 2>/dev/null || true
    fi
}

unit_active() {
    systemctl --user is-active --quiet "$1" >/dev/null 2>&1
}

wait_for_unit() {
    local unit="$1" attempt journal
    for attempt in {1..30}; do
        unit_active "$unit" && return 0
        sleep 1
    done
    journal="$(journalctl --user -u "$unit" -n 20 --no-pager 2>&1 || true)"
    report_line "units: $unit journal: $journal"
    return 1
}

stop_old_masters() {
    local socket entry pid
    for socket in \
        "$HOME/.ssh/sockets/tunnel-agent@oryx.tail12ec1c.ts.net" \
        "$HOME/.ssh/sockets/tunnel-agent@oryx-pcsc.thecybermonk.com"; do
        # These sockets belong to the removed tailnet and oryx-cf tunnel hosts.
        # Their names remain only so this command can end an old master.
        [[ -S "$socket" ]] || continue
        ssh -o "ControlPath=$socket" -O exit oryx-old >/dev/null 2>&1 || true
    done

    for entry in "$PROC_ROOT"/[0-9]*; do
        [[ -d "$entry" ]] || continue
        pid="${entry##*/}"
        process_is_mine "$pid" || continue
        process_args "$pid" || continue
        ((${#PROCESS_ARGS[@]} == 4)) || continue
        [[ "${PROCESS_ARGS[0]##*/}" == ssh && "${PROCESS_ARGS[1]}" == -N && "${PROCESS_ARGS[2]}" == -f ]] || continue
        # Removed devbox tunnel processes used these old SSH hosts as their final argument.
        case "${PROCESS_ARGS[3]}" in
            oryx-tunnel|oryx-cf-tunnel)
                terminate_and_wait "$pid" old-tunnel
                report_line "old-tunnel: ended $pid (${PROCESS_ARGS[3]})"
                ;;
        esac
    done
}

self_failures=()
self_probe() {
    local name="$1"
    shift
    if "$@"; then
        report_line "self-check: $name: ok"
    else
        report_line "self-check: $name: failed"
        self_failures+=("$name")
    fi
}

self_ssh_config() {
    local values hostname proxycommand hostkeyalias
    values="$(ssh_g oryx)" || return 1
    hostname="$(ssh_field "$values" hostname)"
    proxycommand="$(ssh_field "$values" proxycommand)"
    hostkeyalias="$(ssh_field "$values" hostkeyalias)"
    report_line "self-check: ssh -G oryx: hostname=$hostname proxycommand=$proxycommand hostkeyalias=$hostkeyalias"
    # This tailnet name is only the label under which known_hosts holds oryx's key.
    [[ "$hostname" == oryx.thecybermonk.com && "$proxycommand" == 'cloudflared access ssh --hostname %h' && "$hostkeyalias" == oryx.tail12ec1c.ts.net ]]
}

self_unit_active() {
    local unit="$1" state
    state="$(systemctl --user is-active "$unit" 2>&1)" || return 1
    report_line "self-check: systemctl --user is-active $unit: $state"
    [[ "$state" == active ]]
}

self_devboxes_config() {
    local config="$HOME/.config/forward/config.toml" contents
    [[ -f "$config" ]] || return 1
    contents="$(<"$config")"
    report_line "self-check: devboxes daemon configuration: $contents"
}

self_command_output() {
    local name="$1" output
    shift
    output="$("$@" 2>&1)" || return 1
    output="${output//$'\n'/ }"
    report_line "self-check: $name output: $output"
}

self_laptop_port_22() {
    local listeners
    listeners="$(ss -Hltn '( sport = :22 )')" || return 1
    if [[ -n "$listeners" ]]; then
        listeners="${listeners//$'\n'/ }"
        report_line "self-check: laptop port 22: $listeners"
    else
        report_line "self-check: laptop port 22: none"
    fi
}

with_token_environment() {
    (
        set -a
        # shellcheck disable=SC1090
        source "$token_file"
        set +a
        "$@"
    )
}

pick_free_port() {
    python3 - <<'PY'
import socket
sock = socket.socket()
sock.bind(("127.0.0.1", 0))
print(sock.getsockname()[1])
sock.close()
PY
}

delivery_response_parts() {
    local response="$1" line
    DELIVERY_REMOTE_DIR=
    DELIVERY_URL=
    while IFS= read -r line; do
        case "$line" in
            ORYX_TUNNEL_TEMP_DIR=*) DELIVERY_REMOTE_DIR="${line#ORYX_TUNNEL_TEMP_DIR=}" ;;
            http://*|https://*) DELIVERY_URL="$line" ;;
        esac
    done <<< "$response"
    [[ "$DELIVERY_REMOTE_DIR" =~ ^/tmp/oryx-tunnel-setup\.[A-Za-z0-9._-]+$ && -n "$DELIVERY_URL" ]]
}

cleanup_delivery_directory() {
    local remote_dir="$1"
    [[ "$remote_dir" =~ ^/tmp/oryx-tunnel-setup\.[A-Za-z0-9._-]+$ ]] || return 1
    ssh oryx "rm -rf -- '$remote_dir'" >/dev/null 2>&1
}

delivery_preview() {
    local nonce remote_file response body curl_status=0 cleanup_status=0
    nonce="oryx-preview-$(date +%s)-$RANDOM"
    remote_file="oryx-preview-$nonce"
    response="$(ssh oryx "d=\$(mktemp -d /tmp/oryx-tunnel-setup.XXXXXX) || exit
printf '%s\\n' '$nonce' > \"\$d/$remote_file\"
url=\$(forward url \"\$d/$remote_file\") || { rm -rf -- \"\$d\"; exit 1; }
printf 'ORYX_TUNNEL_TEMP_DIR=%s\\n' \"\$d\"
printf '%s\\n' \"\$url\"")" || return 1
    if ! delivery_response_parts "$response"; then
        cleanup_delivery_directory "$DELIVERY_REMOTE_DIR" >/dev/null 2>&1 || true
        return 1
    fi
    body="$(curl --noproxy '*' -fsS "$DELIVERY_URL")" || curl_status=$?
    cleanup_delivery_directory "$DELIVERY_REMOTE_DIR" || cleanup_status=$?
    [[ $curl_status -eq 0 && $cleanup_status -eq 0 && "$body" == "$nonce" ]]
}

delivery_forward_port() {
    local nonce port remote_file session ready=0 body delivered=false
    nonce="oryx-port-$(date +%s)-$RANDOM"
    port="$(pick_free_port)" || return 1
    remote_file="oryx-port-$nonce"
    ssh oryx "d=\$(mktemp -d)
printf '%s\\n' '$nonce' > \"\$d/$remote_file\"
(
    cd \"\$d\"
    timeout 90 python3 - $port <<'PY'
import http.server
import sys

server = http.server.HTTPServer(('127.0.0.1', int(sys.argv[1])), http.server.SimpleHTTPRequestHandler)
server.handle_request()
server.server_close()
PY
) &
server=\$!
timeout 90 forward port $port &
forward=\$!
echo READY
if wait \$server; then
    kill -TERM \$forward 2>/dev/null || true
    wait \$forward 2>/dev/null || true
    rm -rf \"\$d\"
else
    status=\$?
    kill -TERM \$forward 2>/dev/null || true
    wait \$forward 2>/dev/null || true
    rm -rf \"\$d\"
    exit \$status
fi" > "$work_dir/forward-port.out" 2>&1 &
    session=$!
    for _ in {1..20}; do
        grep -q '^READY$' "$work_dir/forward-port.out" && { ready=1; break; }
        sleep 1
    done
    ((ready)) || { kill -TERM "$session" 2>/dev/null || true; wait "$session" 2>/dev/null || true; return 1; }
    # forward port may bind a moment after READY: retry for 10 s, and show only the last error.
    local attempt curl_err="$work_dir/forward-port-curl.err"
    for attempt in {1..100}; do
        if body="$(curl --noproxy '*' -fsS "http://127.0.0.1:$port/$remote_file" 2>"$curl_err")"; then
            delivered=true
            break
        fi
        sleep 0.1
    done
    if ! "$delivered"; then
        cat "$curl_err" >&2
        kill -TERM "$session" 2>/dev/null || true
        wait "$session" 2>/dev/null || true
        return 1
    fi
    wait "$session" || return 1
    [[ "$body" == "$nonce" ]]
}

ask_yes() {
    local prompt="$1" answer
    printf '%s [y/N] ' "$prompt" >&2
    read -r answer
    [[ "$answer" == y || "$answer" == Y ]]
}

delivery_page() {
    local nonce remote_file response open_status=0 cleanup_status=0
    nonce="oryx-page-$(date +%s)-$RANDOM"
    remote_file="oryx-page-$nonce.html"
    response="$(ssh oryx "d=\$(mktemp -d /tmp/oryx-tunnel-setup.XXXXXX) || exit
printf '<p>%s</p>\\n' '$nonce' > \"\$d/$remote_file\"
url=\$(forward url \"\$d/$remote_file\") || { rm -rf -- \"\$d\"; exit 1; }
printf 'ORYX_TUNNEL_TEMP_DIR=%s\\n' \"\$d\"
printf '%s\\n' \"\$url\"")" || return 1
    if ! delivery_response_parts "$response"; then
        cleanup_delivery_directory "$DELIVERY_REMOTE_DIR" >/dev/null 2>&1 || true
        return 1
    fi
    local seen=false
    if ssh oryx "forward open '$DELIVERY_URL'"; then
        # The browser loads the page after forward open returns, so the page stays until Sami answers.
        ask_yes "Did the forward test page open in the browser?" && seen=true
    else
        open_status=1
    fi
    cleanup_delivery_directory "$DELIVERY_REMOTE_DIR" || cleanup_status=$?
    [[ $open_status -eq 0 && $cleanup_status -eq 0 ]] && "$seen"
}

delivery_sound() {
    ssh oryx 'PULSE_SERVER=unix:/run/user/$(id -u)/forward/pulse.sock paplay /usr/share/sounds/freedesktop/stereo/complete.oga' || return 1
    ask_yes "Did you hear the forward test sound?"
}

delivery_browser() {
    local grant_output endpoint version
    local -a grant_status endpoints
    grant_output="$work_dir/browser-grant.out"
    printf 'Touch the YubiKey now for the browser grant.\n' >&2
    set +e
    ssh -t oryx 'forward browser grant --ttl 5m' | tee "$grant_output"
    grant_status=("${PIPESTATUS[@]}")
    set -e
    [[ "${grant_status[0]}" -eq 0 && "${grant_status[1]}" -eq 0 ]] || return 1
    mapfile -t endpoints < <(grep -Eo 'https?://[^[:space:]]+' "$grant_output")
    ((${#endpoints[@]})) || return 1
    endpoint="${endpoints[${#endpoints[@]} - 1]}"
    version="$(ssh oryx "curl -fsS '${endpoint%/}/json/version'")" || return 1
    [[ "$version" == *'"Browser"'* ]]
}

human_tier_read() {
