#!/bin/bash
set -euo pipefail

LAPTOP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TEMPLATE="${LAPTOP_DIR}/shortcuts-custom"
CONF="${LAPTOP_DIR}/workspaces.conf"
MODE="stdout"
MONITORS_FILE=""

error() {
    printf 'generate-shortcuts: %s\n' "$*" >&2
    exit 1
}

usage() {
    cat <<'USAGE'
Usage: generate-shortcuts [--apply | --check] [--conf PATH] [--monitors PATH]

Generate COSMIC custom shortcuts from laptop/workspaces.conf.
  --apply      write the generated shortcuts to COSMIC's custom shortcuts file
  --check      validate the generated RON sanity checks, then print it
  --conf PATH  read workspace mappings from PATH instead of workspaces.conf
  --monitors PATH
               read connected output fixtures from PATH instead of cosmic-randr
               list; rows are <connector> [model words...] [(disabled)|(enabled)]
               and an omitted state means enabled
USAGE
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --apply)
            [[ "${MODE}" == "stdout" ]] || error 'choose only one of --apply or --check'
            MODE="apply"
            ;;
        --check)
            [[ "${MODE}" == "stdout" ]] || error 'choose only one of --apply or --check'
            MODE="check"
            ;;
        --conf)
            [[ $# -ge 2 ]] || error '--conf requires a path'
            CONF="$2"
            shift
            ;;
        --monitors)
            [[ $# -ge 2 ]] || error '--monitors requires a path'
            MONITORS_FILE="$2"
            shift
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        *)
            error "unknown argument: $1"
            ;;
    esac
    shift
done

[[ -r "${CONF}" ]] || error "cannot read workspace config: ${CONF}"
[[ -r "${TEMPLATE}" ]] || error "cannot read shortcut template: ${TEMPLATE}"

ron_escape() {
    local escaped="$1"
    escaped="${escaped//\\/\\\\}"
    escaped="${escaped//\"/\\\"}"
    printf '%s' "${escaped}"
}

parse_chord() {
    local chord="$1"
    local context="$2"
    local token
    local index
    local -a parts
    local -a modifiers=()

    [[ -n "${chord}" && "${chord}" != +* && "${chord}" != *+ && "${chord}" != *'++'* ]] \
        || error "invalid ${context} chord: ${chord}"

    IFS='+' read -r -a parts <<< "${chord}"
    index=$((${#parts[@]} - 1))
    RON_KEY="${parts[$index]}"
    [[ -n "${RON_KEY}" ]] || error "invalid ${context} chord: ${chord}"

    for ((index = 0; index < ${#parts[@]} - 1; index++)); do
        token="${parts[$index]}"
        case "${token}" in
            Super|Alt|Ctrl|Shift)
                modifiers+=("${token}")
                ;;
            *)
                error "invalid modifier in ${context} chord: ${token}"
                ;;
        esac
    done

    RON_MODIFIERS=""
    for token in "${modifiers[@]}"; do
        if [[ -n "${RON_MODIFIERS}" ]]; then
            RON_MODIFIERS+=", "
        fi
        RON_MODIFIERS+="${token}"
    done
}

declare -A monitor_models=()
declare -a monitor_connectors=()

add_monitor() {
    local connector="$1"
    local model="$2"

    [[ "${connector}" =~ ^[[:alnum:]][[:alnum:]-]*$ ]] \
        || error "invalid monitor connector: ${connector}"
    [[ -z "${monitor_models["${connector}"]+x}" ]] \
        || error "duplicate connected monitor connector: ${connector}"

    monitor_connectors+=("${connector}")
    monitor_models["${connector}"]="${model}"
}

load_monitor_file() {
    local raw_line
    local line
    local connector
    local model
    local state
    local state_pattern='[[:space:]]+\(([^)]*)\)$'

    [[ -r "${MONITORS_FILE}" ]] || error "cannot read monitor fixture: ${MONITORS_FILE}"

    while IFS= read -r raw_line || [[ -n "${raw_line}" ]]; do
        line="${raw_line#"${raw_line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        [[ -z "${line}" || "${line:0:1}" == "#" ]] && continue

        state="enabled"
        if [[ "${line}" =~ ${state_pattern} ]]; then
            state="${BASH_REMATCH[1]}"
            case "${state}" in
                enabled|disabled)
                    line="${line%" (${state})"}"
                    ;;
                *)
                    error "${MONITORS_FILE}: invalid monitor fixture state: (${state})"
                    ;;
            esac
        fi

        connector=""
        model=""
        read -r connector model <<< "${line}"
        [[ -n "${connector}" ]] || error "${MONITORS_FILE}: invalid monitor fixture row"
        [[ "${state}" == "enabled" ]] && add_monitor "${connector}" "${model}"
    done < "${MONITORS_FILE}"
}

load_live_monitors() {
    local output
    local line
    local connector=""
    local model=""
    local state=""
    local next_connector
    local next_state
    local head_pattern='^([[:alnum:]][[:alnum:]-]*)[[:space:]]+\(([^)]*)\)[[:space:]]*$'

    output="$(cosmic-randr list 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g')" \
        || error 'failed to list connected monitors with cosmic-randr'

    while IFS= read -r line || [[ -n "${line}" ]]; do
        if [[ "${line}" =~ ${head_pattern} ]]; then
            next_connector="${BASH_REMATCH[1]}"
            next_state="${BASH_REMATCH[2]}"
            if [[ -n "${connector}" && "${state}" == "enabled" ]]; then
                add_monitor "${connector}" "${model}"
            fi
            connector="${next_connector}"
            state="${next_state}"
            model=""
        elif [[ -n "${connector}" && "${line}" =~ ^[[:space:]]+Model:[[:space:]]*(.*)$ ]]; then
            model="${BASH_REMATCH[1]}"
        fi
    done <<< "${output}"

    [[ -z "${connector}" || "${state}" != "enabled" ]] || add_monitor "${connector}" "${model}"
}

load_monitors() {
    if [[ -n "${MONITORS_FILE}" ]]; then
        load_monitor_file
    else
        load_live_monitors
    fi
}

resolve_monitor() {
    local fallback_list="$1"
    local context="$2"
    local query
    local connector
    local model
    local query_lower
    local model_lower
    local match_list
    local -a queries=()
    local -a matches=()

    IFS=',' read -r -a queries <<< "${fallback_list}"
    [[ "${#queries[@]}" -gt 0 ]] || error "${context}: monitor fallback list is empty"

    for query in "${queries[@]}"; do
        [[ -n "${query}" ]] || error "${context}: monitor fallback list contains an empty query"

        if [[ -n "${monitor_models["${query}"]+x}" ]]; then
            RESOLVED_CONNECTOR="${query}"
            RESOLVED_QUERY="${query}"
            return 0
        fi

        query_lower="${query,,}"
        matches=()
        for connector in "${monitor_connectors[@]}"; do
            model="${monitor_models["${connector}"]}"
            model_lower="${model,,}"
            [[ "${model_lower}" == *"${query_lower}"* ]] && matches+=("${connector}")
        done

        case "${#matches[@]}" in
            0)
                ;;
            1)
                RESOLVED_CONNECTOR="${matches[0]}"
                RESOLVED_QUERY="${query}"
                return 0
                ;;
            *)
                match_list=""
                for connector in "${matches[@]}"; do
                    [[ -z "${match_list}" ]] || match_list+=', '
                    match_list+="${connector}"
                done
                error "${context}: ambiguous monitor query: ${query} matches connected outputs: ${match_list}; use connector names"
                ;;
        esac
    done

    return 1
}

declare -A seen_workspaces=()
declare -A seen_chords=()
declare -A local_counts=()
declare -a bindings=()

load_monitors

line_number=0
row_count=0
while IFS= read -r raw_line || [[ -n "${raw_line}" ]]; do
    ((++line_number))
    line="${raw_line#"${raw_line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -z "${line}" || "${line:0:1}" == "#" ]] && continue

    read -r workspace monitor_fallbacks switch_chord move_chord extra <<< "${line}"
    [[ -n "${workspace:-}" && -n "${monitor_fallbacks:-}" && -n "${switch_chord:-}" && -n "${move_chord:-}" && -z "${extra:-}" ]] \
        || error "${CONF}:${line_number}: expected <global-ws> <monitor-fallback-list> <switch-chord> <move-chord>"
    [[ "${workspace}" =~ ^[1-9][0-9]*$ ]] \
        || error "${CONF}:${line_number}: global workspace must be a positive integer: ${workspace}"
    [[ -z "${seen_workspaces[${workspace}]+x}" ]] \
        || error "${CONF}:${line_number}: duplicate global workspace: ${workspace}"
    seen_workspaces[${workspace}]=1

    for chord in "${switch_chord}" "${move_chord}"; do
        [[ -z "${seen_chords[${chord}]+x}" ]] \
            || error "${CONF}:${line_number}: duplicate chord: ${chord}"
        seen_chords[${chord}]=1
    done

    ((++row_count))
    if ! resolve_monitor "${monitor_fallbacks}" "${CONF}:${line_number}"; then
        printf 'generate-shortcuts: %s:%d: no connected monitor matches fallback list: %s; skipping workspace %s\n' \
            "${CONF}" "${line_number}" "${monitor_fallbacks}" "${workspace}" >&2
        continue
    fi

    local_index=$((${local_counts["${RESOLVED_CONNECTOR}"]:-0} + 1))
    local_counts["${RESOLVED_CONNECTOR}"]="${local_index}"
    case "${local_index}" in
        [1-9])
            key_num="${local_index}"
            ;;
        10)
            key_num=0
            ;;
        *)
            printf 'generate-shortcuts: %s:%d: resolved monitor %s has more than 10 local workspaces; skipping workspace %s (10-slot encoding cap)\n' \
                "${CONF}" "${line_number}" "${RESOLVED_CONNECTOR}" "${workspace}" >&2
            continue
            ;;
    esac

    monitor_ron="$(ron_escape "${RESOLVED_QUERY}")"

    parse_chord "${switch_chord}" 'switch'
    bindings+=("    (modifiers: [${RON_MODIFIERS}], key: \"${RON_KEY}\", description: Some(\"WS${workspace} — ${monitor_ron} (${local_index})\")): WorkspaceOnOutput(\"${monitor_ron}\", ${key_num}),")

    parse_chord "${move_chord}" 'move'
    bindings+=("    (modifiers: [${RON_MODIFIERS}], key: \"${RON_KEY}\", description: Some(\"Move to WS${workspace}\")): MoveToWorkspaceOnOutput(\"${monitor_ron}\", ${key_num}),")

done < "${CONF}"

((row_count > 0)) || error "${CONF}: no workspace mappings found"
(( ${#bindings[@]} > 0 )) || error 'no workspace bindings resolved for the connected monitors'

render_template() {
    local template_line
    local marker_count=0

    while IFS= read -r template_line || [[ -n "${template_line}" ]]; do
        if [[ "${template_line}" == '__WORKSPACE_BINDINGS__' ]]; then
            ((++marker_count))
            if ((${#bindings[@]})); then
                printf '%s\n' "${bindings[@]}"
            fi
        else
            printf '%s\n' "${template_line//__HOME__/${HOME}}"
        fi
    done < "${TEMPLATE}"

    ((marker_count == 1)) || error "${TEMPLATE}: expected exactly one __WORKSPACE_BINDINGS__ line"
}

canonicalize_modifiers() {
    local modifiers="$1"
    local modifier
    local canonical_modifiers=""
    local -a modifier_parts
    local -A modifier_set=()

    IFS=',' read -r -a modifier_parts <<< "${modifiers}"
    for modifier in "${modifier_parts[@]}"; do
        modifier="${modifier//[[:space:]]/}"
        [[ -z "${modifier}" ]] && continue
        case "${modifier}" in
            Alt|Ctrl|Shift|Super)
                modifier_set[${modifier}]=1
                ;;
            *)
                error "generated output has invalid modifier: ${modifier}"
                ;;
        esac
    done

    for modifier in Alt Ctrl Shift Super; do
        [[ -n "${modifier_set[${modifier}]+x}" ]] || continue
        [[ -z "${canonical_modifiers}" ]] || canonical_modifiers+=", "
        canonical_modifiers+="${modifier}"
    done

    printf '%s' "${canonical_modifiers}"
}

validate_output() {
    local output="$1"
    local generated_line
    local binding_modifiers
    local binding_key
    local binding_tuple
    local canonical_modifiers
    local open_parens
    local close_parens
    local open_braces
    local close_braces
    local generated_count=0
    local binding_pattern='^[[:space:]]*\(modifiers:[[:space:]]*\[([^]]*)\],[[:space:]]*key:[[:space:]]*"([^"]*)"'
    local -A seen_binding_tuples=()

    open_parens="$(tr -cd '(' <<< "${output}" | wc -c)"
    close_parens="$(tr -cd ')' <<< "${output}" | wc -c)"
    [[ "${open_parens}" -eq "${close_parens}" ]] || error 'generated output has unbalanced parentheses'

    open_braces="$(tr -cd '{' <<< "${output}" | wc -c)"
    close_braces="$(tr -cd '}' <<< "${output}" | wc -c)"
    [[ "${open_braces}" -eq "${close_braces}" ]] || error 'generated output has unbalanced braces'

    while IFS= read -r generated_line; do
        if [[ "${generated_line}" =~ ${binding_pattern} ]]; then
            binding_modifiers="${BASH_REMATCH[1]}"
            binding_key="${BASH_REMATCH[2]}"
            canonical_modifiers="$(canonicalize_modifiers "${binding_modifiers}")"
            binding_tuple="${canonical_modifiers}|${binding_key}"
            [[ -z "${seen_binding_tuples[${binding_tuple}]+x}" ]] \
                || error "generated output has duplicate binding tuple: (modifiers: [${canonical_modifiers}], key: \"${binding_key}\")"
            seen_binding_tuples[${binding_tuple}]=1
        fi

        if [[ "${generated_line}" == *'WorkspaceOnOutput('* || "${generated_line}" == *'MoveToWorkspaceOnOutput('* ]]; then
            [[ "${generated_line}" == *, ]] || error 'generated workspace binding does not end with a comma'
            ((++generated_count))
        fi
    done <<< "${output}"

    [[ "${generated_count}" -eq "${#bindings[@]}" ]] \
        || error "generated output is missing workspace bindings"
}

case "${MODE}" in
    stdout)
        render_template
        ;;
    check)
        output="$(render_template)"
        validate_output "${output}"
        printf '%s\n' "${output}"
        ;;
    apply)
        cosmic_shortcuts="${HOME}/.config/cosmic/com.system76.CosmicSettings.Shortcuts/v1"
        target="${cosmic_shortcuts}/custom"
        temp_target=""
        mkdir -p "${cosmic_shortcuts}"
        temp_target="$(mktemp "${cosmic_shortcuts}/.custom.XXXXXX")"
        trap 'rm -f "${temp_target}"' EXIT
        render_template > "${temp_target}"
        output="$(< "${temp_target}")"
        validate_output "${output}"
        mv -f "${temp_target}" "${target}"
        trap - EXIT
        printf 'Generated COSMIC shortcuts: %s\n' "${target}"
        ;;
esac
