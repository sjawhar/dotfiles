Include ~/.ssh/config.local

Host *
  IdentityAgent ~/.1password/agent.sock

Host devbox
  HostName sami-agents.tailb86685.ts.net
  User ubuntu
  ForwardAgent yes
  Compression yes
  ControlMaster auto
  ControlPath ~/.ssh/sockets/%r@%h-%p
  ControlPersist 600
  ServerAliveInterval 30
  ServerAliveCountMax 3
  TCPKeepAlive yes
  IPQoS lowdelay throughput

Host theorem
  User sami
  ProxyCommand env CLOUDSDK_ACTIVE_CONFIG_NAME=theorem gcloud compute start-iap-tunnel sami-devbox %p --listen-on-stdin --zone us-west1-b
  IdentityFile ~/.ssh/google_compute_engine
  IdentitiesOnly yes
  HostKeyAlias compute.5092395176580716040
  UserKnownHostsFile ~/.ssh/google_compute_known_hosts
  CheckHostIP no
  StrictHostKeyChecking yes
  Compression yes
  ControlMaster auto
  ControlPath ~/.ssh/sockets/%r@%h-%p
  ControlPersist 600
  ServerAliveInterval 30
  ServerAliveCountMax 3
  TCPKeepAlive yes
  IPQoS lowdelay throughput

Host theorem-tree
  User sami
  ProxyCommand env CLOUDSDK_ACTIVE_CONFIG_NAME=theorem gcloud compute start-iap-tunnel sandboxing-tree-1 %p --listen-on-stdin --zone us-west1-b
  IdentityFile ~/.ssh/google_compute_engine
  IdentitiesOnly yes
  CheckHostIP no
  Compression yes
  ControlMaster auto
  ControlPath ~/.ssh/sockets/%r@%h-%p
  ControlPersist 600
  ServerAliveInterval 30
  ServerAliveCountMax 3
  TCPKeepAlive yes

Host oryx
  HostName oryx.tailb86685.ts.net
  User agent
  ForwardAgent yes
  # YubiKey access for sops human tier: use `devbox oryx` (scripts/devbox),
  # which ensures the oryx-tunnel below exists before connecting. Works with mosh.
  Compression yes
  ControlMaster auto
  ControlPath ~/.ssh/sockets/%r@%h-%p
  ControlPersist 600
  ServerAliveInterval 30
  ServerAliveCountMax 3
  TCPKeepAlive yes
  IPQoS lowdelay throughput

# YubiKey tunnel for oryx; the devbox pair uses forward's pcsc channel.
Host oryx-tunnel
  HostName oryx.tailb86685.ts.net
  User agent
  Port 2222
  IdentityFile ~/.ssh/oryx-tunnel
  IdentitiesOnly yes
  ControlMaster auto
  ControlPath ~/.ssh/sockets/tunnel-%r@%h
  ExitOnForwardFailure yes
  ServerAliveInterval 15
  ServerAliveCountMax 3
  RemoteForward 127.0.0.1:12799 /run/pcscd/pcscd.comm

# forward's channels for sami-leanperf (Azure, off the tailnet), held open by
# forward-tunnel@sami-leanperf.service. Each port maps to the same port on the
# far side's loopback: the laptop daemon's ports to the VM, the VM's to here.
# Its own key, like oryx-tunnel's, so a locked 1Password never stalls a reconnect.
Host sami-leanperf-tunnel
  HostName 52.233.92.39
  Port 443
  User sami
  IdentityFile ~/.ssh/sami-leanperf-tunnel
  IdentitiesOnly yes
  BatchMode yes
  StrictHostKeyChecking accept-new
  ControlMaster no
  ControlPath none
  ExitOnForwardFailure yes
  ServerAliveInterval 15
  ServerAliveCountMax 3
  RemoteForward 127.0.0.1:12800 127.0.0.1:12800
  RemoteForward 127.0.0.1:12803 127.0.0.1:12803
  RemoteForward 127.0.0.1:12804 127.0.0.1:12804
  RemoteForward 127.0.0.1:12806 127.0.0.1:12806
  LocalForward 127.0.0.1:12801 127.0.0.1:12801
  LocalForward 127.0.0.1:12802 127.0.0.1:12802
  LocalForward 127.0.0.1:12805 127.0.0.1:12805

Host ghost-wispr
  HostName ghost-wispr.tailb86685.ts.net
  User ghost-wispr
  ForwardAgent yes
