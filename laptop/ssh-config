Include ~/.ssh/config.local

# ssh takes the first value it finds for each option, so per-host settings sit
# above the Host * defaults at the bottom.

# sami-agents, the Trajectory devbox, over AWS Session Manager: it is on the old
# tailnet, which this laptop has left, so this is the only way in. Needs a live
# AWS SSO login for the Trajectory account. The host key is the one pinned for
# its old tailnet name.
Host devbox-ssm
  HostName i-01d7575cd0d055f0e
  User ubuntu
  ForwardAgent yes
  HostKeyAlias sami-agents.tailb86685.ts.net
  ProxyCommand aws ssm start-session --region us-west-2 --target %h --document-name AWS-StartSSHSession --parameters portNumber=%p
  IPQoS lowdelay throughput

# The same machine for trajectory-route@.service, which runs unattended, so it
# signs in with its own key file instead of 1Password and never waits on a
# prompt. trajectory-route.sh makes the key; its public half is in ubuntu's
# authorized_keys on sami-agents.
Host trajectory-route
  HostName i-01d7575cd0d055f0e
  User ubuntu
  HostKeyAlias sami-agents.tailb86685.ts.net
  IdentityFile ~/.ssh/trajectory-route
  IdentitiesOnly yes
  IdentityAgent none
  ForwardAgent no
  ProxyCommand aws ssm start-session --region us-west-2 --target %h --document-name AWS-StartSSHSession --parameters portNumber=%p
  IPQoS lowdelay throughput

# Oryx through Cloudflare Access. The host-key alias is only the label under
# which known_hosts holds oryx's key.
Host oryx
  HostName oryx.thecybermonk.com
  User agent
  ForwardAgent yes
  ProxyCommand cloudflared access ssh --hostname %h
  HostKeyAlias oryx.tail12ec1c.ts.net
  IPQoS lowdelay throughput

# Oryx over AWS Session Manager. The host-key alias is only the label under
# which known_hosts holds oryx's key.
Host oryx-ssm
  HostName mi-0c13e59d491bb8ade
  User agent
  ForwardAgent yes
  HostKeyAlias oryx.tail12ec1c.ts.net
  ProxyCommand aws ssm start-session --profile personal --region us-west-2 --target %h --document-name AWS-StartSSHSession --parameters portNumber=%p
  IPQoS lowdelay throughput

# The forwarding-only Cloudflare Access connection for the oryx pair. The
# forward-tunnel@oryx unit opens it with its service token in the environment.
# The host-key alias is only the label under which known_hosts holds oryx's key.
Host oryx-tunnel
  HostName oryx-pcsc.thecybermonk.com
  User agent
  HostKeyAlias oryx.tail12ec1c.ts.net
  ProxyCommand cloudflared access ssh --hostname %h
  IdentityFile ~/.ssh/oryx-tunnel
  IdentitiesOnly yes
  IdentityAgent none
  ForwardAgent no
  ControlMaster no
  ControlPath none
  StrictHostKeyChecking yes
  BatchMode yes
  ExitOnForwardFailure yes
  ServerAliveInterval 15
  ServerAliveCountMax 4
  RemoteForward 127.0.0.1:12800 127.0.0.1:12800
  RemoteForward 127.0.0.1:12803 127.0.0.1:12803
  RemoteForward 127.0.0.1:12804 127.0.0.1:12804
  RemoteForward 127.0.0.1:12806 127.0.0.1:12806
  LocalForward 127.0.0.1:12801 127.0.0.1:12801
  LocalForward 127.0.0.1:12802 127.0.0.1:12802
  LocalForward 127.0.0.1:12805 127.0.0.1:12805
  RemoteForward 127.0.0.1:5038 127.0.0.1:5037
  RemoteForward 127.0.0.1:2223 sami-devbox:22
  RemoteForward 127.0.0.1:2224 ghost-wispr:22

# Every login key lives in 1Password, except trajectory-route's key file.
Host *
  IdentityAgent ~/.1password/agent.sock
  Compression yes
  ControlMaster auto
  ControlPath ~/.ssh/sockets/%r@%h-%p
  ControlPersist 600
  ServerAliveInterval 30
  ServerAliveCountMax 3
  TCPKeepAlive yes
