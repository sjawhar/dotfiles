Include ~/.ssh/config.local

# ssh takes the first value it finds for each option, so per-host settings sit
# above the Host * defaults at the bottom.

# sami-agents, the Trajectory devbox, over AWS Session Manager: it is on the old
# tailnet, which this laptop has left, so this is the only way in. Needs a live
# AWS SSO login for the Trajectory account. The host key is the one pinned for
# its old tailnet name.
Host devbox-ssm
  HostName i-01d7575cd0d055f0e
  User ubuntu
  ForwardAgent yes
  HostKeyAlias sami-agents.tailb86685.ts.net
  ProxyCommand aws ssm start-session --region us-west-2 --target %h --document-name AWS-StartSSHSession --parameters portNumber=%p
  IPQoS lowdelay throughput

# The same machine for trajectory-route@.service, which runs unattended, so it
# signs in with its own key file instead of 1Password and never waits on a
# prompt. trajectory-route.sh makes the key; its public half is in ubuntu's
# authorized_keys on sami-agents.
Host trajectory-route
  HostName i-01d7575cd0d055f0e
  User ubuntu
  HostKeyAlias sami-agents.tailb86685.ts.net
  IdentityFile ~/.ssh/trajectory-route
  IdentitiesOnly yes
  IdentityAgent none
  ForwardAgent no
  ProxyCommand aws ssm start-session --region us-west-2 --target %h --document-name AWS-StartSSHSession --parameters portNumber=%p
  IPQoS lowdelay throughput

Host oryx
  HostName oryx.tail12ec1c.ts.net
  User agent
  ForwardAgent yes
  # YubiKey access for sops human tier: use `devbox oryx` (scripts/devbox),
  # which ensures the oryx-tunnel below exists before connecting. Works with mosh.
  IPQoS lowdelay throughput

# oryx over AWS Session Manager (hybrid node in the personal AWS account), so
# it stays reachable whichever tailnet it or the laptop is on. sshd's host key
# is the one already pinned for its tailnet name.
Host oryx-ssm
  HostName mi-0c13e59d491bb8ade
  User agent
  ForwardAgent yes
  HostKeyAlias oryx.tail12ec1c.ts.net
  ProxyCommand aws ssm start-session --profile personal --region us-west-2 --target %h --document-name AWS-StartSSHSession --parameters portNumber=%p
  IPQoS lowdelay throughput

# YubiKey tunnel for oryx (scripts/devbox); every other devbox uses forward's pcsc channel.
Host oryx-tunnel
  HostName oryx.tail12ec1c.ts.net
  User agent
  Port 2222
  IdentityFile ~/.ssh/oryx-tunnel
  IdentitiesOnly yes
  ControlPath ~/.ssh/sockets/tunnel-%r@%h
  ControlPersist no
  ExitOnForwardFailure yes
  ServerAliveInterval 15
  RemoteForward 127.0.0.1:12799 /run/pcscd/pcscd.comm

# Every login key lives in 1Password, except trajectory-route's key file.
Host *
  IdentityAgent ~/.1password/agent.sock
  Compression yes
  ControlMaster auto
  ControlPath ~/.ssh/sockets/%r@%h-%p
  ControlPersist 600
  ServerAliveInterval 30
  ServerAliveCountMax 3
  TCPKeepAlive yes
