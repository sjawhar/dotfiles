# joycon-remap's output is "Joy-Cons Luna Virtual" (device-id 057e:2008).
# Grant uaccess so the logged-in user (Brave) can read it. joycond does not
# touch it (2008 is not in joycond's grab list, and the "Virtual" name matches
# joycond's own *Virtual* exclusion), so this rule only guarantees read access.
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="Joy-Cons Luna Virtual", TAG+="uaccess"

# Stable symlink for joycond's combined device (joycon-remap's input; the
# event number changes per connection).
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="Nintendo Switch Combined Joy-Cons", SYMLINK+="input/joycon-combined"

# Hide joycond's combined device from browsers. Chromium treats every
# software-made controller (all under /sys/devices/virtual/input/) as one device
# and reads only the newest, so when the Joy-Cons re-join, the combined device
# (grabbed by joycon-remap, so silent) would take Brave off "Joy-Cons Luna
# Virtual". Chromium skips input devices without ID_INPUT_JOYSTICK.
SUBSYSTEM=="input", ATTRS{name}=="Nintendo Switch Combined Joy-Cons", ENV{ID_INPUT_JOYSTICK}=""
