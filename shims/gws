#!/bin/bash
# gws wrapper: one Google identity per profile, with every profile's credential
# read from secretsd, so the same profiles work on every machine.
#
# Resolution order (first match wins):
#   1. GOOGLE_WORKSPACE_CLI_TOKEN or GOOGLE_WORKSPACE_CLI_CREDENTIALS_FILE
#      already set -> the caller controls gws credentials; exec.
#   2. First non-flag argument is `schema` -> exec with no credential. It reads
#      Google's public discovery documents, so it needs no identity.
#   3. First non-flag argument is `auth` -> inject NOTHING. `gws auth *`
#      operates on the credential store itself, and `gws auth login` is how the
#      credential rule 5 consumes gets created. If the caller set
#      GOOGLE_WORKSPACE_CLI_CONFIG_DIR, exec through with no profile needed;
#      otherwise GWS_ACCOUNT is required and CONFIG_DIR defaults to that
#      profile's store.
#   4. Otherwise GWS_ACCOUNT must name one of GWS_PROFILES; unset, empty, or any
#      other value is an error. There is no default identity.
#   5. GWS_<PROFILE>_SEND_OAUTH set -> the caller fetched that profile's
#      human-tier Gmail send credential (`secrets GWS_<PROFILE>_SEND_OAUTH --
#      gws gmail +send …`, one YubiKey touch per grant); materialize it instead
#      of the read credential, against a private temporary store removed when
#      gws exits. The read and send keys share one OAuth client, so in the
#      profile's store gws would reuse the cached read-only access token (and a
#      later read could pick up the send one). The shim never fetches a send key
#      itself. A GWS_*_SEND_OAUTH named for any other profile is an error: run
#      on the read credential instead, the send would fail as a scope error.
#   6. GWS_<PROFILE>_READ_OAUTH set -> materialize it to a 0600 tempfile against
#      that profile's store, run real gws, clean up. Otherwise re-exec under
#      `secrets` to obtain it first.
#
# Every run of real gws unsets every GWS_*_OAUTH variable: a credential reaches
# real gws as a 0600 file and by no other route.
#
# `secrets` here is secretsd's client, called directly. These credentials come
# from secretsd on every machine, never from the agent-secrets broker, so this
# shim does not use scripts/secret-run, which sends registered agent sessions to
# the broker.
#
# Doctrine (matches gh -> gh-app-token): fail LOUD where a credential is supposed
# to exist. A missing credential is an error, not a reason to run gws bare
# against whatever ~/.config/gws happens to hold.
set -euo pipefail

readonly -a GWS_PROFILES=(personal theorem trajectory)

set_credential_unset_args() {
    # CREDENTIAL_UNSET_ARGS := `-u NAME` for the re-exec guard and every set
    # GWS_*_OAUTH variable, computed at run time so a new profile's key needs no
    # list of its own.
    CREDENTIAL_UNSET_ARGS=(-u GWS_SHIM_SECRETS_REEXEC)
    local name
    for name in $(compgen -v); do
        if [[ "$name" == GWS_*_OAUTH ]]; then
            CREDENTIAL_UNSET_ARGS+=(-u "$name")
        fi
    done
}

exec_real_gws() {
    local real_gws="$1"
    shift
    set_credential_unset_args
    exec env "${CREDENTIAL_UNSET_ARGS[@]}" "$real_gws" "$@"
}

find_real_gws() {
    local self candidate
    self="$(readlink -f "${BASH_SOURCE[0]}")"
    while IFS= read -r candidate; do
        [[ "$(readlink -f "$candidate")" == "$self" ]] && continue
        printf '%s\n' "$candidate"
        return 0
    done < <(type -ap gws)
    # MCP servers and other spawners run with PATHs that carry neither the dotfiles
    # nor the mise shims; fall back to known install locations before failing. The
    # direct install binary comes FIRST: mise's own shim needs mise's env and dies
    # under a minimal environment ("gws is not a valid shim").
    for candidate in "$HOME"/.mise/installs/npm-googleworkspace-cli/*/bin/gws "$HOME/.mise/shims/gws"; do
        if [[ -x "$candidate" && "$(readlink -f "$candidate")" != "$self" ]]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    echo "gws shim: real gws binary not found on PATH or in mise installs" >&2
    return 127
}

find_secrets() {
    local candidate
    if command -v secrets; then
        return 0
    fi
    candidate="$HOME/.mise/installs/secrets/latest/bin/secrets"
    if [[ -x "$candidate" ]]; then
        printf '%s\n' "$candidate"
        return 0
    fi
    echo "gws shim: secrets not found on PATH or in mise installs" >&2
    return 127
}

find_jq() {
    local candidate
    if command -v jq; then
        return 0
    fi
    candidate="$HOME/.mise/installs/jq/1.8.2/jq"
    if [[ -x "$candidate" ]]; then
        printf '%s\n' "$candidate"
        return 0
    fi
    echo "gws shim: jq not found on PATH or in mise installs" >&2
    return 127
}

reexec_under_secrets() {
    # Agent-tier credentials enter only through secrets' environment injection.
    # The guard turns a successful-but-empty secrets invocation into a loud error.
    local key="$1"
    shift
    if [[ -n "${GWS_SHIM_SECRETS_REEXEC:-}" ]]; then
        echo "gws shim: ${key} still unset after re-exec under secrets" >&2
        exit 1
    fi
    local self secrets_bin
    self="$(readlink -f "${BASH_SOURCE[0]}")"
    secrets_bin="$(find_secrets)"
    GWS_SHIM_SECRETS_REEXEC=1 exec "$secrets_bin" "$key" -- "$self" "$@"
}

# gws's own grammar is `gws <service> <resource> ... [flags]` — it parses the first
# non-flag argument as the service, and rejects anything else ("Unknown service
# 'json'" for `gws --format json auth status`). Matching that exactly is the point:
# this helper must agree with gws about what the subcommand is, or the auth bypass
# fires on the wrong commands. Verified against gws 0.22.5.
first_arg() {
    # First non-flag argument, so `gws --json auth status` still routes like
    # `gws auth status`. A global flag taking a SEPARATE value would shadow the
    # subcommand; nothing invokes gws that way, and if something ever does, the
    # failure mode is the pre-bypass behaviour -- a re-exec under `secrets` that
    # fails loudly when the credential does not exist yet, not a silent wrong answer.
    local arg
    for arg in "$@"; do
        [[ "$arg" == -* ]] && continue
        printf '%s\n' "$arg"
        return 0
    done
}

profiles_list() {
    local IFS=' '
    printf '%s' "${GWS_PROFILES[*]}"
}

require_profile() {
    local profile="${GWS_ACCOUNT:-}"
    if [[ -z "$profile" ]]; then
        echo "gws shim: set GWS_ACCOUNT to one of: $(profiles_list)" >&2
        exit 1
    fi
    local candidate
    for candidate in "${GWS_PROFILES[@]}"; do
        if [[ "$candidate" == "$profile" ]]; then
            printf '%s\n' "$profile"
            return 0
        fi
    done
    echo "gws shim: GWS_ACCOUNT must be one of: $(profiles_list), got '${profile}'" >&2
    exit 1
}

materialize_and_run() {
    # Write an authorized_user JSON into a private temporary directory, point real
    # gws at it, and run it against STORE, the gws config dir that holds its token
    # cache. An empty STORE means a private store inside that directory, removed
    # with the credential.
    local real_gws="$1" store="$2" creds_json="$3"
    shift 3
    local tmp_dir creds_file jq client_id client_secret
    tmp_dir="$(mktemp -d)"
    # Single-quoted so $tmp_dir expands when the trap FIRES, not when it is set
    # (SC2064). Double quotes here would expand it immediately, to the empty string.
    trap 'rm -rf -- "$tmp_dir"' EXIT
    creds_file="${tmp_dir}/credential.json"
    if [[ -z "$store" ]]; then
        store="${tmp_dir}/store"
    fi
    if (umask 077 && printf '%s' "$creds_json" > "$creds_file"); then
        :
    else
        exit "$?"
    fi
    jq="$(find_jq)"
    if client_id="$("$jq" -r '.client_id // empty' "$creds_file")"; then
        :
    else
        exit "$?"
    fi
    if [[ -z "$client_id" ]]; then
        echo "gws shim: credential is missing a non-empty client_id" >&2
        exit 1
    fi
    if client_secret="$("$jq" -r '.client_secret // empty' "$creds_file")"; then
        :
    else
        exit "$?"
    fi
    if [[ -z "$client_secret" ]]; then
        echo "gws shim: credential is missing a non-empty client_secret" >&2
        exit 1
    fi
    # The `secrets KEY -- <self>` re-exec EXPORTS the credential JSON into our own
    # environment; the unset list keeps it, and every other GWS_*_OAUTH key, out of
    # real gws, so the credential reaches it only as the file. Real gws runs as a
    # child, not an exec, so the EXIT trap removes the file afterwards.
    # GOOGLE_APPLICATION_CREDENTIALS points at the same file: without it, gws uses
    # the machine ADC's quota project, and another account's ADC produces a 403 that
    # names that unrelated project.
    set_credential_unset_args
    if GOOGLE_APPLICATION_CREDENTIALS="$creds_file" \
        GOOGLE_WORKSPACE_CLI_CREDENTIALS_FILE="$creds_file" \
        GOOGLE_WORKSPACE_CLI_CONFIG_DIR="$store" \
        GOOGLE_WORKSPACE_CLI_CLIENT_ID="$client_id" \
        GOOGLE_WORKSPACE_CLI_CLIENT_SECRET="$client_secret" \
        env "${CREDENTIAL_UNSET_ARGS[@]}" "$real_gws" "$@"; then
        exit
    else
        exit "$?"
    fi
}

main() {
    local real_gws profile
    # split is load-bearing — `local x=$(cmd)` masks the command's exit status and would defeat fail-loud.
    real_gws="$(find_real_gws)"

    if [[ -n "${GOOGLE_WORKSPACE_CLI_TOKEN:-}" || -n "${GOOGLE_WORKSPACE_CLI_CREDENTIALS_FILE:-}" ]]; then
        exec_real_gws "$real_gws" "$@"
    fi

    if [[ "$(first_arg "$@")" == schema ]]; then
        exec_real_gws "$real_gws" "$@"
    fi

    # Never override a CONFIG_DIR the caller already set: that is how provisioning a
    # specific store works. Only without one does a profile pick the store.
    if [[ "$(first_arg "$@")" == auth ]]; then
        if [[ -z "${GOOGLE_WORKSPACE_CLI_CONFIG_DIR:-}" ]]; then
            profile="$(require_profile)"
            export GOOGLE_WORKSPACE_CLI_CONFIG_DIR="${HOME}/.config/gws/${profile}"
        fi
        exec_real_gws "$real_gws" "$@"
    fi

    profile="$(require_profile)"
    local send_key="GWS_${profile^^}_SEND_OAUTH" name
    for name in $(compgen -v); do
        if [[ "$name" == GWS_*_SEND_OAUTH && "$name" != "$send_key" && -n "${!name:-}" ]]; then
            echo "gws shim: ${name} is set but GWS_ACCOUNT=${profile} sends with ${send_key}; set GWS_ACCOUNT to the profile ${name} belongs to, or fetch ${send_key}" >&2
            exit 1
        fi
    done
    if [[ -n "${!send_key:-}" ]]; then
        materialize_and_run "$real_gws" "" "${!send_key}" "$@"
    fi
    local key="GWS_${profile^^}_READ_OAUTH"
    if [[ -n "${!key:-}" ]]; then
        materialize_and_run "$real_gws" "${HOME}/.config/gws/${profile}" "${!key}" "$@"
    fi
    reexec_under_secrets "$key" "$@"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
