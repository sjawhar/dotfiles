#!/bin/bash
# pulumi with a state backend named only when the CLI would otherwise find none.
#
# Pulumi CLI 3.268.0 that reaches no state backend at all, and recognizes a coding agent around
# it (it reads CLAUDECODE, CURSOR_AGENT, CODEX_*, GEMINI_CLI, OPENCODE, AI_AGENT and others),
# creates an ephemeral Pulumi Cloud account of its own, writes the claim in
# /tmp/.pulumi/agent-claim.json and prints a claim URL. One such account was created on this box
# on 2026-10-28 by an agent that only ran `pulumi package add`.
#
# PULUMI_BACKEND_URL outranks a `pulumi login` and a project file's own `backend.url` rather than
# falling back to either, and this box hosts programs on more than one real backend, so a shim
# that set it unconditionally would silently redirect real state. This one sets it only when the
# CLI would find no backend at all: PULUMI_BACKEND_URL unset or empty, PULUMI_ACCESS_TOKEN unset
# or empty (it names Pulumi Cloud), no non-empty `current` in the credentials file a `pulumi
# login` writes, and no `backend.url` in the Pulumi.yaml or Pulumi.yml the command would read
# (searched upward from the working directory, which `--cwd`/`-C` moves). In every other case it
# changes nothing about the backend.
#
# PULUMI_SKIP_UPDATE_CHECK is set either way: no caller here acts on the CLI's own update notice.
#
# Otherwise the shim is transparent: same argv, same stdin and stdout, same exit code, and no
# output of its own on the success path.
set -euo pipefail

self="$(readlink -f "${BASH_SOURCE[0]}")"
self_dir="$(dirname "$self")"

# The first pulumi past this shim's own PATH entry; from the top, skipping this file, when the
# shim was run by path from outside PATH (shims/ssh-keygen's lookup).
real=""
past_self=false
IFS=: read -ra path_dirs <<< "${PATH:-}"
for pass in after-self from-top; do
    for d in "${path_dirs[@]}"; do
        [ -n "$d" ] || continue
        if [ "$(readlink -f "$d" 2>/dev/null)" = "$self_dir" ]; then
            past_self=true
            continue
        fi
        [ "$pass" = from-top ] || $past_self || continue
        if [ -x "$d/pulumi" ] && [ "$(readlink -f "$d/pulumi")" != "$self" ]; then
            real="$d/pulumi"
            break 2
        fi
    done
    $past_self && break
done

# mise_paths: mise as this machine runs it, whatever HOME and PATH the caller set
# (shims/AGENTS.md, "A moved HOME"). A Legion test pane runs a shim with a
# temporary HOME and the PATH <bin>:/usr/local/bin:/usr/bin:/bin, where every
# path under HOME names nothing. Sets, once per process:
#   _mise_bin     mise on PATH, else the dotfiles checkout's bin/mise
#   _mise_config  mise's global configuration: MISE_GLOBAL_CONFIG_FILE, else the
#                 file under HOME when it is readable, else the checkout's
#                 mise.toml, which installers link that file to
#   _mise_datas   the data dirs a tool may be installed in: MISE_DATA_DIR and mise's
#                 default ~/.local/share/mise under HOME; with no MISE_DATA_DIR,
#                 ~/.mise (.bashrc's) and that default, under HOME, then the passwd home's
#   _mise_data    the one to give mise: MISE_DATA_DIR, else the first that exists
# The checkout is DOTFILES_DIR, else the one this file's own path is in.
mise_paths() {
    local IFS=$' \t\n'
    local self dotfiles home dir data seen=""
    local -a all=()
    [[ -z "${_mise_config:-}" ]] || return 0
    _mise_bin=""
    IFS=':'
    for dir in ${PATH:-}; do
        if [[ -n "$dir" && -f "$dir/mise" && -x "$dir/mise" ]]; then
            _mise_bin="$dir/mise"
            break
        fi
    done
    IFS=$' \t\n'
    _mise_config="${MISE_GLOBAL_CONFIG_FILE:-${XDG_CONFIG_HOME:-${HOME:-}/.config}/mise/config.toml}"
    if [[ -z "$_mise_bin" || ( -z "${MISE_GLOBAL_CONFIG_FILE:-}" && ! -r "$_mise_config" ) ]]; then
        dotfiles="${DOTFILES_DIR:-}"
        if [[ -z "$dotfiles" ]]; then
            self="$(command -p readlink -f -- "${BASH_SOURCE[0]}")" || self=""
            dotfiles="${self%/shims/*}"
        fi
        [[ -n "$_mise_bin" ]] || _mise_bin="$dotfiles/bin/mise"
        [[ -n "${MISE_GLOBAL_CONFIG_FILE:-}" || -r "$_mise_config" ]] || _mise_config="$dotfiles/mise.toml"
    fi
    if [[ -n "${MISE_DATA_DIR:-}" ]]; then
        all=("$MISE_DATA_DIR" "${XDG_DATA_HOME:-${HOME:-}/.local/share}/mise")
    else
        all=("${HOME:-}/.mise" "${XDG_DATA_HOME:-${HOME:-}/.local/share}/mise")
        # With HOME unset, ~ is the uid's home in the passwd database, which HOME does not move.
        local HOME
        unset HOME
        home=~
        [[ "$home" != /?* ]] || all+=("$home/.mise" "$home/.local/share/mise")
    fi
    _mise_datas=() _mise_data="${MISE_DATA_DIR:-}"
    for data in "${all[@]}"; do
        [[ "$data" == /?* && ":$seen:" != *":$data:"* ]] || continue
        seen+=":$data"
        _mise_datas+=("$data")
        [[ -n "$_mise_data" || ! -d "$data" ]] || _mise_data="$data"
    done
    : "${_mise_data:=${_mise_datas[0]:-}}"
}

# is_mise_shim FILE: whether FILE is mise's own shim, a file in the shims dir of
# one of mise's data dirs or a link to mise. It reaches its tool only where mise
# reads its config and trust list under HOME, which a moved HOME hides.
is_mise_shim() {
    local IFS=$' \t\n'
    local data
    mise_paths
    for data in ${_mise_datas[@]+"${_mise_datas[@]}"}; do
        [[ "${1%/*}" -ef "$data/shims" ]] && return 0
    done
    [[ -L "$1" && "$(command -p readlink -f -- "$1")" == */mise ]]
}

# mise off PATH: pulumi is a mise-managed tool (`pulumi` in mise.toml), and a unit's or a test
# harness's PATH can hold this dir without mise's shims dir. mise's own shim on PATH under a HOME
# that holds no mise configuration (a moved HOME) would refuse, so mise is asked here too
# (shims/az's lookup): the directory's own pin first, then the machine's (`-C /`), since under a
# moved HOME mise has no record of trusting the directory's configuration.
if [ -z "$real" ] || { is_mise_shim "$real" && [ "$_mise_config" != "${XDG_CONFIG_HOME:-${HOME:-}/.config}/mise/config.toml" ]; }; then
    mise_paths
    found="$(MISE_DATA_DIR="$_mise_data" MISE_GLOBAL_CONFIG_FILE="$_mise_config" "$_mise_bin" which pulumi 2>/dev/null)" \
        || found="$(MISE_DATA_DIR="$_mise_data" MISE_GLOBAL_CONFIG_FILE="$_mise_config" "$_mise_bin" which -C / pulumi 2>/dev/null)" || found=""
    if [ -n "$found" ] && [ -x "$found" ] && [ "$(readlink -f "$found")" != "$self" ]; then
        real="$found"
    fi
fi
[ -n "$real" ] || { echo "shims/pulumi: no real pulumi on PATH ($PATH), and $_mise_bin, given $_mise_config and the data dir $_mise_data, names none" >&2; exit 127; }

export PULUMI_SKIP_UPDATE_CHECK=true

# The directory the command reads its project file from: --cwd/-C, else this one.
project_dir="$PWD"
take_next=false
for arg in "$@"; do
    if $take_next; then
        project_dir="$arg"
        take_next=false
        continue
    fi
    case "$arg" in
        --cwd|-C) take_next=true ;;
        --cwd=*) project_dir="${arg#--cwd=}" ;;
        -C=*) project_dir="${arg#-C=}" ;;
    esac
done

# Whether a Pulumi.yaml or Pulumi.yml at or above dir declares backend.url. Pulumi reads the
# first project file it finds walking up; a `backend:` mapping with a `url:` under it names the
# backend. The scan stops at the first project file, as Pulumi does.
project_names_backend() {
    local dir file
    dir="$(cd "$1" 2>/dev/null && pwd -P)" || return 1
    while :; do
        for file in "$dir/Pulumi.yaml" "$dir/Pulumi.yml"; do
            [ -f "$file" ] || continue
            awk '
                /^[^[:space:]#]/ { in_backend = ($0 ~ /^backend:[[:space:]]*$/) ; next }
                in_backend && /^[[:space:]]+url:[[:space:]]*[^[:space:]]/ { found = 1 }
                END { exit found ? 0 : 1 }
            ' "$file" && return 0
            return 1
        done
        [ "$dir" != "/" ] || return 1
        dir="$(dirname "$dir")"
    done
}

# Whether a `pulumi login` left a current backend in the credentials file.
login_names_backend() {
    local creds
    creds="${PULUMI_HOME:-$HOME/.pulumi}/credentials.json"
    [ -f "$creds" ] || return 1
    [ -n "$(jq -r '.current // empty' "$creds" 2>/dev/null)" ]
}

if [ -z "${PULUMI_BACKEND_URL:-}" ] && [ -z "${PULUMI_ACCESS_TOKEN:-}" ] \
    && ! login_names_backend && ! project_names_backend "$project_dir"; then
    export PULUMI_BACKEND_URL='file://~'
fi

exec "$real" "$@"
