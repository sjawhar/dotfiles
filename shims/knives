#!/usr/bin/env bash
# knives wrapper: exec a local knives build found on PATH past this shim, else the pinned
# release ("github:sjawhar/knives" in mise.toml), with its arguments and stdin untouched.
# A session keeps the PATH it started with, and that PATH names the install dir of the knives
# pinned back then; this shim leads every session's PATH, so it moves them all to the pin.
set -euo pipefail

# --- never loop ---
# Every hop from here to knives is an exec, so a resolution that leads back into this shim
# enters it again in the same pid. knives does that once by design: a direct `knives gh`
# execs shims/gh (knives src/commands/gh.rs, `reentry_shim`), which execs `knives gh` again.
# A third entry in one pid within 10 s is a loop. The time bound lets through a later launch
# that inherited this marker from a long-lived process and happens to get its pid.
_marker_pid="" _marker_at="" _marker_entry="" _marker_target=""
read -r _marker_pid _marker_at _marker_entry _marker_target <<< "${DOTFILES_KNIVES_SHIM:-}"
_now="${EPOCHSECONDS:-$(date +%s)}"
_entry=1
if [[ "$_marker_pid" == "$$" && "$_marker_at" =~ ^[0-9]+$ && "$_marker_entry" =~ ^[0-9]+$ ]] \
    && (( _now - 10#$_marker_at < 10 )); then
    _entry=$(( 10#$_marker_entry + 1 ))
fi
if (( _entry > 2 )); then
    echo "knives: ${BASH_SOURCE[0]} entered $_entry times in pid $$: the knives it resolved (${_marker_target}) leads back to a knives wrapper; refusing to loop (see \`type -a knives\` and \`mise which -C / knives --tool github:sjawhar/knives\`)" >&2
    exit 1
fi

# mise_paths: mise as this machine runs it, whatever HOME and PATH the caller set
# (shims/AGENTS.md, "A moved HOME"). A Legion test pane runs a shim with a
# temporary HOME and the PATH <bin>:/usr/local/bin:/usr/bin:/bin, where every
# path under HOME names nothing. Sets, once per process:
#   _mise_bin     mise on PATH, else the dotfiles checkout's bin/mise, else the
#                 mise the shims in a data dir link to (a copy or a worktree of
#                 the checkout has no bin/, which is not committed)
#   _mise_config  mise's global configuration: MISE_GLOBAL_CONFIG_FILE, else the
#                 file under HOME when it is readable, else the checkout's
#                 mise.toml, which installers link that file to
#   _mise_datas   the data dirs a tool may be installed in: MISE_DATA_DIR and mise's
#                 default ~/.local/share/mise under HOME; with no MISE_DATA_DIR,
#                 ~/.mise (.bashrc's) and that default, under HOME, then the passwd home's
#   _mise_data    the one to give mise: MISE_DATA_DIR, else the first that exists
# The checkout is DOTFILES_DIR, else the one this file's own path is in.
mise_paths() {
    local IFS=$' \t\n'
    local self dotfiles home dir data seen=""
    local -a all=()
    [[ -z "${_mise_config:-}" ]] || return 0
    _mise_bin=""
    IFS=':'
    for dir in ${PATH:-}; do
        if [[ -n "$dir" && -f "$dir/mise" && -x "$dir/mise" ]]; then
            _mise_bin="$dir/mise"
            break
        fi
    done
    IFS=$' \t\n'
    _mise_config="${MISE_GLOBAL_CONFIG_FILE:-${XDG_CONFIG_HOME:-${HOME:-}/.config}/mise/config.toml}"
    if [[ -z "$_mise_bin" || ( -z "${MISE_GLOBAL_CONFIG_FILE:-}" && ! -r "$_mise_config" ) ]]; then
        dotfiles="${DOTFILES_DIR:-}"
        if [[ -z "$dotfiles" ]]; then
            self="$(command -p readlink -f -- "${BASH_SOURCE[0]}")" || self=""
            dotfiles="${self%/shims/*}"
        fi
        [[ -n "$_mise_bin" ]] || _mise_bin="$dotfiles/bin/mise"
        [[ -n "${MISE_GLOBAL_CONFIG_FILE:-}" || -r "$_mise_config" ]] || _mise_config="$dotfiles/mise.toml"
    fi
    if [[ -n "${MISE_DATA_DIR:-}" ]]; then
        all=("$MISE_DATA_DIR" "${XDG_DATA_HOME:-${HOME:-}/.local/share}/mise")
    else
        all=("${HOME:-}/.mise" "${XDG_DATA_HOME:-${HOME:-}/.local/share}/mise")
        # With HOME unset, ~ is the uid's home in the passwd database, which HOME does not move.
        local HOME
        unset HOME
        home=~
        [[ "$home" != /?* ]] || all+=("$home/.mise" "$home/.local/share/mise")
    fi
    _mise_datas=() _mise_data="${MISE_DATA_DIR:-}"
    for data in "${all[@]}"; do
        [[ "$data" == /?* && ":$seen:" != *":$data:"* ]] || continue
        seen+=":$data"
        _mise_datas+=("$data")
        [[ -n "$_mise_data" || ! -d "$data" ]] || _mise_data="$data"
    done
    if [[ ! -f "$_mise_bin" || ! -x "$_mise_bin" ]]; then
        for data in ${_mise_datas[@]+"${_mise_datas[@]}"}; do
            for dir in "$data"/shims/*; do
                [[ -L "$dir" ]] || continue
                dir="$(command -p readlink -f -- "$dir")" || dir=""
                [[ "$dir" != */mise || ! -f "$dir" || ! -x "$dir" ]] || _mise_bin="$dir"
                break
            done
            [[ ! -x "$_mise_bin" ]] || break
        done
    fi
    : "${_mise_data:=${_mise_datas[0]:-}}"
}

# --- resolve: a local build past this shim on PATH, else the pinned release ---
# Entries ahead of this shim's own (`-ef`: its dir however PATH spells it) had their turn.
# mise's dirs are skipped, never matched: the install dir an inherited PATH names is the pin
# of the day the session started. A knives whose real path is in a `shims/` dir is a wrapper
# (this file under another name, another checkout's copy), not a build.
mise_paths
_mise_root="$_mise_data"
IFS=':' read -ra _dirs <<< "$PATH"
for _i in "${!_dirs[@]}"; do
    if [[ "${_dirs[_i]}/knives" -ef "${BASH_SOURCE[0]}" ]]; then
        _dirs=("${_dirs[@]:_i+1}")
        break
    fi
done
_knives=""
for _d in "${_dirs[@]}"; do
    [[ -n "$_d" && "$_d" != "$_mise_root"/* && -f "$_d/knives" && -x "$_d/knives" ]] || continue
    _real="$(realpath "$_d/knives")"
    [[ "${_real%/*}" == */shims ]] && continue
    _knives="$_d/knives"
    break
done
if [[ -z "$_knives" ]]; then
    # The machine's pin, never a project's (`-C /`): the knives plugin every session loads is
    # pinned machine-wide beside it (omp/plugins/package.json). An absolute path, so nothing
    # past here looks knives up on PATH; stdin stays knives' (a hook's event payload).
    # mise is asked last: under load, or while a `mise install` replaces the install dir, it
    # hung or said "knives <pin> is not installed" for minutes (2026-11-03 ~00:3x-01:00Z), and
    # every gh call (shims/gh execs `knives gh`) failed with it. So an exact version pinned in
    # mise's global config is run straight from an install dir, in each of mise's data dirs
    # (mise_paths); then from the path mise resolved for that version before.
    _config="$_mise_config"
    _pin=""
    if [[ -r "$_config" ]]; then
        _pin_re='^[[:space:]]*"github:sjawhar/knives"[[:space:]]*=[[:space:]]*"([0-9][0-9A-Za-z.+-]*)"'
        while IFS= read -r _line; do
            [[ "$_line" =~ $_pin_re ]] && { _pin="${BASH_REMATCH[1]}"; break; }
        done < "$_config"
    fi
    _tried=()
    _cache=""
    if [[ -n "$_pin" ]]; then
        for _root in "${_mise_datas[@]}"; do
            _candidate="$_root/installs/github-sjawhar-knives/$_pin/bin/knives"
            _tried+=("$_candidate")
            if [[ -f "$_candidate" && -x "$_candidate" ]]; then
                _knives="$_candidate"
                break
            fi
        done
        _cache="${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles-knives-shim/$_pin"
        if [[ -z "$_knives" ]]; then
            _tried+=("$_cache")
            _cached=""
            [[ -r "$_cache" ]] && IFS= read -r _cached < "$_cache" || true
            if [[ "$_cached" == /* && -f "$_cached" && -x "$_cached" ]]; then
                _knives="$_cached"
            fi
        fi
    fi
fi
if [[ -z "$_knives" ]]; then
    # mise lives in ~/.dotfiles/bin, which a unit's, harness's or credential helper's PATH can
    # leave out while it keeps this shim; then the shim runs that mise by its path
    # (mise_paths), given the configuration and data dir above. A call that fails or outlives
    # the timeout is tried once more (a reinstall's window, a lock).
    _mise="$_mise_bin"
    # Whole seconds, as the install's wait and cap, so the timeout check below can compare it.
    _mise_timeout="${DOTFILES_KNIVES_MISE_TIMEOUT:-20}"
    [[ "$_mise_timeout" =~ ^[1-9][0-9]*$ ]] || _mise_timeout=20
    _why=""
    for _attempt in 1 2; do
        _rc=0
        # The clock as EPOCHREALTIME gives it (whole seconds where bash has none), so the check
        # below is in microseconds.
        _start="${EPOCHREALTIME:-${EPOCHSECONDS:-$(date +%s)}.000000}"
        _knives="$(MISE_DATA_DIR="$_mise_root" MISE_GLOBAL_CONFIG_FILE="$_config" timeout "$_mise_timeout" "$_mise" which -C / knives --tool github:sjawhar/knives </dev/null)" || _rc=$?
        _end="${EPOCHREALTIME:-${EPOCHSECONDS:-$(date +%s)}.000000}"
        if (( _rc == 0 )) && [[ -n "$_knives" ]]; then
            break
        fi
        _knives=""
        # mise can exit 124 itself; only a call that lasted the whole timeout timed out.
        if (( _rc == 124 && ${_end/[.,]/} - ${_start/[.,]/} >= _mise_timeout * 1000000 )); then
            _why+="${_why:+; }attempt $_attempt timed out after ${_mise_timeout}s"
        else
            _why+="${_why:+; }attempt $_attempt exited $_rc"
        fi
        (( _attempt == 1 )) && sleep 1
    done
    # A pin no install dir holds is installed here, once per machine, and then run. A new pin
    # goes live the moment mise.toml changes on a machine (an edit saved in the live checkout,
    # a publish, a pull), and until a person ran `mise install`, every knives call, and so every
    # gh call (shims/gh execs `knives gh`), failed: 3.2.2 at 04:45Z on sami-leanperf and 3.2.3
    # at ~08:2xZ on sami-rocqperf, 2026-11-03.
    # The install holds <data dir>/.dotfiles-install.lock. dotfiles-follow, dotfiles-sync,
    # agent-session, installers/mise.sh and installers/librarian-harness-host.sh hold the same
    # lock around their `mise install`, so two installs into one data dir never run at the same
    # time. Agent boxes mount the data dir, so the host and its boxes install once between them.
    # A call that finds the lock held waits for the pin, not for the lock: the other install can
    # put the pin in place minutes before it lets go. A failed install is not tried again for
    # 60 s, so an outage does not make every gh call wait for an install of its own.
    # The call runs knives once its binary is in place and answers `--version` with the pin,
    # not when mise exits: after the install mise rebuilds every tool's shims, which took 2 to
    # 4.5 more minutes on sami-rocqperf at load ~650 (2026-11-03 09:1xZ; the knives itself took
    # 7 to 34 s). mise runs in its own session, under a wrapper that holds the lock until mise
    # exits, so a call that ends cuts off neither the install nor the lock.
    _install_log=""
    install_pin() {
        # Absolute, as dotfiles-follow and dotfiles-sync make it: the lock is the file they lock,
        # and mise installs into this dir.
        local data="$_mise_root"
        [[ "$data" == /* ]] || data="$PWD/$data"
        local installed="$data/installs/github-sjawhar-knives/$_pin/bin/knives"
        local lock="$data/.dotfiles-install.lock"
        local wait="${DOTFILES_KNIVES_INSTALL_TIMEOUT:-300}" cap="${DOTFILES_KNIVES_INSTALL_CAP:-600}"
        local fd="" rc=0 pid="" deadline announced="" locked="" status="" out_of_time="" detach=()
        # Whole seconds. wait: how long a call waits for the pin, first while another install
        # holds the lock, then while its own install runs. cap: how long its mise may run before
        # timeout sends TERM, and KILL 10 s later.
        [[ "$wait" =~ ^(0|[1-9][0-9]*)$ ]] || wait=300
        [[ "$cap" =~ ^[1-9][0-9]*$ ]] || cap=600
        _install_log="${_cache%/*}/install-$_pin.log"
        # Every holder of the lock gives the `mise install` it runs under it
        # DOTFILES_INSTALL_LOCK_HELD=1, and this shim does too (below). A knives call under such an
        # install (a git that mise starts asks gh for a credential, and gh runs `knives gh`) must
        # not wait on the lock its ancestor holds, so it ends here and the shim exits 127.
        [[ -z "${DOTFILES_INSTALL_LOCK_HELD:-}" ]] || return 1
        pin_in_place() {
            local version=""
            [[ -f "$installed" && -x "$installed" ]] &&
                version="$("$installed" --version < /dev/null 2> /dev/null)" &&
                [[ " $version " == *" $_pin "* ]]
        }
        # True, and says so, when the last install of this pin failed less than 60 s ago.
        failed_recently() {
            local failed_pin="" failed_at="" now="${EPOCHSECONDS:-$(date +%s)}"
            [[ -r "$lock.failed" ]] && read -r failed_pin failed_at < "$lock.failed" || true
            [[ "$failed_pin" == "$_pin" && "$failed_at" =~ ^[0-9]+$ ]] && (( now - 10#$failed_at < 60 )) || return 1
            echo "knives: the install of knives $_pin failed $(( now - 10#$failed_at ))s ago (log: $_install_log); not trying again for 60 s" >&2
        }
        mkdir -p "${_install_log%/*}" "$data" 2>/dev/null || true
        if command -v flock > /dev/null 2>&1 && exec {fd}>>"$lock"; then
            # Every 0.5 s, until the pin is in place (another install put it there) or this call
            # takes the lock.
            deadline=$(( ${EPOCHSECONDS:-$(date +%s)} + wait ))
            until pin_in_place; do
                if flock -n "$fd"; then
                    locked=1
                    break
                fi
                if failed_recently; then
                    rc=1
                    break
                fi
                if [[ -z "$announced" ]]; then
                    echo "knives: knives $_pin is not installed and $lock is held by another install; waiting up to ${wait}s for it" >&2
                    announced=1
                fi
                if (( ${EPOCHSECONDS:-$(date +%s)} >= deadline )); then
                    echo "knives: waited ${wait}s for $lock, which another install holds; knives $_pin is still not in place" >&2
                    rc=1
                    break
                fi
                sleep 0.5
            done
        fi
        # Only under the lock, or where no lock can be had (no flock, a lock file it cannot
        # open). A call that found the pin in place without the lock runs it.
        if (( rc == 0 )) && [[ -n "$locked" || -z "$fd" ]] && ! pin_in_place; then
            if failed_recently; then
                rc=1
            else
                echo "knives: knives $_pin (pinned in $_config) is not installed on this machine; installing it now (\`mise install github:sjawhar/knives@$_pin\`, log: $_install_log)" >&2
                command -v setsid > /dev/null 2>&1 && detach=(setsid)
                # The wrapper inherits the lock's fd and holds it until mise exits. mise runs
                # without it, so nothing mise leaves running holds the lock. The wrapper holds
                # none of the caller's stdin, stdout or stderr: its stdin is /dev/null and its
                # output goes to the log. Any other fd the caller passed down reaches it and mise.
                # shellcheck disable=SC2016  # the inner bash expands $1, $2, $fd, $cap and $@
                MISE_DATA_DIR="$data" MISE_GLOBAL_CONFIG_FILE="$_config" "${detach[@]}" "$BASH" -c '
                    fd=$1 cap=$2
                    shift 2
                    if [[ -n "$fd" ]]; then
                        DOTFILES_INSTALL_LOCK_HELD=1 timeout -k 10 "$cap" "$@" {fd}>&- &
                    else
                        DOTFILES_INSTALL_LOCK_HELD=1 timeout -k 10 "$cap" "$@" &
                    fi
                    wait "$!"' knives-install "$fd" "$cap" "$_mise" install -C / "github:sjawhar/knives@$_pin" \
                    < /dev/null > "$_install_log" 2>&1 &
                pid=$!
                deadline=$(( ${EPOCHSECONDS:-$(date +%s)} + wait ))
                # rc is 0 here. out_of_time says this call's own wait ran out. A wrapper that
                # ended reports timeout's status: mise's own, 124 where the TERM at the cap
                # stopped mise, 137 where the KILL did.
                while :; do
                    if (( ${EPOCHSECONDS:-$(date +%s)} >= deadline )); then
                        rc=1 out_of_time=1
                        break
                    fi
                    if pin_in_place; then
                        break
                    fi
                    if ! kill -0 "$pid" 2>/dev/null; then
                        status=0
                        wait "$pid" || status=$?
                        pin_in_place || rc=1
                        break
                    fi
                    sleep 0.5
                done
                if (( rc != 0 )); then
                    printf '%s %s\n' "$_pin" "${EPOCHSECONDS:-$(date +%s)}" > "$lock.failed" 2>/dev/null || true
                    if [[ -n "$out_of_time" ]]; then
                        echo "knives: \`mise install github:sjawhar/knives@$_pin\` had not put knives $_pin in place after ${wait}s; the end of its log:" >&2
                    else
                        echo "knives: \`mise install github:sjawhar/knives@$_pin\` exited $status without knives $_pin in place; the end of its log:" >&2
                    fi
                    tail -n 20 "$_install_log" >&2 || true
                fi
            fi
        fi
        [[ -z "$fd" ]] || exec {fd}>&-
        (( rc == 0 )) || return 1
        _knives="$installed"
    }
    if [[ -z "$_knives" && -n "$_pin" ]]; then
        install_pin || _knives=""
    fi
    if [[ -z "$_knives" ]]; then
        if [[ -n "$_pin" ]]; then
            echo "knives: ${BASH_SOURCE[0]}: knives $_pin (pinned in $_config) is not at any of: ${_tried[*]}; \`mise which\` did not resolve it ($_why; mise's errors are above), and this shim could not install it (above${_install_log:+; log: $_install_log}). Run \`mise install github:sjawhar/knives@$_pin\`." >&2
        else
            echo "knives: ${BASH_SOURCE[0]}: no exact github:sjawhar/knives version pinned in $_config, and mise did not resolve the pinned github:sjawhar/knives ($_why; its errors are above)" >&2
        fi
        exit 127
    fi
    # Remembered per pin, so a later call survives a mise outage too; never a wrapper.
    if [[ -n "$_cache" && "$_knives" == /* && "$(realpath "$_knives" 2>/dev/null)" != */shims/* ]]; then
        { mkdir -p "${_cache%/*}" \
            && printf '%s\n' "$_knives" > "$_cache.$$" \
            && mv -f "$_cache.$$" "$_cache"; } 2>/dev/null || rm -f "$_cache.$$" 2>/dev/null || true
    fi
fi
export DOTFILES_KNIVES_SHIM="$$ $_now $_entry $_knives"
exec "$_knives" "$@"
