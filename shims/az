#!/bin/bash
# az with this machine's own Azure identity in an agent session.
#
# The default az config dir (~/.azure) holds Sami's own `az login`, so every az call an agent
# makes without AZURE_CONFIG_DIR acts as Sami@Theorem.dev: on 2026-11-01 at 16:55Z three
# `az vm run-command invoke` calls on sami-leanperf ran under his account
# (dispatch://INFRA-6/ask/6c7b1e80-176f-40e3-967e-e5d642d501ec). The box has its own identity
# logged in at ~/.azure-box-identity (the VM's system-assigned managed identity, Contributor on
# resource group `sami`), which does the same work.
#
# So in an agent session with no AZURE_CONFIG_DIR of its own, the shim points az at that dir.
# An explicit AZURE_CONFIG_DIR (empty included) is kept: a caller that named a config dir chose
# one. Outside an agent session nothing changes, so Sami's interactive shell still runs as
# himself. The shim prints nothing of its own and passes argv, stdin, stdout and the exit code
# through.
#
# A machine whose box identity dir does not exist yet gets one on the first such call: the shim
# runs `az login --identity` into that dir, which signs the VM's own managed identity in and
# needs no person. Where that does not work either (no managed identity on the machine), the
# call goes through unchanged, unless the default dir holds a user login: that is the case this
# shim exists to stop, and it is reported instead of run.
#
# A Google VM (scripts/on-google-vm; sami-devbox, dispatch://INFRA-993) has no Azure managed
# identity. There the box dir holds the agents' own Azure identity `agent-azure` (a user-assigned
# managed identity, Virtual Machine Contributor on resource group SAMI; agent-infra
# box-identity/agentazure.go, theorem-labs/agent-infra#1146), whose federated credential trusts the
# Google ID tokens of the VM's account dev-sjawhar@ (subject its unique id, audience
# api://AzureADTokenExchange). The shim signs in with `az login --service-principal
# --federated-token`, the token straight from the metadata server, no secret anywhere. az keeps
# that token as the client assertion it trades for access tokens (azure/cli/core/auth/identity.py,
# client_assertion), and Google issues it for one hour, so the shim signs in again whenever the
# last sign-in is 20 minutes old or more, under a lock, so concurrent calls neither race nor ever
# hold an assertion near its expiry. The client id is Azure's, known once #1146 is applied (its
# output agentAzureClientId): AGENT_AZURE_CLIENT_ID, else the file
# ${XDG_CONFIG_HOME:-~/.config}/agent-azure/client-id that provisioning writes; without either the
# call stops and says so.
set -euo pipefail

self="$(readlink -f "${BASH_SOURCE[0]}")"
self_dir="$(dirname "$self")"

# The first az past this shim's own PATH entry; from the top, skipping this file and any other
# shims/ copy, when the shim was run by path from outside PATH (shims/ssh-keygen's lookup).
real=""
past_self=false
IFS=: read -ra path_dirs <<< "${PATH:-}"
for pass in after-self from-top; do
    for d in "${path_dirs[@]}"; do
        [ -n "$d" ] || continue
        if [ "$(readlink -f "$d" 2>/dev/null)" = "$self_dir" ]; then
            past_self=true
            continue
        fi
        [ "$pass" = from-top ] || $past_self || continue
        if [ -x "$d/az" ]; then
            resolved="$(readlink -f "$d/az")"
            [ "$resolved" != "$self" ] && [ "$(basename "$(dirname "$resolved")")" != shims ] || continue
            real="$d/az"
            break 2
        fi
    done
    $past_self && break
done
# mise off PATH: az is a mise-managed tool ("pipx:azure-cli" in mise.toml), and a unit's or a
# test harness's PATH can hold this dir without mise's shims dir.
if [ -z "$real" ]; then
    mise="$(command -v mise 2>/dev/null || true)"
    [ -n "$mise" ] || mise="${DOTFILES_DIR:-$HOME/.dotfiles}/bin/mise"
    real="$(MISE_DATA_DIR="${MISE_DATA_DIR:-$HOME/.mise}" "$mise" which -C / az --tool pipx:azure-cli 2>/dev/null)" || real=""
    [ -n "$real" ] && [ -x "$real" ] || real=""
fi
[ -n "$real" ] || { echo "shims/az: no real az on PATH" >&2; exit 127; }

# The one test every identity shim makes, copied into each of them (shims/AGENTS.md, "Who is an
# agent"): a session marker of any harness — omp, a pi tool bridge, Claude Code, an envoy
# session, an agent box, a Legion pane (LEGION_ROLE and the rest of its runtime-owned set,
# packages/daemon/internal/runtime/tmux/spawn.go) — or the gh-app routing include, or a command
# over SSH in a session with no terminal.
agent_context() {
    [[ -n "${OMP_SESSION_ID:-}${PI_SESSION_FILE:-}${PI_TOOL_BRIDGE_URL:-}${AGENTBOX_SESSION:-}${CLAUDECODE:-}${ENVOY_SESSION_ID:-}${AGENT_SHIM_AGENT:-}${LEGION_ROLE:-}${LEGION_TREE:-}${LEGION_CONTROLLER:-}${LEGION_DAEMON_URL:-}" ]] && return 0
    local i v
    for ((i = 0; i < ${GIT_CONFIG_COUNT:-0}; i++)); do
        v="GIT_CONFIG_VALUE_$i"
        [[ "${!v:-}" == *gh-app-routes.gitconfig ]] && return 0
    done
    # There is no exception for tmux. A pane takes the SERVER's environment, not the environment
    # of whoever asked for the pane, so "inside tmux means the person" let an agent's own
    # `tmux new-window` under the person's server produce a pane with no marker that then ran as
    # the person (round 3 of INFRA-1538). The fix is the other way round: shims/tmux and
    # scripts/agentbox-tmux-guard pass the caller's markers to the new pane with tmux's -e, so an
    # agent's pane carries them and is caught above.
    # A command that arrives over SSH in a session with no terminal (`ssh host az account show`)
    # is an agent's, not a person's: sshd gives a person's own session a terminal and names it in
    # SSH_TTY for the whole session, so a pipe into one command of it (`echo x | az …`, git
    # handing its credential helper the request) is still the person's, where testing this
    # command's own stdin made it an agent's. AGENT_SHIM_PERSON=1 is the person's escape for a
    # deliberate non-interactive SSH command of their own (INFRA-1538).
    if [[ -n "${SSH_CONNECTION:-}" && -z "${SSH_TTY:-}" && "${AGENT_SHIM_PERSON:-}" != 1 ]]; then
        AGENT_CONTEXT_VIA_SSH=1
        return 0
    fi
    return 1
}

# Whether the SSH rule, and not a session marker, made this an agent's call: asked before
# anything is chosen, named after (the notice must report the config dir this call ends on, not a
# machine identity it has not selected; review of INFRA-1538).
_via_ssh=""
if agent_context; then _via_ssh="${AGENT_CONTEXT_VIA_SSH:-}"; fi

if [ -z "${AZURE_CONFIG_DIR+set}" ] && agent_context; then
    box="${AZURE_BOX_CONFIG_DIR:-$HOME/.azure-box-identity}"
    if "$self_dir/../scripts/on-google-vm"; then
        tenant=aaa6ad34-51af-41e7-891f-f16f5c53c396
        id_file="${XDG_CONFIG_HOME:-$HOME/.config}/agent-azure/client-id"
        client_id="${AGENT_AZURE_CLIENT_ID:-}"
        if [ -z "$client_id" ] && [ -r "$id_file" ]; then client_id="$(tr -d '[:space:]' < "$id_file")"; fi
        if [ -z "$client_id" ]; then
            echo "shims/az: this Google VM signs in to Azure as the agent-azure identity, and its client id is not known here." >&2
            echo "shims/az: set AGENT_AZURE_CLIENT_ID, or write it to $id_file (agent-infra box-identity output agentAzureClientId, theorem-labs/agent-infra#1146)." >&2
            exit 1
        fi
        mkdir -p "$box"
        exec 9> "$box/.agent-azure-login.lock"
        flock 9
        stamp="$box/.agent-azure-login"
        if [ ! -f "$box/azureProfile.json" ] || [ "$(cat "$stamp" 2> /dev/null)" != "$client_id" ] \
            || [ -z "$(find "$stamp" -mmin -20 2> /dev/null)" ]; then
            metadata="http://${GCE_METADATA_HOST:-metadata.google.internal}/computeMetadata/v1"
            if ! token="$(curl -fsS -m 10 --noproxy '*' -H 'Metadata-Flavor: Google' \
                "$metadata/instance/service-accounts/default/identity?audience=api://AzureADTokenExchange&format=full")" \
                || [ -z "$token" ]; then
                echo "shims/az: no Google ID token for audience api://AzureADTokenExchange from the metadata server ($metadata)." >&2
                exit 1
            fi
            # The token goes in on stdin, never on a command line. az's `@file` expansion opens the
            # named file and has no `-` for stdin, so the file is /dev/stdin.
            if ! out="$(printf '%s' "$token" | AZURE_CONFIG_DIR="$box" timeout 120 "$real" login --service-principal \
                --username "$client_id" --tenant "$tenant" --federated-token @/dev/stdin --only-show-errors --output none 2>&1)"; then
                rm -f "$stamp"
                echo "shims/az: az login --service-principal --federated-token as agent-azure ($client_id) failed:" >&2
                printf '%s\n' "$out" >&2
                exit 1
            fi
            printf '%s\n' "$client_id" > "$stamp"
        fi
        exec 9>&-
        export AZURE_CONFIG_DIR="$box"
    elif [ -f "$box/azureProfile.json" ]; then
        export AZURE_CONFIG_DIR="$box"
    elif mkdir -p "$box" 2> /dev/null \
        && AZURE_CONFIG_DIR="$box" timeout 60 "$real" login --identity --only-show-errors > /dev/null 2>&1 \
        && [ -f "$box/azureProfile.json" ]; then
        # First call on a machine whose box identity was never logged in: the VM's own
        # managed identity, signed in to its own profile, needs no person and no human step.
        export AZURE_CONFIG_DIR="$box"
    elif grep -q '"type"[[:space:]]*:[[:space:]]*"user"' "$HOME/.azure/azureProfile.json" 2> /dev/null; then
        echo "shims/az: $box holds no box identity, \`az login --identity\` there did not make one," >&2
        echo "shims/az: and ~/.azure holds a user login an agent must not use. Name a config dir to run this." >&2
        exit 1
    fi
fi

if [ -n "$_via_ssh" ]; then
    if [ -n "${AZURE_CONFIG_DIR+set}" ]; then
        _where="$AZURE_CONFIG_DIR"
    else
        _where="$HOME/.azure, this machine's default, which holds no user login"
    fi
    echo "az shim: non-interactive SSH, so an agent's call: AZURE_CONFIG_DIR=$_where (set AGENT_SHIM_PERSON=1 for your own login)" >&2
fi

exec "$real" "$@"
