#!/bin/bash
# gcloud wrapper: select a named gcloud configuration via GCLOUD_ACCOUNT,
# instead of typing CLOUDSDK_ACTIVE_CONFIG_NAME=<name> per command or mutating
# global state with `gcloud config configurations activate`.
#
# On a box, a plain `gcloud auth login` goes to Sami's `theorem`
# configuration instead of overwriting the machine's `box` identity. This
# applies only when `active_config` is `box`, GCLOUD_ACCOUNT and
# CLOUDSDK_ACTIVE_CONFIG_NAME are unset or empty, no `--configuration` appears
# in argv, and `--cred-file` selects no file. An otherwise-routable login with
# `--flags-file` fails loud: gcloud expands that opaque file after the shim
# checks identity flags. Routed logins drop --update-adc so the box's
# application default credentials (ADC) remain its own identity.
#
# `gcloud auth application-default login` and `revoke` are refused whenever
# the ADC in CLOUDSDK_CONFIG is an `external_account` credential. Sami's login
# instead belongs in its `legacy_credentials/<account>/adc.json`, which client
# libraries use through GOOGLE_APPLICATION_CREDENTIALS. This check ignores
# GOOGLE_APPLICATION_CREDENTIALS and the active configuration.
#
# Both protections classify the command the way gcloud does, so a flag cannot
# hide the command path: every global flag and its value are consumed wherever
# they appear among the command words, and one leading release track (`alpha`,
# `beta`, `preview`) is stripped for classification only. An unrecognized flag
# whose value is unknowable makes the path ambiguous; where the rest of argv
# could still name a protected `auth` command, that fails loud rather than
# running under the wrong identity.
#
# `gcloud auth`/`gcloud init` run through `forward` on a headless machine
# instead of the paste-a-code flow:
#   - First command word is `auth` or `init`, DISPLAY, WAYLAND_DISPLAY
#     and MIR_SOCKET are all unset, and `forward` resolves on PATH -> gcloud
#     refuses to launch ANY browser on Linux without one of those display
#     variables set (check_browser._DISPLAY_VARIABLES), even with $BROWSER
#     pointing somewhere valid, and falls into the paste-the-URL,
#     paste-back-a-code flow headless. Satisfy the check with a fake display
#     scoped to gcloud alone, and point BROWSER straight at `forward open` —
#     NOT the xdg-open shim, whose display branch would see the fake value
#     and exec the real xdg-open on a machine with no browser.
#
# All other calls retain the existing GCLOUD_ACCOUNT routing and pass-through
# behavior. Doctrine: fail LOUD where an identity is supposed to exist, never
# fall through to a different one.
set -euo pipefail

# The global flags of the installed SDK, split by how many values each takes.
# Generated from the root parser's own declarations by `scripts/gcloud-global-flags`
# against Google Cloud SDK 589.0.0: lib/googlecloudsdk/calliope/cli.py:565-670
# (__AddBuiltinGlobalFlags) and :240-246, lib/surface/__init__.py:57-186,
# lib/googlecloudsdk/calliope/base.py:361-413 and lib/googlecloudsdk/calliope/
# backend.py:338-370. The `--no-` forms are generated from the boolean flags by
# lib/googlecloudsdk/calliope/parser_arguments.py:524-600, and the SDK disables
# flag abbreviations (parser_extensions.py:1273-1287), so each name is exact.
# A subgroup inherits this table unchanged, so one table classifies every depth.
GCLOUD_GLOBAL_VALUE_FLAGS=(
    ---flag-file-line-
    --access-token-file
    --account
    --assert
    --authority-selector
    --authorization-token-file
    --billing-project
    --configuration
    --credential-file-override
    --document
    --flags-file
    --flatten
    --format
    --http-timeout
    --impersonate-service-account
    --project
    --trace-token
    --universe-domain
    --verbosity
)
GCLOUD_GLOBAL_BOOLEAN_FLAGS=(
    --help
    --log-http
    --no-log-http
    --no-user-output-enabled
    --quiet
    --user-output-enabled
    --version
    -h
    -q
    -v
)

# One leading track word selects a surface, not an identity: `alpha auth login`
# is still the login this shim protects (lib/surface/auth/__init__.py:22-24).
GCLOUD_RELEASE_TRACKS=(alpha beta preview)

# The command path gcloud would parse, and whether a flag made it unknowable.
declare -a GCLOUD_COMMAND_WORDS=()
GCLOUD_COMMAND_AMBIGUOUS=0

contains_word() {
    local needle="$1" item
    shift
    for item in "$@"; do
        [[ "$item" == "$needle" ]] && return 0
    done
    return 1
}

# True once the collected words decide whether this is a protected command:
# `auth login`, or `auth application-default login|revoke`. Anything after that
# is the command's own flags and positionals, which cannot move the path.
command_path_is_decided() {
    local count="${#GCLOUD_COMMAND_WORDS[@]}"
    ((count == 0)) && return 1
    [[ "${GCLOUD_COMMAND_WORDS[0]}" != auth ]] && return 0
    ((count == 1)) && return 1
    [[ "${GCLOUD_COMMAND_WORDS[1]}" != application-default ]] && return 0
    ((count >= 3))
}

parse_gcloud_command_path() {
    GCLOUD_COMMAND_WORDS=()
    GCLOUD_COMMAND_AMBIGUOUS=0
    local -a argv=("$@")
    local arg name
    while (($#)); do
        command_path_is_decided && break
        arg="$1"
        case "$arg" in
            -*)
                name="${arg%%=*}"
                if contains_word "$name" "${GCLOUD_GLOBAL_VALUE_FLAGS[@]}"; then
                    shift
                    # A separate value is one more argv entry; `--flag=value` holds its own.
                    [[ "$arg" == *=* ]] || { (($#)) && shift; }
                elif contains_word "$name" "${GCLOUD_GLOBAL_BOOLEAN_FLAGS[@]}"; then
                    shift
                else
                    # An unknown flag may or may not take the next entry, so every
                    # word after it is only a guess at the command path.
                    GCLOUD_COMMAND_AMBIGUOUS=1
                    shift
                fi
                ;;
            *)
                if [[ "${#GCLOUD_COMMAND_WORDS[@]}" -eq 0 ]] && contains_word "$arg" "${GCLOUD_RELEASE_TRACKS[@]}"; then
                    shift
                    continue
                fi
                GCLOUD_COMMAND_WORDS+=("$arg")
                shift
                ;;
        esac
    done
    # Every protected command names `auth`. Without that word in argv, no reading
    # of an unknown flag's value can make this one, so the guess is good enough.
    if [[ "$GCLOUD_COMMAND_AMBIGUOUS" -eq 1 ]] && ! contains_word auth "${argv[@]}"; then
        GCLOUD_COMMAND_AMBIGUOUS=0
    fi
}

# `--name value` and `--name=value`, matching the flag exactly: the SDK accepts
# no abbreviations (parser_extensions.py:1273-1287).
has_option() {
    local name="$1" arg
    shift
    for arg in "$@"; do
        case "$arg" in
            "$name" | "$name"=*) return 0 ;;
        esac
    done
    return 1
}

# The value gcloud would act on: its argparse store action keeps the last
# occurrence, and an empty value is falsy to `auth login` (lib/surface/auth/
# login.py:263,276), so it selects no credential file.
effective_option_value() {
    local name="$1" arg value="" awaiting_value=0
    shift
    for arg in "$@"; do
        if ((awaiting_value)); then
            value="$arg"
            awaiting_value=0
            continue
        fi
        case "$arg" in
            "$name")
                value=""
                awaiting_value=1
                ;;
            "$name"=*) value="${arg#*=}" ;;
        esac
    done
    printf '%s' "$value"
}

needs_forward_browser() {
    case "${GCLOUD_COMMAND_WORDS[0]:-}" in
        auth | init) ;;
        *) return 1 ;;
    esac
    [[ -z "${DISPLAY:-}${WAYLAND_DISPLAY:-}${MIR_SOCKET:-}" ]] || return 1
    command -v forward &>/dev/null
}

is_auth_login() {
    [[ "${GCLOUD_COMMAND_WORDS[0]:-}" == auth && "${GCLOUD_COMMAND_WORDS[1]:-}" == login ]]
}

application_default_operation() {
    [[ "${GCLOUD_COMMAND_WORDS[0]:-}" == auth && "${GCLOUD_COMMAND_WORDS[1]:-}" == application-default ]] || return 1
    case "${GCLOUD_COMMAND_WORDS[2]:-}" in
        login | revoke)
            printf '%s\n' "${GCLOUD_COMMAND_WORDS[2]}"
            return 0
            ;;
    esac
    return 1
}

box_is_active() {
    local config_root active_config
    config_root="${CLOUDSDK_CONFIG:-$HOME/.config/gcloud}"
    active_config="${config_root}/active_config"
    [[ -f "$active_config" && "$(<"$active_config")" == box ]]
}

is_external_account_adc() {
    local config_root adc_file adc_json
    config_root="${CLOUDSDK_CONFIG:-$HOME/.config/gcloud}"
    adc_file="${config_root}/application_default_credentials.json"
    [[ -f "$adc_file" ]] || return 1
    adc_json="$(<"$adc_file")"
    [[ "$adc_json" =~ \"type\"[[:space:]]*:[[:space:]]*\"external_account\" ]]
}

# An identity the caller chose: the box route never overrides one of these.
identity_is_selected() {
    [[ -n "${GCLOUD_ACCOUNT:-}" || -n "${CLOUDSDK_ACTIVE_CONFIG_NAME:-}" ]] && return 0
    has_option --configuration "$@" && return 0
    [[ -n "$(effective_option_value --cred-file "$@")" ]]
}

is_box_routed_auth_login() {
    [[ "$GCLOUD_COMMAND_AMBIGUOUS" -eq 0 ]] || return 1
    is_auth_login || return 1
    identity_is_selected "$@" && return 1
    box_is_active
}

find_real_gcloud() {
    local self candidate
    self="$(readlink -f "${BASH_SOURCE[0]}")"
    while IFS= read -r candidate; do
        [[ "$(readlink -f "$candidate")" == "$self" ]] && continue
        printf '%s\n' "$candidate"
        return 0
    done < <(type -ap gcloud)
    # Minimal-PATH spawners (MCP servers, cron, etc.) carry neither the
    # dotfiles shims nor the SDK's own bin dir; fall back to the documented
    # install location before failing.
    candidate="$HOME/.gcloud/google-cloud-sdk/bin/gcloud"
    if [[ -x "$candidate" && "$(readlink -f "$candidate")" != "$self" ]]; then
        printf '%s\n' "$candidate"
        return 0
    fi
    echo "gcloud shim: real gcloud binary not found on PATH or at the default SDK install location" >&2
    return 127
}

exec_real_gcloud() {
    local real_gcloud="$1"
    shift
    if needs_forward_browser; then
        exec env DISPLAY=:0 "BROWSER=forward open %s" "$real_gcloud" "$@"
    fi
    exec "$real_gcloud" "$@"
}

main() {
    local real_gcloud
    # split is load-bearing — `local x=$(cmd)` masks the command's exit status and would defeat fail-loud.
    real_gcloud="$(find_real_gcloud)"

    parse_gcloud_command_path "$@"

    local config_dir="${CLOUDSDK_CONFIG:-$HOME/.config/gcloud}/configurations"
    # Read the ADC only for a command this block can refuse: an ambiguous path that
    # could be a protected one, or application-default login/revoke. Every other call
    # leaves the credential file unopened, so a runtime monitor that watches who opens
    # it sees gcloud, not this wrapper.
    local adc_operation=""
    if [[ "$GCLOUD_COMMAND_AMBIGUOUS" -eq 1 ]]; then
        local ambiguous_refusal=0
        if ! identity_is_selected "$@" && box_is_active; then
            ambiguous_refusal=1
        elif is_external_account_adc; then
            ambiguous_refusal=1
        fi
        if ((ambiguous_refusal)); then
            echo "gcloud shim: refusing a command whose path an unrecognized flag makes ambiguous while it could still be a protected auth command; drop that flag, or name a configuration explicitly with --configuration theorem or GCLOUD_ACCOUNT=theorem." >&2
            exit 1
        fi
    elif adc_operation="$(application_default_operation)" && is_external_account_adc; then
        echo "gcloud shim: refusing auth application-default ${adc_operation}: the box's ADC is its own identity; run gcloud auth login, which renews legacy_credentials/<account>/adc.json; client libraries use it through GOOGLE_APPLICATION_CREDENTIALS." >&2
        exit 1
    fi

    if is_box_routed_auth_login "$@"; then
        if has_option --flags-file "$@"; then
            echo "gcloud shim: refusing implicit box auth login with --flags-file; name a configuration explicitly with --configuration theorem or GCLOUD_ACCOUNT=theorem." >&2
            exit 1
        fi
        if [[ ! -f "${config_dir}/config_theorem" ]]; then
            echo "gcloud shim: configuration theorem is missing at ${config_dir}/config_theorem; create it with gcloud config configurations create theorem --no-activate." >&2
            exit 1
        fi

        local -a routed_args=()
        local arg update_adc=no
        for arg in "$@"; do
            if [[ "$arg" == --update-adc ]]; then
                update_adc=yes
                continue
            fi
            routed_args+=("$arg")
        done

        echo "gcloud shim: routing auth login to configuration theorem because box is this machine's own identity." >&2
        if [[ "$update_adc" == yes ]]; then
            echo "gcloud shim: dropping --update-adc: the box's ADC stays its own identity; this login renews legacy_credentials/<account>/adc.json for client libraries." >&2
        fi
        export CLOUDSDK_ACTIVE_CONFIG_NAME=theorem
        exec_real_gcloud "$real_gcloud" "${routed_args[@]}"
    fi

    local account="${GCLOUD_ACCOUNT:-}"
    if [[ -z "$account" ]]; then
        exec_real_gcloud "$real_gcloud" "$@"
    fi

    # Reject path separators and dot-segments before they ever touch a
    # filesystem path: an account name is a bare configuration name, never a
    # traversal into an arbitrary file.
    case "$account" in
        */* | . | ..)
            echo "gcloud shim: GCLOUD_ACCOUNT '${account}' is not a valid gcloud configuration name" >&2
            exit 1
            ;;
    esac

    local config_file="${config_dir}/config_${account}"

    if [[ ! -f "$config_file" ]]; then
        local candidate available
        local -a names=()
        if [[ -d "$config_dir" ]]; then
            for candidate in "$config_dir"/config_*; do
                [[ -f "$candidate" ]] || continue
                names+=("${candidate##*/config_}")
            done
        fi
        if [[ "${#names[@]}" -gt 0 ]]; then
            available="$(IFS=', '; echo "${names[*]}")"
        else
            available="(none found in ${config_dir})"
        fi
        echo "gcloud shim: GCLOUD_ACCOUNT '${account}' has no gcloud configuration at ${config_file}; available configurations: ${available}" >&2
        exit 1
    fi

    export CLOUDSDK_ACTIVE_CONFIG_NAME="$account"
    exec_real_gcloud "$real_gcloud" "$@"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
