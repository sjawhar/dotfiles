#!/bin/bash
# gcloud wrapper: select a named gcloud configuration via GCLOUD_ACCOUNT,
# instead of typing CLOUDSDK_ACTIVE_CONFIG_NAME=<name> per command or mutating
# global state with `gcloud config configurations activate`.
#
# On a box, a plain `gcloud auth login` goes to Sami's `theorem`
# configuration instead of overwriting the machine's `box` identity. This
# applies only when `active_config` is `box`, GCLOUD_ACCOUNT and
# CLOUDSDK_ACTIVE_CONFIG_NAME are unset or empty, and neither
# `--configuration` nor `--cred-file` appears in argv. An otherwise-routable
# login with `--flags-file` fails loud: gcloud expands that opaque file after
# the shim checks identity flags. Routed logins drop --update-adc so the box's
# application default credentials (ADC) remain its own identity.
#
# `gcloud auth application-default login` and `revoke` are refused whenever
# the ADC in CLOUDSDK_CONFIG is an `external_account` credential. Sami's login
# instead belongs in its `legacy_credentials/<account>/adc.json`, which client
# libraries use through GOOGLE_APPLICATION_CREDENTIALS. This check ignores
# GOOGLE_APPLICATION_CREDENTIALS and the active configuration.
#
# `gcloud auth`/`gcloud init` run through `forward` on a headless machine
# instead of the paste-a-code flow:
#   - First non-flag argument is `auth` or `init`, DISPLAY, WAYLAND_DISPLAY
#     and MIR_SOCKET are all unset, and `forward` resolves on PATH -> gcloud
#     refuses to launch ANY browser on Linux without one of those display
#     variables set (check_browser._DISPLAY_VARIABLES), even with $BROWSER
#     pointing somewhere valid, and falls into the paste-the-URL,
#     paste-back-a-code flow headless. Satisfy the check with a fake display
#     scoped to gcloud alone, and point BROWSER straight at `forward open` —
#     NOT the xdg-open shim, whose display branch would see the fake value
#     and exec the real xdg-open on a machine with no browser.
#
# All other calls retain the existing GCLOUD_ACCOUNT routing and pass-through
# behavior. Doctrine: fail LOUD where an identity is supposed to exist, never
# fall through to a different one.
set -euo pipefail

# The command words drive both the box-login routing and ADC protection.
# Value-taking global flags are from `gcloud --help` on the installed Cloud
# SDK 589.0.0 (read 2026-10-23); that output lists every flag below.
declare -a GCLOUD_COMMAND_WORDS=()

parse_gcloud_command_path() {
    GCLOUD_COMMAND_WORDS=()
    local arg
    while (($#)); do
        arg="$1"
        case "$arg" in
            --account | --billing-project | --configuration | --flags-file | --flatten | --format | --project | --verbosity | --access-token-file | --impersonate-service-account | --trace-token)
                [[ $# -ge 2 ]] || return 2
                shift 2
                ;;
            --account=* | --billing-project=* | --configuration=* | --flags-file=* | --flatten=* | --format=* | --project=* | --verbosity=* | --access-token-file=* | --impersonate-service-account=* | --trace-token=*)
                shift
                ;;
            --help | -h | --quiet | -q | --version | -v | --log-http | --user-output-enabled | --no-user-output-enabled)
                shift
                ;;
            --)
                return 2
                ;;
            -*)
                # An unfamiliar flag before the command may take a separate
                # value, so its command path is unknowable and ADC must fail closed.
                [[ "${#GCLOUD_COMMAND_WORDS[@]}" -gt 0 ]] || return 2
                shift
                ;;
            *)
                GCLOUD_COMMAND_WORDS+=("$arg")
                [[ "${#GCLOUD_COMMAND_WORDS[@]}" -ge 3 ]] && return 0
                shift
                ;;
        esac
    done
    return 0
}

needs_forward_browser() {
    case "${GCLOUD_COMMAND_WORDS[0]:-}" in
        auth | init) ;;
        *) return 1 ;;
    esac
    [[ -z "${DISPLAY:-}${WAYLAND_DISPLAY:-}${MIR_SOCKET:-}" ]] || return 1
    command -v forward &>/dev/null
}

has_configuration_flag() {
    local arg
    for arg in "$@"; do
        case "$arg" in
            --configuration | --configuration=*) return 0 ;;
        esac
    done
    return 1
}

has_credential_file_flag() {
    local arg
    for arg in "$@"; do
        case "$arg" in
            --cred-file | --cred-file=*) return 0 ;;
        esac
    done
    return 1
}

has_flags_file_flag() {
    local arg
    for arg in "$@"; do
        case "$arg" in
            --flags-file | --flags-file=*) return 0 ;;
        esac
    done
    return 1
}


is_auth_login() {
    [[ "${GCLOUD_COMMAND_WORDS[0]:-}" == auth && "${GCLOUD_COMMAND_WORDS[1]:-}" == login ]]
}

application_default_operation() {
    [[ "${GCLOUD_COMMAND_WORDS[0]:-}" == auth && "${GCLOUD_COMMAND_WORDS[1]:-}" == application-default ]] || return 1
    case "${GCLOUD_COMMAND_WORDS[2]:-}" in
        login | revoke)
            printf '%s\n' "${GCLOUD_COMMAND_WORDS[2]}"
            return 0
            ;;
    esac
    return 1
}

box_is_active() {
    local config_root active_config
    config_root="${CLOUDSDK_CONFIG:-$HOME/.config/gcloud}"
    active_config="${config_root}/active_config"
    [[ -f "$active_config" && "$(<"$active_config")" == box ]]
}

is_external_account_adc() {
    local config_root adc_file adc_json
    config_root="${CLOUDSDK_CONFIG:-$HOME/.config/gcloud}"
    adc_file="${config_root}/application_default_credentials.json"
    [[ -f "$adc_file" ]] || return 1
    adc_json="$(<"$adc_file")"
    [[ "$adc_json" =~ \"type\"[[:space:]]*:[[:space:]]*\"external_account\" ]]
}

is_box_routed_auth_login() {
    [[ -z "${GCLOUD_ACCOUNT:-}" && -z "${CLOUDSDK_ACTIVE_CONFIG_NAME:-}" ]] || return 1
    is_auth_login "$@" || return 1
    box_is_active || return 1
    if has_configuration_flag "$@" || has_credential_file_flag "$@"; then
        return 1
    fi
    return 0
}

find_real_gcloud() {
    local self candidate
    self="$(readlink -f "${BASH_SOURCE[0]}")"
    while IFS= read -r candidate; do
        [[ "$(readlink -f "$candidate")" == "$self" ]] && continue
        printf '%s\n' "$candidate"
        return 0
    done < <(type -ap gcloud)
    # Minimal-PATH spawners (MCP servers, cron, etc.) carry neither the
    # dotfiles shims nor the SDK's own bin dir; fall back to the documented
    # install location before failing.
    candidate="$HOME/.gcloud/google-cloud-sdk/bin/gcloud"
    if [[ -x "$candidate" && "$(readlink -f "$candidate")" != "$self" ]]; then
        printf '%s\n' "$candidate"
        return 0
    fi
    echo "gcloud shim: real gcloud binary not found on PATH or at the default SDK install location" >&2
    return 127
}

main() {
    local real_gcloud
    # split is load-bearing — `local x=$(cmd)` masks the command's exit status and would defeat fail-loud.
    real_gcloud="$(find_real_gcloud)"

    local command_parse_status
    if parse_gcloud_command_path "$@"; then
        command_parse_status=0
    else
        command_parse_status=$?
    fi

    local config_dir="${CLOUDSDK_CONFIG:-$HOME/.config/gcloud}/configurations"
    local adc_operation
    if is_external_account_adc; then
        if [[ "$command_parse_status" -eq 2 ]]; then
            echo "gcloud shim: refusing command with an unknown leading global flag while the box ADC is an external_account credential; run gcloud auth login without that flag." >&2
            exit 1
        fi
        if adc_operation="$(application_default_operation)"; then
            echo "gcloud shim: refusing auth application-default ${adc_operation}: the box's ADC is its own identity; run gcloud auth login, which renews legacy_credentials/<account>/adc.json; client libraries use it through GOOGLE_APPLICATION_CREDENTIALS." >&2
            exit 1
        fi
    fi

    if [[ "$command_parse_status" -eq 0 ]] && is_box_routed_auth_login "$@"; then
        if has_flags_file_flag "$@"; then
            echo "gcloud shim: refusing implicit box auth login with --flags-file; name a configuration explicitly with --configuration theorem or GCLOUD_ACCOUNT=theorem." >&2
            exit 1
        fi
        if [[ ! -f "${config_dir}/config_theorem" ]]; then
            echo "gcloud shim: configuration theorem is missing at ${config_dir}/config_theorem; create it with gcloud config configurations create theorem --no-activate." >&2
            exit 1
        fi

        local -a routed_args=()
        local arg update_adc=no
        for arg in "$@"; do
            if [[ "$arg" == --update-adc ]]; then
                update_adc=yes
                continue
            fi
            routed_args+=("$arg")
        done

        echo "gcloud shim: routing auth login to configuration theorem because box is this machine's own identity." >&2
        if [[ "$update_adc" == yes ]]; then
            echo "gcloud shim: dropping --update-adc: the box's ADC stays its own identity; this login renews legacy_credentials/<account>/adc.json for client libraries." >&2
        fi
        export CLOUDSDK_ACTIVE_CONFIG_NAME=theorem
        if needs_forward_browser "${routed_args[@]}"; then
            exec env DISPLAY=:0 "BROWSER=forward open %s" "$real_gcloud" "${routed_args[@]}"
        fi
        exec "$real_gcloud" "${routed_args[@]}"
    fi

    local account="${GCLOUD_ACCOUNT:-}"
    if [[ -z "$account" ]]; then
        if needs_forward_browser "$@"; then
            exec env DISPLAY=:0 "BROWSER=forward open %s" "$real_gcloud" "$@"
        fi
        exec "$real_gcloud" "$@"
    fi

    # Reject path separators and dot-segments before they ever touch a
    # filesystem path: an account name is a bare configuration name, never a
    # traversal into an arbitrary file.
    case "$account" in
        */* | . | ..)
            echo "gcloud shim: GCLOUD_ACCOUNT '${account}' is not a valid gcloud configuration name" >&2
            exit 1
            ;;
    esac

    local config_file="${config_dir}/config_${account}"

    if [[ ! -f "$config_file" ]]; then
        local candidate available
        local -a names=()
        if [[ -d "$config_dir" ]]; then
            for candidate in "$config_dir"/config_*; do
                [[ -f "$candidate" ]] || continue
                names+=("${candidate##*/config_}")
            done
        fi
        if [[ "${#names[@]}" -gt 0 ]]; then
            available="$(IFS=', '; echo "${names[*]}")"
        else
            available="(none found in ${config_dir})"
        fi
        echo "gcloud shim: GCLOUD_ACCOUNT '${account}' has no gcloud configuration at ${config_file}; available configurations: ${available}" >&2
        exit 1
    fi

    export CLOUDSDK_ACTIVE_CONFIG_NAME="$account"
    if needs_forward_browser "$@"; then
        exec env DISPLAY=:0 "BROWSER=forward open %s" "$real_gcloud" "$@"
    fi
    exec "$real_gcloud" "$@"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
