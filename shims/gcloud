#!/bin/bash
# gcloud wrapper: select a named gcloud configuration via GCLOUD_ACCOUNT,
# instead of typing CLOUDSDK_ACTIVE_CONFIG_NAME=<name> per command or mutating
# global state with `gcloud config configurations activate`.
#
# In the user's own session on a box, a plain `gcloud auth login` goes to his
# own configuration (USER_LOGIN_CONFIGURATION below) instead of overwriting the
# machine's `box` identity. This
# applies only when `active_config` is `box` and the caller chose no identity:
# GCLOUD_ACCOUNT and CLOUDSDK_ACTIVE_CONFIG_NAME are unset or empty, and the
# last `--configuration` and the last `--cred-file` in argv are absent or empty
# (gcloud reads an empty value as none). An otherwise-routable login with
# `--flags-file` fails loud: gcloud expands that opaque file after the shim
# checks identity flags, and a `--cred-file` inside it would come last and win.
# Routed logins drop --update-adc so the box's application default
# credentials (ADC) remain its own identity.
#
# `gcloud auth application-default login` and `revoke` are refused whenever
# the ADC in CLOUDSDK_CONFIG is an `external_account` credential, or `box` is
# active on a Google VM (scripts/on-google-vm), where the box's ADC is the
# metadata server and the well-known file must stay absent: a login written
# there would be whom every Google library on the machine acts as. This check
# ignores GOOGLE_APPLICATION_CREDENTIALS.
#
# An agent session (`shims/gh`'s test) runs as the box identity by default:
# agent-infra's applies run in CI or as its applier service account,
# impersonated from the box identity, and a step only a person can make is on
# agent-infra's docs/break-glass.md (GCLOUD_BREAK_GLASS_URL below), which an
# agent cites in a dispatch ask to that person. In an agent session the shim
# refuses a call whose account is a person's own login (--account or
# CLOUDSDK_CORE_ACCOUNT, anything but *.gserviceaccount.com), unless an explicit
# --configuration names the configuration that holds that login: the route an
# apply no declared identity can make yet takes under Sami's standing permission,
# each use recorded (dispatch://INFRA-6/ask/6c7b1e80-176f-40e3-967e-e5d642d501ec).
# On 2026-11-02T00:07Z an exported CLOUDSDK_CORE_ACCOUNT made one agent shell's
# kubectl, through gke-gcloud-auth-plugin and its per-kubeconfig token cache,
# create GKE Jobs as the user for an hour.
#
# Also in an agent session, every call that would write or remove the
# well-known ADC file is refused on every route: `auth application-default
# login|revoke`, and any `auth login` with --update-adc or a --flags-file. That
# file is whom every Google library and Pulumi without
# GOOGLE_APPLICATION_CREDENTIALS acts as; on 2026-11-01T02:53Z a login under an
# explicit configuration kept --update-adc and wrote the user's own credential
# there. Agent sessions get the box identity through
# GOOGLE_APPLICATION_CREDENTIALS (scripts/agent-session). Each agent-session
# refusal is a REFUSED block naming the call, the identity, why, and the route:
# the box identity, the CI route or the applier, and the break-glass page.
#
# The ADC and login protections classify the command the way gcloud does, so a flag cannot
# hide the command path: every global flag and its value are consumed wherever
# they appear among the command words, and one leading release track (`alpha`,
# `beta`, `preview`) is stripped for classification only. A flag missing from
# the table may take the next entry as its value in a later SDK, so the path is
# read both ways; where one reading names a protected `auth` command and
# another does not, that fails loud rather than running under the wrong
# identity. A command that no reading makes protected passes through.
#
# `gcloud auth`/`gcloud init` run through `forward` on a headless machine
# instead of the paste-a-code flow:
#   - First command word is `auth` or `init`, DISPLAY, WAYLAND_DISPLAY
#     and MIR_SOCKET are all unset, and `forward` resolves on PATH -> gcloud
#     refuses to launch ANY browser on Linux without one of those display
#     variables set (check_browser._DISPLAY_VARIABLES), even with $BROWSER
#     pointing somewhere valid, and falls into the paste-the-URL,
#     paste-back-a-code flow headless. Satisfy the check with a fake display
#     scoped to gcloud alone, and point BROWSER straight at `forward open` —
#     NOT the xdg-open shim, whose display branch would see the fake value
#     and exec the real xdg-open on a machine with no browser.
#
# GCLOUD_ACCOUNT=<name> selects configuration <name>: config_<name> must exist as
# a file under gcloud's configuration directory's configurations/ (a filesystem
# check, not `gcloud config configurations list`, which would recurse into this
# shim and is slow), and the real gcloud then runs with
# CLOUDSDK_ACTIVE_CONFIG_NAME=<name>. A missing one fails loud, naming the value
# and listing the configurations that exist; it never falls back to `default`.
# gcloud's configuration directory is a non-empty CLOUDSDK_CONFIG, else
# .config/gcloud under HOME, else under the current uid's passwd home, as gcloud
# finds it; the shim looks it up only for a check that reads it, and refuses
# that check when none resolves. With GCLOUD_ACCOUNT unset or empty, a call no
# rule above touches runs the real gcloud unchanged, HOME unset included.
# Doctrine: fail LOUD where an identity is supposed to exist, never fall
# through to a different one.
set -euo pipefail

# dotfiles gcloud shim: find_real_gcloud skips any file that holds this exact line.

# The configuration that holds the user's own Google login: his plain login on a box goes
# there. This shim writes its name nowhere else.
USER_LOGIN_CONFIGURATION=theorem
# agent-infra's applier, which a session impersonates from the box identity for an apply
# (agent-infra bootstrap/README.md, "Who applies"), and the page of the steps only a person can make.
GCLOUD_APPLIER="infra-applier@theorem-agent-infra.iam.gserviceaccount.com"
GCLOUD_BREAK_GLASS_URL="https://github.com/theorem-labs/agent-infra/blob/main/docs/break-glass.md"
# Google's page on a VM's run-time limit, named in the refusal of a VM create without one.
GCLOUD_RUN_LIMIT_DOCS_URL="https://cloud.google.com/compute/docs/instances/limit-vm-runtime"

# The global flags of the installed SDK, split by how many values each takes.
# Generated from the root parser's own declarations by `scripts/gcloud-global-flags`
# against Google Cloud SDK 589.0.0: lib/googlecloudsdk/calliope/cli.py:565-670
# (__AddBuiltinGlobalFlags) and :240-246, lib/surface/__init__.py:57-186,
# lib/googlecloudsdk/calliope/base.py:361-413 and lib/googlecloudsdk/calliope/
# backend.py:338-370. The `--no-` forms are generated from the boolean flags by
# lib/googlecloudsdk/calliope/parser_arguments.py:524-600, and the SDK disables
# flag abbreviations (parser_extensions.py:1273-1287), so each name is exact.
# A subgroup inherits this table unchanged, so one table classifies every depth.
GCLOUD_GLOBAL_VALUE_FLAGS=(
    ---flag-file-line-
    --access-token-file
    --account
    --assert
    --authority-selector
    --authorization-token-file
    --billing-project
    --configuration
    --credential-file-override
    --document
    --flags-file
    --flatten
    --format
    --http-timeout
    --impersonate-service-account
    --project
    --trace-token
    --universe-domain
    --verbosity
)
GCLOUD_GLOBAL_BOOLEAN_FLAGS=(
    --help
    --log-http
    --no-log-http
    --no-user-output-enabled
    --quiet
    --user-output-enabled
    --version
    -h
    -q
    -v
)

# One leading track word selects a surface, not an identity: `alpha auth login`
# is still the login this shim protects (lib/surface/auth/__init__.py:22-24).
# The SDK accepts one track word (`alpha beta auth list` is an invalid choice),
# so the shim strips one.
GCLOUD_RELEASE_TRACKS=(alpha beta preview)

# The command path this SDK's own parser reads, and what other readings of an
# unknown flag's value could make it. GCLOUD_READING_KINDS holds one bit per kind
# of path some reading names: 1 `auth login`, 2 `auth application-default
# login|revoke`, 4 anything else. GCLOUD_ARGV is the argv compute_reading_kinds
# walks. It is a global, not that function's arguments: under bash 3.2 every
# function call costs time in proportion to the caller's positional parameters,
# and the walk calls helpers for each entry, so passing 6,000 entries as
# arguments took the 3,000-flag case from 2 s to 11 s.
declare -a GCLOUD_COMMAND_WORDS=()
declare -a GCLOUD_ARGV=()
GCLOUD_READING_KINDS=0
GCLOUD_COMMAND_AMBIGUOUS=0
GCLOUD_POSSIBLE_LOGIN=0
GCLOUD_POSSIBLE_ADC_OPERATION=0

contains_word() {
    local needle="$1" item
    shift
    for item in "$@"; do
        [[ "$item" == "$needle" ]] && return 0
    done
    return 1
}

is_value_flag() {
    contains_word "${1%%=*}" "${GCLOUD_GLOBAL_VALUE_FLAGS[@]}"
}

is_boolean_flag() {
    contains_word "${1%%=*}" "${GCLOUD_GLOBAL_BOOLEAN_FLAGS[@]}"
}

# True once the collected words decide whether this is a protected command:
# `auth login`, or `auth application-default login|revoke`. Anything after that
# is the command's own flags and positionals, which cannot move the path.
command_path_is_decided() {
    local count="${#GCLOUD_COMMAND_WORDS[@]}"
    ((count == 0)) && return 1
    [[ "${GCLOUD_COMMAND_WORDS[0]}" != auth ]] && return 0
    ((count == 1)) && return 1
    [[ "${GCLOUD_COMMAND_WORDS[1]}" != application-default ]] && return 0
    ((count >= 3))
}

# The words this SDK's parser takes for the command path. A global flag consumes
# its value; any other flag takes none: argparse sends an unknown option to its
# extras alone (python3.14/argparse.py:2146-2150), and calliope disables the
# prefix matching that short-option clustering rests on (parser_extensions.py:
# 1273-1287), so `-qq` is one unknown option too. A lone `-` is a positional.
read_command_words() {
    local arg track_stripped=0
    GCLOUD_COMMAND_WORDS=()
    while (($#)); do
        command_path_is_decided && break
        arg="$1"
        shift
        case "$arg" in
            -?*)
                # A separate value is one more argv entry; `--flag=value` holds its own.
                if is_value_flag "$arg" && [[ "$arg" != *=* ]] && (($#)); then
                    shift
                fi
                ;;
            *)
                if ((${#GCLOUD_COMMAND_WORDS[@]} == 0 && !track_stripped)) &&
                    contains_word "$arg" "${GCLOUD_RELEASE_TRACKS[@]}"; then
                    track_stripped=1
                    continue
                fi
                GCLOUD_COMMAND_WORDS+=("$arg")
                ;;
        esac
    done
    return 0
}

# Necessary for any reading to name a protected command: `auth`, then later
# `login`, or `application-default` and then `login` or `revoke`. Reading a flag
# as taking a value or not can only drop entries from the path, never add or
# reorder them, so without these words in this order every reading is ordinary.
protected_words_in_order() {
    local arg seen_auth=0 seen_application_default=0
    for arg in "$@"; do
        if ((seen_application_default)) && [[ "$arg" == login || "$arg" == revoke ]]; then
            return 0
        fi
        if ((seen_auth)); then
            [[ "$arg" == login ]] && return 0
            [[ "$arg" == application-default ]] && seen_application_default=1
        fi
        [[ "$arg" == auth ]] && seen_auth=1
    done
    return 1
}

# Sets GCLOUD_READING_KINDS to the kinds of path every reading of GCLOUD_ARGV
# names. States: 0 nothing read, 1 a release track read, 2 `auth`, 3 `auth
# application-default`. An unknown flag written without `=` and followed by a
# non-flag entry is a choice point, since a later SDK could make it take that
# entry as its value; both readings count. The table holds, at index*4 + state,
# the kinds every reading from that argv index in that state names. Each entry's
# result depends only on the entries after it, so one loop from the last index
# back to 0 fills the table exactly: at most four states per index, and no
# recursion, so no number of unknown flags can exhaust the stack. It is an
# indexed array, not an associative one: bash 3.2, the /bin/bash of macOS, has
# no associative arrays and would stop this shim at the declaration.
compute_reading_kinds() {
    local -a table=()
    local count="${#GCLOUD_ARGV[@]}" index state arg next row skip_row move is_track
    # Past the last entry the path has not reached a protected command.
    for ((state = 0; state < 4; state++)); do
        table[count * 4 + state]=4
    done
    for ((index = count - 1; index >= 0; index--)); do
        arg="${GCLOUD_ARGV[index]}"
        row=$(((index + 1) * 4))
        # How the entry moves the walk: "flag" to the next row in the same state,
        # "value" past the flag's separate value too, "choice" both ways, or
        # "word" through the state machine.
        move=word
        is_track=0
        case "$arg" in
            -?*)
                move=flag
                if is_value_flag "$arg"; then
                    [[ "$arg" == *=* ]] || move=value
                elif ! is_boolean_flag "$arg" && [[ "$arg" != *=* && "$arg" != -- ]] &&
                    ((index + 1 < count)) && [[ "${GCLOUD_ARGV[index + 1]}" != -* ]]; then
                    move=choice
                fi
                ;;
            *) contains_word "$arg" "${GCLOUD_RELEASE_TRACKS[@]}" && is_track=1 ;;
        esac
        skip_row=$(((index + 2 > count ? count : index + 2) * 4))
        for ((state = 0; state < 4; state++)); do
            case "$move" in
                flag) next="${table[row + state]}" ;;
                value) next="${table[skip_row + state]}" ;;
                choice)
                    next=$((table[row + state] | table[skip_row + state]))
                    ;;
                word)
                    if ((state == 0 && is_track)); then
                        next="${table[row + 1]}"
                    else
                        case "$state:$arg" in
                            [01]:auth) next="${table[row + 2]}" ;;
                            2:application-default) next="${table[row + 3]}" ;;
                            2:login) next=1 ;;
                            3:login | 3:revoke) next=2 ;;
                            *) next=4 ;;
                        esac
                    fi
                    ;;
            esac
            table[index * 4 + state]="$next"
        done
    done
    GCLOUD_READING_KINDS="${table[0]}"
}

parse_gcloud_command_path() {
    read_command_words "$@"
    if protected_words_in_order "$@"; then
        GCLOUD_ARGV=("$@")
        compute_reading_kinds
    else
        GCLOUD_READING_KINDS=4
    fi
    GCLOUD_POSSIBLE_LOGIN=$((GCLOUD_READING_KINDS & 1 ? 1 : 0))
    GCLOUD_POSSIBLE_ADC_OPERATION=$((GCLOUD_READING_KINDS & 2 ? 1 : 0))
    # Ambiguous when the readings disagree: more than one kind bit is set.
    GCLOUD_COMMAND_AMBIGUOUS=$(((GCLOUD_READING_KINDS & (GCLOUD_READING_KINDS - 1)) != 0))
}

# `--name value` and `--name=value`, matching the flag exactly: the SDK accepts
# no abbreviations (parser_extensions.py:1273-1287).
has_option() {
    local name="$1" arg
    shift
    for arg in "$@"; do
        case "$arg" in
            "$name" | "$name"=*) return 0 ;;
        esac
    done
    return 1
}

# The value gcloud would act on: its argparse store action keeps the last
# occurrence, and an empty value is falsy to `auth login` (lib/surface/auth/
# login.py:263,276), so it selects no credential file.
effective_option_value() {
    local name="$1" arg value="" awaiting_value=0
    shift
    for arg in "$@"; do
        if ((awaiting_value)); then
            value="$arg"
            awaiting_value=0
            continue
        fi
        case "$arg" in
            "$name")
                value=""
                awaiting_value=1
                ;;
            "$name"=*) value="${arg#*=}" ;;
        esac
    done
    printf '%s' "$value"
}

needs_forward_browser() {
    case "${GCLOUD_COMMAND_WORDS[0]:-}" in
        auth | init) ;;
        *) return 1 ;;
    esac
    [[ -z "${DISPLAY:-}${WAYLAND_DISPLAY:-}${MIR_SOCKET:-}" ]] || return 1
    command -v forward &>/dev/null
}

# The home directory gcloud would use, in GCLOUD_USER_HOME. gcloud takes it from
# Python's expanduser (lib/googlecloudsdk/core/util/files.py:1317-1324), which
# uses HOME when it is set, even empty, else the passwd home of the current uid,
# and drops trailing slashes (posixpath.py:229-280). With HOME unset bash expands
# ~ to that passwd home too, but to / when the uid has none, so `id -un` tells
# the two apart. Fails when the uid has no passwd entry.
resolve_user_home() {
    local home
    if [[ -n "${HOME+set}" ]]; then
        home="$HOME"
    else
        id -un >/dev/null 2>&1 || return 1
        home=~
    fi
    while [[ "$home" == */ ]]; do
        home="${home%/}"
    done
    GCLOUD_USER_HOME="$home"
}

# gcloud's configuration directory, in GCLOUD_CONFIG_ROOT: a non-empty
# CLOUDSDK_CONFIG, else ~/.config/gcloud (lib/googlecloudsdk/core/config.py:
# 231-244). Resolved once, and only on the paths that read the directory, so a
# call that cannot be protected runs the same with HOME unset. Where nothing
# resolves it, the shim cannot tell whether box is active, so it refuses.
GCLOUD_CONFIG_ROOT=""
resolve_config_root() {
    [[ -n "$GCLOUD_CONFIG_ROOT" ]] && return 0
    if [[ -n "${CLOUDSDK_CONFIG:-}" ]]; then
        GCLOUD_CONFIG_ROOT="$CLOUDSDK_CONFIG"
    elif resolve_user_home; then
        GCLOUD_CONFIG_ROOT="${GCLOUD_USER_HOME}/.config/gcloud"
    else
        echo "gcloud shim: cannot find gcloud's configuration directory: CLOUDSDK_CONFIG and HOME are unset and uid ${UID} has no passwd entry; refusing, because without it the shim cannot check which identity this command would use. Set CLOUDSDK_CONFIG or HOME." >&2
        exit 1
    fi
}

box_is_active() {
    resolve_config_root
    local active_config="${GCLOUD_CONFIG_ROOT}/active_config"
    [[ -f "$active_config" && "$(<"$active_config")" == box ]]
}

is_external_account_adc() {
    resolve_config_root
    local adc_file="${GCLOUD_CONFIG_ROOT}/application_default_credentials.json" adc_json
    [[ -f "$adc_file" ]] || return 1
    # An ADC the shim cannot read cannot be shown not to be the box's identity.
    # bash 4 and later fail the read below under set -e; bash 3.2 reads an
    # unreadable file as empty with status 0, which would turn the refusal off.
    if [[ ! -r "$adc_file" ]]; then
        echo "gcloud shim: cannot read ${adc_file} to check whether it is the box's external_account credential; refusing." >&2
        exit 1
    fi
    adc_json="$(<"$adc_file")"
    [[ "$adc_json" =~ \"type\"[[:space:]]*:[[:space:]]*\"external_account\" ]]
}

# The box's ADC is this machine's own identity: the external_account credential an
# Azure box writes there, or, with `box` active on a Google VM, the metadata server
# behind an absent well-known file. Probed only on the paths that can refuse.
adc_is_box_identity() {
    is_external_account_adc && return 0
    box_is_active && "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../scripts/on-google-vm"
}

# An identity the caller chose: the box route never overrides one of these.
# Each counts only with a non-empty value, the last occurrence winning, as the
# SDK reads them: _FindFlagValue takes the last --configuration, and an empty
# name falls through to the environment and then active_config (lib/
# googlecloudsdk/core/configurations/named_configs.py:119-148,494-511); auth
# login tests the --cred-file value for truth (lib/surface/auth/login.py:263,276).
identity_is_selected() {
    [[ -n "${GCLOUD_ACCOUNT:-}" || -n "${CLOUDSDK_ACTIVE_CONFIG_NAME:-}" ]] && return 0
    [[ -n "$(effective_option_value --configuration "$@")" ]] && return 0
    # A flags file expands in place after argv is read, so a --cred-file inside it
    # can come last and win (lib/googlecloudsdk/calliope/cli.py:149-188): with one
    # present, argv does not show the effective --cred-file. A --configuration
    # cannot hide there: the SDK reads it from raw argv before it expands flags
    # files (cli.py:974, before :985).
    has_option --flags-file "$@" && return 1
    [[ -n "$(effective_option_value --cred-file "$@")" ]]
}

# A login that would land on box: the caller chose no identity and box is active.
login_lands_on_box() {
    ! identity_is_selected "$@" && box_is_active
}

# Every reading names `auth login` (GCLOUD_READING_KINDS is exactly 1).
is_box_routed_auth_login() {
    ((GCLOUD_READING_KINDS == 1)) && login_lands_on_box "$@"
}

# Agent session: the test `shims/gh` uses (omp's bash tool and eval kernel, an agentbox session,
# anything launched with the gh-app routing include). Any other process is the user's own.
agent_context() {
    [[ -n "${OMP_SESSION_ID:-}${PI_SESSION_FILE:-}${PI_TOOL_BRIDGE_URL:-}${AGENTBOX_SESSION:-}" ]] && return 0
    local i v
    for ((i = 0; i < ${GIT_CONFIG_COUNT:-0}; i++)); do
        v="GIT_CONFIG_VALUE_$i"
        [[ "${!v:-}" == *gh-app-routes.gitconfig ]] && return 0
    done
    return 1
}

# One configuration directory per agent session (2026-11-03). gcloud keeps credentials and access
# tokens in sqlite files in its configuration directory, with a 5 s busy timeout, and every gcloud
# on the box shared ~/.config/gcloud on the root disk: in 300 s on 2026-11-03 (06:27-06:32Z) its
# access_tokens.db and credentials.db took 2,148 fsyncs and 238 s of fsync time, gcloud led the
# processes blocked on that disk (46 at 08:50Z), and this shim logged 2,000-4,200 `database is
# locked` lines an hour. So an agent session's gcloud runs with CLOUDSDK_CONFIG at
# $AGENT_SESSION_SCRATCH/gcloud: the session's own scratch directory (scripts/agent-session;
# devbox/session-scratch-reap removes it when the session ends), seeded from ~/.config/gcloud at the
# session's first call by scripts/gcloud-session-config. It is left alone when the caller set
# CLOUDSDK_CONFIG (the Linux eval lane gives each attempt its own), in an agentbox, whose
# container binds the host's .config/gcloud read-write, and where no copy can be made (the call
# then runs on ~/.config/gcloud as before). A command whose change must outlive the session (a
# sign-in, a credential activated or revoked, a property, a configuration, `init`, or a path an
# unknown flag makes ambiguous) still runs on ~/.config/gcloud, and the session's copy is set aside
# so that its next call copies again and sees the change. Every rule below reads whichever
# directory this picks.
GCLOUD_SESSION_COPIED=.gcloud-session-copied
# persists_config_change ARGV: the first two words of the command path, past global flags and one release track
# (read_command_words stops once a path cannot be a protected `auth` command, so for `config set` it holds only
# `config`), name a change that must outlive the session; or the path is ambiguous.
persists_config_change() {
    ((GCLOUD_COMMAND_AMBIGUOUS)) && return 0
    local arg track_stripped=0
    local -a words=()
    while (($#)) && ((${#words[@]} < 2)); do
        arg="$1"
        shift
        case "$arg" in
            -?*) if is_value_flag "$arg" && [[ "$arg" != *=* ]] && (($#)); then shift; fi ;;
            *)
                if ((${#words[@]} == 0 && !track_stripped)) && contains_word "$arg" "${GCLOUD_RELEASE_TRACKS[@]}"; then
                    track_stripped=1
                    continue
                fi
                words+=("$arg")
                ;;
        esac
    done
    case "${words[0]:-} ${words[1]:-}" in
        "auth login" | "auth activate-service-account" | "auth revoke" | "auth application-default" | \
            "auth configure-docker" | "auth enterprise-certificate-config" | \
            "config set" | "config unset" | "config configurations" | "init "*) return 0 ;;
    esac
    return 1
}
use_session_config() { # ARGV
    agent_context || return 0
    [[ -z "${CLOUDSDK_CONFIG:-}" && -z "${AGENTBOX_SESSION:-}" ]] || return 0
    local scratch="${AGENT_SESSION_SCRATCH:-}" target origin
    [[ -n "$scratch" && -d "$scratch" && -O "$scratch" ]] || return 0
    target="$scratch/gcloud"
    if persists_config_change "$@"; then
        [[ -e "$target" ]] && { mv -f -- "$target" "$target.replaced.$$" 2> /dev/null || true; }
        return 0
    fi
    if [[ ! -f "$target/$GCLOUD_SESSION_COPIED" ]]; then
        resolve_user_home 2> /dev/null || return 0
        origin="${GCLOUD_USER_HOME}/.config/gcloud"
        "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../scripts/gcloud-session-config" "$origin" "$target" \
            > /dev/null 2>&1 || return 0
    fi
    export CLOUDSDK_CONFIG="$target"
}

# The account a configuration sets: the `account` line of its file in gcloud's configuration
# directory, or nothing when the configuration or the line is missing.
config_account() {
    local account="" line
    resolve_config_root
    while IFS= read -r line; do
        [[ "$line" =~ ^account[[:space:]]*=[[:space:]]*([^[:space:]]+) ]] && account="${BASH_REMATCH[1]}"
    done < "${GCLOUD_CONFIG_ROOT}/configurations/config_$1" 2> /dev/null || true
    printf '%s' "$account"
}

# The configuration a call runs under, as the SDK picks it: the last --configuration when it is not
# empty, then the environment, then active_config, then `default` (named_configs.py:119-148,494-511).
effective_configuration() {
    local name
    name="$(effective_option_value --configuration "$@")"
    [[ -n "$name" ]] || name="${CLOUDSDK_ACTIVE_CONFIG_NAME:-${GCLOUD_ACCOUNT:-}}"
    resolve_config_root
    [[ -n "$name" ]] || name="$(cat "${GCLOUD_CONFIG_ROOT}/active_config" 2>/dev/null || true)"
    printf '%s' "${name:-default}"
}

# The configuration a login would sign in under, and its account, for the refusal text.
login_target() {
    local name account
    name="$(effective_configuration "$@")"
    account="$(config_account "$name")"
    printf 'the account this login signs in (configuration %s%s)' "$name" "${account:+, account $account}"
}

# The route every agent-session refusal ends with: the box identity for reads and the session's own
# work, the CI route or the applier for a production change, and the break-glass page for a step
# only a person can make. It names no sign-in command and no configuration of a person's.
print_agent_route() {
    local box_account root
    box_account="$(config_account box 2> /dev/null)" || box_account=""
    root="$(resolve_config_root 2> /dev/null && printf '%s' "$GCLOUD_CONFIG_ROOT")" || root="<gcloud config dir>"
    echo "  Instead: run as the box identity, configuration box${box_account:+ (${box_account})}, with no other configuration or account selected; your session's libraries and Pulumi already act as it (GOOGLE_APPLICATION_CREDENTIALS=${GOOGLE_APPLICATION_CREDENTIALS:-${root}/box_credential_config.json})."
    echo "  A production change goes through its program's CI apply on main, or an apply as ${GCLOUD_APPLIER}, impersonated from the box identity (CLOUDSDK_AUTH_IMPERSONATE_SERVICE_ACCOUNT=${GCLOUD_APPLIER})."
    echo "  A step only a person can make: send that person a dispatch ask that cites ${GCLOUD_BREAK_GLASS_URL}, which gives the person's steps."
}

# Refuses, in an agent session, a call that names a person's own Google login as its account,
# through --account or CLOUDSDK_CORE_ACCOUNT, under any configuration but the one that holds that
# login. A service account (*.gserviceaccount.com, the box identity among them) is a machine's and
# passes. An explicit --configuration whose own account is that login is the route an apply that no
# declared identity can make yet takes under Sami's standing permission, each use recorded
# (dispatch://INFRA-6/ask/6c7b1e80-176f-40e3-967e-e5d642d501ec), and passes. On 2026-11-02T00:07Z
# one agent shell exported its account as the user's; every later kubectl in it minted his token
# through gke-gcloud-auth-plugin, whose cache beside the kubeconfig is keyed by context, not
# account, so for an hour every caller of that kubeconfig created GKE Jobs as him.
refuse_user_account_in_agent_session() {
    agent_context || return 0
    local account source configuration file name holder=""
    account="$(effective_option_value --account "$@")"
    source="--account"
    if [[ -z "$account" ]]; then
        account="${CLOUDSDK_CORE_ACCOUNT:-}"
        source="CLOUDSDK_CORE_ACCOUNT in the environment"
    fi
    [[ -n "$account" && "$account" != *.gserviceaccount.com ]] || return 0
    configuration="$(effective_option_value --configuration "$@")"
    if [[ -n "$configuration" && "$(config_account "$configuration")" == "$account" ]]; then
        return 0
    fi
    resolve_config_root
    for file in "${GCLOUD_CONFIG_ROOT}"/configurations/config_*; do
        [[ -f "$file" ]] || continue
        name="${file##*/config_}"
        if [[ "$(config_account "$name")" == "$account" ]]; then
            holder="$name"
            break
        fi
    done
    {
        printf 'gcloud shim: REFUSED in an agent session (argv:'
        printf ' %q' "$@"
        printf ')\n'
        echo "  Identity: ${account}, a person's own Google login, named by ${source}."
        echo "  Why: a call under that login is that person's own act in Google Cloud, and naming an account reaches past this call: gke-gcloud-auth-plugin caches the token beside the kubeconfig and gives it to every later caller of that kubeconfig."
        echo "  Drop the account (unset CLOUDSDK_CORE_ACCOUNT; no --account)."
        print_agent_route
        if [[ -n "$holder" ]]; then
            echo "  An apply that no declared identity can make yet may use that login under Sami's standing permission (dispatch://INFRA-6/ask/6c7b1e80-176f-40e3-967e-e5d642d501ec): select its configuration (${holder}) explicitly with --configuration on that one command, and record the use on dispatch://INFRA-6. Never for a seed credential, a permission boundary or a new project."
        fi
    } >&2
    exit 1
}

# Refuses, in an agent session, every call that would write or remove the well-known ADC file,
# on every route: `auth application-default login|revoke`, and a login with --update-adc (or a
# --flags-file, which can hold it). That file is what every Google client library and Pulumi on
# the machine falls back to without GOOGLE_APPLICATION_CREDENTIALS, so whoever it names, every
# such process acts as. On 2026-11-01T02:53Z an agent's login under an explicit configuration
# kept --update-adc (only the routed bare login drops it) and wrote the user's own credential
# there. The text names no login command: the route is the box identity, CI, or a person.
refuse_adc_write_in_agent_session() {
    agent_context || return 0
    local what identity
    resolve_config_root
    local adc="${GCLOUD_CONFIG_ROOT}/application_default_credentials.json"
    if ((GCLOUD_POSSIBLE_ADC_OPERATION)); then
        what="it would write or remove ${adc}"
        identity="the Google account signed in in the browser (login), or none (revoke)"
    elif ((GCLOUD_POSSIBLE_LOGIN)) && { has_option --update-adc "$@" || has_option --flags-file "$@"; }; then
        what="--update-adc would write ${adc}"
        has_option --update-adc "$@" || what="a --flags-file can hold --update-adc, which would write ${adc}"
        identity="$(login_target "$@")"
    else
        return 0
    fi
    {
        printf 'gcloud shim: REFUSED in an agent session (argv:'
        printf ' %q' "$@"
        printf ')\n'
        echo "  Identity: $what as $identity."
        echo "  Why: every Google client library and Pulumi on this machine without GOOGLE_APPLICATION_CREDENTIALS acts as whoever that file names, so one write changes the identity of every such process. No agent process writes it."
        print_agent_route
    } >&2
    exit 1
}

# True for `compute instances create` and `compute instances bulk create` (and `bulk-create`): the
# first words of the command path past global flags, their values and one release track. A
# command's own flag before its last command word (`compute --zone z instances create`) is not
# a form the SDK parses, so it is not read here either.
is_instance_create() {
    local arg track_stripped=0
    local -a words=()
    while (($#)) && ((${#words[@]} < 4)); do
        arg="$1"
        shift
        case "$arg" in
            --) break ;;
            -?*)
                if is_value_flag "$arg" && [[ "$arg" != *=* ]] && (($#)); then
                    shift
                fi
                ;;
            *)
                if ((${#words[@]} == 0 && !track_stripped)) &&
                    contains_word "$arg" "${GCLOUD_RELEASE_TRACKS[@]}"; then
                    track_stripped=1
                    continue
                fi
                words+=("$arg")
                ;;
        esac
    done
    [[ "${words[0]:-} ${words[1]:-}" == "compute instances" ]] || return 1
    [[ "${words[2]:-}" == create || "${words[2]:-}" == bulk-create || "${words[2]:-} ${words[3]:-}" == "bulk create" ]]
}

# Refuses, in an agent session, a VM create that carries no run-time limit on its command line:
# neither --max-run-duration nor --termination-time. A VM an agent creates for a while and then
# forgets runs, and bills, until someone stops it; with a limit Google stops it and keeps its disk
# (dispatch://INFRA-672/ask/a76ad180-3939-48ed-87bf-a6b716d4def0). A long-lived VM is declared in
# code with an owner instead, and a one-off create of one passes with GCLOUD_NO_RUN_LIMIT=<reason>.
# A limit inside a --flags-file or an instance template is not seen here, so it is refused too:
# put the flag on the command line. The argv of a call that passes is never changed.
refuse_instance_create_without_run_limit() {
    agent_context || return 0
    [[ -z "${GCLOUD_NO_RUN_LIMIT:-}" ]] || return 0
    is_instance_create "$@" || return 0
    has_option --max-run-duration "$@" && return 0
    has_option --termination-time "$@" && return 0
    {
        printf 'gcloud shim: REFUSED in an agent session (argv:'
        printf ' %q' "$@"
        printf ')\n'
        echo "  Why: this VM has no run-time limit, so it runs and bills until someone stops it."
        echo "  Add a limit at creation: --max-run-duration=<duration, e.g. 8h; 30s to 120d> (or --termination-time=<RFC 3339 time>) with --instance-termination-action=STOP, which stops the VM when the time runs out and keeps its disk."
        echo "  With local SSD also add --discard-local-ssds-at-termination-timestamp=true; the local SSD data is lost at that stop. Spot VMs take a limit; legacy --preemptible VMs cannot."
        echo "  To extend: start the VM again after it stops (a duration restarts at each start); gcloud compute instances set-scheduling changes the limit only while the VM is stopped."
        echo "  Docs: ${GCLOUD_RUN_LIMIT_DOCS_URL}"
        echo "  A long-lived VM (a service, a dev box) is declared in code with an owner= label; to create one by hand, set GCLOUD_NO_RUN_LIMIT=<reason> on this one command."
    } >&2
    exit 1
}

# The real gcloud: the first `gcloud` on PATH that is not this shim nor a copy of it. A copy is a
# file with the same bytes, or one that holds the marker line at the top of this file (a copy of
# another version). Each copy would take the other for the real one: at 06:23Z on 2026-11-03 a
# scratch copy put ahead of shims/ on PATH and the installed shim called each other until the agent
# box's 8192 processes were used up, and the box's omp stopped (dispatch://INFRA-993).
GCLOUD_SHIM_MARKER="# dotfiles gcloud shim: find_real_gcloud skips any file that holds this exact line."
find_real_gcloud() {
    local self candidate resolved
    self="$(readlink -f "${BASH_SOURCE[0]}")"
    while IFS= read -r candidate; do
        resolved="$(readlink -f "$candidate")"
        [[ "$resolved" == "$self" ]] && continue
        cmp -s "$resolved" "$self" && continue
        grep -qxF "$GCLOUD_SHIM_MARKER" "$resolved" 2>/dev/null && continue
        printf '%s\n' "$candidate"
        return 0
    done < <(type -ap gcloud)
    # Minimal-PATH spawners (MCP servers, cron, etc.) carry neither the
    # dotfiles shims nor the SDK's own bin dir; fall back to the documented
    # install location, under the home gcloud itself would use, before failing.
    candidate=""
    if resolve_user_home; then
        candidate="${GCLOUD_USER_HOME}/.gcloud/google-cloud-sdk/bin/gcloud"
    fi
    if [[ -n "$candidate" && -x "$candidate" && "$(readlink -f "$candidate")" != "$self" ]]; then
        printf '%s\n' "$candidate"
        return 0
    fi
    echo "gcloud shim: real gcloud binary not found on PATH or at the default SDK install location" >&2
    return 127
}

# `container clusters get-credentials` writes the cluster's context into the kubeconfig KUBECONFIG
# names, else ~/.kube/config, and makes it that file's current-context. ~/.kube/config is shared by
# every session on the machine: on 2026-11-02 (16:04Z and again after 19:30Z) an agent's
# get-credentials for grade-us-west1 switched it to the grade cluster, and every other session's
# `kubectl create` in builds-* failed with "requires container.jobs.create". So in an agent session
# with KUBECONFIG unset or empty, the call writes ~/.kube/config.d/<cluster> instead, and says which
# file to export. A person's own shell, and a caller that set KUBECONFIG, are unchanged.
# The command's own value flags (--zone/-z, --region, --location) consume their values, as the
# global ones do, so the one positional left after `get-credentials` is the cluster.
GKE_GET_CREDENTIALS_VALUE_FLAGS=(--zone -z --region --location)
route_get_credentials_kubeconfig() {
    agent_context || return 0
    [[ -z "${KUBECONFIG:-}" ]] || return 0
    local arg track_stripped=0 cluster home dir
    local -a words=()
    while (($#)); do
        arg="$1"
        shift
        case "$arg" in
            -?*)
                if { is_value_flag "$arg" || contains_word "$arg" "${GKE_GET_CREDENTIALS_VALUE_FLAGS[@]}"; } &&
                    [[ "$arg" != *=* ]] && (($#)); then
                    shift
                fi
                ;;
            *)
                if ((${#words[@]} == 0 && !track_stripped)) && contains_word "$arg" "${GCLOUD_RELEASE_TRACKS[@]}"; then
                    track_stripped=1
                    continue
                fi
                words+=("$arg")
                ;;
        esac
    done
    [[ "${words[0]:-}" == container && "${words[1]:-}" == clusters && "${words[2]:-}" == get-credentials ]] || return 0
    cluster="${words[3]:-}"
    cluster="${cluster##*/}"
    if ((${#words[@]} != 4)) || [[ ! "$cluster" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
        echo "gcloud shim: refusing container clusters get-credentials in an agent session with KUBECONFIG unset: the cluster name cannot be read from argv (${words[*]:3}), and the call would write ~/.kube/config, which every session on this machine shares. Set KUBECONFIG to a file of your own, e.g. KUBECONFIG=\$HOME/.kube/config.d/<cluster>." >&2
        exit 1
    fi
    resolve_user_home || {
        echo "gcloud shim: refusing container clusters get-credentials: no home directory to put a kubeconfig of its own in, and the shared one is not written. Set KUBECONFIG." >&2
        exit 1
    }
    home="$GCLOUD_USER_HOME"
    dir="${home}/.kube/config.d"
    mkdir -p -m 700 "$dir"
    export KUBECONFIG="${dir}/${cluster}"
    echo "gcloud shim: writing ${cluster}'s credentials to ${KUBECONFIG}, not ~/.kube/config (every session on this machine shares that file and its current-context). Use it with: export KUBECONFIG=${KUBECONFIG}" >&2
}

# A config dir copied from an Azure box to a Google VM keeps the Azure box credential that gcloud
# stored (an external_account entry whose subject token comes from the Azure metadata service), and
# gcloud reads it before it asks the Google metadata server, so every call fails with "Unable to
# retrieve Identity Pool subject token ... gcloud auth login". On 2026-11-03 the agent session of
# LINUX-1248, moved from sami-rocqperf to sami-devbox (dispatch://INFRA-993), brought such a dir as
# its own CLOUDSDK_CONFIG. installers/gcloud-box.sh repairs ~/.config/gcloud once; this repairs
# whichever dir a call uses, through the same scripts/gcloud-drop-azure-credential. The checks run
# cheapest first, so a call elsewhere pays a file test and at most one grep: the store holds the
# Azure path's bytes, this machine can be a Google VM (an agent box on one has GCE_METADATA_HOST,
# set by scripts/agentbox; the VM itself has Google's DMI product name), and scripts/on-google-vm
# says it is one. On an Azure box the second check stops it, so no call there waits for the
# metadata lookup. The removal's report goes to stderr; a failed removal is reported and the call
# runs anyway, and gcloud then says what is wrong.
AZURE_IMDS_TOKEN_PATH=/metadata/identity/oauth2/token
drop_azure_credential_on_google_vm() {
    local dir dmi="" bin
    if [[ -n "${CLOUDSDK_CONFIG:-}" ]]; then
        dir="$CLOUDSDK_CONFIG"
    elif resolve_user_home; then
        dir="${GCLOUD_USER_HOME}/.config/gcloud"
    else
        return 0
    fi
    [[ -f "$dir/credentials.db" ]] || return 0
    grep -qaF "$AZURE_IMDS_TOKEN_PATH" "$dir/credentials.db" 2>/dev/null || return 0
    if [[ -z "${GCE_METADATA_HOST:-}" ]]; then
        [[ -r /sys/class/dmi/id/product_name ]] && dmi="$(</sys/class/dmi/id/product_name)"
        [[ "$dmi" == "Google Compute Engine" ]] || return 0
    fi
    bin="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../scripts"
    "$bin/on-google-vm" || return 0
    "$bin/gcloud-drop-azure-credential" "$dir" 2>&1 | sed 's/^/gcloud shim: /' >&2 || true
}

# gcloud writes one log file per call into <config dir>/logs and never prunes it: on
# sami-rocqperf that was 8,356 files in ~/.config/gcloud/logs and 18,213 in a second
# configuration directory in one day (2026-10-25, dispatch://INFRA-6), tens of GB. It also
# copies a command's output into that file (calliope/display.py's log.out, core/log.py), so a
# printed token lands there too. File logging is off for every call, in every configuration
# directory and every configuration, a new one included, unless the caller set it either way.
exec_real_gcloud() {
    local real_gcloud="$1"
    shift
    export CLOUDSDK_CORE_DISABLE_FILE_LOGGING="${CLOUDSDK_CORE_DISABLE_FILE_LOGGING:-1}"
    drop_azure_credential_on_google_vm
    limit_storage_parallelism "$real_gcloud" "$@"
    local -a launcher=("$real_gcloud")
    if needs_forward_browser; then
        launcher=(env DISPLAY=:0 "BROWSER=forward open %s" "$real_gcloud")
    fi
    if is_lock_retry_safe "$@"; then
        run_with_lock_retry "${launcher[@]}" "$@"
    fi
    exec "${launcher[@]}" "$@"
}

# `gcloud storage` sizes its worker pool from the core count when nothing sets
# storage/process_count (lib/googlecloudsdk/command_lib/storage/optimize_parameters_util.py:58-127):
# on a 64-core box a copy of many files starts 16 worker processes of 4 threads each. On
# 2026-11-02 at 21:11Z there were 157 gcloud processes on sami-rocqperf, in groups of 16, while it
# swapped 53 GiB at load 900-1,400. For a `gcloud storage` command the shim sets the process count
# to GCLOUD_STORAGE_PROCESS_COUNT unless the caller set it: in the environment (an empty value
# included), in the configuration the call runs under, or in the SDK's installation properties,
# which the environment would otherwise outrank. The thread count stays the SDK's own choice.
# Measured that day on that box (load 300-360), `storage cp -r` of 1,024 files of 2 MiB, two runs
# each: the SDK's 16 processes took 21-30 s up and 12-18 s down, peaking at 18 processes and
# 1.8 GiB summed RSS (0.68 GiB PSS); 4 processes took 39-45 s up and 12-20 s down, at 6 processes
# and 0.62 GiB RSS (0.27 GiB PSS). 8 threads per process instead of 4 gained nothing.
GCLOUD_STORAGE_PROCESS_COUNT=4
limit_storage_parallelism() {
    local real_gcloud="$1"
    shift
    [[ "${GCLOUD_COMMAND_WORDS[0]:-}" == storage && -z "${CLOUDSDK_STORAGE_PROCESS_COUNT+set}" ]] || return 0
    local -a files=("$(dirname "$(readlink -f "$real_gcloud")")/../properties")
    if [[ -n "${CLOUDSDK_CONFIG:-}" ]] || resolve_user_home; then
        resolve_config_root
        files+=("${GCLOUD_CONFIG_ROOT}/configurations/config_$(effective_configuration "$@")")
    fi
    storage_process_count_is_set "${files[@]}" ||
        export CLOUDSDK_STORAGE_PROCESS_COUNT="$GCLOUD_STORAGE_PROCESS_COUNT"
}

# True when one of the property files sets process_count in its [storage] section.
storage_process_count_is_set() {
    local file line section
    for file in "$@"; do
        [[ -f "$file" ]] || continue
        section=""
        while IFS= read -r line || [[ -n "$line" ]]; do
            if [[ "$line" =~ ^[[:space:]]*\[([^]]*)\] ]]; then
                section="${BASH_REMATCH[1]}"
            elif [[ "$section" == storage && "$line" =~ ^[[:space:]]*process_count[[:space:]]*= ]]; then
                return 0
            fi
        done 2> /dev/null < "$file" || :
    done
    return 1
}

# The SDK opens its sqlite stores in the configuration directory with a 5 s busy timeout
# (lib/googlecloudsdk/core/credentials/creds.py:364-368). It only warns when the access-token
# cache (access_tokens.db) is locked, but a locked credentials.db is a crash: `config
# config-helper`, which gke-gcloud-auth-plugin runs for every kubectl call, writes the
# credential back on every call (lib/surface/config/config_helper.py:116, creds.py:555). With
# 60 concurrent calls on sami-rocqperf on 2026-11-02, 23 died with exactly that crash and exit 1.
# `gcloud storage` loads the credential again in each worker of its task graph, and a worker
# that finds credentials.db locked logs only the error's text and fails its one task
# (lib/googlecloudsdk/command_lib/storage/tasks/task_graph_executor.py:322): `ERROR: database
# is locked`, after the progress dots gcloud writes to a stderr that is no terminal, and the
# command ends with exit 1 once its other tasks are done. With a second writer holding
# credentials.db 6 s in every 7.5 s, 10 of 10 `storage cp -r` and `rsync` runs of 16 files
# lost 1 to 13 files that way (2026-11-02). A line that is only that text or the crash's,
# after any dots, is a locked store; any other result passes through as it came.
GCLOUD_LOCK_ERROR='^\.*ERROR: (gcloud crashed \(OperationalError\): )?database is locked$'
# How long a call keeps running again on that text, from the shim's start, and how many of the
# calls sharing a configuration directory may run a repeat attempt at once. At 00:38Z on
# 2026-11-03 sami-rocqperf's root disk, which holds credentials.db, was saturated (io some avg60
# 93%, earlyoom killing): for about two minutes no writer committed, and 67 calls that each had
# had 6 attempts over about 40 s gave up, while 649 repeat attempts, each a new SDK process of
# its own, added to the load on that same disk. So a call waits for the store, up to
# GCLOUD_LOCK_RETRY_SECONDS, and a repeat attempt first takes one of GCLOUD_LOCK_RETRY_SLOTS
# flock(1) slots in <config dir>/.gcloud-shim-retry-slots, waiting in the kernel and not in a
# new process; without flock(1) (macOS) or that directory it repeats without a slot. A first
# attempt never waits. Both values can be set in the environment; 0 slots is no limit.
GCLOUD_LOCK_RETRY_SECONDS="${GCLOUD_LOCK_RETRY_SECONDS:-300}"
GCLOUD_LOCK_RETRY_SLOTS="${GCLOUD_LOCK_RETRY_SLOTS:-8}"

# The retry's clock, in whole seconds, in GCLOUD_LOCK_NOW: bash's SECONDS, or what the command
# GCLOUD_LOCK_RETRY_CLOCK prints when that is set. The tests set it to a clock that only their
# stub `sleep` moves, so the number of attempts before the deadline follows from the backoff
# alone, not from the machine's load: on sami-rocqperf at load 300-380 (2026-11-03) a real clock
# let only 4-6 attempts into a 10 s deadline, and the tests that bound the retry failed.
GCLOUD_LOCK_NOW=0
lock_retry_clock() {
    if [[ -n "${GCLOUD_LOCK_RETRY_CLOCK:-}" ]]; then
        GCLOUD_LOCK_NOW="$("$GCLOUD_LOCK_RETRY_CLOCK")"
    else
        GCLOUD_LOCK_NOW=$SECONDS
    fi
}

# True for a command that running again repeats nothing, and that reads no stdin. The command
# words are read as read_command_words reads them, to the fourth word; a `-` anywhere, as an
# entry or a value, or a --flags-file can mean stdin, and is never retried.
# - Any other group's `describe`, `list` or `get-iam-policy` (GCLOUD_LOCK_READ_VERBS) as the
#   second to fourth word: `compute instances describe`, `container clusters list`, `iam
#   service-accounts keys list`. On 2026-11-03 at 01:52Z transcript-mirror.service failed when
#   `compute instances describe` crashed on a locked credentials.db. A command that changes
#   anything is never retried: the SDK prints the same crash text whether or not its request went
#   out (the traceback goes only to gcloud's file log, which this shim turns off), so a second
#   attempt could repeat a create or a delete. Output is held back, as for the reads below.
# - Reads that print: `auth print-access-token|print-identity-token|list`, `config
#   config-helper|get|get-value|list|configurations list|configurations describe`, and
#   `storage sign-url`. GCLOUD_LOCK_RETRY_STREAM is 0: an attempt's output is held back, so only
#   the attempt that counts is shown.
# - `storage ls|cat|du`, `storage objects|buckets list|describe`: reads of the bucket.
#   `storage cp` and `rsync`: each object they copy gets the same bytes on every attempt, and a
#   file or object an earlier attempt copied is copied again or, by rsync, skipped. Not with
#   `--delete-unmatched-destination-objects` (or any other `--delete` flag), which removes, or
#   with `-I`/`--read-paths-from-stdin`, which reads stdin, or with a path that exists and is
#   neither a regular file nor a directory (a pipe, `/dev/fd/N`, a device), which an attempt
#   can drain. `storage mv` and `rm` remove a source and stay out. GCLOUD_LOCK_RETRY_STREAM is 1:
#   stdout goes through as it comes (`storage cat` of a large object into a pipe), and an attempt
#   that wrote a byte of it is never run again; stderr shows every attempt.
GCLOUD_LOCK_READ_VERBS=(describe list get-iam-policy)
GCLOUD_LOCK_RETRY_STREAM=0
is_lock_retry_safe() {
    local arg track_stripped=0 path_words=-1
    local -a words=() all=("$@")
    for arg in "$@"; do
        case "$arg" in
            - | *=- | --flags-file | --flags-file=*) return 1 ;;
        esac
    done
    while (($#)) && ((${#words[@]} < 4)); do
        arg="$1"
        shift
        case "$arg" in
            -?*)
                if is_value_flag "$arg"; then
                    if [[ "$arg" != *=* ]] && (($#)); then
                        shift
                    fi
                elif ! is_boolean_flag "$arg" && ((path_words < 0)); then
                    # A command's own flag ends the command path: its value could be any word.
                    path_words=${#words[@]}
                fi
                ;;
            *)
                if ((${#words[@]} == 0 && !track_stripped)) &&
                    contains_word "$arg" "${GCLOUD_RELEASE_TRACKS[@]}"; then
                    track_stripped=1
                    continue
                fi
                words+=("$arg")
                ;;
        esac
    done
    GCLOUD_LOCK_SUBCOMMAND="${words[*]:0:3}"
    case "${words[0]:-} ${words[1]:-}" in
        "auth print-access-token" | "auth print-identity-token" | "auth list" | \
            "config config-helper" | "config get" | "config get-value" | "config list" | \
            "storage sign-url")
            return 0
            ;;
        "config configurations")
            [[ "${words[2]:-}" == list || "${words[2]:-}" == describe ]]
            return
            ;;
        "storage objects" | "storage buckets")
            [[ "${words[2]:-}" == list || "${words[2]:-}" == describe ]] || return 1
            ;;
        "storage ls" | "storage cat" | "storage du" | "storage cp" | "storage rsync") ;;
        *)
            # The read verb comes before any of the command's own flags, whose values (`compute
            # ssh vm --command list`) are not the path, and not after `ssh` or `scp`.
            ((path_words >= 0)) || path_words=${#words[@]}
            [[ "${words[1]:-}" != ssh && "${words[1]:-}" != scp ]] || return 1
            local i
            for ((i = 1; i < path_words; i++)); do
                contains_word "${words[i]}" "${GCLOUD_LOCK_READ_VERBS[@]}" && return 0
            done
            return 1
            ;;
    esac
    for arg in "${all[@]}"; do
        case "$arg" in
            --delete* | --read-paths-from-stdin | --read-paths-from-stdin=*) return 1 ;;
            --*) ;;
            -*I*) return 1 ;;
            *)
                if [[ -e "$arg" && ! -f "$arg" && ! -d "$arg" ]]; then
                    return 1
                fi
                ;;
        esac
    done
    GCLOUD_LOCK_RETRY_STREAM=1
}

# One attempt with stdout streamed: its first byte, if any, lands in <dir>/first on the way out,
# and stderr goes out and to <dir>/err through tee, which has ended when this returns. Its status
# is in <dir>/status.
run_streamed_attempt() {
    local dir="$GCLOUD_RETRY_DIR"
    {
        {
            local status=0
            "$@" || status=$?
            printf '%s\n' "$status" >"${dir}/status"
        } 2>&1 1>&3 3>&- | tee -- "${dir}/err" >&2 3>&-
    } 3>&1 | {
        head -c 1 >"${dir}/first"
        cat -- "${dir}/first"
        cat
    } || :
}

# Every lock text an attempt printed adds one line to GCLOUD_LOCK_LOG, so counting lock hits is
# `wc -l`, not a scan of transcripts:
# `<UTC time>\t<kind>\t<outcome>\t<subcommand>\t<pid>\t<session>\t<caller>`.
# Kinds are the two texts of GCLOUD_LOCK_ERROR, the locked store this retry handles: `credcache`
# is the SDK's crash on a locked credentials.db (`gcloud crashed (OperationalError): database is
# locked`), and `store` is a `gcloud storage` worker's `ERROR: database is locked`. Their outcome
# is `retried` when the shim runs the call again, else `gave-up`. Kind `token-cache` is any other
# line with `database is locked`, the SDK's warning that access_tokens.db was locked (`Could not
# initialize access token cache schema: database is locked`, `Could not store access token in
# cache: database is locked`); its outcome is `warning`, since the call goes on. The pid is the
# shim's; the session is OMP_SESSION_ID (`-` outside omp), and the caller is the program that ran
# the shim, from /proc/<parent>/cmdline: its name and its first argument that is no option (a
# script, or the module after -m; nothing after -c), since the pid is gone once the call ends.
# Only calls that run through this retry are seen; every other call is exec'd with its stderr
# untouched. Each line is one O_APPEND write, and a log that cannot be written never changes the
# call.
GCLOUD_LOCK_SUBCOMMAND=""
GCLOUD_LOCK_CALLER=""
lock_caller() {
    [[ -n "$GCLOUD_LOCK_CALLER" ]] && return 0
    local -a argv=()
    local arg i caller="-"
    if [[ -r "/proc/${PPID}/cmdline" ]]; then
        while IFS= read -r -d '' arg && ((${#argv[@]} < 8)); do
            argv+=("$arg")
        done 2>/dev/null <"/proc/${PPID}/cmdline" || :
    fi
    if ((${#argv[@]})); then
        caller="${argv[0]##*/}"
        for ((i = 1; i < ${#argv[@]}; i++)); do
            arg="${argv[i]}"
            [[ "$arg" == -c ]] && break
            if [[ "$arg" == -m ]]; then
                caller+=" -m ${argv[i + 1]:-}"
                break
            fi
            [[ "$arg" == -* ]] && continue
            caller+=" ${arg}"
            break
        done
    fi
    caller="${caller//[$'\t\n\r']/ }"
    GCLOUD_LOCK_CALLER="${caller:0:200}"
}

log_lock_hits() {
    local outcome="$1" err="${GCLOUD_RETRY_DIR}/err" line kinds=""
    grep -qF -- "database is locked" "$err" 2>/dev/null || return 0
    while IFS= read -r line || [[ -n "$line" ]]; do
        if [[ "$line" =~ $GCLOUD_LOCK_ERROR ]]; then
            if [[ "$line" == *"gcloud crashed"* ]]; then
                [[ "$kinds" == *credcache* ]] || kinds+=" credcache"
            else
                [[ "$kinds" == *" store"* ]] || kinds+=" store"
            fi
        elif [[ "$line" == *"database is locked"* ]]; then
            [[ "$kinds" == *token-cache* ]] || kinds+=" token-cache"
        fi
    done 2>/dev/null < <(grep -F -- "database is locked" "$err" 2>/dev/null) || :
    [[ -n "$kinds" ]] || return 0
    local log dir now kind
    if [[ -n "${GCLOUD_LOCK_LOG:-}" ]]; then
        log="$GCLOUD_LOCK_LOG"
    else
        resolve_user_home 2>/dev/null || return 0
        log="${GCLOUD_USER_HOME}/.local/state/gcloud-shim/locks.tsv"
    fi
    dir="$(dirname -- "$log")"
    [[ -d "$dir" ]] || mkdir -p -- "$dir" 2>/dev/null || return 0
    now="$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)" || return 0
    lock_caller
    for kind in $kinds; do
        if [[ "$kind" != token-cache ]]; then
            line="$outcome"
        else
            line=warning
        fi
        { printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$now" "$kind" "$line" "$GCLOUD_LOCK_SUBCOMMAND" "$$" \
            "${OMP_SESSION_ID:--}" "$GCLOUD_LOCK_CALLER" >>"$log"; } 2>/dev/null || :
    done
    return 0
}

# Takes a repeat-attempt slot on fd 9 (see GCLOUD_LOCK_RETRY_SLOTS), waiting on one random slot
# at a time, at most 5 s, so a slot whose holder runs a long transfer does not hold the waiter.
# Returns 1 only when the deadline passes first; with no slot to take it returns 0 at once.
GCLOUD_LOCK_SLOT_DIR=""
take_retry_slot() {
    local deadline="$1" wait slot
    exec 9>&-
    ((GCLOUD_LOCK_RETRY_SLOTS > 0)) && command -v flock >/dev/null 2>&1 || return 0
    if [[ -z "$GCLOUD_LOCK_SLOT_DIR" ]]; then
        if [[ -n "${CLOUDSDK_CONFIG:-}" ]] || resolve_user_home 2>/dev/null; then
            resolve_config_root
            GCLOUD_LOCK_SLOT_DIR="${GCLOUD_CONFIG_ROOT}/.gcloud-shim-retry-slots"
        fi
        [[ -n "$GCLOUD_LOCK_SLOT_DIR" ]] || GCLOUD_LOCK_RETRY_SLOTS=0
        mkdir -p -m 700 -- "$GCLOUD_LOCK_SLOT_DIR" 2>/dev/null || GCLOUD_LOCK_RETRY_SLOTS=0
        ((GCLOUD_LOCK_RETRY_SLOTS > 0)) || return 0
    fi
    while :; do
        lock_retry_clock
        wait=$((deadline - GCLOUD_LOCK_NOW))
        ((wait > 0)) || return 1
        ((wait > 5)) && wait=5
        slot="${GCLOUD_LOCK_SLOT_DIR}/$((RANDOM % GCLOUD_LOCK_RETRY_SLOTS))"
        # The group keeps 2>/dev/null to this open: a bare `exec ... 2>/dev/null` would silence
        # the shim's own stderr, and gcloud's, for the rest of the call.
        { exec 9>>"$slot"; } 2>/dev/null || return 0
        flock -w "$wait" 9 2>/dev/null && return 0
        exec 9>&-
    done
}

# Runs argv (gcloud, or its launcher) and exits with its status; never returns. Without a
# private directory for the output it execs argv once, as before. gcloud runs without fd 9, so
# only the shim holds a slot.
GCLOUD_RETRY_DIR=""
run_with_lock_retry() {
    local status attempt=1 delay_ms retry deadline
    lock_retry_clock
    deadline=$((GCLOUD_LOCK_NOW + GCLOUD_LOCK_RETRY_SECONDS))
    GCLOUD_RETRY_DIR="$(mktemp -d "${TMPDIR:-/tmp}/gcloud-shim.XXXXXX")" || exec "$@"
    # A printed token sits in that directory until gcloud's attempt ends; remove it on every exit.
    trap 'rm -rf "$GCLOUD_RETRY_DIR"' EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
    while :; do
        status=0
        if ((GCLOUD_LOCK_RETRY_STREAM)); then
            rm -f -- "${GCLOUD_RETRY_DIR}/status"
            run_streamed_attempt "$@" 9>&-
            status="$(cat -- "${GCLOUD_RETRY_DIR}/status" 2>/dev/null || echo 1)"
            if ((status == 0)) || [[ -s "${GCLOUD_RETRY_DIR}/first" ]] ||
                ! grep -qxE -- "$GCLOUD_LOCK_ERROR" "${GCLOUD_RETRY_DIR}/err"; then
                log_lock_hits gave-up
                exit "$status"
            fi
        else
            "$@" >"${GCLOUD_RETRY_DIR}/out" 2>"${GCLOUD_RETRY_DIR}/err" 9>&- || status=$?
            if ((status == 0)) || ! grep -qxE -- "$GCLOUD_LOCK_ERROR" "${GCLOUD_RETRY_DIR}/err"; then
                log_lock_hits gave-up
                cat -- "${GCLOUD_RETRY_DIR}/out"
                cat -- "${GCLOUD_RETRY_DIR}/err" >&2
                exit "$status"
            fi
        fi
        # No attempt runs without its backoff: one whose wait would pass the deadline is not run.
        delay_ms=$((200 * attempt + RANDOM % (400 * attempt)))
        ((delay_ms > 6000)) && delay_ms=$((2000 + RANDOM % 4000))
        retry=0
        lock_retry_clock
        if ((GCLOUD_LOCK_NOW + (delay_ms + 999) / 1000 < deadline)); then
            printf 'gcloud shim: another gcloud held a sqlite store in the configuration directory past the SDK busy timeout (attempt %d; running it again for up to %d s in all); next attempt in %d.%03d s.\n' \
                "$attempt" "$GCLOUD_LOCK_RETRY_SECONDS" "$((delay_ms / 1000))" "$((delay_ms % 1000))" >&2
            sleep "$((delay_ms / 1000)).$(printf '%03d' "$((delay_ms % 1000))")"
            take_retry_slot "$deadline" && retry=1
        fi
        if ((!retry)); then
            log_lock_hits gave-up
            if ((!GCLOUD_LOCK_RETRY_STREAM)); then
                cat -- "${GCLOUD_RETRY_DIR}/out"
                cat -- "${GCLOUD_RETRY_DIR}/err" >&2
            fi
            exit "$status"
        fi
        log_lock_hits retried
        attempt=$((attempt + 1))
    done
}

main() {
    local real_gcloud
    # split is load-bearing — `local x=$(cmd)` masks the command's exit status and would defeat fail-loud.
    real_gcloud="$(find_real_gcloud)"

    parse_gcloud_command_path "$@"
    use_session_config "$@"
    refuse_adc_write_in_agent_session "$@"
    refuse_user_account_in_agent_session "$@"
    refuse_instance_create_without_run_limit "$@"
    route_get_credentials_kubeconfig "$@"

    # Read the ADC only for a command this block can refuse: an ambiguous path that
    # could be a protected one, or application-default login/revoke. Every other call
    # leaves the credential file unopened, so a runtime monitor that watches who opens
    # it sees gcloud, not this wrapper.
    if ((GCLOUD_COMMAND_AMBIGUOUS)); then
        if { ((GCLOUD_POSSIBLE_LOGIN)) && login_lands_on_box "$@"; } ||
            { ((GCLOUD_POSSIBLE_ADC_OPERATION)) && adc_is_box_identity; }; then
            echo "gcloud shim: refusing a command whose path an unrecognized flag makes ambiguous while it could still be a protected auth command; drop that flag, or name a configuration explicitly (--configuration <name>, or GCLOUD_ACCOUNT=<name>)." >&2
            if agent_context; then
                print_agent_route >&2
            fi
            exit 1
        fi
    elif ((GCLOUD_READING_KINDS == 2)) && adc_is_box_identity; then
        echo "gcloud shim: refusing auth application-default ${GCLOUD_COMMAND_WORDS[2]}: this box's Application Default Credentials are its own identity and stay so; sign in as yourself with gcloud auth login, which agent-secrets and gcloud use." >&2
        exit 1
    fi

    if is_box_routed_auth_login "$@"; then
        if has_option --flags-file "$@"; then
            echo "gcloud shim: refusing implicit box auth login with --flags-file; name the configuration to sign in under explicitly (--configuration <name>, or GCLOUD_ACCOUNT=<name>)." >&2
            exit 1
        fi
        resolve_config_root
        local config_dir="${GCLOUD_CONFIG_ROOT}/configurations"
        if [[ ! -f "${config_dir}/config_${USER_LOGIN_CONFIGURATION}" ]]; then
            echo "gcloud shim: configuration ${USER_LOGIN_CONFIGURATION} is missing at ${config_dir}/config_${USER_LOGIN_CONFIGURATION}; create it with gcloud config configurations create ${USER_LOGIN_CONFIGURATION} --no-activate." >&2
            exit 1
        fi

        local -a routed_args=()
        local arg update_adc=0
        for arg in "$@"; do
            if [[ "$arg" == --update-adc ]]; then
                update_adc=1
                continue
            fi
            routed_args+=("$arg")
        done

        echo "gcloud shim: routing auth login to configuration ${USER_LOGIN_CONFIGURATION} because box is this machine's own identity." >&2
        if ((update_adc)); then
            echo "gcloud shim: dropping --update-adc: the box's ADC stays its own identity." >&2
        fi
        export CLOUDSDK_ACTIVE_CONFIG_NAME="$USER_LOGIN_CONFIGURATION"
        exec_real_gcloud "$real_gcloud" "${routed_args[@]}"
    fi

    local account="${GCLOUD_ACCOUNT:-}"
    if [[ -z "$account" ]]; then
        exec_real_gcloud "$real_gcloud" "$@"
    fi

    # Reject path separators and dot-segments before they ever touch a
    # filesystem path: an account name is a bare configuration name, never a
    # traversal into an arbitrary file.
    case "$account" in
        */* | . | ..)
            echo "gcloud shim: GCLOUD_ACCOUNT '${account}' is not a valid gcloud configuration name" >&2
            exit 1
            ;;
    esac
    resolve_config_root
    local config_dir="${GCLOUD_CONFIG_ROOT}/configurations"
    local config_file="${config_dir}/config_${account}"

    if [[ ! -f "$config_file" ]]; then
        local candidate available
        local -a names=()
        if [[ -d "$config_dir" ]]; then
            for candidate in "$config_dir"/config_*; do
                [[ -f "$candidate" ]] || continue
                names+=("${candidate##*/config_}")
            done
        fi
        if [[ "${#names[@]}" -gt 0 ]]; then
            available="$(IFS=', '; echo "${names[*]}")"
        else
            available="(none found in ${config_dir})"
        fi
        echo "gcloud shim: GCLOUD_ACCOUNT '${account}' has no gcloud configuration at ${config_file}; available configurations: ${available}" >&2
        exit 1
    fi

    export CLOUDSDK_ACTIVE_CONFIG_NAME="$account"
    exec_real_gcloud "$real_gcloud" "$@"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
