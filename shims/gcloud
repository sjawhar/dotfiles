#!/bin/bash
# gcloud wrapper: select a named gcloud configuration via GCLOUD_ACCOUNT,
# instead of typing CLOUDSDK_ACTIVE_CONFIG_NAME=<name> per command or mutating
# global state with `gcloud config configurations activate`.
#
# On a box, a plain `gcloud auth login` goes to Sami's `theorem`
# configuration instead of overwriting the machine's `box` identity. This
# applies only when `active_config` is `box` and the caller chose no identity:
# GCLOUD_ACCOUNT and CLOUDSDK_ACTIVE_CONFIG_NAME are unset or empty, and the
# last `--configuration` and the last `--cred-file` in argv are absent or empty
# (gcloud reads an empty value as none). An otherwise-routable login with
# `--flags-file` fails loud: gcloud expands that opaque file after the shim
# checks identity flags, and a `--cred-file` inside it would come last and win.
# Routed logins drop --update-adc so the box's application default
# credentials (ADC) remain its own identity.
#
# `gcloud auth application-default login` and `revoke` are refused whenever
# the ADC in CLOUDSDK_CONFIG is an `external_account` credential. Sami signs in
# with `gcloud auth login` instead: agent-secrets borrows that login itself
# (`gcloud auth print-access-token`), and a client library reaches it through
# GOOGLE_APPLICATION_CREDENTIALS naming `legacy_credentials/<account>/adc.json`
# (plugins/sjawhar/skills/using-gcloud). This check ignores
# GOOGLE_APPLICATION_CREDENTIALS and the active configuration.
#
# Both protections classify the command the way gcloud does, so a flag cannot
# hide the command path: every global flag and its value are consumed wherever
# they appear among the command words, and one leading release track (`alpha`,
# `beta`, `preview`) is stripped for classification only. A flag missing from
# the table may take the next entry as its value in a later SDK, so the path is
# read both ways; where one reading names a protected `auth` command and
# another does not, that fails loud rather than running under the wrong
# identity. A command that no reading makes protected passes through.
#
# `gcloud auth`/`gcloud init` run through `forward` on a headless machine
# instead of the paste-a-code flow:
#   - First command word is `auth` or `init`, DISPLAY, WAYLAND_DISPLAY
#     and MIR_SOCKET are all unset, and `forward` resolves on PATH -> gcloud
#     refuses to launch ANY browser on Linux without one of those display
#     variables set (check_browser._DISPLAY_VARIABLES), even with $BROWSER
#     pointing somewhere valid, and falls into the paste-the-URL,
#     paste-back-a-code flow headless. Satisfy the check with a fake display
#     scoped to gcloud alone, and point BROWSER straight at `forward open` —
#     NOT the xdg-open shim, whose display branch would see the fake value
#     and exec the real xdg-open on a machine with no browser.
#
# All other calls retain the existing GCLOUD_ACCOUNT routing and pass-through
# behavior. Doctrine: fail LOUD where an identity is supposed to exist, never
# fall through to a different one.
set -euo pipefail

# The global flags of the installed SDK, split by how many values each takes.
# Generated from the root parser's own declarations by `scripts/gcloud-global-flags`
# against Google Cloud SDK 589.0.0: lib/googlecloudsdk/calliope/cli.py:565-670
# (__AddBuiltinGlobalFlags) and :240-246, lib/surface/__init__.py:57-186,
# lib/googlecloudsdk/calliope/base.py:361-413 and lib/googlecloudsdk/calliope/
# backend.py:338-370. The `--no-` forms are generated from the boolean flags by
# lib/googlecloudsdk/calliope/parser_arguments.py:524-600, and the SDK disables
# flag abbreviations (parser_extensions.py:1273-1287), so each name is exact.
# A subgroup inherits this table unchanged, so one table classifies every depth.
GCLOUD_GLOBAL_VALUE_FLAGS=(
    ---flag-file-line-
    --access-token-file
    --account
    --assert
    --authority-selector
    --authorization-token-file
    --billing-project
    --configuration
    --credential-file-override
    --document
    --flags-file
    --flatten
    --format
    --http-timeout
    --impersonate-service-account
    --project
    --trace-token
    --universe-domain
    --verbosity
)
GCLOUD_GLOBAL_BOOLEAN_FLAGS=(
    --help
    --log-http
    --no-log-http
    --no-user-output-enabled
    --quiet
    --user-output-enabled
    --version
    -h
    -q
    -v
)

# One leading track word selects a surface, not an identity: `alpha auth login`
# is still the login this shim protects (lib/surface/auth/__init__.py:22-24).
# The SDK accepts one track word (`alpha beta auth list` is an invalid choice),
# so the shim strips one.
GCLOUD_RELEASE_TRACKS=(alpha beta preview)

# The command path this SDK's own parser reads, and what other readings of an
# unknown flag's value could make it. GCLOUD_READING_KINDS holds one bit per kind
# of path some reading names: 1 `auth login`, 2 `auth application-default
# login|revoke`, 4 anything else. GCLOUD_PATH_KINDS_TABLE holds, at
# index*4 + state, the kinds every reading from that argv index in that state
# names. It is an indexed array, not an associative one: bash 3.2, the
# /bin/bash of macOS, has no associative arrays and would stop this shim at
# its declaration.
declare -a GCLOUD_COMMAND_WORDS=()
declare -a GCLOUD_ARGV=()
declare -a GCLOUD_PATH_KINDS_TABLE=()
GCLOUD_READING_KINDS=0
GCLOUD_COMMAND_AMBIGUOUS=0
GCLOUD_POSSIBLE_LOGIN=0
GCLOUD_POSSIBLE_ADC_OPERATION=0

contains_word() {
    local needle="$1" item
    shift
    for item in "$@"; do
        [[ "$item" == "$needle" ]] && return 0
    done
    return 1
}

is_value_flag() {
    contains_word "${1%%=*}" "${GCLOUD_GLOBAL_VALUE_FLAGS[@]}"
}

is_boolean_flag() {
    contains_word "${1%%=*}" "${GCLOUD_GLOBAL_BOOLEAN_FLAGS[@]}"
}

# True once the collected words decide whether this is a protected command:
# `auth login`, or `auth application-default login|revoke`. Anything after that
# is the command's own flags and positionals, which cannot move the path.
command_path_is_decided() {
    local count="${#GCLOUD_COMMAND_WORDS[@]}"
    ((count == 0)) && return 1
    [[ "${GCLOUD_COMMAND_WORDS[0]}" != auth ]] && return 0
    ((count == 1)) && return 1
    [[ "${GCLOUD_COMMAND_WORDS[1]}" != application-default ]] && return 0
    ((count >= 3))
}

# The words this SDK's parser takes for the command path. A global flag consumes
# its value; any other flag takes none: argparse sends an unknown option to its
# extras alone (python3.14/argparse.py:2146-2150), and calliope disables the
# prefix matching that short-option clustering rests on (parser_extensions.py:
# 1273-1287), so `-qq` is one unknown option too. A lone `-` is a positional.
read_command_words() {
    local arg track_stripped=0
    GCLOUD_COMMAND_WORDS=()
    while (($#)); do
        command_path_is_decided && break
        arg="$1"
        shift
        case "$arg" in
            -?*)
                # A separate value is one more argv entry; `--flag=value` holds its own.
                if is_value_flag "$arg" && [[ "$arg" != *=* ]] && (($#)); then
                    shift
                fi
                ;;
            *)
                if ((${#GCLOUD_COMMAND_WORDS[@]} == 0 && !track_stripped)) &&
                    contains_word "$arg" "${GCLOUD_RELEASE_TRACKS[@]}"; then
                    track_stripped=1
                    continue
                fi
                GCLOUD_COMMAND_WORDS+=("$arg")
                ;;
        esac
    done
    return 0
}

# Necessary for any reading to name a protected command: `auth`, then later
# `login`, or `application-default` and then `login` or `revoke`. Reading a flag
# as taking a value or not can only drop entries from the path, never add or
# reorder them, so without these words in this order every reading is ordinary.
protected_words_in_order() {
    local arg seen_auth=0 seen_application_default=0
    for arg in "$@"; do
        if ((seen_application_default)) && [[ "$arg" == login || "$arg" == revoke ]]; then
            return 0
        fi
        if ((seen_auth)); then
            [[ "$arg" == login ]] && return 0
            [[ "$arg" == application-default ]] && seen_application_default=1
        fi
        [[ "$arg" == auth ]] && seen_auth=1
    done
    return 1
}

# Sets GCLOUD_READING_KINDS to the kinds of path every reading of GCLOUD_ARGV
# names. States: 0 nothing read, 1 a release track read, 2 `auth`, 3 `auth
# application-default`. An unknown flag written without `=` and followed by a
# non-flag entry is a choice point, since a later SDK could make it take that
# entry as its value; both readings count. Each entry's result depends only on
# the entries after it, so one loop from the last index back to 0 fills the
# table exactly: at most four states per index, no reading limit to give up at,
# and no recursion, so no number of unknown flags can exhaust the stack.
compute_reading_kinds() {
    local count="${#GCLOUD_ARGV[@]}" index state arg next row skip_row move is_track
    GCLOUD_PATH_KINDS_TABLE=()
    # Past the last entry the path has not reached a protected command.
    for ((state = 0; state < 4; state++)); do
        GCLOUD_PATH_KINDS_TABLE[count * 4 + state]=4
    done
    for ((index = count - 1; index >= 0; index--)); do
        arg="${GCLOUD_ARGV[index]}"
        row=$(((index + 1) * 4))
        # How the entry moves the walk: "flag" to the next row in the same state,
        # "value" past the flag's separate value too, "choice" both ways, or
        # "word" through the state machine.
        move=word
        is_track=0
        case "$arg" in
            -?*)
                move=flag
                if is_value_flag "$arg"; then
                    [[ "$arg" == *=* ]] || move=value
                elif ! is_boolean_flag "$arg" && [[ "$arg" != *=* && "$arg" != -- ]] &&
                    ((index + 1 < count)) && [[ "${GCLOUD_ARGV[index + 1]}" != -* ]]; then
                    move=choice
                fi
                ;;
            *) contains_word "$arg" "${GCLOUD_RELEASE_TRACKS[@]}" && is_track=1 ;;
        esac
        skip_row=$(((index + 2 > count ? count : index + 2) * 4))
        for ((state = 0; state < 4; state++)); do
            case "$move" in
                flag) next="${GCLOUD_PATH_KINDS_TABLE[row + state]}" ;;
                value) next="${GCLOUD_PATH_KINDS_TABLE[skip_row + state]}" ;;
                choice)
                    next=$((GCLOUD_PATH_KINDS_TABLE[row + state] | GCLOUD_PATH_KINDS_TABLE[skip_row + state]))
                    ;;
                word)
                    if ((state == 0 && is_track)); then
                        next="${GCLOUD_PATH_KINDS_TABLE[row + 1]}"
                    else
                        case "$state:$arg" in
                            [01]:auth) next="${GCLOUD_PATH_KINDS_TABLE[row + 2]}" ;;
                            2:application-default) next="${GCLOUD_PATH_KINDS_TABLE[row + 3]}" ;;
                            2:login) next=1 ;;
                            3:login | 3:revoke) next=2 ;;
                            *) next=4 ;;
                        esac
                    fi
                    ;;
            esac
            GCLOUD_PATH_KINDS_TABLE[index * 4 + state]="$next"
        done
    done
    GCLOUD_READING_KINDS="${GCLOUD_PATH_KINDS_TABLE[0]}"
}

parse_gcloud_command_path() {
    read_command_words "$@"
    if protected_words_in_order "$@"; then
        GCLOUD_ARGV=("$@")
        compute_reading_kinds
    else
        GCLOUD_READING_KINDS=4
    fi
    GCLOUD_POSSIBLE_LOGIN=$((GCLOUD_READING_KINDS & 1 ? 1 : 0))
    GCLOUD_POSSIBLE_ADC_OPERATION=$((GCLOUD_READING_KINDS & 2 ? 1 : 0))
    # Ambiguous when the readings disagree: more than one kind bit is set.
    GCLOUD_COMMAND_AMBIGUOUS=$(((GCLOUD_READING_KINDS & (GCLOUD_READING_KINDS - 1)) != 0))
}

# `--name value` and `--name=value`, matching the flag exactly: the SDK accepts
# no abbreviations (parser_extensions.py:1273-1287).
has_option() {
    local name="$1" arg
    shift
    for arg in "$@"; do
        case "$arg" in
            "$name" | "$name"=*) return 0 ;;
        esac
    done
    return 1
}

# The value gcloud would act on: its argparse store action keeps the last
# occurrence, and an empty value is falsy to `auth login` (lib/surface/auth/
# login.py:263,276), so it selects no credential file.
effective_option_value() {
    local name="$1" arg value="" awaiting_value=0
    shift
    for arg in "$@"; do
        if ((awaiting_value)); then
            value="$arg"
            awaiting_value=0
            continue
        fi
        case "$arg" in
            "$name")
                value=""
                awaiting_value=1
                ;;
            "$name"=*) value="${arg#*=}" ;;
        esac
    done
    printf '%s' "$value"
}

needs_forward_browser() {
    case "${GCLOUD_COMMAND_WORDS[0]:-}" in
        auth | init) ;;
        *) return 1 ;;
    esac
    [[ -z "${DISPLAY:-}${WAYLAND_DISPLAY:-}${MIR_SOCKET:-}" ]] || return 1
    command -v forward &>/dev/null
}

is_auth_login() {
    [[ "${GCLOUD_COMMAND_WORDS[0]:-}" == auth && "${GCLOUD_COMMAND_WORDS[1]:-}" == login ]]
}

application_default_operation() {
    [[ "${GCLOUD_COMMAND_WORDS[0]:-}" == auth && "${GCLOUD_COMMAND_WORDS[1]:-}" == application-default ]] || return 1
    case "${GCLOUD_COMMAND_WORDS[2]:-}" in
        login | revoke)
            printf '%s\n' "${GCLOUD_COMMAND_WORDS[2]}"
            return 0
            ;;
    esac
    return 1
}

box_is_active() {
    local config_root active_config
    config_root="${CLOUDSDK_CONFIG:-$HOME/.config/gcloud}"
    active_config="${config_root}/active_config"
    [[ -f "$active_config" && "$(<"$active_config")" == box ]]
}

is_external_account_adc() {
    local config_root adc_file adc_json
    config_root="${CLOUDSDK_CONFIG:-$HOME/.config/gcloud}"
    adc_file="${config_root}/application_default_credentials.json"
    [[ -f "$adc_file" ]] || return 1
    # An ADC the shim cannot read cannot be shown not to be the box's identity.
    # bash 4 and later fail the read below under set -e; bash 3.2 reads an
    # unreadable file as empty with status 0, which would turn the refusal off.
    if [[ ! -r "$adc_file" ]]; then
        echo "gcloud shim: cannot read ${adc_file} to check whether it is the box's external_account credential; refusing." >&2
        exit 1
    fi
    adc_json="$(<"$adc_file")"
    [[ "$adc_json" =~ \"type\"[[:space:]]*:[[:space:]]*\"external_account\" ]]
}

# An identity the caller chose: the box route never overrides one of these.
# Each counts only with a non-empty value, the last occurrence winning, as the
# SDK reads them: _FindFlagValue takes the last --configuration, and an empty
# name falls through to the environment and then active_config (lib/
# googlecloudsdk/core/configurations/named_configs.py:119-148,494-511); auth
# login tests the --cred-file value for truth (lib/surface/auth/login.py:263,276).
identity_is_selected() {
    [[ -n "${GCLOUD_ACCOUNT:-}" || -n "${CLOUDSDK_ACTIVE_CONFIG_NAME:-}" ]] && return 0
    [[ -n "$(effective_option_value --configuration "$@")" ]] && return 0
    # A flags file expands in place after argv is read, so a --cred-file inside it
    # can come last and win (lib/googlecloudsdk/calliope/cli.py:149-188): with one
    # present, argv does not show the effective --cred-file. A --configuration
    # cannot hide there: the SDK reads it from raw argv before it expands flags
    # files (cli.py:974, before :985).
    has_option --flags-file "$@" && return 1
    [[ -n "$(effective_option_value --cred-file "$@")" ]]
}

is_box_routed_auth_login() {
    [[ "$GCLOUD_COMMAND_AMBIGUOUS" -eq 0 ]] || return 1
    is_auth_login || return 1
    identity_is_selected "$@" && return 1
    box_is_active
}

find_real_gcloud() {
    local self candidate
    self="$(readlink -f "${BASH_SOURCE[0]}")"
    while IFS= read -r candidate; do
        [[ "$(readlink -f "$candidate")" == "$self" ]] && continue
        printf '%s\n' "$candidate"
        return 0
    done < <(type -ap gcloud)
    # Minimal-PATH spawners (MCP servers, cron, etc.) carry neither the
    # dotfiles shims nor the SDK's own bin dir; fall back to the documented
    # install location before failing.
    candidate="$HOME/.gcloud/google-cloud-sdk/bin/gcloud"
    if [[ -x "$candidate" && "$(readlink -f "$candidate")" != "$self" ]]; then
        printf '%s\n' "$candidate"
        return 0
    fi
    echo "gcloud shim: real gcloud binary not found on PATH or at the default SDK install location" >&2
    return 127
}

exec_real_gcloud() {
    local real_gcloud="$1"
    shift
    if needs_forward_browser; then
        exec env DISPLAY=:0 "BROWSER=forward open %s" "$real_gcloud" "$@"
    fi
    exec "$real_gcloud" "$@"
}

main() {
    local real_gcloud
    # split is load-bearing — `local x=$(cmd)` masks the command's exit status and would defeat fail-loud.
    real_gcloud="$(find_real_gcloud)"

    parse_gcloud_command_path "$@"

    local config_dir="${CLOUDSDK_CONFIG:-$HOME/.config/gcloud}/configurations"
    # Read the ADC only for a command this block can refuse: an ambiguous path that
    # could be a protected one, or application-default login/revoke. Every other call
    # leaves the credential file unopened, so a runtime monitor that watches who opens
    # it sees gcloud, not this wrapper.
    local adc_operation=""
    if ((GCLOUD_COMMAND_AMBIGUOUS)); then
        if { ((GCLOUD_POSSIBLE_LOGIN)) && ! identity_is_selected "$@" && box_is_active; } ||
            { ((GCLOUD_POSSIBLE_ADC_OPERATION)) && is_external_account_adc; }; then
            echo "gcloud shim: refusing a command whose path an unrecognized flag makes ambiguous while it could still be a protected auth command; drop that flag, or name a configuration explicitly with --configuration theorem or GCLOUD_ACCOUNT=theorem." >&2
            exit 1
        fi
    elif adc_operation="$(application_default_operation)" && is_external_account_adc; then
        echo "gcloud shim: refusing auth application-default ${adc_operation}: this box's Application Default Credentials are its own identity and stay so; sign in as yourself with gcloud auth login, which agent-secrets and gcloud use." >&2
        exit 1
    fi

    if is_box_routed_auth_login "$@"; then
        if has_option --flags-file "$@"; then
            echo "gcloud shim: refusing implicit box auth login with --flags-file; name a configuration explicitly with --configuration theorem or GCLOUD_ACCOUNT=theorem." >&2
            exit 1
        fi
        if [[ ! -f "${config_dir}/config_theorem" ]]; then
            echo "gcloud shim: configuration theorem is missing at ${config_dir}/config_theorem; create it with gcloud config configurations create theorem --no-activate." >&2
            exit 1
        fi

        local -a routed_args=()
        local arg update_adc=no
        for arg in "$@"; do
            if [[ "$arg" == --update-adc ]]; then
                update_adc=yes
                continue
            fi
            routed_args+=("$arg")
        done

        echo "gcloud shim: routing auth login to configuration theorem because box is this machine's own identity." >&2
        if [[ "$update_adc" == yes ]]; then
            echo "gcloud shim: dropping --update-adc: the box's ADC stays its own identity." >&2
        fi
        export CLOUDSDK_ACTIVE_CONFIG_NAME=theorem
        exec_real_gcloud "$real_gcloud" "${routed_args[@]}"
    fi

    local account="${GCLOUD_ACCOUNT:-}"
    if [[ -z "$account" ]]; then
        exec_real_gcloud "$real_gcloud" "$@"
    fi

    # Reject path separators and dot-segments before they ever touch a
    # filesystem path: an account name is a bare configuration name, never a
    # traversal into an arbitrary file.
    case "$account" in
        */* | . | ..)
            echo "gcloud shim: GCLOUD_ACCOUNT '${account}' is not a valid gcloud configuration name" >&2
            exit 1
            ;;
    esac

    local config_file="${config_dir}/config_${account}"

    if [[ ! -f "$config_file" ]]; then
        local candidate available
        local -a names=()
        if [[ -d "$config_dir" ]]; then
            for candidate in "$config_dir"/config_*; do
                [[ -f "$candidate" ]] || continue
                names+=("${candidate##*/config_}")
            done
        fi
        if [[ "${#names[@]}" -gt 0 ]]; then
            available="$(IFS=', '; echo "${names[*]}")"
        else
            available="(none found in ${config_dir})"
        fi
        echo "gcloud shim: GCLOUD_ACCOUNT '${account}' has no gcloud configuration at ${config_file}; available configurations: ${available}" >&2
        exit 1
    fi

    export CLOUDSDK_ACTIVE_CONFIG_NAME="$account"
    exec_real_gcloud "$real_gcloud" "$@"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
