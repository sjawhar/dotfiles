#!/bin/bash
# jj-lock-shim: every workspace `jj workspace add` creates in a colocated repo gets
# its git worktree locked. From inside an agent box every other box's workspace
# path looks missing, and an unlocked registration under <store>/.git/worktrees/
# can disappear (AGENTC-431); a locked one survives, and `jj workspace forget`
# still removes it. In an agent session `jj git push --deleted` is refused, so is
# `jj git push` to a public theorem-labs repository unless the backing git
# repository sets omp.publicPush, and in a public theorem-labs repository the
# session's Omp-Session trailer is dropped (all below). Everything else goes
# straight to the real jj.
set -euo pipefail

# A jj that hands the call to the first jj on PATH re-enters this shim in the same
# pid: mise's shim does, when mise has no jj version for the directory (under a
# relocated XDG_CONFIG_HOME, mise reads no global config), and this shim is that
# first jj. DOTFILES_JJ_SHIM ("<pid> <jj>:<jj>…") names every jj this shim has
# handed the call to in that pid; the lookup skips each one, and any path to the
# same file (every shim of one mise), so the call reaches the jj past them or
# fails, instead of the two exec'ing each other forever.
_handed=""
read -r _marker_pid _marker_handed <<< "${DOTFILES_JJ_SHIM:-}"
[[ "$_marker_pid" == "$$" ]] && _handed="$_marker_handed"
handed_back() {
    local IFS=':'
    local jj
    for jj in $_handed; do
        [[ -n "$jj" && "$1" -ef "$jj" ]] && return 0
    done
    return 1
}

# The first jj on PATH that is not this shim, judged by content like shims/gh,
# and not one that handed the call back.
real_jj() {
    local IFS=':'
    local dir candidate header
    for dir in $PATH; do
        candidate="$dir/jj"
        [[ -f "$candidate" && -x "$candidate" ]] || continue
        header=""
        IFS= read -r -n 512 -d '' header < "$candidate" || true
        [[ "$header" == *jj-lock-shim* ]] && continue
        handed_back "$candidate" && continue
        echo "$candidate"
        return
    done
    # A caller that builds its own PATH may leave the real binary off it.
    for candidate in "${DOTFILES_DIR:-$HOME/.dotfiles}/bin/jj" "$HOME/.mise/shims/jj"; do
        [[ -f "$candidate" && -x "$candidate" ]] || continue
        header=""
        IFS= read -r -n 512 -d '' header < "$candidate" || true
        [[ "$header" == *jj-lock-shim* ]] && continue
        handed_back "$candidate" && continue
        echo "$candidate"
        return
    done
    return 1
}
if ! _real="$(real_jj)"; then
    echo "jj shim: no real jj found on PATH${_handed:+; ${_handed//:/, } handed the call back to this shim, as a mise shim does when mise has no jj version for the directory}" >&2
    exit 127
fi
_handed="${_handed:+$_handed:}$_real"
export DOTFILES_JJ_SHIM="$$ $_handed"
# The shim's own tools (cat, awk, realpath, mktemp) must exist even when the
# caller's PATH omits the system dirs; appending keeps the caller's dirs first.
PATH="$PATH:/usr/bin:/bin"

# Refuse `jj git push --deleted` in an agent session. `--deleted` pushes every
# deleted bookmark and tag in the repo, not just the caller's — in a checkout
# shared by many sessions every bookmark whose local copy is absent belongs to
# someone else, and a deleted branch auto-closes its pull request. It is a
# plain clap flag with no attached-value or bundled form (`--deleted=…` is a
# parse error) and is already mutually exclusive with `--bookmark`/`--tag`/
# `--revision`/`--change` (`jj git push --help`), so only the bare literal
# token is the real flag; `jj git push` takes no positional arguments, so a
# token after `--` is never it either. This is a second, independent gate: it
# runs before the workspace-add lock logic below and does not alter it.
agent_context() {
    [[ -n "${OMP_SESSION_ID:-}${PI_SESSION_FILE:-}${PI_TOOL_BRIDGE_URL:-}${AGENTBOX_SESSION:-}" ]] && return 0
    local i v
    for ((i = 0; i < ${GIT_CONFIG_COUNT:-0}; i++)); do
        v="GIT_CONFIG_VALUE_$i"
        [[ "${!v:-}" == *gh-app-routes.gitconfig ]] && return 0
    done
    return 1
}
# Locate the subcommand past jj's global options, same approach as shims/git's
# search for `worktree`.
_pargs=("$@")
_pi=0
while ((_pi < ${#_pargs[@]})); do
    case "${_pargs[_pi]}" in
        -R | --repository | --at-operation | --at-op | --color | --config | --config-file) _pi=$((_pi + 2)) ;;
        -*) _pi=$((_pi + 1)) ;;
        *) break ;;
    esac
done
# The git repository backing the jj repository a command runs in (`-R`, else the
# current directory): prints its path and returns 0; returns 2 when there is none
# (no jj repository, which jj reports itself, or one not backed by git) and 1 when
# a secondary workspace's pointer to its repository is unreadable.
backing_git_dir() {
    local d="" repo target="" a prev=""
    for a in "$@"; do
        [[ "$a" == -- ]] && break
        case "$prev" in -R | --repository) d="$a" ;; esac
        case "$a" in --repository=*) d="${a#*=}" ;; -R?*) d="${a#-R}" ;; esac
        prev="$a"
    done
    d="${d:-$PWD}"
    [[ "$d" == /* ]] || d="$PWD/$d"
    d="${d%/}"
    while [[ ! -d "$d/.jj" ]]; do
        [[ -n "$d" ]] || return 2
        d="${d%/*}"
    done
    repo="$d/.jj/repo"
    if [[ -f "$repo" ]]; then # a secondary workspace names its repository
        IFS= read -r target < "$repo" || true
        [[ -n "$target" ]] || return 1
        [[ "$target" == /* ]] || target="$d/.jj/$target"
        repo="$target"
        target=""
    fi
    IFS= read -r target < "$repo/store/git_target" 2> /dev/null || true
    [[ -n "$target" ]] || return 2
    [[ "$target" == /* ]] || target="$repo/store/$target"
    echo "$target"
}

if agent_context; then
    if [[ "${_pargs[_pi]:-}" == git && "${_pargs[_pi + 1]:-}" == push ]]; then
        _remote="" _dry=0 _next=0
        for _parg in "${_pargs[@]:_pi+2}"; do
            [[ "$_parg" == -- ]] && break
            if ((_next)); then
                _remote="$_parg" _next=0
                continue
            fi
            case "$_parg" in
                --remote) _next=1 ;;
                --remote=*) _remote="${_parg#--remote=}" ;;
                --dry-run) _dry=1 ;;
            esac
            if [[ "$_parg" == --deleted ]]; then
                cat >&2 << 'EOF'
jj shim: `jj git push --deleted` is refused in an agent session.
--deleted pushes every deleted bookmark and tag in the repo, not just yours —
there is no per-name form (`jj git push --help`) — so in a checkout shared by
many sessions it also takes every other session's pending deletion, and a
deleted branch auto-closes its pull request. It cost a human's PR branch on
2026-09-15, and three other sessions' bookmarks plus PR #20325 on 2026-09-28.
Delete and push only your own bookmark:
  jj bookmark delete <name>
  jj git push --bookmark <name>
EOF
                exit 1
            fi
        done
        # A push to a public repository of a PUBLISHING_OWNERS owner (theorem-labs)
        # is refused unless the backing git repository sets omp.publicPush, as for
        # `git push` (scripts/omp-public-push). The remote is `--remote`, else jj's
        # `git.push` setting, else origin. A dry run passes.
        if ((!_dry)) && _gitdir="$(backing_git_dir "$@")"; then
            if [[ -z "$_remote" ]]; then
                # In a subshell that names its own pid in the marker, as below.
                _remote="$(DOTFILES_JJ_SHIM="$BASHPID $_handed"; exec "$_real" "${_pargs[@]:0:_pi}" config get git.push 2> /dev/null)" || _remote=""
                _remote="${_remote:-origin}"
            fi
            "${BASH_SOURCE[0]%/*}/../scripts/omp-public-push" git --git-dir="$_gitdir" -- "$_remote" > /dev/null || exit 1
        fi
    fi
fi

# The Omp-Session trailer comes from an `omp-attribution-*.toml` overlay in
# JJ_CONFIG (omp/extensions/session-env.ts, or the Legion extension), which jj
# cannot make conditional on a remote. So the shim asks
# scripts/omp-session-trailer, as shims/git does, about the repository's backing
# git repository, and where it says no (a public repository of one of its
# PUBLISHING_OWNERS, theorem-labs) runs jj with `templates.commit_trailers` empty.
# That call also takes `immutable_heads()` back to `builtin_immutable_heads()`:
# session-env.ts's cross-session guard (AGENTC-318) tells a session's own commits
# by their trailer, so without one every commit the session describes would be
# immutable to it. The guard is therefore off in those repositories: another
# session's unpushed commits there can be rewritten without --ignore-immutable.
# Commands that never write a description skip the check, which costs a few
# milliseconds with the answer cached; any other command, an alias included,
# pays it. `git config omp.sessionTrailer true|false` in the backing repository
# overrides it either way.
_pre=()
trailer_on() {
    local target rc=0
    target="$(backing_git_dir "$@")" || rc=$?
    ((rc != 2)) || return 0 # no git remote to ask about
    ((rc == 0)) || return 1
    "${BASH_SOURCE[0]%/*}/../scripts/omp-session-trailer" git --git-dir="$target" > /dev/null 2>&1
}
if [[ ":${JJ_CONFIG:-}:" == *"/omp-attribution-"* ]]; then
    case "${_pargs[_pi]:-}" in
        "" | log | st | status | show | diff | evolog | interdiff | op | help | config | version | root | file | bookmark | b | tag | workspace | sparse | util | git) ;;
        *)
            trailer_on "$@" || _pre=(--config 'templates.commit_trailers=""' --config 'revset-aliases."immutable_heads()"="builtin_immutable_heads()"')
            ;;
    esac
fi
unset _pargs _pi _parg _remote _dry _next _gitdir

_add=0 _prev=""
for _a in "$@"; do
    if [[ "$_prev" == workspace && "$_a" == add ]]; then _add=1; break; fi
    _prev="$_a"
done
((_add)) || exec "$_real" "${_pre[@]}" "$@"

_err="$(mktemp)"
trap 'rm -f "$_err"' EXIT
_rc=0
# In a subshell that names its own pid in the marker, since a hand-back re-enters
# this shim in that pid.
(DOTFILES_JJ_SHIM="$BASHPID $_handed"; exec "$_real" "$@") 2> "$_err" || _rc=$?
cat "$_err" >&2
((_rc == 0)) || exit "$_rc"

# jj names the new workspace relative to the current directory.
_rel="$(sed -n 's/^Created workspace in "\(.*\)"$/\1/p' "$_err" | tail -1)"
[[ -n "$_rel" ]] || exit 0
_dest="$(realpath -m -- "$_rel")"
[[ -f "$_dest/.git" ]] || exit 0
if ! _out="$(git -C "$_dest" worktree lock --reason "jj shim: locked on add (AGENTC-431)" "$_dest" 2>&1)"; then
    # In an agent session shims/git already locked it on jj's `git worktree add`.
    [[ "$_out" == *"is already locked"* ]] && exit 0
    echo "jj shim: the workspace was created but its git worktree could NOT be locked: $_out" >&2
    echo "jj shim: lock it by hand: git -C '$_dest' worktree lock '$_dest'" >&2
fi
exit 0
