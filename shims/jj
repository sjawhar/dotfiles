#!/bin/bash
# jj-lock-shim: every workspace `jj workspace add` creates in a colocated repo gets
# its git worktree locked. From inside an agent box every other box's workspace
# path looks missing, and an unlocked registration under <store>/.git/worktrees/
# can disappear (AGENTC-431); a locked one survives, and `jj workspace forget`
# still removes it. In an agent session it refuses `jj git push --deleted` and
# checks outgoing GitHub pushes with the shared public leak check. Outside one it
# runs the same check on `jj git push` wherever this machine has the check
# installed (dispatch://BET-706), unless DOTFILES_JJ_NO_LEAK_CHECK=1. Where
# scripts/omp-session-trailer says no, it drops the session's Omp-Session trailer.
# Everything else goes straight to the real jj.
set -euo pipefail

# A jj that hands the call to the first jj on PATH re-enters this shim in the same
# pid: mise's shim does, when mise has no jj version for the directory (under a
# relocated XDG_CONFIG_HOME, mise reads no global config), and this shim is that
# first jj. DOTFILES_JJ_SHIM ("<pid> <jj>:<jj>…") names every jj this shim has
# handed the call to in that pid; the lookup skips each one, and any path to the
# same file (every shim of one mise), so the call reaches the jj past them or
# fails, instead of the two exec'ing each other forever.
_handed=""
read -r _marker_pid _marker_handed <<< "${DOTFILES_JJ_SHIM:-}"
[[ "$_marker_pid" == "$$" ]] && _handed="$_marker_handed"
handed_back() {
    local IFS=':'
    local jj
    for jj in $_handed; do
        [[ -n "$jj" && "$1" -ef "$jj" ]] && return 0
    done
    return 1
}

# The first jj on PATH that is not this shim, judged by content like shims/gh,
# and not one that handed the call back.
real_jj() {
    local IFS=':'
    local dir candidate header
    for dir in $PATH; do
        candidate="$dir/jj"
        [[ -f "$candidate" && -x "$candidate" ]] || continue
        header=""
        IFS= read -r -n 512 -d '' header < "$candidate" || true
        [[ "$header" == *jj-lock-shim* ]] && continue
        handed_back "$candidate" && continue
        echo "$candidate"
        return
    done
    # A caller that builds its own PATH may leave the real binary off it.
    for candidate in "${DOTFILES_DIR:-$HOME/.dotfiles}/bin/jj" "$HOME/.mise/shims/jj"; do
        [[ -f "$candidate" && -x "$candidate" ]] || continue
        header=""
        IFS= read -r -n 512 -d '' header < "$candidate" || true
        [[ "$header" == *jj-lock-shim* ]] && continue
        handed_back "$candidate" && continue
        echo "$candidate"
        return
    done
    return 1
}
if ! _real="$(real_jj)"; then
    echo "jj shim: no real jj found on PATH${_handed:+; ${_handed//:/, } handed the call back to this shim, as a mise shim does when mise has no jj version for the directory}" >&2
    exit 127
fi
_handed="${_handed:+$_handed:}$_real"
export DOTFILES_JJ_SHIM="$$ $_handed"
# The shim's own tools (cat, awk, realpath, mktemp) must exist even when the
# caller's PATH omits the system dirs; appending keeps the caller's dirs first.
PATH="$PATH:/usr/bin:/bin"

# Refuse `jj git push --deleted` in an agent session. `--deleted` pushes every
# deleted bookmark and tag in the repo, not just the caller's — in a checkout
# shared by many sessions every bookmark whose local copy is absent belongs to
# someone else, and a deleted branch auto-closes its pull request. It is a
# plain clap flag with no attached-value or bundled form (`--deleted=…` is a
# parse error) and is already mutually exclusive with `--bookmark`/`--tag`/
# `--revision`/`--change` (`jj git push --help`), so only the bare literal
# token is the real flag; `jj git push` takes no positional arguments, so a
# token after `--` is never it either. This is a second, independent gate: it
# runs before the workspace-add lock logic below and does not alter it.
agent_context() {
    [[ -n "${OMP_SESSION_ID:-}${PI_SESSION_FILE:-}${PI_TOOL_BRIDGE_URL:-}${AGENTBOX_SESSION:-}${CLAUDECODE:-}${ENVOY_SESSION_ID:-}${AGENT_SHIM_AGENT:-}${LEGION_ROLE:-}${LEGION_TREE:-}${LEGION_CONTROLLER:-}${LEGION_DAEMON_URL:-}" ]] && return 0
    local i v
    for ((i = 0; i < ${GIT_CONFIG_COUNT:-0}; i++)); do
        v="GIT_CONFIG_VALUE_$i"
        [[ "${!v:-}" == *gh-app-routes.gitconfig ]] && return 0
    done
    # There is no exception for tmux. A pane takes the SERVER's environment, not the environment
    # of whoever asked for the pane, so "inside tmux means the person" let an agent's own
    # `tmux new-window` under the person's server produce a pane with no marker that then ran as
    # the person (round 3 of INFRA-1538). The fix is the other way round: shims/tmux and
    # scripts/agentbox-tmux-guard pass the caller's markers to the new pane with tmux's -e, so an
    # agent's pane carries them and is caught above.
    # A command that arrives over SSH in a session with no terminal (`ssh host az account show`)
    # is an agent's, not a person's: sshd gives a person's own session a terminal and names it in
    # SSH_TTY for the whole session, so a pipe into one command of it (`echo x | az …`, git
    # handing its credential helper the request) is still the person's, where testing this
    # command's own stdin made it an agent's. AGENT_SHIM_PERSON=1 is the person's escape for a
    # deliberate non-interactive SSH command of their own (INFRA-1538).
    if [[ -n "${SSH_CONNECTION:-}" && -z "${SSH_TTY:-}" && "${AGENT_SHIM_PERSON:-}" != 1 ]]; then
        AGENT_CONTEXT_VIA_SSH=1
        return 0
    fi
    return 1
}
# Say so when the SSH rule, and not a session marker, made this an agent's call: the push gate
# below then runs as `agent`, and a person whose own non-interactive ssh command this is needs
# the escape named.
if agent_context && [[ -n "${AGENT_CONTEXT_VIA_SSH:-}" ]]; then
    echo "jj shim: non-interactive SSH, so an agent's call, under the agent-session rules (set AGENT_SHIM_PERSON=1 for your own)" >&2
fi
# The shared public leak check, found as the gate and every hook find it: $PUBLIC_LEAK_CHECK, then
# public-leak-check.sh on PATH, then the machine pointer. Sets _check and _pointer; _check may be empty or
# name a file that is not executable.
find_leak_check() {
    _check="${PUBLIC_LEAK_CHECK:-}"
    [[ -n "$_check" ]] || _check="$(command -v public-leak-check.sh 2> /dev/null || true)"
    _pointer="${XDG_CONFIG_HOME:-$HOME/.config}/public-leak-check/path"
    if [[ -z "$_check" && -s "$_pointer" ]]; then IFS= read -r _check < "$_pointer" || true; fi
}
# Who the push gate runs for: `agent` in an agent session; `person` outside one, on a machine with the check
# installed and DOTFILES_JJ_NO_LEAK_CHECK not 1; empty otherwise. A person's own `jj git push` from a terminal
# reaches no git hook (jj runs git with --no-verify) and no other gate (shims/git checks only agent sessions),
# so where the check is installed this shim checks it (Sami, dispatch://BET-64/ask/0b96691d-1104-4a08-bda7-e544a32215b5:
# "Add a hook somehow to my devbox for these leaks"). A machine without the check (a laptop) is unchanged, and
# DOTFILES_JJ_NO_LEAK_CHECK=1 skips it for one command, as `git push --no-verify` does for git. In an agent
# session that variable is ignored and the rule is as before: without a check only a confirmed-private
# destination passes.
_gate=""
if agent_context; then
    _gate=agent
elif [[ "${DOTFILES_JJ_NO_LEAK_CHECK:-}" != 1 ]]; then
    find_leak_check
    if [[ -n "$_check" && -x "$_check" ]]; then _gate=person; fi
fi
push_refuse() {
    printf 'error: jj shim: %s\n' "$@" >&2
    [[ "$_gate" != person ]] ||
        printf 'error: jj shim: to push this one command without the public leak check, run it with DOTFILES_JJ_NO_LEAK_CHECK=1.\n' >&2
    exit 1
}
# Locate the subcommand past jj's global options, same approach as shims/git's
# search for `worktree`.
_pargs=("$@")
command_index() {
    _pi=0
    while ((_pi < ${#_pargs[@]})); do
        case "${_pargs[_pi]}" in
            -R | --repository | --at-operation | --at-op | --color | --config | --config-file) _pi=$((_pi + 2)) ;;
            -*) _pi=$((_pi + 1)) ;;
            *) break ;;
        esac
    done
}
command_index
# Expands the command's aliases as jj will, so the push gate sees the push. A builtin as the first word (any but `git`
# is no push) needs no alias work: the loop returns before reading the aliases. An agent session keeps its cap of 8
# levels. A person's command is followed up to 64 levels (round 8b: deeper aliases are legitimate) and, since the shim
# cannot prove an alias it could not resolve is not a push (round 8c), it refuses past that, or when the aliases cannot
# be read or decoded, as the agent path does; the refusal names DOTFILES_JJ_NO_LEAK_CHECK=1 (push_refuse). One case is
# left to jj: a cycle (an alias name seen twice in one expansion), which jj refuses itself ("Recursive alias
# definition"), running nothing; the gate is dropped so jj gives its own error.
resolve_aliases() {
    local name config="" loaded=0 depth cap=8
    local -a alias=()
    local -A seen=()
    [[ "$_gate" != person ]] || cap=64
    for ((depth = 0; depth <= cap; depth++)); do
        name="${_pargs[_pi]:-}"
        case "$name" in
            "" | abandon | absorb | backout | bisect | bookmark | b | commit | ci | config | describe | desc | diff | diffedit | duplicate | edit | evolog | file | fix | gerrit | git | help | interdiff | log | metaedit | new | next | op | operation | parallelize | prev | rebase | redo | resolve | restore | revert | root | show | sign | simplify-parents | sparse | split | squash | status | st | tag | undo | unsign | util | version | workspace) return 0 ;;
        esac
        ((depth < cap)) || push_refuse "alias expansion exceeds $cap levels. Nothing was pushed."
        if [[ "$_gate" == person && -n "${seen[$name]:-}" ]]; then
            _gate=""
            return 0
        fi
        seen[$name]=1
        if ((loaded == 0)); then
            # jj expands aliases in its invocation context BEFORE applying -R
            # or --config/--config-file. Including those here could read a
            # different alias from the one jj will execute and miss a push.
            config="$(DOTFILES_JJ_SHIM="$BASHPID $_handed" "$_real" --no-pager --color=never config list aliases --include-defaults --template 'name ++ " = " ++ value ++ "\n"' 2>/dev/null)" ||
                push_refuse "cannot read alias configuration for $name. Nothing was pushed."
            loaded=1
        fi
        # Decode TOML without shell evaluation; NUL delimiters preserve every
        # alias argument, including whitespace and newlines. Empty/error output
        # from the decoder is a refusal, never an unguarded fallback.
        mapfile -d '' -t alias < <(python3 -c '
import sys, tomllib
try:
    value = tomllib.loads(sys.stdin.read()).get("aliases", {}).get(sys.argv[1])
    if value is None:
        result = ["missing"]
    elif isinstance(value, list) and value and all(isinstance(v, str) and "\0" not in v for v in value):
        result = ["found", *value]
    else:
        result = ["error"]
except Exception:
    result = ["error"]
for value in result:
    sys.stdout.buffer.write(value.encode() + b"\0")
' "$name" <<< "$config")
        case "${alias[0]:-}" in
            missing) return 0 ;;
            found) _pargs=("${_pargs[@]:0:_pi}" "${alias[@]:1}" "${_pargs[@]:_pi+1}") ;;
            *) push_refuse "cannot resolve alias $name. Nothing was pushed." ;;
        esac
        command_index
    done
}
if [[ "$_gate" == agent ]]; then
    resolve_aliases
    if [[ "${_pargs[_pi]:-}" == git && "${_pargs[_pi + 1]:-}" == push ]]; then
        for _parg in "${_pargs[@]:_pi+2}"; do
            [[ "$_parg" == -- ]] && break
            if [[ "$_parg" == --deleted ]]; then
                cat >&2 << 'EOF'
jj shim: `jj git push --deleted` is refused in an agent session.
--deleted pushes every deleted bookmark and tag in the repo, not just yours —
there is no per-name form (`jj git push --help`) — so in a checkout shared by
many sessions it also takes every other session's pending deletion, and a
deleted branch auto-closes its pull request. It cost a human's PR branch on
2026-09-15, and three other sessions' bookmarks plus PR #20325 on 2026-09-28.
Delete and push only your own bookmark:
  jj bookmark delete <name>
  jj git push --bookmark <name>
EOF
                exit 1
            fi
        done
    fi
fi

# The Omp-Session trailer comes from an `omp-attribution-*.toml` overlay in
# JJ_CONFIG (omp/extensions/session-env.ts, or the Legion extension), which jj
# cannot make conditional on a repository. So the shim asks
# scripts/omp-session-trailer, as shims/git does, about the repository's backing
# git repository, and where it says no (`git config omp.sessionTrailer false`
# there, or a throwaway repository: no remote, and under a temporary root) runs
# jj with `templates.commit_trailers` empty.
# That call also takes `immutable_heads()` back to `builtin_immutable_heads()`:
# session-env.ts's cross-session guard (AGENTC-318) tells a session's own commits
# by their trailer, so without one every commit the session describes would be
# immutable to it. The guard is therefore off in those repositories: another
# session's unpushed commits there can be rewritten without --ignore-immutable.
# Commands that never write a description skip the check, which costs a
# `git config` read and, where that sets nothing, a `git remote` and a
# `git rev-parse`; any other command, an alias included, pays it.
_pre=()
trailer_on() {
    local d="" repo target="" a prev=""
    for a in "$@"; do
        [[ "$a" == -- ]] && break
        case "$prev" in -R | --repository) d="$a" ;; esac
        case "$a" in --repository=*) d="${a#*=}" ;; -R?*) d="${a#-R}" ;; esac
        prev="$a"
    done
    d="${d:-$PWD}"
    [[ "$d" == /* ]] || d="$PWD/$d"
    d="${d%/}"
    while [[ ! -d "$d/.jj" ]]; do
        [[ -n "$d" ]] || return 0 # no jj repository: jj says so itself
        d="${d%/*}"
    done
    repo="$d/.jj/repo"
    if [[ -f "$repo" ]]; then # a secondary workspace names its repository
        IFS= read -r target < "$repo" || true
        [[ -n "$target" ]] || return 1
        [[ "$target" == /* ]] || target="$d/.jj/$target"
        repo="$target"
        target=""
    fi
    IFS= read -r target < "$repo/store/git_target" 2> /dev/null || true
    [[ -n "$target" ]] || return 0 # not git-backed, so no remote
    [[ "$target" == /* ]] || target="$repo/store/$target"
    "${BASH_SOURCE[0]%/*}/../scripts/omp-session-trailer" git --git-dir="$target" > /dev/null 2>&1
}
git_target() {
    local d="" repo target="" a prev=""
    for a in "$@"; do
        [[ "$a" == -- ]] && break
        case "$prev" in -R | --repository) d="$a" ;; esac
        case "$a" in --repository=* | -R=*) d="${a#*=}" ;; -R?*) d="${a#-R}" ;; esac
        prev="$a"
    done
    d="${d:-$PWD}"
    [[ "$d" == /* ]] || d="$PWD/$d"
    d="${d%/}"
    while [[ ! -d "$d/.jj" ]]; do
        [[ -n "$d" ]] || return 0 # no jj repository: jj says so itself
        d="${d%/*}"
    done
    repo="$d/.jj/repo"
    if [[ -f "$repo" ]]; then # a secondary workspace names its repository
        IFS= read -r target < "$repo" || true
        [[ -n "$target" ]] || return 1
        [[ "$target" == /* ]] || target="$d/.jj/$target"
        repo="$target"
        target=""
    fi
    IFS= read -r target < "$repo/store/git_target" 2> /dev/null || true
    [[ -n "$target" ]] || return 0 # not git-backed, so no remote
    [[ "$target" == /* ]] || target="$repo/store/$target"
    printf '%s\n' "$target"
}

push_gate() {
    local target out rc=0 a remote="" kind ref action old new url slug check pointer visibility line
    local zero=0000000000000000000000000000000000000000
    local scripts="${BASH_SOURCE[0]%/*}/../scripts"
    local header='^Changes to push to (.+):$'
    local update='^  (bookmark|tag): (.+) \[(.*)\]$'
    local add='^add to ([0-9a-f]+)$' delete='^delete from ([0-9a-f]+)$'
    local move='^move (forward|backward|sideways) from ([0-9a-f]+) to ([0-9a-f]+)$'
    local -a display=() remotes=()
    local -A updates=()
    for a in "${_pargs[@]:_pi+2}"; do
        [[ "$a" == -- ]] && break
        case "$a" in --help | -h) return 0 ;; esac
    done
    target="$(git_target "$@")" || push_refuse "cannot find the backing git repository. Nothing was pushed."
    [[ -n "$target" ]] || push_refuse "cannot find the backing git repository. Nothing was pushed."

    # jj resolves the caller's selectors and remote patterns itself. Never run
    # the real push until every destination's dry-run updates pass the check.
    out="$(DOTFILES_JJ_SHIM="$BASHPID $_handed" "$_real" "$@" --dry-run --color=never 2>&1)" || rc=$?
    if ((rc)); then printf '%s\n' "$out" >&2; exit "$rc"; fi
    if [[ -z "$out" ]]; then
        # --quiet hides the plan. First run above retains every argument; a
        # second dry-run changes only that rendering flag, never push selection.
        for a in "$@"; do [[ "$a" == --quiet ]] || display+=("$a"); done
        out="$(DOTFILES_JJ_SHIM="$BASHPID $_handed" "$_real" "${display[@]}" --dry-run --color=never 2>&1)" || rc=$?
        if ((rc)); then printf '%s\n' "$out" >&2; exit "$rc"; fi
    fi
    while IFS= read -r line; do
        if [[ "$line" =~ $header ]]; then
            remote="${BASH_REMATCH[1]}"
            remotes+=("$remote")
            updates["$remote"]=""
        elif [[ "$line" =~ $update ]]; then
            [[ -n "$remote" ]] || push_refuse "cannot parse jj's dry-run destination. Nothing was pushed."
            kind="${BASH_REMATCH[1]}" ref="${BASH_REMATCH[2]}" action="${BASH_REMATCH[3]}"
            old="$zero" new="$zero"
            if [[ "$action" =~ $add ]]; then new="${BASH_REMATCH[1]}"
            elif [[ "$action" =~ $delete ]]; then old="${BASH_REMATCH[1]}"
            elif [[ "$action" =~ $move ]]; then old="${BASH_REMATCH[2]}" new="${BASH_REMATCH[3]}"
            else push_refuse "cannot parse jj's dry-run update: $line" "Nothing was pushed."
            fi
            if [[ "$new" != "$zero" ]]; then
                new="$(git --git-dir="$target" rev-parse --verify "$new^{commit}" 2>/dev/null)" ||
                    push_refuse "cannot resolve jj's outgoing commit. Nothing was pushed."
            fi
            if [[ "$old" != "$zero" ]]; then
                old="$(git --git-dir="$target" rev-parse --verify "$old^{commit}" 2>/dev/null)" ||
                    push_refuse "cannot resolve jj's remote commit. Nothing was pushed."
            fi
            if [[ "$kind" == bookmark ]]; then ref="refs/heads/$ref"; else ref="refs/tags/$ref"; fi
            updates["$remote"]+="$ref $new $ref $old"$'\n'
        elif [[ -n "$remote" && "$line" == '  '* ]]; then
            push_refuse "cannot parse jj's dry-run update: $line" "Nothing was pushed."
        fi
    done <<< "$out"
    if ((${#remotes[@]} == 0)); then
        [[ "$out" == *'Nothing changed.'* ]] || push_refuse "jj's dry-run gave no readable push plan. Nothing was pushed."
        return 0
    fi
    find_leak_check
    check="$_check" pointer="$_pointer"
    for remote in "${remotes[@]}"; do
        local urls
        urls="$(git --git-dir="$target" remote get-url --push --all "$remote" 2>/dev/null)" ||
            push_refuse "cannot read push remote $remote. Nothing was pushed."
        [[ -n "$urls" ]] || push_refuse "push remote $remote has no URL. Nothing was pushed."
        while IFS= read -r url; do
            slug="$("$scripts/github-repo-visibility" --slug "$url")" ||
                push_refuse "cannot identify push remote $remote. Nothing was pushed."
            [[ "$slug" != not-github ]] || continue
            [[ -n "${updates[$remote]}" ]] || push_refuse "jj's dry-run gave no updates for $remote. Nothing was pushed."
            if [[ ! -x "$check" ]]; then
                visibility="$("$scripts/github-repo-visibility" "$url")" || visibility=""
                [[ "$visibility" != private ]] || continue
                push_refuse "this machine has no public leak check, and $remote is not confirmed private. Nothing was pushed." \
                    "Point PUBLIC_LEAK_CHECK at the check, put public-leak-check.sh on PATH, or write its path in $pointer."
            fi
            rc=0
            out="$(GIT_DIR="$target" bash "$check" "$remote" "$url" 2>&1 <<< "${updates[$remote]}")" || rc=$?
            if ((rc)); then
                while IFS= read -r line; do printf 'error: %s\n' "$line"; done <<< "$out" >&2
                push_refuse "the public leak check did not pass (exit $rc). Nothing was pushed."
            fi
            [[ -z "$out" ]] || printf '%s\n' "$out" >&2
        done <<< "$urls"
    done
}
# The agent case resolved aliases above, before its --deleted refusal.
if [[ "$_gate" == person ]]; then resolve_aliases; fi
if [[ -n "$_gate" && "${_pargs[_pi]:-}" == git && "${_pargs[_pi + 1]:-}" == push ]]; then
    # Execute the same expanded argv that is checked, not a second alias lookup.
    set -- "${_pargs[@]}"
    push_gate "$@"
fi
# Alias expansion is for the push guards; keep the existing trailer dispatch.
_pargs=("$@")
command_index
if [[ ":${JJ_CONFIG:-}:" == *"/omp-attribution-"* ]]; then
    case "${_pargs[_pi]:-}" in
        "" | log | st | status | show | diff | evolog | interdiff | op | help | config | version | root | file | bookmark | b | tag | workspace | sparse | util | git) ;;
        *)
            trailer_on "$@" || _pre=(--config 'templates.commit_trailers=""' --config 'revset-aliases."immutable_heads()"="builtin_immutable_heads()"')
            ;;
    esac
fi
unset _pargs _pi _parg

_add=0 _prev=""
for _a in "$@"; do
    if [[ "$_prev" == workspace && "$_a" == add ]]; then _add=1; break; fi
    _prev="$_a"
done
((_add)) || exec "$_real" "${_pre[@]}" "$@"

_err="$(mktemp)"
trap 'rm -f "$_err"' EXIT
_rc=0
# In a subshell that names its own pid in the marker, since a hand-back re-enters
# this shim in that pid.
(DOTFILES_JJ_SHIM="$BASHPID $_handed"; exec "$_real" "$@") 2> "$_err" || _rc=$?
cat "$_err" >&2
((_rc == 0)) || exit "$_rc"

# jj names the new workspace relative to the current directory.
_rel="$(sed -n 's/^Created workspace in "\(.*\)"$/\1/p' "$_err" | tail -1)"
[[ -n "$_rel" ]] || exit 0
_dest="$(realpath -m -- "$_rel")"
[[ -f "$_dest/.git" ]] || exit 0
if ! _out="$(git -C "$_dest" worktree lock --reason "jj shim: locked on add (AGENTC-431)" "$_dest" 2>&1)"; then
    # In an agent session shims/git already locked it on jj's `git worktree add`.
    [[ "$_out" == *"is already locked"* ]] && exit 0
    echo "jj shim: the workspace was created but its git worktree could NOT be locked: $_out" >&2
    echo "jj shim: lock it by hand: git -C '$_dest' worktree lock '$_dest'" >&2
fi
exit 0
