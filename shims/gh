#!/bin/bash
# knives-gh-shim: thin dispatcher. The brain lives in `knives gh`.
# Docs: knives repo, docs/superpowers/specs/2026-08-05-release-correctness-and-knives-gh-design.md
# KNIVES_GH_BYPASS=1 skips knives entirely (emergency hatch if knives gh misbehaves).
set -euo pipefail

# Every agent session on this machine reaches GitHub through one App
# installation, so they share one primary rate limit; it reached zero four
# times on 2026-11-01 and every session that reads GitHub stopped
# (dispatch://BET-303). This records one line per OUTERMOST gh call, so the
# spend can be attributed to a caller and a command. knives re-enters this
# shim for its own forge queries, and the read cache re-enters it on a miss:
# both carry a marker, and a marked call is the same call again, not a new
# one. Every step is best-effort; nothing here may fail a gh call.
_gh_cache_root() {
    if [[ -n "${GH_READ_CACHE_DIR:-}" ]]; then
        printf '%s' "$GH_READ_CACHE_DIR"
        return
    fi
    local u="${USER:-$(id -un 2> /dev/null || true)}"
    if [[ -n "$u" && -d "/mnt/nvme/$u" ]]; then
        printf '%s' "/mnt/nvme/$u/gh-read-cache"
    else
        printf '%s' "${XDG_CACHE_HOME:-$HOME/.cache}/gh-read-cache"
    fi
}
_gh_call_log() {
    local root dir a s out=''
    root="$(_gh_cache_root)" || return 0
    dir="$root/log"
    mkdir -p "$dir" 2> /dev/null || return 0
    chmod 700 "$root" "$dir" 2> /dev/null || true
    for a in "$@"; do
        s=${a//\\/\\\\}
        s=${s//\"/\\\"}
        s=${s//$'\n'/\\n}
        s=${s//$'\r'/\\r}
        s=${s//$'\t'/\\t}
        out+=",\"$s\""
    done
    local now="${EPOCHREALTIME:-}"
    now="${now/,/.}"
    [[ -n "$now" ]] || now="$(date -u +%s)"
    printf '{"t":%s,"pid":%s,"sid":"%s","cwd":"%s","ev":"call","argv":[%s]}\n' \
        "$now" "$$" "${OMP_SESSION_ID:-}" "${PWD//\"/}" "${out:1}" \
        >> "$dir/$(date -u +%Y%m%d%H).jsonl" 2> /dev/null || true
}
if [[ -z "${KNIVES_GH_SHIM_DEPTH:-}" && -z "${GH_READ_CACHE_BYPASS:-}" && -z "${GH_SHIM_INNER:-}" && "${GH_READ_CACHE_LOG:-}" != 0 ]]; then
    _gh_call_log "$@" || true
fi

# Agent context: an omp session (its bash tool carries OMP_SESSION_ID, its
# eval kernel PI_SESSION_FILE with an allow-listed environment that drops
# GIT_CONFIG_*), an agentbox session, or anything launched with the gh-app
# routing include (shims/omp, scripts/cld). Three guarantees there:
# the routing include is present even when the caller's environment was
# scrubbed; gh sees the agent config directory of scripts/gh-agent-config,
# whose placeholder login stands where the user's would be, so a call with no
# target owner to route fails on GitHub's 401 and never reaches the user's own
# login in hosts.yml or the keyring (an owner the App does not cover gets the
# upstream token from the secrets store); and a call GitHub refuses for the
# App ends with a refusal that names the call and the route to take instead.
# On 2026-09-14 an agent's `gh api -X POST …/reviews` from omp's eval kernel in
# /tmp ran on the user's keyring and approved a pull request as him. On
# 2026-11-02T00:07Z a Python eval kernel's `gh pr review --approve` did it
# again without reaching this shim at all: mise's python3 shim had put mise's
# own gh ahead of this directory on the kernel's PATH. mise.toml's `_.path`
# now puts this directory first in every mise-run process, and
# scripts/agent-session and omp/extensions/session-env.ts export the agent
# GH_CONFIG_DIR, so a gh that still runs past this shim finds no user login.
agent_context() {
    [[ -n "${OMP_SESSION_ID:-}${PI_SESSION_FILE:-}${PI_TOOL_BRIDGE_URL:-}${AGENTBOX_SESSION:-}" ]] && return 0
    local i v
    for ((i = 0; i < ${GIT_CONFIG_COUNT:-0}; i++)); do
        v="GIT_CONFIG_VALUE_$i"
        [[ "${!v:-}" == *gh-app-routes.gitconfig ]] && return 0
    done
    return 1
}

# A refusal names the exact call, the identity it would have acted as, why it
# is refused and what to do instead, and exits non-zero. A silent or vague
# refusal reads as "no approval exists" and sends the next agent looking for
# another credential (the chief of staff's requirement, 2026-11-02).
gh_shim_user_login() {
    local line user=""
    while IFS= read -r line; do
        [[ "$line" =~ ^\ {4}user:\ *([^[:space:]]+) ]] && { user="${BASH_REMATCH[1]}"; break; }
    done < "${XDG_CONFIG_HOME:-$HOME/.config}/gh/hosts.yml" 2> /dev/null || true
    if [[ -n "$user" ]]; then
        printf "the user login \`%s\` from gh's hosts.yml and keyring" "$user"
    else
        printf "the user's own GitHub login from gh's hosts.yml and keyring"
    fi
}
gh_shim_quote() {
    local out="gh" a
    for a in "$@"; do out+=" $(printf '%q' "$a")"; done
    printf '%s' "$out"
}
# gh_shim_refuse WHY INSTEAD ARGV…: the shim itself refuses, before gh runs.
gh_shim_refuse() {
    local why="$1" instead="$2"
    shift 2
    {
        echo "gh shim: REFUSED: \`$(gh_shim_quote "$@")\`"
        echo "  Identity: it would have used $(gh_shim_user_login)."
        echo "  Why: $why A call that acts as that login is Sami's own signature on GitHub; no agent process may use it."
        echo "  Instead: $instead"
    } >&2
    exit 1
}
# What GitHub answers when the App may not do a call: a review of the App's own
# pull request, a permission the installation lacks, a token GitHub rejects.
GH_SHIM_REFUSED_BY_GITHUB='Can not (approve|request changes on) your own pull request|Resource not accessible by|HTTP 40[13]|Bad credentials|must have (admin|push|write|maintain)|not have permission|Permission to [^ ]+ denied|requires authentication'
# gh_shim_refused_for_app RC ARGV…: GitHub refused the call for the App.
gh_shim_refused_for_app() {
    local rc="$1" pr="" repo="" verdict="APPROVE" a prev="" instead
    shift
    if [[ "${1:-}" == pr && "${2:-}" == review ]]; then
        for a in "${@:3}"; do
            case "$prev" in
                -R | --repo) repo="$a" ;;
                -b | --body | -F | --body-file) ;;
                *)
                    case "$a" in
                        --repo=*) repo="${a#--repo=}" ;;
                        -r | --request-changes) verdict="REQUEST_CHANGES" ;;
                        -*) ;;
                        *) [[ -n "$pr" ]] || pr="$a" ;;
                    esac
                    ;;
            esac
            prev="$a"
        done
    elif [[ "${1:-}" == api ]]; then
        for a in "${@:2}"; do
            if [[ "$a" =~ ^/?repos/([^/]+/[^/]+)/pulls/([0-9]+)/reviews ]]; then
                repo="${BASH_REMATCH[1]}" pr="${BASH_REMATCH[2]}"
            fi
            [[ "$a" == *REQUEST_CHANGES* ]] && verdict="REQUEST_CHANGES"
        done
    fi
    if [[ -n "$pr" ]]; then
        instead="if the repository needs an approving review to merge (a comment does not count there), post the review as the legion-reviewer App: \`~/.dotfiles/scripts/post-review $pr <full 40-character head sha> $verdict <body-file> ${repo:-<owner/repo>}\`. Use that route only when your session did not author the pull request. Where a comment is enough, post the verdict as a pull-request comment from the App: \`gh pr comment $pr${repo:+ -R $repo} --body-file <file>\`, the file's first line \`VERDICT: $verdict at <full 40-character head sha>\`. pr-gate reads issue comments as verdicts (dispatch://BET-9/ask/6b7de765)."
    else
        instead="stop, and tell your lead which call GitHub refused and its error above. Do not look for another credential, token or gh binary."
    fi
    {
        echo "gh shim: REFUSED by GitHub: \`$(gh_shim_quote "$@")\` (exit $rc; GitHub's error is above)."
        echo "  Identity: it ran as the GitHub App this repository's owner routes agent calls to. Do not retry with another credential, token or gh binary: $(gh_shim_user_login) is never used by an agent process. The one other identity an agent has is the legion-reviewer App, for a review verdict only, through scripts/post-review (below)."
        echo "  Why: GitHub does not let that App make this call (it cannot approve or request changes on a pull request it opened, and it cannot use a permission its installation lacks)."
        echo "  Instead: $instead"
    } >&2
    exit "$rc"
}
# gh_shim_no_target RC ARGV…: knives found no repository to route on, so gh ran
# with the agent config's placeholder login and GitHub answered 401. That is not
# a refusal of the App: no App was asked.
gh_shim_no_target() {
    local rc="$1"
    shift
    {
        echo "gh shim: NOT ROUTED: \`$(gh_shim_quote "$@")\` (exit $rc). knives found no repository to route on (its line above), so no GitHub App or upstream token was used; GitHub's 401 is for the placeholder login, not a refusal of the App."
        echo "  Instead: name the repository and run the call again: -R <owner>/<repo> (gh pr/issue/repo), the owner in the path (gh api repos/<owner>/<repo>/…), or GH_REPO=<owner>/<repo> before the command."
        echo "  A call with no repository of its own (gh api markdown, search/code, search/issues, /organizations/…): set GH_REPO to the repository your work is in. The call then runs as that owner's GitHub App, or with the upstream token for an owner without an App (shims/AGENTS.md); GitHub's search answers only for what that token can read."
    } >&2
    exit "$rc"
}
# What GitHub answers when a credential's request budget is spent: the primary
# limit ("API rate limit exceeded for user ID …", HTTP 403 or 429) or a
# secondary limit. The call is allowed; the budget is not there now. Read
# before the refusal pattern, which matches the same HTTP 403.
GH_SHIM_RATE_LIMITED='API rate limit (already )?exceeded|secondary rate limit|HTTP 429'
# gh_shim_rate_limited RC ERRFILE ARGV…: the credential's rate limit stopped the
# call. On 2026-11-02 the shared public-repo token's REST budget ran out and the
# refusal text told agents the App could not make the call and to stop.
gh_shim_rate_limited() {
    local rc="$1" err="$2" who token="" owner="" repo="" prev="" a want=core line name left limit reset when
    local -a limits=()
    shift 2
    token="$(sed -nE 's/.*using the personal token ([^ ]+) .*/\1/p' "$err" | head -n 1)"
    owner="$(sed -nE 's/.*\(owner=([^)]+)\).*/\1/p; s/.*no App installation for owner ([^ ;]+).*/\1/p' "$err" | head -n 1)"
    if [[ -n "$token" ]]; then
        who="the shared public-repo token $token${owner:+ (owner $owner has no App installation)}. It is a personal token, so every session on every machine that reads such an owner, and every other token of the same GitHub user, spends this one budget"
    else
        who="the GitHub App installation${owner:+ for owner $owner}, which every agent session shares"
    fi
    for a in "$@"; do
        case "$prev" in -R | --repo) repo="$a" ;; esac
        case "$a" in
            --repo=*) repo="${a#--repo=}" ;;
            graphql) [[ "${1:-}" == api ]] && want=graphql ;;
        esac
        [[ -z "$repo" && "$a" =~ ^/?repos/([^/]+/[^/?]+) ]] && repo="${BASH_REMATCH[1]}"
        prev="$a"
    done
    # The rate_limit endpoint costs nothing against any limit. It runs on the
    # same route as the call: the same repository when the call named one, else
    # the same directory and environment, from which the call itself was routed.
    while IFS= read -r line; do
        [[ -n "$line" ]] && limits+=("$line")
    done < <(
        if [[ -n "$repo" ]]; then export GH_REPO="$repo"; fi
        GH_SHIM_INNER=1 GH_READ_CACHE=0 GH_READ_CACHE_LOG=0 timeout 30 "$0" api rate_limit \
            --jq '.resources | to_entries[] | select(.key == "core" or .key == "graphql") | "\(.key) \(.value.remaining) \(.value.limit) \(.value.reset)"' \
            2> /dev/null || true
    )
    {
        echo "gh shim: RATE LIMITED: \`$(gh_shim_quote "$@")\` (exit $rc; GitHub's error is above)."
        echo "  Identity: it ran as $who."
        if ((${#limits[@]} == 0)); then
            echo "  Limit: the reset time could not be read; \`gh api rate_limit\` from the same repository shows it and costs nothing."
        else
            for line in "${limits[@]}"; do
                read -r name left limit reset <<< "$line"
                [[ "$name" == "$want" || "$left" == 0 ]] || continue
                when="$(date -u -d "@$reset" +%H:%M:%SZ 2> /dev/null || echo "epoch $reset")"
                echo "  Limit: $name $left of $limit left; it resets at $when (in $(((reset - $(date +%s) + 59) / 60)) min)."
            done
        fi
        echo "  Why: this is not a refusal. The call is allowed and the credential is the right one; its request budget is spent for now (a secondary limit, when nothing above reads 0 left, clears within minutes)."
        echo "  Instead: retry after the reset. To read more cheaply, use one GraphQL query (\`gh api graphql\`), which has a budget of its own, in place of repeated REST calls, and poll no faster than once every few minutes. Do not look for another credential."
    } >&2
    exit "$rc"
}
if agent_context; then
    _dotfiles="${DOTFILES_DIR:-$HOME/.dotfiles}"
    _routed=0
    for ((_i = 0; _i < ${GIT_CONFIG_COUNT:-0}; _i++)); do
        _v="GIT_CONFIG_VALUE_$_i"
        [[ "${!_v:-}" == *gh-app-routes.gitconfig ]] && _routed=1
    done
    if ((!_routed)); then
        _i="${GIT_CONFIG_COUNT:-0}"
        export "GIT_CONFIG_KEY_${_i}=include.path" "GIT_CONFIG_VALUE_${_i}=${_dotfiles}/gh-app-routes.gitconfig" GIT_CONFIG_COUNT="$((_i + 1))"
    fi
    _agent_cfg="${XDG_CONFIG_HOME:-$HOME/.config}/gh-agent"
    [[ -f "$_agent_cfg/hosts.yml" && -e "$_agent_cfg/config.yml" ]] || _agent_cfg="$("$_dotfiles/scripts/gh-agent-config")"
    export GH_CONFIG_DIR="$_agent_cfg"
    # `gh auth status` would describe the placeholder login of the agent config
    # directory, never the user's own, while routed calls work. Here it answers
    # for what an agent call uses instead: it names the routing and, inside a
    # GitHub repository, makes one routed read of it and exits on that.
    if [[ "${1:-}" == auth && "${2:-}" == status ]]; then
        echo "gh shim: agent session. gh calls are routed to the GitHub App for the target repo's owner (an owner without one gets the upstream token), minted per call; the user's own login is not used, so it is not reported."
        _remote="$(git remote get-url origin 2>/dev/null || true)"
        _slug=""
        case "$_remote" in
            *github.com[:/]*) _slug="${_remote#*github.com[:/]}"; _slug="${_slug%/}"; _slug="${_slug%.git}" ;;
        esac
        [[ "$_slug" =~ ^[^/]+/[^/]+$ ]] || _slug=""
        if [[ -z "$_slug" ]]; then
            echo "No GitHub repository in this directory to check. To check one, run a read against it, for example: gh api repos/<owner>/<repo> --jq .full_name"
            exit 0
        fi
        if _out="$("$0" api "repos/$_slug" --jq .full_name 2>&1)"; then
            echo "github.com/$_slug: routed access works"
            exit 0
        fi
        echo "github.com/$_slug: routed access FAILED: ${_out%%$'\n'*}"
        exit 1
    fi
    # Every `gh auth` verb except status is about the user's own login; none
    # belongs to an agent. (Without the agent directory's placeholder hosts.yml,
    # `gh auth token` and `gh auth git-credential` read the user's token from
    # the OS keyring: measured, a gho_ token with hosts.yml absent.)
    # git-credential is what ~/.gitconfig names as the user's helper for
    # github.com, so a git process whose environment lost the routing include
    # (omp's eval kernel) lands here: answer with the App helper on the same
    # request. It mints for an owner the App covers, answers the profile's
    # fallback secret (the user's upstream token) for one it does not, and
    # stops git with its own quit=1 when it can do neither.
    if [[ "${1:-}" == auth && "${2:-}" != status ]]; then
        if [[ "${2:-}" == git-credential ]]; then
            [[ "${3:-}" == get ]] && exec gh-app-token agent get
            exit 0
        fi
        gh_shim_refuse "gh auth ${2:-} reads or changes the user's own login, which no agent process may use or change." \
            "Every other gh call is already routed to the GitHub App for the repository's owner: run the call itself (gh pr …, gh api repos/<owner>/<repo>/…) with -R <owner>/<repo>, and it gets the App's token. If that call is refused, stop and tell your lead which call and the error; do not look for another credential." \
            "$@"
    fi
    # The outermost call runs the rest of this shim as a child and keeps a copy
    # of its stderr: when GitHub refuses the call for the App, gh's own error
    # ("Can not approve your own pull request", "Resource not accessible by
    # integration") reads to an agent like a missing credential, and an agent
    # that goes looking for another one finds the user's. The refusal below
    # names the call, says no other identity exists and gives the route.
    if [[ -z "${GH_SHIM_INNER:-}" && -z "${GH_READ_CACHE_BYPASS:-}" ]] \
        && _err="$(mktemp "${TMPDIR:-/tmp}/gh-shim-stderr.XXXXXX" 2> /dev/null)"; then
        set +e
        { GH_SHIM_INNER=1 "$0" "$@" 2>&1 >&3 3>&- | tee "$_err" >&2; } 3>&1
        _rc=${PIPESTATUS[0]}
        set -e
        _refused=0
        _no_target=0
        _limited=0
        if ((_rc != 0)); then
            grep -q '^knives gh: no target repository' "$_err" && _no_target=1
            ((!_no_target)) && grep -qiE "$GH_SHIM_RATE_LIMITED" "$_err" && _limited=1
            ((!_no_target && !_limited)) && grep -qiE "$GH_SHIM_REFUSED_BY_GITHUB" "$_err" && _refused=1
        fi
        if ((_limited)); then
            set +e
            ( gh_shim_rate_limited "$_rc" "$_err" "$@" )
            set -e
            rm -f "$_err"
            exit "$_rc"
        fi
        rm -f "$_err"
        ((_no_target)) && gh_shim_no_target "$_rc" "$@"
        ((_refused)) && gh_shim_refused_for_app "$_rc" "$@"
        exit "$_rc"
    fi
    # An inherited GH_TOKEN wins over everything below: knives skips minting and
    # gh acts as whoever owns that token, with no trace at the call site. That
    # is legitimate (the queue's admin PAT via `secrets`), so it is not refused,
    # but it is never silent: 2026-09-17, two review verdicts went out as the
    # human and nothing recorded which path produced them.
    if [[ -n "${GH_TOKEN:-}" ]]; then
        case "$GH_TOKEN" in
            ghs_*) _kind="an App installation token" ;;
            ghp_*|gho_*|github_pat_*) _kind="a PERSONAL token: this call acts as its user, not as an App" ;;
            *) _kind="a token of unknown kind" ;;
        esac
        echo "gh shim: GH_TOKEN inherited from the environment (${GH_TOKEN:0:4}…, $_kind); not routing" >&2
    fi
    # A standalone docs-only pull request is refused where docs are batched.
    if [[ "${1:-}" == pr && "${2:-}" == create ]]; then
        "$_dotfiles/scripts/docs-pr-gate" "${@:3}"
    fi
    # Public repository text: refuse an internal reference before gh posts it.
    "$_dotfiles/scripts/public-text-gate" "$@" || exit 1
    # A call goes through the host-wide read cache (dispatch://BET-303):
    # an identical read from any session inside 60 s (120 s for
    # `gh pr view/checks/list --json`) is answered without a
    # request at all, and a plain `gh api` GET revalidates its stored ETag
    # with a conditional request, which GitHub does not count against the
    # primary rate limit when it answers 304. The cache re-enters this shim
    # for the call it does make, marked, so routing, the gates above and
    # knives all run on it unchanged. A write runs as written, and when it
    # ends the cache stops serving every read of that pull request or issue
    # and every repository-wide read of its repository. Anything else, and
    # any failure of that layer, continues below as before.
    if [[ -z "${GH_READ_CACHE_BYPASS:-}" && "${GH_READ_CACHE:-}" != 0 && -x "$_dotfiles/scripts/gh-read-cache" ]]; then
        _self="$(readlink -f "$0" 2> /dev/null || true)"
        [[ -n "$_self" ]] || _self="$0"
        GH_READ_CACHE_GH="$_self" exec "$_dotfiles/scripts/gh-read-cache" -- "$@"
    fi
fi

# Content decides what is "real", never the path: any candidate carrying the
# knives-gh-shim marker in its first 512 bytes is a shim. The old dir-string
# skip broke whenever HOME or DOTFILES_DIR spelled this shim's directory
# differently from PATH, and knives gh re-entered this shim in an unbounded
# fork chain (2026-08-27, ~300k processes). Mirrors real_gh() in knives
# src/commands/gh.rs.
real_gh() {
    local IFS=':'
    local dir candidate header
    for dir in $PATH; do
        candidate="$dir/gh"
        [[ -f "$candidate" && -x "$candidate" ]] || continue
        # Pure bash on purpose: this must work on a PATH too broken to find
        # head or grep. read stops at the first NUL, so an ELF gh yields a
        # short marker-free header and is accepted.
        header=""
        IFS= read -r -n 512 -d '' header < "$candidate" || true
        [[ "$header" == *knives-gh-shim* ]] && continue
        echo "$candidate"
        return
    done
    return 1
}

# Resolve the real gh FIRST and refuse to proceed without it (a bare `gh`
# fallback would re-enter this shim and recurse), and honor the bypass before
# involving knives at all.
if ! _real="$(real_gh)"; then
    echo "gh shim: no real gh found on PATH" >&2
    exit 127
fi
if [[ -z "${KNIVES_GH_BYPASS:-}" ]] && command -v knives > /dev/null 2>&1; then
    # Backstop: a resolution bug must fail loudly here, never fork-bomb the
    # machine. Legit flows re-enter this shim at most twice (knives runs bare
    # `gh` for forge queries); depth 3 is a loop.
    _depth="${KNIVES_GH_SHIM_DEPTH:-0}"
    [[ "$_depth" =~ ^[0-9]+$ ]] || _depth=0
    if ((_depth >= 3)); then
        echo "gh shim: re-entered $_depth times — knives gh is looping through this shim" >&2
        echo "gh shim: refusing to recurse; KNIVES_GH_BYPASS=1 runs $_real directly" >&2
        exit 70
    fi
    KNIVES_GH_SHIM_DEPTH=$((_depth + 1)) KNIVES_REAL_GH="$_real" exec knives gh -- "$@"
fi
exec "$_real" "$@"
