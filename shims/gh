# profile in its own git config file, ~/.config/git/config (`gh-app.host-profile`, written by
# installers/gh-app-host.sh), and the request goes to the App helper exactly as an agent's does
# above. Only that file counts: not the shared ~/.gitconfig, not a repository's config, and not
# `git config --global`, which git 2.43 answers from ~/.gitconfig alone when that file exists.
if [[ "${1:-}" == auth && "${2:-}" == git-credential ]] &&
    _host_profile="$(git config --file "${XDG_CONFIG_HOME:-$HOME/.config}/git/config" --get gh-app.host-profile 2> /dev/null)" &&
    [[ -n "$_host_profile" ]]; then
    [[ "${3:-}" == get ]] && exec gh-app-token "$_host_profile" get
    exit 0
fi

# The same machine's other gh calls from a host shell (an ssh command, a user unit, a pre-push hook)
# had no token at all: no person's login exists there, and the App routing above is an agent
# session's. installers/agent-spend.sh's `gh api` fetch failed, and a hooked push was refused because
# the leak check could not read the repository's visibility (2026-11-04). So outside an agent session,
# when the caller gives no GH_TOKEN or GITHUB_TOKEN, the call gets an installation token of the same
# profile for its target owner, minted through the broker's machine login, as the git helper above
# does. The owner comes from -R/--repo, GH_REPO, a `repos/OWNER/…` path of `gh api`, or this
# directory's origin remote, else theorem-labs. Only an App installation token (ghs_) is used: for an
# owner the App does not cover, gh-app-token answers the profile's personal fallback token, which is
# refused here, and the call goes on with no token. `gh auth` verbs are left to the real gh.
# GH_APP_TOKEN_MIN_LIFETIME: gh reads its token once per call; a cached token with under 30 minutes
# left is replaced by a fresh one (`gh run watch` failed 401 on a 12-minute token, 2026-10-22).
if [[ -z "${GH_TOKEN:-}${GITHUB_TOKEN:-}" && "${1:-}" != auth ]] && ! agent_context &&
    _host_profile="$(git config --file "${XDG_CONFIG_HOME:-$HOME/.config}/git/config" --get gh-app.host-profile 2> /dev/null)" &&
    [[ -n "$_host_profile" ]]; then
    gh_shim_target_owner "$@"
    if _host_token="$(GH_APP_TOKEN_MIN_LIFETIME="${GH_APP_TOKEN_MIN_LIFETIME:-1800}" gh-app-token "$_host_profile" --owner "$_owner" 2> /dev/null)" &&
        [[ "$_host_token" == ghs_* ]]; then
        export GH_TOKEN="$_host_token"
    else
        echo "gh shim: no GitHub App installation token for owner $_owner (profile $_host_profile); gh runs with no token" >&2
    fi
    unset _host_token
fi

# Listed leak terms (leak-terms.sops.yaml) in the text a gh call sends, for every caller, as for a commit or a push:
# on 2026-11-17 an agent's `gh pr edit` put a listed term into a public pull request's body, where GitHub keeps it in
# the body's edit history (dispatch://INFRA-4102). A call that can carry text (gh_shim_may_send_text) goes to
# `scripts/leak-terms-check gh` on the pass that runs gh: for an agent, after the read cache and the public text gate,
# on exactly the arguments gh then gets. The check reads every text the call sends, files and stdin included, and
# refuses one that holds a listed term when the call can reach anything not confirmed private, a visibility it cannot
# read counting as public; a text it cannot read, or a list it cannot decrypt, is refused the same way. A refused call
# exits 2, and gh never runs. When the check needs stdin (its exit 7), it gets the buffer the public text gate shares.
# DOTFILES_LEAK_TERMS_GH_STDIN is this block's alone, for the reason PUBLIC_LEAK_CHECK_STDIN is the gate's.
unset DOTFILES_LEAK_TERMS_GH_STDIN
if gh_shim_may_send_text "$@"; then
    # The check of this shim's own checkout, found through a link to the shim as the agent block finds it.
    _term_check="${BASH_SOURCE[0]}"
    [[ ! -L "$_term_check" ]] || _term_check="$(command -p readlink -f -- "$_term_check")"
    _term_check="${_term_check%/*}/../scripts/leak-terms-check"
    _term_rc=0
    if [[ -n "$_stdin_g" ]]; then
        DOTFILES_LEAK_TERMS_GH_STDIN="/dev/fd/$_stdin_g" "$_term_check" gh -- "$@" || _term_rc=$?
    else
        "$_term_check" gh -- "$@" || _term_rc=$?
        if ((_term_rc == 7)); then
            gh_shim_buffer_stdin
            _term_rc=0
            DOTFILES_LEAK_TERMS_GH_STDIN="/dev/fd/$_stdin_g" "$_term_check" gh -- "$@" || _term_rc=$?
        fi
    fi
    if ((_term_rc != 0)); then
        ((_term_rc < 126)) || echo "gh shim: refusing: the leak-term check $_term_check could not run (exit $_term_rc)" >&2
        exit 2
    fi
fi
gh_shim_stdin_to_gh

# mise_paths: mise as this machine runs it, whatever HOME and PATH the caller set
# (shims/AGENTS.md, "A moved HOME"). A Legion test pane runs a shim with a
# temporary HOME and the PATH <bin>:/usr/local/bin:/usr/bin:/bin, where every
# path under HOME names nothing. Sets, once per process:
#   _mise_bin     mise on PATH, else the dotfiles checkout's bin/mise, else the
#                 mise the shims in a data dir link to (a copy or a worktree of
#                 the checkout has no bin/, which is not committed)
#   _mise_config  mise's global configuration: MISE_GLOBAL_CONFIG_FILE, else the
#                 file under HOME when it is readable, else the checkout's
#                 mise.toml, which installers link that file to
#   _mise_datas   the data dirs a tool may be installed in: MISE_DATA_DIR and mise's
#                 default ~/.local/share/mise under HOME; with no MISE_DATA_DIR,
#                 ~/.mise (.bashrc's) and that default, under HOME, then the passwd home's
#   _mise_data    the one to give mise: MISE_DATA_DIR, else the first that exists
# The checkout is DOTFILES_DIR, else the one this file's own path is in.
mise_paths() {
    local IFS=$' \t\n'
    local self dotfiles home dir data seen=""
    local -a all=()
    [[ -z "${_mise_config:-}" ]] || return 0
    _mise_bin=""
    IFS=':'
    for dir in ${PATH:-}; do
        if [[ -n "$dir" && -f "$dir/mise" && -x "$dir/mise" ]]; then
            _mise_bin="$dir/mise"
            break
        fi
    done
    IFS=$' \t\n'
    _mise_config="${MISE_GLOBAL_CONFIG_FILE:-${XDG_CONFIG_HOME:-${HOME:-}/.config}/mise/config.toml}"
    if [[ -z "$_mise_bin" || ( -z "${MISE_GLOBAL_CONFIG_FILE:-}" && ! -r "$_mise_config" ) ]]; then
        dotfiles="${DOTFILES_DIR:-}"
        if [[ -z "$dotfiles" ]]; then
            self="$(command -p readlink -f -- "${BASH_SOURCE[0]}")" || self=""
            dotfiles="${self%/shims/*}"
        fi
        [[ -n "$_mise_bin" ]] || _mise_bin="$dotfiles/bin/mise"
        [[ -n "${MISE_GLOBAL_CONFIG_FILE:-}" || -r "$_mise_config" ]] || _mise_config="$dotfiles/mise.toml"
    fi
    if [[ -n "${MISE_DATA_DIR:-}" ]]; then
        all=("$MISE_DATA_DIR" "${XDG_DATA_HOME:-${HOME:-}/.local/share}/mise")
    else
        all=("${HOME:-}/.mise" "${XDG_DATA_HOME:-${HOME:-}/.local/share}/mise")
        # With HOME unset, ~ is the uid's home in the passwd database, which HOME does not move.
        local HOME
        unset HOME
        home=~
        [[ "$home" != /?* ]] || all+=("$home/.mise" "$home/.local/share/mise")
    fi
    _mise_datas=() _mise_data="${MISE_DATA_DIR:-}"
    for data in "${all[@]}"; do
        [[ "$data" == /?* && ":$seen:" != *":$data:"* ]] || continue
        seen+=":$data"
        _mise_datas+=("$data")
        [[ -n "$_mise_data" || ! -d "$data" ]] || _mise_data="$data"
    done
    if [[ ! -f "$_mise_bin" || ! -x "$_mise_bin" ]]; then
        for data in ${_mise_datas[@]+"${_mise_datas[@]}"}; do
            for dir in "$data"/shims/*; do
                [[ -L "$dir" ]] || continue
                dir="$(command -p readlink -f -- "$dir")" || dir=""
                [[ "$dir" != */mise || ! -f "$dir" || ! -x "$dir" ]] || _mise_bin="$dir"
                break
            done
            [[ ! -x "$_mise_bin" ]] || break
        done
    fi
    : "${_mise_data:=${_mise_datas[0]:-}}"
}

# is_mise_shim FILE: whether FILE is mise's own shim, a file in the shims dir of
# one of mise's data dirs or a link to mise. It reaches its tool only where mise
# reads its config and trust list under HOME, which a moved HOME hides.
is_mise_shim() {
    local IFS=$' \t\n'
    local data
    mise_paths
    for data in ${_mise_datas[@]+"${_mise_datas[@]}"}; do
        [[ "${1%/*}" -ef "$data/shims" ]] && return 0
    done
    [[ -L "$1" && "$(command -p readlink -f -- "$1")" == */mise ]]
}

# mise_pinned BIN TOOL: sets _pinned to BIN in the install of TOOL at the exact
# version mise's global configuration pins (a [tools] line), from mise's data
# dirs, whatever HOME and PATH the caller set (mise_paths). Without one, _pinned
# is empty and _pinned_searched says what was read, for the caller's refusal.
mise_pinned() {
    local bin="$1" tool="$2"
    local IFS=$' \t\n'
    local line section="" pin="" key data candidate searched=""
    local section_re='^[[:space:]]*\[([^]]*)\]'
    local pin_re='^[[:space:]]*"?([^"=[:space:]]+)"?[[:space:]]*=[[:space:]]*"([0-9][0-9A-Za-z.+-]*)"'
    _pinned="" _pinned_searched=""
    mise_paths
    if [[ -r "$_mise_config" ]]; then
        while IFS= read -r line || [[ -n "$line" ]]; do
            if [[ "$line" =~ $section_re ]]; then
                section="${BASH_REMATCH[1]}"
            elif [[ "$section" == tools && "$line" =~ $pin_re && "${BASH_REMATCH[1]}" == "$tool" ]]; then
                pin="${BASH_REMATCH[2]}"
                break
            fi
        done < "$_mise_config"
    fi
    if [[ -z "$pin" ]]; then
        _pinned_searched="no exact version of $tool pinned in $_mise_config"
        return 1
    fi
    key="${tool//[:\/]/-}"
    key="${key//@/}"
    for data in ${_mise_datas[@]+"${_mise_datas[@]}"}; do
        for candidate in "$data/installs/$key/$pin/$bin" "$data/installs/$key/$pin/bin/$bin" "$data/installs/$key/$pin"/*/bin/"$bin"; do
            if [[ -f "$candidate" && -x "$candidate" ]]; then
                _pinned="$candidate"
                return 0
            fi
        done
        searched+="${searched:+, }$data/installs/$key/$pin"
    done
    _pinned_searched="$tool $pin, pinned in $_mise_config, is installed in none of $searched (\`mise install\` installs it)"
    return 1
}

# A gh this shim hands the call to can hand it straight back. mise's shim does, in the same pid,
# when mise has no gh version for the directory; a wrapper does when it runs this shim as its own
# real gh. On 2026-11-18 a test of cybermonklabs/legion put a pane's `gh` wrapper (`exec
# legion.test gh "$@"`) first on PATH and gave `legion gh` this shim, by its path, as the real gh,
# which `legion gh` starts as a child: the shim took the wrapper for the real gh, and the chain of
# wrapper, `legion gh` and shim grew about 2,000 processes deep (4,275 processes) until the user's
# memory limit stopped it and two sessions' workers died. DOTFILES_GH_SHIM ("<pid> <hops> <call>
# <gh>:<gh>…") names every gh this shim has handed the call to, the pid that handed it, how many
# hand-offs to a gh the chain of processes above it has made, and the call (gh_shim_call_digest),
# `-` where the only gh it names is the pinned install, which is gh itself and hands nothing back,
# or where no digest could be made. A pass in that pid, or one below it given the same call, is
# that call coming back: the lookup skips each gh named (and every path to the same file), taking
# the next one, then the pinned install, or failing with exit 127 and one line naming PATH, instead
# of looping. Any other call below the real gh (the git credential helper gh runs, knives' own
# queries) is another call, and the marker skips nothing for it.
# The hop count is the guard where that skip cannot see the call: with no sha256sum on PATH there
# is no digest, and a wrapper that changes the argv on each pass makes a new call each time. Bash
# keeps the count itself, so it holds whatever tool is missing: the hand-off past _max_hops is
# refused with exit 127 and one line. The deepest chain that is no loop has about four (knives'
# hand-off, its own gh query, the git credential helper the real gh runs, a hook's gh); 8 leaves
# room for that and stops a loop at nine wrapper passes.
_max_hops=8
_handed="" _call=""
read -r _marker_pid _marker_hops _marker_call _marker_handed <<< "${DOTFILES_GH_SHIM:-}"
[[ "$_marker_hops" =~ ^[0-9]{1,4}$ ]] && _marker_hops=$((10#$_marker_hops)) || _marker_hops=0
if ((_marker_hops >= _max_hops)); then
    echo "gh shim: refusing: this chain of processes already handed a call to a gh $_marker_hops times through this shim (DOTFILES_GH_SHIM, at most $_max_hops), so a gh on PATH ($PATH) keeps handing calls back to it${_marker_handed:+; the last pass handed one to ${_marker_handed//:/, }}" >&2
    exit 127
fi
if [[ "$_marker_pid" == "$$" ]]; then
    _handed="$_marker_handed"
elif [[ -n "$_marker_call" && "$_marker_call" != - ]]; then
    gh_shim_call_digest "$@"
    _call="$_digest"
    [[ "$_call" != "$_marker_call" ]] || _handed="$_marker_handed"
fi
# handed_back GH: whether GH, or any path to the same file, is a gh this call was handed to.
handed_back() {
    local IFS=':'
    local gh
    for gh in $_handed; do
        [[ -n "$gh" && "$1" -ef "$gh" ]] && return 0
    done
    return 1
}

# real_gh: sets _real to the gh this shim hands the call to, and _real_pinned when that is the
# pinned install: the first gh past this shim's own PATH entry (the first entry whose gh is this
# file, through a link too), or, when the shim was run by a path outside PATH, the first from the
# top. A gh above the shim's entry is never taken: one there can be a wrapper that runs this shim
# again (above). Content decides what is a copy of this shim, never the path: any candidate
# carrying the knives-gh-shim marker in its first 512 bytes is a shim. The old dir-string skip
# broke whenever HOME or DOTFILES_DIR spelled this shim's directory differently from PATH, and
# knives gh re-entered this shim in an unbounded fork chain (2026-08-27, ~300k processes). A gh
# that handed the call back is skipped too. A variable, not output, so no subshell is forked.
# mise's own shim gives way to the gh pinned exactly in mise's global config,
# straight from its install dir, as shims/knives runs knives: mise's shim is
# mise itself, which reads its config, then execs that gh, one more process on
# every call (0.15 s p50, 0.51 s p90 over 20 calls at load ~290 on 2026-11-03),
# and under load mise hung for minutes (2026-11-03 ~00:3x-01:00Z, shims/knives).
# With no exact pin, or no install of it, _real stays mise's shim. Past PATH,
# the pinned install.
real_gh() {
    local IFS=':'
    local pass dir candidate header own=""
    _real="" _real_pinned=""
    for pass in past-own-entry from-top; do
        for dir in $PATH; do
            candidate="$dir/gh"
            if [[ "$pass" == past-own-entry && -z "$own" ]]; then
                [[ "$candidate" -ef "${BASH_SOURCE[0]}" ]] && own=1
                continue
            fi
            [[ -f "$candidate" && -x "$candidate" ]] || continue
            # Pure bash on purpose: this must work on a PATH too broken to find
            # head or grep. read stops at the first NUL, so an ELF gh yields a
            # short marker-free header and is accepted.
            header=""
            IFS= read -r -n 512 -d '' header < "$candidate" || true
            [[ "$header" == *knives-gh-shim* ]] && continue
            handed_back "$candidate" && continue
            _real="$candidate"
            if is_mise_shim "$candidate" && mise_pinned gh gh && ! handed_back "$_pinned"; then
                _real="$_pinned" _real_pinned=1
            fi
            return 0
        done
        [[ -z "$own" ]] || break
    done
    mise_pinned gh gh && ! handed_back "$_pinned" && _real="$_pinned" _real_pinned=1
}

# Resolve the real gh FIRST and refuse to proceed without it (a bare `gh`
# fallback would re-enter this shim and recurse), and honor the bypass before
# involving knives at all.
if ! real_gh; then
    echo "gh shim: no real gh found on PATH ($PATH), and ${_pinned_searched:-the pinned install handed the call back}${_handed:+; ${_handed//:/, } handed the call back to this shim}" >&2
    exit 127
fi
_handed="${_handed:+$_handed:}$_real"
if [[ -z "$_call" && ( -z "$_real_pinned" || "$_handed" != "$_real" ) ]]; then
    gh_shim_call_digest "$@"
    _call="$_digest"
fi
export DOTFILES_GH_SHIM="$$ $((_marker_hops + 1)) ${_call:--} $_handed"
# The call reaches gh now: the outermost pass of an agent session reads its stderr for GitHub refusing it, or a spent
# rate limit, only after this mark (_reached_mark, which that pass names for its inner passes).
if [[ -n "$_reached_mark" && -n "${GH_SHIM_INNER:-}${GH_READ_CACHE_BYPASS:-}" ]]; then
    printf 1 > "$_reached_mark" 2> /dev/null || true
fi
if [[ -z "${KNIVES_GH_BYPASS:-}" ]] && command -v knives > /dev/null 2>&1; then
    # Backstop: a resolution bug must fail loudly here, never fork-bomb the
    # machine. Legit flows re-enter this shim at most twice (knives runs bare
    # `gh` for forge queries); depth 3 is a loop.
    _depth="${KNIVES_GH_SHIM_DEPTH:-0}"
    [[ "$_depth" =~ ^[0-9]+$ ]] || _depth=0
    if ((_depth >= 3)); then
        echo "gh shim: re-entered $_depth times — knives gh is looping through this shim" >&2
        echo "gh shim: refusing to recurse; KNIVES_GH_BYPASS=1 runs $_real directly" >&2
        exit 70
    fi
    if [[ -n "${_routed_only:-}" && -x "$_dotfiles/scripts/gh-routed-only" ]]; then
        GH_SHIM_REAL_GH="$_real" KNIVES_GH_SHIM_DEPTH=$((_depth + 1)) KNIVES_REAL_GH="$_dotfiles/scripts/gh-routed-only" \
            exec knives gh -- "$@"
    fi
    KNIVES_GH_SHIM_DEPTH=$((_depth + 1)) KNIVES_REAL_GH="$_real" exec knives gh -- "$@"
fi
exec "$_real" "$@"
