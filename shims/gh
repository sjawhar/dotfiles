#!/bin/bash
# knives-gh-shim: thin dispatcher. The brain lives in `knives gh`.
# Docs: knives repo, docs/superpowers/specs/2026-08-05-release-correctness-and-knives-gh-design.md
# KNIVES_GH_BYPASS=1 skips knives entirely (emergency hatch if knives gh misbehaves).
set -euo pipefail

# Agent context: an omp session (its bash tool carries OMP_SESSION_ID, its
# eval kernel PI_SESSION_FILE with an allow-listed environment that drops
# GIT_CONFIG_*), an agentbox session, or anything launched with the gh-app
# routing include (shims/omp, scripts/cld). Two guarantees there:
# the routing include is present even when the caller's environment was
# scrubbed; and gh sees the agent config directory of scripts/gh-agent-config,
# whose placeholder login stands where the user's would be, so a call with no
# target owner to route fails on GitHub's 401 and never reaches the user's own
# login in hosts.yml or the keyring (an owner the App does not cover gets the
# upstream token from the secrets store).
# On 2026-09-14 an agent's `gh api -X POST …/reviews` from omp's eval kernel in
# /tmp ran on the user's keyring and approved a pull request as him. On
# 2026-11-02T00:07Z a Python eval kernel's `gh pr review --approve` did it
# again without reaching this shim at all: mise's python3 shim had put mise's
# own gh ahead of this directory on the kernel's PATH. mise.toml's `_.path`
# now puts this directory first in every mise-run process, and
# scripts/agent-session and omp/extensions/session-env.ts export the agent
# GH_CONFIG_DIR, so a gh that still runs past this shim finds no user login.
agent_context() {
    [[ -n "${OMP_SESSION_ID:-}${PI_SESSION_FILE:-}${PI_TOOL_BRIDGE_URL:-}${AGENTBOX_SESSION:-}${CLAUDECODE:-}${ENVOY_SESSION_ID:-}${AGENT_SHIM_AGENT:-}${LEGION_ROLE:-}${LEGION_TREE:-}${LEGION_CONTROLLER:-}${LEGION_DAEMON_URL:-}" ]] && return 0
    local i v
    for ((i = 0; i < ${GIT_CONFIG_COUNT:-0}; i++)); do
        v="GIT_CONFIG_VALUE_$i"
        [[ "${!v:-}" == *gh-app-routes.gitconfig ]] && return 0
    done
    # There is no exception for tmux. A pane takes the SERVER's environment, not the environment
    # of whoever asked for the pane, so "inside tmux means the person" let an agent's own
    # `tmux new-window` under the person's server produce a pane with no marker that then ran as
    # the person (round 3 of INFRA-1538). The fix is the other way round: shims/tmux and
    # scripts/agentbox-tmux-guard pass the caller's markers to the new pane with tmux's -e, so an
    # agent's pane carries them and is caught above.
    # A command that arrives over SSH in a session with no controlling terminal (`ssh host az
    # account show`) is an agent's, not a person's. The session's terminal decides, not this
    # command's stdin and not SSH_TTY alone: a person's session has one (sshd's for an interactive
    # login, tmux's for every pane) and every process of it shares it, so a pipe into one command of
    # it (`echo x | az …`, git handing its credential helper the request) is still the person's,
    # where testing this command's own stdin made it an agent's. A tmux server started before
    # .tmux.conf carried SSH_TTY gives its panes SSH_CONNECTION without SSH_TTY, and on that alone
    # Sami's own pane was taken for an agent's (INFRA-4089). /dev/tty opens only in a session with
    # a terminal; `true`, not `:`, since a failed redirection of a special builtin ends a
    # POSIX-mode bash. AGENT_SHIM_PERSON=1 is the person's escape for a deliberate
    # non-interactive SSH command of their own (INFRA-1538).
    if [[ -n "${SSH_CONNECTION:-}" && -z "${SSH_TTY:-}" && "${AGENT_SHIM_PERSON:-}" != 1 ]] &&
        ! { true < /dev/tty; } 2> /dev/null; then
        AGENT_CONTEXT_VIA_SSH=1
        return 0
    fi
    return 1
}

# Say so when the SSH rule above, and not a session marker, made this an agent's call: nothing
# else in the output names the identity, and a person whose own non-interactive ssh command this
# is needs to see the escape. Once per call: knives' own queries re-enter this shim.
if [[ -z "${KNIVES_GH_SHIM_DEPTH:-}" ]] &&
    agent_context && [[ -n "${AGENT_CONTEXT_VIA_SSH:-}" ]]; then
    echo "gh shim: non-interactive SSH, so an agent's call: routed to the GitHub App, not to any person's login (set AGENT_SHIM_PERSON=1 for your own)" >&2
fi

# There is no exception here for a machine that names gh-app.host-profile in its own git config
# (sami-devbox, installers/gh-app-host.sh). An earlier draft kept the HOST route for a call whose
# only agent evidence was the SSH rule, on the grounds that the agent route needs a broker session
# an ssh command has not got. It does not: gh-app-token registers one itself (`secret-run
# --register`, shims/gh-app-token), and that profile IS `agent`, so both routes mint the same
# App token. The exception only lifted such a call out of the whole agent block below — past the
# public-text leak check, past the refusal of `gh auth token`, and past the agent GH_CONFIG_DIR
# (review of INFRA-1538).

# gh_shim_quote ARGV…: the call as a shell reads it, for the refusal of `gh auth` below.
gh_shim_quote() {
    local out="gh" a
    for a in "$@"; do out+=" $(printf '%q' "$a")"; done
    printf '%s' "$out"
}
# gh_shim_origin_slug: sets _slug to OWNER/REPO of this directory's origin remote on github.com,
# else empty.
gh_shim_origin_slug() {
    local remote
    remote="$(git remote get-url origin 2> /dev/null || true)"
    _slug=""
    case "$remote" in
        *github.com[:/]*) _slug="${remote#*github.com[:/]}"; _slug="${_slug%/}"; _slug="${_slug%.git}" ;;
    esac
    [[ "$_slug" =~ ^[^/]+/[^/]+$ ]] || _slug=""
}
# gh_shim_target_owner ARGV…: sets _owner to the GitHub owner the call targets: -R/--repo, then
# GH_REPO, then a `repos/OWNER/…` path of `gh api`, then the origin remote, else theorem-labs.
gh_shim_target_owner() {
    local a prev="" repo="" path=""
    for a in "$@"; do
        case "$prev" in -R | --repo) repo="$a" ;; esac
        case "$a" in
            --repo=*) repo="${a#--repo=}" ;;
            -R?*) repo="${a#-R}" ;;
        esac
        [[ "${1:-}" == api && -z "$path" && "$a" =~ ^/?repos/([^/?]+)/ ]] && path="${BASH_REMATCH[1]}"
        prev="$a"
    done
    [[ -n "$repo" ]] || repo="${GH_REPO:-}"
    repo="${repo#https://}"
    repo="${repo#github.com/}"
    _owner="${repo%%/*}"
    [[ -n "$_owner" ]] || _owner="$path"
    if [[ -z "$_owner" ]]; then
        gh_shim_origin_slug
        _owner="${_slug%%/*}"
    fi
    [[ -n "$_owner" ]] || _owner=theorem-labs
}
# gh_shim_call_digest ARGV…: sets _digest to the SHA-256 of ARGV, each argument ended by a NUL (no argument
# can hold one), so one digest names one exact call; empty when it cannot be computed.
gh_shim_call_digest() {
    _digest="$(printf '%s\0' "$@" | sha256sum 2> /dev/null)" || _digest=""
    _digest="${_digest%% *}"
}
# gh_shim_is_write ARGV…: true when this call changes something on GitHub. `gh api` counts when
# it names a method other than GET, which is how gh itself decides; every other verb is listed,
# because a verb this misses is a write whose text goes out unchecked. Read verbs are never listed, so a
# new read command keeps working without an edit here. The command and its verb are found as cobra
# finds them, past the options before each (`gh -R o/r pr comment 1` and `gh pr -R o/r comment 1`
# are `gh pr comment`): an option written apart from any value, but --help and --version, takes the
# next word as its value.
gh_shim_is_write() {
    local a method="" group="" verb="" skip=0 letters value kind pending="" body=0
    for a in "$@"; do
        if ((skip)); then
            skip=0
            continue
        fi
        case "$a" in
            --) break ;;
            --help | --version | -*=*) ;;
            --* | -?) skip=1 ;;
            -*) ;;
            *)
                if [[ -z "$group" ]]; then
                    group="$a"
                    [[ "$a" != api ]] || break
                else
                    verb="$a"
                    break
                fi
                ;;
        esac
    done
    case "$group" in
        api)
            # gh api's options as gh's flag parser (pflag) reads them (`gh api --help`, gh 2.98.0): the method is the
            # last -X/--method given, and with none, a field (-f/-F) or an --input body makes gh POST. A value option
            # takes the rest of its word (`-XPOST`, `-X=POST`, `--method=POST`) or else the next word, also at the end
            # of a cluster after -i, gh api's one short flag that takes none (`-iXPOST`, `-if k=v`), and a word an
            # option takes is never read as an option (`-t -XGET` is a template). Until 2026-11-17 neither a cluster
            # nor a taken word was read, so `gh api -X GET -iXPOST …`, `gh api … -if body=…` and
            # `gh api … -f body=… -t -XGET` were reads here, and gh POSTed their text without the leak-term check.
            for a in "$@"; do
                if [[ -n "$pending" ]]; then
                    case "$pending" in method) method="$a" ;; body) body=1 ;; esac
                    pending=""
                    continue
                fi
                case "$a" in
                    --) break ;;
                    --method=*) method="${a#--method=}" ;;
                    --field=* | --raw-field=* | --input=*) body=1 ;;
                    --method) pending=method ;;
                    --field | --raw-field | --input) pending=body ;;
                    --cache | --header | --hostname | --jq | --preview | --template) pending=other ;;
                    --*) ;;
                    -?*)
                        letters="${a#-}"
                        while [[ "$letters" == i* ]]; do
                            letters="${letters#i}"
                            [[ "$letters" != =* ]] || letters=""
                        done
                        case "${letters:0:1}" in
                            X) kind=method ;;
                            f | F) kind=body ;;
                            H | p | q | t) kind=other ;;
                            *) continue ;;
                        esac
                        value="${letters:1}"
                        [[ ${#value} -le 1 || "${value:0:1}" != = ]] || value="${value:1}"
                        if [[ -z "$value" ]]; then
                            pending="$kind"
                        elif [[ "$kind" == method ]]; then
                            method="$value"
                        elif [[ "$kind" == body ]]; then
                            body=1
                        fi
                        ;;
                esac
            done
            if [[ -n "$method" ]]; then
                [[ "${method^^}" == GET || "${method^^}" == HEAD ]] && return 1
                return 0
            fi
            ((body)) && return 0
            return 1
            ;;
        issue | pr | discussion)
            case "$verb" in
                create | new | comment | edit | close | reopen | merge | review | ready | delete | lock \
                    | unlock | pin | unpin | transfer | develop | checkout | revert) return 0 ;;
            esac
            ;;
        release | repo | label | secret | variable | gist | ruleset | project | codespace)
            case "$verb" in
                create | new | edit | delete | upload | set | remove | rename | archive | sync | fork \
                    | clone | deploy-key | copy | close | stop | field-create | item-create | item-edit) return 0 ;;
            esac
            ;;
        agent-task | agent-tasks | agent | agents) case "$verb" in create) return 0 ;; esac ;;
        workflow) case "$verb" in run | enable | disable) return 0 ;; esac ;;
        run) case "$verb" in rerun | cancel | delete) return 0 ;; esac ;;
        cache) case "$verb" in delete) return 0 ;; esac ;;
    esac
    return 1
}
# gh_shim_may_send_text ARGV…: true when scripts/leak-terms-check must read this call, and it then
# decides: a write (gh_shim_is_write), a first word that is not one of gh 2.98.0's own commands,
# which can be an option before the command or a gh alias of the user's that the check expands, or a
# command under which gh's config.yml may hold an alias (gh_shim_has_nested_alias). It may be wider
# than the check's own table, never narrower (shims/tests/test_gh_leak_terms.py); a read never
# starts the check.
gh_shim_may_send_text() {
    gh_shim_is_write "$@" && return 0
    case "${1:-}" in
        '' | --help | --version) return 1 ;;
        agent | agent-task | agent-tasks | agents | alias | api | at | attestation \
            | auth | browse | cache | codespace | completion | config | copilot | cs | discussion | ext \
            | extension | extensions | gist | gpg-key | help | issue | label | licenses | org | pr | preview \
            | project | release | repo | rs | ruleset | run | search | secret | skill | skills | ssh-key \
            | status | variable | version | workflow)
            gh_shim_has_nested_alias "$1"
            return
            ;;
    esac
    return 0
}
# gh_shim_has_nested_alias COMMAND: true when gh's config.yml (in gh's own config dir) may hold an
# alias under COMMAND, such as `gh alias set 'pr say' 'pr comment'`, which gh runs as what it
# expands to; the check then reads the call and decides. The alias's key starts an indented line of
# a block mapping, or follows the `{` or a `,` of the flow mapping gh writes once the last alias was
# deleted (`aliases: {pr say: pr comment}`). Until 2026-11-17 `gh pr say 11 --body …` was a read
# here, and its text went out unchecked; until review round 9 of dispatch://INFRA-3365 so was such
# a call under a flow alias. The check reads gh's aliases in each form gh 2.98.0 writes them (a block
# mapping, the flow mapping, each key form gh leaves unquoted, a key past 128 bytes after `? `, quoted
# values with their escapes, a `|` block scalar), and judges a call through one as the command it
# expands to. A config.yml gh does not write leaves a call that may run one of its aliases read
# whole, with one target read as public: its arguments, that alias's entry and the entry of each
# alias it runs, read loosely (a text that only looks like such a key in another alias's value is
# read too), and each file and stdin they name. A listed term in any of them is refused, and so is a
# file the check cannot read (a pipe, a device); a directory or a name that is no file is a word. A
# call with none goes out. A line that only looks like an alias starts the check, which finds no
# alias and lets the call go. A key under COMMAND past 128 bytes, which gh writes after `? `, is not
# found here, so a call through it goes to gh unread.
gh_shim_has_nested_alias() {
    local config="${GH_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/gh}/config.yml" text pattern
    [[ -r "$config" ]] || return 1
    text="$(< "$config")" || return 1
    pattern=$'((^|\n)[ \t]+|[{,][ \t\n]*)["\']?'"$1"$'[ \t][^:\n]*:'
    [[ "$text" =~ $pattern ]]
}
# The text of a call that reads stdin (`--input -`, `--body-file -`, `-F name=@-`, …) is read by the checks below
# before gh runs, and gh then gets the same bytes. gh_shim_buffer_stdin reads all of stdin (at most 64 MiB), once a
# call, into a private file (mktemp, mode 0600), opened once to write and then twice more through that descriptor
# (/dev/fd/N, so all three are the same file whatever its pathname names by then), and unlinked BEFORE any byte is
# written: no pathname holds the bytes, so no kill (SIGKILL included) leaves them on disk, and nothing can swap the
# file after a check. Each check reads that open file as /dev/fd/$_stdin_g, and gh_shim_stdin_to_gh gives gh the same
# file as its stdin once every check passed. A read or write error, or more than 64 MiB, refuses the call. Measured
# 2026-11-01 21-23Z: 122 agent calls piped their text.
_stdin_g=""
_stdin_h=""
gh_shim_buffer_stdin() {
    [[ -z "$_stdin_g" ]] || return 0
    local max=$((64 * 1024 * 1024)) buffer size
    buffer="$(mktemp "${TMPDIR:-/tmp}/gh-shim-stdin.XXXXXX")" || {
        echo "gh shim: refusing: cannot make a private file to hold stdin for the leak check" >&2
        exit 1
    }
    if ! exec {_stdin_w}> "$buffer" || ! exec {_stdin_g}< "/dev/fd/$_stdin_w" {_stdin_h}< "/dev/fd/$_stdin_w"; then
        rm -f "$buffer"
        echo "gh shim: refusing: cannot open the private file that holds stdin for the leak check" >&2
        exit 1
    fi
    rm -f "$buffer" || {
        echo "gh shim: refusing: cannot unlink the private file that holds stdin for the leak check" >&2
        exit 1
    }
    head -c "$((max + 1))" >&"$_stdin_w" || {
        echo "gh shim: refusing: cannot read stdin into a file for the leak check" >&2
        exit 1
    }
    exec {_stdin_w}>&-
    size="$(stat -L -c %s "/dev/fd/$_stdin_g")" || exit 1
    if ((size > max)); then
        echo "gh shim: refusing: stdin is over 64 MiB, more than the leak check reads; pass the text in a file" >&2
        exit 1
    fi
}
# gh_shim_stdin_to_gh: when stdin was buffered, gh gets the buffer as its stdin and the checks' descriptors close.
gh_shim_stdin_to_gh() {
    [[ -n "$_stdin_g" ]] || return 0
    exec 0<&"$_stdin_h" {_stdin_g}<&- {_stdin_h}<&-
    _stdin_g=""
    _stdin_h=""
}
if agent_context; then
    # The dotfiles checkout this file is in, through a link to it, not the one under HOME: a
    # caller may give gh a HOME of its own (shims/AGENTS.md, "A moved HOME").
    _gh_src="${BASH_SOURCE[0]}"
    [[ ! -L "$_gh_src" ]] || _gh_src="$(command -p readlink -f -- "$_gh_src")"
    case "$_gh_src" in
        */shims/*) _dotfiles="${_gh_src%/shims/*}" ;;
        *) _dotfiles="${_gh_src%/*}/.." ;;
    esac
    _dotfiles="${DOTFILES_DIR:-$_dotfiles}"
    _routed=0
    for ((_i = 0; _i < ${GIT_CONFIG_COUNT:-0}; _i++)); do
        _v="GIT_CONFIG_VALUE_$_i"
        [[ "${!_v:-}" == *gh-app-routes.gitconfig ]] && _routed=1
    done
    if ((!_routed)); then
        _i="${GIT_CONFIG_COUNT:-0}"
        export "GIT_CONFIG_KEY_${_i}=include.path" "GIT_CONFIG_VALUE_${_i}=${_dotfiles}/gh-app-routes.gitconfig" GIT_CONFIG_COUNT="$((_i + 1))"
    fi
    _agent_cfg="${XDG_CONFIG_HOME:-$HOME/.config}/gh-agent"
    [[ -f "$_agent_cfg/hosts.yml" && -e "$_agent_cfg/config.yml" ]] || _agent_cfg="$("$_dotfiles/scripts/gh-agent-config")"
    export GH_CONFIG_DIR="$_agent_cfg"
    # Every `gh auth` verb except status is about the user's own login; none
    # belongs to an agent, and status goes to gh, which names the agent directory's
    # placeholder login. (Without the agent directory's placeholder hosts.yml,
    # `gh auth token` and `gh auth git-credential` read the user's token from
    # the OS keyring: measured, a gho_ token with hosts.yml absent.)
    # git-credential is what ~/.gitconfig names as the user's helper for
    # github.com, so a git process whose environment lost the routing include
    # (omp's eval kernel) lands here: answer with the App helper on the same
    # request. It mints for an owner the App covers, answers the profile's
    # fallback secret (the user's upstream token) for one it does not, and
    # stops git with its own quit=1 when it can do neither.
    if [[ "${1:-}" == auth && "${2:-}" != status ]]; then
        if [[ "${2:-}" == git-credential ]]; then
            # --for-write: this is git asking to authenticate, and git asks for a credential on
            # a push, not on a fetch or clone of a public repository. gh-app-token then refuses
            # the personal fallback rather than letting this push act as the account owner.
            # Nothing else passes the flag: knives mints for every routed gh call through the
            # same `get` interface, so flagging that would refuse ordinary reads.
            # THIS CLOSES ONE ROUTE, NOT THE CLASS. An agent whose environment carries the
            # gh-app-routes include reaches gh-app-token directly (`helper = !gh-app-token
            # agent`) and never passes here, so its push is not refused; and a raw mint hands
            # over a usable token in any case. The durable fix is a fallback secret that cannot
            # write, which dispatch://INFRA-2031 asks for.
            [[ "${3:-}" == get ]] && exec gh-app-token agent get --for-write
            exit 0
        fi
        {
            echo "gh shim: REFUSED: \`$(gh_shim_quote "$@")\`"
            echo "  Why: gh auth ${2:-} reads or changes the user's own GitHub login (gh's hosts.yml and keyring). A call that acts as that login is Sami's own signature on GitHub; no agent process may use it."
            echo "  Instead: run the call itself (gh pr …, gh api repos/<owner>/<repo>/…) with -R <owner>/<repo>: it is routed to the GitHub App for that owner, or to the upstream token for an owner the App is not installed on. Do not look for another credential."
        } >&2
        exit 1
    fi
    # Public repository text: refuse an internal reference before gh posts it.
    # A call that reads text from stdin (`--input -`, `--body-file -`, `-F name=@-`, …) makes the check exit 4: it
    # cannot read those bytes without taking them from gh. The shim then buffers stdin (gh_shim_buffer_stdin) and runs
    # the check again on the buffer; which forms read stdin is the check's decision (gh-guard), not a list kept here.
    # PUBLIC_LEAK_CHECK_STDIN_BUFFERS tells it this caller buffers, so its exit 4 prints nothing.
    # PUBLIC_LEAK_CHECK_STDIN is this block's alone: a value the caller set made gh send stdin the check never read
    # (re-check, 2026-11-02), so it is cleared first.
    unset PUBLIC_LEAK_CHECK_STDIN
    _gate_rc=0
    PUBLIC_LEAK_CHECK_STDIN_BUFFERS=1 "$_dotfiles/scripts/public-text-gate" "$@" || _gate_rc=$?
    if ((_gate_rc == 4)); then
        gh_shim_buffer_stdin
        PUBLIC_LEAK_CHECK_STDIN="/dev/fd/$_stdin_g" "$_dotfiles/scripts/public-text-gate" "$@" || exit 1
    elif ((_gate_rc != 0)); then
        exit 1
    fi
fi

# Outside an agent session, git's `gh auth git-credential` (the user's helper in ~/.gitconfig)
# goes to the user's own login, except on a machine that holds no person's GitHub login
# (sami-devbox, dispatch://INFRA-993), where nothing would answer it and every private clone
# from an ssh shell failed with "could not read Username". Such a machine names a gh-app
# profile in its own git config file, ~/.config/git/config (`gh-app.host-profile`, written by
# installers/gh-app-host.sh), and the request goes to the App helper exactly as an agent's does
# above. Only that file counts: not the shared ~/.gitconfig, not a repository's config, and not
# `git config --global`, which git 2.43 answers from ~/.gitconfig alone when that file exists.
if [[ "${1:-}" == auth && "${2:-}" == git-credential ]] &&
    _host_profile="$(git config --file "${XDG_CONFIG_HOME:-$HOME/.config}/git/config" --get gh-app.host-profile 2> /dev/null)" &&
    [[ -n "$_host_profile" ]]; then
    [[ "${3:-}" == get ]] && exec gh-app-token "$_host_profile" get
    exit 0
fi

# The same machine's other gh calls from a host shell (an ssh command, a user unit, a pre-push hook)
# had no token at all: no person's login exists there, and the App routing above is an agent
# session's. installers/agent-spend.sh's `gh api` fetch failed, and a hooked push was refused because
# the leak check could not read the repository's visibility (2026-11-04). So outside an agent session,
# when the caller gives no GH_TOKEN or GITHUB_TOKEN, the call gets an installation token of the same
# profile for its target owner, minted through the broker's machine login, as the git helper above
# does. The owner comes from -R/--repo, GH_REPO, a `repos/OWNER/…` path of `gh api`, or this
# directory's origin remote, else theorem-labs. Only an App installation token (ghs_) is used: for an
# owner the App does not cover, gh-app-token answers the profile's personal fallback token, which is
# refused here, and the call goes on with no token. `gh auth` verbs are left to the real gh.
# GH_APP_TOKEN_MIN_LIFETIME: gh reads its token once per call; a cached token with under 30 minutes
# left is replaced by a fresh one (`gh run watch` failed 401 on a 12-minute token, 2026-10-22).
if [[ -z "${GH_TOKEN:-}${GITHUB_TOKEN:-}" && "${1:-}" != auth ]] && ! agent_context &&
    _host_profile="$(git config --file "${XDG_CONFIG_HOME:-$HOME/.config}/git/config" --get gh-app.host-profile 2> /dev/null)" &&
    [[ -n "$_host_profile" ]]; then
    gh_shim_target_owner "$@"
    if _host_token="$(GH_APP_TOKEN_MIN_LIFETIME="${GH_APP_TOKEN_MIN_LIFETIME:-1800}" gh-app-token "$_host_profile" --owner "$_owner" 2> /dev/null)" &&
        [[ "$_host_token" == ghs_* ]]; then
        export GH_TOKEN="$_host_token"
    else
        echo "gh shim: no GitHub App installation token for owner $_owner (profile $_host_profile); gh runs with no token" >&2
    fi
    unset _host_token
fi

# Listed leak terms (leak-terms.sops.yaml) in the text a gh call sends, for every caller, as for a commit or a push:
# on 2026-11-17 an agent's `gh pr edit` put a listed term into a public pull request's body, where GitHub keeps it in
# the body's edit history (dispatch://INFRA-4102). A call that can carry text (gh_shim_may_send_text) goes to
# `scripts/leak-terms-check gh` before gh runs (for an agent, after the public text gate), on exactly the arguments
# gh then gets. The check reads every text the call sends, files and stdin included, and
# refuses one that holds a listed term when the call can reach anything not confirmed private, a visibility it cannot
# read counting as public; a text it cannot read, or a list it cannot decrypt, is refused the same way. A refused call
# exits 2, and gh never runs. When the check needs stdin (its exit 7), it gets the buffer the public text gate shares.
# DOTFILES_LEAK_TERMS_GH_STDIN is this block's alone, for the reason PUBLIC_LEAK_CHECK_STDIN is the gate's.
unset DOTFILES_LEAK_TERMS_GH_STDIN
if gh_shim_may_send_text "$@"; then
    # The check of this shim's own checkout, found through a link to the shim as the agent block finds it.
    _term_check="${BASH_SOURCE[0]}"
    [[ ! -L "$_term_check" ]] || _term_check="$(command -p readlink -f -- "$_term_check")"
    _term_check="${_term_check%/*}/../scripts/leak-terms-check"
    _term_rc=0
    if [[ -n "$_stdin_g" ]]; then
        DOTFILES_LEAK_TERMS_GH_STDIN="/dev/fd/$_stdin_g" "$_term_check" gh -- "$@" || _term_rc=$?
    else
        "$_term_check" gh -- "$@" || _term_rc=$?
        if ((_term_rc == 7)); then
            gh_shim_buffer_stdin
            _term_rc=0
            DOTFILES_LEAK_TERMS_GH_STDIN="/dev/fd/$_stdin_g" "$_term_check" gh -- "$@" || _term_rc=$?
        fi
    fi
    if ((_term_rc != 0)); then
        ((_term_rc < 126)) || echo "gh shim: refusing: the leak-term check $_term_check could not run (exit $_term_rc)" >&2
        exit 2
    fi
fi
gh_shim_stdin_to_gh

# mise_paths: mise as this machine runs it, whatever HOME and PATH the caller set
# (shims/AGENTS.md, "A moved HOME"). A Legion test pane runs a shim with a
# temporary HOME and the PATH <bin>:/usr/local/bin:/usr/bin:/bin, where every
# path under HOME names nothing. Sets, once per process:
#   _mise_bin     mise on PATH, else the dotfiles checkout's bin/mise, else the
#                 mise the shims in a data dir link to (a copy or a worktree of
#                 the checkout has no bin/, which is not committed)
#   _mise_config  mise's global configuration: MISE_GLOBAL_CONFIG_FILE, else the
#                 file under HOME when it is readable, else the checkout's
#                 mise.toml, which installers link that file to
#   _mise_datas   the data dirs a tool may be installed in: MISE_DATA_DIR and mise's
#                 default ~/.local/share/mise under HOME; with no MISE_DATA_DIR,
#                 ~/.mise (.bashrc's) and that default, under HOME, then the passwd home's
#   _mise_data    the one to give mise: MISE_DATA_DIR, else the first that exists
# The checkout is DOTFILES_DIR, else the one this file's own path is in.
mise_paths() {
    local IFS=$' \t\n'
    local self dotfiles home dir data seen=""
    local -a all=()
    [[ -z "${_mise_config:-}" ]] || return 0
    _mise_bin=""
    IFS=':'
    for dir in ${PATH:-}; do
        if [[ -n "$dir" && -f "$dir/mise" && -x "$dir/mise" ]]; then
            _mise_bin="$dir/mise"
            break
        fi
    done
    IFS=$' \t\n'
    _mise_config="${MISE_GLOBAL_CONFIG_FILE:-${XDG_CONFIG_HOME:-${HOME:-}/.config}/mise/config.toml}"
    if [[ -z "$_mise_bin" || ( -z "${MISE_GLOBAL_CONFIG_FILE:-}" && ! -r "$_mise_config" ) ]]; then
        dotfiles="${DOTFILES_DIR:-}"
        if [[ -z "$dotfiles" ]]; then
            self="$(command -p readlink -f -- "${BASH_SOURCE[0]}")" || self=""
            dotfiles="${self%/shims/*}"
        fi
        [[ -n "$_mise_bin" ]] || _mise_bin="$dotfiles/bin/mise"
        [[ -n "${MISE_GLOBAL_CONFIG_FILE:-}" || -r "$_mise_config" ]] || _mise_config="$dotfiles/mise.toml"
    fi
    if [[ -n "${MISE_DATA_DIR:-}" ]]; then
        all=("$MISE_DATA_DIR" "${XDG_DATA_HOME:-${HOME:-}/.local/share}/mise")
    else
        all=("${HOME:-}/.mise" "${XDG_DATA_HOME:-${HOME:-}/.local/share}/mise")
        # With HOME unset, ~ is the uid's home in the passwd database, which HOME does not move.
        local HOME
        unset HOME
        home=~
        [[ "$home" != /?* ]] || all+=("$home/.mise" "$home/.local/share/mise")
    fi
    _mise_datas=() _mise_data="${MISE_DATA_DIR:-}"
    for data in "${all[@]}"; do
        [[ "$data" == /?* && ":$seen:" != *":$data:"* ]] || continue
        seen+=":$data"
        _mise_datas+=("$data")
        [[ -n "$_mise_data" || ! -d "$data" ]] || _mise_data="$data"
    done
    if [[ ! -f "$_mise_bin" || ! -x "$_mise_bin" ]]; then
        for data in ${_mise_datas[@]+"${_mise_datas[@]}"}; do
            for dir in "$data"/shims/*; do
                [[ -L "$dir" ]] || continue
                dir="$(command -p readlink -f -- "$dir")" || dir=""
                [[ "$dir" != */mise || ! -f "$dir" || ! -x "$dir" ]] || _mise_bin="$dir"
                break
            done
            [[ ! -x "$_mise_bin" ]] || break
        done
    fi
    : "${_mise_data:=${_mise_datas[0]:-}}"
}

# is_mise_shim FILE: whether FILE is mise's own shim, a file in the shims dir of
# one of mise's data dirs or a link to mise. It reaches its tool only where mise
# reads its config and trust list under HOME, which a moved HOME hides.
is_mise_shim() {
    local IFS=$' \t\n'
    local data
    mise_paths
    for data in ${_mise_datas[@]+"${_mise_datas[@]}"}; do
        [[ "${1%/*}" -ef "$data/shims" ]] && return 0
    done
    [[ -L "$1" && "$(command -p readlink -f -- "$1")" == */mise ]]
}

# mise_pinned BIN TOOL: sets _pinned to BIN in the install of TOOL at the exact
# version mise's global configuration pins (a [tools] line), from mise's data
# dirs, whatever HOME and PATH the caller set (mise_paths). Without one, _pinned
# is empty and _pinned_searched says what was read, for the caller's refusal.
mise_pinned() {
    local bin="$1" tool="$2"
    local IFS=$' \t\n'
    local line section="" pin="" key data candidate searched=""
    local section_re='^[[:space:]]*\[([^]]*)\]'
    local pin_re='^[[:space:]]*"?([^"=[:space:]]+)"?[[:space:]]*=[[:space:]]*"([0-9][0-9A-Za-z.+-]*)"'
    _pinned="" _pinned_searched=""
    mise_paths
    if [[ -r "$_mise_config" ]]; then
        while IFS= read -r line || [[ -n "$line" ]]; do
            if [[ "$line" =~ $section_re ]]; then
                section="${BASH_REMATCH[1]}"
            elif [[ "$section" == tools && "$line" =~ $pin_re && "${BASH_REMATCH[1]}" == "$tool" ]]; then
                pin="${BASH_REMATCH[2]}"
                break
            fi
        done < "$_mise_config"
    fi
    if [[ -z "$pin" ]]; then
        _pinned_searched="no exact version of $tool pinned in $_mise_config"
        return 1
    fi
    key="${tool//[:\/]/-}"
    key="${key//@/}"
    for data in ${_mise_datas[@]+"${_mise_datas[@]}"}; do
        for candidate in "$data/installs/$key/$pin/$bin" "$data/installs/$key/$pin/bin/$bin" "$data/installs/$key/$pin"/*/bin/"$bin"; do
            if [[ -f "$candidate" && -x "$candidate" ]]; then
                _pinned="$candidate"
                return 0
            fi
        done
        searched+="${searched:+, }$data/installs/$key/$pin"
    done
    _pinned_searched="$tool $pin, pinned in $_mise_config, is installed in none of $searched (\`mise install\` installs it)"
    return 1
}

# A gh this shim hands the call to can hand it straight back. mise's shim does, in the same pid,
# when mise has no gh version for the directory; a wrapper does when it runs this shim as its own
# real gh. On 2026-11-18 a test of cybermonklabs/legion put a pane's `gh` wrapper (`exec
# legion.test gh "$@"`) first on PATH and gave `legion gh` this shim, by its path, as the real gh,
# which `legion gh` starts as a child: the shim took the wrapper for the real gh, and the chain of
# wrapper, `legion gh` and shim grew about 2,000 processes deep (4,275 processes) until the user's
# memory limit stopped it and two sessions' workers died. DOTFILES_GH_SHIM ("<pid> <hops> <call>
# <gh>:<gh>…") names every gh this shim has handed the call to, the pid that handed it, how many
# hand-offs to a gh the chain of processes above it has made, and the call (gh_shim_call_digest),
# `-` where the only gh it names is the pinned install, which is gh itself and hands nothing back,
# or where no digest could be made. A pass in that pid, or one below it given the same call, is
# that call coming back: the lookup skips each gh named (and every path to the same file), taking
# the next one, then the pinned install, or failing with exit 127 and one line naming PATH, instead
# of looping. Any other call below the real gh (the git credential helper gh runs, knives' own
# queries) is another call, and the marker skips nothing for it.
# The hop count is the guard where that skip cannot see the call: with no sha256sum on PATH there
# is no digest, and a wrapper that changes the argv on each pass makes a new call each time. Bash
# keeps the count itself, so it holds whatever tool is missing: the hand-off past _max_hops is
# refused with exit 127 and one line. The deepest chain that is no loop has about four (knives'
# hand-off, its own gh query, the git credential helper the real gh runs, a hook's gh); 8 leaves
# room for that and stops a loop at nine wrapper passes.
_max_hops=8
_handed="" _call=""
read -r _marker_pid _marker_hops _marker_call _marker_handed <<< "${DOTFILES_GH_SHIM:-}"
[[ "$_marker_hops" =~ ^[0-9]{1,4}$ ]] && _marker_hops=$((10#$_marker_hops)) || _marker_hops=0
if ((_marker_hops >= _max_hops)); then
    echo "gh shim: refusing: this chain of processes already handed a call to a gh $_marker_hops times through this shim (DOTFILES_GH_SHIM, at most $_max_hops), so a gh on PATH ($PATH) keeps handing calls back to it${_marker_handed:+; the last pass handed one to ${_marker_handed//:/, }}" >&2
    exit 127
fi
if [[ "$_marker_pid" == "$$" ]]; then
    _handed="$_marker_handed"
elif [[ -n "$_marker_call" && "$_marker_call" != - ]]; then
    gh_shim_call_digest "$@"
    _call="$_digest"
    [[ "$_call" != "$_marker_call" ]] || _handed="$_marker_handed"
fi
# handed_back GH: whether GH, or any path to the same file, is a gh this call was handed to.
handed_back() {
    local IFS=':'
    local gh
    for gh in $_handed; do
        [[ -n "$gh" && "$1" -ef "$gh" ]] && return 0
    done
    return 1
}

# real_gh: sets _real to the gh this shim hands the call to, and _real_pinned when that is the
# pinned install: the first gh past this shim's own PATH entry (the first entry whose gh is this
# file, through a link too), or, when the shim was run by a path outside PATH, the first from the
# top. A gh above the shim's entry is never taken: one there can be a wrapper that runs this shim
# again (above). Content decides what is a copy of this shim, never the path: any candidate
# carrying the knives-gh-shim marker in its first 512 bytes is a shim. The old dir-string skip
# broke whenever HOME or DOTFILES_DIR spelled this shim's directory differently from PATH, and
# knives gh re-entered this shim in an unbounded fork chain (2026-08-27, ~300k processes). A gh
# that handed the call back is skipped too. A variable, not output, so no subshell is forked.
# mise's own shim gives way to the gh pinned exactly in mise's global config,
# straight from its install dir, as shims/knives runs knives: mise's shim is
# mise itself, which reads its config, then execs that gh, one more process on
# every call (0.15 s p50, 0.51 s p90 over 20 calls at load ~290 on 2026-11-03),
# and under load mise hung for minutes (2026-11-03 ~00:3x-01:00Z, shims/knives).
# With no exact pin, or no install of it, _real stays mise's shim. Past PATH,
# the pinned install.
real_gh() {
    local IFS=':'
    local pass dir candidate header own=""
    _real="" _real_pinned=""
    for pass in past-own-entry from-top; do
        for dir in $PATH; do
            candidate="$dir/gh"
            if [[ "$pass" == past-own-entry && -z "$own" ]]; then
                [[ "$candidate" -ef "${BASH_SOURCE[0]}" ]] && own=1
                continue
            fi
            [[ -f "$candidate" && -x "$candidate" ]] || continue
            # Pure bash on purpose: this must work on a PATH too broken to find
            # head or grep. read stops at the first NUL, so an ELF gh yields a
            # short marker-free header and is accepted.
            header=""
            IFS= read -r -n 512 -d '' header < "$candidate" || true
            [[ "$header" == *knives-gh-shim* ]] && continue
            handed_back "$candidate" && continue
            _real="$candidate"
            if is_mise_shim "$candidate" && mise_pinned gh gh && ! handed_back "$_pinned"; then
                _real="$_pinned" _real_pinned=1
            fi
            return 0
        done
        [[ -z "$own" ]] || break
    done
    mise_pinned gh gh && ! handed_back "$_pinned" && _real="$_pinned" _real_pinned=1
}

# Resolve the real gh FIRST and refuse to proceed without it (a bare `gh`
# fallback would re-enter this shim and recurse), and honor the bypass before
# involving knives at all.
if ! real_gh; then
    echo "gh shim: no real gh found on PATH ($PATH), and ${_pinned_searched:-the pinned install handed the call back}${_handed:+; ${_handed//:/, } handed the call back to this shim}" >&2
    exit 127
fi
_handed="${_handed:+$_handed:}$_real"
if [[ -z "$_call" && ( -z "$_real_pinned" || "$_handed" != "$_real" ) ]]; then
    gh_shim_call_digest "$@"
    _call="$_digest"
fi
export DOTFILES_GH_SHIM="$$ $((_marker_hops + 1)) ${_call:--} $_handed"
if [[ -z "${KNIVES_GH_BYPASS:-}" ]] && command -v knives > /dev/null 2>&1; then
    # Backstop: a resolution bug must fail loudly here, never fork-bomb the
    # machine. Legit flows re-enter this shim at most twice (knives runs bare
    # `gh` for forge queries); depth 3 is a loop.
    _depth="${KNIVES_GH_SHIM_DEPTH:-0}"
    [[ "$_depth" =~ ^[0-9]+$ ]] || _depth=0
    if ((_depth >= 3)); then
        echo "gh shim: re-entered $_depth times — knives gh is looping through this shim" >&2
        echo "gh shim: refusing to recurse; KNIVES_GH_BYPASS=1 runs $_real directly" >&2
        exit 70
    fi
    KNIVES_GH_SHIM_DEPTH=$((_depth + 1)) KNIVES_REAL_GH="$_real" exec knives gh -- "$@"
fi
exec "$_real" "$@"
