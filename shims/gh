#!/bin/bash
# knives-gh-shim: thin dispatcher. The brain lives in `knives gh`.
# Docs: knives repo, docs/superpowers/specs/2026-08-05-release-correctness-and-knives-gh-design.md
# KNIVES_GH_BYPASS=1 skips knives entirely (emergency hatch if knives gh misbehaves).
set -euo pipefail

# Every agent session on this machine reaches GitHub through one App
# installation, so they share one primary rate limit; it reached zero four
# times on 2026-11-01 and every session that reads GitHub stopped
# (dispatch://BET-303). This records one line per OUTERMOST gh call, so the
# spend can be attributed to a caller and a command. knives re-enters this
# shim for its own forge queries, and the read cache re-enters it on a miss:
# both carry a marker, and a marked call is the same call again, not a new
# one. Every step is best-effort; nothing here may fail a gh call.
# _gh_cache_root: sets _gh_root, the cache's root directory. A variable, not
# output: `$(...)` forks a subshell, and on 2026-11-03 at load ~290 every
# process this shim started cost tens to hundreds of milliseconds.
_gh_cache_root() {
    if [[ -n "${GH_READ_CACHE_DIR:-}" ]]; then
        _gh_root="$GH_READ_CACHE_DIR"
        return
    fi
    local u="${USER:-$(id -un 2> /dev/null || true)}"
    if [[ -n "$u" && -d "/mnt/nvme/$u" ]]; then
        _gh_root="/mnt/nvme/$u/gh-read-cache"
    else
        _gh_root="${XDG_CACHE_HOME:-$HOME/.cache}/gh-read-cache"
    fi
}
# _gh_call_log EV ARGV…: one line with event EV ("call", "unrouted-refused") for this call.
_gh_call_log() {
    local ev="$1" dir a s out='' hour
    shift
    _gh_cache_root
    dir="$_gh_root/log"
    if [[ ! -d "$dir" ]]; then
        mkdir -p "$dir" 2> /dev/null || return 0
        chmod 700 "$_gh_root" "$dir" 2> /dev/null || true
    fi
    for a in "$@"; do
        s=${a//\\/\\\\}
        s=${s//\"/\\\"}
        s=${s//$'\n'/\\n}
        s=${s//$'\r'/\\r}
        s=${s//$'\t'/\\t}
        out+=",\"$s\""
    done
    local now="${EPOCHREALTIME:-}"
    now="${now/,/.}"
    [[ -n "$now" ]] || now="$(date -u +%s)"
    TZ=UTC0 printf -v hour '%(%Y%m%d%H)T' -1
    printf '{"t":%s,"pid":%s,"sid":"%s","cwd":"%s","ev":"%s","argv":[%s]}\n' \
        "$now" "$$" "${OMP_SESSION_ID:-}" "${PWD//\"/}" "$ev" "${out:1}" \
        >> "$dir/$hour.jsonl" 2> /dev/null || true
}
if [[ -z "${KNIVES_GH_SHIM_DEPTH:-}" && -z "${GH_READ_CACHE_BYPASS:-}" && -z "${GH_SHIM_INNER:-}" && "${GH_READ_CACHE_LOG:-}" != 0 ]]; then
    _gh_call_log call "$@" || true
fi

# Agent context: an omp session (its bash tool carries OMP_SESSION_ID, its
# eval kernel PI_SESSION_FILE with an allow-listed environment that drops
# GIT_CONFIG_*), an agentbox session, or anything launched with the gh-app
# routing include (shims/omp, scripts/cld). Three guarantees there:
# the routing include is present even when the caller's environment was
# scrubbed; gh sees the agent config directory of scripts/gh-agent-config,
# whose placeholder login stands where the user's would be, so a call with no
# target owner to route fails on GitHub's 401 and never reaches the user's own
# login in hosts.yml or the keyring (an owner the App does not cover gets the
# upstream token from the secrets store); and a call GitHub refuses for the
# App ends with a refusal that names the call and the route to take instead.
# On 2026-09-14 an agent's `gh api -X POST …/reviews` from omp's eval kernel in
# /tmp ran on the user's keyring and approved a pull request as him. On
# 2026-11-02T00:07Z a Python eval kernel's `gh pr review --approve` did it
# again without reaching this shim at all: mise's python3 shim had put mise's
# own gh ahead of this directory on the kernel's PATH. mise.toml's `_.path`
# now puts this directory first in every mise-run process, and
# scripts/agent-session and omp/extensions/session-env.ts export the agent
# GH_CONFIG_DIR, so a gh that still runs past this shim finds no user login.
agent_context() {
    [[ -n "${OMP_SESSION_ID:-}${PI_SESSION_FILE:-}${PI_TOOL_BRIDGE_URL:-}${AGENTBOX_SESSION:-}" ]] && return 0
    local i v
    for ((i = 0; i < ${GIT_CONFIG_COUNT:-0}; i++)); do
        v="GIT_CONFIG_VALUE_$i"
        [[ "${!v:-}" == *gh-app-routes.gitconfig ]] && return 0
    done
    return 1
}

# A refusal names the exact call, the identity it would have acted as, why it
# is refused and what to do instead, and exits non-zero. A silent or vague
# refusal reads as "no approval exists" and sends the next agent looking for
# another credential (the chief of staff's requirement, 2026-11-02).
gh_shim_user_login() {
    local line user=""
    while IFS= read -r line; do
        [[ "$line" =~ ^\ {4}user:\ *([^[:space:]]+) ]] && { user="${BASH_REMATCH[1]}"; break; }
    done < "${XDG_CONFIG_HOME:-$HOME/.config}/gh/hosts.yml" 2> /dev/null || true
    if [[ -n "$user" ]]; then
        printf "the user login \`%s\` from gh's hosts.yml and keyring" "$user"
    else
        printf "the user's own GitHub login from gh's hosts.yml and keyring"
    fi
}
gh_shim_quote() {
    local out="gh" a
    for a in "$@"; do out+=" $(printf '%q' "$a")"; done
    printf '%s' "$out"
}
# gh_shim_refuse WHY INSTEAD ARGV…: the shim itself refuses, before gh runs.
gh_shim_refuse() {
    local why="$1" instead="$2"
    shift 2
    {
        echo "gh shim: REFUSED: \`$(gh_shim_quote "$@")\`"
        echo "  Identity: it would have used $(gh_shim_user_login)."
        echo "  Why: $why A call that acts as that login is Sami's own signature on GitHub; no agent process may use it."
        echo "  Instead: $instead"
    } >&2
    exit 1
}
# What GitHub answers when the identity a call ran as may not make it: a review
# of the App's own pull request, a permission or repository the installation or
# token lacks, a token GitHub rejects.
GH_SHIM_REFUSED_BY_GITHUB='Can not (approve|request changes on) your own pull request|Resource not accessible by|HTTP 40[13]|Bad credentials|must have (admin|push|write|maintain)|not have permission|Permission to [^ ]+ denied|requires authentication'
# gh_shim_refused_by_github RC ERRFILE ARGV…: GitHub refused the call for the
# identity it ran as, which is read from the call's environment and stderr, not
# assumed. On 2026-11-02 a call carrying a broker token in GH_TOKEN (so knives
# did not route it) was refused on google/oss-fuzz, and this block said it ran
# as the App and that the user's login is never used by an agent, while the
# token was the user's own and the routed call would have run as him too.
gh_shim_refused_by_github() {
    local rc="$1" err="$2" pr="" repo="" verdict="APPROVE" a prev="" instead who token admin=""
    shift 2
    if [[ "${1:-}" == pr && "${2:-}" == review ]]; then
        for a in "${@:3}"; do
            case "$prev" in
                -R | --repo) repo="$a" ;;
                -b | --body | -F | --body-file) ;;
                *)
                    case "$a" in
                        --repo=*) repo="${a#--repo=}" ;;
                        -r | --request-changes) verdict="REQUEST_CHANGES" ;;
                        -*) ;;
                        *) [[ -n "$pr" ]] || pr="$a" ;;
                    esac
                    ;;
            esac
            prev="$a"
        done
    elif [[ "${1:-}" == api ]]; then
        for a in "${@:2}"; do
            if [[ "$a" =~ ^/?repos/([^/]+/[^/]+)/pulls/([0-9]+)/reviews ]]; then
                repo="${BASH_REMATCH[1]}" pr="${BASH_REMATCH[2]}"
            fi
            [[ "$a" == *REQUEST_CHANGES* ]] && verdict="REQUEST_CHANGES"
        done
    fi
    token="$(sed -nE 's/.*using the personal token ([^ ]+) .*/\1/p' "$err" | head -n 1)"
    if [[ -n "${GH_TOKEN:-}" ]]; then
        who="the token in GH_TOKEN, inherited from the environment (${GH_TOKEN:0:4}…), so as that token's own GitHub user; nothing routed the call, and a broker token reaches only the repositories it was made for (GITHUB_ADMIN_PAT: theorem-labs)"
    elif [[ -n "$token" ]]; then
        who="the personal token $token, so as its GitHub user, not as an App: the repository's owner has no App installation"
    else
        who="the GitHub App this repository's owner routes agent calls to"
    fi
    if [[ -z "${GH_TOKEN:-}" && -z "$token" ]]; then
        # The App was refused. Sami said five times (2026-10-25 to 2026-11-03) that an agent does a
        # GitHub admin action itself with his admin token and never asks him to; this block used to
        # send every such refusal to the lead, who asked him. A review (a CODEOWNERS approval in his
        # name) and a post (the App lacking the issues permission) can be one too, so every branch
        # below carries it.
        admin="If this is a GitHub admin action that work Sami already asked for needs (an App permission or installation, a CODEOWNERS approval in his name, an admin merge, a repository or branch setting), do it yourself with his admin token from the credential broker; never ask Sami to do it (dispatch://OSSV-300/ask/dc4e1c38-bd15-4999-9ef5-4c6540a2ce9a). For a theorem-labs repository run \`secret-run --register --reason '<what and why>' GITHUB_ADMIN_PAT -- sh -c 'GH_TOKEN=\$GITHUB_ADMIN_PAT exec gh \"\$@\"' $(gh_shim_quote "$@")\`; for a repository of sjawhar's own, the same with GITHUB_PERSONAL_ADMIN_PAT in both places. The broker puts the token in the variable of its own name, which gh does not read, so the sh -c line gives it to gh as GH_TOKEN. Sami approves the grant once per session from the broker's card in Dispatch; that card is not an ask. \`--register\` makes the route work in a session that has no broker identity (one launched past shims/omp, so it never registered): it registers this one command as a broker session of its own, and in a session that has one it changes nothing. Without it such a session reads secretsd, which does not hold this key, and gets \"not found\"."
    fi
    if [[ -n "$pr" ]]; then
        instead="if the repository needs an approving review to merge (a comment does not count there), post the review as the legion-reviewer App: \`~/.dotfiles/scripts/post-review $pr <full 40-character head sha> $verdict <body-file> ${repo:-<owner/repo>}\`. Use that route only when your session did not author the pull request. Where a comment is enough, post the verdict as a pull-request comment from the App: \`gh pr comment $pr${repo:+ -R $repo} --body-file <file>\`, the file's first line \`VERDICT: $verdict at <full 40-character head sha>\`. pr-gate reads issue comments as verdicts (dispatch://BET-9/ask/6b7de765).${admin:+ $admin}"
    elif [[ "${1:-} ${2:-}" == "issue create" || "${1:-} ${2:-}" == "issue comment" || "${1:-} ${2:-}" == "pr comment" ]]; then
        instead="if Sami instructed this post in a Dispatch ask he answered, run the same call again with GH_SHIM_APPROVAL=dispatch://<KEY>/ask/<id> in front of it and no GH_TOKEN. The shim then checks that he answered it with its approving option and that the title and body are the draft he was shown, and logs the post; an owner with no App installation gets his own upstream token, so the post goes out as him (shims/AGENTS.md).${admin:+ $admin} Otherwise stop, and tell your lead which call GitHub refused and its error above. Do not look for another credential, token or gh binary."
    elif [[ -n "$admin" ]]; then
        instead="$admin For any other owner, or a call that is not such an admin action, stop and tell your lead which call GitHub refused and its error above. Do not look for another credential, token or gh binary."
    else
        instead="stop, and tell your lead which call GitHub refused and its error above. Do not look for another credential, token or gh binary."
    fi
    {
        echo "gh shim: REFUSED by GitHub: \`$(gh_shim_quote "$@")\` (exit $rc; GitHub's error is above)."
        echo "  Identity: it ran as $who. Do not retry with a token or gh binary you found yourself: every other credential to use is named below. The legion-reviewer App, through scripts/post-review (below), is for a review verdict only."
        echo "  Why: GitHub does not let that identity make this call (an App cannot approve or request changes on a pull request it opened, and an App installation or a token cannot use a permission or a repository it was not given)."
        echo "  Instead: $instead"
    } >&2
    exit "$rc"
}
# What GitHub answers when a credential's request budget is spent: the primary
# limit ("API rate limit exceeded for user ID …", HTTP 403 or 429) or a
# secondary limit. The call is allowed; the budget is not there now. Read
# before the refusal pattern, which matches the same HTTP 403.
GH_SHIM_RATE_LIMITED='API rate limit (already )?exceeded|secondary rate limit|HTTP 429'
# gh_shim_rate_limited RC ERRFILE ARGV…: the credential's rate limit stopped the
# call. On 2026-11-02 the shared public-repo token's REST budget ran out and the
# refusal text told agents the App could not make the call and to stop.
gh_shim_rate_limited() {
    local rc="$1" err="$2" who token="" owner="" repo="" prev="" a want=core line name left limit reset when
    local -a limits=()
    shift 2
    token="$(sed -nE 's/.*using the personal token ([^ ]+) .*/\1/p' "$err" | head -n 1)"
    owner="$(sed -nE 's/.*\(owner=([^)]+)\).*/\1/p; s/.*no App installation for owner ([^ ;]+).*/\1/p' "$err" | head -n 1)"
    if [[ -n "$token" ]]; then
        who="the shared public-repo token $token${owner:+ (owner $owner has no App installation)}. It is a personal token, so every session on every machine that reads such an owner, and every other token of the same GitHub user, spends this one budget"
    else
        who="the GitHub App installation${owner:+ for owner $owner}, which every agent session shares"
    fi
    # Which budget the call spends: GitHub keeps one each for REST (core), GraphQL,
    # search and code search. A search call that hit its 30-a-minute limit was
    # reported against core, which had thousands left (2026-11-03).
    case "${1:-} ${2:-}" in
        'search code') want=code_search ;;
        search\ *) want=search ;;
    esac
    for a in "$@"; do
        case "$prev" in -R | --repo) repo="$a" ;; esac
        case "$a" in
            --repo=*) repo="${a#--repo=}" ;;
            graphql) [[ "${1:-}" == api ]] && want=graphql ;;
            search/code* | /search/code*) [[ "${1:-}" == api ]] && want=code_search ;;
            search/* | /search/*) [[ "${1:-}" == api ]] && want=search ;;
        esac
        [[ -z "$repo" && "$a" =~ ^/?repos/([^/]+/[^/?]+) ]] && repo="${BASH_REMATCH[1]}"
        prev="$a"
    done
    # The rate_limit endpoint costs nothing against any limit. It runs on the
    # same route as the call: the same repository when the call named one, else
    # the same directory and environment, from which the call itself was routed.
    while IFS= read -r line; do
        [[ -n "$line" ]] && limits+=("$line")
    done < <(
        if [[ -n "$repo" ]]; then export GH_REPO="$repo"; fi
        GH_SHIM_INNER=1 GH_READ_CACHE=0 GH_READ_CACHE_LOG=0 timeout 30 "$0" api rate_limit \
            --jq '.resources | to_entries[] | select(.key == "core" or .key == "graphql" or .key == "search" or .key == "code_search" or .value.remaining == 0) | "\(.key) \(.value.remaining) \(.value.limit) \(.value.reset)"' \
            2> /dev/null || true
    )
    {
        echo "gh shim: RATE LIMITED: \`$(gh_shim_quote "$@")\` (exit $rc; GitHub's error is above)."
        echo "  Identity: it ran as $who."
        if ((${#limits[@]} == 0)); then
            echo "  Limit: the reset time could not be read; \`gh api rate_limit\` from the same repository shows it and costs nothing."
        else
            for line in "${limits[@]}"; do
                read -r name left limit reset <<< "$line"
                [[ "$name" == "$want" || "$left" == 0 ]] || continue
                when="$(date -u -d "@$reset" +%H:%M:%SZ 2> /dev/null || echo "epoch $reset")"
                echo "  Limit: $name $left of $limit left; it resets at $when (in $(((reset - $(date +%s) + 59) / 60)) min)."
            done
        fi
        echo "  Why: this is not a refusal. The call is allowed and the credential is the right one; its request budget is spent for now (a secondary limit, when nothing above reads 0 left, clears within minutes)."
        echo "  Instead: retry after the reset. To read more cheaply, use one GraphQL query (\`gh api graphql\`), which has a budget of its own, in place of repeated REST calls, and poll no faster than once every few minutes. Do not look for another credential."
    } >&2
    exit "$rc"
}
if agent_context; then
    _dotfiles="${DOTFILES_DIR:-$HOME/.dotfiles}"
    _routed=0
    for ((_i = 0; _i < ${GIT_CONFIG_COUNT:-0}; _i++)); do
        _v="GIT_CONFIG_VALUE_$_i"
        [[ "${!_v:-}" == *gh-app-routes.gitconfig ]] && _routed=1
    done
    if ((!_routed)); then
        _i="${GIT_CONFIG_COUNT:-0}"
        export "GIT_CONFIG_KEY_${_i}=include.path" "GIT_CONFIG_VALUE_${_i}=${_dotfiles}/gh-app-routes.gitconfig" GIT_CONFIG_COUNT="$((_i + 1))"
    fi
    _agent_cfg="${XDG_CONFIG_HOME:-$HOME/.config}/gh-agent"
    [[ -f "$_agent_cfg/hosts.yml" && -e "$_agent_cfg/config.yml" ]] || _agent_cfg="$("$_dotfiles/scripts/gh-agent-config")"
    export GH_CONFIG_DIR="$_agent_cfg"
    # Here gh runs only with the token knives routed (scripts/gh-routed-only, as
    # KNIVES_REAL_GH below): a call that needs GitHub and got none could only get
    # the placeholder login's 401, so it is refused before it reaches GitHub, with
    # exit 4 and one line naming the fix. On 2026-11-03 a lane's 18 mutations from
    # a directory with no repository each got a 401 it never read (stderr dropped).
    _routed_only=1
    # `gh auth status` would describe the placeholder login of the agent config
    # directory, never the user's own, while routed calls work. Here it answers
    # for what an agent call uses instead: it names the routing and, inside a
    # GitHub repository, makes one routed read of it and exits on that.
    if [[ "${1:-}" == auth && "${2:-}" == status ]]; then
        echo "gh shim: agent session. gh calls are routed to the GitHub App for the target repo's owner (an owner without one gets the upstream token), minted per call; the user's own login is not used, so it is not reported."
        _remote="$(git remote get-url origin 2>/dev/null || true)"
        _slug=""
        case "$_remote" in
            *github.com[:/]*) _slug="${_remote#*github.com[:/]}"; _slug="${_slug%/}"; _slug="${_slug%.git}" ;;
        esac
        [[ "$_slug" =~ ^[^/]+/[^/]+$ ]] || _slug=""
        if [[ -z "$_slug" ]]; then
            echo "No GitHub repository in this directory to check. To check one, run a read against it, for example: gh api repos/<owner>/<repo> --jq .full_name"
            exit 0
        fi
        if _out="$("$0" api "repos/$_slug" --jq .full_name 2>&1)"; then
            echo "github.com/$_slug: routed access works"
            exit 0
        fi
        echo "github.com/$_slug: routed access FAILED: ${_out%%$'\n'*}"
        exit 1
    fi
    # Every `gh auth` verb except status is about the user's own login; none
    # belongs to an agent. (Without the agent directory's placeholder hosts.yml,
    # `gh auth token` and `gh auth git-credential` read the user's token from
    # the OS keyring: measured, a gho_ token with hosts.yml absent.)
    # git-credential is what ~/.gitconfig names as the user's helper for
    # github.com, so a git process whose environment lost the routing include
    # (omp's eval kernel) lands here: answer with the App helper on the same
    # request. It mints for an owner the App covers, answers the profile's
    # fallback secret (the user's upstream token) for one it does not, and
    # stops git with its own quit=1 when it can do neither.
    if [[ "${1:-}" == auth && "${2:-}" != status ]]; then
        if [[ "${2:-}" == git-credential ]]; then
            [[ "${3:-}" == get ]] && exec gh-app-token agent get
            exit 0
        fi
        gh_shim_refuse "gh auth ${2:-} reads or changes the user's own login, which no agent process may use or change." \
            "Every other gh call is already routed to the GitHub App for the repository's owner: run the call itself (gh pr …, gh api repos/<owner>/<repo>/…) with -R <owner>/<repo>, and it gets the App's token. If GitHub refuses that call, the shim's refusal names the route to take (for an admin action, Sami's admin token from the credential broker); do not look for another credential." \
            "$@"
    fi
    # A post Sami instructed goes out as him only on a citation: GH_SHIM_APPROVAL
    # names the Dispatch ask he answered, and scripts/gh-approved-post checks the
    # answer and that the title and body are the draft he was shown, and logs the
    # post beside the call log, before the call goes on its usual route (for an
    # owner without the App, his own upstream token). A citation that does not
    # hold refuses the call; a call without one is unchanged. On 2026-11-02 he
    # answered "Post it" on dispatch://OSSV-232/ask/a7d1ac41-45c4-4504-a985-7c92998d2158
    # and the issue still did not go out.
    _approved_log=""
    if [[ -n "${GH_SHIM_APPROVAL:-}" && -z "${GH_SHIM_INNER:-}" && -z "${GH_READ_CACHE_BYPASS:-}" && -z "${KNIVES_GH_SHIM_DEPTH:-}" ]]; then
        _gh_cache_root
        _approved_root="$_gh_root"
        mkdir -p "$_approved_root/log" && chmod 700 "$_approved_root" "$_approved_root/log" || exit 1
        _approved_log="$_approved_root/log/approved-posts.jsonl"
        "$_dotfiles/scripts/gh-approved-post" --log "$_approved_log" -- "$@" || exit 1
    fi
    # The outermost call runs the rest of this shim as a child and keeps a copy
    # of its stderr: when GitHub refuses the call, gh's own error ("Can not
    # approve your own pull request", "Resource not accessible by integration")
    # reads to an agent like a missing credential, and an agent that goes looking
    # for another one finds the user's. The refusal below names the call, the
    # identity it ran as and the route.
    if [[ -z "${GH_SHIM_INNER:-}" && -z "${GH_READ_CACHE_BYPASS:-}" ]] \
        && _err="$(mktemp "${TMPDIR:-/tmp}/gh-shim-stderr.XXXXXX" 2> /dev/null)"; then
        set +e
        { GH_SHIM_INNER=1 "$0" "$@" 2>&1 >&3 3>&- | tee "$_err" >&2; } 3>&1
        _rc=${PIPESTATUS[0]}
        set -e
        if [[ -n "$_approved_log" ]]; then
            printf '{"t":"%s","pid":%s,"sid":"%s","ask":"%s","ev":"result","rc":%s}\n' \
                "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$$" "${OMP_SESSION_ID:-}" "${GH_SHIM_APPROVAL//\"/}" "$_rc" \
                >> "$_approved_log" 2> /dev/null || true
        fi
        _refused=0
        _unrouted=0
        _limited=0
        if ((_rc != 0)); then
            # Not routed: refused before GitHub by scripts/gh-routed-only (exit 4), or
            # knives' own no-target line; neither is GitHub refusing the App.
            grep -q '^gh shim: NOT ROUTED\|^knives gh: no target repository' "$_err" && _unrouted=1
            ((!_unrouted)) && grep -qiE "$GH_SHIM_RATE_LIMITED" "$_err" && _limited=1
            ((!_unrouted && !_limited)) && grep -qiE "$GH_SHIM_REFUSED_BY_GITHUB" "$_err" && _refused=1
        fi
        ((_rc == 4 && _unrouted)) && { _gh_call_log unrouted-refused "$@" || true; }
        if ((_limited || _refused)); then
            set +e
            if ((_limited)); then
                ( gh_shim_rate_limited "$_rc" "$_err" "$@" )
            else
                ( gh_shim_refused_by_github "$_rc" "$_err" "$@" )
            fi
            set -e
            rm -f "$_err"
            exit "$_rc"
        fi
        rm -f "$_err"
        exit "$_rc"
    fi
    # An inherited GH_TOKEN wins over everything below: knives skips minting and
    # gh acts as whoever owns that token, with no trace at the call site. That
    # is legitimate (the queue's admin PAT via `secrets`), so it is not refused,
    # but it is never silent: 2026-09-17, two review verdicts went out as the
    # human and nothing recorded which path produced them.
    if [[ -n "${GH_TOKEN:-}" ]]; then
        case "$GH_TOKEN" in
            ghs_*) _kind="an App installation token" ;;
            ghp_*|gho_*|github_pat_*) _kind="a PERSONAL token: this call acts as its user, not as an App" ;;
            *) _kind="a token of unknown kind" ;;
        esac
        echo "gh shim: GH_TOKEN inherited from the environment (${GH_TOKEN:0:4}…, $_kind); not routing" >&2
    fi
    # A call goes through the host-wide read cache (dispatch://BET-303):
    # an identical read from any session inside 60 s (120 s for
    # `gh pr view/checks/list --json`) is answered without a
    # request at all, and a plain `gh api` GET revalidates its stored ETag
    # with a conditional request, which GitHub does not count against the
    # primary rate limit when it answers 304. A write runs as written, and
    # when it ends the cache stops serving every read of that pull request or
    # issue and every repository-wide read of its repository.
    # The cache comes BEFORE the gates below. Every call it makes (a miss, a
    # revalidation, a write, a pass-through, and any failure of that layer)
    # re-enters this shim marked GH_READ_CACHE_BYPASS, and that pass runs the
    # gates, routing and knives on exactly the arguments gh then runs with. A
    # hit sends nothing, and it can only serve an answer that such a pass
    # fetched for the same arguments. With the gates also run before the
    # cache, every call ran the leak check twice: on 2026-11-03 at load ~290,
    # 20 calls spent 4.6 s (p50) in each run, 9 s of the 11 s a call took.
    if [[ -z "${GH_READ_CACHE_BYPASS:-}" && "${GH_READ_CACHE:-}" != 0 && -x "$_dotfiles/scripts/gh-read-cache" ]]; then
        if [[ "$0" == /* && ! -L "$0" ]]; then
            _self="$0"
        else
            _self="$(readlink -f "$0" 2> /dev/null || true)"
            [[ -n "$_self" ]] || _self="$0"
        fi
        # GH_READ_CACHE_PARENT: the cache ends with this process's parent, and a
        # parent that died before it could ask the kernel shows as another pid.
        GH_READ_CACHE_GH="$_self" GH_READ_CACHE_PARENT="$PPID" exec "$_dotfiles/scripts/gh-read-cache" -- "$@"
    fi
    # A standalone docs-only pull request is refused where docs are batched.
    if [[ "${1:-}" == pr && "${2:-}" == create ]]; then
        "$_dotfiles/scripts/docs-pr-gate" "${@:3}"
    fi
    # Public repository text: refuse an internal reference before gh posts it.
    # A call that reads text from stdin (`--input -`, `--body-file -`, `-F name=@-`, …) makes the check exit 4: it
    # cannot read those bytes without taking them from gh. So all of stdin goes into a private file (mktemp, mode
    # 0600), opened once to write and then twice more through that descriptor (/dev/fd/N, so all three are the same
    # file whatever its pathname names by then), and unlinked BEFORE any byte is written: no pathname holds the
    # bytes, so no kill (SIGKILL included) leaves them on disk, and nothing can swap the file after the check.
    # The check reads that open file as /dev/fd/N, and only when it passes does gh get the same file as its stdin. A
    # read or write error, or more than 64 MiB, refuses the call. Which forms read stdin is the check's decision
    # (gh-guard), not a list kept here; PUBLIC_LEAK_CHECK_STDIN_BUFFERS tells it this caller buffers, so its exit 4
    # prints nothing. PUBLIC_LEAK_CHECK_STDIN is this block's alone: a value the caller set made gh send stdin the
    # check never read (re-check, 2026-11-02), so it is cleared first. Measured 2026-11-01 21-23Z: 122 agent calls
    # piped their text, 56 of them scripts/post-review's reviews.
    unset PUBLIC_LEAK_CHECK_STDIN
    _gate_rc=0
    PUBLIC_LEAK_CHECK_STDIN_BUFFERS=1 "$_dotfiles/scripts/public-text-gate" "$@" || _gate_rc=$?
    if ((_gate_rc == 4)); then
        _stdin_max=$((64 * 1024 * 1024))
        _stdin_buf="$(mktemp "${TMPDIR:-/tmp}/gh-shim-stdin.XXXXXX")" || {
            echo "gh shim: refusing: cannot make a private file to hold stdin for the leak check" >&2
            exit 1
        }
        if ! exec {_stdin_w}> "$_stdin_buf" || ! exec {_stdin_g}< "/dev/fd/$_stdin_w" {_stdin_h}< "/dev/fd/$_stdin_w"; then
            rm -f "$_stdin_buf"
            echo "gh shim: refusing: cannot open the private file that holds stdin for the leak check" >&2
            exit 1
        fi
        rm -f "$_stdin_buf" || {
            echo "gh shim: refusing: cannot unlink the private file that holds stdin for the leak check" >&2
            exit 1
        }
        head -c "$((_stdin_max + 1))" >&"$_stdin_w" || {
            echo "gh shim: refusing: cannot read stdin into a file for the leak check" >&2
            exit 1
        }
        exec {_stdin_w}>&-
        _stdin_size="$(stat -L -c %s "/dev/fd/$_stdin_g")" || exit 1
        if ((_stdin_size > _stdin_max)); then
            echo "gh shim: refusing: stdin is over 64 MiB, more than the leak check reads; pass the text in a file" >&2
            exit 1
        fi
        PUBLIC_LEAK_CHECK_STDIN="/dev/fd/$_stdin_g" "$_dotfiles/scripts/public-text-gate" "$@" || exit 1
        exec 0<&"$_stdin_h" {_stdin_g}<&- {_stdin_h}<&-
    elif ((_gate_rc != 0)); then
        exit 1
    fi
fi

# Outside an agent session, git's `gh auth git-credential` (the user's helper in ~/.gitconfig)
# goes to the user's own login, except on a machine that holds no person's GitHub login
# (sami-devbox, dispatch://INFRA-993), where nothing would answer it and every private clone
# from an ssh shell failed with "could not read Username". Such a machine names a gh-app
# profile in its own git config file, ~/.config/git/config (`gh-app.host-profile`, written by
# installers/gh-app-host.sh), and the request goes to the App helper exactly as an agent's does
# above. Only that file counts: not the shared ~/.gitconfig, not a repository's config, and not
# `git config --global`, which git 2.43 answers from ~/.gitconfig alone when that file exists.
if [[ "${1:-}" == auth && "${2:-}" == git-credential ]] &&
    _host_profile="$(git config --file "${XDG_CONFIG_HOME:-$HOME/.config}/git/config" --get gh-app.host-profile 2> /dev/null)" &&
    [[ -n "$_host_profile" ]]; then
    [[ "${3:-}" == get ]] && exec gh-app-token "$_host_profile" get
    exit 0
fi

# real_gh: sets _real to the gh this shim hands the call to.
# Content decides what is "real", never the path: any candidate carrying the
# knives-gh-shim marker in its first 512 bytes is a shim. The old dir-string
# skip broke whenever HOME or DOTFILES_DIR spelled this shim's directory
# differently from PATH, and knives gh re-entered this shim in an unbounded
# fork chain (2026-08-27, ~300k processes). Mirrors real_gh() in knives
# src/commands/gh.rs. A variable, not output, so no subshell is forked.
real_gh() {
    local IFS=':'
    local dir candidate header
    _real=""
    for dir in $PATH; do
        candidate="$dir/gh"
        [[ -f "$candidate" && -x "$candidate" ]] || continue
        # Pure bash on purpose: this must work on a PATH too broken to find
        # head or grep. read stops at the first NUL, so an ELF gh yields a
        # short marker-free header and is accepted.
        header=""
        IFS= read -r -n 512 -d '' header < "$candidate" || true
        [[ "$header" == *knives-gh-shim* ]] && continue
        _real="$candidate"
        mise_pinned_gh "$dir" || true
        return 0
    done
    return 1
}
# mise_pinned_gh DIR: when DIR is mise's shims directory, sets _real to the gh
# pinned exactly in mise's global config, straight from its install dir, as
# shims/knives runs knives. mise's shim is mise itself: it reads its config,
# then execs that gh, one more process on every call (0.15 s p50, 0.51 s p90
# over 20 calls at load ~290 on 2026-11-03), and under load mise hung for
# minutes (2026-11-03 ~00:3x-01:00Z, shims/knives). With no exact pin, or no
# install of it, _real stays mise's shim.
mise_pinned_gh() {
    local IFS=$' \t\n'
    local root data="" config line section="" pin="" candidate
    local section_re='^[[:space:]]*\[([^]]*)\]' pin_re='^[[:space:]]*"?gh"?[[:space:]]*=[[:space:]]*"([0-9][0-9A-Za-z.+-]*)"'
    for root in "${MISE_DATA_DIR:-$HOME/.mise}" "${XDG_DATA_HOME:-$HOME/.local/share}/mise"; do
        if [[ "$1" -ef "$root/shims" ]]; then
            data="$root"
            break
        fi
    done
    [[ -n "$data" ]] || return 1
    config="${MISE_GLOBAL_CONFIG_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/mise/config.toml}"
    [[ -r "$config" ]] || return 1
    while IFS= read -r line; do
        if [[ "$line" =~ $section_re ]]; then
            section="${BASH_REMATCH[1]}"
        elif [[ "$section" == tools && "$line" =~ $pin_re ]]; then
            pin="${BASH_REMATCH[1]}"
            break
        fi
    done < "$config"
    [[ -n "$pin" ]] || return 1
    for candidate in "$data/installs/gh/$pin/bin/gh" "$data/installs/gh/$pin"/*/bin/gh; do
        if [[ -f "$candidate" && -x "$candidate" ]]; then
            _real="$candidate"
            return 0
        fi
    done
    return 1
}

# Resolve the real gh FIRST and refuse to proceed without it (a bare `gh`
# fallback would re-enter this shim and recurse), and honor the bypass before
# involving knives at all.
if ! real_gh; then
    echo "gh shim: no real gh found on PATH" >&2
    exit 127
fi
if [[ -z "${KNIVES_GH_BYPASS:-}" ]] && command -v knives > /dev/null 2>&1; then
    # Backstop: a resolution bug must fail loudly here, never fork-bomb the
    # machine. Legit flows re-enter this shim at most twice (knives runs bare
    # `gh` for forge queries); depth 3 is a loop.
    _depth="${KNIVES_GH_SHIM_DEPTH:-0}"
    [[ "$_depth" =~ ^[0-9]+$ ]] || _depth=0
    if ((_depth >= 3)); then
        echo "gh shim: re-entered $_depth times — knives gh is looping through this shim" >&2
        echo "gh shim: refusing to recurse; KNIVES_GH_BYPASS=1 runs $_real directly" >&2
        exit 70
    fi
    if [[ -n "${_routed_only:-}" && -x "$_dotfiles/scripts/gh-routed-only" ]]; then
        GH_SHIM_REAL_GH="$_real" KNIVES_GH_SHIM_DEPTH=$((_depth + 1)) KNIVES_REAL_GH="$_dotfiles/scripts/gh-routed-only" \
            exec knives gh -- "$@"
    fi
    KNIVES_GH_SHIM_DEPTH=$((_depth + 1)) KNIVES_REAL_GH="$_real" exec knives gh -- "$@"
fi
exec "$_real" "$@"
