#!/bin/bash
# knives-gh-shim: thin dispatcher. The brain lives in `knives gh`.
# Docs: knives repo, docs/superpowers/specs/2026-08-05-release-correctness-and-knives-gh-design.md
# KNIVES_GH_BYPASS=1 skips knives entirely (emergency hatch if knives gh misbehaves).
set -euo pipefail

real_gh() {
    local IFS=':'
    local dotfiles_shims="${DOTFILES_DIR:-$HOME/.dotfiles}/shims"
    for dir in $PATH; do
        [[ "$dir" == "$dotfiles_shims" ]] && continue
        [[ -x "$dir/gh" ]] && { echo "$dir/gh"; return; }
    done
    return 1
}

# Oracle amendments: resolve the real gh FIRST and refuse to proceed without it
# (a bare `gh` fallback would re-enter this shim and recurse), and honor the
# bypass before involving knives at all.
if ! _real="$(real_gh)"; then
    echo "gh shim: no real gh found on PATH" >&2
    exit 127
fi
if [[ -z "${KNIVES_GH_BYPASS:-}" ]] && command -v knives > /dev/null 2>&1; then
    KNIVES_REAL_GH="$_real" exec knives gh -- "$@"
fi
exec "$_real" "$@"
