#!/bin/bash
# knives-gh-shim: thin dispatcher. The brain lives in `knives gh`.
# Docs: knives repo, docs/superpowers/specs/2026-08-05-release-correctness-and-knives-gh-design.md
# KNIVES_GH_BYPASS=1 skips knives entirely (emergency hatch if knives gh misbehaves).
set -euo pipefail
# The mark the outermost pass of an agent session gives its inner passes (GH_SHIM_REACHED_GH, below), held in this
# process only: a gh call the checks make themselves (a visibility read) runs this shim again and must not set it.
_reached_mark="${GH_SHIM_REACHED_GH:-}"
unset GH_SHIM_REACHED_GH

# Every agent session on this machine reaches GitHub through one App
# installation, so they share one primary rate limit; it reached zero four
# times on 2026-11-01 and every session that reads GitHub stopped
# (dispatch://BET-303). This records one line per OUTERMOST gh call, so the
# spend can be attributed to a caller and a command. knives re-enters this
# shim for its own forge queries, and the read cache re-enters it on a miss:
# both carry a marker, and a marked call is the same call again, not a new
# one. Every step is best-effort; nothing here may fail a gh call.
# _gh_cache_root: sets _gh_root, the cache's root directory. A variable, not
# output: `$(...)` forks a subshell, and on 2026-11-03 at load ~290 every
# process this shim started cost tens to hundreds of milliseconds.
_gh_cache_root() {
    if [[ -n "${GH_READ_CACHE_DIR:-}" ]]; then
        _gh_root="$GH_READ_CACHE_DIR"
        return
    fi
    local u="${USER:-$(id -un 2> /dev/null || true)}"
    if [[ -n "$u" && -d "/mnt/nvme/$u" ]]; then
        _gh_root="/mnt/nvme/$u/gh-read-cache"
    else
        _gh_root="${XDG_CACHE_HOME:-$HOME/.cache}/gh-read-cache"
    fi
}
# _gh_call_log EV ARGV…: one line with event EV ("call", "unrouted-refused") for this call.
_gh_call_log() {
    local ev="$1" dir a s out='' hour
    shift
    _gh_cache_root
    dir="$_gh_root/log"
    if [[ ! -d "$dir" ]]; then
        mkdir -p "$dir" 2> /dev/null || return 0
        chmod 700 "$_gh_root" "$dir" 2> /dev/null || true
    fi
    for a in "$@"; do
        s=${a//\\/\\\\}
        s=${s//\"/\\\"}
        s=${s//$'\n'/\\n}
        s=${s//$'\r'/\\r}
        s=${s//$'\t'/\\t}
        out+=",\"$s\""
    done
    local now="${EPOCHREALTIME:-}"
    now="${now/,/.}"
    [[ -n "$now" ]] || now="$(date -u +%s)"
    TZ=UTC0 printf -v hour '%(%Y%m%d%H)T' -1
    printf '{"t":%s,"pid":%s,"sid":"%s","cwd":"%s","ev":"%s","argv":[%s]}\n' \
        "$now" "$$" "${OMP_SESSION_ID:-}" "${PWD//\"/}" "$ev" "${out:1}" \
        >> "$dir/$hour.jsonl" 2> /dev/null || true
}
if [[ -z "${KNIVES_GH_SHIM_DEPTH:-}" && -z "${GH_READ_CACHE_BYPASS:-}" && -z "${GH_SHIM_INNER:-}" && "${GH_READ_CACHE_LOG:-}" != 0 ]]; then
    _gh_call_log call "$@" || true
fi

# A job's log holds terminal escape sequences, and gh 2.98.0 refuses to print
# one without --allow-escape-sequences, so a plain
# `gh api repos/<owner>/<repo>/actions/jobs/<id>/logs` returns nothing and the
# caller reads no CI failure (11,209 such refusals on this fleet in the week to
# 2026-11-08). A job log is text to read, never a document to render, so the
# shim asks for it allowed; a call that already passes the flag is unchanged.
if [[ "${1:-}" == api ]]; then
    _esc_logs=0
    _esc_have=0
    for _esc_a in "$@"; do
        case "$_esc_a" in
            --allow-escape-sequences) _esc_have=1 ;;
            *actions/jobs/*/logs) _esc_logs=1 ;;
        esac
    done
    if ((_esc_logs)) && ((!_esc_have)); then
        set -- "$@" --allow-escape-sequences
    fi
    unset _esc_a _esc_logs _esc_have
fi

# Agent context: an omp session (its bash tool carries OMP_SESSION_ID, its
# eval kernel PI_SESSION_FILE with an allow-listed environment that drops
# GIT_CONFIG_*), an agentbox session, or anything launched with the gh-app
# routing include (shims/omp, scripts/cld). Three guarantees there:
# the routing include is present even when the caller's environment was
# scrubbed; gh sees the agent config directory of scripts/gh-agent-config,
# whose placeholder login stands where the user's would be, so a call with no
# target owner to route fails on GitHub's 401 and never reaches the user's own
# login in hosts.yml or the keyring (an owner the App does not cover gets the
# upstream token from the secrets store); and a call GitHub refuses for the
# App ends with a refusal that names the call and the route to take instead.
# On 2026-09-14 an agent's `gh api -X POST …/reviews` from omp's eval kernel in
# /tmp ran on the user's keyring and approved a pull request as him. On
# 2026-11-02T00:07Z a Python eval kernel's `gh pr review --approve` did it
# again without reaching this shim at all: mise's python3 shim had put mise's
# own gh ahead of this directory on the kernel's PATH. mise.toml's `_.path`
# now puts this directory first in every mise-run process, and
# scripts/agent-session and omp/extensions/session-env.ts export the agent
# GH_CONFIG_DIR, so a gh that still runs past this shim finds no user login.
agent_context() {
    [[ -n "${OMP_SESSION_ID:-}${PI_SESSION_FILE:-}${PI_TOOL_BRIDGE_URL:-}${AGENTBOX_SESSION:-}${CLAUDECODE:-}${ENVOY_SESSION_ID:-}${AGENT_SHIM_AGENT:-}${LEGION_ROLE:-}${LEGION_TREE:-}${LEGION_CONTROLLER:-}${LEGION_DAEMON_URL:-}" ]] && return 0
    local i v
    for ((i = 0; i < ${GIT_CONFIG_COUNT:-0}; i++)); do
        v="GIT_CONFIG_VALUE_$i"
        [[ "${!v:-}" == *gh-app-routes.gitconfig ]] && return 0
    done
    # There is no exception for tmux. A pane takes the SERVER's environment, not the environment
    # of whoever asked for the pane, so "inside tmux means the person" let an agent's own
    # `tmux new-window` under the person's server produce a pane with no marker that then ran as
    # the person (round 3 of INFRA-1538). The fix is the other way round: shims/tmux and
    # scripts/agentbox-tmux-guard pass the caller's markers to the new pane with tmux's -e, so an
    # agent's pane carries them and is caught above.
    # A command that arrives over SSH in a session with no controlling terminal (`ssh host az
    # account show`) is an agent's, not a person's. The session's terminal decides, not this
    # command's stdin and not SSH_TTY alone: a person's session has one (sshd's for an interactive
    # login, tmux's for every pane) and every process of it shares it, so a pipe into one command of
    # it (`echo x | az …`, git handing its credential helper the request) is still the person's,
    # where testing this command's own stdin made it an agent's. A tmux server started before
    # .tmux.conf carried SSH_TTY gives its panes SSH_CONNECTION without SSH_TTY, and on that alone
    # Sami's own pane was taken for an agent's (INFRA-4089). /dev/tty opens only in a session with
    # a terminal; `true`, not `:`, since a failed redirection of a special builtin ends a
    # POSIX-mode bash. AGENT_SHIM_PERSON=1 is the person's escape for a deliberate
    # non-interactive SSH command of their own (INFRA-1538).
    if [[ -n "${SSH_CONNECTION:-}" && -z "${SSH_TTY:-}" && "${AGENT_SHIM_PERSON:-}" != 1 ]] &&
        ! { true < /dev/tty; } 2> /dev/null; then
        AGENT_CONTEXT_VIA_SSH=1
        return 0
    fi
    return 1
}

# Say so when the SSH rule above, and not a session marker, made this an agent's call: nothing
# else in the output names the identity, and a person whose own non-interactive ssh command this
# is needs to see the escape. Once per call: the read cache and the stderr-keeping outer pass
# below re-enter this shim.
if [[ -z "${GH_SHIM_INNER:-}${GH_READ_CACHE_BYPASS:-}${KNIVES_GH_SHIM_DEPTH:-}" ]] &&
    agent_context && [[ -n "${AGENT_CONTEXT_VIA_SSH:-}" ]]; then
    echo "gh shim: non-interactive SSH, so an agent's call: routed to the GitHub App, not to any person's login (set AGENT_SHIM_PERSON=1 for your own)" >&2
fi

# There is no exception here for a machine that names gh-app.host-profile in its own git config
# (sami-devbox, installers/gh-app-host.sh). An earlier draft kept the HOST route for a call whose
# only agent evidence was the SSH rule, on the grounds that the agent route needs a broker session
# an ssh command has not got. It does not: gh-app-token registers one itself (`secret-run
# --register`, shims/gh-app-token), and that profile IS `agent`, so both routes mint the same
# App token. The exception only lifted such a call out of the whole agent block below — past the
# public-text leak check, past the refusal of `gh auth token`, past the agent GH_CONFIG_DIR, and
# past the requirement that a call name the repository it targets (review of INFRA-1538).

# A refusal names the exact call, the identity it would have acted as, why it
# is refused and what to do instead, and exits non-zero. A silent or vague
# refusal reads as "no approval exists" and sends the next agent looking for
# another credential (the chief of staff's requirement, 2026-11-02).
gh_shim_user_login() {
    local line user="" hosts="${XDG_CONFIG_HOME:-$HOME/.config}/gh/hosts.yml"
    # Guarded, not `2> /dev/null` on the loop: redirections are applied left to right, so a
    # missing hosts.yml printed "No such file or directory" BEFORE stderr was silenced, and that
    # line landed between "REFUSED" and the reason, where it reads as the cause of the refusal
    # (seen in the dispatch://INFRA-2006 smoke, 2026-11-08). An agent process normally has no
    # hosts.yml at all, so this was the common case, not the rare one.
    if [[ -r "$hosts" ]]; then
        while IFS= read -r line; do
            [[ "$line" =~ ^\ {4}user:\ *([^[:space:]]+) ]] && { user="${BASH_REMATCH[1]}"; break; }
        done < "$hosts"
    fi
    if [[ -n "$user" ]]; then
        printf "the user login \`%s\` from gh's hosts.yml and keyring" "$user"
    else
        printf "the user's own GitHub login from gh's hosts.yml and keyring"
    fi
}
gh_shim_quote() {
    local out="gh" a
    for a in "$@"; do out+=" $(printf '%q' "$a")"; done
    printf '%s' "$out"
}
# gh_shim_origin_slug: sets _slug to OWNER/REPO of this directory's origin remote on github.com,
# else empty.
gh_shim_origin_slug() {
    local remote
    remote="$(git remote get-url origin 2> /dev/null || true)"
    _slug=""
    case "$remote" in
        *github.com[:/]*) _slug="${remote#*github.com[:/]}"; _slug="${_slug%/}"; _slug="${_slug%.git}" ;;
    esac
    [[ "$_slug" =~ ^[^/]+/[^/]+$ ]] || _slug=""
}
# gh_shim_target_owner ARGV…: sets _owner to the GitHub owner the call targets: -R/--repo, then
# GH_REPO, then a `repos/OWNER/…` path of `gh api`, then the origin remote, else theorem-labs.
gh_shim_target_owner() {
    local a prev="" repo="" path=""
    for a in "$@"; do
        case "$prev" in -R | --repo) repo="$a" ;; esac
        case "$a" in
            --repo=*) repo="${a#--repo=}" ;;
            -R?*) repo="${a#-R}" ;;
        esac
        [[ "${1:-}" == api && -z "$path" && "$a" =~ ^/?repos/([^/?]+)/ ]] && path="${BASH_REMATCH[1]}"
        prev="$a"
    done
    [[ -n "$repo" ]] || repo="${GH_REPO:-}"
    repo="${repo#https://}"
    repo="${repo#github.com/}"
    _owner="${repo%%/*}"
    [[ -n "$_owner" ]] || _owner="$path"
    if [[ -z "$_owner" ]]; then
        gh_shim_origin_slug
        _owner="${_slug%%/*}"
    fi
    [[ -n "$_owner" ]] || _owner=theorem-labs
}
# gh_shim_call_digest ARGV…: sets _digest to the SHA-256 of GH_SHIM_APPROVAL and ARGV, each ended
# by a NUL (no argument can hold one), so one digest names one citation and one exact call; empty
# when it cannot be computed.
gh_shim_call_digest() {
    _digest="$(printf '%s\0' "${GH_SHIM_APPROVAL:-}" "$@" | sha256sum 2> /dev/null)" || _digest=""
    _digest="${_digest%% *}"
}
# gh_shim_is_write ARGV…: true when this call changes something on GitHub. `gh api` counts when
# it names a method other than GET, which is how gh itself decides; every other verb is listed,
# because a verb this misses is a write that goes out ungated. Read verbs are never listed, so a
# new read command keeps working without an edit here. The command and its verb are found as cobra
# finds them, past the options before each (`gh -R o/r pr comment 1` and `gh pr -R o/r comment 1`
# are `gh pr comment`): an option written apart from any value, but --help and --version, takes the
# next word as its value.
gh_shim_is_write() {
    local a method="" group="" verb="" skip=0 letters value kind pending="" body=0
    for a in "$@"; do
        if ((skip)); then
            skip=0
            continue
        fi
        case "$a" in
            --) break ;;
            --help | --version | -*=*) ;;
            --* | -?) skip=1 ;;
            -*) ;;
            *)
                if [[ -z "$group" ]]; then
                    group="$a"
                    [[ "$a" != api ]] || break
                else
                    verb="$a"
                    break
                fi
                ;;
        esac
    done
    case "$group" in
        api)
            # gh api's options as gh's flag parser (pflag) reads them (`gh api --help`, gh 2.98.0): the method is the
            # last -X/--method given, and with none, a field (-f/-F) or an --input body makes gh POST. A value option
            # takes the rest of its word (`-XPOST`, `-X=POST`, `--method=POST`) or else the next word, also at the end
            # of a cluster after -i, gh api's one short flag that takes none (`-iXPOST`, `-if k=v`), and a word an
            # option takes is never read as an option (`-t -XGET` is a template). Until 2026-11-17 neither a cluster
            # nor a taken word was read, so `gh api -X GET -iXPOST …`, `gh api … -if body=…` and
            # `gh api … -f body=… -t -XGET` were reads here, and gh POSTed their text without the leak-term check.
            for a in "$@"; do
                if [[ -n "$pending" ]]; then
                    case "$pending" in method) method="$a" ;; body) body=1 ;; esac
                    pending=""
                    continue
                fi
                case "$a" in
                    --) break ;;
                    --method=*) method="${a#--method=}" ;;
                    --field=* | --raw-field=* | --input=*) body=1 ;;
                    --method) pending=method ;;
                    --field | --raw-field | --input) pending=body ;;
                    --cache | --header | --hostname | --jq | --preview | --template) pending=other ;;
                    --*) ;;
                    -?*)
                        letters="${a#-}"
                        while [[ "$letters" == i* ]]; do
                            letters="${letters#i}"
                            [[ "$letters" != =* ]] || letters=""
                        done
                        case "${letters:0:1}" in
                            X) kind=method ;;
                            f | F) kind=body ;;
                            H | p | q | t) kind=other ;;
                            *) continue ;;
                        esac
                        value="${letters:1}"
                        [[ ${#value} -le 1 || "${value:0:1}" != = ]] || value="${value:1}"
                        if [[ -z "$value" ]]; then
                            pending="$kind"
                        elif [[ "$kind" == method ]]; then
                            method="$value"
                        elif [[ "$kind" == body ]]; then
                            body=1
                        fi
                        ;;
                esac
            done
            if [[ -n "$method" ]]; then
                [[ "${method^^}" == GET || "${method^^}" == HEAD ]] && return 1
                return 0
            fi
            ((body)) && return 0
            return 1
            ;;
        issue | pr | discussion)
            case "$verb" in
                create | new | comment | edit | close | reopen | merge | review | ready | delete | lock \
                    | unlock | pin | unpin | transfer | develop | checkout | revert) return 0 ;;
            esac
            ;;
        release | repo | label | secret | variable | gist | ruleset | project | codespace)
            case "$verb" in
                create | new | edit | delete | upload | set | remove | rename | archive | sync | fork \
                    | clone | deploy-key | copy | close | stop | field-create | item-create | item-edit) return 0 ;;
            esac
            ;;
        agent-task | agent-tasks | agent | agents) case "$verb" in create) return 0 ;; esac ;;
        workflow) case "$verb" in run | enable | disable) return 0 ;; esac ;;
        run) case "$verb" in rerun | cancel | delete) return 0 ;; esac ;;
        cache) case "$verb" in delete) return 0 ;; esac ;;
    esac
    return 1
}
# gh_shim_may_send_text ARGV…: true when scripts/leak-terms-check must read this call, and it then
# decides: a write (gh_shim_is_write), a first word that is not one of gh 2.98.0's own commands,
# which can be an option before the command or a gh alias of the user's that the check expands, or a
# command under which gh's config.yml may hold an alias (gh_shim_has_nested_alias). It may be wider
# than the check's own table, never narrower (shims/tests/test_gh_leak_terms.py); a read never
# starts the check.
gh_shim_may_send_text() {
    gh_shim_is_write "$@" && return 0
    case "${1:-}" in
        '' | --help | --version) return 1 ;;
        agent | agent-task | agent-tasks | agents | alias | api | at | attestation \
            | auth | browse | cache | codespace | completion | config | copilot | cs | discussion | ext \
            | extension | extensions | gist | gpg-key | help | issue | label | licenses | org | pr | preview \
            | project | release | repo | rs | ruleset | run | search | secret | skill | skills | ssh-key \
            | status | variable | version | workflow)
            gh_shim_has_nested_alias "$1"
            return
            ;;
    esac
    return 0
}
# gh_shim_has_nested_alias COMMAND: true when gh's config.yml (in gh's own config dir) may hold an
# alias under COMMAND, such as `gh alias set 'pr say' 'pr comment'`, which gh runs as what it
# expands to; the check then reads the call and decides. Until 2026-11-17 `gh pr say 11 --body …`
# was a read here, and its text went out unchecked. A line that only looks like one starts the
# check, which finds no alias and lets the call go.
gh_shim_has_nested_alias() {
    local config="${GH_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/gh}/config.yml" text pattern
    [[ -r "$config" ]] || return 1
    text="$(< "$config")" || return 1
    pattern=$'(^|\n)[ \t]+["\']?'"$1"$'[ \t][^:\n]*:'
    [[ "$text" =~ $pattern ]]
}
# gh_shim_refuse WHY INSTEAD ARGV…: the shim itself refuses, before gh runs.
gh_shim_refuse() {
    local why="$1" instead="$2"
    shift 2
    {
        echo "gh shim: REFUSED: \`$(gh_shim_quote "$@")\`"
        echo "  Identity: it would have used $(gh_shim_user_login)."
        echo "  Why: $why A call that acts as that login is Sami's own signature on GitHub; no agent process may use it."
        echo "  Instead: $instead"
    } >&2
    exit 1
}
# What GitHub answers when the identity a call ran as may not make it: a review
# of the App's own pull request, a permission or repository the installation or
# token lacks, a token GitHub rejects.
GH_SHIM_REFUSED_BY_GITHUB='Can not (approve|request changes on) your own pull request|Resource not accessible by|HTTP 40[13]|Bad credentials|must have (admin|push|write|maintain)|not have permission|Permission to [^ ]+ denied|requires authentication'
# gh_shim_refused_by_github RC ERRFILE ARGV…: GitHub refused the call for the
# identity it ran as, which is read from the call's environment and stderr, not
# assumed. On 2026-11-02 a call carrying a broker token in GH_TOKEN (so knives
# did not route it) was refused on google/oss-fuzz, and this block said it ran
# as the App and that the user's login is never used by an agent, while the
# token was the user's own and the routed call would have run as him too.
gh_shim_refused_by_github() {
    local rc="$1" err="$2" pr="" repo="" verdict="APPROVE" a prev="" instead who token admin=""
    shift 2
    if [[ "${1:-}" == pr && "${2:-}" == review ]]; then
        for a in "${@:3}"; do
            case "$prev" in
                -R | --repo) repo="$a" ;;
                -b | --body | -F | --body-file) ;;
                *)
                    case "$a" in
                        --repo=*) repo="${a#--repo=}" ;;
                        -r | --request-changes) verdict="REQUEST_CHANGES" ;;
                        -*) ;;
                        *) [[ -n "$pr" ]] || pr="$a" ;;
                    esac
                    ;;
            esac
            prev="$a"
        done
    elif [[ "${1:-}" == api ]]; then
        for a in "${@:2}"; do
            if [[ "$a" =~ ^/?repos/([^/]+/[^/]+)/pulls/([0-9]+)/reviews ]]; then
                repo="${BASH_REMATCH[1]}" pr="${BASH_REMATCH[2]}"
            fi
            [[ "$a" == *REQUEST_CHANGES* ]] && verdict="REQUEST_CHANGES"
        done
    fi
    token="$(sed -nE 's/.*using the personal token ([^ ]+) .*/\1/p' "$err" | head -n 1)"
    if [[ -n "${GH_TOKEN:-}" ]]; then
        who="the token in GH_TOKEN, inherited from the environment (${GH_TOKEN:0:4}…), so as that token's own GitHub user; nothing routed the call, and a broker token reaches only the repositories it was made for (GITHUB_ADMIN_PAT: theorem-labs)"
    elif [[ -n "$token" ]]; then
        who="the personal token $token, so as its GitHub user, not as an App: the repository's owner has no App installation"
    else
        who="the GitHub App this repository's owner routes agent calls to"
    fi
    if [[ -z "${GH_TOKEN:-}" && -z "$token" ]]; then
        # The App was refused. Sami said five times (2026-10-25 to 2026-11-03) that an agent does a
        # GitHub admin action itself with his admin token and never asks him to; this block used to
        # send every such refusal to the lead, who asked him. A post (the App lacking the issues
        # permission) can be one too, so every branch below carries it. An approval of a pull request
        # never is: dispatch://INFRA-1481's R3 (approved 2026-11-15) says no approval uses a person's token.
        admin="If this is a GitHub admin action that work Sami already asked for needs (an App permission or installation, an admin merge, a repository or branch setting), do it yourself with his admin token from the credential broker; never ask Sami to do it (dispatch://OSSV-300/ask/dc4e1c38-bd15-4999-9ef5-4c6540a2ce9a). An approval of a pull request is not such an action: no approval uses a person's token (dispatch://INFRA-1481, R3). For a theorem-labs repository run \`secret-run --register --reason '<what and why>' GITHUB_ADMIN_PAT -- sh -c 'GH_TOKEN=\$GITHUB_ADMIN_PAT exec gh \"\$@\"' $(gh_shim_quote "$@")\`; for a repository of sjawhar's own, the same with GITHUB_PERSONAL_ADMIN_PAT in both places. The broker puts the token in the variable of its own name, which gh does not read, so the sh -c line gives it to gh as GH_TOKEN. Sami approves the grant once per session from the broker's card in Dispatch; that card is not an ask. \`--register\` makes the route work in a session that has no broker identity (one launched past shims/omp, so it never registered): it registers this one command as a broker session of its own, and in a session that has one it changes nothing. Without it such a session reads secretsd, which does not hold this key, and gets \"not found\"."
    fi
    if [[ -n "$pr" ]]; then
        instead="where a repository requires an approval your own identity cannot give, ask INFRA's Legion controller (Envoy topic notifications.role.legion-infra-controller) which running Legion reviewer reads it, and send that reviewer the pull request and its head. Ask for no review issue. Where a code owner owns the files changed, ask that person through Dispatch; never approve with a person's token or as the Legion review App (dispatch://INFRA-1481, R1 and R3), and ask no other session to review it. Where a comment is enough, post the verdict as a pull-request comment: \`gh pr comment $pr${repo:+ -R $repo} --body-file <file>\`, the file's first line \`VERDICT: $verdict at <full 40-character head sha>\`. pr-gate reads issue comments as verdicts (dispatch://BET-9/ask/6b7de765)."
    elif [[ "${1:-} ${2:-}" == "issue create" || "${1:-} ${2:-}" == "issue comment" || "${1:-} ${2:-}" == "pr comment" || "${1:-} ${2:-}" == "pr create" ]]; then
        instead="if Sami instructed this post in a Dispatch ask he answered, run the same call again with GH_SHIM_APPROVAL=dispatch://<KEY>/ask/<id> in front of it and no GH_TOKEN. The shim then checks that he answered it with its approving option and that the title and body are the draft he was shown, and logs the post; an owner with no App installation gets his own upstream token, so the post goes out as him (shims/AGENTS.md).${admin:+ $admin} Otherwise stop, and tell your lead which call GitHub refused and its error above. Do not look for another credential, token or gh binary."
    elif [[ -n "$admin" ]]; then
        instead="$admin For any other owner, or a call that is not such an admin action, stop and tell your lead which call GitHub refused and its error above. Do not look for another credential, token or gh binary."
    else
        instead="stop, and tell your lead which call GitHub refused and its error above. Do not look for another credential, token or gh binary."
    fi
    {
        echo "gh shim: REFUSED by GitHub: \`$(gh_shim_quote "$@")\` (exit $rc; GitHub's error is above)."
        echo "  Identity: it ran as $who. Do not retry with a token or gh binary you found yourself: every other credential to use is named below."
        if grep -q "HTTP 401" "$err"; then
