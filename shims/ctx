#!/bin/bash
# ctx wrapper: names the memory graph's server for every ctx call, as .bashrc's CTX_SERVER does
# for a new shell, so a session, pane or unit whose environment predates that line reaches the
# server too. A CTX_SERVER the caller set wins, and an empty one means a local tree
# (`CTX_SERVER= ctx --memory <tree> …`), which ctx reads as unset.
#
# Two deployments. Sami's personal one keeps his own life in his own tree and must never reach
# the team's: a search there would send a contact's name over company infrastructure, and a write
# would commit a personal fact into the company tree under his login. The personal one is chosen
# when the session runs in the `personal` omp profile, or when the caller names it with
# CTX_PERSONAL_ROOT (the personal deployment's scripts do). Naming the personal server in a skill
# or a habit is not enough, because the shared `ctx-memory` skill tells every session to run
# plain `ctx`. Every other call gets the team server.
#
# The personal deployment describes itself in its root directory (CTX_PERSONAL_ROOT, else
# $XDG_DATA_HOME/ctx-personal): `server-url` names its server, `ctx-version` the release it runs,
# and an executable `bin/ctx` overrides that release while a change it needs is unreleased.
#
# The team deployment's binary is the mise pin ("github:sjawhar/ctx-memory" in mise.toml), looked
# up with `mise which -C /` so a project's own mise configuration does not move it and mise's own
# shim, which hands an unresolved call back to PATH, is never in the loop. It never execs itself.
set -u

# mise_paths: mise as this machine runs it, whatever HOME and PATH the caller set
# (shims/AGENTS.md, "A moved HOME"). A Legion test pane runs a shim with a
# temporary HOME and the PATH <bin>:/usr/local/bin:/usr/bin:/bin, where every
# path under HOME names nothing. Sets, once per process:
#   _mise_bin     mise on PATH, else the dotfiles checkout's bin/mise
#   _mise_config  mise's global configuration: MISE_GLOBAL_CONFIG_FILE, else the
#                 file under HOME when it is readable, else the checkout's
#                 mise.toml, which installers link that file to
#   _mise_datas   the data dirs a tool may be installed in: MISE_DATA_DIR and mise's
#                 default ~/.local/share/mise under HOME; with no MISE_DATA_DIR,
#                 ~/.mise (.bashrc's) and that default, under HOME, then the passwd home's
#   _mise_data    the one to give mise: MISE_DATA_DIR, else the first that exists
# The checkout is DOTFILES_DIR, else the one this file's own path is in.
mise_paths() {
    local IFS=$' \t\n'
    local self dotfiles home dir data seen=""
    local -a all=()
    [[ -z "${_mise_config:-}" ]] || return 0
    _mise_bin=""
    IFS=':'
    for dir in ${PATH:-}; do
        if [[ -n "$dir" && -f "$dir/mise" && -x "$dir/mise" ]]; then
            _mise_bin="$dir/mise"
            break
        fi
    done
    IFS=$' \t\n'
    _mise_config="${MISE_GLOBAL_CONFIG_FILE:-${XDG_CONFIG_HOME:-${HOME:-}/.config}/mise/config.toml}"
    if [[ -z "$_mise_bin" || ( -z "${MISE_GLOBAL_CONFIG_FILE:-}" && ! -r "$_mise_config" ) ]]; then
        dotfiles="${DOTFILES_DIR:-}"
        if [[ -z "$dotfiles" ]]; then
            self="$(command -p readlink -f -- "${BASH_SOURCE[0]}")" || self=""
            dotfiles="${self%/shims/*}"
        fi
        [[ -n "$_mise_bin" ]] || _mise_bin="$dotfiles/bin/mise"
        [[ -n "${MISE_GLOBAL_CONFIG_FILE:-}" || -r "$_mise_config" ]] || _mise_config="$dotfiles/mise.toml"
    fi
    if [[ -n "${MISE_DATA_DIR:-}" ]]; then
        all=("$MISE_DATA_DIR" "${XDG_DATA_HOME:-${HOME:-}/.local/share}/mise")
    else
        all=("${HOME:-}/.mise" "${XDG_DATA_HOME:-${HOME:-}/.local/share}/mise")
        # With HOME unset, ~ is the uid's home in the passwd database, which HOME does not move.
        local HOME
        unset HOME
        home=~
        [[ "$home" != /?* ]] || all+=("$home/.mise" "$home/.local/share/mise")
    fi
    _mise_datas=() _mise_data="${MISE_DATA_DIR:-}"
    for data in "${all[@]}"; do
        [[ "$data" == /?* && ":$seen:" != *":$data:"* ]] || continue
        seen+=":$data"
        _mise_datas+=("$data")
        [[ -n "$_mise_data" || ! -d "$data" ]] || _mise_data="$data"
    done
    : "${_mise_data:=${_mise_datas[0]:-}}"
}

mise_paths
mise="$_mise_bin"
# The dotfiles keep mise's tools in their own data dir (.bashrc, mise/mise.conf); a unit or a
# script that sourced neither must look there too, or mise reports nothing installed. Each mise
# call below names mise's global configuration, which under a moved HOME is the dotfiles
# checkout's (mise_paths).
export MISE_DATA_DIR="$_mise_data"

if [[ "${OMP_PROFILE:-${PI_PROFILE:-}}" == personal || -n "${CTX_PERSONAL_ROOT:-}" ]]; then
	# The XDG data home counts only as an absolute path, as the XDG Base Directory spec says.
	case "${XDG_DATA_HOME:-}" in
	/*) data_home="$XDG_DATA_HOME" ;;
	*) data_home="$HOME/.local/share" ;;
	esac
	root="${CTX_PERSONAL_ROOT:-$data_home/ctx-personal}"
	real="$root/bin/ctx"
	if [[ ! -x "$real" ]]; then
		version="$(cat "$root/ctx-version" 2>/dev/null)"
		dir=""
		[[ -n "$version" ]] && dir="$(MISE_GLOBAL_CONFIG_FILE="$_mise_config" "$mise" where -C / "github:sjawhar/ctx-memory@$version" 2>/dev/null)"
		real="$dir/ctx"
		if [[ -z "$dir" || ! -x "$real" ]]; then
			echo "ctx shim: the personal deployment at $root names no installed ctx (bin/ctx or ctx-version '$version')" >&2
			exit 127
		fi
	fi
	# The server is always the deployment's own. An inherited CTX_SERVER never counts here: every
	# shell inherits the team server's URL from .bashrc, and honouring it would send a personal
	# search or write to the company tree. Only an empty CTX_SERVER (`CTX_SERVER= ctx --memory …`)
	# is honoured, and it means a local tree read with no server at all.
	if [[ -n "${CTX_SERVER+set}" && -z "$CTX_SERVER" ]]; then
		:
	else
		CTX_SERVER="$(cat "$root/server-url" 2>/dev/null)"
		if [[ -z "$CTX_SERVER" ]]; then
			echo "ctx shim: the personal deployment at $root has no server-url" >&2
			exit 127
		fi
	fi
	export CTX_SERVER
	export CTX_DATA_DIR="${CTX_DATA_DIR-$root/data}"
	export CTX_STATE_DIR="${CTX_STATE_DIR-$root/state}"
	# ctx refuses --memory beside a configured server, so a tree is named only for a local read.
	if [[ -z "$CTX_SERVER" ]]; then export CTX_MEMORY="${CTX_MEMORY-$root/tree}"; else unset CTX_MEMORY; fi
	exec "$real" "$@"
fi

real="$(MISE_GLOBAL_CONFIG_FILE="$_mise_config" "$mise" which -C / ctx --tool github:sjawhar/ctx-memory 2>/dev/null)" || real=""
if [[ -z "$real" || ! -x "$real" ]]; then
	echo "ctx shim: $mise, given $_mise_config and the data dir $_mise_data, did not resolve the pinned github:sjawhar/ctx-memory; run \`mise install\`" >&2
	exit 127
fi

export CTX_SERVER="${CTX_SERVER-http://ctx-memory.tail12ec1c.ts.net}"
exec "$real" "$@"
