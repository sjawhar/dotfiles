#!/usr/bin/python3
"""Owner-aware GitHub App credential helper.

Interpreter is pinned to the system python3, NOT `env python3`: git invokes a credential
helper with the caller's environment, so under any activated virtualenv (a uv run, an agent
shell, a project venv) `env python3` can resolve to an interpreter the helper was never run
under. It needs nothing past the standard library.

Git credential-helper usage (wired up in gh-app-routes.gitconfig):
  gh-app-token <profile> get

Direct usage prints a raw installation token:
  gh-app-token <profile> [--owner <login>] [--repo <name>]... [--read-only]

A returned installation token comes from a cache and may have as little as five minutes
left (TOKEN_REFRESH_MARGIN). A caller that holds it longer sets GH_APP_TOKEN_MIN_LIFETIME
to the seconds it needs: a cached token with less life left than that is not reused, and a
fresh broker release (an hour) is returned instead. `knives gh` sets it for each gh call it
runs, because gh reads its token once and keeps it for the whole call: a `gh run watch`
handed a cached token with twelve minutes left failed with 401 Bad credentials twelve
minutes in (2026-10-22). A fresh release is returned whatever the request: GitHub issues an
installation token for one hour, so asking for an hour (as a watch does) means a fresh token,
never a loop, and a caller needing more than that hour asks again.

A profile lives in git config and needs the App id (which names its covered-owner file) and
the secrets-broker secret holding the App's key; a fallback secret is optional:
  [gh-app "<profile>"]
      app-id          = ...
      broker-secret   = GITHUB_APP_<PERSON>  ; a github-app secret of the secrets broker
      fallback-secret = NAME_OF_SECRET       ; a personal access token, from `secrets get`

The helper never holds the App's key. On a cache miss it asks the secrets broker through
secret-run, which mints the installation tokens:
  secret-run --register --reason "gh-app-token <owner>" GITHUB_APP_<PERSON> -- printenv GITHUB_APP_<PERSON>
and reads the release from its stdout:
  {"installations": {"<owner>": {"installation_id": <int>, "token": "...",
  "expires_at": "<RFC 3339>"}}}
Every owner's token in a release is cached, and every owner and installation id is merged
into a covered-owner file that never shrinks.

--register makes this caller a broker session when it has none, which secret-run does not do
for anyone else. secret-run's rule is that a process with no broker identity reads secretsd, and
that is right for every key secretsd holds; GITHUB_APP_<PERSON> lives in the broker alone, so for
this helper "no identity" could only end in a refusal. Its callers are not a list anyone can keep:
the lane relays, units such as ossv-ops-sync, the speed services, and any job an agent detached,
which systemd --user adopts once the tool call that started it exits, so it no longer descends
from its session's registered root. Registering is what any of them can already do with one
command (`agent-secrets register --exec`), under Sami's machine login, for his agent-tier secret
on his box (dispatch://INFRA-688/ask/83bd712a). secret-run registers only when the client ran and
answered "no identity"; a client that cannot run is still its hard error. It happens only on a
cache miss, so the cache below bounds enrollments at one per miss, not one per call, and each
session ends with the secret-run that made it.

--repo and --read-only narrow the token of one owner (INFRA-322) to those repositories and to
contents:read and metadata:read: secret-run passes them to the broker as --github-owner,
--github-repo and --github-read-only, which mints the narrowed token with GitHub's
access_tokens body. A narrowed token has its own cache entry, so it never reuses or replaces
the owner-wide one, and it never falls back to the personal token, which cannot be narrowed.

The target owner comes from --owner, then GH_APP_OWNER, then the owner segment of the
credential request's path (requires credential.useHttpPath). Whether an owner is covered is
decided from the broker's release and the covered-owner file alone, never from a failed
request:

- Owner in the release: answer with its token. Any broker failure (a pending or denied
  request, an error, a release that does not parse) emits `quit=1`, which stops git's helper
  chain. The fallback secret is never read then, so a broker outage cannot swap identity on
  our own repositories.
- Owner missing from the release but in the covered-owner file: refuse. A release that drops
  an owner it covered before is a contradiction, not permission to act as the human.
- Owner never covered: answer with the profile's fallback secret (the user's personal access
  token for upstream repositories the App is not installed on). No fallback-secret
  configured, or the secret unreadable: `quit=1` naming the cause. Nothing ever falls through
  to the next helper or to the user's keyring login.
"""

import argparse
import fcntl
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, TypedDict

CACHE_DIR = Path.home() / ".cache" / "gh-app-token"
TOKEN_REFRESH_MARGIN = 300  # Refresh five minutes before expiry.
MIN_LIFETIME_ENV = "GH_APP_TOKEN_MIN_LIFETIME"


class AppTokenError(Exception):
    """A configuration, secret, broker or cache failure."""


class UninstalledOwnerError(AppTokenError):
    """The broker released no token for the requested GitHub owner."""


class BrokerInstallation(TypedDict):
    installation_id: int
    token: str
    expires_at: str


def git_config_optional(key: str) -> str | None:
    result = subprocess.run(
        ["git", "config", "--get", key],
        capture_output=True,
        text=True,
        check=False,
    )
    value = result.stdout.strip()
    if result.returncode != 0 or not value:
        return None
    return value


def git_config(key: str) -> str:
    value = git_config_optional(key)
    if value is None:
        raise AppTokenError(f"missing git config: {key}")
    return value


def cache_component(value: str) -> str:
    """Make a profile or owner safe and stable for use in a cache-file name."""
    return re.sub(r"[^A-Za-z0-9._-]", "_", value.lower())


def scope_of(repos: list[str] | None, read_only: bool) -> dict[str, Any] | None:
    """The narrowing --repo/--read-only ask for, in GitHub's access_tokens body shape, or None
    for an owner-wide token."""
    if not repos and not read_only:
        return None
    scope: dict[str, Any] = {}
    if repos:
        scope["repositories"] = sorted({r.split("/")[-1] for r in repos})
    if read_only:
        scope["permissions"] = {"contents": "read", "metadata": "read"}
    return scope


def scope_key(scope: dict[str, Any] | None) -> str:
    """A stable cache-name part for a scope: a scoped token never shares an owner-wide cache entry."""
    if not scope:
        return ""
    perms = ",".join(f"{k}={v}" for k, v in sorted(scope.get("permissions", {}).items()))
    return f"repos={','.join(scope.get('repositories', []))};perms={perms}"


def token_cache_file(profile: str, owner: str, scope: str = "") -> Path:
    """The cache entry for one profile, App, owner and scope. The profile's App id is part of
    the key, so a profile whose app-id changes never gets the old App's token back (2026-10-26:
    a corrected review profile kept answering with the first App's cached token)."""
    app_id = git_config_optional(f"gh-app.{profile}.app-id") or "none"
    suffix = f"--{cache_component(scope)}" if scope else ""
    return CACHE_DIR / (
        f"token-{cache_component(profile)}--app-{cache_component(app_id)}"
        f"--{cache_component(owner)}{suffix}.json"
    )


def required_lifetime() -> int:
    """Seconds a returned token must stay valid: the caller's GH_APP_TOKEN_MIN_LIFETIME,
    never less than TOKEN_REFRESH_MARGIN."""
    raw = os.environ.get(MIN_LIFETIME_ENV, "")
    if not raw:
        return TOKEN_REFRESH_MARGIN
    try:
        requested = int(raw)
    except ValueError:
        raise AppTokenError(f"{MIN_LIFETIME_ENV} must be a whole number of seconds, not {raw!r}") from None
    return max(TOKEN_REFRESH_MARGIN, requested)


def get_cached_token(profile: str, owner: str, min_lifetime: int = TOKEN_REFRESH_MARGIN, scope: str = "") -> str | None:
    cache_file = token_cache_file(profile, owner, scope)
    if not cache_file.exists():
        return None
    try:
        data = json.loads(cache_file.read_text())
        expires_at = datetime.fromisoformat(data["expires_at"].replace("Z", "+00:00"))
        if (expires_at - datetime.now(timezone.utc)).total_seconds() > min_lifetime:
            return data["token"]
    except (json.JSONDecodeError, KeyError, TypeError, ValueError):
        return None
    return None


def write_cache_file(cache_file: Path, data: dict[str, Any]) -> None:
    """Atomically replace a mode-0600 JSON cache entry."""
    temporary_path: Path | None = None
    try:
        CACHE_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
        with tempfile.NamedTemporaryFile(
            mode="w",
            encoding="utf-8",
            dir=CACHE_DIR,
            prefix=f".{cache_file.name}.",
            delete=False,
        ) as temporary:
            temporary.write(json.dumps(data))
            temporary.flush()
            os.fsync(temporary.fileno())
            temporary_path = Path(temporary.name)
        temporary_path.chmod(0o600)
        os.replace(temporary_path, cache_file)
    except OSError as error:
        raise AppTokenError("failed to write credential cache") from error
    finally:
        if temporary_path is not None:
            try:
                temporary_path.unlink(missing_ok=True)
            except OSError:
                pass


def covered_owners_file(app_id: str) -> Path:
    return CACHE_DIR / f"covered-{cache_component(app_id)}.json"


def covered_owners_lock_file(app_id: str) -> Path:
    return CACHE_DIR / f"covered-{cache_component(app_id)}.lock"


def remember_covered_owners(app_id: str, installations: dict[str, int]) -> None:
    """Record every owner this App has ever been seen installed on.

    Unlike the token caches, this is never expired and never shrinks: it is what lets a
    later release that omits a known owner be treated as the contradiction it is, instead
    of as permission to hand out the personal token. The read-merge-write runs under one
    lock, so two concurrent cache misses never drop each other's owners.
    """
    try:
        CACHE_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
        with covered_owners_lock_file(app_id).open("a", encoding="utf-8") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            covered = covered_owners(app_id)
            updated = {**covered, **installations}
            if updated != covered:
                write_cache_file(covered_owners_file(app_id), updated)
    except OSError as error:
        raise AppTokenError("failed to update covered-owner cache") from error


def covered_owners(app_id: str) -> dict[str, int]:
    """The covered-owner file. A damaged one is unknown coverage, never an empty one."""
    cache_file = covered_owners_file(app_id)
    if not cache_file.exists():
        return {}
    try:
        data = json.loads(cache_file.read_text())
    except (json.JSONDecodeError, OSError, UnicodeDecodeError) as error:
        raise AppTokenError("invalid covered-owner cache") from error
    if not isinstance(data, dict):
        raise AppTokenError("invalid covered-owner cache")

    covered: dict[str, int] = {}
    for owner, installation_id in data.items():
        normalized_owner = owner.casefold() if isinstance(owner, str) else ""
        if (
            not normalized_owner
            or not isinstance(installation_id, int)
            or isinstance(installation_id, bool)
            or normalized_owner in covered
        ):
            raise AppTokenError("invalid covered-owner cache")
        covered[normalized_owner] = installation_id
    return covered


def log_decision(profile: str, owner: str, request: dict[str, str], decision: str, detail: str) -> None:
    """One line per invocation in the cache dir, so a misattributed action is
    answerable after the fact: which owner was resolved, from what path, and
    whether the App, the personal token, or a refusal answered. Never the token
    itself - four characters of prefix say which kind it was (ghs_ App, ghp_
    personal) - and never the broker's output. 2026-09-17: two review verdicts went
    out as the human and nothing recorded which of these paths produced them.
    """
    try:
        CACHE_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
        path = CACHE_DIR / "decisions.log"
        # Cap it. Every gh call of every gate runs through this shim, and on
        # 2026-10-30 the log reached 751 MB with no rotation while the root disk
        # went to zero free and Dispatch writes failed with ENOSPC. One previous
        # generation is kept, so the answer to "which path produced that verdict"
        # survives a rotation.
        try:
            if path.stat().st_size > 32 * 1024 * 1024:
                path.replace(CACHE_DIR / "decisions.log.1")
        except FileNotFoundError:
            pass
        with path.open("a") as log:
            log.write(
                json.dumps(
                    {
                        "at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
                        "profile": profile,
                        "owner": owner,
                        "path": request.get("path", ""),
                        "decision": decision,
                        "detail": detail,
                        "pid": os.getpid(),
                        "ppid": os.getppid(),
                        "cwd": os.getcwd(),
                        "session": os.environ.get("OMP_SESSION_ID", ""),
                    }
                )
                + "\n"
            )
    except OSError:
        pass  # the log is diagnostics; never fail a mint because of it


def mise_shims() -> Path:
    """mise's shims dir.

    mise runs [settings.github] credential_command with its own shims dir taken off PATH,
    and outside an interactive shell (where `mise activate` adds the install dirs) that dir
    is the only place `secrets` and `agent-secrets` are found: every mint then failed
    (2026-10-24, INFRA-219).
    """
    return Path(os.environ.get("MISE_DATA_DIR") or Path.home() / ".mise") / "shims"


def secrets_executable() -> str:
    """`secrets` on PATH, else mise's shim for it (mise_shims)."""
    return shutil.which("secrets") or str(mise_shims() / "secrets")


def secret_run_command() -> tuple[str, dict[str, str]]:
    """secret-run on PATH, else the one in this shim's own checkout, and the environment to run
    it in: the caller's, with mise's shims dir after its PATH, so secret-run finds
    agent-secrets (the broker) and secrets where the caller's PATH lacks them (mise_shims)."""
    executable = shutil.which("secret-run") or str(Path(__file__).resolve().parents[1] / "scripts" / "secret-run")
    environment = dict(os.environ)
    environment["PATH"] = os.pathsep.join(part for part in (environment.get("PATH", ""), str(mise_shims())) if part)
    return executable, environment


def resolve_secret(name: str) -> str:
    """Read the upstream personal-access-token fallback from secretsd. The App's key is the
    broker's alone, and never read here."""
    try:
        result = subprocess.run(
            [secrets_executable(), "get", name, "--value"],
            capture_output=True,
            text=True,
            check=True,
        )
    except (subprocess.CalledProcessError, FileNotFoundError) as error:
        detail = (getattr(error, "stderr", None) or "").strip() or str(error)
        raise AppTokenError(f"failed to fetch secret {name}: {detail}") from error
    value = result.stdout.strip()
    if not value:
        raise AppTokenError(f"empty secret {name}")
    return value


def fallback_token(profile: str, owner: str) -> str:
    """The profile's personal access token for an owner the App is not installed on.

    Read from secretsd on every request; the token is static, so no cache file is written
    for it. Never silent: the identity about to act is the human's, and the caller has no
    other way to tell.
    """
    app_id = git_config(f"gh-app.{profile}.app-id")
    known = covered_owners(app_id).get(owner.casefold())
    if known is not None:
        # 2026-09-17: two review verdicts on trajectory-labs-pbc/agent-c went
        # out as the human because a discovery omitted an owner the App covers
        # and this path handed out the personal token without a word.
        raise AppTokenError(
            f"owner {owner} was installed for App {app_id} (installation {known}) and is now "
            "missing from the broker's release; refusing to fall back to the personal token. If "
            f"the App really was uninstalled there, delete {covered_owners_file(app_id)} to "
            "re-enable the fallback for it"
        )
    fallback_secret = git_config_optional(f"gh-app.{profile}.fallback-secret")
    if fallback_secret is None:
        raise AppTokenError(
            f"no App installation for owner {owner} and no fallback-secret on profile {profile}"
        )
    print(
        f"gh-app-token: no App installation for owner {owner}; using the personal token "
        f"{fallback_secret} - this call will act as its user, not as the App",
        file=sys.stderr,
    )
    return resolve_secret(fallback_secret)


def parse_broker_installations(release: str) -> dict[str, BrokerInstallation]:
    """Validate a broker release without putting any of it in an error."""
    try:
        data = json.loads(release)
    except json.JSONDecodeError as error:
        raise AppTokenError("broker returned invalid installations JSON") from error
    if not isinstance(data, dict) or not isinstance(data.get("installations"), dict):
        raise AppTokenError("broker returned invalid installations JSON")

    parsed: dict[str, BrokerInstallation] = {}
    for owner, installation in data["installations"].items():
        if not isinstance(owner, str) or not owner or not isinstance(installation, dict):
            raise AppTokenError("broker returned invalid installations JSON")
        installation_id = installation.get("installation_id")
        token = installation.get("token")
        expires_at = installation.get("expires_at")
        if (
            not isinstance(installation_id, int)
            or isinstance(installation_id, bool)
            or not isinstance(token, str)
            or not token
            or not isinstance(expires_at, str)
        ):
            raise AppTokenError("broker returned invalid installations JSON")
        try:
            expiration = datetime.fromisoformat(expires_at.replace("Z", "+00:00"))
        except ValueError as error:
            raise AppTokenError("broker returned invalid installations JSON") from error
        normalized_owner = owner.casefold()
        if expiration.tzinfo is None or normalized_owner in parsed:
            raise AppTokenError("broker returned invalid installations JSON")
        parsed[normalized_owner] = {
            "installation_id": installation_id,
            "token": token,
            "expires_at": expires_at,
        }
    return parsed


def request_broker_installations(
    secret_name: str, owner: str, scope: dict[str, Any] | None = None
) -> dict[str, BrokerInstallation]:
    """Ask the broker for a release of secret_name through secret-run, capturing its stdout
    without logging it. With scope, the release is narrowed to owner's installation, its
    repositories and its read-only permissions."""
    executable, environment = secret_run_command()
    narrowing: list[str] = []
    if scope:
        narrowing = ["--github-owner", owner]
        for repository in scope.get("repositories", []):
            narrowing += ["--github-repo", repository]
        if scope.get("permissions"):
            narrowing.append("--github-read-only")
    command = [
        executable,
        "--register",
        "--reason",
        f"gh-app-token {owner}",
        *narrowing,
        secret_name,
        "--",
        "printenv",
        secret_name,
    ]
    try:
        result = subprocess.run(command, capture_output=True, text=True, check=False, env=environment)
    except FileNotFoundError as error:
        raise AppTokenError("secret-run is not available") from error
    except (OSError, UnicodeDecodeError) as error:
        raise AppTokenError("failed to run secret-run") from error
    if result.returncode == 75:
        raise AppTokenError(
            f"broker request for {secret_name} is pending; run agent-secrets-login before retrying"
        )
    if result.returncode == 77:
        raise AppTokenError(
            f"broker request for {secret_name} was denied; run agent-secrets-login before retrying"
        )
    if result.returncode:
        # agent-secrets names the cause on the first line of stderr (broker unreachable, an old
        # broker that cannot narrow, an old client that lacks a flag) and never a value there;
        # the release itself goes only to stdout.
        cause = result.stderr.strip().splitlines()[:1] or ["no message"]
        detail = f"broker request for {secret_name} failed (exit {result.returncode}): {cause[0]}"
        if scope:
            detail += "; a --repo/--read-only token has no fallback"
        raise AppTokenError(detail)
    return parse_broker_installations(result.stdout)


def select_owner(explicit_owner: str | None, request: dict[str, str]) -> str | None:
    """Apply --owner > GH_APP_OWNER > credential-request-path precedence."""
    path_owner = request.get("path", "").lstrip("/").split("/", 1)[0]
    return explicit_owner or os.environ.get("GH_APP_OWNER") or path_owner or None


def get_token(
    profile: str, owner: str, min_lifetime: int = TOKEN_REFRESH_MARGIN, scope: dict[str, Any] | None = None
) -> str:
    """Return a token for one owner (narrowed by scope when given), never reusing another owner's
    or another scope's cache, and never a cached one with min_lifetime seconds or less left."""
    owner = owner.casefold()
    key = scope_key(scope)
    cached_token = get_cached_token(profile, owner, min_lifetime, key)
    if cached_token:
        return cached_token

    app_id = git_config(f"gh-app.{profile}.app-id")
    broker_secret = git_config(f"gh-app.{profile}.broker-secret")
    print(
        f"gh-app-token: minting token for profile {profile} (owner={owner}{', ' + key if key else ''}) through the broker...",
        file=sys.stderr,
    )
    installations = request_broker_installations(broker_secret, owner, scope)
    remember_covered_owners(
        app_id,
        {name: installation["installation_id"] for name, installation in installations.items()},
    )
    if not scope:
        # An owner-wide release holds every covered owner's token: cache them all. A narrowed
        # one is cached under its scope alone, never in an owner-wide entry.
        for name, installation in installations.items():
            write_cache_file(
                token_cache_file(profile, name),
                {"token": installation["token"], "expires_at": installation["expires_at"]},
            )
    installation = installations.get(owner)
    if installation is None:
        raise UninstalledOwnerError(f"GitHub App is not installed for owner {owner}")
    if scope:
        write_cache_file(
            token_cache_file(profile, owner, key),
            {"token": installation["token"], "expires_at": installation["expires_at"]},
        )
    return installation["token"]


def read_credential_request() -> dict[str, str]:
    request: dict[str, str] = {}
    for raw_line in sys.stdin:
        line = raw_line.strip()
        if not line:
            break
        if "=" in line:
            key, _, value = line.partition("=")
            request[key] = value
    return request


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Return a target-owner GitHub App installation token from the secrets broker."
    )
    parser.add_argument("profile")
    parser.add_argument("action", choices=("get", "store", "erase"), nargs="?")
    parser.add_argument("--owner", metavar="LOGIN")
    parser.add_argument(
        "--repo", metavar="NAME", action="append",
        help="narrow the token to this repository of the owner (repeatable); never falls back to the personal token",
    )
    parser.add_argument(
        "--read-only", action="store_true",
        help="narrow the token to contents:read and metadata:read; never falls back to the personal token",
    )
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    args = parse_args(sys.argv[1:] if argv is None else argv)
    if args.action in {"store", "erase"}:
        return 0

    credential_mode = args.action == "get"
    request = read_credential_request() if credential_mode else {}
    if credential_mode and request.get("host", "").casefold() != "github.com":
        return 0

    owner = select_owner(args.owner, request)
    if owner is None:
        # No owner signal at all (e.g. useHttpPath disabled). In credential
        # mode this is indistinguishable from an unrouted request: answer
        # nothing. No helper is configured behind this one, so git ends with
        # "could not read Username".
        if credential_mode:
            return 0
        print("gh-app-token: target owner required: pass --owner or set GH_APP_OWNER", file=sys.stderr)
        return 1

    scope = scope_of(args.repo, args.read_only)
    try:
        try:
            token = get_token(args.profile, owner, required_lifetime(), scope)
            decision = "app"
        except UninstalledOwnerError:
            if scope:
                # A narrowed token was asked for; the personal token cannot be narrowed.
                raise AppTokenError(
                    f"no App installation for owner {owner}; a --repo/--read-only token has no fallback"
                ) from None
            token = fallback_token(args.profile, owner)
            decision = "fallback-personal-token"
    except AppTokenError as error:
        log_decision(args.profile, owner, request, "refused", str(error))
        print(f"gh-app-token: {error}", file=sys.stderr)
        if credential_mode:
            # Stop git's helper chain: a broker failure, or an uncovered owner
            # with no usable fallback, must fail loudly, never silently fall
            # back to the user's own credentials.
            print("quit=1")
        return 1
    log_decision(args.profile, owner, request, decision, f"token={token[:4]}…")

    if credential_mode:
        print(f"protocol={request.get('protocol', 'https')}")
        print(f"host={request.get('host', 'github.com')}")
        print("username=x-access-token")
        print(f"password={token}")
    else:
        print(token)
    return 0


if __name__ == "__main__":
    sys.exit(main())
