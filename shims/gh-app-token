def default_cache_dir() -> Path:
    """The token cache, covered-owner files and decisions.log: /mnt/nvme/<user>/gh-app-token on a
    machine with that disk, else ~/.cache/gh-app-token. On sami-rocqperf ~/.cache is on the root disk,
    whose ext4 journal ran out of space under load: on 2026-11-03 at 09:50Z 428 helper processes sat
    writing decisions.log there and every push on the box hung.

    /mnt/nvme/<user> counts only when this process can write it. Inside an agent box that does not bind
    it, the path exists as an empty root-owned directory, and choosing it failed every push from that box
    with 'failed to update covered-owner cache' (LINUX-1274, 2026-11-04 12:57Z)."""
    user = os.environ.get("USER") or ""
    nvme = Path("/mnt/nvme", user)
    if user and nvme.is_dir() and os.access(nvme, os.W_OK | os.X_OK):
        return nvme / "gh-app-token"
    return Path.home() / ".cache" / "gh-app-token"


OLD_CACHE_DIR = Path.home() / ".cache" / "gh-app-token"
DEFAULT_CACHE_DIR = default_cache_dir()
CACHE_DIR = DEFAULT_CACHE_DIR
MOVED_NOTE = "MOVED.txt"


def seed_cache_dir(new: Path, old: Path) -> None:
    """Once, when the cache moves: copy the cached tokens and covered-owner files from the old
    directory (modes kept, 0600) into a new one built aside and published by one rename, and leave a
    note in the old directory saying where the cache is now. decisions.log is not copied; it stays in
    the old directory as the record up to the move. Failure leaves the new directory to fill itself."""
    if new == old or new.exists() or not old.is_dir():
        return
    try:
        new.parent.mkdir(parents=True, exist_ok=True)
        partial = Path(tempfile.mkdtemp(prefix=f".{new.name}.", dir=new.parent))
        try:
            for entry in old.iterdir():
                if entry.is_file() and entry.name.endswith(".json") and entry.name.startswith(("token-", "covered-")):
                    shutil.copy2(entry, partial / entry.name)
            os.rename(partial, new)
        finally:
            if partial.exists():
                shutil.rmtree(partial, ignore_errors=True)
        note = old / MOVED_NOTE
        if not note.exists():
            note.write_text(
                f"gh-app-token's cache and decisions.log moved to {new} on "
                f"{datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')}: this disk's journal stalled every "
                "write to decisions.log (2026-11-03). Nothing here is written any more; decisions.log here is the "
                "record up to the move.\n"
            )
    except OSError:
        pass


GITHUB_API = "https://api.github.com"
TOKEN_REFRESH_MARGIN = 300  # Refresh five minutes before expiry.
# How old a cached token's last check at GitHub may be before it is checked again
# (live_cached_token), and how long each connect or read of that check waits for GitHub.
LIVENESS_INTERVAL = 60
LIVENESS_TIMEOUT = 5
MIN_LIFETIME_ENV = "GH_APP_TOKEN_MIN_LIFETIME"
# An agent box gets its broker identity after it starts, not before: scripts/agentbox puts
# enrollment.pending in the box's key dir ahead of `docker run` and keeps it fresh until the
# enrollment ends, which took 116 s from box start on 2026-11-01 and 132 s on the same host an
# hour later, both at load 400 (a keygen inside the box, then the broker call). The agent-secrets
# client waits 20 s for that marker and then fails the call,
# so the first GitHub command of a new box - the normal case, since `agentbox new … -- omp
# --resume <id>` gives the agent a prompt at once - failed with "no session identity" and git was
# told quit=1, which reads as "this box has no GitHub access" rather than "wait" (INFRA-702).
# Wait here for that enrollment to END, but only while the marker says one is under way: nothing
# else creates it, a host session's key dir holds none (its $XDG_RUNTIME_DIR/agent-secrets keeps
# only the helper's socket), and the launcher removes it on success and on failure alike, so the
# 20 s wait of the client stays the whole story everywhere else. The key dir is the one the
# client reads, its default included, since an environment that dropped AGENT_SECRETS_* still
# reaches the box's key dir through XDG_RUNTIME_DIR, and the client would then meet the marker
# with only its own 20 s. The bound is generous because the marker is the real guard: it is
# renewed only while the launcher is still working, so a launcher that dies or gives up ends the
# wait inside the freshness window below, which is the client's own.
ENROLLMENT_MARKER = "enrollment.pending"
ENROLLMENT_MARKER_FRESH_SECONDS = 160
ENROLLMENT_WAIT_SECONDS = 300
# The lines the agent-secrets client prints while it waits for the launcher itself, before its
# own refusal or its success; neither is ever the cause of a failed call (broker_failure_cause).
CLIENT_ENROLLMENT_NOTICES = (
