#!/usr/bin/python3
"""Owner-aware GitHub App credential helper.

Git credential-helper usage (wired up in gh-app-routes.gitconfig):
  gh-app-token <profile> get

Direct usage prints a raw installation token:
  gh-app-token <profile> [--owner <login>]

A returned installation token comes from a cache and may have as little as five
minutes left (TOKEN_REFRESH_MARGIN). A caller that holds it longer sets
GH_APP_TOKEN_MIN_LIFETIME to the seconds it needs: a cached token with less
life left than that is not reused, and a fresh broker release is returned
instead. `knives gh` sets it for each gh call it runs, because gh reads its
token once and keeps it for the whole call.

A profile lives in git config and needs the App identifier (to keep its
historical-covered-owner file stable), the broker secret, and optionally a
fallback secret:
  [gh-app "<profile>"]
      app-id          = ...
      broker-secret   = GITHUB_APP_<PERSON>
      fallback-secret = NAME_OF_SECRET   ; a personal access token

On a cache miss the helper runs:
  secret-run --reason "gh-app-token <owner>" GITHUB_APP_<PERSON> -- \
      printenv GITHUB_APP_<PERSON>

The captured stdout is the broker's JSON release:
  {"installations": {"<owner>": {"installation_id": <int>, "token": "...",
  "expires_at": "<RFC 3339>"}}}

Every release's installation tokens are cached. Every release's owner and
installation ID are merged into a never-shrinking coverage file. That file
prevents a later release that omits a formerly covered owner from permitting
the personal-token fallback.

The target owner comes from --owner, then GH_APP_OWNER, then the owner segment
of the credential request's path (requires credential.useHttpPath).
"""

import argparse
import fcntl
import json
import os
import re
import subprocess
import sys
import tempfile
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, TypedDict

CACHE_DIR = Path.home() / ".cache" / "gh-app-token"
TOKEN_REFRESH_MARGIN = 300  # Refresh five minutes before expiry.
MIN_LIFETIME_ENV = "GH_APP_TOKEN_MIN_LIFETIME"


class AppTokenError(Exception):
    """A configuration, broker, or cache failure."""


class UninstalledOwnerError(AppTokenError):
    """The broker did not release a token for the requested GitHub owner."""


class BrokerInstallation(TypedDict):
    installation_id: int
    token: str
    expires_at: str


def git_config_optional(key: str) -> str | None:
    result = subprocess.run(
        ["git", "config", "--get", key],
        capture_output=True,
        text=True,
        check=False,
    )
    value = result.stdout.strip()
    if result.returncode != 0 or not value:
        return None
    return value


def git_config(key: str) -> str:
    value = git_config_optional(key)
    if value is None:
        raise AppTokenError(f"missing git config: {key}")
    return value


def cache_component(value: str) -> str:
    """Make a profile or owner safe and stable for use in a cache-file name."""
    return re.sub(r"[^A-Za-z0-9._-]", "_", value.lower())


def token_cache_file(profile: str, owner: str) -> Path:
    return CACHE_DIR / f"token-{cache_component(profile)}--{cache_component(owner)}.json"


def required_lifetime() -> int:
    """Seconds a returned token must stay valid: the caller's requested lifetime,
    never less than TOKEN_REFRESH_MARGIN."""
    raw = os.environ.get(MIN_LIFETIME_ENV, "")
    if not raw:
        return TOKEN_REFRESH_MARGIN
    try:
        requested = int(raw)
    except ValueError:
        raise AppTokenError(f"{MIN_LIFETIME_ENV} must be a whole number of seconds, not {raw!r}") from None
    return max(TOKEN_REFRESH_MARGIN, requested)


def get_cached_token(profile: str, owner: str, min_lifetime: int = TOKEN_REFRESH_MARGIN) -> str | None:
    cache_file = token_cache_file(profile, owner)
    if not cache_file.exists():
        return None
    try:
        data = json.loads(cache_file.read_text())
    except (json.JSONDecodeError, OSError, UnicodeDecodeError) as error:
        raise AppTokenError("failed to read token cache") from error
    if not isinstance(data, dict):
        return None
    token = data.get("token")
    expires_at = data.get("expires_at")
    if not isinstance(token, str) or not token or not isinstance(expires_at, str):
        return None
    try:
        expiration = datetime.fromisoformat(expires_at.replace("Z", "+00:00"))
    except ValueError:
        return None
    if expiration.tzinfo is not None and (
        expiration - datetime.now(timezone.utc)
    ).total_seconds() > min_lifetime:
        return token
    return None


def write_cache_file(cache_file: Path, data: dict[str, Any]) -> None:
    """Atomically replace a mode-0600 JSON cache entry."""
    temporary_path: Path | None = None
    try:
        CACHE_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
        with tempfile.NamedTemporaryFile(
            mode="w",
            encoding="utf-8",
            dir=CACHE_DIR,
            prefix=f".{cache_file.name}.",
            delete=False,
        ) as temporary:
            temporary.write(json.dumps(data))
            temporary.flush()
            os.fsync(temporary.fileno())
            temporary_path = Path(temporary.name)
        temporary_path.chmod(0o600)
        os.replace(temporary_path, cache_file)
    except OSError as error:
        raise AppTokenError("failed to write credential cache") from error
    finally:
        if temporary_path is not None:
            try:
                temporary_path.unlink(missing_ok=True)
            except OSError:
                pass


def covered_owners_file(app_id: str) -> Path:
    return CACHE_DIR / f"covered-{cache_component(app_id)}.json"


def covered_owners_lock_file(app_id: str) -> Path:
    return CACHE_DIR / f"covered-{cache_component(app_id)}.lock"


def remember_covered_owners(app_id: str, installations: dict[str, int]) -> None:
    """Merge coverage under one lock, so permanent owner history never shrinks."""
    try:
        CACHE_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
        with covered_owners_lock_file(app_id).open("a", encoding="utf-8") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            covered = covered_owners(app_id)
            updated = {**covered, **installations}
            if updated != covered:
                write_cache_file(covered_owners_file(app_id), updated)
    except OSError as error:
        raise AppTokenError("failed to update covered-owner cache") from error


def covered_owners(app_id: str) -> dict[str, int]:
    cache_file = covered_owners_file(app_id)
    if not cache_file.exists():
        return {}
    try:
        data = json.loads(cache_file.read_text())
    except (json.JSONDecodeError, OSError, UnicodeDecodeError) as error:
        raise AppTokenError("invalid covered-owner cache") from error
    if not isinstance(data, dict):
        raise AppTokenError("invalid covered-owner cache")

    covered: dict[str, int] = {}
    for owner, installation_id in data.items():
        normalized_owner = owner.casefold() if isinstance(owner, str) else ""
        if (
            not normalized_owner
            or not isinstance(installation_id, int)
            or isinstance(installation_id, bool)
            or normalized_owner in covered
        ):
            raise AppTokenError("invalid covered-owner cache")
        covered[normalized_owner] = installation_id
    return covered


def log_decision(profile: str, owner: str, request: dict[str, str], decision: str) -> None:
    """Record which credential path answered without recording credential data."""
    try:
        CACHE_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
        with (CACHE_DIR / "decisions.log").open("a") as log:
            log.write(
                json.dumps(
                    {
                        "at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
                        "profile": profile,
                        "owner": owner,
                        "path": request.get("path", ""),
                        "decision": decision,
                        "pid": os.getpid(),
                        "ppid": os.getppid(),
                        "cwd": os.getcwd(),
                        "session": os.environ.get("OMP_SESSION_ID", ""),
                    }
                )
                + "\n"
            )
    except OSError:
        pass  # Diagnostics must never prevent credential use.


def resolve_secret(name: str) -> str:
    """Read only the upstream personal-access-token fallback from secretsd."""
    try:
        result = subprocess.run(
            ["secrets", "get", name, "--value"],
            capture_output=True,
            text=True,
            check=True,
        )
    except (subprocess.CalledProcessError, FileNotFoundError) as error:
        detail = (getattr(error, "stderr", None) or "").strip() or str(error)
        raise AppTokenError(f"failed to fetch secret {name}: {detail}") from error
    value = result.stdout.strip()
    if not value:
        raise AppTokenError(f"empty secret {name}")
    return value


def fallback_token(profile: str, owner: str) -> str:
    """Return the personal token only for an owner never covered by the App."""
    app_id = git_config(f"gh-app.{profile}.app-id")
    known = covered_owners(app_id).get(owner.casefold())
    if known is not None:
        raise AppTokenError(
            f"owner {owner} was installed for App {app_id} (installation {known}) and is now "
            "missing from the broker release; refusing to fall back to the personal token. If "
            f"the App really was uninstalled there, delete {covered_owners_file(app_id)} to "
            "re-enable the fallback for it"
        )
    fallback_secret = git_config_optional(f"gh-app.{profile}.fallback-secret")
    if fallback_secret is None:
        raise AppTokenError(
            f"no App installation for owner {owner} and no fallback-secret on profile {profile}"
        )
    print(
        f"gh-app-token: no App installation for owner {owner}; using the personal token "
        f"{fallback_secret} - this call will act as its user, not as the App",
        file=sys.stderr,
    )
    return resolve_secret(fallback_secret)


def parse_broker_installations(release: str) -> dict[str, BrokerInstallation]:
    """Validate a broker release without including its credential data in errors."""
    try:
        data = json.loads(release)
    except json.JSONDecodeError as error:
        raise AppTokenError("broker returned invalid installations JSON") from error
    if not isinstance(data, dict) or not isinstance(data.get("installations"), dict):
        raise AppTokenError("broker returned invalid installations JSON")

    parsed: dict[str, BrokerInstallation] = {}
    for owner, installation in data["installations"].items():
        if not isinstance(owner, str) or not owner or not isinstance(installation, dict):
            raise AppTokenError("broker returned invalid installations JSON")
        installation_id = installation.get("installation_id")
        token = installation.get("token")
        expires_at = installation.get("expires_at")
        if (
            not isinstance(installation_id, int)
            or isinstance(installation_id, bool)
            or not isinstance(token, str)
            or not token
            or not isinstance(expires_at, str)
        ):
            raise AppTokenError("broker returned invalid installations JSON")
        try:
            expiration = datetime.fromisoformat(expires_at.replace("Z", "+00:00"))
        except ValueError as error:
            raise AppTokenError("broker returned invalid installations JSON") from error
        normalized_owner = owner.casefold()
        if expiration.tzinfo is None or normalized_owner in parsed:
            raise AppTokenError("broker returned invalid installations JSON")
        parsed[normalized_owner] = {
            "installation_id": installation_id,
            "token": token,
            "expires_at": expires_at,
        }
    return parsed


def request_broker_installations(secret_name: str, owner: str) -> dict[str, BrokerInstallation]:
    """Ask secret-run for the broker release, capturing its stdout without logging it."""
    command = [
        "secret-run",
        "--reason",
        f"gh-app-token {owner}",
        secret_name,
        "--",
        "printenv",
        secret_name,
    ]
    try:
        result = subprocess.run(command, capture_output=True, text=True, check=False)
    except FileNotFoundError as error:
        raise AppTokenError("secret-run is not available") from error
    except (OSError, UnicodeDecodeError) as error:
        raise AppTokenError("failed to run secret-run") from error
    if result.returncode == 75:
        raise AppTokenError(
            f"broker request for {secret_name} is pending; run agent-secrets-login before retrying"
        )
    if result.returncode == 77:
        raise AppTokenError(
            f"broker request for {secret_name} was denied; run agent-secrets-login before retrying"
        )
    if result.returncode:
        raise AppTokenError(f"broker request for {secret_name} failed (exit {result.returncode})")
    return parse_broker_installations(result.stdout)


def cache_broker_installations(
    profile: str, app_id: str, installations: dict[str, BrokerInstallation]
) -> None:
    """Persist every owner in one broker release before selecting the requested one."""
    remember_covered_owners(
        app_id,
        {owner: installation["installation_id"] for owner, installation in installations.items()},
    )
    for owner, installation in installations.items():
        write_cache_file(
            token_cache_file(profile, owner),
            {"token": installation["token"], "expires_at": installation["expires_at"]},
        )


def get_token(profile: str, owner: str, min_lifetime: int = TOKEN_REFRESH_MARGIN) -> str:
    """Return a token for one owner, never reusing another owner's cache."""
    owner = owner.casefold()
    cached_token = get_cached_token(profile, owner, min_lifetime)
    if cached_token:
        return cached_token

    app_id = git_config(f"gh-app.{profile}.app-id")
    broker_secret = git_config(f"gh-app.{profile}.broker-secret")
    installations = request_broker_installations(broker_secret, owner)
    cache_broker_installations(profile, app_id, installations)
    installation = installations.get(owner)
    if installation is None:
        raise UninstalledOwnerError(f"GitHub App is not installed for owner {owner}")
    return installation["token"]


def read_credential_request() -> dict[str, str]:
    request: dict[str, str] = {}
    for raw_line in sys.stdin:
        line = raw_line.strip()
        if not line:
            break
        if "=" in line:
            key, _, value = line.partition("=")
            request[key] = value
    return request


def select_owner(explicit_owner: str | None, request: dict[str, str]) -> str | None:
    """Apply --owner > GH_APP_OWNER > credential-request-path precedence."""
    path_owner = request.get("path", "").lstrip("/").split("/", 1)[0]
    return explicit_owner or os.environ.get("GH_APP_OWNER") or path_owner or None


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Return a target-owner GitHub App installation token."
    )
    parser.add_argument("profile")
    parser.add_argument("action", choices=("get", "store", "erase"), nargs="?")
    parser.add_argument("--owner", metavar="LOGIN")
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    args = parse_args(sys.argv[1:] if argv is None else argv)
    if args.action in {"store", "erase"}:
        return 0

    credential_mode = args.action == "get"
    request = read_credential_request() if credential_mode else {}
    if credential_mode and request.get("host", "").casefold() != "github.com":
        return 0

    owner = select_owner(args.owner, request)
    if owner is None:
        if credential_mode:
            return 0
        print("gh-app-token: target owner required: pass --owner or set GH_APP_OWNER", file=sys.stderr)
        return 1

    try:
        try:
            token = get_token(args.profile, owner, required_lifetime())
            decision = "app"
        except UninstalledOwnerError:
            token = fallback_token(args.profile, owner)
            decision = "fallback-personal-token"
    except AppTokenError as error:
        log_decision(args.profile, owner, request, "refused")
        print(f"gh-app-token: {error}", file=sys.stderr)
        if credential_mode:
            # Stop git's helper chain: no broker or fallback failure may silently
            # continue to the user's own credentials.
            print("quit=1")
        return 1
    log_decision(args.profile, owner, request, decision)

    if credential_mode:
        print(f"protocol={request.get('protocol', 'https')}")
        print(f"host={request.get('host', 'github.com')}")
        print("username=x-access-token")
        print(f"password={token}")
    else:
        print(token)
    return 0


if __name__ == "__main__":
    sys.exit(main())
