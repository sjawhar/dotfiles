class AppTokenError(Exception):
    """A configuration, secret, broker or cache failure."""


class UninstalledOwnerError(AppTokenError):
    """The broker released no token for the requested GitHub owner."""


class RefusedOwnerError(AppTokenError):
    """This machine must not issue a token for the requested owner."""


class BrokerInstallation(TypedDict):
    installation_id: int
    token: str
    expires_at: str


def git_config_optional(key: str) -> str | None:
    result = subprocess.run(
        ["git", "config", "--get", key],
        capture_output=True,
        text=True,
        check=False,
    )
    value = result.stdout.strip()
    if result.returncode != 0 or not value:
        return None
    return value


def refused_owners(profile: str) -> frozenset[str]:
    """The owners this machine refuses for profile, casefolded: every gh-app.<profile>.refuse-owner
    in ~/.config/git/config, the machine's own git config, found from HOME at each call.

    git reads that one file, named with --file, and runs in / so that it finds no repository. A plain
    `git config` reads $XDG_CONFIG_HOME/git/config in its place whenever XDG_CONFIG_HOME is set, and
    Legion panes set it to a directory with no git config, so there every refusal was skipped
    (HOME-216). ~/.gitconfig, GIT_CONFIG_GLOBAL, the system config and a repository's config are never
    read: other machines share the first, and a repository is not the machine.

    Not lenient like git_config_optional, for which any failure means "not set": that would serve a
    refused owner whenever git cannot read the file. git exits 1 for a missing file and for a file it
    may not open alike, so the file system decides "missing" against "cannot see" before git runs:
    - No file at the path: no owner is refused.
    - A dangling link at the path, a file this process may not read, or a path it cannot look up
      (an unsearchable ~/.config or ~/.config/git): every owner is refused.
    Then git's exit 0 gives the owners, and exit 1 with nothing on stdout means the key is not set, so
    no owner is refused. git's stderr is not read: GIT_TRACE and a git wrapper on PATH write there on
    every call. Any other exit, such as 128 for a file git cannot parse, or a git that cannot run,
    raises AppTokenError, so every owner is refused."""
    key = f"gh-app.{profile}.refuse-owner"
    config = Path.home() / ".config" / "git" / "config"
    failure = f"failed to read {key} from {config}, so every owner is refused"
    try:
        os.stat(config)
    except (FileNotFoundError, NotADirectoryError) as error:
        if os.path.islink(config):
            raise AppTokenError(failure) from error
        return frozenset()
    except OSError as error:
        raise AppTokenError(failure) from error
    if not os.access(config, os.R_OK):
        raise AppTokenError(failure)
    try:
        result = subprocess.run(
            ["git", "config", "--file", str(config), "--get-all", key],
            capture_output=True,
            text=True,
            check=False,
            cwd="/",
        )
    except (OSError, UnicodeDecodeError) as error:
        raise AppTokenError(failure) from error
    if result.returncode == 0:
        return frozenset(value.casefold() for value in result.stdout.splitlines())
    if result.returncode == 1 and not result.stdout:
        return frozenset()
    raise AppTokenError(failure)


def git_config(key: str) -> str:
    value = git_config_optional(key)
    if value is None:
        raise AppTokenError(f"missing git config: {key}")
    return value


def cache_component(value: str) -> str:
    """Make a profile or owner safe and stable for use in a cache-file name."""
    return re.sub(r"[^A-Za-z0-9._-]", "_", value.lower())


def scope_of(repos: list[str] | None, read_only: bool) -> dict[str, Any] | None:
    """The narrowing --repo/--read-only ask for, in GitHub's access_tokens body shape, or None
    for an owner-wide token."""
    if not repos and not read_only:
        return None
    scope: dict[str, Any] = {}
    if repos:
        scope["repositories"] = sorted({r.split("/")[-1] for r in repos})
    if read_only:
        scope["permissions"] = {"contents": "read", "metadata": "read"}
    return scope


def scope_key(scope: dict[str, Any] | None) -> str:
    """A stable cache-name part for a scope: a scoped token never shares an owner-wide cache entry."""
    if not scope:
        return ""
    perms = ",".join(f"{k}={v}" for k, v in sorted(scope.get("permissions", {}).items()))
    return f"repos={','.join(scope.get('repositories', []))};perms={perms}"


def broker_secret_for(profile: str, scope: dict[str, Any] | None) -> str:
    """The broker profile a mint for scope asks for: broker-secret (GITHUB_APP_<PERSON>), or for a
    read-only scope its read profile, broker-secret with _READ appended, which holds the scope's
    contents:read and metadata:read."""
    secret = git_config(f"gh-app.{profile}.broker-secret")
    return f"{secret}_READ" if scope and scope.get("permissions") else secret


def token_cache_file(profile: str, owner: str, scope: str = "") -> Path:
    """The cache entry for one profile, App, owner and scope. The profile's App id is part of
    the key, so a profile whose app-id changes never gets the old App's token back (2026-10-26:
    a corrected review profile kept answering with the first App's cached token)."""
    app_id = git_config_optional(f"gh-app.{profile}.app-id") or "none"
    suffix = f"--{cache_component(scope)}" if scope else ""
    return CACHE_DIR / (
        f"token-{cache_component(profile)}--app-{cache_component(app_id)}"
        f"--{cache_component(owner)}{suffix}.json"
    )


def required_lifetime() -> int:
    """Seconds a returned token must stay valid: the caller's GH_APP_TOKEN_MIN_LIFETIME,
    never less than TOKEN_REFRESH_MARGIN."""
    raw = os.environ.get(MIN_LIFETIME_ENV, "")
    if not raw:
        return TOKEN_REFRESH_MARGIN
    try:
        requested = int(raw)
    except ValueError:
        raise AppTokenError(f"{MIN_LIFETIME_ENV} must be a whole number of seconds, not {raw!r}") from None
    return max(TOKEN_REFRESH_MARGIN, requested)


def seconds_left(entry: dict[str, Any]) -> float:
    """How long entry's token has before it lapses, by its expires_at."""
    expires_at = datetime.fromisoformat(entry["expires_at"].replace("Z", "+00:00"))
    return (expires_at - datetime.now(timezone.utc)).total_seconds()


def cached_entry(cache_file: Path, min_lifetime: int) -> dict[str, Any] | None:
    """cache_file's entry while its token has more than min_lifetime seconds left, else None. An
    entry another call removes while this one reads it is a miss."""
    try:
        data = json.loads(cache_file.read_text())
        if "token" in data and seconds_left(data) > min_lifetime:
            return data
    except (OSError, KeyError, TypeError, ValueError):
        return None
    return None


def get_cached_token(profile: str, owner: str, min_lifetime: int = TOKEN_REFRESH_MARGIN, scope: str = "") -> str | None:
    entry = cached_entry(token_cache_file(profile, owner, scope), min_lifetime)
    return entry["token"] if entry else None


def utc_stamp(moment: datetime) -> str:
    return moment.strftime("%Y-%m-%dT%H:%M:%SZ")


@contextlib.contextmanager
def token_cache_locked():
    """Hold the lock over every token entry's writes: the mint's (get_token) and a check's
    record or drop (settle_checked_entry), so a check never replaces or removes an entry another
    call wrote after the check began. It is never held across a network call."""
    CACHE_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
    with (CACHE_DIR / "tokens.lock").open("a", encoding="utf-8") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield


def github_status(path: str, bearer: str) -> int | None:
    """GitHub's HTTP status for GET path with bearer, or None when no answer came: no
    connection, a connect or read that waited LIVENESS_TIMEOUT seconds, or a reply that is not
    HTTP."""
    request = urllib.request.Request(
        GITHUB_API + path,
        headers={
            "Authorization": f"Bearer {bearer}",
            "Accept": "application/vnd.github+json",
            "X-GitHub-Api-Version": "2022-11-28",
        },
    )
    try:
        with urllib.request.urlopen(request, timeout=LIVENESS_TIMEOUT) as response:
            return response.status
    except urllib.error.HTTPError as error:
        error.close()
        return error.code
    except (urllib.error.URLError, http.client.HTTPException, OSError, ValueError):
        return None


def live_cached_token(cache_file: Path, entry: dict[str, Any]) -> str | None:
    """entry's token, or None when GitHub answers 401 for it (revoked), after dropping
    cache_file. GitHub is asked only when the entry's checked_at is LIVENESS_INTERVAL old or
    more, missing or in the future; any answer but 401, or none, records a new checked_at, so
    one cache entry costs at most one request a minute."""
    now = datetime.now(timezone.utc)
    try:
        checked = datetime.fromisoformat(entry["checked_at"].replace("Z", "+00:00"))
        if 0 <= (now - checked).total_seconds() < LIVENESS_INTERVAL:
            return entry["token"]
    except (KeyError, AttributeError, TypeError, ValueError):
        pass
    if github_status("/rate_limit", entry["token"]) == 401:
        settle_checked_entry(cache_file, entry["token"], None)
        return None
    settle_checked_entry(cache_file, entry["token"], utc_stamp(now))
    return entry["token"]


def settle_checked_entry(cache_file: Path, token: str, checked_at: str | None) -> None:
    """After a check of token, and only while cache_file still holds token: record checked_at
    in it, or remove it when checked_at is None (GitHub answered 401). An entry another call
    wrote while the check was out stays as it is. A failure leaves the entry: after a 401 the
    mint that follows replaces it, and a check not recorded is made again by the next call."""
    try:
        with token_cache_locked():
            current = json.loads(cache_file.read_text())
            if not isinstance(current, dict) or current.get("token") != token:
                return
            if checked_at is None:
                cache_file.unlink()
            else:
                write_cache_file(cache_file, {**current, "checked_at": checked_at})
    except (OSError, ValueError, AppTokenError):
        pass


def write_cache_file(cache_file: Path, data: dict[str, Any]) -> None:
    """Atomically replace a mode-0600 JSON cache entry."""
    temporary_path: Path | None = None
    try:
        CACHE_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
        with tempfile.NamedTemporaryFile(
            mode="w",
            encoding="utf-8",
            dir=CACHE_DIR,
            prefix=f".{cache_file.name}.",
            delete=False,
        ) as temporary:
            temporary.write(json.dumps(data))
            temporary.flush()
            os.fsync(temporary.fileno())
            temporary_path = Path(temporary.name)
        temporary_path.chmod(0o600)
        os.replace(temporary_path, cache_file)
    except OSError as error:
        raise AppTokenError("failed to write credential cache") from error
    finally:
        if temporary_path is not None:
            try:
                temporary_path.unlink(missing_ok=True)
            except OSError:
                pass


def covered_owners_file(app_id: str) -> Path:
    return CACHE_DIR / f"covered-{cache_component(app_id)}.json"


def covered_owners_lock_file(app_id: str) -> Path:
    return CACHE_DIR / f"covered-{cache_component(app_id)}.lock"


def remember_covered_owners(app_id: str, installations: dict[str, int]) -> None:
    """Record every owner this App has ever been seen installed on.

    Unlike the token caches, this is never expired and never shrinks: it is what lets a
    later release that omits a known owner be treated as the contradiction it is, instead
    of as permission to hand out the personal token. The read-merge-write runs under one
    lock, so two concurrent cache misses never drop each other's owners.
    """
    try:
        CACHE_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
        with covered_owners_lock_file(app_id).open("a", encoding="utf-8") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            covered = covered_owners(app_id)
            updated = {**covered, **installations}
            if updated != covered:
                write_cache_file(covered_owners_file(app_id), updated)
    except OSError as error:
        raise AppTokenError("failed to update covered-owner cache") from error


def covered_owners(app_id: str) -> dict[str, int]:
    """The covered-owner file. A damaged one is unknown coverage, never an empty one."""
    cache_file = covered_owners_file(app_id)
    if not cache_file.exists():
        return {}
    try:
        data = json.loads(cache_file.read_text())
    except (json.JSONDecodeError, OSError, UnicodeDecodeError) as error:
        raise AppTokenError("invalid covered-owner cache") from error
    if not isinstance(data, dict):
        raise AppTokenError("invalid covered-owner cache")

    covered: dict[str, int] = {}
    for owner, installation_id in data.items():
        normalized_owner = owner.casefold() if isinstance(owner, str) else ""
        if (
            not normalized_owner
            or not isinstance(installation_id, int)
            or isinstance(installation_id, bool)
            or normalized_owner in covered
        ):
            raise AppTokenError("invalid covered-owner cache")
        covered[normalized_owner] = installation_id
    return covered


def log_decision(profile: str, owner: str, request: dict[str, str], decision: str, detail: str) -> None:
    """One line per invocation in the cache dir, so a misattributed action is
    answerable after the fact: which owner was resolved, from what path, and
    whether the App, the personal token, or a refusal answered. Never the token
    itself - four characters of prefix say which kind it was (ghs_ App, ghp_
    personal) - and never the broker's output. 2026-09-17: two review verdicts went
    out as the human and nothing recorded which of these paths produced them.
    """
    try:
        CACHE_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
        path = CACHE_DIR / "decisions.log"
        # Cap it. Every gh call of every gate runs through this shim, and on
        # 2026-10-30 the log reached 751 MB with no rotation while the root disk
        # went to zero free and Dispatch writes failed with ENOSPC. One previous
        # generation is kept, so the answer to "which path produced that verdict"
        # survives a rotation.
        try:
            if path.stat().st_size > 32 * 1024 * 1024:
                path.replace(CACHE_DIR / "decisions.log.1")
        except FileNotFoundError:
            pass
        with path.open("a") as log:
            log.write(
                json.dumps(
                    {
                        "at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
                        "profile": profile,
                        "owner": owner,
                        "path": request.get("path", ""),
                        "decision": decision,
                        "detail": detail,
                        "pid": os.getpid(),
                        "ppid": os.getppid(),
                        "cwd": os.getcwd(),
                        "session": os.environ.get("OMP_SESSION_ID", ""),
                    }
                )
                + "\n"
            )
    except OSError:
        pass  # the log is diagnostics; never fail a mint because of it


def mise_environment() -> dict[str, str]:
    """mise's data dir and configuration as shims/ reads them, whatever HOME the caller set
    (shims/tests/test_shim_moved_home.py): MISE_DATA_DIR, as mise itself reads it, else the first
    of ~/.mise (.bashrc's) and mise's default ~/.local/share/mise that exists, under HOME and
    then under the uid's passwd home; and, where neither MISE_GLOBAL_CONFIG_FILE nor mise's
    global config file under HOME names one, the mise.toml of the checkout this file is in,
    which installers link mise's global config to. Without them, mise's shims under a moved
    HOME have no version of anything."""
    import pwd

    environment: dict[str, str] = {}
    data = os.environ.get("MISE_DATA_DIR")
    if not data:
        candidates: list[Path] = []
        if os.environ.get("HOME"):
            home = Path(os.environ["HOME"])
            candidates += [home / ".mise", Path(os.environ.get("XDG_DATA_HOME") or home / ".local" / "share") / "mise"]
        passwd = Path(pwd.getpwuid(os.getuid()).pw_dir)
        candidates += [passwd / ".mise", passwd / ".local" / "share" / "mise"]
        data = str(next((c for c in candidates if c.is_dir()), candidates[0]))
    environment["MISE_DATA_DIR"] = data
    config_home = os.environ.get("XDG_CONFIG_HOME") or str(Path(os.environ.get("HOME", "/nonexistent")) / ".config")
    if not os.environ.get("MISE_GLOBAL_CONFIG_FILE") and not os.access(Path(config_home) / "mise" / "config.toml", os.R_OK):
        environment["MISE_GLOBAL_CONFIG_FILE"] = str(Path(__file__).resolve().parents[1] / "mise.toml")
    return environment


def mise_shims() -> Path:
    """mise's shims dir (mise_environment).

    mise runs [settings.github] credential_command with its own shims dir taken off PATH,
    and outside an interactive shell (where `mise activate` adds the install dirs) that dir
    is the only place `secrets` and `agent-secrets` are found: every mint then failed
    (2026-10-24, INFRA-219).
    """
    return Path(mise_environment()["MISE_DATA_DIR"]) / "shims"


def secrets_executable() -> str:
    """`secrets` on PATH, else mise's shim for it (mise_shims)."""
    return shutil.which("secrets") or str(mise_shims() / "secrets")


# The directory the client and secrets run in: this shim's own dotfiles tree, never the caller's checkout. Each can be
# mise's shim, and mise reads the project config of the directory it runs in,
# which under CI=true (omp's bash tool) it trusts, so a checkout's `.mise.toml` ran its `_.source` script and its
# PYTHONPATH's sitecustomize.py while an App token was minted (measured 2026-11-23).
OWN_CHECKOUT = Path(__file__).resolve().parents[1]


# The file that gives the client its broker URL where the caller has none (omp's eval kernel and a unit pass none on,
# and the client refuses without one).
BROKER_URL_SH = OWN_CHECKOUT / "agent-secrets" / "broker-url.sh"


def client_command() -> tuple[list[str], dict[str, str]]:
    """The agent-secrets client, run by sh after BROKER_URL_SH, and the environment to run it in:
    the caller's, with mise's shims dir after its PATH, so the client and secrets resolve where
    the caller's PATH lacks them (mise_shims), and mise's data dir and configuration for those
    shims (mise_environment)."""
    environment = {**os.environ, **mise_environment()}
    environment["PATH"] = os.pathsep.join(part for part in (environment.get("PATH", ""), str(mise_shims())) if part)
    return ["sh", "-c", '. "$0" && exec agent-secrets "$@"', str(BROKER_URL_SH)], environment


def resolve_secret(name: str) -> str:
    """Read a secret from secretsd: the upstream personal-access-token fallback, and on a machine
    that set key-secret, the App's key."""
    try:
        result = subprocess.run(
            [secrets_executable(), "get", name, "--value"],
            capture_output=True,
            text=True,
            check=True,
            env={**os.environ, **mise_environment()},
            cwd=OWN_CHECKOUT,
        )
    except (subprocess.CalledProcessError, FileNotFoundError) as error:
        detail = (getattr(error, "stderr", None) or "").strip() or str(error)
        raise AppTokenError(f"failed to fetch secret {name}: {detail}") from error
    value = result.stdout.strip()
    if not value:
        raise AppTokenError(f"empty secret {name}")
    return value


def fallback_token(profile: str, owner: str) -> str:
    """The profile's personal access token for an owner the App is not installed on.

    Read from secretsd on every request; the token is static, so no cache file is written
    for it. Never silent: the identity about to act is the human's, and the caller has no
    other way to tell.
    """
    app_id = git_config(f"gh-app.{profile}.app-id")
    known = covered_owners(app_id).get(owner.casefold())
    if known is not None:
        # 2026-09-17: two review verdicts on trajectory-labs-pbc/agent-c went
        # out as the human because a discovery omitted an owner the App covers
        # and this path handed out the personal token without a word.
        raise AppTokenError(
            f"owner {owner} was installed for App {app_id} (installation {known}) and is now "
            "missing from the App's installations; refusing to fall back to the personal token. If "
            f"the App really was uninstalled there, delete {covered_owners_file(app_id)} to "
            "re-enable the fallback for it"
        )
    fallback_secret = git_config_optional(f"gh-app.{profile}.fallback-secret")
    if fallback_secret is None:
        raise AppTokenError(
            f"no App installation for owner {owner} and no fallback-secret on profile {profile}"
        )
    print(
        f"gh-app-token: no App installation for owner {owner}; using the personal token "
        f"{fallback_secret} - this call will act as its user, not as the App",
        file=sys.stderr,
    )
    return resolve_secret(fallback_secret)


def parse_broker_installations(release: str) -> dict[str, BrokerInstallation]:
    """Validate a broker release without putting any of it in an error."""
    try:
        data = json.loads(release)
    except json.JSONDecodeError as error:
        raise AppTokenError("broker returned invalid installations JSON") from error
    if not isinstance(data, dict) or not isinstance(data.get("installations"), dict):
        raise AppTokenError("broker returned invalid installations JSON")

    parsed: dict[str, BrokerInstallation] = {}
    for owner, installation in data["installations"].items():
        if not isinstance(owner, str) or not owner or not isinstance(installation, dict):
            raise AppTokenError("broker returned invalid installations JSON")
        installation_id = installation.get("installation_id")
        token = installation.get("token")
        expires_at = installation.get("expires_at")
        if (
            not isinstance(installation_id, int)
            or isinstance(installation_id, bool)
            or not isinstance(token, str)
            or not token
            or not isinstance(expires_at, str)
        ):
            raise AppTokenError("broker returned invalid installations JSON")
        try:
            expiration = datetime.fromisoformat(expires_at.replace("Z", "+00:00"))
        except ValueError as error:
            raise AppTokenError("broker returned invalid installations JSON") from error
        normalized_owner = owner.casefold()
        if expiration.tzinfo is None or normalized_owner in parsed:
            raise AppTokenError("broker returned invalid installations JSON")
        parsed[normalized_owner] = {
            "installation_id": installation_id,
            "token": token,
            "expires_at": expires_at,
        }
    return parsed


def box_key_dir() -> Path:
    """The key dir the agent-secrets client reads (its keyDir): AGENT_SECRETS_KEY_DIR, else
    $XDG_RUNTIME_DIR/agent-secrets, else /run/user/<uid>/agent-secrets (helper.DefaultSocket's
    directory)."""
    key_dir = os.environ.get("AGENT_SECRETS_KEY_DIR")
    if key_dir:
        return Path(key_dir)
    runtime_dir = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    return Path(runtime_dir) / "agent-secrets"


def broker_failure_cause(stderr: str) -> str:
    """The cause of a failed broker call: the first line of its stderr that is not one of the
    client's notices that it waits for a launcher still enrolling the box. The client names the
    cause on that line (broker unreachable, an old broker that cannot narrow, an old client that
    lacks a flag) and never a value there; the release itself goes only to stdout. A notice comes
    only once wait_for_box_enrollment's own bound ran out with the marker still fresh, and the
    client's refusal after it says what it waited for, or the later step that failed once the
    launcher finished."""
    for line in stderr.strip().splitlines():
        if line and not line.startswith(CLIENT_ENROLLMENT_NOTICES):
            return line
    return "no message"


def wait_for_box_enrollment() -> None:
    """Block while this box's secrets-broker enrollment is still under way, up to
    ENROLLMENT_WAIT_SECONDS. Returns at once - and so changes nothing - wherever there is no
    marker, or a marker no launcher is renewing."""
    marker = box_key_dir() / ENROLLMENT_MARKER
    deadline = time.monotonic() + ENROLLMENT_WAIT_SECONDS
    announced = False
    while True:
        try:
            age = time.time() - marker.stat().st_mtime
        except OSError:
            return  # Enrolled, or the enrollment failed: either way the launcher is done.
        if age > ENROLLMENT_MARKER_FRESH_SECONDS or time.monotonic() >= deadline:
            return
        if not announced:
            print(
                "gh-app-token: this box is still being enrolled with the secrets broker; "
                f"waiting up to {ENROLLMENT_WAIT_SECONDS}s for it...",
                file=sys.stderr,
            )
            announced = True
        time.sleep(1)


def request_broker_installations(
    secret_name: str, owner: str, scope: dict[str, Any] | None = None
) -> dict[str, BrokerInstallation]:
    """Ask the broker for a release of secret_name through its client, capturing its stdout
    without logging it. With scope, the release is narrowed with --target to owner's installation,
    or to each of its repositories; a read-only scope's secret_name is the read profile
    (broker_secret_for)."""
    wait_for_box_enrollment()
    client, environment = client_command()
    narrowing: list[str] = []
    if scope:
        targets = [f"{owner}/{repository}" for repository in scope.get("repositories", [])] or [owner]
        for target in targets:
            narrowing += ["--target", target]
    command = [
        *client,
        secret_name,
        "--reason",
        f"gh-app-token {owner}",
        *narrowing,
        "--",
        "printenv",
        secret_name,
    ]
    try:
        result = subprocess.run(command, capture_output=True, text=True, check=False, env=environment, cwd=OWN_CHECKOUT)
    except FileNotFoundError as error:
        raise AppTokenError("sh is not available to run the agent-secrets client") from error
    except (OSError, UnicodeDecodeError) as error:
        raise AppTokenError("failed to run the agent-secrets client") from error
    if result.returncode == 75:
        raise AppTokenError(
            f"broker request for {secret_name} is pending; run agent-secrets-login before retrying"
        )
    if result.returncode == 77:
        raise AppTokenError(
            f"broker request for {secret_name} was denied; run agent-secrets-login before retrying"
        )
    if result.returncode:
        cause = broker_failure_cause(result.stderr)
        detail = f"broker request for {secret_name} failed (exit {result.returncode}): {cause}"
        if scope:
            detail += "; a --repo/--read-only token has no fallback"
        raise AppTokenError(detail)
    return parse_broker_installations(result.stdout)


def b64url(data: bytes) -> str:
    return base64.urlsafe_b64encode(data).rstrip(b"=").decode()


def app_jwt(app_id: str, private_key: bytes) -> str:
    """A ten-minute App JWT, RS256-signed by openssl, which reads the key from a pipe."""
    now = int(time.time())
    header = b64url(json.dumps({"alg": "RS256", "typ": "JWT"}).encode())
    claims = b64url(json.dumps({"iat": now - 60, "exp": now + 540, "iss": app_id}).encode())
    signing_input = f"{header}.{claims}"
    read_fd, write_fd = os.pipe()
    try:
        # A PEM key is a few KB, well under a pipe's buffer, so this write never blocks.
        os.write(write_fd, private_key)
        os.close(write_fd)
        write_fd = -1
        result = subprocess.run(
            ["openssl", "dgst", "-sha256", "-sign", f"/dev/fd/{read_fd}"],
            input=signing_input.encode(),
            capture_output=True,
            pass_fds=(read_fd,),
            check=False,
        )
    except FileNotFoundError as error:
        raise AppTokenError("openssl is not installed; it signs the App JWT") from error
    finally:
        os.close(read_fd)
        if write_fd != -1:
            os.close(write_fd)
    if result.returncode:
        cause = result.stderr.decode(errors="replace").strip().splitlines()[:1] or ["no message"]
        raise AppTokenError(f"openssl could not sign the App JWT: {cause[0]}")
    return f"{signing_input}.{b64url(result.stdout)}"


def github_api(method: str, path: str, bearer: str, body: dict[str, Any] | None = None) -> Any:
    request = urllib.request.Request(
        GITHUB_API + path,
        method=method,
        data=json.dumps(body).encode() if body is not None else None,
        headers={
            "Authorization": f"Bearer {bearer}",
            "Accept": "application/vnd.github+json",
            "X-GitHub-Api-Version": "2022-11-28",
        },
    )
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            return json.load(response)
    except urllib.error.HTTPError as error:
        raise AppTokenError(f"GitHub {method} {path.split('?')[0]} returned {error.code}") from error
    except (urllib.error.URLError, OSError, json.JSONDecodeError) as error:
        raise AppTokenError(f"GitHub {method} {path.split('?')[0]} failed: {error}") from error


def mint_from_secretsd(
    key_secret: str, app_id: str, owner: str, scope: dict[str, Any] | None
) -> tuple[dict[str, int], dict[str, BrokerInstallation]]:
    """Mint with the App key this machine keeps in secretsd (key-secret). Returns every owner the
    App is installed on, for the covered-owner file, and owner's token alone in a broker
    release's shape: empty when the App is not installed there."""
    try:
        private_key = base64.b64decode(resolve_secret(key_secret), validate=True)
    except binascii.Error as error:
        raise AppTokenError(f"secret {key_secret} is not base64") from error
    bearer = app_jwt(app_id, private_key)
    covered: dict[str, int] = {}
    page = 1
    while True:
        items = github_api("GET", f"/app/installations?per_page=100&page={page}", bearer)
        try:
            for item in items:
                covered[item["account"]["login"].casefold()] = int(item["id"])
        except (TypeError, KeyError, AttributeError, ValueError) as error:
            raise AppTokenError("GitHub returned an invalid installations list") from error
        if len(items) < 100:
            break
        page += 1
    installation_id = covered.get(owner)
    if installation_id is None:
        return covered, {}
    minted = github_api("POST", f"/app/installations/{installation_id}/access_tokens", bearer, scope or {})
    if not isinstance(minted, dict) or not isinstance(minted.get("token"), str) or not isinstance(minted.get("expires_at"), str):
        raise AppTokenError("GitHub returned an invalid installation token")
    return covered, {owner: {"installation_id": installation_id, "token": minted["token"], "expires_at": minted["expires_at"]}}


AGENT_MARKERS = (
    "OMP_SESSION_ID", "PI_SESSION_FILE", "PI_TOOL_BRIDGE_URL", "AGENTBOX_SESSION", "CLAUDECODE",
    "ENVOY_SESSION_ID", "AGENT_SHIM_AGENT", "LEGION_ROLE", "LEGION_TREE", "LEGION_CONTROLLER",
    "LEGION_DAEMON_URL",
)


def agent_context() -> bool:
    """True when this call belongs to an agent session, by the same test shims/gh makes.

    Kept identical to that function on purpose: if the two disagree about who is an agent, a
    write refused by one is allowed by the other. A person pushing from their own shell must
    not be refused — the fallback exists for their pushes to third-party forks.
    """
    if any(os.environ.get(name) for name in AGENT_MARKERS):
        return True
    for i in range(int(os.environ.get("GIT_CONFIG_COUNT") or 0)):
        if (os.environ.get(f"GIT_CONFIG_VALUE_{i}") or "").endswith("gh-app-routes.gitconfig"):
            return True
    # A command over SSH in a session with no controlling terminal is an agent's. The session's
    # terminal decides, as in shims/gh, not stdin and not SSH_TTY alone: a person's session has
    # one (sshd's for an interactive login, tmux's for every pane) and every process of it shares
    # it, so a pipe into one command of it -- git handing its credential helper the request -- is
    # still the person's, and so is a pane of a tmux server that never carried SSH_TTY
    # (INFRA-4089). AGENT_SHIM_PERSON=1 is their escape for a deliberate non-interactive SSH
    # command of their own (INFRA-1538).
    if (
        not os.environ.get("SSH_CONNECTION")
        or os.environ.get("SSH_TTY")
        or os.environ.get("AGENT_SHIM_PERSON") == "1"
    ):
        return False
    try:
        os.close(os.open("/dev/tty", os.O_RDONLY))
    except OSError:
        return True
    return False


def select_owner(explicit_owner: str | None, request: dict[str, str]) -> str | None:
    """Apply --owner > GH_APP_OWNER > credential-request-path precedence."""
    path_owner = request.get("path", "").lstrip("/").split("/", 1)[0]
    return explicit_owner or os.environ.get("GH_APP_OWNER") or path_owner or None


def get_token(
    profile: str,
    owner: str,
    min_lifetime: int = TOKEN_REFRESH_MARGIN,
    scope: dict[str, Any] | None = None,
    *,
    refused: frozenset[str],
) -> str:
    """Return a token for one owner (narrowed by scope when given), never reusing another owner's
    or another scope's cache, never a cached one with min_lifetime seconds or less left (counted
    again after its check at GitHub), and never a cached one GitHub answered 401 for
    (live_cached_token): that one is replaced by one fresh mint. An owner-wide release caches no
    token for an owner in refused (refused_owners). Every token it caches is recorded as checked
    when minted, under the token-cache lock."""
    owner = owner.casefold()
    key = scope_key(scope)
    cache_file = token_cache_file(profile, owner, key)
    entry = cached_entry(cache_file, min_lifetime)
    if entry:
        cached_token = live_cached_token(cache_file, entry)
        if cached_token is None:
            print(
                f"gh-app-token: GitHub answered 401 for the cached token of profile {profile} "
                f"(owner={owner}{', ' + key if key else ''}): it was revoked, so it is dropped",
                file=sys.stderr,
            )
        elif seconds_left(entry) > min_lifetime:
            return cached_token

    app_id = git_config(f"gh-app.{profile}.app-id")
    key_secret = git_config_optional(f"gh-app.{profile}.key-secret")
    print(
        f"gh-app-token: minting token for profile {profile} (owner={owner}{', ' + key if key else ''}) "
        f"{'with ' + key_secret + ' from secretsd' if key_secret else 'through the broker'}...",
        file=sys.stderr,
    )
    if key_secret:
        covered, installations = mint_from_secretsd(key_secret, app_id, owner, scope)
    else:
        installations = request_broker_installations(broker_secret_for(profile, scope), owner, scope)
        covered = {name: installation["installation_id"] for name, installation in installations.items()}
    minted_at = utc_stamp(datetime.now(timezone.utc))
    remember_covered_owners(app_id, covered)
    installation = installations.get(owner)
    try:
        with token_cache_locked():
            if not scope:
                # An owner-wide release holds every covered owner's token: cache them all but the
                # ones this machine refuses. A narrowed one is cached under its scope alone, never
                # in an owner-wide entry.
                for name, minted in installations.items():
                    if name in refused:
                        continue
                    write_cache_file(
                        token_cache_file(profile, name),
                        {"token": minted["token"], "expires_at": minted["expires_at"], "checked_at": minted_at},
                    )
            elif installation is not None:
                write_cache_file(
                    cache_file,
                    {"token": installation["token"], "expires_at": installation["expires_at"], "checked_at": minted_at},
                )
    except OSError as error:
        raise AppTokenError("failed to write credential cache") from error
    if installation is None:
        raise UninstalledOwnerError(f"GitHub App is not installed for owner {owner}")
    return installation["token"]


def read_credential_request() -> dict[str, str]:
    request: dict[str, str] = {}
    for raw_line in sys.stdin:
        line = raw_line.strip()
        if not line:
            break
        if "=" in line:
            key, _, value = line.partition("=")
            request[key] = value
    return request


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Return a target-owner GitHub App installation token."
    )
    parser.add_argument("profile")
    parser.add_argument("action", choices=("get", "store", "erase"), nargs="?")
    parser.add_argument("--owner", metavar="LOGIN")
    parser.add_argument(
        "--repo", metavar="NAME", action="append",
        help="narrow the token to this repository of the owner (repeatable); never falls back to the personal token",
    )
    parser.add_argument(
        "--read-only", action="store_true",
        help="ask for the profile's read secret, its broker-secret with _READ appended (contents:read and "
             "metadata:read), narrowed with --target to the owner or to each --repo; never falls back to "
             "the personal token",
    )
    parser.add_argument(
        "--for-write", action="store_true",
        help="this credential will be used to change something on GitHub, so an owner with "
             "no App installation is refused in an agent session rather than served the "
             "personal fallback. Only git's credential helper passes it.",
    )
    return parser.parse_args(argv)


def log_decision_after_answer(*decision: Any) -> None:
    """log_decision, never on the caller's path. git waits for its credential helper to exit
    (credential.c: finish_command after reading the answer), and knives waits for this process too,
    so a log write stuck on the disk holds the push: on 2026-11-03 at 09:50Z 428 helper processes,
    the oldest 598 s, sat in ext4_buffered_write_iter on decisions.log (the root disk's journal was
    out of space) while every push on the box hung. So once the answer is flushed, the process entry
    point forks: the parent exits at once and a detached child, its stdin, stdout and stderr on
    /dev/null, writes the line; when no child can be made the line is dropped. main() called in a
    test (DETACH_DECISION_LOG False) writes it inline."""
    sys.stdout.flush()
    sys.stderr.flush()
    if not DETACH_DECISION_LOG:
        log_decision(*decision)
        return
    try:
        if os.fork():
            return
    except OSError:
        return
    try:
        os.setsid()
        devnull = os.open(os.devnull, os.O_RDWR)
        for fd in (0, 1, 2):
            os.dup2(devnull, fd)
        # Every other descriptor it inherited goes too: a mise that holds .dotfiles-install.lock on
        # one runs this command, and a writer stuck on the disk would keep that lock held
        # (dispatch://INFRA-4798). listdir has read the whole directory and closed its own
        # descriptor before the loop closes anything.
        try:
            inherited = [int(fd) for fd in os.listdir("/proc/self/fd")]
        except OSError:
            # No /proc: every number up to the open-file limit, in one call.
            os.closerange(3, os.sysconf("SC_OPEN_MAX"))
            inherited = []
        for fd in inherited:
            if fd > 2:
                try:
                    os.close(fd)
                except OSError:
                    pass
        log_decision(*decision)
    finally:
        os._exit(0)


DETACH_DECISION_LOG = False


def main(argv: list[str] | None = None) -> int:
    args = parse_args(sys.argv[1:] if argv is None else argv)
    if args.action in {"store", "erase"}:
        return 0

    credential_mode = args.action == "get"
    request = read_credential_request() if credential_mode else {}
    if credential_mode and not request:
        # git always sends at least protocol and host, so an empty request is a person
        # or agent who ran `get` by hand expecting a token; answering nothing with exit 0
        # read as a silent success (2026-11-05).
        print(
            "gh-app-token: `get` is git's credential-helper action and read no request on stdin;"
            " to mint a token directly run: gh-app-token <profile> --owner <login> [--repo <name>]",
            file=sys.stderr,
        )
        return 2
    if credential_mode and request.get("host", "").casefold() != "github.com":
        return 0

    owner = select_owner(args.owner, request)
    if owner is None:
        # No owner signal at all (e.g. useHttpPath disabled). In credential
        # mode this is indistinguishable from an unrouted request: answer
        # nothing. No helper is configured behind this one, so git ends with
        # "could not read Username".
        if credential_mode:
            return 0
        print("gh-app-token: target owner required: pass --owner or set GH_APP_OWNER", file=sys.stderr)
        return 1

    try:
        refused = refused_owners(args.profile)
        if owner.casefold() in refused:
            raise RefusedOwnerError(
                f"owner {owner} is refused for profile {args.profile} on this machine "
                f"(gh-app.{args.profile}.refuse-owner): no token"
            )

        if CACHE_DIR == DEFAULT_CACHE_DIR:
            seed_cache_dir(CACHE_DIR, OLD_CACHE_DIR)
        scope = scope_of(args.repo, args.read_only)
        try:
            token = get_token(args.profile, owner, required_lifetime(), scope, refused=refused)
            decision = "app"
        except UninstalledOwnerError:
            if scope:
                # A narrowed token was asked for; the personal token cannot be narrowed.
                raise AppTokenError(
                    f"no App installation for owner {owner}; a --repo/--read-only token has no fallback"
                ) from None
            token = fallback_token(args.profile, owner)
            # A write on the personal fallback is the account owner posting under their own
            # name on someone else's project. A `git push` is refused here, at the mint: it
            # reaches this token through the credential helper, which execs this program first.
            #
            # The signal is --for-write, which ONLY shims/gh's `gh auth git-credential` branch
            # passes, because that branch is git asking to authenticate a push. Credential mode
            # itself is not that signal: knives mints for every routed `gh` call, read and
            # write alike, through this same `get` interface, so refusing on credential mode
            # fails ordinary reads of uncovered owners.
            #
            # Only an agent session is refused; a person pushing from their own shell is what
            # the fallback exists for. A push to the owner's own forks goes to an App-covered
            # owner and never reaches this branch (dispatch://INFRA-2031).
            if args.for_write and agent_context():
                raise AppTokenError(
                    f"refusing this credential request: a push to {owner} through this helper "
                    f"would use the account owner's personal token, because the App is not "
                    f"installed there. Ask on the relevant Dispatch issue and have a person "
                    f"do it. Reads of {owner}, and pushes to owners the App covers, are "
                    f"unaffected."
                ) from None
            decision = "fallback-personal-token"
    except AppTokenError as error:
        message = f"gh-app-token: {error}"
        print(message, file=sys.stderr)
        if credential_mode:
            # Stop git's helper chain: a broker failure, or an uncovered owner
            # with no usable fallback, must fail loudly, never silently fall
            # back to the user's own credentials.
            print("quit=1")
        log_decision_after_answer(
            args.profile,
            owner,
            request,
            "refused",
            message if isinstance(error, RefusedOwnerError) else str(error),
        )
        return 1

    if credential_mode:
        print(f"protocol={request.get('protocol', 'https')}")
        print(f"host={request.get('host', 'github.com')}")
        print("username=x-access-token")
        print(f"password={token}")
    else:
        print(token)
    log_decision_after_answer(args.profile, owner, request, decision, f"token={token[:4]}…")
    return 0


if __name__ == "__main__":
    DETACH_DECISION_LOG = True
    sys.exit(main())
