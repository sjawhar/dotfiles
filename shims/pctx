#!/bin/bash
# pctx: ctx against Sami's own memory tree, never the team one.
#
# The `ctx` shim beside this one points every call at the team server
# (CTX_SERVER=http://ctx-memory.tail12ec1c.ts.net), so a personal command run as `ctx` would read
# and write the company's tree. This wrapper names the personal deployment instead: its own
# server on loopback, its own data and state directories, and the binary of the version the
# personal tree is kept on. Personal skills, timers and sessions call `pctx`; nothing personal
# calls `ctx`.
#
# A CTX_SERVER the caller set wins, so `CTX_SERVER= pctx --memory ... sweep` reads the tree
# directly with no server, which is how the read-only checks run.
set -u

root="${CTX_PERSONAL_ROOT:-$HOME/.local/share/ctx-personal}"
# The deployment's own build comes first: the personal tree runs ahead of the published release
# while a change it needs is still an open pull request. Without one, the release named in
# ctx-version is used.
version="$(cat "$root/ctx-version" 2>/dev/null || echo 0.2.10)"
real="$root/bin/ctx"
if [[ ! -x "$real" ]]; then
	real="$HOME/.mise/installs/github-sjawhar-ctx-memory/$version/ctx"
fi
if [[ ! -x "$real" ]]; then
	echo "pctx: no ctx at $root/bin/ctx, and no $version at $real; run \`mise install github:sjawhar/ctx-memory@$version\`" >&2
	exit 127
fi

export CTX_SERVER="${CTX_SERVER-http://127.0.0.1:47820}"
export CTX_MEMORY="${CTX_MEMORY-$root/tree}"
export CTX_DATA_DIR="${CTX_DATA_DIR-$root/data}"
export CTX_STATE_DIR="${CTX_STATE_DIR-$root/state}"
# ctx refuses --memory beside a configured server, so drop the tree when one is named.
[[ -n "$CTX_SERVER" ]] && unset CTX_MEMORY
exec "$real" "$@"
