#!/bin/bash
# secrets with the YubiKey kept for Sami's own shells. An agent's request for a human-tier key
# never reaches secretsd: the key's only prompt is a blink that the
# YubiKey's firmware gives about 15 seconds, so an agent's request times out unanswered unless Sami
# happens to be at the key, and on 2026-11-01 thirteen of them did (secretsd journal:
# sops_failure="yubikey-stanza-undecryptable", then decision="TIMEOUT"). Agents get human-tier
# credentials from the secrets broker instead (`secret-run`, an approval card in Sami's Dispatch
# inbox, a grant for the session), so this shim refuses at once (exit 77, the broker's own
# "denied") and names the broker command, or, for a session the broker does not know, how to
# relaunch it so it is.
#
# An agent is a caller with OMP_SESSION_ID, PI_SESSION_FILE, CLAUDECODE or ENVOY_SESSION_ID set;
# Sami's shells set none of them. A human-tier key is a `<KEY>.env` or `<KEY>.local.env` file in
# the `secrets.human.d` of a source root secretsd's config.toml declares. Only `get` (without
# --no-request) and `KEY... -- PROGRAM` request a grant. A grant some session already holds does
# not make the call pass: `secrets get --no-request` reports "grant":true when ANY session holds
# the key (its GRANTS call carries no token), so trusting it would blink the key for this one.
# Every other call, and every call from a non-agent, execs the real secrets with the same
# arguments. A process without this directory ahead of ~/.mise/shims on PATH runs the real
# secrets, and the omp tool `secrets_request` talks to the daemon without running any binary.
#
# A machine without the broker's helper unit (the laptop: the root install.sh does not install it,
# agent-secrets/AGENTS.md) has no broker to send an agent to, so there an agent's request goes to
# secretsd and the YubiKey as before. Refusing it left every agent on the laptop with no human-tier
# key at all (Sami, 2026-11-02: "Fix the wrapper"). The test is the one scripts/agent-secrets-session
# and scripts/agentbox use for "this machine has the helper".
set -euo pipefail

self="$(readlink -f "${BASH_SOURCE[0]}")"
self_dir="$(dirname "$self")"

# The first secrets past this shim's own PATH entry; from the top, skipping this file, when the
# shim was run by path from outside PATH.
real=""
past_self=false
IFS=: read -ra path_dirs <<< "${PATH:-}"
for pass in after-self from-top; do
    for d in "${path_dirs[@]}"; do
        [ -n "$d" ] || continue
        if [ "$(readlink -f "$d" 2>/dev/null)" = "$self_dir" ]; then
            past_self=true
            continue
        fi
        [ "$pass" = from-top ] || $past_self || continue
        if [ -x "$d/secrets" ] && [ "$(readlink -f "$d/secrets")" != "$self" ]; then
            real="$d/secrets"
            break 2
        fi
    done
    $past_self && break
done
[ -n "$real" ] || { echo "shims/secrets: no real secrets on PATH" >&2; exit 127; }

# The same test the other six shims make, in this file's own style: every harness's session
# marker, the AGENT_SHIM_AGENT=1 that shims/tmux puts in an agent's pane, the gh-app routing
# include, and a command over SSH in a session with no terminal. It read neither
# PI_TOOL_BRIDGE_URL and AGENTBOX_SESSION nor the routing include, so a boxed agent's
# `secrets get` of a human-tier key reached the YubiKey prompt (round 3 of INFRA-1538).
# There is no tmux exception here either: shims/tmux gives an agent's new pane these markers.
agent=false
for var in OMP_SESSION_ID PI_SESSION_FILE PI_TOOL_BRIDGE_URL AGENTBOX_SESSION CLAUDECODE \
    ENVOY_SESSION_ID AGENT_SHIM_AGENT LEGION_ROLE LEGION_TREE LEGION_CONTROLLER \
    LEGION_DAEMON_URL; do
    [ -z "${!var:-}" ] || agent=true
done
i=0
while [ "$i" -lt "${GIT_CONFIG_COUNT:-0}" ]; do
    var="GIT_CONFIG_VALUE_$i"
    case "${!var:-}" in *gh-app-routes.gitconfig) agent=true ;; esac
    i=$((i + 1))
done
# A command that arrives over SSH in a session with no terminal (`ssh host secrets get …`) is an
# agent's, not a person's: sshd gives a person's own session a terminal and names it in SSH_TTY
# for the whole session, so a pipe into one command of it is still the person's, where testing
# this command's own stdin made it an agent's. AGENT_SHIM_PERSON=1 is the person's escape for a
# deliberate non-interactive SSH command of their own (INFRA-1538).
if [ -n "${SSH_CONNECTION:-}" ] && [ -z "${SSH_TTY:-}" ] && [ "${AGENT_SHIM_PERSON:-}" != 1 ]; then
    # Only when this rule, and not a marker above, decided.
    $agent || echo "secrets shim: non-interactive SSH, so an agent's call: agent-tier only, through the broker (set AGENT_SHIM_PERSON=1 for your own)" >&2
    agent=true
fi
$agent || exec "$real" "$@"
[ -e "$HOME/.config/systemd/user/agent-secrets-helper.service" ] || exec "$real" "$@"

keys=()
if [ "${1:-}" = get ]; then
    skip=false
    for arg in "${@:2}"; do
        if $skip; then skip=false; continue; fi
        case "$arg" in
            --no-request) exec "$real" "$@" ;;
            --ttl) skip=true ;;
            -*) ;;
            *) keys+=("$arg") ;;
        esac
    done
elif [[ "${1:-}" =~ ^[A-Z][A-Z0-9_]*$ ]]; then
    for arg in "$@"; do
        [ "$arg" != -- ] || break
        keys+=("$arg")
    done
fi
(( ${#keys[@]} )) || exec "$real" "$@"

config="${SECRETSD_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/secretsd/config.toml}"
roots=()
if [ -r "$config" ]; then
    while IFS= read -r line; do
        [[ "$line" =~ ^[[:space:]]*path[[:space:]]*=[[:space:]]*\"(.*)\"[[:space:]]*$ ]] && roots+=("${BASH_REMATCH[1]}")
    done < "$config"
fi
human=()
for key in "${keys[@]}"; do
    for root in "${roots[@]}"; do
        if [ -e "$root/secrets.human.d/$key.env" ] || [ -e "$root/secrets.human.d/$key.local.env" ]; then
            human+=("$key")
            break
        fi
    done
done
(( ${#human[@]} )) || exec "$real" "$@"

# secretsd names the credential broker holds under another name: the same token (Sami, in chat to
# the chief of staff, 2026-11-02 ~02:0xZ: "Yes, they're the same. Stop using the yubikey.").
declare -A broker_name=([GITHUB_ADMIN_PAT_THEOREM]=GITHUB_ADMIN_PAT)

session="${OMP_SESSION_ID:-}"
[ -n "$session" ] || [ -z "${PI_SESSION_FILE:-}" ] || {
    session="${PI_SESSION_FILE##*_}"
    session="${session%.jsonl}"
}
names=()
for key in "${human[@]}"; do names+=("${broker_name[$key]:-$key}"); done
{
    printf 'secrets: refused: %s is human tier. For an agent session, secretsd would blink the YubiKey, which gives a touch about 15 seconds, and time out unless Sami is at the key, so nothing was requested. Agents get human-tier credentials from the Legion credential broker: Sami said so on 2026-10-25 (dispatch://INFRA-223/ask/d2bfc2df-9399-42a9-90b8-35b9f5a46d66) and again on 2026-11-03 (dispatch://OSSV-300/ask/dc4e1c38-bd15-4999-9ef5-4c6540a2ce9a: "You can request the admin PAT to do it yourself."), and 13 secretsd requests timed out on 2026-11-01.\n' "${human[*]}"
    for key in "${human[@]}"; do
        [ -z "${broker_name[$key]:-}" ] ||
            printf 'The broker holds this same token under the name %s; %s is secretsd'"'"'s name for it (Sami, in chat to the chief of staff, 2026-11-02).\n' \
                "${broker_name[$key]}" "$key"
    done
    if command -v agent-secrets >/dev/null && agent-secrets identity >/dev/null 2>&1; then
        printf 'Ask the broker; an approval card reaches Sami in Dispatch and the grant lasts the session:\n    secret-run --reason "<what for>" %s -- <command>\n' "${names[*]}"
    else
        printf 'This session has no broker identity: it was not launched through ~/.dotfiles/shims/omp. Ask the broker for this one command anyway: --register makes the command a broker session of its own, with no restart, and an approval card reaches Sami in Dispatch:\n    secret-run --register --reason "<what for>" %s -- <command>\nSo that every later request needs no --register, relaunch the session from a shell whose PATH starts with ~/.dotfiles/shims when it is at a safe point:\n    omp --resume %s\n' "${names[*]}" "${session:-<session id>}"
    fi
} >&2
exit 77
