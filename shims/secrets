#!/bin/bash
# secrets with the YubiKey kept for Sami's own shells. An agent's request for a human-tier key
# never reaches secretsd: the key's only prompt is a blink that the
# YubiKey's firmware gives about 15 seconds, so an agent's request times out unanswered unless Sami
# happens to be at the key, and on 2026-11-01 thirteen of them did (secretsd journal:
# sops_failure="yubikey-stanza-undecryptable", then decision="TIMEOUT"). Agents get human-tier
# credentials from the secrets broker instead (`agent-secrets`, an approval card in Sami's Dispatch
# inbox, a grant for the session), so this shim refuses at once (exit 77, the broker's own
# "denied") and names the broker command, or, for a session the broker does not know, how to
# relaunch it so it is.
#
# An agent is a caller the agent test below names (a harness's session marker, the gh-app routing
# include, or a command over SSH with no terminal); Sami's own shells have none of them. A
# human-tier key is a `<KEY>.env` or `<KEY>.local.env` file in
# the `secrets.human.d` of a source root secretsd's config.toml declares. Only `get` (without
# --no-request) and `KEY... -- PROGRAM` request a grant. A grant some session already holds does
# not make the call pass: `secrets get --no-request` reports "grant":true when ANY session holds
# the key (its GRANTS call carries no token), so trusting it would blink the key for this one.
# Every other call, and every call from a non-agent, execs the real secrets with the same
# arguments. A process without this directory ahead of ~/.mise/shims on PATH runs the real
# secrets, and the omp tool `secrets_request` talks to the daemon without running any binary.
#
# A machine without the broker's helper unit (the root install.sh installs it only where env.local
# names a broker) has no broker to send an agent to, so there an
# agent's request goes to secretsd and the YubiKey as before. Refusing it left every agent on a
# machine without the unit with no human-tier key at all (Sami, 2026-11-02: "Fix the wrapper"). The
# test is the one scripts/agent-secrets-session and scripts/agentbox use for "this machine has the
# helper".
set -euo pipefail

self="$(readlink -f "${BASH_SOURCE[0]}")"
self_dir="$(dirname "$self")"

# The first secrets past this shim's own PATH entry; from the top, skipping this file, when the
# shim was run by path from outside PATH.
real=""
past_self=false
IFS=: read -ra path_dirs <<< "${PATH:-}"
for pass in after-self from-top; do
    for d in "${path_dirs[@]}"; do
        [ -n "$d" ] || continue
        if [ "$(readlink -f "$d" 2>/dev/null)" = "$self_dir" ]; then
            past_self=true
            continue
        fi
        [ "$pass" = from-top ] || $past_self || continue
        if [ -x "$d/secrets" ] && [ "$(readlink -f "$d/secrets")" != "$self" ]; then
            real="$d/secrets"
            break 2
        fi
    done
    $past_self && break
done

# mise_paths: mise as this machine runs it, whatever HOME and PATH the caller set
# (shims/tests/test_shim_moved_home.py). A Legion test pane runs a shim with a
# temporary HOME and the PATH <bin>:/usr/local/bin:/usr/bin:/bin, where every
# path under HOME names nothing. Sets, once per process:
#   _mise_bin     mise on PATH, else the dotfiles checkout's bin/mise, else the
#                 mise the shims in a data dir link to (a copy or a worktree of
#                 the checkout has no bin/, which is not committed)
#   _mise_config  mise's global configuration: MISE_GLOBAL_CONFIG_FILE, else the
#                 file under HOME when it is readable, else the checkout's
#                 mise.toml, which installers link that file to
#   _mise_datas   the data dirs a tool may be installed in: MISE_DATA_DIR and mise's
#                 default ~/.local/share/mise under HOME; with no MISE_DATA_DIR,
#                 ~/.mise (.bashrc's) and that default, under HOME, then the passwd home's
#   _mise_data    the one to give mise: MISE_DATA_DIR, else the first that exists
# The checkout is DOTFILES_DIR, else the one this file's own path is in.
mise_paths() {
    local IFS=$' \t\n'
    local self dotfiles home dir data seen=""
    local -a all=()
    [[ -z "${_mise_config:-}" ]] || return 0
    _mise_bin=""
    IFS=':'
    for dir in ${PATH:-}; do
        if [[ -n "$dir" && -f "$dir/mise" && -x "$dir/mise" ]]; then
            _mise_bin="$dir/mise"
            break
        fi
    done
    IFS=$' \t\n'
    _mise_config="${MISE_GLOBAL_CONFIG_FILE:-${XDG_CONFIG_HOME:-${HOME:-}/.config}/mise/config.toml}"
    if [[ -z "$_mise_bin" || ( -z "${MISE_GLOBAL_CONFIG_FILE:-}" && ! -r "$_mise_config" ) ]]; then
        dotfiles="${DOTFILES_DIR:-}"
        if [[ -z "$dotfiles" ]]; then
            self="$(command -p readlink -f -- "${BASH_SOURCE[0]}")" || self=""
            dotfiles="${self%/shims/*}"
        fi
        [[ -n "$_mise_bin" ]] || _mise_bin="$dotfiles/bin/mise"
        [[ -n "${MISE_GLOBAL_CONFIG_FILE:-}" || -r "$_mise_config" ]] || _mise_config="$dotfiles/mise.toml"
    fi
    if [[ -n "${MISE_DATA_DIR:-}" ]]; then
        all=("$MISE_DATA_DIR" "${XDG_DATA_HOME:-${HOME:-}/.local/share}/mise")
    else
        all=("${HOME:-}/.mise" "${XDG_DATA_HOME:-${HOME:-}/.local/share}/mise")
        # With HOME unset, ~ is the uid's home in the passwd database, which HOME does not move.
        local HOME
        unset HOME
        home=~
        [[ "$home" != /?* ]] || all+=("$home/.mise" "$home/.local/share/mise")
    fi
    _mise_datas=() _mise_data="${MISE_DATA_DIR:-}"
    for data in "${all[@]}"; do
        [[ "$data" == /?* && ":$seen:" != *":$data:"* ]] || continue
        seen+=":$data"
        _mise_datas+=("$data")
        [[ -n "$_mise_data" || ! -d "$data" ]] || _mise_data="$data"
    done
    if [[ ! -f "$_mise_bin" || ! -x "$_mise_bin" ]]; then
        for data in ${_mise_datas[@]+"${_mise_datas[@]}"}; do
            for dir in "$data"/shims/*; do
                [[ -L "$dir" ]] || continue
                dir="$(command -p readlink -f -- "$dir")" || dir=""
                [[ "$dir" != */mise || ! -f "$dir" || ! -x "$dir" ]] || _mise_bin="$dir"
                break
            done
            [[ ! -x "$_mise_bin" ]] || break
        done
    fi
    : "${_mise_data:=${_mise_datas[0]:-}}"
}

# is_mise_shim FILE: whether FILE is mise's own shim, a file in the shims dir of
# one of mise's data dirs or a link to mise. It reaches its tool only where mise
# reads its config and trust list under HOME, which a moved HOME hides.
is_mise_shim() {
    local IFS=$' \t\n'
    local data
    mise_paths
    for data in ${_mise_datas[@]+"${_mise_datas[@]}"}; do
        [[ "${1%/*}" -ef "$data/shims" ]] && return 0
    done
    [[ -L "$1" && "$(command -p readlink -f -- "$1")" == */mise ]]
}

# mise off PATH: secrets is a mise-managed tool (the `secrets` alias in mise.toml), and a unit's or
# a test harness's PATH can hold this dir without mise's shims dir. mise's own shim on PATH under a
# HOME that holds no mise configuration (a moved HOME) would refuse, so mise is asked here too
# (shims/az's lookup).
if [ -z "$real" ] || { is_mise_shim "$real" && [ "$_mise_config" != "${XDG_CONFIG_HOME:-${HOME:-}/.config}/mise/config.toml" ]; }; then
    mise_paths
    found="$(MISE_DATA_DIR="$_mise_data" MISE_GLOBAL_CONFIG_FILE="$_mise_config" "$_mise_bin" which -C / secrets 2>/dev/null)" || found=""
    if [ -n "$found" ] && [ -x "$found" ] && [ "$(readlink -f "$found")" != "$self" ]; then
        real="$found"
    fi
fi
[ -n "$real" ] || { echo "shims/secrets: no real secrets on PATH ($PATH), and $_mise_bin, given $_mise_config and the data dir $_mise_data, names none" >&2; exit 127; }

# The same test the other six shims make, in this file's own style: every harness's session
# marker, the AGENT_SHIM_AGENT=1 that shims/tmux puts in an agent's pane, the gh-app routing
# include, and a command over SSH in a session with no terminal. It read neither
# PI_TOOL_BRIDGE_URL and AGENTBOX_SESSION nor the routing include, so a boxed agent's
# `secrets get` of a human-tier key reached the YubiKey prompt (round 3 of INFRA-1538).
# There is no tmux exception here either: shims/tmux gives an agent's new pane these markers.
agent=false
for var in OMP_SESSION_ID PI_SESSION_FILE PI_TOOL_BRIDGE_URL AGENTBOX_SESSION CLAUDECODE \
    ENVOY_SESSION_ID AGENT_SHIM_AGENT LEGION_ROLE LEGION_TREE LEGION_CONTROLLER \
    LEGION_DAEMON_URL; do
    [ -z "${!var:-}" ] || agent=true
done
i=0
while [ "$i" -lt "${GIT_CONFIG_COUNT:-0}" ]; do
    var="GIT_CONFIG_VALUE_$i"
    case "${!var:-}" in *gh-app-routes.gitconfig) agent=true ;; esac
    i=$((i + 1))
done
# A command that arrives over SSH in a session with no controlling terminal (`ssh host secrets
# get …`) is an agent's, not a person's. The session's terminal decides, not this command's stdin
# and not SSH_TTY alone: a person's session has one (sshd's for an interactive login, tmux's for
# every pane) and every process of it shares it, so a pipe into one command of it is still the
# person's. A tmux server started before .tmux.conf carried SSH_TTY gives its panes
# SSH_CONNECTION without SSH_TTY, and on that alone Sami's own pane was taken for an agent's
# (INFRA-4089). `true`, not `:`: a failed redirection of a special builtin ends a POSIX-mode
# bash. AGENT_SHIM_PERSON=1 is the person's escape for a deliberate non-interactive SSH command
# of their own (INFRA-1538).
if [ -n "${SSH_CONNECTION:-}" ] && [ -z "${SSH_TTY:-}" ] && [ "${AGENT_SHIM_PERSON:-}" != 1 ] &&
    ! { true < /dev/tty; } 2> /dev/null; then
    # Only when this rule, and not a marker above, decided.
    $agent || echo "secrets shim: non-interactive SSH, so an agent's call: agent-tier only, through the broker (set AGENT_SHIM_PERSON=1 for your own)" >&2
    agent=true
fi
$agent || exec "$real" "$@"
[ -e "$HOME/.config/systemd/user/agent-secrets-helper.service" ] || exec "$real" "$@"

keys=()
if [ "${1:-}" = get ]; then
    skip=false
    for arg in "${@:2}"; do
        if $skip; then skip=false; continue; fi
        case "$arg" in
            --no-request) exec "$real" "$@" ;;
            --ttl) skip=true ;;
            -*) ;;
            *) keys+=("$arg") ;;
        esac
    done
elif [[ "${1:-}" =~ ^[A-Z][A-Z0-9_]*$ ]]; then
    for arg in "$@"; do
        [ "$arg" != -- ] || break
        keys+=("$arg")
    done
fi
(( ${#keys[@]} )) || exec "$real" "$@"

config="${SECRETSD_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/secretsd/config.toml}"
roots=()
if [ -r "$config" ]; then
    while IFS= read -r line; do
        [[ "$line" =~ ^[[:space:]]*path[[:space:]]*=[[:space:]]*\"(.*)\"[[:space:]]*$ ]] && roots+=("${BASH_REMATCH[1]}")
    done < "$config"
fi
human=()
for key in "${keys[@]}"; do
    for root in "${roots[@]}"; do
        if [ -e "$root/secrets.human.d/$key.env" ] || [ -e "$root/secrets.human.d/$key.local.env" ]; then
            human+=("$key")
            break
        fi
    done
done
(( ${#human[@]} )) || exec "$real" "$@"

# secretsd names the credential broker holds under another name: the same token (Sami, in chat to
# the chief of staff, 2026-11-02 ~02:0xZ: "Yes, they're the same. Stop using the yubikey.").
declare -A broker_name=([GITHUB_ADMIN_PAT_THEOREM]=GITHUB_ADMIN_PAT)

session="${OMP_SESSION_ID:-}"
[ -n "$session" ] || [ -z "${PI_SESSION_FILE:-}" ] || {
    session="${PI_SESSION_FILE##*_}"
    session="${session%.jsonl}"
}
names=()
for key in "${human[@]}"; do names+=("${broker_name[$key]:-$key}"); done
{
    printf 'secrets: refused: %s is human tier. For an agent session, secretsd would blink the YubiKey, which gives a touch about 15 seconds, and time out unless Sami is at the key, so nothing was requested. Agents get human-tier credentials from the Legion credential broker: Sami said so on 2026-10-25 (dispatch://INFRA-223/ask/d2bfc2df-9399-42a9-90b8-35b9f5a46d66) and again on 2026-11-03 (dispatch://OSSV-300/ask/dc4e1c38-bd15-4999-9ef5-4c6540a2ce9a: "You can request the admin PAT to do it yourself."), and 13 secretsd requests timed out on 2026-11-01.\n' "${human[*]}"
    for key in "${human[@]}"; do
        [ -z "${broker_name[$key]:-}" ] ||
            printf 'The broker holds this same token under the name %s; %s is secretsd'"'"'s name for it (Sami, in chat to the chief of staff, 2026-11-02).\n' \
                "${broker_name[$key]}" "$key"
    done
    if command -v agent-secrets >/dev/null && agent-secrets identity >/dev/null 2>&1; then
        printf 'Ask the broker; an approval card reaches Sami in Dispatch:\n    agent-secrets %s --reason "<what for>" -- <command>\n' "${names[*]}"
    else
        printf 'This session has no broker identity of its own: it was not launched through ~/.dotfiles/shims/omp. Ask the broker for this one command anyway; the client then acts as the person signed in on this machine, or as the machine, and an approval card reaches Sami in Dispatch:\n    agent-secrets %s --reason "<what for>" -- <command>\nSo that the session has its own identity, relaunch it from a shell whose PATH starts with ~/.dotfiles/shims when it is at a safe point:\n    omp --resume %s\n' "${names[*]}" "${session:-<session id>}"
    fi
} >&2
exit 77
