#!/usr/bin/env bash
# omp wrapper: what an omp session needs on top of scripts/agent-session, then omp.
#
# omp is the first non-wrapper `omp` on PATH once mise has set PATH for this directory: the
# pinned release ("github:sjawhar/oh-my-pi" in mise.toml), or a local build ahead of ~/.mise/shims.
set -euo pipefail

DOTFILES_DIR="${DOTFILES_DIR:-$HOME/.dotfiles}"

# mise's environment for this directory. A session keeps the PATH it started with, so a PATH can
# still name the install dir of an older pin; mise puts the current pin's dir in its place. A pin
# that is not installed leaves no omp install dir, and agent-session refuses.
# mise lives in ~/.dotfiles/bin, which a unit's or harness's PATH can leave out while it keeps
# this shim; then the shim runs that mise by its path, with .bashrc's data dir.
export MISE_DATA_DIR="${MISE_DATA_DIR:-$HOME/.mise}"
mise_bin="$(command -v mise)" || mise_bin="$DOTFILES_DIR/bin/mise"
mise_env="$("$mise_bin" env -s bash)"
eval "$mise_env"

# glibc gives each allocating thread its own 64 MiB arena and never returns freed chunks; omp's
# native addon allocates from ~140 threads, so a long session retained 1-2 GB of dead native
# memory. Two shared arenas hold it under ~30 MB (measured idle: 24 MB flat versus 104 MB growing
# 45 MB/min). Bun and JavaScriptCore use mimalloc, so only the native side changes.
export MALLOC_ARENA_MAX="${MALLOC_ARENA_MAX:-2}"

# Mnemopi ranks recall by veracity, and omp labels a deliberate `retain`/`learn` save `tool` and
# a transcript slice `unknown`. Mnemopi's stock weights (tool 0.5, unknown 0.8) therefore rank
# raw transcript above curated memory; these weight by provenance instead, and lean semantic over
# keyword so a one-line fact is not out-matched on term overlap by a long transcript. omp has no
# setting for them, only these variables; a caller's value wins. Their effect on what recall
# injects is unmeasured.
export MNEMOPI_TOOL_WEIGHT="${MNEMOPI_TOOL_WEIGHT:-1.0}"
export MNEMOPI_UNKNOWN_WEIGHT="${MNEMOPI_UNKNOWN_WEIGHT:-0.5}"
export MNEMOPI_VEC_WEIGHT="${MNEMOPI_VEC_WEIGHT:-0.6}"
export MNEMOPI_FTS_WEIGHT="${MNEMOPI_FTS_WEIGHT:-0.2}"
export MNEMOPI_IMPORTANCE_WEIGHT="${MNEMOPI_IMPORTANCE_WEIGHT:-0.2}"

# omp's bash tool runs every call in one persistent shell, so `set -e`, `-u` or `-o pipefail` at
# one call's top level stays on for every later call and silently breaks them (`yes | head -n 1`
# exits 141, a `grep -c` counting zero ends the command). omp puts PI_SHELL_PREFIX in front of
# each command inside its executor, so the model's command text never shows it; a caller's value
# wins. Costs: a `!cd` typed in the TUI no longer moves the session's cwd, and `set -x` and
# `shopt` changes still carry over.
export PI_SHELL_PREFIX="${PI_SHELL_PREFIX:-set +e +u +o pipefail;}"

# omp/config.yml is every profile's settings of record, loaded as a PI_CONFIG_FILES overlay omp
# never writes; runtime writes (/model picks, prompt answers) land in the profile's own
# config.yml and lose to it on the next start. Later entries win, so a caller's overlays stay on
# top, and a nested launch does not add it twice.
overlay="$DOTFILES_DIR/omp/config.yml"
case ":${PI_CONFIG_FILES:-}:" in
    *":$overlay:"*) ;;
    *) export PI_CONFIG_FILES="$overlay${PI_CONFIG_FILES:+:$PI_CONFIG_FILES}" ;;
esac

# installers/omp-embed.sh runs one embedding server per machine and records its URL. Pointed at
# it, mnemopi spawns no ~1 GB embedding worker per session. Only while it answers: a dead server
# would leave the session on keyword-only recall, while no URL keeps the in-process worker.
embed_file="${XDG_CONFIG_HOME:-$HOME/.config}/omp-embed/endpoint"
if [[ -z "${MNEMOPI_EMBEDDING_API_URL:-}" && -r "$embed_file" ]]; then
    embed_url="$(<"$embed_file")"
    if curl -fsS -m 1 "${embed_url%/v1}/health" >/dev/null 2>&1; then
        export MNEMOPI_EMBEDDING_API_URL="$embed_url"
    fi
fi

# A named profile gets the shared setup: its symlinks track installers/omp.sh's in ~/.omp and
# ~/.omp/agent (created, re-pointed, retired), and its real files are its own. config.yml comes
# from the overlay above; models.yml (provider routes and keys) and envoy.json are the profile's
# own, so neither is mirrored or pruned. The profile is the last --profile before a `--`, else
# OMP_PROFILE when it is defined, else PI_PROFILE; a misread costs only these links.
profile="" flagged="" prev=""
for arg in "$@"; do
    [[ "$arg" == -- ]] && break
    if [[ "$prev" == --profile ]]; then
        profile="$arg" flagged=1
    elif [[ "$arg" == --profile=* ]]; then
        profile="${arg#--profile=}" flagged=1
    fi
    prev="$arg"
done
if [[ -z "$flagged" ]]; then
    if [[ -n "${OMP_PROFILE+x}" ]]; then profile="$OMP_PROFILE"; else profile="${PI_PROFILE:-}"; fi
fi
[[ "$profile" == default ]] && profile=""
if [[ -n "$profile" && ! "$profile" =~ ^[a-z0-9][a-z0-9._-]*$ ]]; then
    echo "omp: invalid profile name: $profile (lowercase letters, digits, '.', '-', '_'; starting with a letter or digit)" >&2
    exit 2
fi

# omp/config.local.yml (gitignored, machine-local) is the box's own model routing. On sami-rocqperf it points every
# Anthropic role at the OSS Verify model gateway and falls each one back to the same model on the direct Anthropic
# login (dispatch://INFRA-398; Sami, 2026-11-01 17:13Z, after the 12:35-16:20Z outage of the shared login). It
# loads after omp/config.yml, so it wins on the roles it names, and before a caller's own overlays, so a `--config`
# file still wins over both. A machine without the file is unchanged.
# The default profile alone gets it: a named profile such as `pbc` bills another Anthropic account, so it gets
# omp/config.<profile>.local.yml in the same place instead, when that file exists (on sami-rocqperf,
# config.pbc.local.yml points the pbc roles at the gateway's `pbc/` groups, team verified-grader, which bill PBC;
# Sami, 2026-11-03 14:31Z, dispatch://INFRA-481/ask/2a5a0149: "Just move our agents."). Without that file a named
# profile keeps config.yml's direct `anthropic/...` roles. A nested launch inherits PI_CONFIG_FILES from its parent,
# so a launch drops every local overlay the parent added before adding its own.
local_overlay="$DOTFILES_DIR/omp/config.local.yml"
[[ -n "$profile" ]] && local_overlay="$DOTFILES_DIR/omp/config.$profile.local.yml"
pi_files=""
IFS=: read -ra pi_entries <<<"${PI_CONFIG_FILES:-}"
for entry in "${pi_entries[@]}"; do
    [[ "$entry" == "$DOTFILES_DIR"/omp/config.*local.yml && "$entry" != "$local_overlay" ]] && continue
    pi_files="${pi_files:+$pi_files:}$entry"
done
export PI_CONFIG_FILES="$pi_files"
if [[ -f "$local_overlay" ]]; then
    case ":${PI_CONFIG_FILES:-}:" in
        *":$local_overlay:"*) ;;
        *) export PI_CONFIG_FILES="${PI_CONFIG_FILES/"$overlay"/"$overlay:$local_overlay"}" ;;
    esac
fi

# A profile's copy of one shared config file (mcp.json, lsp.json, keybindings.yml, WATCHDOG.*).
# A link would let anything that writes the profile's file write the shared one instead: on
# 2026-11-01 a probe harness wrote `{ "mcpServers": {} }` to its profile's agent/mcp.json, which
# was a link to ~/.dotfiles/omp/mcp.json, and every session on the box started with no MCP
# servers. So the profile holds a real copy, refreshed from the shared file on each launch while
# it is still exactly what was last copied (recorded in DST/.mirror-src/NAME). A file the profile
# wrote itself, or changed since, stays the profile's and is no longer refreshed.
mirror_copy() { # mirror_copy SHARED_LINK DST NAME
    local shared="$1" dst="$2" name="$3"
    local copy="$dst/$name" last="$dst/.mirror-src/$name"
    [[ -L "$copy" ]] && rm -f "$copy"
    if [[ -e "$copy" ]]; then
        [[ -f "$last" ]] && cmp -s "$copy" "$last" || return 0
        cmp -s "$shared" "$copy" && return 0
    fi
    mkdir -p "$dst/.mirror-src"
    { cp "$shared" "$copy.new.$$" && mv -f "$copy.new.$$" "$copy" \
        && cp "$copy" "$last.new.$$" && mv -f "$last.new.$$" "$last"; } 2>/dev/null \
        || rm -f "$copy.new.$$" "$last.new.$$"
}
mirror_links() { # mirror_links SRC DST [copy-files]
    local src="$1" dst="$2" copy_files="${3:-}" entry name
    mkdir -p "$dst"
    for entry in "$dst"/*; do
        name="${entry##*/}"
        if [[ ! -L "$entry" ]]; then
            # A copy whose shared file is gone goes too, unless the profile changed it.
            if [[ -n "$copy_files" && -f "$dst/.mirror-src/$name" && ! -L "$src/$name" ]] \
                && cmp -s "$entry" "$dst/.mirror-src/$name"; then
                rm -f "$entry" "$dst/.mirror-src/$name"
            fi
            continue
        fi
        case "$name" in config.yml|models.yml) rm -f "$entry"; continue ;; envoy.json) continue ;; esac
        [[ -L "$src/$name" ]] || rm -f "$entry"
    done
    for entry in "$src"/*; do
        name="${entry##*/}"
        case "$name" in config.yml|models.yml|envoy.json) continue ;; esac
        if [[ -L "$entry" ]]; then
            if [[ -n "$copy_files" && -f "$entry" && ! -d "$entry" ]]; then
                mirror_copy "$entry" "$dst" "$name"
            elif [[ -L "$dst/$name" || ! -e "$dst/$name" ]] \
                && [[ "$(readlink "$dst/$name" 2>/dev/null)" != "$(readlink "$entry")" ]]; then
                ln -sfn "$(readlink "$entry")" "$dst/$name"
            fi
        elif [[ "$name" == extensions && -d "$entry" ]]; then
            # Extension code stays linked: a copied .ts would resolve its imports from the profile.
            mirror_links "$entry" "$dst/$name"
        fi
    done
}
# A profile whose agent/ holds models.overlay.yml is the default profile with other provider keys,
# not a separate install (dispatch://BET-59, 2026-10-30: the verified-grader sessions bill Anthropic
# to another account). It shares every piece of state with the default: each entry of ~/.omp (but
# agent/, profiles/ and run/) and of ~/.omp/agent (but models.yml, models.overlay.yml and SQLite's
# -wal/-shm, which SQLite places beside the link's target) is a link to the default's, re-made on
# every launch, so an entry a newer omp adds is shared too; dotfiles included, since omp reads an
# agent/.env. An entry omp created in the profile first, with no default counterpart, is moved into
# the default and linked. One that exists on both sides as a real entry stops the launch: it means
# divergent state, and a human decides which copy is real. models.yml alone is the profile's: the
# default's merged with the overlay, rebuilt on every launch, so it cannot drift from the default.
# The merge deep-merges maps but replaces arrays, so an overlay that carries a `models:` list
# replaces the default's list instead of adding to it. Measured by the omp maintainer on a scratch
# home (2026-10-30): one SQLite WAL set, one session store, and sessions resume through either root.
share_links() { # share_links SRC DST KEEP_NAME...
    local src="$1" dst="$2" entry name keep dotglob_was=""
    shift 2
    shopt -q dotglob && dotglob_was=1
    shopt -s dotglob
    mkdir -p "$dst"
    for entry in "$dst"/*; do
        [[ -e "$entry" && ! -L "$entry" ]] || continue
        name="${entry##*/}"
        for keep in "$@"; do [[ "$name" == $keep ]] && continue 2; done
        if [[ -e "$src/$name" || -L "$src/$name" ]]; then
            echo "omp: $dst/$name and $src/$name are both real; this profile shares all state with the default, so remove the copy that is not real and launch again" >&2
            exit 1
        fi
        mv "$entry" "$src/$name"
        ln -s "$src/$name" "$entry"
    done
    for entry in "$src"/*; do
        [[ -e "$entry" || -L "$entry" ]] || continue
        name="${entry##*/}"
        for keep in "$@"; do [[ "$name" == $keep ]] && continue 2; done
        [[ "$(readlink "$dst/$name" 2>/dev/null)" == "$entry" ]] || ln -sfn "$entry" "$dst/$name"
    done
    [[ -n "$dotglob_was" ]] || shopt -u dotglob
}
if [[ -n "$profile" ]]; then
    root="$HOME/${PI_CONFIG_DIR:-.omp}"
    overlay_models="$root/profiles/$profile/agent/models.overlay.yml"
    if [[ -f "$overlay_models" ]]; then
        # Several sessions launch at once: one link pass at a time, so two shims never both move
        # the same new entry into the default. Bounded, so a stuck holder fails launches loudly
        # instead of hanging them, and never lets one start half-linked.
        exec 9>"$root/profiles/$profile/.share.lock"
        if ! flock -w 30 9; then
            echo "omp: waited 30 s for $root/profiles/$profile/.share.lock; profile $profile not started" >&2
            exit 1
        fi
        share_links "$root" "$root/profiles/$profile" agent profiles run .share.lock
        share_links "$root/agent" "$root/profiles/$profile/agent" \
            models.yml models.overlay.yml 'models.yml.new.*' '*-wal' '*-shm'
        # pi-envoy reads a named profile's agent/envoy.json instead of ~/.config/legion/envoy.json.
        [[ -e "$root/profiles/$profile/agent/envoy.json" ]] ||
            ln -s "${XDG_CONFIG_HOME:-$HOME/.config}/legion/envoy.json" "$root/profiles/$profile/agent/envoy.json"
        exec 9>&-
        models_out="$root/profiles/$profile/agent/models.yml"
        # 0600: the default's models.yml can hold literal keys (scripts/omp-models-build, `apiKeyFile`).
        (umask 077 && yq eval-all '. as $item ireduce ({}; . * $item)' "$root/agent/models.yml" "$overlay_models" \
            > "$models_out.new.$$")
        if cmp -s "$models_out.new.$$" "$models_out"; then rm -f "$models_out.new.$$"; chmod 600 "$models_out"; else mv "$models_out.new.$$" "$models_out"; fi
    else
        mirror_links "$root" "$root/profiles/$profile"
        mirror_links "$root/agent" "$root/profiles/$profile/agent" copy-files
    fi
fi

# OMP_MEMORY_MAX=<systemd size, e.g. 32G> runs this session in a transient systemd user scope with
# that hard memory cap and swap off. A session that runs away is then killed inside its own cgroup
# instead of the kernel picking a victim anywhere on the box: on 2026-10-26 at 05:47Z one omp
# session reached 138.0 GiB and the global OOM killer took two of the box's coredns pods with it.
# Unset, the default below applies (the larger of 24G and a twentieth of the host's RAM). A scope is transient, so
# it leaves no unit file behind. OMP_MEMORY_MAX is removed from the session's own environment, so
# subprocesses do not each ask for a scope of their own; they share this one and count against it.
# If systemd-run is missing or refuses (a container with no user manager), the session starts
# uncapped rather than failing.
#
# No MemoryHigh: measured on this box, a cap with MemoryHigh below it does not kill a session that
# passes it, it throttles the session into reclaim and the lane looks like it is thinking (an omp
# start under a 192M cap with MemoryHigh at 144M was still in `discoverAndLoadMCPTools` after 84 s).
# A plain MemoryMax kills promptly, and the wrapper waits for the session so it can say why: a
# ceiling nobody can see costs a lead more time than the kill itself.
# OOMPolicy=continue: at the ceiling the kernel kills the largest process in the scope, usually a
# runaway child, and the session should live on. systemd's default for a scope is `stop`, which
# ends the whole scope after that kill: at 2026-11-02T03:22:08Z the kernel killed the right child
# and systemd then stopped the session with its 40 subagents. Agent boxes already run this way
# (their docker scopes are OOMPolicy=continue). If omp itself is the one killed, the wrapper says so.
# The default ceiling (dispatch://INFRA-898, answered on its ask on 2026-10-31): 24 GiB per session,
# above every session measured that day (the largest of 44 held 17.8 GiB at 17:07Z). It scales
# with the host (dispatch://INFRA-993): the larger of 24 GiB and MemTotal/20, in whole GiB, read
# from /proc/meminfo when the scope is made. On sami-rocqperf (251 GiB) that is 24G; on
# sami-devbox (2.1 TiB) it is 109G, where Rust and TypeScript builds reached 24 GiB every few
# minutes on 2026-11-02. A caller's own value stays, clamped at four times the default (96G at the
# floor). A session already inside a ceiling's scope (OMP_MEMORY_SCOPE, set below) takes no
# default of its own: an omp it starts shares its scope and counts against it.
# OMP_MEMINFO names another meminfo file, for the tests.
if [[ -z "${OMP_MEMORY_SCOPE:-}" ]]; then
    mem_total_kb=$(awk '$1 == "MemTotal:" { print $2; exit }' "${OMP_MEMINFO:-/proc/meminfo}" 2>/dev/null || true)
    mem_default_g=$(( ${mem_total_kb:-0} / 20 >> 20 ))
    ((mem_default_g >= 24)) || mem_default_g=24
    mem_clamp_g=$((mem_default_g * 4))
    : "${OMP_MEMORY_MAX:=${mem_default_g}G}"
    if [[ "$OMP_MEMORY_MAX" =~ ^([0-9]+)([KMGT]?)$ ]]; then
        mem_bytes=${BASH_REMATCH[1]}
        case "${BASH_REMATCH[2]}" in
            K) mem_bytes=$((mem_bytes << 10)) ;; M) mem_bytes=$((mem_bytes << 20)) ;;
            G) mem_bytes=$((mem_bytes << 30)) ;; T) mem_bytes=$((mem_bytes << 40)) ;;
        esac
        if ((mem_bytes > mem_clamp_g << 30)); then
            echo "omp: OMP_MEMORY_MAX=$OMP_MEMORY_MAX is above the ${mem_clamp_g}G ceiling for one session; using ${mem_clamp_g}G." >&2
            OMP_MEMORY_MAX=${mem_clamp_g}G
        fi
    fi
fi
# In an agent box no scope is asked for at all. The box's own cgroup, set at `docker run
# --memory` by scripts/agentbox, already is this session's ceiling and kills it the same way,
# and since `shims/systemd-run` makes `--user --scope` work inside a box (2026-11-04) a probe
# there would now SUCCEED and wrap every boxed session in a second cgroup of its own, with the
# host's RAM deciding its size (a box reads the host's /proc/meminfo) — a ceiling above the
# box's own, under a different cgroup than the box's, for no gain.
if [[ -n "${OMP_MEMORY_MAX:-}" ]] && [[ -e "${AGENTBOX_IDENTITY_FILE:-/etc/agentbox-identity}" ]]; then
    unset OMP_MEMORY_MAX
    echo "omp: in an agent box; this session's memory ceiling is the box's own cgroup." >&2
elif [[ -n "${OMP_MEMORY_MAX:-}" ]] && command -v systemd-run >/dev/null 2>&1; then
    mem_max="$OMP_MEMORY_MAX"
    unset OMP_MEMORY_MAX
    export OMP_MEMORY_SCOPE="$mem_max"
    # Under load the systemd user manager waits on the kernel's cgroup lock and a scope request
    # times out ("Failed to start transient scope unit: Connection timed out"): 5 of 7 tries did
    # between 05:04 and 05:20Z on 2026-11-02, at load 450-520. A session started then would run
    # with no ceiling and no OOMPolicy, so the probe tries once more after 10 s before falling
    # back. A box never reaches here: it took the branch above.
    scope_probe() {
        systemd-run --user --scope -q -p MemoryMax="$mem_max" -p MemorySwapMax=0 -p OOMPolicy=continue -- true \
            >/dev/null 2>&1
    }
    if scope_probe || { sleep 10 && scope_probe; }; then
        # A non-interactive shell gives a background job /dev/null as stdin unless the job names
        # its own, and interactive omp then refuses to start ("stdin is not a TTY"). So hand the
        # job the wrapper's own stdin through a spare descriptor. With job control off the job
        # stays in this shell's process group, so it still owns the terminal.
        exec 3<&0
        systemd-run --user --scope -q -p MemoryMax="$mem_max" -p MemorySwapMax=0 -p OOMPolicy=continue \
            -- "$DOTFILES_DIR/scripts/agent-session" omp "$@" <&3 3<&- &
        omp_pid=$!
        exec 3<&-
        for sig in INT TERM HUP QUIT; do
            # shellcheck disable=SC2064
            trap "kill -$sig $omp_pid 2>/dev/null" "$sig"
        done
        # `set -e` would end the wrapper on a non-zero `wait`, before it can say why the session
        # died; and a forwarded signal interrupts `wait` with 128+signal while the session is
        # still running, so wait again until the child is really gone.
        omp_status=0
        until wait "$omp_pid"; do
            omp_status=$?
            kill -0 "$omp_pid" 2>/dev/null || break
        done
        if ((omp_status == 137)); then
            echo "omp: this session was killed at its $mem_max memory ceiling (OMP_MEMORY_MAX)." >&2
            echo "omp: resume it with 'omp --resume <session-id>'; raise the ceiling if it was real work." >&2
        fi
        exit "$omp_status"
    fi
    echo "omp: systemd-run refused a $mem_max scope; starting without a memory ceiling" >&2
fi

exec "$DOTFILES_DIR/scripts/agent-session" omp "$@"
