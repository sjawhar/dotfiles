#!/usr/bin/env bash
# omp wrapper: what an omp session needs on top of scripts/agent-session, then omp.
#
# omp is the first non-wrapper `omp` on PATH once mise has set PATH for this directory: the
# pinned release ("github:sjawhar/oh-my-pi" in mise.toml), or a local build ahead of ~/.mise/shims.
set -euo pipefail

# mise_paths: mise as this machine runs it, whatever HOME and PATH the caller set
# (shims/tests/test_shim_moved_home.py). A Legion test pane runs a shim with a
# temporary HOME and the PATH <bin>:/usr/local/bin:/usr/bin:/bin, where every
# path under HOME names nothing. Sets, once per process:
#   _mise_bin     mise on PATH, else the dotfiles checkout's bin/mise, else the
#                 mise the shims in a data dir link to (a copy or a worktree of
#                 the checkout has no bin/, which is not committed)
#   _mise_config  mise's global configuration: MISE_GLOBAL_CONFIG_FILE, else the
#                 file under HOME when it is readable, else the checkout's
#                 mise.toml, which installers link that file to
#   _mise_datas   the data dirs a tool may be installed in: MISE_DATA_DIR and mise's
#                 default ~/.local/share/mise under HOME; with no MISE_DATA_DIR,
#                 ~/.mise (.bashrc's) and that default, under HOME, then the passwd home's
#   _mise_data    the one to give mise: MISE_DATA_DIR, else the first that exists
# The checkout is DOTFILES_DIR, else the one this file's own path is in.
mise_paths() {
    local IFS=$' \t\n'
    local self dotfiles home dir data seen=""
    local -a all=()
    [[ -z "${_mise_config:-}" ]] || return 0
    _mise_bin=""
    IFS=':'
    for dir in ${PATH:-}; do
        if [[ -n "$dir" && -f "$dir/mise" && -x "$dir/mise" ]]; then
            _mise_bin="$dir/mise"
            break
        fi
    done
    IFS=$' \t\n'
    _mise_config="${MISE_GLOBAL_CONFIG_FILE:-${XDG_CONFIG_HOME:-${HOME:-}/.config}/mise/config.toml}"
    if [[ -z "$_mise_bin" || ( -z "${MISE_GLOBAL_CONFIG_FILE:-}" && ! -r "$_mise_config" ) ]]; then
        dotfiles="${DOTFILES_DIR:-}"
        if [[ -z "$dotfiles" ]]; then
            self="$(command -p readlink -f -- "${BASH_SOURCE[0]}")" || self=""
            dotfiles="${self%/shims/*}"
        fi
        [[ -n "$_mise_bin" ]] || _mise_bin="$dotfiles/bin/mise"
        [[ -n "${MISE_GLOBAL_CONFIG_FILE:-}" || -r "$_mise_config" ]] || _mise_config="$dotfiles/mise.toml"
    fi
    if [[ -n "${MISE_DATA_DIR:-}" ]]; then
        all=("$MISE_DATA_DIR" "${XDG_DATA_HOME:-${HOME:-}/.local/share}/mise")
    else
        all=("${HOME:-}/.mise" "${XDG_DATA_HOME:-${HOME:-}/.local/share}/mise")
        # With HOME unset, ~ is the uid's home in the passwd database, which HOME does not move.
        local HOME
        unset HOME
        home=~
        [[ "$home" != /?* ]] || all+=("$home/.mise" "$home/.local/share/mise")
    fi
    _mise_datas=() _mise_data="${MISE_DATA_DIR:-}"
    for data in "${all[@]}"; do
        [[ "$data" == /?* && ":$seen:" != *":$data:"* ]] || continue
        seen+=":$data"
        _mise_datas+=("$data")
        [[ -n "$_mise_data" || ! -d "$data" ]] || _mise_data="$data"
    done
    if [[ ! -f "$_mise_bin" || ! -x "$_mise_bin" ]]; then
        for data in ${_mise_datas[@]+"${_mise_datas[@]}"}; do
            for dir in "$data"/shims/*; do
                [[ -L "$dir" ]] || continue
                dir="$(command -p readlink -f -- "$dir")" || dir=""
                [[ "$dir" != */mise || ! -f "$dir" || ! -x "$dir" ]] || _mise_bin="$dir"
                break
            done
            [[ ! -x "$_mise_bin" ]] || break
        done
    fi
    : "${_mise_data:=${_mise_datas[0]:-}}"
}

# The dotfiles checkout this file is in, through a link to it, not the one under HOME: a caller
# may give omp a HOME of its own (shims/tests/test_shim_moved_home.py).
_omp_self="$(command -p readlink -f -- "${BASH_SOURCE[0]}")"
DOTFILES_DIR="${DOTFILES_DIR:-${_omp_self%/shims/*}}"

# mise's environment for this directory. A session keeps the PATH it started with, so a PATH can
# still name the install dir of an older pin; mise puts the current pin's dir in its place. A pin
# that is not installed leaves no omp install dir, and agent-session refuses.
# mise lives in ~/.dotfiles/bin, which a unit's or harness's PATH can leave out while it keeps
# this shim; then the shim runs that mise by its path, with .bashrc's data dir, and, where HOME
# holds no mise configuration, the checkout's mise.toml as mise's global configuration (mise_paths).
mise_paths
export MISE_DATA_DIR="$_mise_data"
if [[ "$_mise_config" == "${XDG_CONFIG_HOME:-${HOME:-}/.config}/mise/config.toml" ]]; then
    mise_env="$("$_mise_bin" env -s bash)"
else
    mise_env="$(MISE_GLOBAL_CONFIG_FILE="$_mise_config" "$_mise_bin" env -s bash)"
fi
eval "$mise_env"

# glibc gives each allocating thread its own 64 MiB arena and never returns freed chunks; omp's
# native addon allocates from ~140 threads, so a long session retained 1-2 GB of dead native
# memory. Two shared arenas hold it under ~30 MB (measured idle: 24 MB flat versus 104 MB growing
# 45 MB/min). Bun and JavaScriptCore use mimalloc, so only the native side changes.
export MALLOC_ARENA_MAX="${MALLOC_ARENA_MAX:-2}"

# Mnemopi ranks recall by veracity, and omp labels a deliberate `retain`/`learn` save `tool` and
# a transcript slice `unknown`. Mnemopi's stock weights (tool 0.5, unknown 0.8) therefore rank
# raw transcript above curated memory; these weight by provenance instead, and lean semantic over
# keyword so a one-line fact is not out-matched on term overlap by a long transcript. omp has no
# setting for them, only these variables; a caller's value wins. Their effect on what recall
# injects is unmeasured.
export MNEMOPI_TOOL_WEIGHT="${MNEMOPI_TOOL_WEIGHT:-1.0}"
export MNEMOPI_UNKNOWN_WEIGHT="${MNEMOPI_UNKNOWN_WEIGHT:-0.5}"
export MNEMOPI_VEC_WEIGHT="${MNEMOPI_VEC_WEIGHT:-0.6}"
export MNEMOPI_FTS_WEIGHT="${MNEMOPI_FTS_WEIGHT:-0.2}"
export MNEMOPI_IMPORTANCE_WEIGHT="${MNEMOPI_IMPORTANCE_WEIGHT:-0.2}"

# omp's bash tool runs every call in one persistent shell, so `set -e`, `-u` or `-o pipefail` at
# one call's top level stays on for every later call and silently breaks them (`yes | head -n 1`
# exits 141, a `grep -c` counting zero ends the command). omp puts PI_SHELL_PREFIX in front of
# each command inside its executor, so the model's command text never shows it; a caller's value
# wins. Costs: a `!cd` typed in the TUI no longer moves the session's cwd, and `set -x` and
# `shopt` changes still carry over.
export PI_SHELL_PREFIX="${PI_SHELL_PREFIX:-set +e +u +o pipefail;}"

# omp/config.yml is every profile's settings of record, loaded as a PI_CONFIG_FILES overlay omp
# never writes; runtime writes (/model picks, prompt answers) land in the profile's own
# config.yml and lose to it on the next start. Later entries win, so a caller's overlays stay on
# top, and a nested launch does not add it twice.
overlay="$DOTFILES_DIR/omp/config.yml"
case ":${PI_CONFIG_FILES:-}:" in
    *":$overlay:"*) ;;
    *) export PI_CONFIG_FILES="$overlay${PI_CONFIG_FILES:+:$PI_CONFIG_FILES}" ;;
esac

# installers/omp-embed.sh runs one embedding server per machine and records its URL. Pointed at
# it, mnemopi spawns no ~1 GB embedding worker per session. Only while it answers: a dead server
# would leave the session on keyword-only recall, while no URL keeps the in-process worker.
embed_file="${XDG_CONFIG_HOME:-$HOME/.config}/omp-embed/endpoint"
if [[ -z "${MNEMOPI_EMBEDDING_API_URL:-}" && -r "$embed_file" ]]; then
    embed_url="$(<"$embed_file")"
    if curl -fsS -m 1 "${embed_url%/v1}/health" >/dev/null 2>&1; then
        export MNEMOPI_EMBEDDING_API_URL="$embed_url"
    fi
fi

# A named profile gets the shared setup unless it opts out (below): its symlinks track
# installers/omp.sh's in ~/.omp and ~/.omp/agent (created, re-pointed, retired), and its real
# files are its own, as is a link it holds where the default has a real entry (legion's agent.db,
# a link to the personal profile's). config.yml comes from the overlay above; models.yml (provider
# routes and keys) and envoy.json are the profile's own, so neither is mirrored or pruned. A
# profile opts out when its directory, $root/profiles/NAME/ (the profile's top directory, since
# the setup writes there too), holds .no-shared-setup, a file or a directory; a link counts only
# while its target exists (`-e`). The profile's owner writes it: the Legion deployment's "Set up"
# writes it in legion. The shim's mirror into legion linked the default's agents into it: the
# Legion daemon's boot check refused on the dotfiles `oracle` agent on 2026-11-09, and `oracle`
# subagents failed in Legion panes on 2026-11-11 and 2026-11-12 (dispatch://HOME-163). The
# marker stops the shim's writes, not omp's own (sessions, logs, SQLite). The profile is the last
# --profile before a `--`, else OMP_PROFILE when it is defined, else PI_PROFILE when it is
# defined, else the machine's own default below; a misread costs only these links.
#
# A machine whose bare `omp` starts a named profile says so in a file of its own, outside this
# repo: ${XDG_CONFIG_HOME:-$HOME/.config}/omp/profile, holding the profile's name. Sami's personal
# machine (oryx) holds `personal`, so his sessions there start on his own accounts and memory
# without a flag. A machine without the file keeps the default profile. The shim exports the name
# as OMP_PROFILE, so omp, its subagents, its scripted `omp -p` runs and shims/ctx (which picks the
# personal memory server by it) all see it. `--profile default` still starts the default profile.
# omp removes OMP_PROFILE from a default-profile session's environment, so on such a machine a
# launch that resolves to the default exports OMP_IN_DEFAULT_PROFILE=1, and an omp it starts with
# no profile named stays in the default instead of taking the file's.
profile="" flagged="" prev=""
for arg in "$@"; do
    [[ "$arg" == -- ]] && break
    if [[ "$prev" == --profile ]]; then
        profile="$arg" flagged=1
    elif [[ "$arg" == --profile=* ]]; then
        profile="${arg#--profile=}" flagged=1
    fi
    prev="$arg"
done
profile_file="${XDG_CONFIG_HOME:-$HOME/.config}/omp/profile"
if [[ -z "$flagged" ]]; then
    if [[ -n "${OMP_PROFILE+x}" ]]; then
        profile="$OMP_PROFILE"
    elif [[ -n "${PI_PROFILE+x}" ]]; then
        profile="$PI_PROFILE"
    elif [[ -z "${OMP_IN_DEFAULT_PROFILE:-}" && -r "$profile_file" ]]; then
        profile=$(tr -d '[:space:]' <"$profile_file")
        export OMP_PROFILE="$profile"
    fi
fi
[[ "$profile" == default ]] && profile=""
if [[ -n "$profile" && ! "$profile" =~ ^[a-z0-9][a-z0-9._-]*$ ]]; then
    echo "omp: invalid profile name: $profile (lowercase letters, digits, '.', '-', '_'; starting with a letter or digit)" >&2
    exit 2
fi
if [[ -r "$profile_file" ]]; then
    if [[ -z "$profile" ]]; then export OMP_IN_DEFAULT_PROFILE=1; else unset OMP_IN_DEFAULT_PROFILE; fi
fi

# omp/config.local.yml (gitignored, machine-local) is the box's own model routing. On sami-rocqperf it points every
# Anthropic role at Theorem's model gateway and falls each one back to the same model on the direct Anthropic
# login (dispatch://INFRA-398; Sami, 2026-11-01 17:13Z, after the 12:35-16:20Z outage of the shared login). It
# loads after omp/config.yml, so it wins on the roles it names, and before a caller's own overlays, so a `--config`
# file still wins over both. A machine without the file is unchanged.
# The default profile alone gets it: a named profile such as `pbc` bills another Anthropic account, so it gets
# omp/config.<profile>.local.yml in the same place instead, when that file exists (on sami-rocqperf,
# config.pbc.local.yml points the pbc roles at the gateway's `pbc/` groups, team verified-grader, which bill PBC;
# Sami, 2026-11-03 14:31Z, dispatch://INFRA-481/ask/2a5a0149: "Just move our agents."). Without that file a named
# profile keeps config.yml's direct `anthropic/...` roles. A nested launch inherits PI_CONFIG_FILES from its parent,
# so a launch drops every local overlay the parent added before adding its own, and the parent's scope overlay
# (config.scopes.yml, below) too.
local_overlay="$DOTFILES_DIR/omp/config.local.yml"
[[ -n "$profile" ]] && local_overlay="$DOTFILES_DIR/omp/config.$profile.local.yml"
pi_files=""
IFS=: read -ra pi_entries <<<"${PI_CONFIG_FILES:-}"
for entry in "${pi_entries[@]}"; do
    [[ "$entry" == "$DOTFILES_DIR"/omp/config.*local.yml && "$entry" != "$local_overlay" ]] && continue
    [[ "$entry" == */agent/config.scopes.yml ]] && continue
    pi_files="${pi_files:+$pi_files:}$entry"
done
export PI_CONFIG_FILES="$pi_files"
if [[ -f "$local_overlay" ]]; then
    case ":${PI_CONFIG_FILES:-}:" in
        *":$local_overlay:"*) ;;
        *) export PI_CONFIG_FILES="${PI_CONFIG_FILES/"$overlay"/"$overlay:$local_overlay"}" ;;
    esac
fi

# A profile's copy of one shared config file (lsp.json, keybindings.yml, WATCHDOG.*,
# SAMI-RULES.md), or of the mcp.json the scope step builds (below). A link would let anything that
# writes the profile's file write the shared one instead: on 2026-11-01 a probe harness wrote
# `{ "mcpServers": {} }` to its profile's agent/mcp.json, which was a link to
# ~/.dotfiles/omp/mcp.json, and every session on the box started with no MCP servers. So the
# profile holds a real copy, refreshed from the shared file on each launch while it is still
# exactly what was last copied (recorded in DST/.mirror-src/NAME). A file the profile wrote itself,
# or changed since, stays the profile's and is no longer refreshed.
mirror_copy() { # mirror_copy SOURCE DST NAME
    local shared="$1" dst="$2" name="$3"
    local copy="$dst/$name" last="$dst/.mirror-src/$name"
    [[ -L "$copy" ]] && rm -f "$copy"
    if [[ -e "$copy" ]]; then
        [[ -f "$last" ]] && cmp -s "$copy" "$last" || return 0
        cmp -s "$shared" "$copy" && return 0
    fi
    mkdir -p "$dst/.mirror-src"
    { cp "$shared" "$copy.new.$$" && mv -f "$copy.new.$$" "$copy" \
        && cp "$copy" "$last.new.$$" && mv -f "$last.new.$$" "$last"; } 2>/dev/null \
        || rm -f "$copy.new.$$" "$last.new.$$"
}
mirror_links() { # mirror_links SRC DST [copy-files]
    local src="$1" dst="$2" copy_files="${3:-}" entry name
    mkdir -p "$dst"
    for entry in "$dst"/*; do
        name="${entry##*/}"
        # The scope step (below) builds mcp.json for each profile from omp/mcp.json.
        [[ "$name" == mcp.json ]] && continue
        if [[ ! -L "$entry" ]]; then
            # A copy whose shared file is gone goes too, unless the profile changed it.
            if [[ -n "$copy_files" && -f "$dst/.mirror-src/$name" && ! -L "$src/$name" ]] \
                && cmp -s "$entry" "$dst/.mirror-src/$name"; then
                rm -f "$entry" "$dst/.mirror-src/$name"
            fi
            continue
        fi
        case "$name" in config.yml|models.yml) rm -f "$entry"; continue ;; envoy.json) continue ;; esac
        # Only the default's links are mirrored, so a link beside a real default entry is the
        # profile's own (legion's agent.db, a link to the personal profile's logins, pruned at
        # ~07:46Z on 2026-11-09). A mirrored link whose source is gone still goes.
        [[ -L "$src/$name" || -e "$src/$name" ]] || rm -f "$entry"
    done
    for entry in "$src"/*; do
        name="${entry##*/}"
        case "$name" in config.yml|models.yml|envoy.json|mcp.json) continue ;; esac
        if [[ -L "$entry" ]]; then
            if [[ -n "$copy_files" && -f "$entry" && ! -d "$entry" ]]; then
                mirror_copy "$entry" "$dst" "$name"
            elif [[ -L "$dst/$name" || ! -e "$dst/$name" ]] \
                && [[ "$(readlink "$dst/$name" 2>/dev/null)" != "$(readlink "$entry")" ]]; then
                ln -sfn "$(readlink "$entry")" "$dst/$name"
            fi
        elif [[ "$name" == extensions && -d "$entry" ]]; then
            # Extension code stays linked: a copied .ts would resolve its imports from the profile.
            mirror_links "$entry" "$dst/$name"
        fi
    done
}
# A profile whose agent/ holds models.overlay.yml is the default profile with other provider keys,
# not a separate install (dispatch://BET-59, 2026-10-30: the verified-grader sessions bill Anthropic
# to another account). It shares every piece of state with the default: each entry of ~/.omp (but
# agent/, profiles/, run/ and .no-shared-setup, since an old shim moved one there and a link to it
# would opt the profile out) and of ~/.omp/agent (but models.yml, models.overlay.yml, SQLite's
# -wal/-shm, which SQLite places beside the link's target, and what the scope step below builds for
# each profile: mcp.json, config.scopes.yml, their temporary files and .mirror-src) is a link to the
# default's, re-made on every launch, so an entry a newer omp adds is shared too; dotfiles
# included, since omp reads an agent/.env. An entry omp created in the profile first, with no
# default counterpart, is moved into the default and linked. One that exists on both sides as a
# real entry stops the launch: it means divergent state, and a human decides which copy is real.
# models.yml is the profile's: the default's merged with the overlay, rebuilt on every launch, so
# it cannot drift from the default.
# The merge deep-merges maps but replaces arrays, so an overlay that carries a `models:` list
# replaces the default's list instead of adding to it. Measured by the omp maintainer on a scratch
# home (2026-10-30): one SQLite WAL set, one session store, and sessions resume through either root.
# same_content A B: do two regular files say the same thing? Bytes first, and for JSON a parse,
# because omp writes these with its own key order: the pbc profile's marketplaces.json and the
# default's were equal as documents and different as bytes. Anything that is not two readable
# regular files, or JSON that will not parse, is "different" -- the careful answer, since the
# caller refuses the launch on it.
#
# A field the writer stamps on every write is not content. At 02:15:41Z on 2026-11-08 a writer
# replaced the pbc profile's marketplaces.json link with a real file, and the copy differed from
# the default in `updatedAt` ALONE -- 02:15:41.817Z against 02:17:45.524Z, diffed twice by the
# grading lane, once pretty-printed and once with sorted keys. That one field made this function
# say "different", so every omp launch under the profile refused from 02:15Z until the link was
# restored by hand at 02:19Z, and three review arms died on it. A stale duplicate is not
# divergent state. Only these write stamps are ignored, and only inside JSON: anything the
# profile actually says differently still stops the launch, because a real per-profile change
# silently discarded at startup is worse than the breakage this prevents.
same_content() {
    local a="$1" b="$2"
    [[ -f "$a" && -f "$b" ]] || return 1
    cmp -s "$a" "$b" && return 0
    [[ "$a" == *.json && "$b" == *.json ]] || return 1
    python3 - "$a" "$b" <<'PY'
import json, sys
STAMPS = {"updatedAt", "updated_at", "fetchedAt", "fetched_at", "lastChecked", "checkedAt"}


def strip(value):
    if isinstance(value, dict):
        return {k: strip(v) for k, v in value.items() if k not in STAMPS}
    if isinstance(value, list):
        return [strip(v) for v in value]
    return value


try:
    with open(sys.argv[1]) as fa, open(sys.argv[2]) as fb:
        sys.exit(0 if strip(json.load(fa)) == strip(json.load(fb)) else 1)
except Exception:
    sys.exit(1)
PY
}

share_links() { # share_links SRC DST KEEP_NAME...
    local src="$1" dst="$2" entry name keep dotglob_was=""
    shift 2
    shopt -q dotglob && dotglob_was=1
    shopt -s dotglob
    mkdir -p "$dst"
    for entry in "$dst"/*; do
        [[ -e "$entry" && ! -L "$entry" ]] || continue
        name="${entry##*/}"
        # shellcheck disable=SC2053 # each KEEP_NAME is a glob
        for keep in "$@"; do [[ "$name" == $keep ]] && continue 2; done
        if [[ -e "$src/$name" || -L "$src/$name" ]]; then
            # Same content on both sides is not divergent state, and refusing on it costs every
            # launch of the profile. omp rewrites some of these files itself (marketplaces.json
            # on a marketplace refresh) and has twice replaced the link with a regular file, on
            # 2026-11-04 and again at 16:37Z on 2026-11-07, when concurrent `omp -p` launches
            # raced; the two copies then differed only in key order. Move the copy aside, keep
            # it, and link. Only a real difference still stops the launch.
            if same_content "$entry" "$src/$name"; then
                mv "$entry" "$entry.replaced-$(date -u +%Y%m%dT%H%M%SZ)"
                ln -s "$src/$name" "$entry"
                echo "omp: $dst/$name was a copy of $src/$name; moved it aside and relinked" >&2
                continue
            fi
            echo "omp: $dst/$name and $src/$name are both real and their contents differ; this profile shares all state with the default, so remove the copy that is not real and launch again" >&2
            exit 1
        fi
        mv "$entry" "$src/$name"
        ln -s "$src/$name" "$entry"
    done
    for entry in "$src"/*; do
        [[ -e "$entry" || -L "$entry" ]] || continue
        name="${entry##*/}"
        # shellcheck disable=SC2053 # each KEEP_NAME is a glob
        for keep in "$@"; do [[ "$name" == $keep ]] && continue 2; done
        [[ "$(readlink "$dst/$name" 2>/dev/null)" == "$entry" ]] || ln -sfn "$entry" "$dst/$name"
    done
    [[ -n "$dotglob_was" ]] || shopt -u dotglob
}
root="$HOME/${PI_CONFIG_DIR:-.omp}"
# Sami's rules, for every session and its task subagents: ~/.omp/agent/SAMI-RULES.md, a link to
# .claude/CLAUDE.md that omp/config.yml names in contextFiles.extra. installers/omp.sh makes it, but a
# machine that takes a change through scripts/dotfiles-follow never runs that installer, so each
# launch makes the link, or re-points one that names another file, before the setup below copies or
# links it into a named profile. A real file there is someone's own and stays. The new link is made
# under a dot name the mirror skips and renamed into place, so a concurrent launch never sees a gap.
rules_link="$root/agent/SAMI-RULES.md"
rules_src="$DOTFILES_DIR/.claude/CLAUDE.md"
if [[ ! -e "$rules_link" && ! -L "$rules_link" ]] \
    || { [[ -L "$rules_link" && ! -d "$rules_link" ]] && [[ "$(readlink "$rules_link")" != "$rules_src" ]]; }; then
    mkdir -p "$root/agent"
    { ln -s "$rules_src" "$root/agent/.SAMI-RULES.md.new.$$" \
        && mv -f "$root/agent/.SAMI-RULES.md.new.$$" "$rules_link"; } 2>/dev/null \
        || rm -f "$root/agent/.SAMI-RULES.md.new.$$"
fi
if [[ -n "$profile" && ! -e "$root/profiles/$profile/.no-shared-setup" ]]; then
    overlay_models="$root/profiles/$profile/agent/models.overlay.yml"
    if [[ -f "$overlay_models" ]]; then
        # Fail before changing profile state: a stale key may bill the wrong account, and a
        # warning followed by retries hides the broken command until the first model call.
        "$DOTFILES_DIR/scripts/omp-models-check" "$root/agent/models.yml" "$overlay_models"
        # Several sessions launch at once: one link pass at a time, so two shims never both move
        # the same new entry into the default. Bounded, so a stuck holder fails launches loudly
        # instead of hanging them, and never lets one start half-linked.
        exec 9>"$root/profiles/$profile/.share.lock"
        if ! flock -w 30 9; then
            echo "omp: waited 30 s for $root/profiles/$profile/.share.lock; profile $profile not started" >&2
            exit 1
        fi
        share_links "$root" "$root/profiles/$profile" agent profiles run .share.lock .no-shared-setup
        share_links "$root/agent" "$root/profiles/$profile/agent" \
            models.yml models.overlay.yml 'models.yml.new.*' '*-wal' '*-shm' \
            mcp.json 'mcp.json.*' config.scopes.yml 'config.scopes.yml.*' .mirror-src '.SAMI-RULES.md.new.*'
        # pi-envoy reads a named profile's agent/envoy.json instead of ~/.config/legion/envoy.json.
        # A link to a missing file counts too: `ln` would refuse every later launch.
        envoy_json="$root/profiles/$profile/agent/envoy.json"
        [[ -e "$envoy_json" || -L "$envoy_json" ]] ||
            ln -s "${XDG_CONFIG_HOME:-$HOME/.config}/legion/envoy.json" "$envoy_json"
        exec 9>&-
        models_out="$root/profiles/$profile/agent/models.yml"
        # 0600: the default's models.yml can hold literal keys (scripts/omp-models-build, `apiKeyFile`).
        (
            umask 077
            models_tmp="$models_out.new.$$"
            trap 'rm -f "$models_tmp"' EXIT
            # shellcheck disable=SC2016 # a yq expression, not the shell's
            yq eval-all '. as $item ireduce ({}; . * $item)' "$root/agent/models.yml" "$overlay_models" > "$models_tmp"
            # Check the bytes being installed too: a source can change while the lock waits.
            "$DOTFILES_DIR/scripts/omp-models-check" "$models_tmp"
            if cmp -s "$models_tmp" "$models_out"; then chmod 600 "$models_out"; else mv "$models_tmp" "$models_out"; fi
        )
    else
        mirror_links "$root" "$root/profiles/$profile"
        mirror_links "$root/agent" "$root/profiles/$profile/agent" copy-files
    fi
fi

# Where each MCP server and skill loads. omp/scopes.yml names an MCP server, or a skill by a name or
# a glob as skills.ignoredSkills takes them, each with `context: personal|theorem`,
# `host: <short hostname>` or both; what it does not name loads everywhere. A session's context is
# its profile when that is `personal` or `theorem`, else the word in the machine's own
# ${XDG_CONFIG_HOME:-$HOME/.config}/omp/context (outside this repo, like omp/profile above). No
# file, or any other word, is UNKNOWN: every context-scoped entry loads, so a machine or an agent
# box that never declared a context loses nothing, and a `host:` entry still applies. The host is
# the machine's short name, as ENVOY_MACHINE_ID takes it (scripts/agent-session): AGENTBOX_HOST in
# an agent box, which shares its machine's ~/.omp and so these files, else `hostname -s`, each cut
# at its first dot.
# For each profile the shim sets up (the default, and a named profile without .no-shared-setup),
# each launch builds two files in the profile's agent directory. mcp.json is omp/mcp.json without
# the servers the context and host exclude, and with each of them in its disabledServers, which
# hides a server of that name from every source: a plugin brings its own servers, named
# `<plugin>:<server>` (the slack plugin's `slack:slack`), which a server of omp/mcp.json shadows
# only while it loads. mcp.json follows mirror_copy's rule: a profile that wrote its own mcp.json,
# or changed the built one (omp's /mcp disable writes it), keeps that file, unscoped from then on.
# config.scopes.yml is a settings overlay whose skills.ignoredSkills is omp/config.yml's
# list, the local overlay's when it sets one, and every skill the context and host exclude: a
# later overlay's list replaces an earlier one's, so it must carry all three. It goes right after
# the dotfiles overlays, so a caller's own overlays still win. Each file is written whole under a
# temporary name and renamed into place, so concurrent launches never leave or read a partial file.
# Without a yq that reads all three, the session starts unscoped and says so.
# Claude Code's CLAUDE_CONFIG_DIR (.bashrc points it at the tracked .claude/) also opts omp into
# Claude Code's user root, and omp then loads the stale plugin copies of Claude Code's plugin
# registry (.claude/plugins/cache) as duplicate skills (sjawhar/*, superpowers/*, knives/*) in
# every directory. So a session the shim sets up starts without it, once its own SAMI-RULES.md
# (above; the setup copies or links it into each named profile) is a readable file: Sami's rules
# reach it, and its task subagents, through that file. Without one, CLAUDE_CONFIG_DIR is how the
# rules arrive, so the launch keeps it and says so. A marked profile's owner manages its setup, and
# it keeps the variable.
# scope_excluded SECTION: a yq expression for the keys of omp/scopes.yml's SECTION (mcp or skills)
# that SCOPE_CONTEXT and SCOPE_HOST exclude; an empty SCOPE_CONTEXT is UNKNOWN.
scope_excluded() {
    printf '(.%s // {}) | to_entries | map(select(((.value.context // "") != "" and strenv(SCOPE_CONTEXT) != "" and .value.context != strenv(SCOPE_CONTEXT)) or ((.value.host // "") != "" and .value.host != strenv(SCOPE_HOST)))) | map(.key)' "$1"
}
scope_build() { # scope_build AGENT_DIR CONTEXT HOST
    local dir="$1" lists='(load(strenv(SCOPE_CONFIG)).skills.ignoredSkills // [])'
    local built="$1/mcp.json.built.$$" settings="$1/config.scopes.yml"
    local -x SCOPE_MANIFEST="$DOTFILES_DIR/omp/scopes.yml" SCOPE_CONTEXT="$2" SCOPE_HOST="$3" \
        SCOPE_CONFIG="$overlay" SCOPE_LOCAL="$local_overlay"
    [[ -f "$local_overlay" ]] && lists+=' + (load(strenv(SCOPE_LOCAL)).skills.ignoredSkills // [])'
    if yq -o=json -I2 "(load(strenv(SCOPE_MANIFEST)) | $(scope_excluded mcp)) as \$drop
            | .mcpServers |= with_entries(select((.key as \$k | \$drop | any_c(. == \$k)) | not))
            | .disabledServers = ((.disabledServers // []) + \$drop | unique)
            | del(.disabledServers | select(length == 0))" \
            "$DOTFILES_DIR/omp/mcp.json" >"$built" \
        && yq "($lists + ($(scope_excluded skills))) | unique | {\"skills\": {\"ignoredSkills\": .}}" \
            "$SCOPE_MANIFEST" >"$settings.new.$$"; then
        mirror_copy "$built" "$dir" mcp.json
        if cmp -s "$settings.new.$$" "$settings"; then rm -f "$settings.new.$$"; else mv -f "$settings.new.$$" "$settings"; fi
        rm -f "$built"
        return 0
    fi
    rm -f "$built" "$settings.new.$$"
    return 1
}
if [[ -z "$profile" || ! -e "$root/profiles/$profile/.no-shared-setup" ]]; then
    rules_file="$root/agent/SAMI-RULES.md"
    [[ -z "$profile" ]] || rules_file="$root/profiles/$profile/agent/SAMI-RULES.md"
    if [[ -f "$rules_file" && -r "$rules_file" ]]; then
        unset CLAUDE_CONFIG_DIR
    elif [[ -n "${CLAUDE_CONFIG_DIR:-}" ]]; then
        echo "omp: $rules_file is not a readable file, so this session keeps CLAUDE_CONFIG_DIR for Sami's rules (and Claude Code's stale plugin skills with them)" >&2
    else
        echo "omp: $rules_file is not a readable file and CLAUDE_CONFIG_DIR is unset, so this session has no rules file of Sami's" >&2
    fi
    agent_dir="$root/agent"
    [[ -z "$profile" ]] || agent_dir="$root/profiles/$profile/agent"
    context=""
    case "$profile" in
        personal | theorem) context="$profile" ;;
        *)
            context_file="${XDG_CONFIG_HOME:-$HOME/.config}/omp/context"
            [[ ! -r "$context_file" ]] || context=$(tr -d '[:space:]' <"$context_file")
            [[ "$context" == personal || "$context" == theorem ]] || context=""
            ;;
    esac
    host="${AGENTBOX_HOST:-$(hostname -s)}"
    mkdir -p "$agent_dir"
    scope_failed=""
    if ! command -v yq >/dev/null 2>&1; then
        scope_failed="yq is not on PATH"
    elif ! scope_build "$agent_dir" "$context" "${host%%.*}"; then
        scope_failed="yq could not read omp/scopes.yml, omp/mcp.json or a config overlay (above)"
    fi
    if [[ -n "$scope_failed" ]]; then
        echo "omp: $scope_failed, so this session loads every MCP server and skill (omp/scopes.yml)" >&2
        mirror_copy "$DOTFILES_DIR/omp/mcp.json" "$agent_dir" mcp.json
    else
        # Right after the last dotfiles overlay: the local overlay where the list names it.
        anchor="$overlay"
        [[ ":$PI_CONFIG_FILES:" != *":$local_overlay:"* ]] || anchor="$local_overlay"
        pi_files=""
        IFS=: read -ra pi_entries <<<"$PI_CONFIG_FILES"
        for entry in "${pi_entries[@]}"; do
            pi_files="${pi_files:+$pi_files:}$entry"
            if [[ "$entry" == "$anchor" ]]; then
                pi_files+=":$agent_dir/config.scopes.yml"
                anchor=""
            fi
        done
        export PI_CONFIG_FILES="$pi_files"
    fi
fi

# OMP_MEMORY_MAX=<systemd size, e.g. 32G> runs this session in a transient systemd user scope with
# that hard memory cap and swap off. A session that runs away is then killed inside its own cgroup
# instead of the kernel picking a victim anywhere on the box: on 2026-10-26 at 05:47Z one omp
# session reached 138.0 GiB and the global OOM killer took two of the box's coredns pods with it.
# Unset, the default below applies (the larger of 24G and a twentieth of the host's RAM). A scope is transient, so
# it leaves no unit file behind. OMP_MEMORY_MAX is removed from the session's own environment, so
# subprocesses do not each ask for a scope of their own; they share this one and count against it.
# If systemd-run is missing or refuses (a container with no user manager), the session starts
# uncapped rather than failing.
#
# No MemoryHigh: measured on this box, a cap with MemoryHigh below it does not kill a session that
# passes it, it throttles the session into reclaim and the lane looks like it is thinking (an omp
# start under a 192M cap with MemoryHigh at 144M was still in `discoverAndLoadMCPTools` after 84 s).
# A plain MemoryMax kills promptly, and the wrapper waits for the session so it can say why: a
# ceiling nobody can see costs a lead more time than the kill itself.
# OOMPolicy=continue: at the ceiling the kernel kills the largest process in the scope, usually a
# runaway child, and the session should live on. systemd's default for a scope is `stop`, which
# ends the whole scope after that kill: at 2026-11-02T03:22:08Z the kernel killed the right child
# and systemd then stopped the session with its 40 subagents. Agent boxes already run this way
# (their docker scopes are OOMPolicy=continue). If omp itself is the one killed, the wrapper says so.
# The default ceiling (dispatch://INFRA-898, answered on its ask on 2026-10-31): 24 GiB per session,
# above every session measured that day (the largest of 44 held 17.8 GiB at 17:07Z). It scales
# with the host (dispatch://INFRA-993): the larger of 24 GiB and MemTotal/20, in whole GiB, read
# from /proc/meminfo when the scope is made. On sami-rocqperf (251 GiB) that is 24G; on
# sami-devbox (2.1 TiB) it is 109G, where Rust and TypeScript builds reached 24 GiB every few
# minutes on 2026-11-02. A caller's own value stays, clamped at four times the default (96G at the
# floor). A session already inside a ceiling's scope (OMP_MEMORY_SCOPE, set below) takes no
# default of its own: an omp it starts shares its scope and counts against it.
# OMP_MEMINFO names another meminfo file, for the tests.
#
# A machine that gives its sessions no ceiling says so in a file of its own, outside this repo:
# ${XDG_CONFIG_HOME:-$HOME/.config}/omp/memory-max, holding `off` or a systemd size (`48G`). The
# ceiling protects a box many people's sessions share; Sami's personal machine (oryx, 62 GiB) runs
# one assistant session with its subagents, and the 24 GiB default killed it with all of them on
# 2026-11-04 at 18:20Z, with 30 GiB of the machine still free. A machine without the file keeps
# the default. A caller's OMP_MEMORY_MAX wins over the file, and `off` there starts that one launch
# with no scope. A session started with no ceiling exports OMP_MEMORY_SCOPE=off, so an omp it
# starts takes no default either.
if [[ -z "${OMP_MEMORY_SCOPE:-}" ]]; then
    memory_max_file="${XDG_CONFIG_HOME:-$HOME/.config}/omp/memory-max"
    if [[ -z "${OMP_MEMORY_MAX:-}" && -r "$memory_max_file" ]]; then
        OMP_MEMORY_MAX=$(tr -d '[:space:]' <"$memory_max_file")
    fi
    if [[ "${OMP_MEMORY_MAX:-}" == off ]]; then
        unset OMP_MEMORY_MAX
        export OMP_MEMORY_SCOPE=off
    else
        mem_total_kb=$(awk '$1 == "MemTotal:" { print $2; exit }' "${OMP_MEMINFO:-/proc/meminfo}" 2>/dev/null || true)
        mem_default_g=$(( ${mem_total_kb:-0} / 20 >> 20 ))
        ((mem_default_g >= 24)) || mem_default_g=24
        mem_clamp_g=$((mem_default_g * 4))
        : "${OMP_MEMORY_MAX:=${mem_default_g}G}"
        if [[ "$OMP_MEMORY_MAX" =~ ^([0-9]+)([KMGT]?)$ ]]; then
            mem_bytes=${BASH_REMATCH[1]}
            case "${BASH_REMATCH[2]}" in
                K) mem_bytes=$((mem_bytes << 10)) ;; M) mem_bytes=$((mem_bytes << 20)) ;;
                G) mem_bytes=$((mem_bytes << 30)) ;; T) mem_bytes=$((mem_bytes << 40)) ;;
            esac
            if ((mem_bytes > mem_clamp_g << 30)); then
                echo "omp: OMP_MEMORY_MAX=$OMP_MEMORY_MAX is above the ${mem_clamp_g}G ceiling for one session; using ${mem_clamp_g}G." >&2
                OMP_MEMORY_MAX=${mem_clamp_g}G
            fi
        fi
    fi
fi
# In an agent box no scope is asked for at all. The box's own cgroup, set at `docker run
# --memory` by scripts/agentbox, already is this session's ceiling and kills it the same way,
# and since `shims/systemd-run` makes `--user --scope` work inside a box (2026-11-04) a probe
# there would now SUCCEED and wrap every boxed session in a second cgroup of its own, with the
# host's RAM deciding its size (a box reads the host's /proc/meminfo) — a ceiling above the
# box's own, under a different cgroup than the box's, for no gain.
if [[ -n "${OMP_MEMORY_MAX:-}" ]] && [[ -e "${AGENTBOX_IDENTITY_FILE:-/etc/agentbox-identity}" ]]; then
    unset OMP_MEMORY_MAX
    echo "omp: in an agent box; this session's memory ceiling is the box's own cgroup." >&2
elif [[ -n "${OMP_MEMORY_MAX:-}" ]] && command -v systemd-run >/dev/null 2>&1; then
    mem_max="$OMP_MEMORY_MAX"
    unset OMP_MEMORY_MAX
    export OMP_MEMORY_SCOPE="$mem_max"
    # Under load the systemd user manager waits on the kernel's cgroup lock and a scope request
    # times out ("Failed to start transient scope unit: Connection timed out"): 5 of 7 tries did
    # between 05:04 and 05:20Z on 2026-11-02, at load 450-520. A session started then would run
    # with no ceiling and no OOMPolicy, so the probe tries once more after 10 s before falling
    # back. A box never reaches here: it took the branch above.
    scope_probe() {
        systemd-run --user --scope -q -p MemoryMax="$mem_max" -p MemorySwapMax=0 -p OOMPolicy=continue -- true \
            >/dev/null 2>&1
    }
    # The scope a background child runs in, once systemd-run has moved it out of this shell's cgroup.
    child_scope() {
        local pid=$1 self cg i
        self=$(sed -n 's/^0:://p' "/proc/$$/cgroup" 2>/dev/null)
        for ((i = 0; i < 25; i++)); do
            cg=$(sed -n 's/^0:://p' "/proc/$pid/cgroup" 2>/dev/null)
            [[ -z $cg ]] && return 0
            [[ $cg != "$self" ]] && { echo "$cg"; return 0; }
            sleep 0.2
        done
    }
    # Whether the kernel's OOM killer fired in a scope: oom, none, or unknown. Its memory.events
    # while the cgroup lasts; after, the unit's journal, where systemd writes "A process of this unit
    # has been killed by the OOM killer". A unit with no journal line at all is unknown, not none.
    # Until 2026-11-22 every exit 137 was called a ceiling kill: at 21:05Z two sessions with peaks of
    # 40.6G and 5.1G were told so after another session wrote cgroup.kill on their scopes.
    scope_oom() {
        local cg=$1 since=$2 n lines try
        [[ -n $cg ]] || { echo unknown; return 0; }
        n=$(awk '$1 == "oom_kill" {print $2}' "/sys/fs/cgroup$cg/memory.events" 2>/dev/null)
        if [[ $n =~ ^[0-9]+$ ]]; then
            if ((n > 0)); then echo oom; else echo none; fi
            return 0
        fi
        for try in 1 2; do
            lines=$(timeout 20 journalctl --user -q --no-pager -o cat -u "${cg##*/}" --since "@$since" 2>/dev/null)
            if [[ $lines == *"killed by the OOM killer"* ]]; then echo oom; return 0; fi
            ((try == 1)) && sleep 2
        done
        if [[ -n $lines ]]; then echo none; else echo unknown; fi
    }
    if scope_probe || { sleep 10 && scope_probe; }; then
        # A non-interactive shell gives a background job /dev/null as stdin unless the job names
        # its own, and interactive omp then refuses to start ("stdin is not a TTY"). So hand the
        # job the wrapper's own stdin through a spare descriptor. With job control off the job
        # stays in this shell's process group, so it still owns the terminal.
        exec 3<&0
        systemd-run --user --scope -q -p MemoryMax="$mem_max" -p MemorySwapMax=0 -p OOMPolicy=continue \
            -- "$DOTFILES_DIR/scripts/agent-session" omp "$@" <&3 3<&- &
        omp_pid=$!
        omp_since=$(date +%s)
        exec 3<&-
        omp_scope=$(child_scope "$omp_pid")
        for sig in INT TERM HUP QUIT; do
            # shellcheck disable=SC2064
            trap "kill -$sig $omp_pid 2>/dev/null" "$sig"
        done
        # `set -e` would end the wrapper on a non-zero `wait`, before it can say why the session
        # died; and a forwarded signal interrupts `wait` with 128+signal while the session is
        # still running, so wait again until the child is really gone.
        omp_status=0
        until wait "$omp_pid"; do
            omp_status=$?
            kill -0 "$omp_pid" 2>/dev/null || break
        done
        if ((omp_status == 137)); then
            case $(scope_oom "$omp_scope" "$omp_since") in
                oom)
                    echo "omp: this session was killed at its $mem_max memory ceiling (OMP_MEMORY_MAX)." >&2
                    echo "omp: resume it with 'omp --resume <session-id>'; raise the ceiling if it was real work." >&2 ;;
                none)
                    echo "omp: this session was killed by SIGKILL, not at its $mem_max memory ceiling: its scope ${omp_scope##*/} recorded no OOM kill, so something else ended it." >&2
                    echo "omp: resume it with 'omp --resume <session-id>'." >&2 ;;
                *)
                    echo "omp: this session was killed by SIGKILL; whether at its $mem_max memory ceiling could not be read (scope ${omp_scope:-unknown})." >&2
                    echo "omp: resume it with 'omp --resume <session-id>'." >&2 ;;
            esac
        fi
        exit "$omp_status"
    fi
    echo "omp: systemd-run refused a $mem_max scope; starting without a memory ceiling" >&2
fi

exec "$DOTFILES_DIR/scripts/agent-session" omp "$@"
