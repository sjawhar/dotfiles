#!/bin/bash
# jj-push-gate: the pre-push hook of a `git push` shims/git directs through this
# gate: a guarded checkout, or a direct push to a public or unreadable GitHub
# URL. jj runs git with --no-verify, so the checkout's own pre-push hook, which
# runs the shared public leak check, never runs for a jj push; a repository's
# own hooks path overrides the global hooks dispatcher. shims/git drops jj's
# flag and points core.hooksPath here (shims/AGENTS.md).
# This makes the call the hook that install-prepush-hook.sh installs makes: the
# encrypted term check first, with the same `$PUBLIC_LEAK_CHECK`, PATH, then
# `${XDG_CONFIG_HOME:-~/.config}/public-leak-check/path` lookup for the shared
# check when GIT_SHIM_PUBLIC_CHECK=1. It runs the term scanner as
# `leak-terms-check push --remote <remote> --url <url>` with git's own update
# lines on stdin. So the URL is the one git is pushing to, and the updates are
# the ones it is about to send: an up-to-date ref is not among them. The public
# check alone still decides where it is enabled, for every target,
# sjawhar/dotfiles included since its scrub (dispatch://INFRA-974). The
# differences:
# - for a jj push, the checkout's own pre-push (pre-push.local included) does
#   not run, as it did not before this gate; for a plain verified push,
#   shims/git names the repository's own hooks directory in
#   GIT_SHIM_OWN_HOOKS, and its pre-push runs after a clean term and public
#   check with the same arguments and stdin, without the shim's -c or that
#   variable, exactly as git would have run it;
# - every line of a refusal starts with `error: `, the only git output jj still
#   shows under --quiet, so the lines naming the commit and the text that
#   matched always reach the person who pushed, and the gate's own last line
#   repeats the check's decisive line rather than pointing at the ones above it
#   (see the reason block below).
# Every other hook name in this directory is a link to ./hook, which runs the hook git would have run without the gate.
set -uo pipefail
own="${GIT_SHIM_OWN_HOOKS-}"
public="${GIT_SHIM_PUBLIC_CHECK:-0}"
unset GIT_SHIM_OWN_HOOKS GIT_SHIM_PUBLIC_CHECK
what="jj push"
[[ -z "$own" ]] || what="push"
refuse() {
    printf 'error: git shim: %s\n' "$@" >&2
    exit 1
}
url="${2:-}"
in="$(cat)" || refuse "cannot read the updates git gave the pre-push hook, so this $what to $url is refused." \
    "Nothing was pushed, and nothing is wrong with your commits: your commits were not read."
scripts="${0%/*}/../../scripts"
sshcmd="$(git config --get core.sshCommand 2> /dev/null)" || sshcmd=""
visibility="$(GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-$sshcmd}" "$scripts/github-repo-visibility" "$url" 2> /dev/null)" || visibility=unknown
case "$visibility" in
    private | internal | not-github) ;;
    *)
        term_rc=0
        term_out="$(
            printf '%s' "$in" | "$scripts/leak-terms-check" push --remote "${1:-}" --url "$url" 2>&1
            statuses=("${PIPESTATUS[@]}")
            ((statuses[0] == 0)) || exit "${statuses[0]}"
            exit "${statuses[1]}"
        )" || term_rc=$?
        if ((term_rc)); then
            while IFS= read -r line; do [[ -z "$line" ]] || printf 'error: %s\n' "$line"; done <<< "$term_out" >&2
            ((term_rc != 3)) || refuse "this push to $url holds a listed leak term. Nothing was pushed."
            refuse "the leak-term check did not pass, so this push to $url is refused. Nothing was pushed."
        fi
        ;;
esac
run_own_hook() {
    [[ -n "$own" && -x "$own/pre-push" ]] || exit 0
    # The shim's entry comes back out of GIT_CONFIG_PARAMETERS, as ./hook takes it out (the last one equal to it).
    mine="${0%/*}"
    mine="${mine//\'/\'\\\'\'}"
    mine=" 'core.hooksPath'='${mine//!/\'\\!\'}' "
    p=" ${GIT_CONFIG_PARAMETERS-} "
    if [[ "$p" == *"$mine"* ]]; then
        before="${p%"$mine"*}"
        p="$before ${p:${#before}+${#mine}}"
        p="${p# }"
        p="${p% }"
        if [[ -n "$p" ]]; then export GIT_CONFIG_PARAMETERS="$p"; else unset GIT_CONFIG_PARAMETERS; fi
    fi
    # git's update lines each end in a newline, the last one included, which $(cat) took off and <<< puts back;
    # no update line at all is empty stdin.
    if [[ -n "$in" ]]; then exec "$own/pre-push" "$@" <<< "$in"; fi
    exec "$own/pre-push" "$@" < /dev/null
}
[[ "$public" == 1 ]] || run_own_hook "$@"
chk="${PUBLIC_LEAK_CHECK:-}"
[[ -n "$chk" ]] || chk="$(command -v public-leak-check.sh 2> /dev/null || true)"
pointer="${XDG_CONFIG_HOME:-$HOME/.config}/public-leak-check/path"
if [[ -z "$chk" && -s "$pointer" ]]; then IFS= read -r chk < "$pointer" || true; fi
[[ -n "$chk" && -x "$chk" ]] || refuse "this machine has no public leak check, so this $what to $url is refused. Nothing was pushed." \
    "Nothing is wrong with your commits: the check never ran. Point at it with PUBLIC_LEAK_CHECK, put public-leak-check.sh on PATH," \
    "or write its path in $pointer, then push again."
crc=0
out="$(bash "$chk" "$@" 2>&1 <<< "$in")" || crc=$?
if ((crc == 0)); then
    [[ -z "$out" ]] || printf '%s\n' "$out" >&2
    run_own_hook "$@"
fi
while IFS= read -r line; do printf 'error: %s\n' "$line"; done <<< "$out" >&2
# The check's own decisive line, lifted into the refusal. Its output can be dozens of advisory
# lines -- one `reviewed row unused in this push` per unused row -- with the line that actually
# decided it first. A reader who takes the end of the output, with `tail` or by reading the
# refusal itself, sees only the advice. On 2026-11-06 that cost six agents about an hour and four
# discarded theories: the first line said `cannot read the visibility of <repo>` because `gh` was
# not on PATH, and the 37 lines after it sent every reader to the allow-list. The refusal is the
# one line every reader sees, so it carries the reason rather than pointing above itself. The
# Python check (leak-check-v7 on) prints its self-test line first, on a refusal too, so a refusal
# read `refused this push to <url>: self-test: 41 of 41 fresh canaries found` (oryx, 2026-11-08).
reason=
while IFS= read -r line; do
    case "$line" in
        *"reviewed row unused"* | "LEAK CHECK: self-test:"*) continue ;;
        "LEAK CHECK: "*) reason="${line#LEAK CHECK: }"; break ;;
    esac
done <<< "$out"
if [[ -n "$reason" ]]; then
    # Not every line of the check ends in a full stop, and this one runs into the sentence after it.
    case "$reason" in *[.!?]) ;; *) reason="$reason." ;; esac
else
    reason="the lines above name the commit and the text that matched, or say why the check could not read the target."
fi
((crc != 3)) || refuse "the public leak check refused this $what to $url: $reason Nothing was pushed."
refuse "the public leak check could not finish (exit $crc), so this $what to $url is refused. Nothing was pushed." \
    "Nothing is wrong with your commits: the check never passed or refused them. The check: $chk"
