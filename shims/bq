#!/bin/bash
# bq wrapper: put BigQuery's CLI on PATH, with the same file-logging protection the gcloud shim
# gives gcloud. The Cloud SDK installs bq beside gcloud in its own bin directory, and that
# directory is on nobody's PATH here, so every caller hard-coded the SDK's full path instead
# (agent-infra's spend loaders, 2026-10-29). A command is called by name; a path is for data.
#
# Resolution: the first bq past this shim's own PATH entry (below), else the SDK's documented
# install location under the home gcloud itself uses. It never execs itself.
#
# bq shares gcloud's config directory and its per-call log files, which gcloud never prunes
# (8,356 files in one day on sami-rocqperf, dispatch://INFRA-6), so file logging is off unless
# the caller set it either way.
set -u

self="$(readlink -f "${BASH_SOURCE[0]}")"
self_dir="$(dirname "$self")"

# The first bq past this shim's own PATH entry, so a pass-through wrapper above the shim is never
# found again (from the top, a stand-in bq first on PATH looped with this shim: agent-infra #849's
# test-copy.sh, 2026-10-29); from the top, skipping this file, when the shim was run by path from
# outside PATH. This is shims/ssh-keygen's lookup.
real=""
past_self=false
IFS=: read -ra path_dirs <<< "${PATH:-}"
for pass in after-self from-top; do
	for d in "${path_dirs[@]}"; do
		[[ -n "$d" ]] || continue
		if [[ "$(readlink -f "$d" 2>/dev/null)" == "$self_dir" ]]; then
			past_self=true
			continue
		fi
		[[ "$pass" == from-top ]] || $past_self || continue
		if [[ -x "$d/bq" && ! -d "$d/bq" && "$(readlink -f "$d/bq")" != "$self" ]]; then
			real="$d/bq"
			break 2
		fi
	done
	$past_self && break
done

if [[ -z "$real" ]]; then
	home="${HOME:-}"
	[[ -n "$home" ]] || home="$(getent passwd "$(id -u)" | cut -d: -f6)"
	candidate="${home}/.gcloud/google-cloud-sdk/bin/bq"
	if [[ -x "$candidate" && "$(readlink -f "$candidate")" != "$self" ]]; then
		real="$candidate"
	fi
fi

if [[ -z "$real" ]]; then
	echo "bq shim: real bq binary not found on PATH or at the default SDK install location" >&2
	exit 127
fi

export CLOUDSDK_CORE_DISABLE_FILE_LOGGING="${CLOUDSDK_CORE_DISABLE_FILE_LOGGING:-1}"
exec "$real" "$@"
