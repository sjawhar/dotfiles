    (
        unset GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_COMMON_DIR GIT_NAMESPACE
        cd "$1" && GIT_DIR="$1/.git" GIT_WORK_TREE="$1" "$_real" "${@:2}"
    )
}
git_would_remove() {
    local tree="$1" given="$2" gd gitlinks path status populated=0
    [[ -e "$tree" ]] || return 0 # git checks only a tree that is still there
    gd="$(tree_git "$tree" rev-parse --absolute-git-dir 2> /dev/null)" || return 1
    if [[ -d "$gd/modules" ]]; then populated=1; fi
    # Read to EOF, as the lookup below does; a failed listing means "cannot tell".
    gitlinks="$(tree_git "$tree" -c core.quotePath=false ls-files --stage | awk '$1 == "160000"')" || return 1
    while IFS= read -r path; do
        [[ -n "$path" ]] || continue
        path="${path#*$'\t'}"
        if [[ "$path" == \"* ]]; then return 1; fi # a name git had to quote: cannot tell
        if [[ -e "$tree/$path/.git" ]]; then populated=1; fi
    done <<< "$gitlinks"
    if ((populated)); then
        echo "fatal: working trees containing submodules cannot be moved or removed" >&2
        exit 128
    fi
    status="$(tree_git "$tree" status --porcelain --ignore-submodules=none)" || return 1
    if [[ -n "$status" ]]; then
        echo "fatal: '$given' contains modified or untracked files, use --force to delete it" >&2
        exit 128
    fi
}

# Succeeds when the repository's common directory (its store of worktree registrations) lies
# under a temporary root of this session, where no other session or box can register a
# worktree: a throwaway repository a test made with mkdtemp. Both sides are resolved through
# symlinks (git 2.43 already prints the common directory resolved; realpath keeps that true
# for a git that does not) and compared by whole path components, so /tmpfoo is not under
# /tmp. A root that resolves to / would allow everything and is skipped.
prune_common=""
prune_is_safe() {
    local root user
    prune_common="$("$_real" "${args[@]:0:i}" rev-parse --path-format=absolute --git-common-dir 2> /dev/null)" || return 1
    prune_common="$(realpath -e -- "$prune_common" 2> /dev/null)" || return 1
    user="$(id -un)"
    for root in ${TMPDIR:+"$TMPDIR"} /tmp /var/tmp "/mnt/nvme/$user/session-tmp" "/mnt/nvme/$user/tmp-omp-batch" /mnt/nvme/tmp-omp-batch; do
        root="$(realpath -e -- "$root" 2> /dev/null)" || continue
        [[ "$root" != / && "$prune_common" == "$root"/* ]] && return 0
    done
    return 1
}

case "$verb" in
    prune)
        for a in "${rest[@]}"; do
            [[ "$a" == -n || "$a" == --dry-run ]] && exec "$_real" "$@"
        done
        prune_is_safe && exec "$_real" "$@"
        cat >&2 << EOF
git shim: \`git worktree prune\` is refused in an agent session (AGENTC-431).
This repository keeps its worktree registrations in ${prune_common:-a store git did not name},
which other sessions and agent boxes can share. From inside a box every other box's
worktree looks missing, so a prune deletes live sessions' registrations; it did so 17 times
on 2026-09-26.
A prune runs only where no other session can have a worktree: a repository whose store lies
under a temporary root (\$TMPDIR, /tmp, /var/tmp, /mnt/nvme/<user>/session-tmp,
/mnt/nvme/<user>/tmp-omp-batch, /mnt/nvme/tmp-omp-batch), such as one a test made with mkdtemp.
Remove your own worktree with \`git worktree remove <path>\` or \`jj workspace forget <name>\`;
\`git worktree prune -n\` shows what a prune would delete without deleting it.
EOF
        exit 1
        ;;
    add)
        for a in "${rest[@]}"; do
            [[ "$a" == --lock ]] && exec "$_real" "$@"
        done
        exec "$_real" "${args[@]:0:i+2}" --lock --reason "$LOCK_REASON" "${rest[@]}"
        ;;
    remove)
        # A tree carrying an agent add-lock (this shim's, or shims/jj's, exactly) is removed with
        # the lock on: two --force is git's own way past a lock, and git then deletes the lock
        # with the registration, while every refusal leaves it where it was. Taking the lock off
        # first, as this shim used to, left the tree unlocked whenever git refused, as it does
        # for uncommitted work. Any other lock stands.
        #
        # The worktree is the last non-option argument; options end at `--`. The --force count
        # is git's: one skips git's clean check, two its lock check too, `--no-force` starts
        # again. A count this misses only adds a check.
        force=0 target="" opts=1
        for a in "${rest[@]}"; do
            if ((opts)); then
                case "$a" in
                    --) opts=0; continue ;;
                    --force) force=$((force + 1)); continue ;;
                    --no-force) force=0; continue ;;
                    -*) [[ "$a" =~ ^-f+$ ]] && force=$((force + ${#a} - 1)); continue ;;
                esac
            fi
            target="$a"
        done
        ((force < 2)) && [[ -n "$target" ]] || exec "$_real" "$@"

        # Which registration git will remove, found as git's find_worktree finds it: first a
        # trailing part of a registered path, at a directory boundary, that names one tree only
        # (`remove wt`, `remove nest/wt`); else the path read from where every `-C` leaves git,
        # in order (an empty one changes nothing), compared with each registered path after
        # both are resolved. Read from the shim's own directory instead, a tree named by its
        # name or from another directory carried a lock the shim never saw.
        #
        # The listing is read whole, into a variable. A reader that stops early (an awk `exit`
        # on its first match, as an earlier version had) closes the pipe while git is still
        # writing; once the porcelain outgrows the pipe (121 worktrees give 19 KB, and this
        # box's pipes drop to 8 KiB past pipe-user-pages-soft) git dies of SIGPIPE and
        # `set -o pipefail` kills the shim before git runs. That was observed once on the shared
        # legion store (2026-09-30), and left a half-registered worktree.
        #
        # The `|| true` is the guard that matters: this lookup only DECIDES whether to let git
        # past the lock, so any failure of it (a git that cannot read the store, a locked
        # `packed-refs`, a cause nobody found) must degrade to "leave the lock alone" and let the
        # real git run, never to a shim that exits before the user's own command runs.
        listing="$("$_real" "${args[@]:0:i}" worktree list --porcelain || true)"
        paths=() locks=()
        while IFS= read -r line; do
            case "$line" in
                "worktree "*) paths+=("${line#worktree }"); locks+=("") ;;
                locked*) if ((${#locks[@]})); then locks[-1]="$line"; fi ;;
            esac
        done <<< "$listing"
        found="" matches=0
        for k in "${!paths[@]}"; do
            if [[ "${paths[k]}" == "$target" || "${paths[k]}" == */"$target" ]]; then
                found="$k" matches=$((matches + 1))
            fi
        done
        if ((matches != 1)); then
            found="" base="$PWD"
            for ((k = 0; k < i; k++)); do
                case "${args[k]}" in
                    -C)
                        d="${args[k + 1]:-}"
                        if [[ "$d" == /* ]]; then base="$d"; elif [[ -n "$d" ]]; then base="$base/$d"; fi
                        k=$((k + 1))
                        ;;
                    -c | --git-dir | --work-tree | --namespace | --config-env | --exec-path) k=$((k + 1)) ;;
                esac
            done
            want="$target"
            [[ "$want" == /* ]] || want="$base/$want"
            real=()
            if ((${#paths[@]})); then mapfile -t real < <(realpath -m -- "$want" "${paths[@]}" || true); fi
            for k in "${!paths[@]}"; do
                if [[ -n "${real[0]:-}" && "${real[k + 1]:-}" == "${real[0]}" ]]; then
                    found="$k"
                    break
                fi
            done
        fi
        [[ -n "$found" ]] || exec "$_real" "$@"
        lock="${locks[found]}"
        [[ "$lock" == "locked $LOCK_REASON" || "$lock" == "locked $JJ_LOCK_REASON" ]] || exec "$_real" "$@"
        ((force > 0)) || git_would_remove "${paths[found]}" "$target" || exec "$_real" "$@"
        exec "$_real" "${args[@]:0:i+2}" --force --force "${rest[@]}"
        ;;
esac
exec "$_real" "$@"
