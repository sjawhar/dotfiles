# parse_long_opt of parse-options.c at git v2.43.0: an exact name (or `no-` and an exact
# name, or a `no-` name without its `no-`) wins, else the one unique abbreviation of a name
# or of its negation. Sets PUSH_OPTION, PUSH_KIND, PUSH_UNSET, PUSH_ATTACHED and
# PUSH_VALUE; returns 1 for an unknown option and 2 for an ambiguous one.
push_long_parse() {
    local arg=$1 name_part entry long kind noneg name rest state unset opt_unset
    local abbrev="" abbrev_kind="" abbrev_unset=0 ambiguous=0
    name_part="${arg%%=*}"
    PUSH_OPTION="" PUSH_KIND="" PUSH_UNSET=0 PUSH_ATTACHED=0 PUSH_VALUE=""
    for entry in "${PUSH_LONG_OPTIONS[@]}"; do
        IFS=: read -r long kind noneg <<< "$entry"
        name=$long unset=0 opt_unset=0 rest="" state=skip
        while :; do
            if [[ "$arg" == "$name"* ]]; then
                rest="${arg:${#name}}" state=exact
                break
            fi
            if [[ "$name" == "$name_part"* ]]; then
                state=abbrev
                break
            fi
            [[ "$noneg" != N ]] || break
            if [[ "no-" == "$arg"* ]]; then
                unset=1 state=abbrev
                break
            fi
            if [[ "$arg" != no-* ]]; then
                if [[ "$name" == no-* ]]; then
                    name="${name#no-}" opt_unset=1
                    continue
                fi
                break
            fi
            unset=1
            if [[ "${arg:3}" == "$name"* ]]; then
                rest="${arg:3+${#name}}" state=exact
            elif [[ "$name" == "${arg:3}"* ]]; then
                state=abbrev
            fi
            break
        done
        case "$state" in
            skip) continue ;;
            abbrev)
