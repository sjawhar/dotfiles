#!/bin/bash
# git-worktree-shim: in an agent session, refuse a bare `git worktree prune` outside a
# throwaway repository, lock every `git worktree add`, let `git worktree remove` past a
# lock of ours and no further, give every `git commit` without a command-line hooks path
# the leak-term hooks, give every commit an omp session makes its Omp-Session trailer where
# it does now, run the shared public leak check on every `git push` jj runs where the pre-push
# hook would and on every plain `git push` whose hooks directory holds neither the leak check's
# wrapper nor its dispatcher, and keep a pruning `git fetch` from deleting the destination
# of a short-named refspec.
# From inside an agent box every other box's worktree path looks missing, so a
# prune there deletes live sessions' registrations in the shared store
# (AGENTC-431: 17 bare prunes on 2026-09-26, from five boxes). A locked
# registration survives a prune. Everything else goes straight to the real git.
set -euo pipefail

LOCK_REASON="agent session: locked on add (AGENTC-431)"
# The lock shims/jj puts on a workspace's git worktree when this shim did not lock it
# already (a `jj workspace add` outside an agent session). Ours as well.
JJ_LOCK_REASON="jj shim: locked on add (AGENTC-431)"

# The first git on PATH past this shim, judged by content like shims/gh. Entries
# before the shim's own (`-ef`: its directory however PATH spells it) already had
# their turn: a wrapper there that hands off positionally (knives gh's jj-bookmark
# wrapper) would otherwise be chosen again and the two exec each other forever.
# A PATH that does not carry this shim is scanned whole, then the system dirs.
real_git() {
    local IFS=':'
    local dir candidate header seen_self=0 first_above=""
    for dir in $PATH; do
        candidate="$dir/git"
        [[ -f "$candidate" && -x "$candidate" ]] || continue
        if [[ "$candidate" -ef "$0" ]]; then
            seen_self=1
            continue
        fi
        header=""
        IFS= read -r -n 512 -d '' header < "$candidate" || true
        [[ "$header" == *git-worktree-shim* ]] && continue
        if [[ "$seen_self" == 1 ]]; then
            echo "$candidate"
            return
        fi
        [[ -n "$first_above" ]] || first_above="$candidate"
    done
    if [[ "$seen_self" == 0 && -n "$first_above" ]]; then
        echo "$first_above"
        return
    fi
    # A caller that builds its own PATH may leave the real binary off it.
    for candidate in /usr/bin/git /usr/local/bin/git /bin/git; do
        [[ -f "$candidate" && -x "$candidate" ]] || continue
        header=""
        IFS= read -r -n 512 -d '' header < "$candidate" || true
        [[ "$header" == *git-worktree-shim* ]] && continue
        echo "$candidate"
        return
    done
    return 1
}
if ! _real="$(real_git)"; then
    echo "git shim: no real git found on PATH" >&2
    exit 127
fi
# The shim's own tools (cat, awk, realpath, mktemp) must exist even when the
# caller's PATH omits the system dirs; appending keeps the caller's dirs first.
PATH="$PATH:/usr/bin:/bin"

# Same test as shims/gh: an omp session, an agentbox session, or anything
# launched with the gh-app routing include.
agent_context() {
    [[ -n "${OMP_SESSION_ID:-}${PI_SESSION_FILE:-}${PI_TOOL_BRIDGE_URL:-}${AGENTBOX_SESSION:-}${CLAUDECODE:-}${ENVOY_SESSION_ID:-}${AGENT_SHIM_AGENT:-}${LEGION_ROLE:-}${LEGION_TREE:-}${LEGION_CONTROLLER:-}${LEGION_DAEMON_URL:-}" ]] && return 0
    local i v
    for ((i = 0; i < ${GIT_CONFIG_COUNT:-0}; i++)); do
        v="GIT_CONFIG_VALUE_$i"
        [[ "${!v:-}" == *gh-app-routes.gitconfig ]] && return 0
    done
    # There is no exception for tmux. A pane takes the SERVER's environment, not the environment
    # of whoever asked for the pane, so "inside tmux means the person" let an agent's own
    # `tmux new-window` under the person's server produce a pane with no marker that then ran as
    # the person (round 3 of INFRA-1538). The fix is the other way round: shims/tmux and
    # scripts/agentbox-tmux-guard pass the caller's markers to the new pane with tmux's -e, so an
    # agent's pane carries them and is caught above.
    # A command that arrives over SSH in a session with no terminal (`ssh host az account show`)
    # is an agent's, not a person's: sshd gives a person's own session a terminal and names it in
    # SSH_TTY for the whole session, so a pipe into one command of it (`echo x | az …`, git
    # handing its credential helper the request) is still the person's, where testing this
    # command's own stdin made it an agent's. AGENT_SHIM_PERSON=1 is the person's escape for a
    # deliberate non-interactive SSH command of their own (INFRA-1538).
    if [[ -n "${SSH_CONNECTION:-}" && -z "${SSH_TTY:-}" && "${AGENT_SHIM_PERSON:-}" != 1 ]]; then
        AGENT_CONTEXT_VIA_SSH=1
        return 0
    fi
    return 1
}
# Locate the subcommand past git's global options before distinguishing an agent from a person:
# every caller's ordinary `git commit` uses the leak-term hooks.
args=("$@")
i=0
while ((i < ${#args[@]})); do
    case "${args[i]}" in
        -C | -c | --git-dir | --work-tree | --namespace | --config-env | --exec-path) i=$((i + 2)) ;;
        -*) i=$((i + 1)) ;;
        *) break ;;
    esac
done

# Keep the existing case-insensitive command-line override test: a caller who selects a hooks
# path owns that command, and the scanner does not run.
caller_hooks_path=0
shopt -s nocasematch
[[ " ${args[*]:0:i} " == *core.hookspath=* ]] && caller_hooks_path=1
shopt -u nocasematch

commit_scan_state() {
    local cleanup=default verbose=config status=config option canonical value short character j index
    local -a long_options=(
        all interactive patch include only quiet verbose no-verbose amend no-post-rewrite post-rewrite dry-run
        short branch ahead-behind porcelain long null allow-empty allow-empty-message no-verify verify author date
        cleanup status no-status reset-author file message reuse-message reedit-message template fixup squash trailer
        gpg-sign no-gpg-sign signoff no-signoff edit no-edit untracked-files pathspec-from-file pathspec-file-nul
    )

    index=$((i + 1))
    while ((index < ${#args[@]})); do
        option="${args[index]}"
        if [[ "$option" == -- ]]; then
            break
        fi
        if [[ "$option" == --* ]]; then
            value="${option#--}"
            value="${value%%=*}"
            canonical=""
            for character in "${long_options[@]}"; do
                if [[ "$character" == "$value" ]]; then
                    canonical="$character"
                    break
                fi
                if [[ "$character" == "$value"* ]]; then
                    if [[ -n "$canonical" ]]; then
                        printf 'cleanup=unknown verbose=unknown status=unknown'
                        return
                    fi
                    canonical="$character"
                fi
            done
            if [[ -z "$canonical" ]]; then
                printf 'cleanup=unknown verbose=unknown status=unknown'
                return
            fi
            case "$canonical" in
                cleanup)
                    if [[ "$option" == *=* ]]; then
                        value="${option#*=}"
                    elif ((index + 1 < ${#args[@]})); then
                        index=$((index + 1))
                        value="${args[index]}"
                    else
                        printf 'cleanup=unknown verbose=unknown status=unknown'
                        return
                    fi
                    case "$value" in
                        verbatim | whitespace | strip | scissors) cleanup="$value" ;;
                        *) printf 'cleanup=unknown verbose=unknown status=unknown'; return ;;
                    esac
                    ;;
                verbose)
                    [[ "$option" == *=* ]] && { printf 'cleanup=unknown verbose=unknown status=unknown'; return; }
                    if [[ "$verbose" == config ]]; then verbose=1; else verbose=$((verbose + 1)); fi
                    ;;
                no-verbose) [[ "$option" == *=* ]] && { printf 'cleanup=unknown verbose=unknown status=unknown'; return; }; verbose=0 ;;
                status) [[ "$option" == *=* ]] && { printf 'cleanup=unknown verbose=unknown status=unknown'; return; }; status=1 ;;
                no-status) [[ "$option" == *=* ]] && { printf 'cleanup=unknown verbose=unknown status=unknown'; return; }; status=0 ;;
                message | file | reuse-message | reedit-message | template | author | date | fixup | squash | trailer | pathspec-from-file)
                    if [[ "$option" != *=* ]]; then
                        ((index + 1 < ${#args[@]})) || { printf 'cleanup=unknown verbose=unknown status=unknown'; return; }
                        index=$((index + 1))
                    fi
                    ;;
                gpg-sign | untracked-files)
                    ;;
                *)
                    if [[ "$option" == *=* ]]; then
                        printf 'cleanup=unknown verbose=unknown status=unknown'
                        return
                    fi
                    ;;
            esac
        elif [[ "$option" == -?* ]]; then
            short="${option#-}"
            j=0
            while ((j < ${#short})); do
                character="${short:j:1}"
                case "$character" in
                    v)
                        if [[ "$verbose" == config ]]; then verbose=1; else verbose=$((verbose + 1)); fi
                        ;;
                    a | i | n | p | o | q | e | s | z) ;;
                    m | F | c | C | t)
                        if ((j + 1 < ${#short})); then
                            j=${#short}
                            continue
                        fi
                        ((index + 1 < ${#args[@]})) || { printf 'cleanup=unknown verbose=unknown status=unknown'; return; }
                        index=$((index + 1))
                        ;;
                    S | u)
                        j=${#short}
                        continue
                        ;;
                    *) printf 'cleanup=unknown verbose=unknown status=unknown'; return ;;
                esac
                j=$((j + 1))
            done
        fi
        index=$((index + 1))
    done
    printf 'cleanup=%s verbose=%s status=%s' "$cleanup" "$verbose" "$status"
}

scan_commit=0
unset DOTFILES_GIT_COMMIT_SCAN
if [[ "${args[i]:-}" == commit && $caller_hooks_path -eq 0 ]]; then
    scan_commit=1
    DOTFILES_GIT_COMMIT_SCAN="$(commit_scan_state)"
    export DOTFILES_GIT_COMMIT_SCAN
fi

is_agent=0
if agent_context; then
    is_agent=1
fi
if ((scan_commit)); then
    hook_dir="$(cd -P -- "${BASH_SOURCE[0]%/*}" && pwd)/git-hooks"
    if ((is_agent)) && [[ "${OMP_SESSION_ID:-}" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] &&
        "${BASH_SOURCE[0]%/*}/../scripts/omp-session-trailer" "$_real" "${args[@]:0:i}" > /dev/null 2>&1; then
        exec "$_real" "${args[@]:0:i}" -c trailer.Omp-Session.ifexists=addIfDifferent -c "core.hooksPath=$hook_dir" \
            commit --trailer "Omp-Session: $OMP_SESSION_ID" "${args[@]:i+1}"
    fi
    exec "$_real" "${args[@]:0:i}" -c "core.hooksPath=$hook_dir" "${args[@]:i}"
fi

((is_agent)) || exec "$_real" "$@"
# Say so when the SSH rule, and not a session marker, made this an agent's call: the agent-session
# rules below (the worktree lock, the prune refusal, the session trailer) are otherwise silent
# about why, and a person whose own non-interactive ssh command this is needs the escape named.
if [[ -n "${AGENT_CONTEXT_VIA_SSH:-}" ]]; then
    echo "git shim: non-interactive SSH, so an agent's call, under the agent-session rules (set AGENT_SHIM_PERSON=1 for your own)" >&2
fi

# A commit made from an omp session carries `Omp-Session: <id>`, the trailer
# session attribution reads; omp/extensions/session-env.ts exports the id, and
# jj commits get the same trailer from its JJ_CONFIG overlay. A missing or
# malformed id adds nothing: attribution may be absent, never wrong.
# scripts/omp-session-trailer says yes everywhere unless the checkout sets
# `git config omp.sessionTrailer false`, or the repository is a throwaway one (no
# remote, and its common directory under a temporary root, such as a test's mkdtemp).
# - `git commit`: git's own --trailer adds it, so the repository's hooks and
#   commit signing run exactly as they would without it, and
#   `ifexists=addIfDifferent` keeps an amend from repeating it.
# - `git merge`, `pull`, `cherry-pick`, `revert` take no --trailer, so they run
#   with `core.hooksPath` at shims/git-hooks/, whose prepare-commit-msg adds the
#   same line; then every hook name there runs the hook git would have run
#   without that override (git-hooks/hook). A rebase (`pull --rebase`) keeps each
#   replayed commit's message as it was. A caller's own `-c core.hooksPath`
#   stands, and that command gets no trailer.
# A commit made through an alias, `git rebase`, `git am` or `git commit-tree`
# carries none.
session_re='^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
case "${args[i]:-}" in
    commit | merge | pull | cherry-pick | revert)
        if [[ "${OMP_SESSION_ID:-}" =~ $session_re ]] &&
            "${BASH_SOURCE[0]%/*}/../scripts/omp-session-trailer" "$_real" "${args[@]:0:i}" > /dev/null 2>&1; then
            if [[ "${args[i]}" == commit ]]; then
                exec "$_real" "${args[@]:0:i}" -c trailer.Omp-Session.ifexists=addIfDifferent commit --trailer "Omp-Session: $OMP_SESSION_ID" "${args[@]:i+1}"
            fi
            [[ $caller_hooks_path -eq 1 ]] || exec "$_real" "${args[@]:0:i}" -c "core.hooksPath=$(cd -P -- "${BASH_SOURCE[0]%/*}" && pwd)/git-hooks" "${args[@]:i}"
        fi
        ;;
esac
# A fetch with pruning on (`fetch.prune`, set in this repo's .gitconfig, or --prune)
# deletes the destination of a command-line refspec whose source is not a full ref
# name, such as `git fetch origin b:refs/remotes/origin/b`, instead of updating it,
# whenever that destination already exists, and exits 0: every second run leaves it
# missing (git 2.43.0, 2026-11-02; `+b:…`, tags, `HEAD:…` and a refs/heads/
# destination too). Prune never deletes anything else for refspecs without a `*`:
# a source the remote lacks fails the fetch first. So when every command-line
# refspec is such a one and one of them has that form, the fetch runs with a last
# --no-prune, and no refspec changes. A glob or negative refspec beside it, refspecs
# on stdin (--stdin) or `--multiple` leave the fetch as it was, as does a fetch from
# a URL with fetch.pruneTags, whose tag pruning --no-prune would also stop.
if [[ "${args[i]:-}" == fetch ]]; then
    fetch_fix=0 positional=0 opts=1 end=${#args[@]}
    for ((k = i + 1; k < ${#args[@]}; k++)); do
        a="${args[k]}"
        if ((opts)); then
            case "$a" in
                --) opts=0 end=$k; continue ;;
                --multiple | --stdin) exec "$_real" "$@" ;;
                --upload-pack | -j | --jobs | --depth | --shallow-since | --shallow-exclude | --deepen | --refmap | \
                    -o | --server-option | --negotiation-tip | --filter | --recurse-submodules-default | --submodule-prefix)
                    k=$((k + 1)); continue ;;
                -?*) continue ;;
            esac
        fi
        positional=$((positional + 1))
        if ((positional == 1)); then
            remote="$a"
            continue
        fi
        [[ "$a" != *'*'* && "$a" != ^* ]] || exec "$_real" "$@"
        src="${a%%:*}" src="${src#+}"
        [[ "$a" == *:?* && "$src" != refs/* ]] && fetch_fix=1
    done
    if ((fetch_fix)) && [[ "$remote" == *[:/]* ]]; then
        "$_real" "${args[@]:0:i}" config --get --type=bool fetch.pruneTags 2> /dev/null | grep -qx true && exec "$_real" "$@"
    fi
    ((fetch_fix)) || exec "$_real" "$@"
    exec "$_real" "${args[@]:0:end}" --no-prune "${args[@]:end}"
fi

# Only `worktree` and `push` read on: the push gate below sits past this exec,
# so every other command runs without bash parsing it.
[[ "${args[i]:-}" == worktree || "${args[i]:-}" == push ]] || exec "$_real" "$@"

# jj publishes through git and turns git's hooks off: `jj git push` runs, once per
# remote, `git -c core.fsmonitor=false -c submodule.recurse=false --git-dir <dir>
# push --porcelain --no-verify --force-with-lease=<ref>:<old>… -- <remote>
# <sha>:<ref>…` (jj 0.46, measured 2026-11-01). So the pre-push hook through which
# a git checkout runs the shared public leak check never runs for a jj push, and
# theorem-labs/rocq alone has fourteen jj checkouts here (dispatch://BET-214/ask/19a77b7a;
# Sami, dispatch://BET-214/ask/3f2020ba: "Some reasonable check makes sense").
# So when jj is the caller in a checkout that hook guards, this gives the push its
# pre-push hook back: it drops jj's --no-verify and points core.hooksPath at
# jj-push-hooks/, whose pre-push makes the hook's call to the same check. git
# itself hands that hook the URL it is pushing to and the updates it is about to
# send, so nothing about the push is guessed here: an up-to-date ref is not
# scanned, a bookmark moved meanwhile does not change what goes out, and a remote
# changed meanwhile does not change where it goes. jj has resolved every way of
# naming what to push (--bookmark, --named, -r, --change, --all, --tag, aliases,
# git.push, global options) before it runs git.
# - Guarded is the rule of dispatch://BET-706, which the hook sweep (sweep-hooks.sh, beside the shared check) also
#   installs the hook by: a checkout is guarded when any URL its `git remote -v` prints is GUARD by
#   ../scripts/github-repo-visibility: a GitHub repository (github.com, www.github.com or ssh.github.com, directly or through an ssh
#   alias, after a leading `<transport>::` or `git+`) that is public or whose visibility cannot be read (the leak
#   check's fresh cache entry, then gh), or a URL whose host part cannot be parsed. A private or internal repository,
#   a local path and another host are not. A line is read as git prints it, the URL whole after the tab: on a push
#   line, without its final ` (push)`; on a fetch line, up to its first ` (fetch)`, since a partial clone's filter,
#   whose text may hold anything, follows it (`<url> (fetch) [sparse:oid=HEAD:a [b]]`). So a space in a path or a # or ? in an ssh
#   alias changes nothing. When git would run an ssh command of its own (the
#   checkout's core.sshCommand, or GIT_SSH_COMMAND or GIT_SSH), an ssh alias is unknown, since that command may
#   resolve it otherwise than ssh -G. The sweep has its own reader of the same rule, in another repository
#   (tests/test_jj_push_leak_gate.py runs both on the same checkouts).
# - Unknown counts as public (spec R4): every failure to read a visibility, a cache that cannot be reached, an entry
#   that is empty or holds another word, gh that fails or does not answer in 5 s, a helper that cannot run, guards the
#   checkout. The check then decides, and refuses a push to a theorem-labs repository whose visibility it cannot read
#   either, so that still fails closed against a leak while a clean push goes out.
# A plain `git push` runs the pre-push hook of git's effective hooks directory: core.hooksPath where it is set, else
# the repository's common hooks directory. The leak check reaches it there in two ways only: the leak-check wrapper
# that install-prepush-hook.sh and the sweep install (marker PUBLIC-LEAK-CHECK-WRAPPER), or the global hooks
# dispatcher (~/.local/share/public-leak-check-hooks/global, dispatch://BET-706 R6), whose `dispatch` carries
# PUBLIC-LEAK-CHECK-DISPATCHER. Neither reaches a fresh clone on a machine or in an agent box without the dispatcher
# (a box made before 2026-11-05 has its ~/.gitconfig bound to a deleted file, so it never saw the include, and has no
# hooks directory), nor a repository whose own core.hooksPath (local or worktree, an empty value included, which git
# 2.43 reads as `/`: husky, the pre-commit framework) overrides the dispatcher. So for every plain push from a guarded
# checkout, with no --no-verify, whose effective hooks directory has no executable pre-push that is the wrapper or
# the dispatcher's entry (git ignores a hook that is not executable), the shim adds a last -c
# core.hooksPath=jj-push-hooks/ as for jj, and names that directory in GIT_SHIM_OWN_HOOKS: the gate's pre-push runs
# the check, then that directory's pre-push with the same arguments and stdin; every other hook is the one git would
# have run. Where the wrapper or the dispatcher is effective the shim adds nothing, so a push is checked once. Not
# seen, as `git push --no-verify` is not: a hooks path set on the command line or in the environment (the caller's
# own choice), a jj told to run another git (`git.executable-path`) or copied under another name, and a remote
# changed between this decision and git reading its config.
from_jj() { # true when the process that ran this git is jj, also a jj binary replaced since it started
    local exe
    exe="$(readlink "/proc/$PPID/exe" 2> /dev/null)" || return 1
    exe="${exe% (deleted)}"
    [[ "${exe##*/}" == jj ]]
}
jj_push_refuse() {
    printf 'error: git shim: %s\n' "$@" >&2
    exit 1
}
JJ_PUSH_UNREAD="Nothing was pushed, and nothing is wrong with your commits: your commits were not read."
# The visibility helper, as shims/jj finds it: scripts/ beside this shims dir.
jj_gate_visibility="${BASH_SOURCE[0]%/*}/../scripts/github-repo-visibility"
# jj_push_guarded LISTING: true when the checkout whose `git remote -v` is LISTING is guarded (above): some URL in it
# is GUARD. Each URL is read once, and the first GUARD one decides. The checkout's core.sshCommand goes to the helper
# as GIT_SSH_COMMAND, which git itself puts ahead of it. A helper that exits other than 0 is unknown, whatever it
# printed. A remote whose config has no url is listed with a blank URL (`<name><TAB>` and nothing else); git pushes to
# its name as the URL, after url.<base>.insteadOf and pushInsteadOf rewrite it, so such a remote's URLs are those
# `git remote get-url --push --all <name>` and `git remote get-url --all <name>` print, read with the same global
# options as `git remote -v`, and a failure of either is unknown (dispatch://BET-706: seven partial clones of
# `[remote "https://github.com/theorem-labs/rocq.git"]`; the sweep reads them by the same rule).
jj_push_guarded() {
    local line url name push fetch sshcmd v
    local -a urls
    local -A checked=() named=()
    sshcmd="$("$_real" "${args[@]:0:i}" config --get core.sshCommand 2> /dev/null)" || sshcmd=""
    while IFS= read -r line; do
        [[ "$line" == *$'\t'* ]] || continue
        # A line with no tab is no remote's: the rest of a filter holding a newline. A push line's URL ends at its final
        # ` (push)`. A fetch line's ends at its first ` (fetch)`: git prints a partial clone's filter after that
        # annotation (`<url> (fetch) [blob:none]`), and the filter may hold ` [`, `]` or ` (fetch)` itself. The sweep
        # reads the lines by the same rule.
        url="${line#*$'\t'}"
        if [[ "$url" == *" (push)" ]]; then url="${url% (push)}"; else url="${url%% (fetch)*}"; fi
        if [[ -n "$url" ]]; then
            urls=("$url")
        else
            name="${line%%$'\t'*}"
            [[ -z "${named[$name]:-}" ]] || continue
            named[$name]=1
            push="$("$_real" "${args[@]:0:i}" remote get-url --push --all -- "$name" 2> /dev/null)" || return 0
            fetch="$("$_real" "${args[@]:0:i}" remote get-url --all -- "$name" 2> /dev/null)" || return 0
            mapfile -t urls <<< "$push"$'\n'"$fetch"
        fi
        for url in "${urls[@]}"; do
            [[ -n "$url" && -z "${checked[$url]:-}" ]] || continue
            checked[$url]=1
            v="$(GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-$sshcmd}" "$jj_gate_visibility" "$url" 2> /dev/null)" || v=unknown
            case "$v" in
                private | internal | not-github) ;;
                *) return 0 ;;
            esac
        done
    done <<< "$1"
    return 1
}
# jj_push_gate: in a guarded checkout, runs this push with git's hooks on and a last -c core.hooksPath=jj-push-hooks/,
# which beats jj's own core.hooksPath and every earlier one, so the gate's pre-push runs; jj-push-hooks/hook, which
# every other hook name there links to, takes that one -c back out and runs the hook git would have run without it.
# When git's stderr carries git's own "failed to push some refs", jj 0.46 reads only git's stdout, which is empty
# when a pre-push hook refused, and drops the stderr: the person sees "Git push output unfamiliar" and nothing else
# (measured 2026-11-02). git prints that line for a destination right after that destination's pre-push hook
# refused, so the one that belongs to the gate's refusal is the one right after its `error: git shim: ` lines; that
# line alone is left out, and jj then reports git's stderr, the check's lines naming the commit and the text that
# matched included, under --quiet too. Another destination's failure keeps its line: jj then reports that failure
# from git's porcelain and drops the stderr, the gate's refusal with it. The push is refused either way: git exits 1.
jj_push_gate() {
    local out hooks a seen=0
    local -a rest=()
    out="$("$_real" "${args[@]:0:i}" remote -v 2> /dev/null)" ||
        jj_push_refuse "cannot list this repository's remotes, so whether this jj push needs the public leak check is unknown and it is refused." \
            "$JJ_PUSH_UNREAD"
    jj_push_guarded "$out" || return 0
    hooks="$(cd -P -- "${BASH_SOURCE[0]%/*}" && pwd)/jj-push-hooks"
    [[ -x "$hooks/pre-push" ]] ||
        jj_push_refuse "the leak gate's hook $hooks/pre-push is missing, so this jj push from a checkout of a public or unreadable GitHub repository is refused." \
            "$JJ_PUSH_UNREAD"
    for a in "${args[@]:i+1}"; do
        if ((!seen)); then
            [[ "$a" == -- ]] && seen=1
            [[ "$a" == --no-verify ]] && continue
        fi
        rest+=("$a")
    done
    exec "$_real" "${args[@]:0:i}" -c "core.hooksPath=$hooks" push --verify "${rest[@]}" \
        2> >(awk '/^error: git shim: /{ gate = 1; print; fflush(); next }
                  gate && /^error: failed to push some refs to /{ gate = 0; next }
                  { gate = 0; print; fflush() }' >&2)
}
# plain_push_gate: a plain `git push` whose effective hooks directory runs no leak check (above), else returns.
plain_push_gate() {
    local a verify=1 out scope own base hooks
    for a in "${args[@]:i+1}"; do
        case "$a" in
            --) break ;;
            --no-verify) verify=0 ;;
            --verify) verify=1 ;;
        esac
    done
    ((verify)) || return 0
    # git's effective hooks directory. core.hooksPath and where it is set: from the command line or the environment it
    # is the caller's choice and left alone. An empty value still overrides every other one, and git 2.43 then looks
    # for each hook at /<name> (`git rev-parse --git-path hooks/pre-push` prints /pre-push), so its directory is /.
    # Unset, git uses the common hooks directory (a worktree's included).
    if out="$("$_real" "${args[@]:0:i}" config --show-scope --type=path --get core.hooksPath 2> /dev/null)"; then
        scope="${out%%$'\t'*}" own="${out#*$'\t'}"
        [[ "$scope" != command ]] || return 0
        [[ -n "$own" ]] || own=/
        # git runs a hook from the top of the work tree (from the git directory in a bare repository), and takes a
        # relative hooks path from there.
        if [[ "$own" != /* ]]; then
            base="$("$_real" "${args[@]:0:i}" rev-parse --show-toplevel 2> /dev/null)" ||
                base="$("$_real" "${args[@]:0:i}" rev-parse --absolute-git-dir 2> /dev/null)" || return 0
            own="$base/$own"
        fi
    else
        own="$("$_real" "${args[@]:0:i}" rev-parse --path-format=absolute --git-common-dir 2> /dev/null)/hooks" || return 0
    fi
    # The wrapper or the dispatcher checks only when git runs its pre-push, and git ignores a hook that is not
    # executable.
    if [[ -x "$own/pre-push" ]]; then
        if grep -qs PUBLIC-LEAK-CHECK-WRAPPER -- "$own/pre-push"; then return 0; fi
        if [[ -x "$own/dispatch" ]] && grep -qs PUBLIC-LEAK-CHECK-DISPATCHER -- "$own/dispatch"; then return 0; fi
    fi
    out="$("$_real" "${args[@]:0:i}" remote -v 2> /dev/null)" ||
        jj_push_refuse "cannot list this repository's remotes, so whether this push needs the public leak check is unknown and it is refused." \
            "$JJ_PUSH_UNREAD"
    jj_push_guarded "$out" || return 0
    hooks="$(cd -P -- "${BASH_SOURCE[0]%/*}" && pwd)/jj-push-hooks"
    [[ -x "$hooks/pre-push" ]] ||
        jj_push_refuse "the leak gate's hook $hooks/pre-push is missing, so this push from a checkout of a public or unreadable GitHub repository is refused." \
            "$JJ_PUSH_UNREAD"
    export GIT_SHIM_OWN_HOOKS="$own"
    exec "$_real" "${args[@]:0:i}" -c "core.hooksPath=$hooks" "${args[@]:i}"
}
if [[ "${args[i]}" == push ]]; then
    unset GIT_SHIM_OWN_HOOKS
    if from_jj; then jj_push_gate; else plain_push_gate; fi
    exec "$_real" "$@"
fi

verb="${args[i + 1]:-}"
rest=("${args[@]:i+2}")

# Exits as `git worktree remove` without --force would refuse the tree at $1 (spelled $2 by
# the caller), returns 0 when it would go on, 1 when it cannot tell. git's own check
# (check_clean_worktree in builtin/worktree.c) refuses a tree holding a checked-out
# submodule, or anything `git status --porcelain --ignore-submodules=none` lists there. The
# double --force a lock of ours takes skips that check too, so this runs it first, each git
# with the GIT_DIR and GIT_WORK_TREE git's check gives its own `git status`, so a GIT_DIR or
# index the caller exported cannot point it at another repository.
tree_git() {
    (
        unset GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_COMMON_DIR GIT_NAMESPACE
        cd "$1" && GIT_DIR="$1/.git" GIT_WORK_TREE="$1" "$_real" "${@:2}"
    )
}
git_would_remove() {
    local tree="$1" given="$2" gd gitlinks path status populated=0
    [[ -e "$tree" ]] || return 0 # git checks only a tree that is still there
    gd="$(tree_git "$tree" rev-parse --absolute-git-dir 2> /dev/null)" || return 1
    if [[ -d "$gd/modules" ]]; then populated=1; fi
    # Read to EOF, as the lookup below does; a failed listing means "cannot tell".
    gitlinks="$(tree_git "$tree" -c core.quotePath=false ls-files --stage | awk '$1 == "160000"')" || return 1
    while IFS= read -r path; do
        [[ -n "$path" ]] || continue
        path="${path#*$'\t'}"
        if [[ "$path" == \"* ]]; then return 1; fi # a name git had to quote: cannot tell
        if [[ -e "$tree/$path/.git" ]]; then populated=1; fi
    done <<< "$gitlinks"
    if ((populated)); then
        echo "fatal: working trees containing submodules cannot be moved or removed" >&2
        exit 128
    fi
    status="$(tree_git "$tree" status --porcelain --ignore-submodules=none)" || return 1
    if [[ -n "$status" ]]; then
        echo "fatal: '$given' contains modified or untracked files, use --force to delete it" >&2
        exit 128
    fi
}

# Succeeds when the repository's common directory (its store of worktree registrations) lies
# under a temporary root of this session, where no other session or box can register a
# worktree: a throwaway repository a test made with mkdtemp. Both sides are resolved through
# symlinks (git 2.43 already prints the common directory resolved; realpath keeps that true
# for a git that does not) and compared by whole path components, so /tmpfoo is not under
# /tmp. A root that resolves to / would allow everything and is skipped.
prune_common=""
prune_is_safe() {
    local root user
    prune_common="$("$_real" "${args[@]:0:i}" rev-parse --path-format=absolute --git-common-dir 2> /dev/null)" || return 1
    prune_common="$(realpath -e -- "$prune_common" 2> /dev/null)" || return 1
    user="$(id -un)"
    for root in ${TMPDIR:+"$TMPDIR"} /tmp /var/tmp "/mnt/nvme/$user/session-tmp" "/mnt/nvme/$user/tmp-omp-batch" /mnt/nvme/tmp-omp-batch; do
        root="$(realpath -e -- "$root" 2> /dev/null)" || continue
        [[ "$root" != / && "$prune_common" == "$root"/* ]] && return 0
    done
    return 1
}

case "$verb" in
    prune)
        for a in "${rest[@]}"; do
            [[ "$a" == -n || "$a" == --dry-run ]] && exec "$_real" "$@"
        done
        prune_is_safe && exec "$_real" "$@"
        cat >&2 << EOF
git shim: \`git worktree prune\` is refused in an agent session (AGENTC-431).
This repository keeps its worktree registrations in ${prune_common:-a store git did not name},
which other sessions and agent boxes can share. From inside a box every other box's
worktree looks missing, so a prune deletes live sessions' registrations; it did so 17 times
on 2026-09-26.
A prune runs only where no other session can have a worktree: a repository whose store lies
under a temporary root (\$TMPDIR, /tmp, /var/tmp, /mnt/nvme/<user>/session-tmp,
/mnt/nvme/<user>/tmp-omp-batch, /mnt/nvme/tmp-omp-batch), such as one a test made with mkdtemp.
Remove your own worktree with \`git worktree remove <path>\` or \`jj workspace forget <name>\`;
\`git worktree prune -n\` shows what a prune would delete without deleting it.
EOF
        exit 1
        ;;
    add)
        for a in "${rest[@]}"; do
            [[ "$a" == --lock ]] && exec "$_real" "$@"
        done
        exec "$_real" "${args[@]:0:i+2}" --lock --reason "$LOCK_REASON" "${rest[@]}"
        ;;
    remove)
        # A tree carrying an agent add-lock (this shim's, or shims/jj's, exactly) is removed with
        # the lock on: two --force is git's own way past a lock, and git then deletes the lock
        # with the registration, while every refusal leaves it where it was. Taking the lock off
        # first, as this shim used to, left the tree unlocked whenever git refused, as it does
        # for uncommitted work. Any other lock stands.
        #
        # The worktree is the last non-option argument; options end at `--`. The --force count
        # is git's: one skips git's clean check, two its lock check too, `--no-force` starts
        # again. A count this misses only adds a check.
        force=0 target="" opts=1
        for a in "${rest[@]}"; do
            if ((opts)); then
                case "$a" in
                    --) opts=0; continue ;;
                    --force) force=$((force + 1)); continue ;;
                    --no-force) force=0; continue ;;
                    -*) [[ "$a" =~ ^-f+$ ]] && force=$((force + ${#a} - 1)); continue ;;
                esac
            fi
            target="$a"
        done
        ((force < 2)) && [[ -n "$target" ]] || exec "$_real" "$@"

        # Which registration git will remove, found as git's find_worktree finds it: first a
        # trailing part of a registered path, at a directory boundary, that names one tree only
        # (`remove wt`, `remove nest/wt`); else the path read from where every `-C` leaves git,
        # in order (an empty one changes nothing), compared with each registered path after
        # both are resolved. Read from the shim's own directory instead, a tree named by its
        # name or from another directory carried a lock the shim never saw.
        #
        # The listing is read whole, into a variable. A reader that stops early (an awk `exit`
        # on its first match, as an earlier version had) closes the pipe while git is still
        # writing; once the porcelain outgrows the pipe (121 worktrees give 19 KB, and this
        # box's pipes drop to 8 KiB past pipe-user-pages-soft) git dies of SIGPIPE and
        # `set -o pipefail` kills the shim before git runs. That was observed once on the shared
        # legion store (2026-09-30), and left a half-registered worktree.
        #
        # The `|| true` is the guard that matters: this lookup only DECIDES whether to let git
        # past the lock, so any failure of it (a git that cannot read the store, a locked
        # `packed-refs`, a cause nobody found) must degrade to "leave the lock alone" and let the
        # real git run, never to a shim that exits before the user's own command runs.
        listing="$("$_real" "${args[@]:0:i}" worktree list --porcelain || true)"
        paths=() locks=()
        while IFS= read -r line; do
            case "$line" in
                "worktree "*) paths+=("${line#worktree }"); locks+=("") ;;
                locked*) if ((${#locks[@]})); then locks[-1]="$line"; fi ;;
            esac
        done <<< "$listing"
        found="" matches=0
        for k in "${!paths[@]}"; do
            if [[ "${paths[k]}" == "$target" || "${paths[k]}" == */"$target" ]]; then
                found="$k" matches=$((matches + 1))
            fi
        done
        if ((matches != 1)); then
            found="" base="$PWD"
            for ((k = 0; k < i; k++)); do
                case "${args[k]}" in
                    -C)
                        d="${args[k + 1]:-}"
                        if [[ "$d" == /* ]]; then base="$d"; elif [[ -n "$d" ]]; then base="$base/$d"; fi
                        k=$((k + 1))
                        ;;
                    -c | --git-dir | --work-tree | --namespace | --config-env | --exec-path) k=$((k + 1)) ;;
                esac
            done
            want="$target"
            [[ "$want" == /* ]] || want="$base/$want"
            real=()
            if ((${#paths[@]})); then mapfile -t real < <(realpath -m -- "$want" "${paths[@]}" || true); fi
            for k in "${!paths[@]}"; do
                if [[ -n "${real[0]:-}" && "${real[k + 1]:-}" == "${real[0]}" ]]; then
                    found="$k"
                    break
                fi
            done
        fi
        [[ -n "$found" ]] || exec "$_real" "$@"
        lock="${locks[found]}"
        [[ "$lock" == "locked $LOCK_REASON" || "$lock" == "locked $JJ_LOCK_REASON" ]] || exec "$_real" "$@"
        ((force > 0)) || git_would_remove "${paths[found]}" "$target" || exec "$_real" "$@"
        exec "$_real" "${args[@]:0:i+2}" --force --force "${rest[@]}"
        ;;
esac
exec "$_real" "$@"
