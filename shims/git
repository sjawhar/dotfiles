    [[ -n "$abbrev" ]] || return 1
    PUSH_OPTION=$abbrev PUSH_KIND=$abbrev_kind PUSH_UNSET=$abbrev_unset
    # An abbreviation keeps the value after `=`; a negated one cannot carry `=`.
    if [[ "$arg" == *=* ]]; then PUSH_ATTACHED=1 PUSH_VALUE="${arg#*=}"; fi
    return 0
