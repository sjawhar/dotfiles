#!/bin/bash
# git-worktree-shim: locate Git 2.43 global options and expand its non-shell aliases before
# dispatching; in an agent session, refuse a bare `git worktree prune` outside a
# throwaway repository, lock every `git worktree add`, let `git worktree remove` past a
# lock of ours and no further, give every `git commit` without a command-line hooks path
# the leak-term hooks, give every commit an omp session makes its Omp-Session trailer where
# it does now, run the shared public leak check under its existing conditions, run the
# encrypted leak-term check on every `git push` but one from an unguarded checkout to a
# configured remote (its hook scans a public or unknown GitHub URL),
# and keep a pruning `git fetch` from deleting the destination of a short-named refspec.
# From inside an agent box every other box's worktree path looks missing, so a
# prune there deletes live sessions' registrations in the shared store
# (AGENTC-431: 17 bare prunes on 2026-09-26, from five boxes). A locked
# registration survives a prune. Everything else goes straight to the real git.
set -euo pipefail

LOCK_REASON="agent session: locked on add (AGENTC-431)"
# The lock shims/jj puts on a workspace's git worktree when this shim did not lock it
# already (a `jj workspace add` outside an agent session). Ours as well.
JJ_LOCK_REASON="jj shim: locked on add (AGENTC-431)"

# The first git on PATH past this shim, judged by content like shims/gh. Entries
# before the shim's own (`-ef`: its directory however PATH spells it) already had
# their turn: a wrapper there that hands off positionally (knives gh's jj-bookmark
# wrapper) would otherwise be chosen again and the two exec each other forever.
# A PATH that does not carry this shim is scanned whole, then the system dirs.
real_git() {
    local IFS=':'
    local dir candidate header seen_self=0 first_above=""
    for dir in $PATH; do
        candidate="$dir/git"
        [[ -f "$candidate" && -x "$candidate" ]] || continue
        if [[ "$candidate" -ef "$0" ]]; then
            seen_self=1
            continue
        fi
        header=""
        IFS= read -r -n 512 -d '' header < "$candidate" || true
        [[ "$header" == *git-worktree-shim* ]] && continue
        if [[ "$seen_self" == 1 ]]; then
            echo "$candidate"
            return
        fi
        [[ -n "$first_above" ]] || first_above="$candidate"
    done
    if [[ "$seen_self" == 0 && -n "$first_above" ]]; then
        echo "$first_above"
        return
    fi
    # A caller that builds its own PATH may leave the real binary off it.
    for candidate in /usr/bin/git /usr/local/bin/git /bin/git; do
        [[ -f "$candidate" && -x "$candidate" ]] || continue
        header=""
        IFS= read -r -n 512 -d '' header < "$candidate" || true
        [[ "$header" == *git-worktree-shim* ]] && continue
        echo "$candidate"
        return
    done
    return 1
}
if ! _real="$(real_git)"; then
    echo "git shim: no real git found on PATH" >&2
    exit 127
fi
# The shim's own tools (cat, awk, realpath, mktemp) must exist even when the
# caller's PATH omits the system dirs; appending keeps the caller's dirs first.
PATH="$PATH:/usr/bin:/bin"

# Same test as shims/gh: an omp session, an agentbox session, or anything
# launched with the gh-app routing include.
agent_context() {
    [[ -n "${OMP_SESSION_ID:-}${PI_SESSION_FILE:-}${PI_TOOL_BRIDGE_URL:-}${AGENTBOX_SESSION:-}${CLAUDECODE:-}${ENVOY_SESSION_ID:-}${AGENT_SHIM_AGENT:-}${LEGION_ROLE:-}${LEGION_TREE:-}${LEGION_CONTROLLER:-}${LEGION_DAEMON_URL:-}" ]] && return 0
    local i v
    for ((i = 0; i < ${GIT_CONFIG_COUNT:-0}; i++)); do
        v="GIT_CONFIG_VALUE_$i"
        [[ "${!v:-}" == *gh-app-routes.gitconfig ]] && return 0
    done
    # There is no exception for tmux. A pane takes the SERVER's environment, not the environment
    # of whoever asked for the pane, so "inside tmux means the person" let an agent's own
    # `tmux new-window` under the person's server produce a pane with no marker that then ran as
    # the person (round 3 of INFRA-1538). The fix is the other way round: shims/tmux and
    # scripts/agentbox-tmux-guard pass the caller's markers to the new pane with tmux's -e, so an
    # agent's pane carries them and is caught above.
    # A command that arrives over SSH in a session with no terminal (`ssh host az account show`)
    # is an agent's, not a person's: sshd gives a person's own session a terminal and names it in
    # SSH_TTY for the whole session, so a pipe into one command of it (`echo x | az …`, git
    # handing its credential helper the request) is still the person's, where testing this
    # command's own stdin made it an agent's. AGENT_SHIM_PERSON=1 is the person's escape for a
    # deliberate non-interactive SSH command of their own (INFRA-1538).
    if [[ -n "${SSH_CONNECTION:-}" && -z "${SSH_TTY:-}" && "${AGENT_SHIM_PERSON:-}" != 1 ]]; then
        AGENT_CONTEXT_VIA_SSH=1
        return 0
    fi
    return 1
}
# Locate the subcommand exactly past Git 2.43's global options before distinguishing an agent
# from a person: every caller's ordinary `git commit` uses the leak-term hooks. A global query
# or an unknown option cannot reach a subcommand, so leave I at the end and let Git report it.
git_command_index() {
    local option count=${#args[@]}
    i=0
    while ((i < count)); do
        option="${args[i]}"
        case "$option" in
            --help | -h | --version | -v) return ;;
            --exec-path=*) ((i += 1)) ;;
            --exec-path?* | --exec-path | --html-path | --man-path | --info-path | --list-cmds=*) i=$count; return ;;
            -p | --paginate | -P | --no-pager | --no-replace-objects | --bare | --literal-pathspecs | --no-literal-pathspecs | \
                --glob-pathspecs | --noglob-pathspecs | --icase-pathspecs | --no-optional-locks) ((i += 1)) ;;
            --git-dir | --namespace | --work-tree | -c | --config-env | --shallow-file | -C | --attr-source)
                ((i += 2))
                ((i <= count)) || i=$count
                ;;
            --git-dir=* | --namespace=* | --work-tree=* | --config-env=* | --attr-source=*) ((i += 1)) ;;
            -*) i=$count; return ;;
            *) return ;;
        esac
    done
}

# Git v2.43's commands[] table in git.c. Builtins run before aliases, and avoiding the alias
# lookup keeps ordinary commands at their existing process cost.
git_builtin() {
    case "$1" in
        --help | -h | --version | -v | add | am | annotate | apply | archive | bisect | blame | branch | bugreport | bundle | cat-file | \
            check-attr | check-ignore | check-mailmap | check-ref-format | checkout | checkout--worker | checkout-index | cherry | \
            cherry-pick | clean | clone | column | commit | commit-graph | commit-tree | config | count-objects | credential | \
            credential-cache | credential-cache--daemon | credential-store | describe | diagnose | diff | diff-files | diff-index | \
            diff-tree | difftool | fast-export | fast-import | fetch | fetch-pack | fmt-merge-msg | for-each-ref | for-each-repo | \
            format-patch | fsck | fsck-objects | fsmonitor--daemon | gc | get-tar-commit-id | grep | hash-object | help | hook | \
            index-pack | init | init-db | interpret-trailers | log | ls-files | ls-remote | ls-tree | mailinfo | mailsplit | maintenance | \
            merge | merge-base | merge-file | merge-index | merge-ours | merge-recursive | merge-recursive-ours | merge-recursive-theirs | \
            merge-subtree | merge-tree | mktag | mktree | multi-pack-index | mv | name-rev | notes | pack-objects | pack-redundant | \
            pack-refs | patch-id | pickaxe | prune | prune-packed | pull | push | range-diff | read-tree | rebase | receive-pack | reflog | \
            remote | remote-ext | remote-fd | repack | replace | rerere | reset | restore | rev-list | rev-parse | revert | rm | send-pack | \
            shortlog | show | show-branch | show-index | show-ref | sparse-checkout | stage | stash | status | stripspace | \
            submodule--helper | switch | symbolic-ref | tag | unpack-file | unpack-objects | update-index | update-ref | \
            update-server-info | upload-archive | upload-archive--writer | upload-pack | var | verify-commit | verify-pack | verify-tag | \
            version | whatchanged | worktree | write-tree) return 0 ;;
    esac
    return 1
}

# Return true when handle_options() rejects an alias because it changes Git's environment.
git_alias_changes_environment() {
    local option
    local -a alias_options=("$@")
    local index=0 count=${#alias_options[@]}
    while ((index < count)); do
        option="${alias_options[index]}"
        case "$option" in
            --help | -h | --version | -v) return 1 ;;
            --exec-path=*) ((index += 1)) ;;
            --exec-path?* | --exec-path | --html-path | --man-path | --info-path | --list-cmds=*) return 1 ;;
            -p | --paginate) ((index += 1)) ;;
            -P | --no-pager | --no-replace-objects | --git-dir | --git-dir=* | --namespace | --namespace=* | --work-tree | \
                --work-tree=* | --bare | --literal-pathspecs | --no-literal-pathspecs | --glob-pathspecs | --noglob-pathspecs | \
                --icase-pathspecs | --no-optional-locks | --shallow-file | -C | --attr-source | --attr-source=*) return 0 ;;
            -c | --config-env)
                ((index += 2))
                ((index <= count)) || return 1
                ;;
            --config-env=*) ((index += 1)) ;;
            -*) return 1 ;;
            *) return 1 ;;
        esac
    done
    return 1
}

# Expand ordinary aliases with Git's split_cmdline rules. A shell alias starts with `!`; Git
# delegates it to a shell, so it stays outside this shim's commit and push dispatch. Git 2.43's
# run_argv (git.c) tries a builtin, then an external `git-<name>` from its exec path or PATH,
# and reads alias.<name> only when neither exists, so a name that is an external command is
# left to git unexpanded.
git_external_command() {
    local exec_path
    exec_path="$("$_real" "${args[@]:0:i}" --exec-path 2> /dev/null)" || exec_path="$("$_real" --exec-path 2> /dev/null)" || exec_path=""
    [[ -n "$exec_path" && -f "$exec_path/git-$1" && -x "$exec_path/git-$1" ]] && return 0
    command -v -- "git-$1" > /dev/null 2>&1
}
git_alias_refuse() {
    printf 'git shim: cannot read alias %s, so the leak-term check cannot run. Nothing was changed.\n' "$1" >&2
    exit 1
}

git_expand_aliases() {
    local name decoder_pid decoder_read
    local -a alias_words=()
    local -A seen=()
    while ((i < ${#args[@]})); do
        name="${args[i]}"
        git_builtin "$name" && return
        git_external_command "$name" && return
        [[ -z "${seen[$name]:-}" ]] || {
            args=("${original_args[@]}")
            git_command_index
            return
        }
        alias_words=()
        if mapfile -d '' -t alias_words < <(
            python3 - "$_real" "$name" "${args[@]:0:i}" <<'PY'
import os
import subprocess
import sys

real, name, *globals_ = sys.argv[1:]
try:
    completed = subprocess.run(
        [real, *globals_, "config", "--null", "--get", f"alias.{name}"],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=False,
    )
except OSError:
    sys.stdout.buffer.write(b"error\0")
    raise SystemExit
if completed.returncode == 1:
    sys.stdout.buffer.write(b"missing\0")
    raise SystemExit
if completed.returncode:
    sys.stdout.buffer.write(b"error\0")
    raise SystemExit
if completed.stdout.count(b"\0") != 1 or not completed.stdout.endswith(b"\0"):
    sys.stdout.buffer.write(b"error\0")
    raise SystemExit
value = completed.stdout[:-1]
if value.startswith(b"!"):
    sys.stdout.buffer.write(b"shell\0")
    raise SystemExit

whitespace = b" \t\n\v\f\r"
words = []
word = bytearray()
quoted = 0
index = 0
while index < len(value):
    character = value[index]
    if not quoted and character in whitespace:
        words.append(bytes(word))
        word.clear()
        index += 1
        while index < len(value) and value[index] in whitespace:
            index += 1
        continue
    if not quoted and character in (ord("'"), ord('"')):
        quoted = character
        index += 1
        continue
    if quoted and character == quoted:
        quoted = 0
        index += 1
        continue
    if character == ord("\\") and quoted != ord("'"):
        index += 1
        if index == len(value):
            sys.stdout.buffer.write(b"split\0")
            raise SystemExit
        character = value[index]
    word.append(character)
    index += 1
if quoted:
    sys.stdout.buffer.write(b"split\0")
    raise SystemExit
words.append(bytes(word))
sys.stdout.buffer.write(b"found\0")
for word in words:
    sys.stdout.buffer.write(word + b"\0")
PY
        ); then
            decoder_read=0
        else
            decoder_read=$?
        fi
        decoder_pid=$!
        if ((decoder_read != 0)) || ! wait "$decoder_pid"; then
            git_alias_refuse "$name"
        fi
        case "${alias_words[0]:-}" in
            missing | shell) return ;;
            found) ;;
            *) git_alias_refuse "$name" ;;
        esac
        git_alias_changes_environment "${alias_words[@]:1}" && return
        [[ "${alias_words[1]:-}" != "$name" ]] || return
        seen["$name"]=1
        args=("${args[@]:0:i}" "${alias_words[@]:1}" "${args[@]:i+1}")
        git_command_index
    done
}

args=("$@")
original_args=("$@")
git_command_index
git_expand_aliases
set -- "${args[@]}"

# A caller who selects a hooks path owns that command, and the scanner does not run. Git's
# `-c` takes a separate `key=value`, while --config-env accepts both separate and `=` forms.
caller_hooks_path=0
for ((k = 0; k < i; k++)); do
    config=""
    case "${args[k]}" in
        -c | --config-env)
            ((k + 1 < i)) || break
            config="${args[k + 1]}"
            ((k += 1))
            ;;
        --config-env=*) config="${args[k]#*=}" ;;
        # Another global's separate value is never a -c entry, even when it reads `-c`.
        -C | --git-dir | --work-tree | --namespace | --shallow-file | --attr-source) ((k += 1)); continue ;;
        *) continue ;;
    esac
    [[ "${config%%=*}" != [Cc][Oo][Rr][Ee].[Hh][Oo][Oo][Kk][Ss][Pp][Aa][Tt][Hh] ]] || {
        caller_hooks_path=1
        break
    }
done

# Prints DOTFILES_GIT_COMMIT_SCAN, `cleanup=<mode> verbose=<n|config|unknown>
# status=<1|0|config|unknown> verify=<1|0|unknown>`: the mode is `absent` when the argv names no
# --cleanup (the hook then reads commit.cleanup), `default` for an explicit --cleanup=default, a
# named mode, or `unknown` when the argv cannot be read; verify is 0 under --no-verify.
scan_unknown() {
    printf 'cleanup=unknown verbose=unknown status=unknown verify=unknown'
}
commit_scan_state() {
    local cleanup=absent verbose=config status=config verify=1 option canonical value short character long j index
    local -a long_options=(
        all interactive patch include only quiet verbose no-verbose amend no-post-rewrite post-rewrite dry-run
        short branch ahead-behind porcelain long null allow-empty allow-empty-message no-verify verify author date
        cleanup status no-status reset-author file message reuse-message reedit-message template fixup squash trailer
        gpg-sign no-gpg-sign signoff no-signoff edit no-edit untracked-files pathspec-from-file pathspec-file-nul
    )

    index=$((i + 1))
    while ((index < ${#args[@]})); do
        option="${args[index]}"
        if [[ "$option" == -- ]]; then
            break
        fi
        if [[ "$option" == --* ]]; then
            value="${option#--}"
            value="${value%%=*}"
            canonical=""
            for long in "${long_options[@]}"; do
                if [[ "$long" == "$value" ]]; then
                    canonical="$long"
                    break
                fi
                if [[ "$long" == "$value"* ]]; then
                    if [[ -n "$canonical" ]]; then
                        scan_unknown
                        return
                    fi
                    canonical="$long"
                fi
            done
            if [[ -z "$canonical" ]]; then
                scan_unknown
                return
            fi
            case "$canonical" in
                cleanup)
                    if [[ "$option" == *=* ]]; then
                        value="${option#*=}"
                    elif ((index + 1 < ${#args[@]})); then
                        index=$((index + 1))
                        value="${args[index]}"
                    else
                        scan_unknown
                        return
                    fi
                    case "$value" in
                        default | verbatim | whitespace | strip | scissors) cleanup="$value" ;;
                        *) scan_unknown; return ;;
                    esac
                    ;;
                verbose)
                    [[ "$option" == *=* ]] && { scan_unknown; return; }
                    if [[ "$verbose" == config ]]; then verbose=1; else verbose=$((verbose + 1)); fi
                    ;;
                no-verbose) [[ "$option" == *=* ]] && { scan_unknown; return; }; verbose=0 ;;
                status) [[ "$option" == *=* ]] && { scan_unknown; return; }; status=1 ;;
                no-status) [[ "$option" == *=* ]] && { scan_unknown; return; }; status=0 ;;
                verify) [[ "$option" == *=* ]] && { scan_unknown; return; }; verify=1 ;;
                no-verify) [[ "$option" == *=* ]] && { scan_unknown; return; }; verify=0 ;;
                message | file | reuse-message | reedit-message | template | author | date | fixup | squash | trailer | pathspec-from-file)
                    if [[ "$option" != *=* ]]; then
                        ((index + 1 < ${#args[@]})) || { scan_unknown; return; }
                        index=$((index + 1))
                    fi
                    ;;
                gpg-sign | untracked-files)
                    ;;
                *)
                    if [[ "$option" == *=* ]]; then
                        scan_unknown
                        return
                    fi
                    ;;
            esac
        elif [[ "$option" == -?* ]]; then
            short="${option#-}"
            j=0
            while ((j < ${#short})); do
                character="${short:j:1}"
                case "$character" in
                    v)
                        if [[ "$verbose" == config ]]; then verbose=1; else verbose=$((verbose + 1)); fi
                        ;;
                    n) verify=0 ;;
                    a | i | p | o | q | e | s | z) ;;
                    m | F | c | C | t)
                        if ((j + 1 < ${#short})); then
                            j=${#short}
                            continue
                        fi
                        ((index + 1 < ${#args[@]})) || { scan_unknown; return; }
                        index=$((index + 1))
                        ;;
                    S | u)
                        j=${#short}
                        continue
                        ;;
                    *) scan_unknown; return ;;
                esac
                j=$((j + 1))
            done
        fi
        index=$((index + 1))
    done
    printf 'cleanup=%s verbose=%s status=%s verify=%s' "$cleanup" "$verbose" "$status" "$verify"
}

scan_commit=0
unset DOTFILES_GIT_COMMIT_SCAN
if [[ "${args[i]:-}" == commit && $caller_hooks_path -eq 0 ]]; then
    scan_commit=1
    DOTFILES_GIT_COMMIT_SCAN="$(commit_scan_state)"
    export DOTFILES_GIT_COMMIT_SCAN
fi

is_agent=0
if agent_context; then
    is_agent=1
fi
# Say so when the SSH rule, and not a session marker, made this an agent's call: the agent-session
# rules below (the session trailer, the worktree lock, the prune refusal, the public check of a push)
# are otherwise silent about why, and a person whose own non-interactive ssh command this is needs
# the escape named.
if [[ -n "${AGENT_CONTEXT_VIA_SSH:-}" ]]; then
    echo "git shim: non-interactive SSH, so an agent's call, under the agent-session rules (set AGENT_SHIM_PERSON=1 for your own)" >&2
fi

# A commit made from an omp session carries `Omp-Session: <id>`, the trailer
# session attribution reads; omp/extensions/session-env.ts exports the id, and
# jj commits get the same trailer from its JJ_CONFIG overlay. A missing or
# malformed id adds nothing: attribution may be absent, never wrong.
# scripts/omp-session-trailer says yes everywhere unless the checkout sets
# `git config omp.sessionTrailer false`, or the repository is a throwaway one (no
# remote, and its common directory under a temporary root, such as a test's mkdtemp).
# - `git commit`: git's own --trailer adds it, so the repository's hooks and
#   commit signing run exactly as they would without it, and
#   `ifexists=addIfDifferent` keeps an amend from repeating it. A commit without a
#   command-line `core.hooksPath` gets it here, with the leak-term hooks; one with
#   such a hooks path gets it in the case below.
# - `git merge`, `pull`, `cherry-pick`, `revert` take no --trailer, so they run
#   with `core.hooksPath` at shims/git-hooks/, whose prepare-commit-msg adds the
#   same line; then every hook name there runs the hook git would have run
#   without that override (git-hooks/hook). A rebase (`pull --rebase`) keeps each
#   replayed commit's message as it was. A caller's own `-c core.hooksPath`
#   stands, and that command gets no trailer.
# An ordinary alias is expanded first, so it gets the trailer of the command it names. A commit
# made through a shell alias (`!…`), `git rebase`, `git am` or `git commit-tree` carries none.
session_re='^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
if ((scan_commit)); then
    hook_dir="$(cd -P -- "${BASH_SOURCE[0]%/*}" && pwd)/git-hooks"
    if ((is_agent)) && [[ "${OMP_SESSION_ID:-}" =~ $session_re ]] &&
        "${BASH_SOURCE[0]%/*}/../scripts/omp-session-trailer" "$_real" "${args[@]:0:i}" > /dev/null 2>&1; then
        exec "$_real" "${args[@]:0:i}" -c trailer.Omp-Session.ifexists=addIfDifferent -c "core.hooksPath=$hook_dir" \
            commit --trailer "Omp-Session: $OMP_SESSION_ID" "${args[@]:i+1}"
    fi
    exec "$_real" "${args[@]:0:i}" -c "core.hooksPath=$hook_dir" "${args[@]:i}"
fi

if [[ "${args[i]:-}" != push ]]; then
    ((is_agent)) || exec "$_real" "$@"
fi
case "${args[i]:-}" in
    commit | merge | pull | cherry-pick | revert)
        if [[ "${OMP_SESSION_ID:-}" =~ $session_re ]] &&
            "${BASH_SOURCE[0]%/*}/../scripts/omp-session-trailer" "$_real" "${args[@]:0:i}" > /dev/null 2>&1; then
            if [[ "${args[i]}" == commit ]]; then
                exec "$_real" "${args[@]:0:i}" -c trailer.Omp-Session.ifexists=addIfDifferent commit --trailer "Omp-Session: $OMP_SESSION_ID" "${args[@]:i+1}"
            fi
            [[ $caller_hooks_path -eq 1 ]] || exec "$_real" "${args[@]:0:i}" -c "core.hooksPath=$(cd -P -- "${BASH_SOURCE[0]%/*}" && pwd)/git-hooks" "${args[@]:i}"
        fi
        ;;
esac
# A fetch with pruning on (`fetch.prune`, set in this repo's .gitconfig, or --prune)
# deletes the destination of a command-line refspec whose source is not a full ref
# name, such as `git fetch origin b:refs/remotes/origin/b`, instead of updating it,
# whenever that destination already exists, and exits 0: every second run leaves it
# missing (git 2.43.0, 2026-11-02; `+b:…`, tags, `HEAD:…` and a refs/heads/
# destination too). Prune never deletes anything else for refspecs without a `*`:
# a source the remote lacks fails the fetch first. So when every command-line
# refspec is such a one and one of them has that form, the fetch runs with a last
# --no-prune, and no refspec changes. A glob or negative refspec beside it, refspecs
# on stdin (--stdin) or `--multiple` leave the fetch as it was, as does a fetch from
# a URL with fetch.pruneTags, whose tag pruning --no-prune would also stop.
if [[ "${args[i]:-}" == fetch ]]; then
    fetch_fix=0 positional=0 opts=1 end=${#args[@]}
    for ((k = i + 1; k < ${#args[@]}; k++)); do
        a="${args[k]}"
        if ((opts)); then
            case "$a" in
                --) opts=0 end=$k; continue ;;
                --multiple | --stdin) exec "$_real" "$@" ;;
                --upload-pack | -j | --jobs | --depth | --shallow-since | --shallow-exclude | --deepen | --refmap | \
                    -o | --server-option | --negotiation-tip | --filter | --recurse-submodules-default | --submodule-prefix)
                    k=$((k + 1)); continue ;;
                -?*) continue ;;
            esac
        fi
        positional=$((positional + 1))
        if ((positional == 1)); then
            remote="$a"
            continue
        fi
        [[ "$a" != *'*'* && "$a" != ^* ]] || exec "$_real" "$@"
        src="${a%%:*}" src="${src#+}"
        [[ "$a" == *:?* && "$src" != refs/* ]] && fetch_fix=1
    done
    if ((fetch_fix)) && [[ "$remote" == *[:/]* ]]; then
        "$_real" "${args[@]:0:i}" config --get --type=bool fetch.pruneTags 2> /dev/null | grep -qx true && exec "$_real" "$@"
    fi
    ((fetch_fix)) || exec "$_real" "$@"
    exec "$_real" "${args[@]:0:end}" --no-prune "${args[@]:end}"
fi

