#!/usr/bin/env python3
"""Report Pulumi programs that are merged, declared and never applied.

Why this exists: agent-infra 904aecc3 ("bootstrap, legion: a worker pod reads its Google
project and no secret's value through that role") merged at 2026-10-30T00:34Z and declared a
custom IAM role and its binding. Nobody applied it. It surfaced two hours later only because a
Legion worker pod ran its own check and got 403 on nine of twelve assertions, and the INFRA
lead applied it by hand at 02:29Z. The same preview showed six further creates from
agent-infra #151, merged 2026-10-29T19:06Z, still unapplied.

Nothing measured that gap. `main` is the declared state and the cloud is the live state, and
between a merge and an apply they differ with no instrument on the difference. The cost is not
only the missing resource: the next person's targeted preview carries a stranger's creates, so
an applier who was told "stop if the plan is not exactly N" stops on a correct apply, and an
applier who is not told that applies a change they never read.

What one run does:

  1. Put a private checkout on origin/main. It is this script's own, under STATE_ROOT, so no
     worktree a person or an agent is working in is touched, fetched or reset.
  2. For each configured stack, run `pulumi preview --non-interactive` and read the plan's
     counts. A preview takes no state lock, so a run never blocks an apply, and it is the only
     operation here: this script applies nothing and can refuse nothing.
  3. Append one sample per stack per run to the log, whether or not anything is pending. A
     silent log cannot be told from a dead watch.
  4. Alert over Envoy only when a stack's pending set changes, or a preview starts failing, or a
     run cannot start. A clean stack says nothing, because a daily "nothing to report" trains
     its reader to ignore it; and bootstrap/prod had pending steps in every one of its 7
     samples (2026-10-30..11-02), so the same pending set again is not news either.
  5. Name every pending resource in the message (at most 600 characters, short names), and
     every URN in the report file it names, so the reader can tell whose change it is without
     running the preview again.

What it does not do: it does not apply, does not refresh (a refresh takes a lock and rewrites
state), does not read or print any secret, and does not judge whether a pending plan is good.
An unapplied merge may be deliberate -- a change whose apply waits for a key move, or for a
person. The report says what is pending; a human or the stack's owner decides.

The credential is agent-infra's applier, infra-applier@, whose token the box identity mints per
run by impersonation (bootstrap/README.md, "Who applies"); a preview applies nothing with it,
and no person's login is used. TAILSCALE_API_KEY is set to a
value that authenticates nowhere, which is what bootstrap/README.md's targeted runs use: the
Tailscale provider must be configurable for the program to compile, and a preview that does not
refresh never calls Tailscale. If a stack is ever added whose preview does reach Tailscale, that
stack needs the real key and does not belong in this watch.
"""

from __future__ import annotations

import argparse
import json
import os
import pathlib
import re
import shutil
import socket
import subprocess
import sys
import time

REPO_URL = "https://github.com/theorem-labs/agent-infra"
STATE_ROOT = pathlib.Path(
    os.environ.get("PULUMI_DRIFT_WATCH_STATE", "/mnt/nvme/sami/pulumi-drift-watch")
)
CHECKOUT = STATE_ROOT / "agent-infra"
LOG = STATE_ROOT / "samples.jsonl"

# Each entry: the directory under the checkout, and the stack name. Only stacks whose preview
# reaches no provider that needs a credential this box does not hold.
STACKS = [("bootstrap", "prod")]

# Who hears it: the INFRA project's Legion controller, which owns the pending applies
# (dispatch://INFRA-430 comment c78927c8), by its Envoy role, so the address survives a new
# controller session. The INFRA lead asked for it too (2026-10-30T02:28Z) but holds no Envoy role
# (`envoy ps`, 2026-11-03), so its session id is the fallback only, for when nobody holds the role.
TARGET = "notifications.role.legion-infra-controller"
FALLBACK = "01a13c57-d826-7242-80fe-5f0670188b11"  # INFRA lead
MESSAGE_LIMIT = 600
REPORT_DAYS = 7

ENVOY = pathlib.Path(__file__).with_name("envoy")
# agent-infra's applier: bootstrap/README.md's "Who applies" has a session export it, and the
# box identity holds roles/iam.serviceAccountTokenCreator on it.
APPLIER = "infra-applier@theorem-agent-infra.iam.gserviceaccount.com"
PREVIEW_TIMEOUT_S = 900


def run(cmd: list[str], cwd: pathlib.Path | None = None, env: dict | None = None,
        timeout: int = 300) -> subprocess.CompletedProcess:
    return subprocess.run(
        cmd, cwd=cwd, env=env, timeout=timeout,
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
    )


def ensure_checkout() -> str:
    """Put this watch's own checkout on origin/main. Returns the commit it sits on."""
    STATE_ROOT.mkdir(parents=True, exist_ok=True)
    if not (CHECKOUT / ".git").exists():
        if CHECKOUT.exists():
            shutil.rmtree(CHECKOUT)
        r = run(["git", "clone", "--filter=blob:none", REPO_URL, str(CHECKOUT)], timeout=900)
        if r.returncode != 0:
            raise RuntimeError(f"clone failed: {r.stdout[-2000:]}")
    for cmd in (["git", "fetch", "origin", "main", "--quiet"],
                ["git", "reset", "--hard", "origin/main", "--quiet"],
                ["git", "clean", "-qfd"]):
        r = run(cmd, cwd=CHECKOUT, timeout=900)
        if r.returncode != 0:
            raise RuntimeError(f"{' '.join(cmd)} failed: {r.stdout[-2000:]}")
    return run(["git", "rev-parse", "HEAD"], cwd=CHECKOUT).stdout.strip()


def preview_env() -> dict:
    # stderr apart: gcloud warns on stderr that it impersonates, and stdout must be the token alone.
    token = subprocess.run(
        ["gcloud", "auth", "print-access-token", f"--impersonate-service-account={APPLIER}"],
        timeout=120, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
    )
    if token.returncode != 0 or not token.stdout.strip():
        raise RuntimeError(f"no Google token as {APPLIER}: {token.stderr.strip()[:400]}")
    env = dict(os.environ)
    env["CLOUDSDK_AUTH_IMPERSONATE_SERVICE_ACCOUNT"] = APPLIER
    env["GOOGLE_OAUTH_ACCESS_TOKEN"] = token.stdout.strip()
    # Authenticates nowhere; a preview that does not refresh never calls Tailscale.
    env["TAILSCALE_API_KEY"] = "unused"
    env["PULUMI_SKIP_UPDATE_CHECK"] = "true"
    return env


STEP_RE = re.compile(r"^\s*([+~\-]|\+-)\s+(\S+)\s+(\S+)\s+(create|update|delete|replace)\b")


def preview(directory: str, stack: str, env: dict) -> dict:
    """Run one preview. Returns the plan: counts, the steps, and the raw tail."""
    cwd = CHECKOUT / directory
    r = run(
        ["pulumi", "preview", "--stack", stack, "--non-interactive", "--diff"],
        cwd=cwd, env=env, timeout=PREVIEW_TIMEOUT_S,
    )
    out = r.stdout
    steps, counts = [], {}
    for line in out.splitlines():
        m = re.search(r"^\s*([+~]|\+-|-)\s+(\S+):\s*\((create|update|delete|replace)\)", line)
        if m:
            continue  # the --diff body; the URN follows on the next line
        m = re.search(r"\[urn=(\S+?)\]", line)
        if m:
            steps.append(m.group(1))
    for kind in ("create", "update", "delete", "replace"):
        m = re.search(rf"^\s*[+~\-]*\s*(\d+)\s+to {kind}", out, re.MULTILINE)
        if m:
            counts[kind] = int(m.group(1))
    m = re.search(r"^\s*(\d+)\s+unchanged", out, re.MULTILINE)
    unchanged = int(m.group(1)) if m else None
    pending = sum(counts.values())
    # The stack resource's own URN is always printed; it is not a step.
    steps = [u for u in steps if "::pulumi:pulumi:Stack::" not in u]
    return {
        "dir": directory, "stack": stack, "rc": r.returncode, "counts": counts,
        "pending": pending, "unchanged": unchanged, "steps": steps, "tail": out[-4000:],
    }


def report_text(commit: str, plan: dict) -> str:
    """Everything a reader needs to act: the full report file a message names."""
    where = f"{plan['dir']}/ stack {plan['stack']}"
    if plan["rc"] != 0:
        return (
            f"PULUMI PREVIEW FAILED: {where} on theorem-labs/agent-infra main at {commit[:9]}, "
            f"exit {plan['rc']}. This watch previews only; it applied nothing and refused "
            f"nothing. The preview's last lines:\n\n{plan['tail']}\n\n"
            "A failed preview hides whatever is pending behind it, so treat this as unknown "
            "drift, not as a clean stack. From pulumi-drift-watch "
            f"(~/.dotfiles/scripts/pulumi-drift-watch) on {socket.gethostname()}, a systemd --user timer.\n"
        )
    parts = ", ".join(f"{n} to {k}" for k, n in sorted(plan["counts"].items()))
    body = [
        f"PULUMI PLAN PENDING ON MAIN: {where} at theorem-labs/agent-infra {commit[:9]} plans "
        f"{parts} ({plan['unchanged']} unchanged). Every one of these is merged and declared "
        "and not live: the code says it exists and the cloud does not.",
        "",
        "What is pending, by URN:",
    ]
    body += [f"  {u}" for u in plan["steps"]]
    body += [
        "",
        "Why this matters beyond the missing resources: the next person's preview of this stack "
        "carries these steps too. An applier told to stop unless the plan is exactly their own "
        "N will stop on a correct apply, and one not told that will apply a change they never "
        "read.",
        "",
        "What to do: find who merged each one (`git log --oneline -S<name> -- " + plan["dir"] +
        "/`), and have that author preview and apply it with their own acceptance. An apply "
        "that is deliberately waiting -- on a key move, a person, or another stack -- needs no "
        "action here; say so on its issue so the next report is read rather than skipped.",
        "",
        "This watch previews only. It applies nothing, refreshes nothing (a refresh takes the "
        "state lock), reads no secret, and judges nothing. A preview takes no lock, so this run "
        "blocked no apply. It says a pending set once, and again only when the set changes. From "
        f"pulumi-drift-watch (~/.dotfiles/scripts/pulumi-drift-watch) on {socket.gethostname()}, "
        "a systemd --user timer.",
        "",
        "The preview's last lines:",
        plan["tail"],
    ]
    return "\n".join(body) + "\n"


def resource_name(urn: str) -> str:
    """`urn:pulumi:prod::proj::gcp:iam/x:WorkloadIdentityPool::github-preview` -> `github-preview`,
    the name `git log -S` finds in the program; the report has the whole URN."""
    return urn.rpartition("::")[2]


def fit(items: list[str], room: int) -> str:
    """As many of `items` as fit in `room` characters, then how many more the report lists."""
    shown: list[str] = []
    for i, item in enumerate(items):
        more = len(items) - i - 1
        if len(", ".join(shown + [item]) + (f", and {more} more" if more else "")) > room:
            break
        shown.append(item)
    more = len(items) - len(shown)
    if not more:
        return ", ".join(shown)
    return ", ".join(shown) + f", and {more} more" if shown else f"{more} resources, listed in the report"


def bounded(text: str, tail: str) -> str:
    """`text` cut at its end so that `text + tail` is at most MESSAGE_LIMIT characters."""
    room = MESSAGE_LIMIT - len(tail)
    if len(text) > room:
        text = text[: max(0, room - 2)].rstrip() + "… "
    return text + tail


def message_text(commit: str, plan: dict, previous: str | None, report: str) -> str:
    """The Envoy message: the decision first, every pending resource by name, the report last.

    The controller runs in GKE (Envoy lists it on machine `gke`) and cannot open a file on this
    box, so the names are in the message itself; the 6 pending on 2026-11-02 take 193 characters."""
    where = f"{plan['dir']}/{plan['stack']} at agent-infra {commit[:9]}"
    tail = f"Full report: {report}"
    if plan["rc"] != 0:
        last = next((line.strip() for line in reversed(plan["tail"].splitlines()) if line.strip()), "")
        return bounded(
            f"PULUMI PREVIEW FAILED: {where}, exit {plan['rc']}: what is pending is unknown until a preview"
            f" works. Last line: {last[:200]}. Applied and refused nothing. Said once, until a preview"
            " works again. ", tail)
    parts = ", ".join(f"{n} to {k}" for k, n in sorted(plan["counts"].items()))
    before = set(previous.splitlines()) if previous and previous != "failed" else None
    now = set(plan["steps"])
    change = (f"Changed since the last report: {len(now - before)} added, {len(before - now)} gone. "
              if before is not None else "")
    head = f"PULUMI PLAN PENDING: {where}: {parts}, merged, not live. {change}Pending: "
    advice = (f". Authors apply theirs or say on the issue that it waits (git log -S<name> -- {plan['dir']}/)."
              " Sent again only on a change. ")
    names = fit([resource_name(u) for u in sorted(plan["steps"])],
                MESSAGE_LIMIT - len(head) - len(advice) - len(tail))
    return bounded(head + names + advice, tail)


def write_report(kind: str, text: str) -> str:
    """One report file under STATE_ROOT/reports, those older than REPORT_DAYS removed; its path."""
    directory = STATE_ROOT / "reports"
    now = time.time()
    path = directory / f"{time.strftime('%Y%m%dT%H%M%SZ', time.gmtime(now))}-{kind}.txt"
    try:
        directory.mkdir(parents=True, exist_ok=True)
        path.write_text(text)
    except OSError as exc:
        print(f"report {path} not written: {exc}", file=sys.stderr)
        return f"none ({path} not written: {exc.strerror or exc})"
    for old in directory.glob("*.txt"):
        try:
            if old.stat().st_mtime < now - REPORT_DAYS * 86400:
                old.unlink()
        except OSError:
            continue
    return str(path)


def plan_fingerprint(plan: dict) -> str:
    """What makes one report different news from the last: the step set, or a failed preview.

    The counts and the unchanged total are deliberately left out. The same six URNs with a
    different unchanged total is the same news; one more URN is not.
    """
    if plan["rc"] != 0:
        return "failed"
    return "\n".join(sorted(plan["steps"]))


def sent_path(directory: str, stack: str) -> pathlib.Path:
    return STATE_ROOT / f"sent.{directory.replace('/', '_')}.{stack}"


def last_sent(directory: str, stack: str) -> str | None:
    try:
        return sent_path(directory, stack).read_text()
    except OSError:
        return None


def remember_sent(directory: str, stack: str, fingerprint: str) -> None:
    try:
        sent_path(directory, stack).write_text(fingerprint)
    except OSError as exc:
        # Failing to remember costs a repeated report, never a missed one.
        print(f"could not record the sent set for {directory}/{stack}: {exc}", file=sys.stderr)


def forget_sent(directory: str, stack: str) -> None:
    sent_path(directory, stack).unlink(missing_ok=True)


def send(target: str, text: str) -> bool:
    """One Envoy message: a session id is a direct send, a topic (a role) a publish."""
    try:
        r = subprocess.run([str(ENVOY), "send", "--source", "envoy", "--message-file", "-", target],
                           input=text, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, timeout=120)
    except (OSError, subprocess.SubprocessError) as exc:
        print(f"envoy send to {target} failed: {exc}", file=sys.stderr)
        return False
    if r.returncode != 0:
        print(f"envoy send to {target} failed: {r.stdout.strip()[:400]}", file=sys.stderr)
    return r.returncode == 0


def deliver(text: str) -> str:
    """Send to the controller's role, else to the INFRA lead; who took it, or "" for nobody."""
    return next((t for t in (TARGET, FALLBACK) if send(t, text)), "")


# A run that cannot start says so once per cause (the text before the first ':' of its error),
# and again only after a run that started: a daily repeat of the same failure is not news.
COULD_NOT_RUN = "sent.could-not-run"


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--dry-run", action="store_true",
                    help="run the previews and print what would be sent; send nothing")
    ap.add_argument("--print-alert", action="store_true",
                    help="print each alert to stdout as well as sending it")
    ap.add_argument("--always", action="store_true",
                    help="report even a stack with nothing pending (for proving the path)")
    args = ap.parse_args(argv)

    STATE_ROOT.mkdir(parents=True, exist_ok=True)
    try:
        commit = ensure_checkout()
        env = preview_env()
    except Exception as exc:  # the run itself could not start
        cause = str(exc).split(":", 1)[0]
        print(f"PULUMI DRIFT WATCH COULD NOT RUN: {exc}", file=sys.stderr)
        repeat = (STATE_ROOT / COULD_NOT_RUN).is_file() and (STATE_ROOT / COULD_NOT_RUN).read_text() == cause
        if args.dry_run or repeat:
            return 1
        report = write_report("could-not-run", f"PULUMI DRIFT WATCH COULD NOT RUN on {socket.gethostname()}: {exc}\n")
        text = bounded(
            f"PULUMI DRIFT WATCH COULD NOT RUN on {socket.gethostname()}: {str(exc)[:250]}. No preview ran, so"
            " pending plans are unknown until a run works. Said once per cause. ", f"Full report: {report}")
        if deliver(text):
            (STATE_ROOT / COULD_NOT_RUN).write_text(cause)
        return 1
    (STATE_ROOT / COULD_NOT_RUN).unlink(missing_ok=True)

    rc = 0
    for directory, stack in STACKS:
        plan = preview(directory, stack, env)
        sample = {"t": time.time(), "commit": commit, **{
            k: plan[k] for k in ("dir", "stack", "rc", "counts", "pending", "unchanged")}}
        with LOG.open("a") as fh:
            fh.write(json.dumps(sample) + "\n")
        noisy = plan["rc"] != 0 or plan["pending"] > 0 or args.always
        if not noisy:
            print(f"{directory}/{stack}: clean ({plan['unchanged']} unchanged)")
            forget_sent(directory, stack)
            continue
        # A report a reader has already acted on is not news, and a watch that repeats itself
        # trains its reader to skip it. The INFRA controller got this stack's same six URNs twice
        # in seven minutes on 2026-10-30 and asked for exactly this (dispatch://INFRA-430, comment
        # c78927c8 records that set as deliberately waiting on dispatch://INFRA-773). So a pending
        # set is sent once and then only when the set itself changes -- a URN added or removed, or
        # a preview that failed where it used to succeed. A clean run forgets the set, so the next
        # time it comes back it is news again. Only a hand run with --always repeats a set.
        fingerprint = plan_fingerprint(plan)
        previous = last_sent(directory, stack)
        if plan["rc"] != 0:
            rc = 1
        if not args.always and fingerprint == previous:
            print(f"{directory}/{stack}: unchanged pending set, not resent ({plan['pending']} pending)")
            continue
        full = report_text(commit, plan)
        if args.dry_run:
            print(message_text(commit, plan, previous, "(not written in a dry run)"))
            print(full)
            continue
        text = message_text(commit, plan, previous, write_report("failed" if plan["rc"] else "pending", full))
        if args.print_alert:
            print(text)
        # Claiming delivery without checking it is how a watch becomes decorative.
        told = deliver(text)
        if not told:
            print("no recipient took the alert", file=sys.stderr)
            rc = 1
        else:
            print(f"{directory}/{stack}: sent to {told}")
            remember_sent(directory, stack, fingerprint)
    return rc


if __name__ == "__main__":
    sys.exit(main())
