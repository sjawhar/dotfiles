#!/usr/bin/env python3
"""omp-root-hang-watch: tell the box-health owner once when a lead's root omp session hangs.

    omp-root-hang-watch [--role ROLE | --session ID] [--to TOPIC|ID] [--stale-minutes N]
                        [--sessions-root DIR] [--state FILE] [--dry-run]

Every 5 minutes (the `omp-root-hang-watch` user timer), it reads one root session's transcript,
`~/.omp/agent/sessions/<dir>/<time>_<session>.jsonl`. The session is the holder of an Envoy role
(`--role`, default `lead-rocq-speed`, the Rocq speed stream's lead), not a session id written
here: when the lead's session is replaced, the watch follows the role. It sends one Envoy message
to the box-health lead's role (`notifications.role.lead-box-health`, `--to`) when both are true:

1. The transcript has had no new line for 30 minutes (its mtime).
2. The session has a live child job: a tool call the session started that has no result.

The holder comes from GET /v1/sessions, which only reads. Never GET /v1/roles/<role>: answering it
releases a lapsed holder's claim (scripts/envoy-role-holder-watch, step 3). A hung root stops
heartbeating and Envoy then drops it from that list, which is exactly the case this watch exists
for, so the last holder it resolved is kept in the state file and watched while Envoy lists no
holder of the role (or does not answer).

"Live child job", exactly: in the last 4 MiB of the transcript, a `tool_execution_start` entry
written after the last assistant message, with no `toolResult` message for the same
`toolCallId`. These are the calls of the batch the session is waiting on now. A start before
the last assistant message is a call an earlier omp process left open before a restart, and
it does not count.

Why this signal and not the process tree or the subagent transcripts: on 2026-11-02 the root's
`bash` call started at 00:08:09.946Z never wrote a result, and the transcript wrote nothing
more until 01:59:36Z, while two of the lane's pull requests waited for it. An open
call in a still transcript is that incident, read from one file. The root omp's descendants
cannot say it: it always has idle eval kernels and persistent shells, and its in-process
subagents' tool calls are its children too. No subagent wrote a line during that window, so
"subagent transcripts moved" would have stayed quiet through the whole incident.

One exception. `wait` and `task` block on subagents and background jobs by design: in this
session's history 62 calls took 20-39 minutes, `wait` up to its 30-minute cap and `task` up
to 39 minutes. When every open call is one of those two, the watch alerts only when nothing
under the session's directory (subagent transcripts, job logs) changed in the window either:
then the jobs it waits on are not moving and nothing will wake it.

It sends at most one message per stall, of at most 600 characters, naming a report file with
every open call: the state file records the transcript's size and mtime at the alert, and the
next alert needs a transcript that moved and then stalled again. A failed send records nothing,
so the next run tries again. A quiet run reuses the transcript path the state file holds rather
than list every session directory (1,655 of them on sami-rocqperf, 2026-11-03).

It never signals, stops or restarts any process. The box-health owner decides what to do.

Exit status: 0 for a quiet run or a sent alert, 1 when no session or transcript is found or the
send failed.
"""

from __future__ import annotations

import argparse
import json
import os
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

DEFAULT_ROLE = "lead-rocq-speed"  # the Rocq speed stream's lead (SPEEDCOACH), whose hang made this watch
DEFAULT_TO = "notifications.role.lead-box-health"
DEFAULT_ENVOY_URL = "http://127.0.0.1:9020"
SESSIONS_ROOT = Path.home() / ".omp" / "agent" / "sessions"
STATE_DIR = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local" / "state") / "omp-root-hang-watch"
ENVOY = Path(__file__).resolve().parent / "envoy"
TAIL_BYTES = 4 << 20
BLOCKING_TOOLS = frozenset({"wait", "task"})
MESSAGE_LIMIT = 600
REPORT_DAYS = 7


def log(message: str) -> None:
    print(message, flush=True)


def find_transcript(root: Path, session: str) -> Path | None:
    """The session's own transcript: `<root>/<cwd dir>/<time>_<session>.jsonl`, newest first."""
    found = sorted(root.glob(f"*/*_{session}.jsonl"), key=lambda p: p.stat().st_mtime, reverse=True)
    return found[0] if found else None


def envoy_sessions() -> list[dict] | None:
    """Envoy's live sessions (GET /v1/sessions, a pure read), or None when Envoy does not answer."""
    path = os.environ.get("ENVOY_CONFIG_FILE") or str(
        Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "legion/envoy.json"
    )
    try:
        config = json.loads(Path(path).read_text()).get("envoy") or {}
    except (OSError, ValueError):
        config = {}
    url = (os.environ.get("ENVOY_URL") or config.get("url") or DEFAULT_ENVOY_URL).rstrip("/")
    token = os.environ.get("ENVOY_TOKEN") or config.get("token") or ""
    if token.startswith("!"):
        try:
            done = subprocess.run(["/bin/sh", "-c", token[1:]], capture_output=True, text=True, timeout=10,
                                  stdin=subprocess.DEVNULL)
            token = done.stdout.strip() if done.returncode == 0 else ""
        except (OSError, subprocess.SubprocessError):
            token = ""
    request = urllib.request.Request(url + "/v1/sessions")
    if token:
        request.add_header("Authorization", f"Bearer {token}")
    try:
        with urllib.request.urlopen(request, timeout=10) as answer:
            sessions = json.loads(answer.read())
    except (urllib.error.URLError, OSError, ValueError) as error:
        log(f"Envoy at {url} did not list its sessions: {error}")
        return None
    return sessions if isinstance(sessions, list) else None


def role_holder(sessions: list[dict], role: str) -> str:
    """The live session holding `role`, the most recently seen when Envoy lists more than one."""
    holders = [s for s in sessions if role in (s.get("roles") or []) and s.get("session_id")]
    return max(holders, key=lambda s: s.get("last_seen") or 0)["session_id"] if holders else ""


def open_calls(transcript: Path) -> list[dict]:
    """Tool calls of the current batch that have no result yet."""
    size = transcript.stat().st_size
    with transcript.open("rb") as handle:
        handle.seek(max(0, size - TAIL_BYTES))
        lines = handle.read().split(b"\n")
    if size > TAIL_BYTES:
        lines = lines[1:]  # the first line of the window is a partial line
    starts: dict[str, dict] = {}
    for raw in lines:
        if not raw.strip():
            continue
        try:
            entry = json.loads(raw)
        except ValueError:
            continue
        if entry.get("type") == "custom" and entry.get("customType") == "tool_execution_start":
            data = entry.get("data") or {}
            call = data.get("toolCallId")
            if call:
                starts[call] = {
                    "id": call,
                    "tool": data.get("toolName", "?"),
                    "started": data.get("startedAt") or entry.get("timestamp", "?"),
                    "intent": data.get("intent") or "",
                }
        elif entry.get("type") == "message":
            message = entry.get("message") or {}
            if message.get("role") == "assistant":
                starts.clear()
            elif message.get("role") == "toolResult":
                starts.pop(message.get("toolCallId"), None)
    return list(starts.values())


def newest_change(directory: Path, since: float) -> Path | None:
    """The first file under `directory` changed after `since`, or None."""
    for parent, _dirs, files in os.walk(directory):
        for name in files:
            path = Path(parent) / name
            try:
                if path.stat().st_mtime > since:
                    return path
            except OSError:
                continue
    return None


def root_pids(session: str) -> list[int]:
    """Live omp processes whose command line names the session (`omp --resume <id>`)."""
    pids = []
    for entry in Path("/proc").iterdir():
        if not entry.name.isdigit():
            continue
        try:
            argv = (entry / "cmdline").read_bytes().split(b"\0")
        except OSError:
            continue
        if argv and Path(argv[0].decode(errors="replace")).name == "omp" and any(
            session.encode() in arg for arg in argv[1:]
        ):
            pids.append(int(entry.name))
    return sorted(pids)


def send(target: str, text: str) -> bool:
    """One Envoy message: a session id is a direct send, a topic (a role) a publish."""
    try:
        done = subprocess.run(
            [str(ENVOY), "send", "--source", "envoy", "--message-file", "-", target],
            input=text, capture_output=True, text=True, timeout=60,
        )
    except (OSError, subprocess.SubprocessError) as error:
        log(f"send to {target} failed: {error}")
        return False
    if done.returncode != 0:
        log(f"send to {target} failed: exit {done.returncode}: {(done.stderr or done.stdout).strip()}")
    return done.returncode == 0


def utc(epoch: float) -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(epoch))


def describe(call: dict) -> str:
    return f"{call['tool']} started {call['started']}" + (f" ({call['intent']})" if call["intent"] else "")


def write_report(directory: Path, text: str, now: float) -> str:
    """One report file under `directory`, and those older than REPORT_DAYS removed; its path."""
    path = directory / f"{time.strftime('%Y%m%dT%H%M%SZ', time.gmtime(now))}-hang.txt"
    try:
        directory.mkdir(parents=True, exist_ok=True)
        path.write_text(text)
    except OSError as error:
        log(f"report {path} not written: {error}")
        return f"none ({path} not written: {error.strerror or error})"
    for old in directory.glob("*.txt"):
        try:
            if old.stat().st_mtime < now - REPORT_DAYS * 86400:
                old.unlink()
        except OSError:
            continue
    return str(path)


def fit(items: list[str], room: int) -> str:
    """As many of `items` as fit in `room` characters, then how many more there are; "" if none fits."""
    shown: list[str] = []
    for i, item in enumerate(items):
        more = len(items) - i - 1
        if len("; ".join(shown + [item]) + (f"; and {more} more" if more else "")) > room:
            break
        shown.append(item)
    if not shown:
        return ""
    more = len(items) - len(shown)
    return "; ".join(shown) + (f"; and {more} more" if more else "")


def alert_text(session: str, who: str, mtime: float, now: float, calls: list[dict], pids: list[int],
               report: str) -> str:
    """At most MESSAGE_LIMIT characters: what, whose, since when, which calls, and the report."""
    minutes = int((now - mtime) // 60)
    process = (f"omp process {', '.join(map(str, pids))} is alive" if pids
               else "no omp process names this session on its command line")
    head = (f"ROOT SESSION HANG: session {session} ({who}) wrote no transcript line for {minutes} min"
            f" (last at {utc(mtime)}). It waits on a tool call with no result: ")
    rest = (f". {process}. This watch did not stop or restart anything: look at the session's pane or"
            f" send it an Envoy message, and decide. One message per stall, from {socket.gethostname()}. ")
    tail = f"Full report: {report}"
    room = MESSAGE_LIMIT - len(head) - len(rest) - len(tail)
    # Each call with its intent while they fit; else without it; else only how many.
    listed = (fit([describe(c) for c in calls], room)
              or fit([f"{c['tool']} started {c['started']}" for c in calls], room)
              or f"{len(calls)} calls, listed in the report")
    text = head + listed + rest
    if len(text) > MESSAGE_LIMIT - len(tail):
        text = text[: MESSAGE_LIMIT - len(tail) - 2].rstrip() + "… "
    return text + tail


def report_text(session: str, how: str, transcript: Path, mtime: float, now: float, calls: list[dict],
                pids: list[int]) -> str:
    lines = [
        f"omp-root-hang-watch on {socket.gethostname()}, {utc(now)}: ROOT SESSION HANG.",
        f"Session {session}, found as the {how}.",
        f"Transcript {transcript}: no new line since {utc(mtime)} ({int((now - mtime) // 60)} min).",
        f"Open tool calls of its current batch ({len(calls)}), each with no result:",
    ]
    lines += [f"- {call['id']} {describe(call)}" for call in calls]
    lines += [
        f"Root omp process: {', '.join(map(str, pids))}" if pids
        else "Root omp process: none names this session on its command line.",
        "",
        "This watch never signals, stops or restarts a process. To decide: look at the session's tmux pane,"
        f" read the transcript's last lines (`tail -n 5 {transcript}`), or send the session an Envoy message"
        f" (`envoy send {session} '...'`). A `wait` or `task` call counts only when nothing under"
        f" {transcript.with_suffix('')} changed in the window either.",
        "One message per stall: the next one needs the transcript to move and then stall again.",
    ]
    return "\n".join(lines) + "\n"


def write_state(path: Path, state: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(state) + "\n")
    tmp.replace(path)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--role", default=DEFAULT_ROLE, help="Envoy role whose holder's root session is watched")
    parser.add_argument("--session", default="", help="watch this root session id instead of the role's holder")
    parser.add_argument("--to", default=DEFAULT_TO, help="Envoy topic or session id that gets the alert")
    parser.add_argument("--stale-minutes", type=float, default=30.0)
    parser.add_argument("--sessions-root", type=Path, default=SESSIONS_ROOT)
    parser.add_argument("--state", type=Path, default=None,
                        help="default: $XDG_STATE_HOME/omp-root-hang-watch/role-<role>.json, or <session>.json")
    parser.add_argument("--dry-run", action="store_true", help="print the alert; send nothing, write no state")
    options = parser.parse_args(argv)

    state_path = options.state or STATE_DIR / (f"{options.session}.json" if options.session else f"role-{options.role}.json")
    window = options.stale_minutes * 60
    now = time.time()
    try:
        state = json.loads(state_path.read_text())
    except (OSError, ValueError):
        state = {}

    if options.session:
        session, how = options.session, "session named by --session"
    else:
        sessions = envoy_sessions()
        session = role_holder(sessions or [], options.role)
        how = f"holder of Envoy role {options.role}"
        if not session and state.get("holder"):
            session = state["holder"]
            how = (f"last holder of Envoy role {options.role} this watch saw: Envoy lists no holder now"
                   + ("" if sessions is not None else " (Envoy did not answer)"))
        if not session:
            log(f"FAIL: no session holds Envoy role {options.role}, and this watch has seen none")
            return 1
    if state.get("holder") != session:
        state = {"holder": session}  # another session: its stall key and its transcript are not this one's

    cached = Path(state["transcript"]) if state.get("transcript") else None
    transcript = (cached if cached and cached.is_file() and cached.name.endswith(f"_{session}.jsonl")
                  and cached.is_relative_to(options.sessions_root) else None)
    if transcript is None:
        transcript = find_transcript(options.sessions_root, session)
    if transcript is None:
        log(f"FAIL: no transcript *_{session}.jsonl under {options.sessions_root}/*/")
        return 1
    stat = transcript.stat()
    if now - stat.st_mtime >= window and transcript == cached:
        # About to judge a stall: a newer transcript of the same session is the one to read.
        newest = find_transcript(options.sessions_root, session)
        if newest is not None and newest != transcript:
            transcript, stat = newest, newest.stat()
    state["transcript"] = str(transcript)
    age = now - stat.st_mtime

    def quiet(reason: str) -> int:
        log(f"quiet: {reason}")
        if not options.dry_run:
            write_state(state_path, state)
        return 0

    if age < window:
        return quiet(f"transcript moved {int(age)} s ago ({transcript.name})")
    calls = open_calls(transcript)
    if not calls:
        return quiet(f"transcript still for {int(age // 60)} min, but no tool call is open (session is idle)")
    if all(c["tool"] in BLOCKING_TOOLS for c in calls):
        moved = newest_change(transcript.with_suffix(""), now - window)
        if moved is not None:
            return quiet(f"open {', '.join(c['tool'] for c in calls)} waits on jobs that still write ({moved})")

    key = f"{stat.st_size}:{stat.st_mtime_ns}"
    if state.get("key") == key:
        return quiet(f"already alerted for this stall (transcript still at {key})")

    pids = root_pids(session)
    who = options.role if how.startswith(("holder", "last holder")) else "--session"
    if options.dry_run:
        log(f"DRY RUN: would send to {options.to}: "
            + alert_text(session, who, stat.st_mtime, now, calls, pids, "(not written in a dry run)"))
        return 0
    report = write_report(state_path.parent / "reports",
                          report_text(session, how, transcript, stat.st_mtime, now, calls, pids), now)
    text = alert_text(session, who, stat.st_mtime, now, calls, pids, report)
    if not send(options.to, text):
        return 1
    state.update(key=key, sent_at=utc(now), to=options.to)
    write_state(state_path, state)
    log(f"ALERT sent to {options.to}: {text}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
