#!/usr/bin/env python3
"""Snapshot tmux workspace: capture pane state and omp session IDs.

Non-destructive: reads each omp pane's session from the session file the omp
process holds open (on the host, or inside an agent box), the same way
tmux-resurrect-omp does, instead of interrupting running sessions.
"""

from __future__ import annotations

import datetime as dt
import importlib.machinery
import importlib.util
import json
import os
import socket
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path

# Session lookup is tmux-resurrect-omp's: find_omp/open_session for host panes,
# box_sessions for panes running in an agent box.
_loader = importlib.machinery.SourceFileLoader(
    "tmux_resurrect_omp", str(Path(__file__).resolve().parent / "tmux-resurrect-omp")
)
_spec = importlib.util.spec_from_loader(_loader.name, _loader)
omp_sessions = importlib.util.module_from_spec(_spec)
sys.modules[_spec.name] = omp_sessions
_loader.exec_module(omp_sessions)


@dataclass
class Pane:
    pane_id: str
    pane_pid: int
    window_index: int
    window_name: str
    pane_index: int
    cwd: str
    command: str
    title: str


def eprint(message: str = "") -> None:
    print(message, file=sys.stderr)


def run_tmux(*args: str) -> str:
    proc = subprocess.run(
        ["tmux", *args],
        check=True,
        capture_output=True,
        text=True,
    )
    return proc.stdout


def get_tmux_session_name() -> str:
    output = run_tmux("display-message", "-p", "#S")
    return output.strip()


def list_panes_for_session(tmux_session: str, own_pane_id: str | None) -> list[Pane]:
    separator = "\x1f"
    fmt = separator.join(
        [
            "#{pane_id}",
            "#{pane_pid}",
            "#{window_index}",
            "#{window_name}",
            "#{pane_index}",
            "#{pane_current_path}",
            "#{pane_current_command}",
            "#{pane_title}",
        ]
    )
    output = run_tmux("list-panes", "-s", "-t", tmux_session, "-F", fmt)

    panes: list[Pane] = []
    for line in output.splitlines():
        if not line.strip():
            continue
        parts = line.split(separator)
        if len(parts) != 8:
            eprint(f"warning: unable to parse pane metadata row: {line!r}")
            continue

        pane_id, pane_pid, window_index, window_name, pane_index, cwd, command, title = parts
        if own_pane_id and pane_id == own_pane_id:
            continue

        try:
            pane = Pane(
                pane_id=pane_id,
                pane_pid=int(pane_pid),
                window_index=int(window_index),
                window_name=window_name,
                pane_index=int(pane_index),
                cwd=cwd,
                command=command,
                title=title,
            )
            panes.append(pane)
        except ValueError as exc:
            eprint(f"warning: invalid pane metadata for {pane_id}: {exc}")

    panes.sort(key=lambda p: (p.window_index, p.pane_index))
    return panes


def launcher_spec(pane_pid: int) -> str | None:
    """What an `agentbox new <spec> -- …` launcher under the pane was given before `--`."""
    frontier = [pane_pid]
    for _ in range(omp_sessions.MAX_DEPTH):
        next_frontier: list[int] = []
        for pid in frontier:
            try:
                argv = Path(f"/proc/{pid}/cmdline").read_bytes().replace(b"\0", b" ").decode()
            except OSError:
                argv = ""
            m = omp_sessions.LAUNCH_SPEC.search(argv)
            if m:
                return m.group("spec")
            next_frontier += omp_sessions.children(pid)
        frontier = next_frontier
    return None


def find_session(pane: Pane, boxed: dict[str, tuple[str, str]] | None) -> tuple[str, str | None] | None:
    """(session id, agentbox spec or None) of the omp session running in the pane."""
    omp = omp_sessions.find_omp(pane.pane_pid)
    if omp is not None:
        sid = omp_sessions.open_session(omp)
        if sid:
            return sid, None
    if boxed and pane.pane_id in boxed:
        repo, sid = boxed[pane.pane_id]
        return sid, launcher_spec(pane.pane_pid) or repo
    return None


def build_snapshot(panes: list[Pane], tmux_session: str) -> dict[str, object]:
    boxed: dict[str, tuple[str, str]] | None = None
    try:
        boxed = omp_sessions.box_sessions()
    except (OSError, subprocess.SubprocessError) as exc:
        eprint(f"warning: agent boxes not checked: {exc}")

    pane_entries: list[dict[str, object]] = []
    matched = 0
    for pane in panes:
        ai_session: dict[str, str] | None = None
        found = find_session(pane, boxed)
        if found:
            sid, spec = found
            ai_session = {
                "type": "omp",
                "session_id": sid,
                "title": pane.title,
                "resume_cmd": omp_sessions.resume_command(spec, sid),
            }
            matched += 1
        elif pane.command == "omp":
            eprint(f"warning: omp in pane {pane.pane_id} has no session file open yet")

        pane_entries.append(
            {
                "window_index": pane.window_index,
                "window_name": pane.window_name,
                "pane_index": pane.pane_index,
                "cwd": pane.cwd,
                "command": pane.command,
                "ai_session": ai_session,
            }
        )

    eprint(f"Matched {matched} omp session(s) to panes")

    captured_at = dt.datetime.now(dt.timezone.utc).replace(microsecond=0).isoformat()
    captured_at = captured_at.replace("+00:00", "Z")

    return {
        "version": 1,
        "captured_at": captured_at,
        "hostname": socket.gethostname(),
        "tmux_session": tmux_session,
        "panes": pane_entries,
    }


def write_snapshot(snapshot: dict[str, object]) -> Path:
    output_dir = Path.home() / ".dotfiles" / ".tmux-workspace"
    output_dir.mkdir(parents=True, exist_ok=True)

    serialized = json.dumps(snapshot, indent=2)

    # Save per-session snapshot (multi-session safe)
    session_name = snapshot.get("tmux_session", "unknown")
    session_path = output_dir / f"snapshot-{session_name}.json"
    session_path.write_text(serialized + "\n", encoding="utf-8")

    # Also save as latest (backwards compatible with tmux-restore)
    latest_path = output_dir / "snapshot.json"
    latest_path.write_text(serialized + "\n", encoding="utf-8")

    return session_path


def main() -> int:
    # When run via tmux run-shell (hooks/cron), TMUX env isn't set
    # but tmux commands still work. Only bail if tmux server is unreachable.
    if "TMUX" not in os.environ:
        try:
            run_tmux("display-message", "-p", "")
        except (subprocess.CalledProcessError, FileNotFoundError):
            eprint("error: tmux server not reachable")
            return 1

    own_pane_id = os.environ.get("TMUX_PANE")
    try:
        tmux_session = get_tmux_session_name()
        panes = list_panes_for_session(tmux_session, own_pane_id)
        eprint(f"Snapshotting tmux session: {tmux_session}")
        eprint(f"Found {len(panes)} pane(s)")
        snapshot = build_snapshot(panes, tmux_session)
        output_path = write_snapshot(snapshot)
        eprint(f"Saved to {output_path}")
        return 0
    except subprocess.CalledProcessError as exc:
        stderr = exc.stderr.strip() if exc.stderr else str(exc)
        eprint(f"error: tmux command failed: {stderr}")
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
