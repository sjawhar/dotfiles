#!/usr/bin/env bash
# Claude Code launcher: `cld [--profile NAME] [claude args...]`.
#
# Picks the Claude Code profile and its model route, then execs claude through
# scripts/agent-session, the session environment every agent launcher shares (the
# gh-app routing include, shims-first PATH, the secrets-broker identity).
set -euo pipefail

# --- profile: CLAUDE_CONFIG_DIR is Claude Code's own profile, with its own login ---
# --profile NAME uses .claude-profiles/NAME and links _shared into it; no flag keeps an inherited
# CLAUDE_CONFIG_DIR, else .claude. _shared: what .gitignore tracks under .claude, plus skills,
# output-styles and plugins.
_canonical="${DOTFILES_DIR:-$HOME/.dotfiles}/.claude"
_shared=(CLAUDE.md AGENTS.md settings.json mcp.json agents commands hooks project-instructions
    skills output-styles plugins)
_args=()
_profile=""
_profile_given=""
while (($#)); do
    case "$1" in
        --profile=*) _profile="${1#--profile=}" _profile_given=1; shift ;;
        --profile)
            if (($# < 2)); then
                echo "cld: --profile needs a name" >&2
                exit 2
            fi
            _profile="$2" _profile_given=1
            shift 2
            ;;
        *) _args+=("$1"); shift ;;
    esac
done
if [[ -z "$_profile_given" ]]; then
    export CLAUDE_CONFIG_DIR="${CLAUDE_CONFIG_DIR:-$_canonical}"
elif [[ -z "$_profile" || "$_profile" == default ]]; then
    export CLAUDE_CONFIG_DIR="$_canonical"
else
    if ! [[ "$_profile" =~ ^[A-Za-z0-9_][A-Za-z0-9._-]*$ ]]; then
        echo "cld: invalid profile name: $_profile (letters, digits, '.', '-', '_'; not starting with '.')" >&2
        exit 2
    fi
    export CLAUDE_CONFIG_DIR="${DOTFILES_DIR:-$HOME/.dotfiles}/.claude-profiles/$_profile"
    (umask 077 && mkdir -p "$CLAUDE_CONFIG_DIR")
    for _n in "${_shared[@]}"; do
        [[ -e "$_canonical/$_n" ]] || continue
        [[ -e "$CLAUDE_CONFIG_DIR/$_n" || -L "$CLAUDE_CONFIG_DIR/$_n" ]] \
            || ln -s "$_canonical/$_n" "$CLAUDE_CONFIG_DIR/$_n"
    done
    unset _n
fi
# --- model route: the profile's own cld-settings.json, else the trajectory profile's Hawk gateway ---
# A profile's cld-settings.json is machine-local and never committed (.gitignore drops it with the
# rest of the profile's state): it names the keys that machine has, like omp's models.local.yml,
# e.g. {"apiKeyHelper": "secrets get --value <KEY>"}. A profile with neither keeps its own login.
_settings=()
if [[ -f "$CLAUDE_CONFIG_DIR/cld-settings.json" ]]; then
    _settings=(--settings "$CLAUDE_CONFIG_DIR/cld-settings.json")
elif [[ "$CLAUDE_CONFIG_DIR" == "${DOTFILES_DIR:-$HOME/.dotfiles}/.claude-profiles/trajectory" ]]; then
    # Sami's previous job reaches Anthropic through its Hawk gateway. apiKeyHelper re-runs
    # scripts/hawk-token at start, every five minutes and on a 401; each run mints a token with a
    # fresh jti, which is what the gateway's exchanged-once rule needs
    # (agent-c docs/onboarding/model-access-clients.md).
    _settings=(--settings "$(printf '{"apiKeyHelper":"%s","env":{"ANTHROPIC_BASE_URL":"%s"}}' \
        "${DOTFILES_DIR:-$HOME/.dotfiles}/scripts/hawk-token" \
        "https://middleman.hawk.internal.trajectorylabs.com/anthropic")")
fi
unset _canonical _shared _profile _profile_given

# No Envoy or Dispatch variable is set here: the claude-envoy bridge reads the
# profile's envoy.json (envoy/AGENTS.md), and a variable exported here would
# override that file for every profile.
# Opt the session into the Envoy channel plugin (managed settings allowlist the
# legion-plugins marketplace); channel events reach the model as <channel> messages.
exec "${DOTFILES_DIR:-$HOME/.dotfiles}/scripts/agent-session" \
    claude --dangerously-skip-permissions --channels plugin:claude-envoy@legion-plugins \
    ${_settings[@]+"${_settings[@]}"} "${_args[@]}"
