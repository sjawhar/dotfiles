#!/usr/bin/env bash
# Claude Code launcher: `cld [--profile NAME] [claude args...]`.
#
# Loads gh-app-routes.gitconfig for the agent session so git push and gh CLI
# authenticate as the GitHub App installation for the target repo's owner;
# owners without an installation get the upstream token from the secrets store.
# Mirrors the env setup in scripts/oc. Private key is fetched lazily by the
# gh-app-token helper via `secrets get`.
set -euo pipefail

# --- profile: which Claude config dir, so which login bills the session ---
# CLAUDE_CONFIG_DIR is Claude Code's own profile mechanism: each dir keeps its own login (a
# claude.ai subscription, or an Anthropic Console account and the API key it mints), history,
# sessions, and the org's policy files (policy-limits.json, remote-settings.json).
# `--profile NAME` runs under ${DOTFILES_DIR}/.claude-profiles/NAME, created on first use;
# `default` (or an empty name) is the canonical ${DOTFILES_DIR}/.claude. Without the flag an
# inherited CLAUDE_CONFIG_DIR wins, so a claude started from inside a profiled session stays
# in that profile. A profile shares the canonical user configuration through symlinks: the
# entries in _shared and only those, so a state file a new Claude Code release adds stays
# per-profile instead of carrying one account's login or org policy into another. Entries
# already in the profile are left alone. The environment is not touched: an ANTHROPIC_API_KEY
# the caller exported outranks the profile's login, and Claude Code asks before using it.
_canonical="${DOTFILES_DIR:-$HOME/.dotfiles}/.claude"
_shared=(CLAUDE.md settings.json agents commands skills output-styles plugins)
_args=()
_profile=""
_profile_given=""
while (($#)); do
    case "$1" in
        --profile=*) _profile="${1#--profile=}" _profile_given=1; shift ;;
        --profile)
            if (($# < 2)); then
                echo "cld: --profile needs a name" >&2
                exit 2
            fi
            _profile="$2" _profile_given=1
            shift 2
            ;;
        *) _args+=("$1"); shift ;;
    esac
done
if [[ -z "$_profile_given" ]]; then
    export CLAUDE_CONFIG_DIR="${CLAUDE_CONFIG_DIR:-$_canonical}"
elif [[ -z "$_profile" || "$_profile" == default ]]; then
    export CLAUDE_CONFIG_DIR="$_canonical"
else
    if ! [[ "$_profile" =~ ^[A-Za-z0-9_][A-Za-z0-9._-]*$ ]]; then
        echo "cld: invalid profile name: $_profile (letters, digits, '.', '-', '_'; not starting with '.')" >&2
        exit 2
    fi
    export CLAUDE_CONFIG_DIR="${DOTFILES_DIR:-$HOME/.dotfiles}/.claude-profiles/$_profile"
    (umask 077 && mkdir -p "$CLAUDE_CONFIG_DIR")
    for _n in "${_shared[@]}"; do
        [[ -e "$_canonical/$_n" ]] || continue
        [[ -e "$CLAUDE_CONFIG_DIR/$_n" || -L "$CLAUDE_CONFIG_DIR/$_n" ]] \
            || ln -s "$_canonical/$_n" "$CLAUDE_CONFIG_DIR/$_n"
    done
    unset _n
fi
unset _canonical _shared _profile _profile_given

# --- gh-app routing config (per-repo credential routing for git+gh) ---
# Agents authenticate as the GitHub App installation matching each repo's
# owner; owners without an installation get the upstream token from the
# secrets store (gh-app.agent.fallback-secret), never your keyring login.
# Only loaded by agent shells; interactive shells are unaffected.
# See gh-app-routes.gitconfig and shims/gh-app-token.
GIT_CONFIG_COUNT=$((${GIT_CONFIG_COUNT:-0} + 1))
_idx=$((GIT_CONFIG_COUNT - 1))
export GIT_CONFIG_COUNT
export "GIT_CONFIG_KEY_${_idx}"=include.path
export "GIT_CONFIG_VALUE_${_idx}"="${DOTFILES_DIR:-$HOME/.dotfiles}/gh-app-routes.gitconfig"
unset _idx

# Envoy NATS defaults to the tailnet host; a box that runs its own single-node
# envoy overrides it in the gitignored envoy/env.local (shims/omp sources the
# same file).
if [ -r "${DOTFILES_DIR:-$HOME/.dotfiles}/envoy/env.local" ]; then
    # shellcheck disable=SC1091  # machine-local, absent in the repo
    . "${DOTFILES_DIR:-$HOME/.dotfiles}/envoy/env.local"
fi
export ENVOY_NATS_URL="${ENVOY_NATS_URL:-nats://envoy-nats:4222}"

# Envoy NATS credential for the claude-envoy bridge: the `omp-session` nkey
# seed's per-boot 0600 file, when there is one (scripts/envoy-nats-seed). A seed
# the caller already gave wins. Mirrors shims/omp.
if [[ -z "${NATS_NKEY_SEED_FILE:-}" && -z "${NATS_NKEY_SEED:-}" ]]; then
    _seed_file="$("${DOTFILES_DIR:-$HOME/.dotfiles}/scripts/envoy-nats-seed")" || _seed_file=""
    if [[ -n "$_seed_file" ]]; then
        export NATS_NKEY_SEED_FILE="$_seed_file"
    fi
    unset _seed_file
fi

# --- dotfiles shims must lead PATH ---
# The gh App routing above only works when `gh` resolves to shims/gh. The
# launching shell's mise hook may have prepended tool install dirs (including
# the real gh) ahead of the shims; agent sessions inherit PATH forever, so
# re-front the shims here or agents silently act as the user on GitHub.
_newpath=""
IFS=':' read -ra _parts <<< "$PATH"
for _p in "${_parts[@]}"; do
    [ -n "$_p" ] && [ "$_p" != "${DOTFILES_DIR:-$HOME/.dotfiles}/shims" ] && _newpath="${_newpath:+$_newpath:}$_p"
done
export PATH="${DOTFILES_DIR:-$HOME/.dotfiles}/shims:$_newpath"
unset _newpath _parts _p

# Host session identity for agent secrets: claude runs as a registered session of the
# agent-secrets helper where that applies (scripts/agent-secrets-session, the same wrapper as
# shims/omp and scripts/oc).
# Opt the session into the Envoy channel plugin (managed settings allowlist the
# legion-plugins marketplace); channel events reach the model as <channel> messages.
exec "${DOTFILES_DIR:-$HOME/.dotfiles}/scripts/agent-secrets-session" \
    claude --dangerously-skip-permissions --channels plugin:claude-envoy-bridge@legion-plugins "${_args[@]}"
