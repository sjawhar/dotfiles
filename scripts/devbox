#!/bin/bash
# devbox — connect to the devbox or oryx by mosh.
#
# The devbox pair's YubiKey path is forward's PC/SC channel. The tunnel
# machinery below serves oryx only: it lets oryx decrypt sops human-tier
# secrets with the YubiKey plugged into this laptop. Mosh can't carry SSH
# forwards, so the tunnel is a separate background ssh held by a dedicated
# control socket — created here on demand. A reconnect supervisor (below) then
# keeps it alive across laptop sleep and Wi-Fi changes for the lifetime of this
# login session; after a logout or reboot, run `devbox oryx` once to restart it.
#
# CRITICAL: The oryx tunnel MUST be created from an active local session (a
# terminal on the laptop). If started from a non-interactive SSH session (e.g.
# by an agent over SSH), the ssh process lives in an SSH session scope that goes
# inactive, and polkit blocks pcscd access with 'Process is NOT authorized for
# action: access_pcsc', while the TCP half of the forward keeps working. The
# tunnel looks healthy but YubiKey decryption silently fails. If an agent
# created a stale tunnel, kill it explicitly:
# `ssh -O exit oryx-tunnel`, then run `devbox oryx` from a terminal.
#
# The supervisor is intentionally session-scoped: it stops when that login
# session ends and only reconnects while loginctl shows the session active, so
# it cannot recreate the inactive-session failure described above.
#
# Args pass through to mosh, e.g.: devbox -- tm
# Targets: bare `devbox` is the EC2 devbox; `devbox oryx` is the oryx laptop.
# Only oryx uses a Host oryx-tunnel block in ssh config and a supervisor.
set -euo pipefail

if [[ "${1:-}" == --tunnel-supervisor ]]; then
    supervisor=1
    target="${2:?--tunnel-supervisor needs a target}"
else
    supervisor=0
    target=devbox
    case "${1:-}" in devbox|oryx) target="$1"; shift ;; esac
fi
if [[ "$target" != devbox ]]; then
    tunnel_host="${target}-tunnel"
    readonly tunnel_control="$(ssh -G "$tunnel_host" | awk '/^controlpath /{print $2}')"
    readonly supervisor_lock=~/.ssh/sockets/devbox-tunnel-supervisor-${target}.lock
    readonly supervisor_log=~/.ssh/sockets/devbox-tunnel-supervisor-${target}.log

    if [[ "$supervisor" == 1 ]]; then
        # One supervisor per laptop: the lock holder is it, everyone else leaves.
        exec 9>"$supervisor_lock"
        flock -n 9 || exit 0
        : > "$supervisor_log"
        while true; do
            # ssh's own keepalives (ServerAlive 15x3) declare a dead network in
            # ~45s and release the control socket; this loop then rebuilds. The
            # target-side sshd reaps a dead session's 12799 listener in ~45s too,
            # so a failed rebuild here is just retried on the next tick.
            sleep 15
            if [[ -n "${XDG_SESSION_ID:-}" ]]; then
                state=$(loginctl show-session "$XDG_SESSION_ID" --property State --value 2>/dev/null) \
                    || { printf '%s session gone; exiting\n' "$(date -Is)" >> "$supervisor_log"; exit 0; }
                # Not active (mid-suspend, VT switch): a tunnel built now would be
                # refused by pcscd anyway, so wait for the session to come back.
                [[ "$state" == active ]] || continue
            fi
            ssh -O check "$tunnel_host" 2>/dev/null && continue
            rm -f "$tunnel_control"
            if ssh -N -f "$tunnel_host" 2>>"$supervisor_log"; then
                printf '%s tunnel reconnected\n' "$(date -Is)" >> "$supervisor_log"
            fi
        done
    fi

    if ! ssh -O check "$tunnel_host" 2>/dev/null; then
        # Dead or stale control socket — clear it so we don't spawn a masterless dup.
        rm -f "$tunnel_control"
        echo "${target}: starting YubiKey tunnel..." >&2
        # -f backgrounds only after the forward is up (ExitOnForwardFailure).
        # stderr goes to a file, not a pipe: the backgrounded child keeps the fd,
        # and a pipe would make command substitution block for the tunnel's life.
        tunnel_err=$(mktemp)
        if ! ssh -N -f "$tunnel_host" 2>"$tunnel_err"; then
            cat "$tunnel_err" >&2
            if grep -q "remote port forwarding failed" "$tunnel_err"; then
                cat >&2 <<MSG

${target}: port 12799 on ${target} is still held by the previous tunnel's dying
session. The tunnel rides the target's real sshd (port 2222), which reaps a
dead session in ~45s — wait a minute and re-run \`devbox ${target}\`. If it
STILL fails, something else grabbed 12799 on ${target}; look with:

  ssh ${target} 'sudo ss -lntp sport = :12799'
MSG
            fi
            rm -f "$tunnel_err"
            exit 1
        fi
        rm -f "$tunnel_err"
    fi

    # Spawn the reconnect supervisor in its own process session, detached from this
    # terminal (no SIGHUP when it closes) but still inside this logind session's
    # scope, which is what keeps pcscd authorizing it. flock makes re-runs no-ops.
    setsid "$0" --tunnel-supervisor "$target" < /dev/null > /dev/null 2>&1 &
fi

exec mosh "$target" "$@"
