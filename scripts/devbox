#!/bin/bash
# devbox — open a session on a machine: devbox <host> [-- command].
#
# `oryx` goes through Cloudflare Access with ssh and tmux. It does not use mosh.
# Other hosts use mosh over the tailnet. Bare `devbox` lists the Linux machines
# online on the tailnet. Arguments after another host pass through to mosh, for
# example: devbox sami-rocqperf -- tm
set -euo pipefail

usage() {
    echo "usage: devbox <host> [-- command]" >&2
    echo "oryx uses Cloudflare Access with ssh and tmux, not mosh." >&2
    echo "Linux machines online on the tailnet (other hosts):" >&2
    tailscale status --json \
        | jq -r '.Peer[] | select(.Online and .OS == "linux") | .DNSName | split(".")[0]' \
        | sort | sed 's/^/  /' >&2
    exit 2
}

target="${1:-}"
[[ -n "$target" && "$target" != -* ]] || usage
shift

if [[ "$target" == oryx ]]; then
    if [[ "${1:-}" == -- ]]; then
        shift
    fi
    if (( $# )); then
        exec ssh -t oryx "$@"
    fi
    exec ssh -t oryx tmux attach -t main '||' tmux new -s main
fi

exec mosh "$target" "$@"
