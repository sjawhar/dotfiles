#!/usr/bin/env python3
"""gh-approved-post --log FILE -- <gh argv…>: check the Dispatch ask a post as Sami cites.

shims/gh runs this in an agent session when a call carries GH_SHIM_APPROVAL, a Dispatch ask
reference (dispatch://KEY/ask/<id>), before the call goes on. Exit 0 lets the call run on its
usual route, which for an owner without the GitHub App is Sami's own upstream token
(GH_PUBLIC_REPO_PAT, login sjawhar), and with a GH_TOKEN from the broker is that token. Exit 1
refuses it, and stderr says why.

His rule (CLAUDE.md): anything that commits him outside the company is drafted, shown to him,
then sent; his answer to the draft is the permission to send it. On 2026-11-02 he answered
dispatch://OSSV-232/ask/a7d1ac41-45c4-4504-a985-7c92998d2158 "Post it" and the post still did
not go out. The call passes only when all of these hold:
  - the call is `gh issue create`, `gh issue comment`, `gh pr comment` or `gh pr create`, with the
    repository named (-R/--repo, or a GitHub URL as the comment target), the title in -t/--title
    and the body in one of -b/--body or -F/--body-file <file>, a pull request's head in --head
    (not -H, which knives does not read) as <owner>:<branch> where the owner is one of
    APPROVER_FORK_OWNERS (his own forks) and its base, if named, in -B/--base, and no other flag, so
    what is checked is all that is posted;
  - the ask exists, is answered by APPROVER, and its one selected option approves (its label
    starts with an approving word and is not a "do not" option);
  - the draft, in the version of the ask's document that first shows the answer (else in the
    ask's own question), names the repository, and holds the posted body, exactly, between two
    `---` lines; for an issue or a pull request, a `Title: <title>` line before them gives the
    title;
  - or, for an ask KIND_APPROVALS lists by its id, whose answer approves a KIND of post with no
    fixed text (dispatch://INFRA-3412): his answer still says the words the entry reads, the ask
    or its answer names the entry's repository, the call is one of the entry's verbs on that
    repository, and GH_SHIM_VERDICT names the fresh reviewer's verdict on record, a Dispatch
    comment whose first line is `VERDICT: APPROVE at sha256:<SHA-256 of the body as posted>`, with
    a `Title: <title>` line for an issue or a pull request, written by a session that is none of
    this call's (SESSION_VARS). A subagent of the posting session writes to Dispatch as that
    session, so its verdict is refused: the reviewer is another session, such as a Legion
    reviewer. An ask that is not listed approves only the text it showed him.
Every check, passed or refused, appends one JSON line to FILE: who (session, pid, cwd), which ask,
which repository, the title and the body, and for a kind of post what the answer approves and the
verdict that passed.
"""

import hashlib
import html
import json
import os
import re
import shlex
import subprocess
import sys
import time

APPROVER = "sami@theorem.dev"
# APPROVER's GitHub login.
APPROVER_LOGIN = "sjawhar"
# The owners of APPROVER's own forks, one of which a cited pull request's head must name. His forks
# moved from his login to the cybermonklabs organization: on 2026-11-17 `gh api
# repos/sjawhar/oh-my-pi` answered cybermonklabs/oh-my-pi, and the head to post,
# cybermonklabs:upstream/fix-hindsight-recall-cooldown, was refused here. A fixed list, not a lookup
# of where a repository redirects at post time: which owner's branch may go out as him is decided
# in this file, not by whatever GitHub answers when the post runs.
APPROVER_FORK_OWNERS = (APPROVER_LOGIN, "cybermonklabs")
FORK_OWNERS_TEXT = " or ".join(APPROVER_FORK_OWNERS)
APPROVING = re.compile(r"^(post|send|publish|file|open|submit|approve|yes|go)\b", re.I)
NEGATION = re.compile(r"^(do not|don't|dont|no|not|never|hold|wait|skip|cancel)\b|\bnot\b", re.I)
# An option approves a post when one of its clauses opens with an approving verb ("Push the commit
# and post both comments") and nothing in it negates one.
CLAUSES = re.compile(r"\s*(?:,|;|\band\b|\bthen\b)\s*", re.I)


def approves(option: str) -> bool:
    if NEGATION.search(option):
        return False
    return any(APPROVING.match(clause) for clause in CLAUSES.split(option) if clause)


VERBS = {("issue", "create"), ("issue", "comment"), ("pr", "comment"), ("pr", "create")}
CREATES = {"issue create", "pr create"}
# A pattern that must match a whole value ends in `\Z`, never `$`: Python's `$` also matches before
# a final newline, so `o/upstream\n` passed as a repository.
REPO_RE = re.compile(r"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+\Z")
URL_RE = re.compile(r"^https://github\.com/([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)/(?:issues|pull)/\d+")
BRANCH = r"[^\s:~^?*\[\\]+"
HEAD_RE = re.compile(rf"^([A-Za-z0-9-]+):({BRANCH})\Z")
BASE_RE = re.compile(rf"^{BRANCH}\Z")
POST_FLAGS = ("-R", "--repo", "-t", "--title", "-b", "--body", "-F", "--body-file")
PR_FLAGS = ("--head", "-B", "--base")
# Asks whose answer approves a KIND of post, with no fixed text (dispatch://INFRA-3412), by ask id:
# the repository and the verbs the answer is read as approving, and the answer's own words that say
# so. A program cannot read "the Rock repo" as a repository, so the reading is made here, in a
# reviewed change to this file, as APPROVER_FORK_OWNERS is; the check then finds each of `words` in
# his answer and the repository in the ask or the answer, so no entry stands on words he did not
# write. Each post under an entry also needs a fresh reviewer's verdict (check_verdict).
KIND_APPROVALS = {
    # dispatch://BET-422/ask/48d87cd6-f3d0-44d5-9a79-30c8b38f28d0, answered 2026-11-12T19:33:21Z on an
    # ask about rocq-prover/rocq#22456: "The answer is the same every single time for rock. Just open
    # an issue and a PR. And you have to follow the three-step process for anything going to the Rock
    # repo." His three steps end in a fresh reviewer's cut (skill outside-message): the verdict.
    "48d87cd6-f3d0-44d5-9a79-30c8b38f28d0": {
        "repo": "rocq-prover/rocq",
        "verbs": ("issue create", "pr create"),
        "words": ("Just open an issue and a PR.", "anything going to the Rock repo"),
    },
}
VERDICT_REF_RE = re.compile(
    r"^dispatch://[A-Z][A-Z0-9]*-\d+/comment/([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})\Z")
VERDICT_LINE_RE = re.compile(r"^VERDICT: (\S+) at sha256:([0-9a-f]{64})\Z")
# The ids a session runs under; a verdict written by any of them is the poster's own.
SESSION_VARS = ("OMP_SESSION_ID", "DISPATCH_SESSION_ID", "PI_SESSION_ID", "ENVOY_SESSION_ID")


class Refused(Exception):
    pass


class KindRefused(Refused):
    """A refusal of a citation of an ask KIND_APPROVALS lists; `approves` says what it approves."""

    def __init__(self, why: str, approves: str):
        super().__init__(why)
        self.approves = approves


def parse_call(argv: list[str]) -> dict:
    if len(argv) < 2 or (argv[0], argv[1]) not in VERBS:
        raise Refused(
            "a cited post is `gh issue create`, `gh issue comment`, `gh pr comment` or `gh pr create`; "
            f"this call is `gh {' '.join(argv[:2])}`."
        )
    call = {"verb": f"{argv[0]} {argv[1]}", "repo": "", "title": None, "body": None, "target": "",
            "head": "", "base": None}
    flags = POST_FLAGS + (PR_FLAGS if call["verb"] == "pr create" else ())
    rest = argv[2:]
    bodies = set()
    i = 0
    while i < len(rest):
        arg = rest[i]
        name, eq, inline = arg.partition("=") if arg.startswith("--") else (arg, "", "")
        if name == "-H" and call["verb"] == "pr create":
            # knives 3.2.3 (src/commands/gh.rs, has_head_flag) sees only --head, and in a jj
            # checkout it then adds `--head <current bookmark>`, which gh takes over -H.
            raise Refused("write the head as --head <owner>:<branch>, not -H: knives, which routes the "
                          "call, reads only --head, and in a jj checkout it adds its own --head, which "
                          "gh would use instead.")
        if name in flags:
            if eq:
                value = inline
            elif i + 1 < len(rest):
                i += 1
                value = rest[i]
            else:
                raise Refused(f"`{arg}` has no value.")
            if name in ("-R", "--repo"):
                call["repo"] = value
            elif name in ("-t", "--title"):
                call["title"] = value
            elif name in ("-b", "--body"):
                call["body"] = value
                call["sha256"] = hashlib.sha256(value.encode()).hexdigest()
                bodies.add("--body")
            elif name == "--head":
                call["head"] = value
            elif name in ("-B", "--base"):
                call["base"] = value
            else:
                bodies.add("--body-file")
                if value == "-":
                    raise Refused("the body comes from stdin; pass it in a file (--body-file <file>).")
                try:
                    with open(value, "rb") as f:
                        raw = f.read()
                except OSError as e:
                    raise Refused(f"cannot read the body file {value}: {e.strerror}.") from None
                # The SHA-256 of the bytes gh posts; the body as a text file reads it, newlines and all.
                call["sha256"] = hashlib.sha256(raw).hexdigest()
                call["body"] = raw.decode("utf-8").replace("\r\n", "\n").replace("\r", "\n")
        elif arg.startswith("-"):
            raise Refused(
                f"`{arg}` is not checked against the approved draft; a cited post takes only "
                "-R/--repo, -t/--title, -b/--body and -F/--body-file, and a pull request also "
                "--head and -B/--base."
            )
        elif call["verb"] not in CREATES and not call["target"]:
            call["target"] = arg
        else:
            raise Refused(f"unexpected argument `{arg}`.")
        i += 1
    # gh posts a body file over --body whatever their order (gh 2.98.0, pr/create/create.go and
    # issue/create/create.go), so with both the text checked could be the one not posted.
    if len(bodies) == 2:
        raise Refused("pass the body once, with -b/--body or -F/--body-file: given both, gh posts the "
                      "file and drops --body.")
    m = URL_RE.match(call["target"])
    if m and call["repo"] and call["repo"].lower() != m.group(1).lower():
        raise Refused(f"-R {call['repo']} and the target {call['target']} name different repositories.")
    if m and not call["repo"]:
        call["repo"] = m.group(1)
    if not REPO_RE.match(call["repo"]):
        raise Refused("name the repository: -R <owner>/<repo>.")
    if call["verb"] in CREATES and not call["title"]:
        what = "an issue" if call["verb"] == "issue create" else "a pull request"
        raise Refused(f"{what} needs its title in -t/--title.")
    if call["verb"] not in CREATES and not call["target"]:
        raise Refused(f"`gh {call['verb']}` needs the number or URL it comments on.")
    if call["verb"] not in CREATES and call["title"] is not None:
        raise Refused(f"`gh {call['verb']}` takes no title.")
    if call["verb"] == "pr create":
        head = HEAD_RE.match(call["head"])
        if not head:
            raise Refused(
                f"a cited pull request names its head as --head <owner>:<branch>, a branch of one of "
                f"{APPROVER_LOGIN}'s own forks (owner {FORK_OWNERS_TEXT}); this call's head is "
                f"{call['head'] or 'not given'!r}."
            )
        if head.group(1).lower() not in {owner.lower() for owner in APPROVER_FORK_OWNERS}:
            raise Refused(
                f"the head {call['head']} is not a branch of one of {APPROVER_LOGIN}'s own forks; a pull "
                f"request he approved opens from one of them, as --head <owner>:<branch> with the owner "
                f"{FORK_OWNERS_TEXT}."
            )
        if call["base"] is not None and not BASE_RE.match(call["base"]):
            raise Refused(f"the base {call['base']!r} is not a branch name.")
    if not call["body"] or not call["body"].strip():
        raise Refused("the body is empty; pass it with -b/--body or -F/--body-file.")
    return call


def dispatch(*args: str) -> str:
    try:
        out = subprocess.run(["dispatch", *args], capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired) as e:
        raise Refused(f"`dispatch {' '.join(args)}` did not run: {e}.") from None
    if out.returncode != 0:
        first = (out.stderr.strip() or out.stdout.strip()).splitlines()[:1]
        raise Refused(f"`dispatch {' '.join(args)}` failed (exit {out.returncode}): {' '.join(first)}")
    return out.stdout


def parse_ask(text: str) -> dict:
    """The fields of `dispatch read --ref <ask>`, and its document link. The answer is read only
    between the `State:` line and the replies, so text in the question or a reply cannot stand in
    for it."""
    m = re.match(r"Question: (.*?)\nOptions:\n(.*?)\nState: (\S+)\n", text, re.S)
    if not m:
        raise Refused("Dispatch's answer for the citation is not an ask.")
    question, options_text, state = m.groups()
    options = []
    for line in options_text.splitlines():
        if line.startswith("- "):
            # Dispatch prints each option's own block reference after it: `(dispatch://…#b-<id>)`.
            label = re.sub(r" \(dispatch://\S+#b-[^()\s]+\)$", "", line[2:])
            options.append(label.split(" — ", 1)[0].strip())
    ask = {"question": question, "options": options, "state": state, "by": "", "selected": "", "text": "",
           "id": ""}
    after = re.split(r"\n(?:Replies:\n|Node: ask )", text[m.end() - 1:], maxsplit=1)[0]
    asked = re.match(r"\nAsk id: ([0-9a-f-]+)\n", after)
    ask["id"] = asked.group(1) if asked else ""
    answer = re.match(r"\nAsk id: [^\n]*\nAnswer:\n- By: ([^\n]*)\n- Selected: ([^\n]*)(?:\n- Text: (.*))?", after, re.S)
    if answer:
        ask["by"] = answer.group(1).strip()
        ask["selected"] = answer.group(2).strip()
        ask["text"] = (answer.group(3) or "").strip()
    links = text.rsplit("\nLinks:\n", 1)[1] if "\nLinks:\n" in text else ""
    doc = re.search(r"^- anchored_to (?:artifact|spec|document) (dispatch://\S+)", links, re.M)
    nodes = [ln for ln in text.splitlines() if ln.startswith("Node: ask ")]
    part = re.search(r"part of (dispatch://\S+/(?:artifact/[^ @]+|spec)) \(version (\d+)\)", nodes[-1]) if nodes else None
    ask["document"] = doc.group(1) if doc else part.group(1) if part else ""
    ask["first_version"] = int(part.group(2)) if part and part.group(1) == ask["document"] else 1
    return ask


def ask_blocks(doc: str, question: str) -> list[dict]:
    """The attributes of each ask block of the document whose text starts with the ask's question."""
    first = question.splitlines()[0].strip()
    return [
        {k: html.unescape(v) for k, v in re.findall(r'(\w+)="([^"]*)"', m.group(1))}
        for m in re.finditer(r"^:::ask\{([^\n]*)\}\n([^\n]*)", doc, re.M)
        if m.group(2).strip() == first
    ]


def drafts(source: str) -> list[tuple[str | None, str]]:
    """(title, body) for each text between two consecutive `---` lines; the title is the last
    `Title: …` line before that section's opening rule."""
    lines = source.split("\n")
    rules = [i for i, line in enumerate(lines) if line.strip() == "---"]
    found = []
    for a, b in zip(rules, rules[1:]):
        title = None
        for line in reversed(lines[:a]):
            if line.strip() == "---":
                break
            if line.startswith("Title: "):
                title = line[len("Title: "):].strip()
                break
        found.append((title, "\n".join(lines[a + 1:b])))
    return found


def norm(text: str) -> str:
    return "\n".join(line.rstrip() for line in text.replace("\r\n", "\n").split("\n")).strip("\n")


def repo_named(repo: str) -> re.Pattern:
    """A repository named whole: `o/up` is not named by `o/upstream`, nor `o/a` by `o/a.b`."""
    return re.compile(rf"(?<![\w.-]){re.escape(repo)}(?![\w-]|\.\w)", re.I)


def check_kind(ask: dict, kind: dict, call: dict) -> dict:
    """A citation of an ask whose answer approves a kind of post: the answer's words, the
    repository, the kind, and the fresh reviewer's verdict."""
    approves = f"{' and '.join(f'`gh {verb}`' for verb in kind['verbs'])} on {kind['repo']}"

    def refuse(why: str):
        raise KindRefused(why, approves)

    for words in kind["words"]:
        if words not in ask["text"]:
            refuse(f"his answer does not say {words!r}, which KIND_APPROVALS reads as approving {approves}.")
    if not repo_named(kind["repo"]).search(ask["question"] + "\n" + ask["text"]):
        refuse(f"neither the ask nor its answer names {kind['repo']}, which KIND_APPROVALS reads it as approving.")
    if call["repo"].lower() != kind["repo"].lower() or call["verb"] not in kind["verbs"]:
        refuse(f"his answer approves {approves}, and no other post; this call is `gh {call['verb']}` on "
               f"{call['repo']}.")
    review, reviewer = check_verdict(call, refuse)
    return {"approves": approves, "review": review, "reviewer": reviewer}


def check_verdict(call: dict, refuse) -> tuple[str, str]:
    """The fresh reviewer's verdict on record: the Dispatch comment GH_SHIM_VERDICT names, written
    by a session that is not this call's, approving this body and title."""
    ref = os.environ.get("GH_SHIM_VERDICT", "")
    titled = call["verb"] in CREATES
    if not ref:
        refuse("a post of a kind he approved needs a fresh reviewer's verdict on record, from a session "
               "that did not write the text: a Dispatch comment whose first line is `VERDICT: APPROVE at "
               f"sha256:<SHA-256 of the body as posted>`{', with a `Title: <title>` line,' if titled else ''} "
               f"named as GH_SHIM_VERDICT=dispatch://<KEY>/comment/<id>. This body's SHA-256 is {call['sha256']}.")
    want = VERDICT_REF_RE.match(ref)
    if not want:
        refuse(f"GH_SHIM_VERDICT={ref!r} is not a Dispatch comment reference (dispatch://KEY/comment/<id>).")
    # The header line comes before the body, so no text in the body can stand in for it.
    read = re.match(r"Comment:\n(\S+) · ([^\n]*)\nBody: (.*?)\nReply chain:\n", dispatch("read", "--ref", ref), re.S)
    if not read or read.group(1) != want.group(1):
        refuse(f"Dispatch's answer for {ref} is not that comment.")
    author, body = read.group(2).strip(), read.group(3)
    session = re.fullmatch(r"session (\S+)", author)
    if not session:
        refuse(f"the verdict {ref} was written by {author}, not by a session; the verdict is a reviewer session's.")
    reviewer = session.group(1)
    ours = {os.environ.get(name, "") for name in SESSION_VARS} - {""}
    if not ours:
        refuse(f"this call runs under no session id ({', '.join(SESSION_VARS)}), so the verdict cannot be "
               "told to come from another session.")
    if reviewer in ours:
        refuse(f"the verdict {ref} was written by session {reviewer}, which is the session making this post. "
               "A reviewer session that did not write the text records it; a subagent of this session "
               "writes to Dispatch as this session, so it cannot.")
    lines = body.split("\n")
    line = VERDICT_LINE_RE.match(next((text.strip() for text in lines if text.strip()), ""))
    if not line:
        refuse(f"the verdict {ref} does not begin with a `VERDICT: APPROVE at sha256:<64 hex>` line.")
    if line.group(1).upper() != "APPROVE":
        refuse(f"the verdict {ref} is {line.group(1)}, not APPROVE.")
    if line.group(2) != call["sha256"]:
        refuse(f"the verdict {ref} approves the text with SHA-256 {line.group(2)}, and this body's is "
               f"{call['sha256']}: a text that changed after the review goes back to a reviewer.")
    if titled:
        titles = [text[len("Title: "):].strip() for text in lines if text.startswith("Title: ")]
        if not titles:
            refuse(f"the verdict {ref} has no `Title: <title>` line, so the title it approves cannot be told.")
        if titles[0] != call["title"].strip():
            refuse(f"the verdict {ref} names the title {titles[0]!r}, not {call['title']!r}.")
    return ref, reviewer


def check(ref: str, call: dict) -> dict:
    if not re.match(r"^dispatch://[A-Z][A-Z0-9]*-\d+/ask/[0-9a-f-]{8,}\Z", ref):
        raise Refused(f"GH_SHIM_APPROVAL={ref!r} is not a Dispatch ask reference (dispatch://KEY/ask/<id>).")
    ask = parse_ask(dispatch("read", "--ref", ref))
    record = {"answered_by": ask["by"], "selected": ask["selected"], "answer_text": ask["text"]}
    if ask["state"] != "answered":
        raise Refused(f"the ask is {ask['state']}, not answered.")
    if ask["by"] != APPROVER:
        raise Refused(f"the ask was answered by {ask['by'] or 'nobody'}, not {APPROVER}.")
    if ask["selected"] not in ask["options"]:
        raise Refused(f"the answer selects {ask['selected']!r}, which is not exactly one of the ask's options.")
    if not approves(ask["selected"]):
        raise Refused(f"the selected option {ask['selected']!r} does not approve a post.")
    kind = KIND_APPROVALS.get(ask["id"])
    if kind:
        record.update(check_kind(ask, kind, call))
        return record
    source, where = ask["question"], ref
    if ask["document"]:
        versions = re.search(r"^Versions: (\d+)$", dispatch("read", "--ref", ask["document"]), re.M)
        if not versions:
            raise Refused(f"cannot read the versions of {ask['document']}.")
        for v in range(ask["first_version"], int(versions.group(1)) + 1):
            doc = dispatch("doc-read", "--ref", f"{ask['document']}@v{v}")
            blocks = ask_blocks(doc, ask["question"])
            if len(blocks) > 1:
                raise Refused(f"{ask['document']}@v{v} holds {len(blocks)} asks with this question, so which "
                              "one he answered cannot be told.")
            if blocks and blocks[0].get("state") == "answered":
                if blocks[0].get("answered_by") != APPROVER:
                    raise Refused(f"{ask['document']}@v{v} shows the ask answered by {blocks[0].get('answered_by')}.")
                if json.loads(blocks[0].get("selected") or "[]") != [ask["selected"]]:
                    raise Refused(f"{ask['document']}@v{v} shows another selection: {blocks[0].get('selected')}.")
                source, where = doc, f"{ask['document']}@v{v}"
                break
        else:
            raise Refused(f"no version of {ask['document']} shows the ask answered.")
    record["draft"] = where
    if not repo_named(call["repo"]).search(source + "\n" + ask["question"]):
        raise Refused(f"neither the ask nor its draft ({where}) names {call['repo']}.")
    body = norm(call["body"])
    sections = drafts(source)
    titled = [title for title, draft in sections if norm(draft) == body]
    if not titled:
        raise Refused(f"the body is not, exactly, the text between two `---` lines in {where}.")
    if call["title"] is not None and call["title"].strip() not in titled:
        raise Refused(f"the title {call['title']!r} is not the `Title:` line of that draft in {where}.")
    return record


def main() -> int:
    argv = sys.argv[1:]
    log = ""
    if len(argv) >= 2 and argv[0] == "--log":
        log, argv = argv[1], argv[2:]
    if argv[:1] == ["--"]:
        argv = argv[1:]
    ref = os.environ.get("GH_SHIM_APPROVAL", "")
    record = {
        "t": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "sid": os.environ.get("OMP_SESSION_ID", ""),
        "pid": os.getppid(),
        "cwd": os.getcwd(),
        "ask": ref,
        "argv": argv,
    }
    try:
        call = parse_call(argv)
        record.update(repo=call["repo"], verb=call["verb"], target=call["target"], title=call["title"],
                      body=call["body"], body_sha256=call["sha256"])
        if call["verb"] == "pr create":
            record.update(head=call["head"], base=call["base"] or "")
        record.update(check(ref, call))
        record["verdict"] = "allowed"
        code = 0
    except Refused as e:
        record["verdict"] = "refused"
        record["why"] = str(e)
        quoted = shlex.join(argv)
        if isinstance(e, KindRefused):
            instead = (
                f"{ref} approves a kind of post with no fixed text ({e.approves}), each one after a fresh "
                f"reviewer's verdict: a Dispatch comment by a session that did not write the text (not a "
                f"subagent of this session, which writes as this session), whose first line is `VERDICT: "
                f"APPROVE at sha256:<SHA-256 of the body as posted>`, with a `Title: <title>` line for an "
                f"issue or a pull request, named in GH_SHIM_VERDICT (shims/AGENTS.md). A text that "
                f"changes goes back to a reviewer, not to him in a new ask"
            )
        else:
            instead = (
                f"A post as Sami cites a Dispatch ask he answered with its approving option, whose "
                f"document (or question) holds the exact text between two `---` lines, with a "
                f"`Title: <title>` line before them for an issue or a pull request, and a pull request "
                f"opens from one of {APPROVER_LOGIN}'s own forks (shims/AGENTS.md). If the text must "
                f"change, show him the new text in a new ask"
            )
        print(
            f"gh shim: REFUSED: `gh {quoted}` cites {ref}, and the citation does not hold: {e}\n"
            f"  Instead: fix what is named above. {instead}; do not look for another credential.",
            file=sys.stderr,
        )
        code = 1
    if log:
        try:
            os.makedirs(os.path.dirname(log), mode=0o700, exist_ok=True)
            fd = os.open(log, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
            with os.fdopen(fd, "a") as f:
                f.write(json.dumps(record) + "\n")
        except OSError as e:
            print(f"gh shim: cannot log the cited post to {log}: {e}", file=sys.stderr)
            return 1
    if code == 0:
        if "approves" in record:
            held = (f"his answer approves {record['approves']}, and the text has a reviewer's verdict "
                    f"{record['review']} (session {record['reviewer']})")
        else:
            held = f"the text matches {record['draft']}"
        print(
            f"gh shim: cited post: {ref} answered by {APPROVER} ({record['selected']!r}); {held}. "
            f"Logged to {log or 'nowhere'}.",
            file=sys.stderr,
        )
        if record.get("answer_text"):
            print(f"gh shim: his answer also says: {record['answer_text']}", file=sys.stderr)
    return code


if __name__ == "__main__":
    sys.exit(main())
