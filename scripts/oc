#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = []
# ///
#
# ─── How to run ───
# On PATH as `oc` (scripts/ is prepended in .bashrc); uv is pinned in mise.toml.
#   oc [ARGS]              — launch opencode with --port 0 (ARGS pass through)
#   oc ps [--json|--local|--sub-agents] — list running instances (delegates to `envoy ps`)
#   oc history [HOURS] [--json] [--legion] — list recent sessions from the DB
#   oc kill PANE [PANE...] — kill the opencode running in tmux pane(s)
# ──────────────────
"""OpenCode launcher with subcommands.

Python (PEP 723 + uv) rather than bash so that editing this file no longer
breaks tmux panes launched before the edit: bash reads scripts lazily from
the same fd it executes, so an edit shifts its byte offsets mid-run, whereas
Python parses the whole file up front — and the launch path exec()s opencode,
leaving no interpreter behind at all.

Env vars:
  ENVOY_URL          — Envoy listener base URL (default: http://127.0.0.1:9020)
  OPENCODE_NO_SERVE  — set to "1" to skip --port 0 (raw opencode)
  OPENCODE_DB        — override the sessions DB path
"""

from __future__ import annotations

import argparse
import json
import os
import re
import signal
import sqlite3
import subprocess
import sys
import time
import urllib.request
from contextlib import closing
from dataclasses import dataclass
from functools import cache
from pathlib import Path
from typing import NoReturn, assert_never

ENVOY_URL = os.environ.get("ENVOY_URL", "http://127.0.0.1:9020")
SESSION_ID_RE = re.compile(r"ses_[A-Za-z0-9]+")
HOME = Path.home()


def db_path() -> Path:
    return Path(os.environ.get("OPENCODE_DB", str(HOME / ".local/share/opencode/opencode.db")))


# ---------------------------------------------------------------------------
# Subcommand: history
# ---------------------------------------------------------------------------

LEGION_WORKSPACE_PATTERNS = (
    f"{HOME}/.legion/workspaces/%",
    f"{HOME}/.local/share/legion/workspaces/%",
    f"{HOME}/legion/work/%",
)

HISTORY_COLUMNS = ("id", "dir", "title", "created", "updated", "msgs")


def sessions_dir() -> Path:
    return Path(os.environ.get("OPENCODE_SESSIONS_DIR", str(db_path().parent / "sessions")))


def shard_message_count(session_id: str) -> int | None:
    """Messages in this session's own shard DB, or None when it has no shard.

    OpenCode moved message storage out of the main DB into per-session shards
    under `sessions/`; the main `message` table stopped gaining rows at the
    migration and reports 0 for every session started after it. Sessions older
    than the migration have no shard, and are still counted from the main DB.
    """
    shard = sessions_dir() / f"{session_id}.db"
    if not shard.is_file():
        return None
    with closing(sqlite3.connect(f"file:{shard}?mode=ro", uri=True)) as conn:
        return conn.execute("SELECT COUNT(*) FROM message WHERE session_id = ?", (session_id,)).fetchone()[0]


def history_rows(hours: int, *, legion: bool) -> list[tuple[str, str, str | None, str, str, int]]:
    """Top-level sessions active in the last `hours`, most recently active first.

    Ordered by last activity rather than creation time: a session started
    weeks ago but used an hour ago is recent history, and sorting by
    time_created buries it under every session merely created today.
    """
    cutoff_ms = (int(time.time()) - hours * 3600) * 1000
    legion_filter, params = "", [str(HOME), cutoff_ms]
    if not legion:
        legion_filter = "AND directory NOT LIKE ? " * len(LEGION_WORKSPACE_PATTERNS)
        params.extend(LEGION_WORKSPACE_PATTERNS)
    query = f"""
        SELECT id,
               REPLACE(directory, ?, '~'),
               title,
               strftime('%Y-%m-%d %H:%M', time_created/1000, 'unixepoch', 'localtime'),
               strftime('%Y-%m-%d %H:%M', time_updated/1000, 'unixepoch', 'localtime'),
               (SELECT COUNT(*) FROM message m WHERE m.session_id = s.id)
        FROM session s
        WHERE parent_id IS NULL AND time_updated >= ? {legion_filter}
        ORDER BY time_updated DESC
    """  # noqa: S608 — placeholders only; legion_filter is a literal
    with closing(sqlite3.connect(f"file:{db_path()}?mode=ro", uri=True)) as conn:
        rows = conn.execute(query, params).fetchall()
    return [
        (session_id, directory, title, created, updated, sharded if (sharded := shard_message_count(session_id)) is not None else msgs)
        for session_id, directory, title, created, updated, msgs in rows
    ]


def print_table(rows: list[tuple[str, ...]]) -> None:
    """Left-aligned columns joined by two spaces, like `column -t`."""
    widths = [max(len(row[i]) for row in rows) for i in range(len(rows[0]))]
    for row in rows:
        print("  ".join(cell.ljust(w) for cell, w in zip(row, widths, strict=True)).rstrip())


def cmd_history(args: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="oc history", description="List recent sessions from the local DB.")
    parser.add_argument("hours", nargs="?", type=int, default=24, help="look-back window in hours (default: 24)")
    parser.add_argument("--json", action="store_true", dest="as_json", help="output as a JSON array")
    parser.add_argument("--legion", action="store_true", help="include Legion workspace sessions")
    opts = parser.parse_args(args)
    hours: int = opts.hours
    if not db_path().is_file():
        print(f"error: database not found: {db_path()}", file=sys.stderr)
        return 1
    rows = history_rows(hours, legion=opts.legion)
    if opts.as_json:
        print(json.dumps([dict(zip(HISTORY_COLUMNS, row, strict=True)) for row in rows]))
    elif not rows:
        print(f"No sessions in the last {hours}h")
    else:
        header = tuple(name.upper() for name in HISTORY_COLUMNS)
        print_table([header] + [tuple("" if cell is None else str(cell) for cell in row) for row in rows])
    return 0


# ---------------------------------------------------------------------------
# Subcommand: kill
# ---------------------------------------------------------------------------


def pane_root_pid(pane: str) -> int | str:
    """Resolve the pane's root pid, or return an error message.

    tmux exits 0 printing nothing for a target it cannot resolve, so judge by
    the output rather than the exit status.
    """
    proc = subprocess.run(
        ["tmux", "display-message", "-p", "-t", pane, "#{pane_pid}"],
        capture_output=True,
        text=True,
        check=False,
    )
    out = proc.stdout.strip()
    return int(out) if out.isdigit() else (proc.stderr.strip() or f"no such tmux pane: {pane}")


def opencode_descendants(root: int) -> list[int]:
    """Pids of every `opencode` process anywhere under `root`.

    A pane usually runs opencode as pane shell -> opencode (this script execs),
    but walk the whole subtree rather than guessing the depth.
    """
    ps = subprocess.run(["ps", "-eo", "pid=,ppid=,comm="], capture_output=True, text=True, check=False)
    children: dict[int, list[tuple[int, str]]] = {}
    for line in ps.stdout.splitlines():
        match line.split(None, 2):
            case [pid, ppid, comm] if pid.isdigit() and ppid.isdigit():
                children.setdefault(int(ppid), []).append((int(pid), comm))
            case _:
                pass  # ps header/garbage line
    found: list[int] = []
    queue = [root]
    while queue:
        for pid, comm in children.get(queue.pop(), []):
            if comm == "opencode":
                found.append(pid)
            queue.append(pid)
    return found


def cmdline(pid: int) -> list[str]:
    try:
        raw = Path(f"/proc/{pid}/cmdline").read_bytes()
    except OSError:
        return []
    return [arg for arg in raw.decode(errors="replace").split("\0") if arg]


def listen_ports(pid: int) -> list[int]:
    """Loopback ports `pid` is listening on, via `ss -tlnp`."""
    ss = subprocess.run(["ss", "-tlnp"], capture_output=True, text=True, check=False)
    needle = f"pid={pid},"
    matches = (re.search(r"127\.0\.0\.1:(\d+)\s", line) for line in ss.stdout.splitlines() if needle in line)
    return sorted({int(m.group(1)) for m in matches if m})


@dataclass(frozen=True, slots=True)
class RegistryEntry:
    """One Envoy-registered session: which port it lives on, and its id."""

    port: int
    session_id: str


@cache
def envoy_registry() -> tuple[RegistryEntry, ...]:
    """Envoy's live-session registry; empty on any failure (Envoy is optional)."""
    try:
        with urllib.request.urlopen(f"{ENVOY_URL}/v1/sessions", timeout=2) as resp:  # noqa: S310
            entries = json.load(resp)
    except (OSError, ValueError):
        return ()
    if not isinstance(entries, list):
        return ()
    return tuple(
        RegistryEntry(port=port, session_id=session_id)
        for entry in entries
        if isinstance(entry, dict)
        and isinstance(port := entry.get("port"), int)
        and isinstance(session_id := entry.get("session_id"), str)
    )


def active_session_ids(port: int) -> list[str]:
    """Session IDs mid-turn on this instance; any ses_* in the payload counts."""
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{port}/api/session/active", timeout=2) as resp:
            return SESSION_ID_RE.findall(resp.read().decode(errors="replace"))
    except OSError:
        return []


@dataclass(frozen=True, slots=True)
class PaneSession:
    """A top-level session that was running in a killed pane."""

    session_id: str
    title: str


def annotate_sessions(ids: list[str]) -> list[PaneSession]:
    """Title each id from the DB, dropping subagent sessions.

    Envoy reports every subagent session that ever registered on a port; a
    pane's own session is a root one (parent_id IS NULL). IDs the DB has never
    heard of are kept, untitled, rather than silently lost.
    """
    if not ids:
        return []
    placeholders = ",".join("?" * len(ids))
    try:
        with closing(sqlite3.connect(f"file:{db_path()}?mode=ro", uri=True)) as conn:
            rows = conn.execute(
                f"SELECT id, parent_id IS NULL, COALESCE(title, '') FROM session WHERE id IN ({placeholders})",  # noqa: S608
                ids,
            ).fetchall()
    except sqlite3.Error:
        return [PaneSession(session_id, "") for session_id in ids]
    known = {row[0]: (bool(row[1]), row[2]) for row in rows}
    kept: list[PaneSession] = []
    for session_id in ids:
        match known.get(session_id):
            case None:
                kept.append(PaneSession(session_id, ""))
            case (True, title):
                kept.append(PaneSession(session_id, title))
            case (False, _):
                pass  # subagent session
    return kept


def pane_sessions(pid: int) -> list[PaneSession]:
    """Top-level sessions of opencode process `pid`, most authoritative first.

    No single source is complete: launch args only carry a session when one was
    named, /api/session/active only reports sessions mid-turn, and Envoy only
    knows sessions that got as far as registering. Must run while the process
    is still alive.
    """
    argv = cmdline(pid)
    ids = [argv[i + 1] for i, arg in enumerate(argv[:-1]) if arg in ("-s", "--session")]
    ids += [arg.split("=", 1)[1] for arg in argv if arg.startswith("--session=")]
    ports = listen_ports(pid)
    for port in ports:
        ids += active_session_ids(port)
    for port in ports:
        ids += [entry.session_id for entry in envoy_registry() if entry.port == port]
    deduped = dict.fromkeys(i for i in ids if SESSION_ID_RE.fullmatch(i))
    return annotate_sessions(list(deduped))


def process_is_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    return True


def terminate(pid: int) -> str:
    """SIGTERM, give it 5s to shut down, then stop asking nicely."""
    os.kill(pid, signal.SIGTERM)
    for _ in range(50):
        if not process_is_alive(pid):
            return "killed"
        time.sleep(0.1)
    try:
        os.kill(pid, signal.SIGKILL)
    except ProcessLookupError:
        return "killed"
    return "SIGKILLed"


def kill_one(pane: str, pid: int) -> bool:
    args = " ".join(cmdline(pid))
    # Collect while it can still answer for itself. Reporting is a nicety; it
    # must never stand between you and killing the process, whatever breaks.
    try:
        sessions = pane_sessions(pid)
    except Exception as exc:  # noqa: BLE001 — deliberate boundary, see above
        print(f"oc kill: {pane}: session lookup failed: {exc}", file=sys.stderr)
        sessions = []
    try:
        verb = terminate(pid)
    except (ProcessLookupError, PermissionError):
        print(f"oc kill: {pane}: could not signal {pid}", file=sys.stderr)
        return False
    print(f"{pane}: {verb} opencode {pid} ({args})")
    if not sessions:
        print(f"{pane}:   (no session id found)")
    for session in sessions:
        title = f"  {session.title}" if session.title else ""
        print(f"{pane}:   session {session.session_id}{title}")
    return True


def kill_pane(pane: str) -> bool:
    match pane_root_pid(pane):
        case str(error):
            print(f"oc kill: {error}", file=sys.stderr)
            return False
        case int(root):
            pids = opencode_descendants(root)
            if not pids:
                print(f"oc kill: {pane}: no opencode process under pane pid {root}", file=sys.stderr)
                return False
            results = [kill_one(pane, pid) for pid in pids]
            return all(results)
        case unreachable:
            assert_never(unreachable)


def cmd_kill(args: list[str]) -> int:
    parser = argparse.ArgumentParser(
        prog="oc kill",
        description="Kill the opencode running in tmux pane(s) and report which sessions were active.",
    )
    parser.add_argument("panes", nargs="+", metavar="PANE", help="tmux target-pane (%%18, dev:3.1, ...)")
    opts = parser.parse_args(args)
    results = [kill_pane(pane) for pane in opts.panes]
    return 0 if all(results) else 1


# ---------------------------------------------------------------------------
# Main: launch opencode (with oh-my-opencode for interactive sessions)
# ---------------------------------------------------------------------------


def launch(args: list[str]) -> NoReturn:
    env = os.environ
    dotfiles = Path(env.get("DOTFILES_DIR", str(HOME / ".dotfiles")))

    # Add oh-my-opencode plugin for interactive use
    env["OPENCODE_CONFIG_CONTENT"] = '{"plugin":["@sjawhar/oh-my-opencode@sami"]}'

    # --- gh-app routing config (per-repo credential routing for git+gh) ---
    # Agents authenticate as the GitHub App installation matching each repo's
    # owner; owners without an installation fall through to your gh user auth.
    # See gh-app-routes.gitconfig and shims/gh-app-token.
    index = int(env.get("GIT_CONFIG_COUNT", "0") or "0")
    env[f"GIT_CONFIG_KEY_{index}"] = "include.path"
    env[f"GIT_CONFIG_VALUE_{index}"] = str(dotfiles / "gh-app-routes.gitconfig")
    env["GIT_CONFIG_COUNT"] = str(index + 1)

    # --- dotfiles shims must lead PATH ---
    # The gh App routing above only works when `gh` resolves to shims/gh. The
    # launching shell's mise hook may have prepended tool install dirs
    # (including the real gh) ahead of the shims; agent serves inherit PATH
    # forever, so re-front the shims here or agents silently act as the user
    # on GitHub.
    shims = str(dotfiles / "shims")
    rest = [p for p in env.get("PATH", "").split(":") if p and p != shims]
    env["PATH"] = ":".join([shims, *rest])

    # OPENCODE_NO_SERVE=1 opts out; an explicit --port wins over our --port 0.
    serve_args = [] if env.get("OPENCODE_NO_SERVE") == "1" or "--port" in args else ["--port", "0"]
    try:
        os.execvp("opencode", ["opencode", *serve_args, *args])
    except OSError as exc:
        print(f"oc: cannot exec opencode: {exc}", file=sys.stderr)
        sys.exit(127)


def main() -> int:  # noqa: RET503 — every match arm returns or exec()s away
    match sys.argv[1:]:
        case ["ps", *rest]:
            envoy = Path(__file__).resolve().parent / "envoy"
            os.execv(str(envoy), [str(envoy), "ps", *rest])
        case ["history", *rest]:
            return cmd_history(rest)
        case ["kill", *rest]:
            return cmd_kill(rest)
        case args:
            launch(args)


if __name__ == "__main__":
    sys.exit(main())
