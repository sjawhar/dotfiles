#!/usr/bin/env bash
# verified-grader-gateway-key -- keep the BET-59 verified-grader stream's model-gateway key in tmpfs, where the
# `pbc-gateway` provider's `apiKey: "!cat …"` reads it (agent-infra model-gateway/box README.md, "What a BET-59
# session launches with"). omp/verified-grader-gateway-key.service runs it once at boot and nothing runs it on a
# schedule; it runs alone too, which is how a rotated key is picked up.
#
# It is the last gateway credential on this box that is a key. Every other provider mints this machine's own
# identity token per call (scripts/gateway-token), because the gateway's sign-in is that token
# (agent-infra model-gateway/vm/ossv_box_auth.py). This stream cannot: that check maps an account to exactly one
# LiteLLM team, dev-sjawhar@ is team `box`, and the `pbc/` groups belong to team `verified-grader` alone
# (model-gateway/main.go, pbcModels) -- measured 2026-11-04, an identity token on pbc/claude-opus-5-5 answers
# 403 team_model_access_denied. When the INFRA lead gives an identity caller that team, this script, its unit and
# its installer all go.
#
# The key is consumer `verified-grader` (team verified-grader) of agent-infra's model-gateway/ stack, which mints it
# and writes it to Secret Manager as theorem-agent-infra's verified-grader-model-gateway-key. This asks the gateway
# VM, over ssh on the tailnet, to read the newest version with its own metadata token, as the box key's writer
# does: the stack grants the VM's own account Secret Accessor on every consumer secret (main.go, deliver), and
# the host reaches the VM on tcp:22 with bin/ossv-vm. No broker request and no approval are in this path, so a
# resume, a restart and an unattended start need nothing typed.
#
# The key is written 0600 to $XDG_RUNTIME_DIR/verified-grader/gateway-key, in a 0700 directory. That is tmpfs, so
# the file is gone after a reboot and the boot unit puts it back. Every agent box mounts that directory read-only
# (scripts/agentbox), so only the host writes it. A rotated key replaces the file at the next run; omp re-runs
# `!cat` when the gateway answers 401, so a running session takes the new key with no restart. The file is left
# untouched when the key is unchanged. The key passes through this process only, and is never printed or logged.
#
# OSSV_ROOT (default ~/src/oss-verifier), OSSV_VM (default OSSV_ROOT/bin/ossv-vm) and OSSV_GATEWAY_HOST (default
# model-gateway) name the VM as vm/apply names it.
#
# From agent-infra's model-gateway/box/verified-grader-gateway-key (agentvm's copy, sha256 49988455…), which ran
# from a tmux loop every 600 s. Differences: the PATH line below (a systemd unit's PATH has no gcloud, which ossv-vm
# calls on an instance-cache miss), an unchanged key prints one line to the journal, and nothing repeats the run.
set -uo pipefail
export PATH="$HOME/.dotfiles/shims:$HOME/.dotfiles/bin:$HOME/.mise/shims:$PATH"
root="${OSSV_ROOT:-$HOME/src/oss-verifier}"
vm="${OSSV_VM:-$root/bin/ossv-vm}"
host="${OSSV_GATEWAY_HOST:-model-gateway}"
d="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/verified-grader"
f="$d/gateway-key"
install -d -m 700 "$d" || exit 1
k="$(timeout 120 "$vm" ssh "$host" 'bash -s' << 'EOF' 2> /dev/null | tr -d '\r\n'
set -euo pipefail
t="$(curl -fsS -m 10 -H 'Metadata-Flavor: Google' \
  http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token | jq -er .access_token)"
curl -fsS -m 20 -K <(printf 'header = "Authorization: Bearer %s"\n' "$t") \
  "https://secretmanager.googleapis.com/v1/projects/theorem-agent-infra/secrets/verified-grader-model-gateway-key/versions/latest:access" \
  | jq -er .payload.data | base64 -d
EOF
)" || k=""
case "$k" in
  sk-*)
    if [ -s "$f" ] && [ "$(cat "$f")" = "$k" ]; then
      echo "verified-grader-gateway-key: key unchanged; $f left as it was"
      exit 0
    fi
    umask 077
    rm -f "$f.new"
    printf %s "$k" > "$f.new" && mv -f "$f.new" "$f" || exit 1
    logger -t verified-grader-gateway-key -- "key written to $f"
    ;;
  *)
    rm -f "$f.new"
    logger -t verified-grader-gateway-key -- "no key from Secret Manager through $host"
    echo "verified-grader-gateway-key: no key from Secret Manager through $host; $f is left as it was" >&2
    exit 1
    ;;
esac
