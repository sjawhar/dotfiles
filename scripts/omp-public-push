#!/bin/bash
# omp-public-push GIT [GIT_OPTION…] -- [REMOTE]: whether an agent session may push from the
# repository `GIT [GIT_OPTION…]` names to REMOTE, a remote name or a URL; empty means the
# remote a bare `git push` uses (branch.<name>.pushRemote, remote.pushDefault,
# branch.<name>.remote, origin). Exit 0 allows it, with stdout saying why; exit 1 refuses
# it, with the refusal on stderr. shims/git asks it for every `git push` from an agent
# session and shims/jj for every `jj git push` (`shims/AGENTS.md`).
#
# A public repository of an owner in PUBLISHING_OWNERS (scripts/github-visibility.bash:
# theorem-labs, whose public repositories are its releases) is published only on purpose,
# so a push to one is refused unless the checkout opts in with
# `git config omp.publicPush true`. A remote counts as such a repository when any of its
# URLs, fetch or push, is one: a remote whose pushurl was pointed elsewhere still names the
# public repository. GitHub not answering refuses too. Every other target is allowed,
# Sami's own public repositories included. `gh api` writes (contents PUT, git/refs) never
# pass through git and are not covered.
set -euo pipefail

# shellcheck source=github-visibility.bash
source "${BASH_SOURCE[0]%/*}/github-visibility.bash"

git=()
while (($#)) && [[ "$1" != -- ]]; do
    git+=("$1")
    shift
done
remote="${2:-}"

if [[ "$("${git[@]}" config --type=bool --get omp.publicPush 2> /dev/null || true)" == true ]]; then
    echo "allowed: omp.publicPush is true"
    exit 0
fi

if [[ -z "$remote" ]]; then
    branch="$("${git[@]}" symbolic-ref -q --short HEAD 2> /dev/null || true)"
    declare -A conf=()
    while read -r key value; do
        conf["$key"]="$value"
    done < <("${git[@]}" config --get-regexp '^(branch\..*\.(pushremote|remote)|remote\.pushdefault)$' 2> /dev/null || true)
    remote="${conf[branch.$branch.pushremote]:-${conf[remote.pushdefault]:-${conf[branch.$branch.remote]:-origin}}}"
fi

# A configured remote: every URL and pushurl it has, as written and as `git remote -v`
# prints it after insteadOf and pushInsteadOf, so a rewrite in either direction still
# counts. Anything else is a URL or path, as given and as git rewrites it by insteadOf.
urls=()
while read -r key url; do
    [[ "$key" == "remote.$remote.url" || "$key" == "remote.$remote.pushurl" ]] && urls+=("$url")
done < <("${git[@]}" config --get-regexp '^remote\..*\.(url|pushurl)$' 2> /dev/null || true)
if ((${#urls[@]})); then
    while read -r name url _kind; do
        [[ "$name" == "$remote" ]] && urls+=("$url")
    done < <("${git[@]}" remote -v 2> /dev/null || true)
else
    urls=("$remote" "$("${git[@]}" ls-remote --get-url "$remote" 2> /dev/null || true)")
fi
mapfile -t slugs < <(publishing_slugs "${urls[@]}")
for slug in "${slugs[@]}"; do
    answer="$(github_visibility "$slug")"
    case "$answer" in
        private | internal) ;;
        *)
            if [[ "$answer" == public ]]; then
                why="GitHub reports it public"
            else
                why="GitHub could not say whether it is public, so it is treated as public"
            fi
            cat >&2 << EOF
push refused: github.com/$slug is a public repository ($why).
An omp session does not push to a public ${slug%%/*} repository (its published releases)
unless the clone publishes on purpose. For a clone that does, opt in once:
  git config omp.publicPush true
\`gh api\` writes (contents PUT, git/refs) are not covered by this guard.
EOF
            echo "refused: github.com/$slug is $answer"
            exit 1
            ;;
    esac
done
echo "allowed: ${remote} is not a public ${PUBLISHING_OWNERS[*]} repository"
exit 0
