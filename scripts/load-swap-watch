#!/usr/bin/env python3
"""Alert while an agent box is still able to act, when its CPU or its swap runs out.

Why this exists: on 2026-10-29 between about 22:46Z and 23:58Z, six agent lanes on
ossv-agent-open (c-asan-rt, c-libc-str, g-ph-hreply, c-omx-writer, c-asanb, h-cmd-b2) were
reported frozen and the box was read as hung. It was not hung. Measured at 23:55-23:58Z: 32
cores carrying load 251/185/135, `cpu some avg60` at 80%, 126 `omp` processes holding 108 GiB
of RSS and 180 GiB of swap, and `/swapfile` at 200,820,180 of 201,326,588 KB used -- 99.75%,
515 MB free. `ossv-worker list` showed 115 workers in `running` state. Nothing alerted. Every
liveness check a person could run said the box was healthy: omp was running in every pane,
`tmux capture-pane` answered in 0.01 s, no process was stuck in a syscall, and the transcripts
kept being written. The lanes were simply being served a fraction of a core each, with their
working sets in a swapfile that had no room left.

That failure mode is invisible to the two watches already on these boxes. `disk-fill-watch`
watches bytes on a filesystem. `omp-memory-watch` watches one session's own memcg against the
ceiling `shims/omp` gave it, which is a per-session limit and says nothing about a box carrying
a hundred of them. The box-wide resource that ran out here -- CPU time, and swap -- had no
instrument at all.

What one run does, from /proc only, with no model call and no subprocess on the quiet path:

  1. Record one sample of CPU pressure, swap, memory and the run queue. Every run appends,
     whether or not anything is wrong: a silent log cannot be told from a dead watch.
  2. Judge each condition on its own, and say each on its own. CPU and swap are different
     states with different actions, and one headline for both overstates whichever half has
     recovered: on 2026-10-30T01:32Z an escalation said "STILL OUT OF CPU+SWAP" about a box
     carrying load 27 on 32 cores at 7% CPU pressure, because the CPU half had been true half
     an hour earlier. Each condition now has its own crossing, grace, alert, escalation and
     clear.
  3. The CPU rule asks two things, because either alone is wrong. PSI (`cpu some avg60`, time
     tasks spent runnable and waiting for a CPU) must be at or over CPU_STALL, AND the load
     must be over the core count. Load alone counts uninterruptible sleep, so load 221 may be a
     box waiting on a disk; PSI alone called that 7% box starved. The alert carries `io some`
     and `memory full` beside it so the reader can see which of the three it is.
  4. The swap rule asks nothing about CPU. A swapfile with nothing left is worth saying on an
     idle box: it is a statement about the next memory squeeze, not about now, since from there
     the kernel's reclaim has nowhere to go but the OOM killer. Time to exhaustion comes from
     this watch's own samples, the way disk-fill-watch computes time to full.
  5. Hold a crossing for the grace window before alerting, so a build burst does not fire it.
  6. Name the consumers. CPU is attributed by a short delta of per-process CPU time, never by
     one `ps` reading, because the processes eating this box are thousands of short-lived
     children. Swap is attributed by `VmSwap` per process. Both are grouped by command and by
     the agent session or lane worker that owns them, so the alert says "115 workers, 181 GiB
     of swap in omp" rather than naming a pid nobody can act on.

It also counts the box's agents, because on these boxes the dial that causes this is the number
of concurrent workers, not any one of them.

Alerts go over Envoy to agent sessions only, never to a person: the box-health lead's role,
falling back to the INFRA lead's session when nobody holds that role, and the chief of staff
when a crossing is still open 30 minutes after its alert. This watch only detects. It kills
nothing, stops no worker and changes no limit.
"""

from __future__ import annotations

import argparse
import fcntl
import json
import os
import re
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

# The two sessions that own this detector's findings, as in disk-fill-watch and omp-memory-watch.
CHIEF_OF_STAFF = "01a13dca-e979-7264-af32-f654ef57a6f5"
INFRA_LEAD = "01a13c57-d826-7242-80fe-5f0670188b11"

# The box-health lead owns box resources (dispatch://INFRA-716) and holds this Envoy role, so a
# crossing goes to the role, not to a session id that moves when the lane changes hands.
BOX_HEALTH_ROLE_TOPIC = "notifications.role.lead-box-health"

DEFAULT_ENVOY_URL = "http://127.0.0.1:9020"
GIB = 1073741824

UUID_RE = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}")
# An ossv lane worker's name, from the path its process stands in or its brief:
# /home/sami/work/cold/workers/c-libc-str.md, /home/sami/work/workers/c-libc-str/...
WORKER_RE = re.compile(r"/workers/([A-Za-z0-9][A-Za-z0-9_.-]*?)(?:\.md|\.jsonl|/|\s|\Z)")

# Where the state file goes, as disk-fill-watch places its own: the big disk on an agent box,
# ~/.local/state on a machine without one.
_NVME_STATE = Path("/mnt/nvme/sami/tmp/load-swap-watch/state.json")
DEFAULT_STATE = (
    _NVME_STATE
    if os.access("/mnt/nvme/sami/tmp", os.W_OK)
    else Path(os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local/state"))) / "load-swap-watch/state.json"
)

# The CPU bar, taken from the readings of 2026-10-29/30 rather than from a round number, and
# paired with a load over the core count (see verdict). Healthy boxes measured: ossv-agent-open
# at 01:32Z, cpu some avg60 7% at load 27 on 32 cores, answering normally; sami-leanperf idle,
# 0% at load 1 on 160. Starved boxes measured: ossv-agent-open during the six-lane incident,
# 80% at load 251 on 32; sami-rocqperf through the night, 42% to 65% at load 204-310 on 64, its
# own lanes visibly slow at the low end; ossv-agent-open2 at 01:32Z, 55% at load 76 on 32. The
# lowest starved reading is 42% and the highest healthy one is 7%, so the bar goes in that
# empty band, below every starved reading with margin and five times the highest healthy one.
CPU_STALL = 35.0

CLOCK_TICK = os.sysconf("SC_CLK_TCK")


def log(message: str) -> None:
    stamp = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    print(f"{stamp} {message}", flush=True)


def iso(epoch: float | None) -> str:
    if not epoch:
        return "unknown"
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(epoch))


def human_time(seconds: float) -> str:
    seconds = max(0.0, float(seconds))
    if seconds < 90:
        return f"{seconds:.0f}s"
    if seconds < 5400:
        return f"{seconds / 60:.0f} min"
    if seconds < 172800:
        return f"{seconds / 3600:.1f} h"
    return f"{seconds / 86400:.1f} days"


def gib(value: float) -> str:
    return f"{value / GIB:.1f} GiB"


# ------------------------------------------------------------------------------- Envoy


class Envoy:
    """The listener this machine's sessions use, resolved the way scripts/envoy resolves it."""

    def __init__(self, timeout: float = 8.0) -> None:
        path = os.environ.get("ENVOY_CONFIG_FILE") or str(
            Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))) / "legion/envoy.json"
        )
        try:
            config = json.loads(Path(path).read_text()).get("envoy") or {}
        except (OSError, ValueError):
            config = {}
        if config.get("enabled") is False:
            raise SystemExit(f"{path} sets envoy.enabled to false: Envoy is off")
        self.url = (os.environ.get("ENVOY_URL") or config.get("url") or DEFAULT_ENVOY_URL).rstrip("/")
        self.timeout = timeout
        token = os.environ.get("ENVOY_TOKEN") or config.get("token") or ""
        if token.startswith("!"):
            try:
                done = subprocess.run(
                    ["/bin/sh", "-c", token[1:]],
                    capture_output=True,
                    text=True,
                    timeout=10,
                    stdin=subprocess.DEVNULL,
                )
                token = done.stdout.strip() if done.returncode == 0 else ""
            except (OSError, subprocess.SubprocessError):
                token = ""
        self.token = token

    def request(self, method: str, path: str, body: dict | None = None) -> tuple[int, dict | list]:
        data = json.dumps(body).encode() if body is not None else None
        request = urllib.request.Request(self.url + path, data=data, method=method)
        if data is not None:
            request.add_header("Content-Type", "application/json")
        if self.token:
            request.add_header("Authorization", f"Bearer {self.token}")
        try:
            with urllib.request.urlopen(request, timeout=self.timeout) as answer:
                raw = answer.read().decode() or "{}"
                return answer.status, json.loads(raw)
        except urllib.error.HTTPError as error:
            raw = error.read().decode() or "{}"
            try:
                return error.code, json.loads(raw)
            except ValueError:
                return error.code, {"error": raw.strip()}
        except (urllib.error.URLError, socket.timeout, ValueError, OSError) as error:
            return 0, {"error": str(error)}

    def send(self, session_id: str, message: str) -> bool:
        status, body = self.request(
            "POST",
            "/v1/messages/send",
            {"target_session": session_id, "message": message, "source": "envoy"},
        )
        if status != 200:
            log(f"  send to {session_id} failed: {status} {body}")
        return status == 200

    def publish(self, topic: str, message: str) -> bool:
        status, body = self.request(
            "POST",
            "/v1/messages/publish",
            {"topic": topic, "message": message, "source": "envoy"},
        )
        if status != 200:
            log(f"  publish to {topic} failed: {status} {body}")
        return status == 200


# ------------------------------------------------------------------------------- the box


def read_text(path: str) -> str:
    try:
        return Path(path).read_text()
    except OSError:
        return ""


def pressure(resource: str) -> dict[str, float]:
    """`some` and `full` averages from /proc/pressure/<resource>, as percentages of wall time.

    `some avg60` is the number this watch decides on for CPU: the share of the last minute in
    which at least one runnable task was waiting for a CPU. A box with no PSI (a kernel without
    CONFIG_PSI) returns {}, and the CPU rule then falls back to the run queue per core.
    """
    found: dict[str, float] = {}
    for line in read_text(f"/proc/pressure/{resource}").splitlines():
        parts = line.split()
        if not parts:
            continue
        for item in parts[1:]:
            key, sep, value = item.partition("=")
            if sep and key.startswith("avg"):
                try:
                    found[f"{parts[0]}_{key}"] = float(value)
                except ValueError:
                    pass
    return found


def meminfo() -> dict[str, int]:
    found = {}
    for line in read_text("/proc/meminfo").splitlines():
        key, _, rest = line.partition(":")
        parts = rest.split()
        if parts:
            try:
                found[key] = int(parts[0]) * 1024
            except ValueError:
                pass
    return found


def vmstat() -> dict[str, int]:
    found = {}
    for line in read_text("/proc/vmstat").splitlines():
        parts = line.split()
        if len(parts) == 2:
            try:
                found[parts[0]] = int(parts[1])
            except ValueError:
                pass
    return found


def run_queue() -> tuple[int, int]:
    """(procs_running, procs_blocked) from /proc/stat: the runnable and the uninterruptible.

    Load average is the sum of both over time, so it cannot tell a box short of CPU from a box
    waiting on a disk. These two can, and the alert prints them.
    """
    running = blocked = 0
    for line in read_text("/proc/stat").splitlines():
        if line.startswith("procs_running "):
            running = int(line.split()[1])
        elif line.startswith("procs_blocked "):
            blocked = int(line.split()[1])
    return running, blocked


def sample_box() -> dict:
    memory = meminfo()
    swap_total = memory.get("SwapTotal", 0)
    swap_free = memory.get("SwapFree", 0)
    running, blocked = run_queue()
    load = read_text("/proc/loadavg").split()
    cores = os.cpu_count() or 1
    return {
        "at": time.time(),
        "cores": cores,
        "cpu": pressure("cpu"),
        "io": pressure("io"),
        "memory_pressure": pressure("memory"),
        "load1": float(load[0]) if load else 0.0,
        "load5": float(load[1]) if len(load) > 1 else 0.0,
        "load15": float(load[2]) if len(load) > 2 else 0.0,
        "procs_running": running,
        "procs_blocked": blocked,
        "swap_total": swap_total,
        "swap_free": swap_free,
        "swap_used_fraction": (1 - swap_free / swap_total) if swap_total else 0.0,
        "mem_available": memory.get("MemAvailable", 0),
        "mem_total": memory.get("MemTotal", 0),
        "pswpin": vmstat().get("pswpin", 0),
    }


# ------------------------------------------------------------------------------- the consumers


def cmdline_of(pid: int) -> str:
    try:
        return Path(f"/proc/{pid}/cmdline").read_bytes().decode("utf8", "replace").replace("\0", " ").strip()
    except OSError:
        return ""


def comm_of(pid: int) -> str:
    try:
        return Path(f"/proc/{pid}/comm").read_text().strip()
    except OSError:
        return ""


def ppid_of(pid: int) -> int:
    try:
        data = Path(f"/proc/{pid}/stat").read_text()
        return int(data[data.rfind(")") + 2 :].split()[1])
    except (OSError, ValueError, IndexError):
        return 0


def age_of(pid: int) -> float:
    try:
        data = Path(f"/proc/{pid}/stat").read_text()
        ticks = int(data[data.rfind(")") + 2 :].split()[19])
        uptime = float(read_text("/proc/uptime").split()[0])
        return max(0.0, uptime - ticks / CLOCK_TICK)
    except (OSError, ValueError, IndexError):
        return 0.0


def cpu_ticks_of(pid: int) -> int | None:
    """utime + stime of a process, in clock ticks, or None when it is gone."""
    try:
        data = Path(f"/proc/{pid}/stat").read_text()
        fields = data[data.rfind(")") + 2 :].split()
        return int(fields[11]) + int(fields[12])
    except (OSError, ValueError, IndexError):
        return None


def environ_of(pid: int) -> dict[str, str]:
    found = {}
    try:
        raw = Path(f"/proc/{pid}/environ").read_bytes().decode("utf8", "replace")
    except OSError:
        return found
    for item in raw.split("\0"):
        key, sep, value = item.partition("=")
        if sep and key in ("OMP_SESSION_ID", "CLAUDE_SESSION_ID"):
            found[key] = value
    return found


def session_from_fds(pid: int, limit: int = 128) -> str:
    """The session id of the transcript this process holds open, or "".

    An `omp` started as `omp --resume <path>` carries no session id in its environment, and its
    command line is truncated in `ps`; the transcript it holds open names the session in full.
    """
    try:
        descriptors = os.listdir(f"/proc/{pid}/fd")
    except OSError:
        return ""
    for descriptor in descriptors[:limit]:
        try:
            target = os.readlink(f"/proc/{pid}/fd/{descriptor}")
        except OSError:
            continue
        if "/.omp/agent/sessions/" in target and target.endswith(".jsonl"):
            found = UUID_RE.findall(os.path.basename(target))
            if found:
                return found[0]
    return ""


def session_of(pid: int, depth: int = 12) -> str:
    """The agent session a process belongs to, read from the process and never guessed."""
    here = pid
    for _ in range(depth):
        if here <= 1:
            break
        environment = environ_of(here)
        for key in ("OMP_SESSION_ID", "CLAUDE_SESSION_ID"):
            if environment.get(key):
                return environment[key]
        if comm_of(here) in ("omp", "claude", "node", "bun"):
            found = UUID_RE.findall(cmdline_of(here))
            if found:
                return found[0]
            found_fd = session_from_fds(here)
            if found_fd:
                return found_fd
        here = ppid_of(here)
    return ""


def worker_of(pid: int, depth: int = 6) -> str:
    """The lane worker a process belongs to: its brief's name, its working directory, or "".

    A lane box runs one `omp` per worker under `w-<name>` of its tmux server, and the worker's
    name is in the brief path on its command line and in the directory it stands in. Both are
    read from the process; a box that is not a lane box simply has no match.
    """
    here = pid
    for _ in range(depth):
        if here <= 1:
            break
        found = WORKER_RE.search(cmdline_of(here))
        if found:
            return found.group(1)
        try:
            found = WORKER_RE.search(os.readlink(f"/proc/{here}/cwd") + "/")
            if found:
                return found.group(1)
        except OSError:
            pass
        here = ppid_of(here)
    return ""


def swap_of(pid: int) -> int:
    """VmSwap of a process, in bytes. /proc/<pid>/status is world-readable, so no sudo."""
    try:
        for line in Path(f"/proc/{pid}/status").read_text().splitlines():
            if line.startswith("VmSwap:"):
                return int(line.split()[1]) * 1024
    except (OSError, ValueError, IndexError):
        pass
    return 0


def rss_of(pid: int) -> int:
    try:
        for line in Path(f"/proc/{pid}/status").read_text().splitlines():
            if line.startswith("VmRSS:"):
                return int(line.split()[1]) * 1024
    except (OSError, ValueError, IndexError):
        pass
    return 0


def pids() -> list[int]:
    return [int(name) for name in os.listdir("/proc") if name.isdigit()]


def sample_cpu(seconds: float) -> tuple[list[dict], float]:
    """Per-process CPU over one short interval: (rows sorted by cores used, actual interval).

    A single `ps` column is useless here. The processes that filled this box's run queue were
    thousands of short-lived git, python and gzip children: every pid in a `ps` snapshot taken
    at 23:52Z was already gone at 23:53Z. A delta over an interval counts the work they did,
    and attributes what is left to the long-lived `omp` processes correctly.
    """
    before = {}
    for pid in pids():
        ticks = cpu_ticks_of(pid)
        if ticks is not None:
            before[pid] = ticks
    started = time.time()
    time.sleep(seconds)
    span = max(time.time() - started, 0.001)
    rows = []
    for pid, was in before.items():
        now = cpu_ticks_of(pid)
        if now is None or now <= was:
            continue
        rows.append({"pid": pid, "cores": (now - was) / CLOCK_TICK / span, "comm": comm_of(pid)})
    rows.sort(key=lambda row: -row["cores"])
    return rows, span


def sample_swap() -> list[dict]:
    rows = []
    for pid in pids():
        used = swap_of(pid)
        if used > 0:
            rows.append({"pid": pid, "swap": used, "comm": comm_of(pid)})
    rows.sort(key=lambda row: -row["swap"])
    return rows


def by_command(rows: list[dict], field: str) -> list[tuple[str, float, int]]:
    totals: dict[str, list[float]] = {}
    for row in rows:
        entry = totals.setdefault(row["comm"] or "?", [0.0, 0])
        entry[0] += row[field]
        entry[1] += 1
    ranked = [(name, total, int(count)) for name, (total, count) in totals.items()]
    ranked.sort(key=lambda item: -item[1])
    return ranked


def describe(pid: int) -> str:
    """One process, named the way a reader can act on it: lane worker, session, age."""
    parts = []
    worker = worker_of(pid)
    if worker:
        parts.append(f"lane {worker}")
    session = session_of(pid)
    if session:
        parts.append(f"session {session}")
    if not parts:
        command = cmdline_of(pid) or comm_of(pid)
        parts.append(command[:70] if command else "unknown")
    age = age_of(pid)
    if age:
        parts.append(f"up {human_time(age)}")
    return ", ".join(parts)


def agent_census() -> dict:
    """How many agents this box is carrying, and what they hold. The dial, on a lane box."""
    count = 0
    rss = swap = 0
    for pid in pids():
        if comm_of(pid) != "omp":
            continue
        count += 1
        rss += rss_of(pid)
        swap += swap_of(pid)
    return {"omp": count, "rss": rss, "swap": swap}


def consumers_text(options: argparse.Namespace) -> str:
    """The body of an alert: who is using the CPU now, and who holds the swap."""
    cpu_rows, span = sample_cpu(options.sample_seconds)
    swap_rows = sample_swap()
    cores = os.cpu_count() or 1
    census = agent_census()

    lines = [
        f"The box is carrying {census['omp']} omp processes holding {gib(census['rss'])} of RSS"
        f" and {gib(census['swap'])} of swap."
    ]
    ranked = by_command(cpu_rows, "cores")
    if ranked:
        share = ", ".join(
            f"{name} {total:.1f} cores ({100 * total / cores:.0f}% of the box, {count} processes)"
            for name, total, count in ranked[:5]
        )
        lines.append(f"CPU over a {span:.0f}s interval, by command: {share}.")
    if cpu_rows:
        lines.append(f"Top CPU processes over that interval (of {cores} cores):")
        for row in cpu_rows[: options.top]:
            lines.append(f"  pid {row['pid']} {row['comm']} {row['cores']:.2f} cores -- {describe(row['pid'])}")
    ranked_swap = by_command(swap_rows, "swap")
    if ranked_swap:
        share = ", ".join(f"{name} {gib(total)} ({count} processes)" for name, total, count in ranked_swap[:5])
        lines.append(f"Swap held, by command: {share}.")
    if swap_rows:
        lines.append("Top swap holders:")
        for row in swap_rows[: options.top]:
            lines.append(f"  pid {row['pid']} {row['comm']} {gib(row['swap'])} -- {describe(row['pid'])}")
    return "\n".join(lines)


# ------------------------------------------------------------------------------- state


class State:
    """The one file this watch owns: its samples and its open crossings.

    Opened under an exclusive, non-blocking flock for the whole run, so a hand run and the timer
    can never both decide that a crossing is new; the loser skips its period.
    """

    def __init__(self, path: Path) -> None:
        self.path = path
        path.parent.mkdir(parents=True, exist_ok=True)
        self.handle = open(path, "a+")
        try:
            fcntl.flock(self.handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
            self.locked = True
        except OSError:
            self.locked = False
            self.data = {}
            return
        self.handle.seek(0)
        try:
            self.data = json.loads(self.handle.read() or "{}")
        except ValueError:
            self.data = {}

    def commit(self, options: argparse.Namespace) -> None:
        if options.dry_run and not options.write_state:
            return
        self.handle.seek(0)
        self.handle.truncate()
        json.dump(self.data, self.handle, indent=1, sort_keys=True)
        self.handle.flush()
        os.fsync(self.handle.fileno())

    def close(self) -> None:
        try:
            self.handle.close()
        except OSError:
            pass


def swap_drain_rate(samples: list[list[float]], window: float) -> tuple[float | None, float]:
    """(bytes per second of swap free-space fall, actual measurement window)."""
    if len(samples) < 2:
        return None, 0.0
    now = samples[-1][0]
    anchor = samples[0]
    for sample in samples:
        if now - sample[0] <= window:
            anchor = sample
            break
    span = now - anchor[0]
    if span <= 0:
        return None, 0.0
    return (anchor[1] - samples[-1][1]) / span, span


# ------------------------------------------------------------------------------- the decision


# Each condition is judged apart and said apart. On 2026-10-30T01:32Z an escalation from
# ossv-agent-open read "STILL OUT OF CPU+SWAP" while that box carried load 27 on 32 cores with
# cpu some avg60 at 7%: a working box. The swap half was true and the CPU half had recovered
# half an hour before, because the headline named the union of everything the crossing had ever
# been rather than what was true at the time it spoke. A headline that overstates one half
# makes the next true alert cheaper to dismiss, which on these boxes is expensive: six lanes on
# that same machine lost an hour the night before by reading a working box as frozen.
HEADLINE = {
    "cpu": "BOX SHORT OF CPU",
    "swap": "BOX OUT OF SWAP",
    "memory": "BOX SHORT OF MEMORY",
}
STILL = {
    "cpu": "STILL SHORT OF CPU",
    "swap": "STILL OUT OF SWAP",
    "memory": "STILL SHORT OF MEMORY",
}


def verdict(now: dict, samples: list[list[float]], options: argparse.Namespace) -> dict:
    """What this box is short of, condition by condition, each with its own reasons."""
    cores = now["cores"]
    cpu_some = now["cpu"].get("some_avg60")
    findings: dict[str, dict] = {}

    # Two gates, because either on its own is wrong here. PSI alone called ossv-agent-open
    # starved at 7%; the run queue alone counts uninterruptible sleep and so cannot tell a box
    # short of CPU from one waiting on a disk. A load at or under the core count is a box whose
    # work fits on its cores, whatever its pressure reads.
    if cpu_some is not None:
        if cpu_some >= options.cpu_stall and now["load1"] > cores:
            findings["cpu"] = {
                "reasons": [
                    f"cpu pressure some avg60 is {cpu_some:.0f}%, at or over the"
                    f" {options.cpu_stall:.0f}% rule, with load {now['load1']:.0f} over"
                    f" {cores} cores: that share of the last minute had a task runnable and"
                    f" waiting for a CPU, on a box carrying more than it has cores"
                ]
            }
    elif now["procs_running"] >= options.queue_per_core * cores:
        # A kernel without PSI. The run queue alone is a coarser instrument, so it is the
        # fallback and never the primary: it says how many want a CPU, not how long they waited.
        findings["cpu"] = {
            "reasons": [
                f"no PSI on this kernel; {now['procs_running']} runnable processes on {cores}"
                f" cores, at or over the {options.queue_per_core:.1f} per core fallback rule"
            ]
        }

    drain, drain_window = swap_drain_rate(samples, options.rate_window)
    time_to_exhaustion = None
    if drain and drain > 0 and now["swap_free"] > 0:
        time_to_exhaustion = now["swap_free"] / drain
    # The swap rule asks nothing about CPU. Swap with nothing left is a statement about the next
    # memory squeeze, not about this minute, and it is worth saying on a box that is otherwise
    # idle: from there the kernel's next reclaim has nowhere to go but the OOM killer.
    if now["swap_total"]:
        if now["swap_used_fraction"] >= options.swap_used:
            findings["swap"] = {
                "reasons": [
                    f"swap is {100 * now['swap_used_fraction']:.1f}% used ({gib(now['swap_free'])}"
                    f" free of {gib(now['swap_total'])}), at or over the"
                    f" {100 * options.swap_used:.0f}% rule"
                ]
            }
        elif time_to_exhaustion is not None and time_to_exhaustion < options.horizon:
            findings["swap"] = {
                "reasons": [
                    f"swap is draining at {gib(drain * 3600)}/h over the last"
                    f" {human_time(drain_window)}, {human_time(time_to_exhaustion)} from exhaustion"
                ]
            }

    if now["mem_available"] and now["mem_available"] < options.mem_floor:
        findings["memory"] = {
            "reasons": [
                f"MemAvailable is {gib(now['mem_available'])}, under the"
                f" {gib(options.mem_floor)} floor"
            ]
        }

    return {
        "crossing": bool(findings),
        "findings": findings,
        "kinds": sorted(findings),
        "reasons": [reason for found in findings.values() for reason in found["reasons"]],
        "time_to_exhaustion": time_to_exhaustion,
        "swap_drain": drain,
        "swap_drain_window": drain_window,
    }


def clears(kind: str, now: dict, options: argparse.Namespace) -> bool:
    """Hysteresis, per condition: it clears well clear of what opened it, never on the rule."""
    if kind == "cpu":
        cpu_some = now["cpu"].get("some_avg60")
        if cpu_some is None:
            return now["procs_running"] < options.queue_per_core * now["cores"] * options.clear_factor
        return cpu_some < options.cpu_stall * options.clear_factor or now["load1"] <= now["cores"]
    if kind == "swap":
        return not now["swap_total"] or now["swap_used_fraction"] < options.swap_used * options.clear_factor
    if kind == "memory":
        return not now["mem_available"] or now["mem_available"] >= options.mem_floor / options.clear_factor
    return True


def state_line(now: dict) -> str:
    cpu = now["cpu"].get("some_avg60")
    io = now["io"].get("some_avg60")
    memory = now["memory_pressure"].get("full_avg60")
    pieces = [
        f"load {now['load1']:.0f}/{now['load5']:.0f}/{now['load15']:.0f} on {now['cores']} cores",
        f"{now['procs_running']} runnable, {now['procs_blocked']} blocked",
    ]
    if cpu is not None:
        pieces.append(f"cpu some avg60 {cpu:.0f}%")
    if io is not None:
        pieces.append(f"io some avg60 {io:.0f}%")
    if memory is not None:
        pieces.append(f"memory full avg60 {memory:.1f}%")
    if now["swap_total"]:
        pieces.append(
            f"swap {100 * now['swap_used_fraction']:.1f}% used ({gib(now['swap_free'])} free)"
        )
    pieces.append(f"MemAvailable {gib(now['mem_available'])}")
    return ", ".join(pieces)


def what_it_means(kind: str) -> list[str]:
    """What this condition is, and what to do about it. One condition, one action."""
    if kind == "cpu":
        return [
            "What this looks like from a pane: every agent still runs and answers, its"
            " transcript is still written, and tmux still paints -- but a turn that takes"
            " seconds takes tens of minutes, so the lane reads as frozen. Do not restart an"
            " agent on this signal: a restart costs its turn and adds another working set to"
            " the same box.",
            "DO: reduce the number of concurrent agents on this box (on a lane box,"
            " `ossv-worker list` and stop or pause the lanes that are idle or duplicated), then"
            " let the swapped working sets fault back in. Move new work to a box with free"
            " cores rather than raising the limit here.",
        ]
    if kind == "swap":
        return [
            "What this is: a statement about the NEXT memory squeeze, not about this minute."
            " The box may be answering perfectly while this is true. With no swap left the"
            " kernel's next reclaim has nowhere to put anything, so the OOM killer chooses"
            " which lane dies, and it does not choose the idle one.",
            "DO: stop the sessions on this box that have finished, by exact pid and with their"
            " owner asked first; each one hands back the swap it holds. Nothing here needs a"
            " restart of the box or of a live lane.",
        ]
    return [
        "What this is: the box is close to having no memory to give, which is the step after"
        " swap is gone. An OOM kill takes a whole session and every lane inside it.",
        "DO: stop finished sessions by exact pid, owner asked first, and move new work"
        " elsewhere until MemAvailable recovers.",
    ]


def alert_text(now: dict, kind: str, found: dict, incident: dict, consumers: str, when: float) -> str:
    cpu = now["cpu"].get("some_avg60")
    io = now["io"].get("some_avg60")
    memory = now["memory_pressure"].get("full_avg60")
    which = ""
    if kind == "cpu" and cpu is not None and io is not None and memory is not None:
        which = (
            f" Of the three pressures, cpu is {cpu:.0f}%, io {io:.0f}% and memory {memory:.1f}%:"
            f" {'a CPU shortage' if cpu >= max(io, memory) else 'not primarily a CPU shortage'}."
        )
    lines = [
        f"{HEADLINE[kind]}: {socket.gethostname()} has {state_line(now)}.{which}",
        "Why this alerts: " + "; ".join(found["reasons"]) + ".",
        f"This {kind} crossing opened at {iso(incident.get('opened_at'))},"
        f" {human_time(when - (incident.get('opened_at') or when))} ago."
        " Every other condition on this box is reported on its own, so this message says"
        " nothing about them.",
        consumers,
        *what_it_means(kind),
        "This watch only detects. It kills nothing, stops no worker, and changes no limit."
        f" From load-swap-watch (~/.dotfiles/scripts/load-swap-watch) on {socket.gethostname()},"
        " a systemd --user timer.",
    ]
    return "\n".join(lines)


def clear_text(now: dict, kind: str, incident: dict, when: float) -> str:
    opened = incident.get("opened_at") or when
    return (
        f"{HEADLINE[kind]} CLEARED: {socket.gethostname()} is back to {state_line(now)}."
        f" That {kind} crossing opened at {iso(opened)}, cleared at {iso(when)}, and lasted"
        f" {human_time(when - opened)}. No action is needed, and any other condition on this box"
        f" stands or clears on its own. From load-swap-watch on {socket.gethostname()}."
    )


def tell_box_health(envoy: Envoy, text: str) -> str:
    """Tell the box-health lead, and say who heard it.

    The role is the address while somebody holds it; an unheld role answers non-200, and the
    INFRA lead's session hears it instead.
    """
    if envoy.publish(BOX_HEALTH_ROLE_TOPIC, text):
        return BOX_HEALTH_ROLE_TOPIC
    if envoy.send(INFRA_LEAD, text):
        return INFRA_LEAD
    return ""


# ------------------------------------------------------------------------------- one run


def run_once(options: argparse.Namespace) -> int:
    when = time.time()
    envoy = Envoy(timeout=options.http_timeout)
    state = State(options.state)
    if not state.locked:
        log(f"another run holds {options.state}; skipping this period")
        return 0

    now = sample_box()
    samples: list = state.data.setdefault("samples", [])
    samples.append([now["at"], now["swap_free"]])
    cutoff = now["at"] - max(options.rate_window * 3, 7200)
    state.data["samples"] = [sample for sample in samples if sample[0] >= cutoff][-512:]
    state.data["last_run"] = now["at"]
    state.data["last_state"] = state_line(now)

    found = verdict(now, state.data["samples"], options)
    log(state_line(now))

    # One incident per condition. They open, alert, escalate and clear on their own clocks, so
    # a CPU shortage that recovered can never be carried into a swap message half an hour later.
    incidents: dict = state.data.setdefault("incidents", {})
    # The single-incident state of the first version: keep nothing from it but its timestamps,
    # so an upgrade neither re-alerts what was already said nor loses an open crossing.
    legacy = state.data.pop("incident", None)
    if legacy and legacy.get("opened_at"):
        for kind in legacy.get("kinds") or []:
            incidents.setdefault(kind, dict(legacy, kinds=[kind]))
    heard: list[str] = []
    unheard = 0
    messages: list[str] = []
    consumers = ""

    def consumers_once() -> str:
        # The 10 s CPU sample and the VmSwap walk happen at most once per run, however many
        # conditions speak in it.
        nonlocal consumers
        if not consumers:
            consumers = consumers_text(options)
        return consumers

    for kind in ("cpu", "swap", "memory"):
        finding = found["findings"].get(kind)
        incident = incidents.get(kind) or {}
        if finding:
            if not incident:
                incident = {"opened_at": when, "alerted_at": None, "escalated_at": None}
                log(f"{kind} crossing opened: {'; '.join(finding['reasons'])}")
            incident["last_seen"] = when
            held = when - (incident.get("opened_at") or when)
            if incident.get("alerted_at") is None and held >= options.grace:
                text = alert_text(now, kind, finding, incident, consumers_once(), when)
                incident["alerted_at"] = when
                incidents[kind] = incident
                state.commit(options)
                messages.append(text)
                if not options.dry_run:
                    target = tell_box_health(envoy, text)
                    if target:
                        heard.append(target)
                    else:
                        unheard += 1
            elif (
                incident.get("alerted_at")
                and incident.get("escalated_at") is None
                and when - incident["alerted_at"] >= options.escalate
            ):
                text = (
                    f"{STILL[kind]} {human_time(when - incident['alerted_at'])} after the first"
                    f" alert: {socket.gethostname()} has {state_line(now)}."
                    f" Why it still holds: {'; '.join(finding['reasons'])}."
                    " Nobody has brought the box back. This message is about that one condition"
                    " as it reads now, and about nothing else on the box.\n"
                    + consumers_once()
                )
                incident["escalated_at"] = when
                incidents[kind] = incident
                state.commit(options)
                messages.append(text)
                if not options.dry_run:
                    # The send's own answer decides, not the attempt. An escalation that says it
                    # was told while the listener refused it is the silent failure this watch
                    # exists to stop seeing elsewhere.
                    if envoy.send(CHIEF_OF_STAFF, text):
                        heard.append(CHIEF_OF_STAFF)
                    else:
                        unheard += 1
            else:
                # Say what this run is waiting for, which is not the grace window once the alert
                # has gone: a reader should be able to tell "not yet alerted" from "alerted,
                # waiting on the escalation" from "said everything it has to say".
                if incident.get("escalated_at"):
                    waiting = (
                        f"alerted at {iso(incident['alerted_at'])},"
                        f" escalated at {iso(incident['escalated_at'])}"
                    )
                elif incident.get("alerted_at"):
                    waiting = (
                        f"alerted at {iso(incident['alerted_at'])}; escalation at"
                        f" {iso(incident['alerted_at'] + options.escalate)}"
                    )
                else:
                    waiting = f"alert at {iso((incident.get('opened_at') or when) + options.grace)}"
                log(f"{kind} crossing open for {human_time(held)}; {waiting}")
            incidents[kind] = incident
        elif incident:
            if clears(kind, now, options):
                if incident.get("alerted_at"):
                    text = clear_text(now, kind, incident, when)
                    messages.append(text)
                    if not options.dry_run:
                        target = tell_box_health(envoy, text)
                        if target:
                            heard.append(target)
                        else:
                            unheard += 1
                log(f"{kind} crossing cleared after {human_time(when - (incident.get('opened_at') or when))}")
                incidents.pop(kind, None)
            else:
                log(f"{kind} is under its rule but not yet clear of it; the crossing stays open")
                incident["last_seen"] = when
                incidents[kind] = incident

    state.commit(options)
    state.close()
    if messages and (options.print_alert or options.dry_run):
        print("\n\n".join(messages))
    for target in heard:
        log(f"told {target}")
    if unheard:
        # Every route refused it. The state already records the alert as made, so this line is
        # the only trace that it reached nobody: a detector whose delivery fails quietly is
        # worse than no detector, because the record says someone was told.
        log(f"NOBODY HEARD IT: {unheard} message(s) refused by every Envoy route; see above")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument(
        "--cpu-stall",
        type=float,
        default=CPU_STALL,
        help=(
            "alert when /proc/pressure/cpu some avg60 is at or over this percentage AND load is"
            f" over the core count (default {CPU_STALL:.0f})"
        ),
    )
    parser.add_argument(
        "--queue-per-core",
        type=float,
        default=3.0,
        help="fallback rule on a kernel without PSI: runnable processes per core (default 3)",
    )
    parser.add_argument(
        "--swap-used",
        type=float,
        default=0.85,
        help="alert when this fraction of swap is in use (default 0.85)",
    )
    parser.add_argument(
        "--mem-floor",
        type=float,
        default=8 * GIB,
        help="alert when MemAvailable falls under this many bytes (default 8 GiB)",
    )
    parser.add_argument(
        "--horizon",
        type=float,
        default=7200.0,
        help="alert when swap is draining and reaches zero inside this many seconds (default 2 h)",
    )
    parser.add_argument(
        "--rate-window",
        type=float,
        default=3600.0,
        help="window of this watch's own samples the swap drain rate is measured over (default 1 h)",
    )
    parser.add_argument(
        "--grace",
        type=float,
        default=600.0,
        help="a crossing must hold this long before it alerts (default 600 s)",
    )
    parser.add_argument(
        "--escalate",
        type=float,
        default=1800.0,
        help="tell the chief of staff when a crossing is still open this long after its alert (default 30 min)",
    )
    parser.add_argument(
        "--clear-factor",
        type=float,
        default=0.7,
        help="hysteresis: a crossing clears at this fraction of the rule that opened it (default 0.7)",
    )
    parser.add_argument(
        "--sample-seconds",
        type=float,
        default=10.0,
        help="interval the per-process CPU delta in an alert is measured over (default 10 s)",
    )
    parser.add_argument("--top", type=int, default=8, help="processes named per list in an alert (default 8)")
    parser.add_argument("--state", type=Path, default=DEFAULT_STATE, help=f"state file (default {DEFAULT_STATE})")
    parser.add_argument("--http-timeout", type=float, default=8.0, help="Envoy request timeout (default 8 s)")
    parser.add_argument("--dry-run", action="store_true", help="decide and print, send nothing, write no state")
    parser.add_argument("--write-state", action="store_true", help="with --dry-run, still write the state file")
    parser.add_argument("--print-alert", action="store_true", help="print an alert to stdout as well as sending it")
    parser.add_argument(
        "--consumers",
        action="store_true",
        help="print who is using the CPU and holding the swap now, and exit; decides nothing",
    )
    parser.add_argument("--json", action="store_true", help="with --consumers, print one JSON object")
    options = parser.parse_args()

    if options.consumers:
        if options.json:
            cpu_rows, span = sample_cpu(options.sample_seconds)
            print(
                json.dumps(
                    {
                        "box": sample_box(),
                        "census": agent_census(),
                        "cpu_interval": span,
                        "cpu": [
                            dict(row, who=describe(row["pid"])) for row in cpu_rows[: options.top]
                        ],
                        "swap": [
                            dict(row, who=describe(row["pid"])) for row in sample_swap()[: options.top]
                        ],
                    },
                    indent=1,
                )
            )
        else:
            print(state_line(sample_box()))
            print(consumers_text(options))
        return 0
    return run_once(options)


if __name__ == "__main__":
    sys.exit(main())
