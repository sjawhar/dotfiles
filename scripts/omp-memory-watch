#!/usr/bin/env python3
"""Warn an agent session before the kernel OOM-kills it, while it can still shed work.

Why this exists: on 2026-10-27T05:55:14Z the kernel OOM-killed the Verified Linux owner
session (pid 3398496, `omp`, anon-rss 15522968 kB) inside its own systemd scope,
/user.slice/user-1000.slice/user@1000.service/app.slice/run-u174595.scope, whose MemoryMax
is 24 GiB (`memory: usage 25165824kB, limit 25165824kB, failcnt 121421`). About 40 in-session
subagent lanes died with it and nothing warned first. (dispatch://INFRA-602)

What this watch is NOT: it kills nothing and sheds nothing. Prevention belongs to the session --
a session's own self-watch (for example /mnt/nvme/sami/tmp/verified-linux/handover/ol-rss-watch.sh,
which warns at 10 GiB of omp RSS) warns first and the session sheds its own lanes. This watch
detects, and alerts the session itself and its stream lead.

It acts in two bounded ways (Sami, 2026-11-02 01:00Z: kill the runaway subprocess instead of the
whole session, and restart the sessions that did die):

  * oom bias (`oom_bias_pass`, off with --no-oom-bias): every process in a capped omp scope except
    the session's own omp is raised to oom_score_adj +500, so when the scope reaches its ceiling
    the kernel kills the runaway child, not the session;
  * pane restart (`restart_pass`, off with --no-restart, a dry run with --restart-dry-run): a
    tmux pane whose omp died without a normal `session_exit` is resumed in place.

What the alerting part of one run does, with /proc and /sys reads only, no transcript reading
and no model call:

  1. Find every `omp` process on this machine and the systemd scope each one runs in
     (/proc/<pid>/cgroup). `shims/omp` starts each session under
     `systemd-run --user --scope -p MemoryMax=$OMP_MEMORY_MAX -p MemorySwapMax=0`, so the
     scope -- not the process -- is what the kernel's memcg OOM killer measures.
  2. For each such scope, read the limit it is heading for: the smallest numeric `memory.max`
     from the scope up to the cgroup root. When every level says `max`, the ceiling is the
     machine's RAM and a crossing there is a box-wide OOM, which is said in the alert.
  3. Read what the kernel cannot reclaim: `anon + shmem + kernel + sock` from the scope's
     memory.stat. A scope `shims/omp` starts carries MemorySwapMax=0, so its anonymous memory
     cannot be paged out even though the box now has a 64 GiB swap file: file cache is the only
     reclaimable part of its memory.current and must not count towards the ceiling. (A scope
     that `ossv-worker` starts sets MemoryMax alone and leaves memory.swap.max at `max`, so its
     anonymous memory CAN be paged out; the watch reads memory.swap.max per scope and says which
     shape it is, rather than claiming MemorySwapMax=0 for every scope.) This is a better
     predictor than the omp process's RSS: at the 05:55:14Z kill the omp process held
     14.9 GiB of the 24 GiB that hit the ceiling and 20 python3 tool subprocesses in the same
     scope held the rest, so an RSS threshold alone would have been watching 62% of the number
     the kernel was about to compare.
  4. A scope is CROSSING while that number is at or above `--fraction` of its limit. It must
     stay so for the grace window (default 60 s) before it alerts, so one transient compile
     does not fire. It clears below `--clear-fraction` of the limit, or when the process ends.
  5. Separately, and with no hold at all, a scope that REACHES its wall is reported: the `max`
     counter of its memory.events rises (the kernel refused an allocation at memory.max and had
     to reclaim), or memory.peak crosses `--wall-fraction` of the ceiling. Steps 3 and 4 miss
     this whenever the pressure is reclaimable: on ossv-agent-open on 2026-10-30, 31 of 95
     worker scopes had touched their 24 GiB wall while every one of them sat under the 45%
     sampling level on unreclaimable memory, and only 4 were ever reported. A touch is rate
     limited to one report per scope per `--wall-cooldown` (default 15 min); the session owning
     the scope gets the whole report, and the box-health owner gets one batched digest of every
     touch per `--wall-digest` window, so no touch is lost and no lane storms the owner.

Alerts go over Envoy to agent sessions only, never to a person: the session itself (so it can
checkpoint and shed on its own terms) and the box-health owner -- the holder of the
`lead-box-health` Envoy role, and the SRE session when nobody holds it. The escalation, when a
crossing is still open and still rising 10 minutes later, goes to the same owner.
"""

from __future__ import annotations

import argparse
import fcntl
import importlib.machinery
import importlib.util
import json
import os
import re
import shlex
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

# Kept ONLY for omp-box-memory-guard's --protect list and its own alerts, which import it as
# watch.INFRA_LEAD: this watch tells the INFRA lead nothing. It owned this detector and handed
# box health to the SRE on 2026-10-31.
INFRA_LEAD = "01a13c57-d826-7242-80fe-5f0670188b11"

# Kept ONLY for omp-box-memory-guard's --protect list, which imports it as watch.CHIEF_OF_STAFF:
# this watch tells the chief of staff nothing. Box health is the SRE session's (Sami,
# 2026-10-31: "There's an SRE. They can handle it.").
CHIEF_OF_STAFF = "01a13dca-e979-7264-af32-f654ef57a6f5"

# Box health belongs to the box-health lead's Envoy role (dispatch://INFRA-716), and to the SRE
# session when nobody holds that role.
BOX_HEALTH_ROLE_TOPIC = "notifications.role.lead-box-health"
SRE = "01a18385-f8c8-74a9-b6ff-694fb5fe87a7"

# Where the state file goes. /mnt/nvme/sami/tmp is the agent devboxes' scratch on the big disk;
# an agent box without it keeps the state under ~/.local/state, which every XDG machine has.
# Measured 2026-10-30 on ossv-agent-open..open6, ossv-agent-git and ossv-agent-repo: /mnt/nvme
# there is a root-owned 755 directory on the root filesystem with no sami/tmp under it, so this
# watch crashed on its first run of every one of them with PermissionError. The test is
# writability, not existence: the path can be a directory this user still cannot write into, and
# `--state` cannot be the answer, since a non-default state file forces --dry-run and the watch
# would then be armed and permanently silent.
_NVME_STATE = Path("/mnt/nvme/sami/tmp/omp-memory-watch/state.json")
DEFAULT_STATE = (
    _NVME_STATE
    if os.access("/mnt/nvme/sami/tmp", os.W_OK)
    else Path(os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local/state"))) / "omp-memory-watch/state.json"
)
DEFAULT_ENVOY_URL = "http://127.0.0.1:9020"
SESSION_ROOT = Path.home() / ".omp/agent/sessions"
# Where this copy runs from. A VM runs it from a versioned path under /opt, never from the
# dotfiles checkout, and an alert that named the checkout sent its reader to the wrong file.
SELF_PATH = os.path.realpath(__file__)
CGROUP_ROOT = Path("/sys/fs/cgroup")
GIB = 1073741824

UUID_RE = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}")
# A session's own memory self-watch, recognised by its command line. The known one is
# ol-rss-watch.sh; the pattern is deliberately wide, and a miss is reported as "could not tell",
# never as "has none".
SELF_WATCH_RE = re.compile(r"(?i)(rss|mem|memory|oom)[-_]?(watch|guard|watchdog|limit)")


def log(message: str) -> None:
    stamp = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    print(f"{stamp} {message}", flush=True)


def iso(epoch: float | None) -> str:
    if not epoch:
        return "unknown"
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(epoch))


def human(seconds: float) -> str:
    seconds = int(seconds)
    if seconds < 90:
        return f"{seconds} s"
    minutes, rest = divmod(seconds, 60)
    if minutes < 90:
        return f"{minutes} min {rest} s"
    hours, minutes = divmod(minutes, 60)
    return f"{hours} h {minutes} min"


def gib(value: float) -> str:
    return f"{value / GIB:.2f} GiB"


# --------------------------------------------------------------------------- Envoy transport


class Envoy:
    """The listener this machine's sessions use, resolved the way scripts/envoy resolves it."""

    def __init__(self, timeout: float = 8.0) -> None:
        path = os.environ.get("ENVOY_CONFIG_FILE") or str(
            Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config")))
            / "legion/envoy.json"
        )
        config: dict = {}
        try:
            config = json.loads(Path(path).read_text()).get("envoy") or {}
        except (OSError, ValueError):
            config = {}
        if config.get("enabled") is False:
            raise SystemExit(f"{path} sets envoy.enabled to false: Envoy is off")
        self.url = (os.environ.get("ENVOY_URL") or config.get("url") or DEFAULT_ENVOY_URL).rstrip("/")
        self.timeout = timeout
        token = os.environ.get("ENVOY_TOKEN") or config.get("token") or ""
        if token.startswith("!"):
            try:
                done = subprocess.run(
                    ["/bin/sh", "-c", token[1:]],
                    capture_output=True,
                    text=True,
                    timeout=10,
                    stdin=subprocess.DEVNULL,
                )
                token = done.stdout.strip() if done.returncode == 0 else ""
            except (OSError, subprocess.SubprocessError):
                token = ""
        self.token = token

    def request(self, method: str, path: str, body: dict | None = None) -> tuple[int, dict | list]:
        data = json.dumps(body).encode() if body is not None else None
        request = urllib.request.Request(self.url + path, data=data, method=method)
        if data is not None:
            request.add_header("Content-Type", "application/json")
        if self.token:
            request.add_header("Authorization", f"Bearer {self.token}")
        try:
            with urllib.request.urlopen(request, timeout=self.timeout) as answer:
                raw = answer.read().decode() or "{}"
                return answer.status, json.loads(raw)
        except urllib.error.HTTPError as error:
            raw = error.read().decode() or "{}"
            try:
                return error.code, json.loads(raw)
            except ValueError:
                return error.code, {"error": raw.strip()}
        except (urllib.error.URLError, socket.timeout, ValueError, OSError) as error:
            return 0, {"error": str(error)}

    def send(self, session_id: str, message: str) -> bool:
        status, body = self.request(
            "POST",
            "/v1/messages/send",
            {"target_session": session_id, "message": message, "source": "envoy"},
        )
        if status != 200:
            log(f"  send to {session_id} failed: {status} {body}")
        return status == 200

    def publish(self, topic: str, message: str) -> bool:
        status, body = self.request(
            "POST",
            "/v1/messages/publish",
            {"topic": topic, "message": message, "source": "envoy"},
        )
        if status != 200:
            log(f"  publish to {topic} failed: {status} {body}")
        return status == 200


# The sessions Envoy has live on THIS box, filled at most once per run and only when a wall
# report is about to name one. Empty with LIVE_READ False means "not looked up", which reads as
# "cannot verify" and never as "nothing is live".
#
# Why this watch needs it: a session id taken from an `omp --resume <path>` command line is the
# id the session directory was CREATED with, and a resume gets a new one. On ossv-agent-repo on
# 2026-10-30 that stale id was 01a14b36 (VERIFY, which runs on sami-rocqperf) while the live
# owner was 01a14b84 -- and load-swap-watch sent its 20:17:23Z alert to the wrong box's session
# for exactly that reason. A worker's own `.ossv-workers/<name>/session` file, which this watch
# prefers, follows a resume and does not have the defect; the fallback does.
LIVE_SESSIONS: dict[str, dict] = {}
LIVE_READ = False


def this_box(host: str) -> bool:
    """Whether an Envoy session row's host is this machine, by its first label."""
    if not host:
        return False
    mine = socket.gethostname()
    return host == mine or host.split(".")[0] == mine.split(".")[0]


def refresh_live_sessions(envoy: Envoy) -> None:
    """Ask Envoy which sessions are live on this box. One GET, at most once per run."""
    global LIVE_READ
    status, body = envoy.request("GET", "/v1/sessions")
    if status != 200 or not isinstance(body, list):
        log(f"  live sessions unavailable: GET /v1/sessions answered {status}; attribution unverified")
        return
    LIVE_SESSIONS.clear()
    for row in body:
        if isinstance(row, dict) and row.get("session_id") and this_box(str(row.get("host") or "")):
            LIVE_SESSIONS[str(row["session_id"])] = row
    LIVE_READ = True
    log(f"  {len(LIVE_SESSIONS)} session(s) live on this box, of {len(body)} Envoy knows")


def verify_touch_session(envoy: Envoy, touch: dict) -> None:
    """Check the touch's session id against what is live here, and retarget when it is wrong.

    A report sent to a session id that is not live on this box does not reach a silent owner:
    it reaches whoever holds that id somewhere else. So a claim that cannot be verified here is
    replaced by the live owner when one can be named, and the report says what happened.
    """
    if not LIVE_READ:
        refresh_live_sessions(envoy)
    claim = touch.get("session") or ""
    if not LIVE_READ:
        touch["session_note"] = ""
        return
    if claim and claim in LIVE_SESSIONS:
        touch["session_note"] = ""
        return
    owner = ""
    if touch.get("worker_session") and touch["worker_session"] in LIVE_SESSIONS:
        owner = touch["worker_session"]
    elif len(LIVE_SESSIONS) == 1:
        owner = next(iter(LIVE_SESSIONS))
    touch["session_claim"] = claim
    touch["session"] = owner
    if claim and owner:
        touch["session_note"] = (
            f" The id {claim} on this scope's processes is not live on this box -- an"
            " `omp --resume` keeps the session directory's original id, and an inherited"
            f" OMP_SESSION_ID names whoever started the box -- so this went to {owner}, the live"
            " owner here."
        )
    elif claim:
        touch["session_note"] = (
            f" The id {claim} on this scope's processes is not live on this box and no live"
            " session here could be matched to it, so nobody was told directly."
        )
    else:
        touch["session_note"] = ""


# ------------------------------------------------------------------ this machine's omp scopes


def read_int(path: Path) -> int | None:
    try:
        text = path.read_text().strip()
    except OSError:
        return None
    if text == "max":
        return None
    try:
        return int(text)
    except ValueError:
        return None


def mem_total() -> int:
    try:
        for line in Path("/proc/meminfo").read_text().splitlines():
            if line.startswith("MemTotal:"):
                return int(line.split()[1]) * 1024
    except (OSError, ValueError, IndexError):
        pass
    return 0


def cgroup_of(pid: int) -> str:
    """The cgroup v2 path of a pid, as written in /proc/<pid>/cgroup ("0::/user.slice/...")."""
    try:
        for line in Path(f"/proc/{pid}/cgroup").read_text().splitlines():
            parts = line.split(":", 2)
            if len(parts) == 3 and parts[0] == "0":
                return parts[2].strip()
    except OSError:
        pass
    return ""


def effective_limit(cgroup: str) -> tuple[int, str, bool]:
    """(ceiling in bytes, where it comes from, whether the session has a cap of its OWN).

    The ceiling is the smallest numeric `memory.max` from this cgroup up to the root. A scope
    started by `shims/omp` carries MemoryMax, and since 2026-10-27 `user-1000.slice` carries a
    box-level one too (installers/omp-box-memory-guard.sh): 232 GiB, so the user's sessions
    together can never take the RAM the system's daemons need.

    The third value is whether THIS cgroup -- not an ancestor -- carries the limit. That is
    what decides how a session is measured: a session in a scope of its own is measured on the
    scope, while one that only inherits the slice's ceiling shares that ceiling with every
    other session in the login and is measured on its own process instead. Before the slice
    had a ceiling the two tests were the same; with one, charging a session the whole login
    scope's memory against a 232 GiB slice would warn on nothing at all.
    """
    best: int | None = None
    where = ""
    parts = [p for p in cgroup.strip("/").split("/") if p]
    path = CGROUP_ROOT
    for part in [""] + parts:
        path = path / part if part else path
        value = read_int(path / "memory.max")
        if value is not None and (best is None or value < best):
            best, where = value, part or "(cgroup root)"
    own = read_int(CGROUP_ROOT / cgroup.strip("/") / "memory.max") is not None
    if best is None:
        return mem_total(), "no cgroup limit anywhere in the chain: the machine's RAM", False
    return best, f"memory.max of {where}", own


def scope_pressure(cgroup: str) -> tuple[int, int, dict[str, int]]:
    """(unreclaimable bytes, memory.current, the memory.stat fields behind them).

    Unreclaimable is anon + shmem + kernel + sock. In a cgroup that `shims/omp` starts with
    MemorySwapMax=0 that is exact: its anonymous memory cannot be paged out even though the box
    now has swap, so file cache is the only part of memory.current the kernel can give back, and
    counting cache towards the ceiling would alert on a scope in no danger. A caller measuring a
    cgroup that CAN swap (a slice with no MemorySwapMax) gets a conservative over-estimate of the
    danger, which is the safe direction for a guard.
    """
    directory = CGROUP_ROOT / cgroup.strip("/")
    current = read_int(directory / "memory.current") or 0
    fields: dict[str, int] = {}
    try:
        for line in (directory / "memory.stat").read_text().splitlines():
            key, _, value = line.partition(" ")
            if key in ("anon", "file", "kernel", "sock", "shmem", "slab"):
                fields[key] = int(value)
    except (OSError, ValueError):
        return current, current, fields
    unreclaimable = fields.get("anon", 0) + fields.get("shmem", 0) + fields.get("kernel", 0) + fields.get("sock", 0)
    return min(unreclaimable, current), current, fields


def memory_events(cgroup: str) -> dict[str, int]:
    """The scope's memory.events counters, keyed by name ("max", "oom", "oom_kill", ...).

    `max` counts the times the kernel refused an allocation at memory.max and had to reclaim to
    satisfy it: a scope whose `max` rises has REACHED its wall, whatever its unreclaimable
    memory reads. It is the only signal that does not need the pressure to be held: a worker
    that goes from comfortable to the ceiling and back inside one 30 s period leaves no other
    trace short of an OOM kill.
    """
    counters: dict[str, int] = {}
    try:
        for line in (CGROUP_ROOT / cgroup.strip("/") / "memory.events").read_text().splitlines():
            key, _, value = line.partition(" ")
            try:
                counters[key] = int(value)
            except ValueError:
                continue
    except OSError:
        pass
    return counters


def swap_setting(cgroup: str) -> str:
    """The scope's memory.swap.max as written ("0", "max", a byte count), or "" when unreadable.

    The alert says a scope's anonymous memory cannot be paged out only when this reads 0. A
    scope `shims/omp` starts carries MemorySwapMax=0 and a scope `ossv-worker` starts does not,
    and the alert used to claim the first of both.
    """
    try:
        return (CGROUP_ROOT / cgroup.strip("/") / "memory.swap.max").read_text().strip()
    except OSError:
        return ""


def swap_sentence(swap_max: str) -> str:
    """What this run can truthfully say about the scope's swap, from memory.swap.max alone."""
    if swap_max == "0":
        return " This scope's memory.swap.max is 0, so the rest it cannot page out."
    if swap_max == "max":
        return (
            " This scope's memory.swap.max is `max`, so its anonymous memory CAN be paged out to"
            " the box's swap -- which is why its unreclaimable number can sit low while the scope"
            " still reaches its wall."
        )
    if swap_max:
        return f" This scope's memory.swap.max is {swap_max}, so some of the rest can be paged out."
    return " This scope's memory.swap.max could not be read, so nothing is claimed about its swap."


# A worker's name, as `ossv-worker` writes it into every path under its state root: the omp
# process of worker `c-asan` is started with `@<root>/.ossv-workers/c-asan/message-resume-0.md`
# and works under `<home>/work/workers/c-asan/`. Taking it from the command line means no path
# is hard-coded here and the directory it names can be read for the worker's session id.
# `\S*` would swallow omp's `@` prompt-file prefix into the path, so the directory starts at a
# `/` and holds no `@`.
WORKER_RE = re.compile(r"(?P<dir>(?P<root>/[^\s@]*?/\.ossv-workers)/(?P<name>[^/\s]+))(?:/|\s|$)")


def worker_of(pids: list[int]) -> tuple[str, str]:
    """(worker name, its state directory) for the first process in the scope that names one."""
    for pid in pids:
        found = WORKER_RE.search(cmdline_of(pid))
        if found:
            return found.group("name"), found.group("dir")
    return "", ""


def worker_session(directory: str) -> str:
    """The session id `ossv-worker` recorded for this worker, when it has confirmed one.

    `session_unconfirmed` beside it means `$d/session` still names the PREVIOUS session (the
    worker's own rule), so it is not used then: a wrong session id sends an owner to checkpoint
    a session that is not theirs.
    """
    if not directory:
        return ""
    try:
        if (Path(directory) / "session_unconfirmed").exists():
            return ""
        found = UUID_RE.findall((Path(directory) / "session").read_text())
    except OSError:
        return ""
    return found[0] if found else ""


# What the memory.stat fields mean to the reader of an alert. `kernel` already covers `slab`,
# so slab is named only to say how much of the kernel number it is.
STAT_MEANING = {
    "anon": "anonymous memory the processes allocated (heaps, stacks)",
    "file": "page cache: files the scope read or wrote",
    "shmem": "shared memory and tmpfs, which is charged to the scope that touches it",
    "kernel": "kernel memory charged to the scope (slab, page tables, kernel stacks)",
    "slab": "kernel slab, part of the kernel number",
    "sock": "socket buffers",
}
# The lever that field answers to. A generic "reduce your file traffic" under a scope whose
# memory is anonymous is advice for a different scope, so each field names its own.
STAT_LEVER = {
    "anon": " Anonymous memory IS process memory, so a low RSS sum with a high anon number means"
    " the processes that held it have already ended: look at what this lane ran, not at what it"
    " runs now.",
    "file": " Page cache is charged to the scope that reads or writes the file. The lever is this"
    " lane's file traffic -- big checkouts, build trees, logs, archives -- not its lane count.",
    "shmem": " tmpfs and shared memory stay charged until they are deleted. Look for what this"
    " lane wrote under /dev/shm or another tmpfs and never removed.",
    "kernel": " Kernel memory grows with the number of processes, mappings and open files, so the"
    " lever is how many of those this lane keeps at once, not how large any one of them is.",
    "sock": " Socket buffers this large mean a stalled or very fast stream: look at what this"
    " lane is downloading or piping.",
}
# A scope is one runaway process when the named processes hold this much of its peak, and a
# crowd when every process together does. Between and below them the memory is not in any
# process's RSS at all, which is what the memory.stat split answers.
RUNAWAY_SHARE = 0.60
CROWD_SHARE = 0.70


def stat_split(stats: dict) -> str:
    """The memory.stat fields of the scope, largest first, as one line."""
    rows = [(name, int(value)) for name, value in (stats or {}).items() if int(value) > 0 and name != "slab"]
    if not rows:
        return "memory.stat unreadable"
    rows.sort(key=lambda row: row[1], reverse=True)
    return ", ".join(f"{name} {gib(value)}" for name, value in rows)


def dominant_stat(stats: dict) -> tuple[str, int]:
    """The largest memory.stat field and its size, ignoring `slab` (it is inside `kernel`)."""
    rows = [(name, int(value)) for name, value in (stats or {}).items() if name != "slab"]
    if not rows:
        return "", 0
    return max(rows, key=lambda row: row[1])


def wall_advice(touch: dict) -> str:
    """What the owner should do, decided by where the scope's memory actually is.

    Telling an owner to hunt a process is wrong when no process holds the memory: in the open4
    and open6 digests of 2026-10-30 the three largest processes held 10-29% of a scope sitting
    at its ceiling, and the rest was page cache the owner's own file traffic had charged there.
    """
    peak = max(int(touch.get("peak") or 0), 1)
    top_sum = sum(rss for _pid, rss, _command in touch.get("top") or [])
    rss_sum = int(touch.get("rss_sum") or 0)
    count = int(touch.get("task_count") or 0)
    current = int(touch.get("current") or 0)
    if top_sum >= RUNAWAY_SHARE * peak:
        return (
            f"ONE RUNAWAY: the {len(touch.get('top') or [])} processes named above hold"
            f" {gib(top_sum)}, {100 * top_sum / peak:.0f}% of the peak. Find that process and"
            " stop or bound it -- shedding lanes will not help while it runs."
        )
    if rss_sum >= CROWD_SHARE * peak:
        return (
            f"MANY PROCESSES: no single one is large, but all {count} together hold"
            f" {gib(rss_sum)}, {100 * rss_sum / peak:.0f}% of the peak. Reduce the fan-out --"
            " run fewer lanes or fewer tool subprocesses at a time."
        )
    name, size = dominant_stat(touch.get("stats") or {})
    fell_back = current < peak * 0.5
    if not name:
        where = " memory.stat could not be read, so this run cannot say where it is."
    else:
        where = (
            f" The largest field of its memory.stat{' now' if fell_back else ''} is {name} at"
            f" {gib(size)}: {STAT_MEANING.get(name, 'see memory.stat')}.{STAT_LEVER.get(name, '')}"
        )
    if fell_back:
        where += (
            f" The scope has since fallen back to {gib(current)} of memory.current, so the peak"
            " was a burst: nothing on it now holds that memory, and the split above describes"
            " the scope as it is now, not as it was at the ceiling. Look at what this lane had"
            f" just started when it touched the wall at {iso(touch.get('at'))}."
        )
    return (
        f"NOT IN ANY PROCESS: all {count} processes together hold only {gib(rss_sum)},"
        f" {100 * rss_sum / peak:.0f}% of the peak, so hunting a process is the wrong move."
        + where
    )


def omp_processes() -> list[tuple[int, str]]:
    """Every `omp` process on this machine, as (pid, its cgroup path)."""
    found = []
    for entry in os.listdir("/proc"):
        if not entry.isdigit():
            continue
        pid = int(entry)
        try:
            if Path(f"/proc/{pid}/comm").read_text().strip() != "omp":
                continue
        except OSError:
            continue
        cgroup = cgroup_of(pid)
        if cgroup:
            found.append((pid, cgroup))
    return found


def rss_of(pid: int) -> int:
    """VmRSS in bytes, read from /proc/<pid>/statm (resident pages)."""
    try:
        return int(Path(f"/proc/{pid}/statm").read_text().split()[1]) * os.sysconf("SC_PAGE_SIZE")
    except (OSError, ValueError, IndexError):
        return 0


def pid_start(pid: int) -> int:
    """Field 22 of /proc/<pid>/stat: the clock ticks since boot at which the process started.

    pids on this box wrap inside a day, so an incident remembers this with the pid and starts
    over when it changes -- a remembered pid alone can come back as an unrelated process.
    """
    try:
        data = Path(f"/proc/{pid}/stat").read_text()
        return int(data[data.rfind(")") + 2 :].split()[19])
    except (OSError, ValueError, IndexError):
        return 0


def scope_tasks(cgroup: str) -> list[int]:
    try:
        return [int(line) for line in (CGROUP_ROOT / cgroup.strip("/") / "cgroup.procs").read_text().split()]
    except (OSError, ValueError):
        return []


def cmdline_of(pid: int) -> str:
    try:
        return Path(f"/proc/{pid}/cmdline").read_bytes().decode("utf8", "replace").replace("\0", " ").strip()
    except OSError:
        return ""


def session_of(pid: int) -> str:
    """The session id an omp process holds: its command line, else its open transcript.

    Resolved only for a process that is about to be alerted on, which is what keeps a run to
    a handful of file reads: the fd scan is the expensive part.
    """
    found = set(UUID_RE.findall(cmdline_of(pid)))
    if not found:
        try:
            for descriptor in os.listdir(f"/proc/{pid}/fd"):
                try:
                    target = os.readlink(f"/proc/{pid}/fd/{descriptor}")
                except OSError:
                    continue
                if "/.omp/agent/sessions/" in target and target.endswith(".jsonl"):
                    found.update(UUID_RE.findall(os.path.basename(target)))
        except OSError:
            pass
    return sorted(found)[0] if found else ""


def self_watch_anywhere(omp_pid: int) -> str:
    """The self-watch test for a session with no scope of its own.

    Scope membership says nothing there (the login scope holds every session in the login), so
    the test is a process anywhere on this machine whose command line both reads like a memory
    watch and names this omp pid as an argument -- which is how the one known self-watch is
    started (`ol-rss-watch.sh <omp pid> 10`).
    """
    for entry in os.listdir("/proc"):
        if not entry.isdigit() or int(entry) == omp_pid:
            continue
        command = cmdline_of(int(entry))
        if command and SELF_WATCH_RE.search(command) and str(omp_pid) in command.split():
            return f"yes -- pid {entry} runs `{command[:160]}`"
    return (
        "could not tell: no process on this machine has a memory-watch command line naming pid "
        f"{omp_pid}. It may run one in-session (a tool loop this check cannot see), or it may "
        "have none and this is its only warning"
    )


def self_watch_of(cgroup: str, omp_pid: int) -> str:
    """What this run can say about the session's OWN memory self-watch.

    The session owns prevention; this watch only detects. A session that runs its own watch
    has already been warned before this one fires, and one that does not has only this. The
    test is a command-line match on the other processes in the same scope, so it can miss a
    self-watch that runs elsewhere -- which the alert says, rather than implying there is none.
    """
    for pid in scope_tasks(cgroup):
        if pid == omp_pid:
            continue
        command = cmdline_of(pid)
        if command and SELF_WATCH_RE.search(command):
            return f"yes -- pid {pid} in the same scope runs `{command[:160]}`"
    return (
        "could not tell: no process in this scope has a memory-watch command line. It may run "
        "one in-session (a tool loop this check cannot see), or it may have none and this is "
        "its only warning"
    )


# ------------------------------------------------------------------------------- the decision


class State(object):
    """The one file this watch owns: per-scope samples and the open crossings.

    Opened under an exclusive, non-blocking flock for the whole run, so a hand run and the
    timer can never both decide that a crossing is new -- the loser skips its period. `commit`
    writes the whole file and fsyncs it, and every alert commits before it sends, so the
    once-per-crossing record is on disk before the message exists.
    """

    def __init__(self, path: Path) -> None:
        self.path = path
        path.parent.mkdir(parents=True, exist_ok=True)
        self.handle = open(path, "a+")
        try:
            fcntl.flock(self.handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
            self.locked = True
        except OSError:
            self.locked = False
            self.data = {}
            return
        self.handle.seek(0)
        try:
            self.data = json.loads(self.handle.read() or "{}")
        except ValueError:
            self.data = {}

    def commit(self, options: argparse.Namespace) -> None:
        if options.dry_run and not options.write_state:
            return
        self.handle.seek(0)
        self.handle.truncate()
        json.dump(self.data, self.handle, indent=1, sort_keys=True)
        self.handle.flush()
        os.fsync(self.handle.fileno())

    def close(self) -> None:
        try:
            self.handle.close()
        except OSError:
            pass


def rate_per_min(samples: list[list[float]]) -> float | None:
    """GiB per minute across the samples kept for this scope, or None with too few."""
    if len(samples) < 2:
        return None
    span = samples[-1][0] - samples[0][0]
    if span < 30:
        return None
    return (samples[-1][1] - samples[0][1]) / GIB / (span / 60)


def alert_text(scope: str, incident: dict, now: float, kind: str) -> str:
    limit = incident["limit"]
    warn_at = incident["warn_at"]
    usage = incident["peak"]
    headroom = limit - usage
    rate = incident.get("rate")
    session = incident.get("session") or ""
    pid = incident.get("pid")
    limited = incident.get("limited", True)
    eta = ""
    if rate is not None:
        eta = f" It has risen at {rate:.2f} GiB/min over the last {human(incident.get('rate_span') or 0)}."
        if rate > 0.05 and limited:
            # Only a capped session has a headroom worth converting into minutes: for an
            # uncapped one the "ceiling" is the whole machine, shared with every other session.
            eta = (
                f" At the {rate:.2f} GiB/min it has risen at over the last"
                f" {human(incident.get('rate_span') or 0)}, that headroom is"
                f" {headroom / GIB / rate:.0f} minutes."
            )
    # The session is read from the PROCESS -- its command line, else the transcript it holds
    # open -- never from who is sending or reading this. An alert that guessed would send a
    # lead to checkpoint the wrong session.
    who = (
        f"Session {session}"
        if session
        else "Session unknown (this process names no session id on its command line and holds no"
        " session transcript open)"
    )
    memory = (
        f"Memory: {gib(usage)} unreclaimable (anon+shmem+kernel+sock) in its scope, of a"
        f" {gib(limit)} ceiling -- {100 * usage / limit:.0f}%, {gib(headroom)} left. The ceiling"
        f" is {incident.get('limit_from')}. The scope's memory.current is"
        f" {gib(incident.get('current') or 0)}; the difference is file cache, which the kernel can"
        f" reclaim.{swap_sentence(incident.get('swap_max') or '')}{eta}"
        if limited
        else f"Memory: this omp process holds {gib(usage)} RSS. {gib(limit)} is the ceiling --"
        f" {incident.get('limit_from')} -- and {gib(warn_at)} is the level a CAPPED session is"
        f" warned at, which this one has passed.{eta}"
    )
    tasks = incident.get("task_count") or 1
    composition = (
        f"The scope holds {tasks} process{'es' if tasks != 1 else ''}; the omp process is"
        f" {100 * (incident.get('omp_rss') or 0) / max(usage, 1):.0f}% of the pressure"
        + (", its tool subprocesses the rest" if tasks > 1 else "")
        + ". The kernel OOM-kills on the SCOPE, not on omp's RSS: at the 05:55:14Z kill omp"
        " held 14.9 GiB of the 24 GiB that hit the ceiling."
        if limited
        else "This session has NO scope of its own, so nothing caps it and its tool subprocesses"
        f" are not counted here -- only omp's own RSS is. Its login scope {scope.split(':')[0]}"
        " is shared with every other session in that login, so what kills it is the machine"
        " running out, which takes the box with it."
    )
    lines = [
        f"OMP SESSION NEAR ITS MEMORY LIMIT ({kind}): {who} has been over"
        f" {gib(warn_at)} for {human(now - (incident.get('opened_at') or now))}, first detected at"
        f" {iso(incident.get('opened_at'))}.",
        f"Process: omp pid {pid} (RSS {gib(incident.get('omp_rss') or 0)}) in scope"
        f" {incident.get('scope') or scope} on {socket.gethostname()}. Measured:"
        f" {incident.get('measured') or 'unrecorded'}.",
        memory,
        composition,
        f"Your own self-watch: {incident.get('self_watch')}.",
        "DO, on your own terms and before the kernel decides for you: write your handover files"
        " now (what each lane was doing, where its work is); stop spawning lanes; shed or finish"
        " the lanes you can; then restart yourself with `omp --resume <your session id>` in your"
        " tmux pane while your state is on disk. An OOM kill loses every in-flight lane with no"
        " exit record -- about 40 of them on 2026-10-27T05:55:14Z.",
        "This watch only detects. It kills nothing, sheds nothing and restarts nothing: the"
        " shedding is yours, on your own terms.",
        f"From omp-memory-watch ({SELF_PATH}) on "
        f"{socket.gethostname()}, a systemd --user timer every 30 s.",
    ]
    return "\n".join(lines)


def reclaimable_bytes(touch: dict) -> int | None:
    """The part of this scope's charge the kernel can give back, or None when it cannot be told.

    memory.current minus the unreclaimable part (anon+shmem+kernel+sock) is page cache: clean
    file pages the kernel drops under pressure, and dirty ones it writes back and then drops.
    None means memory.stat was unreadable, where `scope_pressure` counts the whole of
    memory.current as unreclaimable and no split exists to show.
    """
    if not (touch.get("stats") or {}):
        return None
    return max(int(touch.get("current") or 0) - int(touch.get("usage") or 0), 0)


def reclaimable_clause(touch: dict) -> str:
    """The headline's one clause: how much of the ceiling is page cache the kernel can drop.

    It decides whether the rest of the report means anything, so it goes in the first sentence
    and not three paragraphs down beside the memory.stat split.
    """
    limit = max(int(touch.get("limit") or 0), 1)
    free = reclaimable_bytes(touch)
    if free is None:
        return ", of which none can be shown reclaimable: its memory.stat could not be read"
    return f", of which {gib(free)} ({100 * free / limit:.0f}% of the ceiling) is reclaimable page cache"


# Why the advice below turns on oom_kill, oom and the unreclaimable share, and not on the fact
# of being at the wall. From Documentation/admin-guide/cgroup-v2.rst (read 2026-11-01 at
# https://www.kernel.org/doc/Documentation/admin-guide/cgroup-v2.rst):
#
#   memory.max  "If a cgroup's memory usage reaches this limit and can't be reduced, the OOM
#               killer is invoked in the cgroup."
#   max         "The number of times the cgroup's memory usage was about to go over the max
#               boundary.  If direct reclaim fails to bring it down, the cgroup goes to OOM
#               state."
#   oom         "The number of time the cgroup's memory usage was reached the limit and
#               allocation was about to fail."
#   oom_kill    "The number of processes belonging to this cgroup killed by any kind of OOM
#               killer."
#   file        "Amount of memory used to cache filesystem data, including tmpfs and shared
#               memory."
#
# So `max` rising is the kernel SUCCEEDING: usage reached the boundary, direct reclaim brought
# it down, the allocation went through. The counter that rises when reclaim FAILS is `oom`, and
# the one that rises when something dies is `oom_kill`. The kill condition the kernel documents
# is "can't be reduced", and a scope holding gigabytes of page cache can be reduced. A scope
# whose ceiling is mostly cache therefore produces `max` events in normal operation and can sit
# at memory.max indefinitely; telling its owner it is one allocation from death is false, and
# the shedding that advice provokes -- killed builds, halved gates, abandoned measurements --
# costs more than the event does.
#
# The urgent side keeps every shape `urgent_reason` already escalates on, plus `oom` above zero
# and the unreclaimable share test, so this verdict is urgent wherever the box-health owner is
# told at once and the two can never contradict each other. Nothing here changes WHETHER a
# report is sent: every threshold that gates a report is untouched.


def wall_state(touch: dict) -> tuple[str, str]:
    """("urgent" or "normal", the sentence saying which and why, from this scope's counters)."""
    limit = max(int(touch.get("limit") or 0), 1)
    peak = max(int(touch.get("peak") or 0), 1)
    usage = int(touch.get("usage") or 0)
    anon = int((touch.get("stats") or {}).get("anon", 0))
    oom = int(touch.get("events_oom") or 0)
    killed = int(touch.get("events_oom_kill") or 0)
    # The level this watch already calls a session near its limit (--fraction, 0.70: 16.8 GiB of
    # 24 GiB, measured in omp-memory-watch.md), and the anon share that already skips the digest
    # (--wall-urgent-anon, 0.50). Both are read from the touch so one run has one set of levels.
    warn_fraction = float(touch.get("warn_fraction") or 0.70)
    urgent_anon = float(touch.get("urgent_anon") or 0.50)
    free = reclaimable_bytes(touch)
    if killed:
        return "urgent", (
            f"URGENT, and not a forecast: memory.events oom_kill is {killed}. The memcg OOM"
            " killer has ALREADY killed a process in this scope, so reclaim has run out here"
            " before. The next allocation it cannot satisfy takes another process, and an OOM"
            " kill loses every in-flight lane with no exit record."
        )
    if oom:
        return "urgent", (
            f"URGENT: memory.events oom is {oom}. Reclaim has already failed at memory.max in"
            " this scope and an allocation was about to fail -- the kernel's own condition for"
            " invoking the memcg OOM killer is a usage that reaches the limit and cannot be"
            " reduced. oom_kill is still 0, so nothing has died yet; the next failure is the"
            " kill."
        )
    if free is None:
        return "urgent", (
            "URGENT, conservatively: this scope's memory.stat could not be read, so no part of"
            " its charge can be shown to be page cache. Read it as if none of it is reclaimable."
        )
    if usage >= warn_fraction * limit:
        return "urgent", (
            f"URGENT: {gib(usage)} of the {gib(limit)} ceiling is unreclaimable"
            f" (anon+shmem+kernel+sock), {100 * usage / limit:.0f}% of it, and only {gib(free)}"
            " is page cache the kernel can drop. That is at or past the"
            f" {100 * warn_fraction:.0f}% level this watch calls a session near its limit, so"
            " reclaim is nearly out of material: when it cannot bring the scope back under"
            " memory.max, the memcg OOM killer runs."
        )
    if anon >= urgent_anon * peak:
        return "urgent", (
            f"URGENT: anonymous memory is {gib(anon)}, {100 * anon / peak:.0f}% of the"
            f" {gib(peak)} peak, and anon is what the kernel cannot hand back. A scope at its"
            " wall holding mostly anon has little left to reclaim, and when reclaim fails the"
            " memcg OOM killer runs."
        )
    return "normal", (
        f"NOT URGENT: {gib(free)} of this scope's {gib(limit)} ceiling --"
        f" {100 * free / limit:.0f}% -- is page cache, which the kernel reclaims on demand, and"
        f" memory.events oom is 0 with oom_kill 0. So every one of the {touch.get('events_max', 0)}"
        " times this scope reached memory.max, direct reclaim brought it down and the allocation"
        " went through: that is exactly what the `max` counter counts. `oom` is the counter that"
        " rises when reclaim fails, and it has not risen here. This scope is NOT one allocation"
        " from a kill; a cache-filled scope can sit on its ceiling for as long as its file"
        " traffic keeps the cache full. Do NOT kill your builds, halve a shared gate, or abandon"
        " a measurement on this report -- that cost is certain, and the kill it would avert is"
        " not coming while these counters hold. Watch oom and oom_kill, not `max`."
    )


def wall_text(touch: dict) -> str:
    """What one scope's owner is told when its scope reaches memory.max.

    No hold, no rate of rise and no forecast: the scope is AT its ceiling now, and every number
    here is read from that one moment.
    """
    limit = touch["limit"]
    peak = touch["peak"]
    session = touch.get("session") or ""
    claim = touch.get("session_claim") or ""
    who = (
        f"session {session}"
        if session
        else (
            f"session UNKNOWN: the id {claim} on its processes is not live on this box and no"
            " live session here matches it"
            if claim
            else "session UNKNOWN (no session id on any command line in the scope, no transcript"
            " open, and the worker directory records none yet)"
        )
    )
    worker = touch.get("worker")
    reasons = []
    if touch.get("events_delta"):
        reasons.append(
            f"the `max` counter of its memory.events rose by {touch['events_delta']} since the"
            f" last poll (now {touch.get('events_max')}): the kernel refused an allocation at"
            " memory.max that many times and had to reclaim to satisfy it"
        )
    if touch.get("peak_touch"):
        reasons.append(
            f"its memory.peak reached {gib(peak)}, {100 * peak / max(limit, 1):.1f}% of the ceiling"
        )
    lines = [
        f"OMP SCOPE REACHED ITS MEMORY WALL: scope {touch['scope']} on {socket.gethostname()}"
        f" ({who}" + (f", ossv-worker {worker}" if worker else ", no ossv-worker name on its command lines") + ")"
        f" is at its {gib(limit)} memory.max{reclaimable_clause(touch)}.",
        "What says so: " + "; and ".join(reasons) + ".",
        f"Numbers now: memory.peak {gib(peak)}, memory.current {gib(touch.get('current') or 0)},"
        f" unreclaimable (anon+shmem+kernel+sock) {gib(touch.get('usage') or 0)}, ceiling"
        f" {gib(limit)} ({touch.get('limit_from')})."
        + swap_sentence(touch.get("swap_max") or "")
        + f" memory.events oom {touch.get('events_oom', 0)}, oom_kill"
        f" {touch.get('events_oom_kill', 0)}.",
        f"Where that memory is, by memory.stat: {stat_split(touch.get('stats') or {})}.",
        f"The scope holds {touch.get('task_count') or 0} processes holding"
        f" {gib(touch.get('rss_sum') or 0)} of RSS between them,"
        f" {100 * int(touch.get('rss_sum') or 0) / max(peak, 1):.0f}% of the peak."
        " The three largest by RSS:",
    ]
    for pid, rss, command in touch.get("top") or []:
        lines.append(f"  {gib(rss)}  pid {pid}  {command[:200] or '(no command line)'}")
    if not touch.get("top"):
        lines.append("  (none readable: every process in the scope ended before it could be read)")
    lines.append(
        "Why you are hearing this and did not before: the crossing alert needs the scope's"
        " UNRECLAIMABLE memory to sit above 70% of the ceiling for 60 s. A scope whose pressure"
        " is page cache, or one that reaches the ceiling and falls back inside one 30 s period,"
        " never meets that and still spends its whole budget. On ossv-agent-open on 2026-10-30,"
        " 31 of 95 worker scopes had touched their 24 GiB wall and 4 were reported."
    )
    state, verdict = wall_state(touch)
    lines.append(
        "DO, first and whatever the cause: write your handover files now -- what each lane was"
        " doing and where its work is. That costs seconds, and it is right whether this scope is"
        " in danger or not."
    )
    lines.append(f"What the counters say about this scope ({state}): {verdict}")
    lines.append("If you do shed, shed the right thing: " + wall_advice(touch))
    lines.append(
        f"This watch only detects; it kills nothing. One report per scope per"
        f" {human(touch.get('cooldown') or 900)}. From omp-memory-watch"
        f" ({SELF_PATH}) on {socket.gethostname()}, a systemd --user"
        " timer every 30 s."
    )
    return "\n".join(lines)



def urgent_reason(touch: dict, options: argparse.Namespace) -> str:
    """Why this touch cannot wait for the hourly digest, or "".

    Two shapes end in a kill rather than in reclaim. Anonymous memory is the memory the kernel
    cannot give back, so a scope at its wall holding mostly anon has nothing left to reclaim:
    the next allocation is the OOM killer's. And an oom_kill that has already happened is not a
    forecast at all. Everything else -- a scope at its wall on page cache, which the kernel
    drops and carries on -- rides the digest.
    """
    if int((touch.get("stats") or {}).get("anon", 0)) >= options.wall_urgent_anon * max(int(touch.get("peak") or 0), 1):
        return (
            f"anon {gib((touch.get('stats') or {}).get('anon', 0))} is"
            f" {100 * int((touch.get('stats') or {}).get('anon', 0)) / max(int(touch.get('peak') or 1), 1):.0f}%"
            f" of the {gib(touch.get('peak') or 0)} peak, which the kernel cannot reclaim"
        )
    if int(touch.get("events_oom_kill") or 0):
        return f"memory.events oom_kill is {touch['events_oom_kill']}: the kernel has already killed in this scope"
    return ""


def urgent_text(touch: dict, reason: str) -> str:
    """The one touch that is sent the moment it is seen, to the box-health owner."""
    worker = touch.get("worker") or "no worker name"
    session = touch.get("session") or "session unknown"
    return (
        f"SCOPE AT ITS MEMORY WALL, NOT WAITING FOR THE DIGEST, on {socket.gethostname()}:"
        f" {touch.get('scope')} ({worker}, {session}) reached {gib(touch.get('peak') or 0)} of"
        f" {gib(touch.get('limit') or 0)}. Why this one is immediate: {reason}.\n"
        + digest_row(touch)
        + "\nIts owner has the whole report: the memory.stat split, the process count and RSS"
        " sum, and the three largest processes with their command lines. From omp-memory-watch"
        f" on {socket.gethostname()}."
    )


def digest_row(touch: dict) -> str:
    """One scope on one line: box, worker, peak, and the file/anon split."""
    stats = touch.get("stats") or {}
    peak = max(int(touch.get("peak") or 0), 1)
    return (
        f"  {iso(touch.get('at'))}  {touch.get('box') or socket.gethostname().split('.')[0]}"
        f"  {touch.get('worker') or 'no worker name'}"
        f"  peak {gib(touch.get('peak') or 0)} of {gib(touch.get('limit') or 0)}"
        f"  file {gib(stats.get('file', 0))} ({100 * int(stats.get('file', 0)) / peak:.0f}%)"
        f"  anon {gib(stats.get('anon', 0))} ({100 * int(stats.get('anon', 0)) / peak:.0f}%)"
        + (f"  oom_kill {touch['events_oom_kill']}" if int(touch.get("events_oom_kill") or 0) else "")
        + f"  {touch.get('session') or 'session unknown'}"
    )


def wall_digest_text(pending: list[dict], window: float, scope_of_text: str = "") -> str:
    """The box-health owner's batched view: one line per scope that reached its wall.

    Every scope's own owner already has the whole report -- the memory.stat split, the process
    count and RSS sum, and the three largest processes with their command lines -- which is
    where the shedding happens. This reader wants the shape of the fleet, not each scope's
    detail: a per-box digest every 15 minutes was eight messages an hour saying the same thing
    (Sami, 2026-10-31). So one line each, and the two shapes that end in a kill -- anon above
    half the peak, and an oom_kill that already happened -- do not wait for it at all.
    """
    where = scope_of_text or socket.gethostname()
    boxes = sorted({str(touch.get("box") or socket.gethostname().split(".")[0]) for touch in pending})
    lines = [
        f"SCOPES AT THEIR MEMORY WALL ({where}): {len(pending)} touch(es) on"
        f" {len(boxes)} box(es) in the last {human(window)} -- {', '.join(boxes)}. Each is a"
        " scope whose memory.events `max` counter rose or whose memory.peak reached its"
        " ceiling, with no hold, so these are the touches the 70%-for-60 s crossing alert"
        " cannot see. Columns: time, box, worker, peak, page cache, anonymous, session.",
    ]
    lines.extend(digest_row(touch) for touch in sorted(pending, key=lambda t: t.get("at") or 0))
    lines.append(
        "Anything here is reclaimable pressure: a scope whose anon passed half its peak, or one"
        " the kernel has already killed in, was sent the moment it was seen and is not in this"
        " list for the first time. Each scope's own owner has the whole report. From"
        " omp-memory-watch."
    )
    return "\n".join(lines)


def wall_touch(
    target: dict, walls: dict, options: argparse.Namespace, now: float, cold_start: bool
) -> dict | None:
    """Decide whether this capped scope has REACHED its wall since the last poll, and report it.

    Returns the touch to report, or None. The wall memory is keyed by scope and never by pid:
    one scope holds several `omp` processes (the session, its js-eval helper), the crossing
    logic follows whichever is largest, and a flip between them must not look like a new scope
    and report the same backlog again.
    """
    key = target["key"]
    limit = target["limit"]
    events = target.get("events") or {}
    events_max = int(events.get("max", 0))
    peak = int(target.get("peak_bytes") or 0)
    memory = walls.setdefault(key, {})
    known = "events_max" in memory
    previous_max = int(memory.get("events_max", 0))
    previous_peak = int(memory.get("peak", 0))
    memory["events_max"] = events_max
    memory["peak"] = max(previous_peak, peak)
    if cold_start and not known:
        # Seeded, not reported: see run_once. A counter already above zero dates from before
        # this state file existed.
        return None
    delta = events_max - previous_max if known else events_max
    peak_floor = limit * options.wall_fraction
    peak_touch = peak >= peak_floor and peak > previous_peak
    if delta <= 0 and not peak_touch:
        return None
    last = memory.get("reported_at")
    if last and now - last < options.wall_cooldown:
        # Inside the cooldown the touch is real and already reported; count it so the next
        # report can say how many times it happened rather than dropping the fact.
        memory["suppressed"] = int(memory.get("suppressed", 0)) + 1
        return None
    pids = scope_tasks(target["cgroup"])
    worker, directory = worker_of(pids)
    from_worker = worker_session(directory)
    session = from_worker or session_of(target["pid"])
    memory["reported_at"] = now
    suppressed = int(memory.pop("suppressed", 0))
    # Every process in the scope, not only the three named: the three largest explained 10-29%
    # of a scope at its ceiling in the open4 and open6 digests of 2026-10-30, and the question
    # that leaves -- one runaway, a crowd of small processes, or memory no process holds -- is
    # answered by the whole RSS sum against the memory.stat split, not by a longer top list.
    by_rss = [(pid, rss_of(pid), cmdline_of(pid)) for pid in pids]
    by_rss = [row for row in by_rss if row[1] > 0]
    by_rss.sort(key=lambda row: row[1], reverse=True)
    return dict(
        at=now,
        scope=target["scope"],
        key=key,
        session=session,
        worker_session=from_worker,
        session_note="",
        session_claim="",
        worker=worker,
        limit=limit,
        limit_from=target["limit_from"],
        peak=peak,
        current=target["current"],
        usage=target["usage"],
        swap_max=target.get("swap_max") or "",
        events_max=events_max,
        events_delta=delta,
        events_oom=int(events.get("oom", 0)),
        events_oom_kill=int(events.get("oom_kill", 0)),
        peak_touch=peak_touch,
        task_count=len(pids),
        rss_sum=sum(rss for _pid, rss, _command in by_rss),
        stats={name: int(value) for name, value in (target.get("stats") or {}).items()},
        top=by_rss[: options.wall_top],
        suppressed=suppressed,
        cooldown=options.wall_cooldown,
        # The levels `wall_state` judges this touch against, carried with it so the report and
        # the run that produced it can never disagree about what "near the limit" means.
        warn_fraction=options.fraction,
        urgent_anon=options.wall_urgent_anon,
    )



def clear_text(scope: str, incident: dict, cause: str, now: float) -> str:
    opened = incident.get("opened_at") or now
    session = incident.get("session") or "unknown"
    return (
        f"OMP SESSION MEMORY CLEARED: session {session} (omp pid {incident.get('pid')}, scope {scope})"
        f" is back under {gib(incident.get('warn_at') or 0)}. What cleared it: {cause}. "
        f"The crossing opened at {iso(opened)}, cleared at {iso(now)}, lasted {human(now - opened)},"
        f" and peaked at {gib(incident.get('peak') or 0)} of a {gib(incident.get('limit') or 0)} ceiling. "
        "No action is needed. From omp-memory-watch on " + socket.gethostname() + "."
    )


# A machine whose box health belongs to one session, not to this box's role holder, sets
# BOX_HEALTH_OWNER to that session id: the OSS Verify lane VMs run these watches from their own
# dotfiles and their alerts go to the fleet monitoring owner.
OWNER_RE = re.compile(r"01[0-9a-f]{6}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\Z")


def box_health_owner() -> str:
    """The session id BOX_HEALTH_OWNER names, or "" for the role-then-SRE default.

    An unusable value is refused at start, not at the first crossing: a watch that drops its
    alerts quietly is worse than one that does not run.
    """
    owner = (os.environ.get("BOX_HEALTH_OWNER") or "").strip()
    if owner and not OWNER_RE.fullmatch(owner):
        raise SystemExit(
            f"BOX_HEALTH_OWNER={owner!r} is not an omp session id"
            " (01xxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx); unset it for the box-health role"
        )
    return owner


def tell_box_health(envoy: Envoy, text: str) -> str:
    """Tell this box's health owner, and say who heard it.

    With BOX_HEALTH_OWNER set, that session is the only recipient and nothing is published to
    the role. Otherwise the role is the address while somebody holds it; an unheld role answers
    non-200, and then the SRE session hears it instead.
    """
    owner = box_health_owner()
    if owner:
        return owner if envoy.send(owner, text) else ""
    if envoy.publish(BOX_HEALTH_ROLE_TOPIC, text):
        return BOX_HEALTH_ROLE_TOPIC
    if envoy.send(SRE, text):
        return SRE
    return ""


def tell(envoy: Envoy, target: str, text: str) -> bool:
    """Send to a session id, or publish to the box-health role when that is the recipient."""
    if target == BOX_HEALTH_ROLE_TOPIC:
        return bool(tell_box_health(envoy, text))
    return envoy.send(target, text)


def send_clear(envoy: Envoy, options: argparse.Namespace, scope: str, incident: dict, cause: str, now: float) -> bool:
    if not incident.get("alerted_at") or incident.get("cleared_at"):
        return False
    incident["cleared_at"] = now
    targets = incident.get("told") or [BOX_HEALTH_ROLE_TOPIC]
    text = clear_text(scope, incident, cause, now)
    for target in targets:
        if not options.dry_run:
            tell(envoy, target, text)
    log(f"{scope}: CLEARED ({cause}); told {len(targets)} recipients")
    if options.print_alert:
        print(text)
    return True


# ---------------------------------------------------- prefer the runaway child over the session

# The procfs this pass reads and writes. A module constant so the tests can point it at a tree.
PROC_ROOT = Path("/proc")


def parent_of(pid: int) -> int:
    """Field 4 of /proc/<pid>/stat, or 0 when the process is gone."""
    try:
        data = (PROC_ROOT / str(pid) / "stat").read_text()
        return int(data[data.rfind(")") + 2 :].split()[1])
    except (OSError, ValueError, IndexError):
        return 0


def oom_bias_pass(
    omps: list[tuple[int, str]], adj: int, dry_run: bool, deadline: float = float("inf")
) -> dict[str, int]:
    """Raise every process in a capped omp scope, except the session's own omp, to `adj`.

    When a scope reaches its MemoryMax the memcg OOM killer kills the member with the largest
    badness: its RSS + swap + page tables, plus oom_score_adj * (the scope's limit) / 1000. With
    every adj at 0 that is the session's omp, which held 14.9 of the 24 GiB at the 2026-10-27
    kill (dispatch://INFRA-602), and about 40 subagents died with it. An unprivileged process may
    raise an oom_score_adj of its own uid but never lower one, so omp cannot be biased down;
    every other member is biased up instead. At +500 under a 24 GiB limit each such process
    scores 12 GiB more: a 3.2 GiB tsgo (15.2) is killed before a 1.7 GiB omp, and only a member
    smaller than the omp by more than 12 GiB of RSS loses to it.

    The rule protects the SESSION's omp, not every process named omp: the one omp in the scope
    whose parent is outside the scope -- the process `shims/omp` starts through `systemd-run
    --scope`, and which owns the session. A nested omp (a subagent, a js-eval helper) has its
    parent inside the scope and is biased like any other child: a runaway subagent holding
    10 GiB is a far better victim than the session and all its other lanes. A scope where no omp
    has its parent outside is left with every omp unbiased, which is how it was before this pass.

    Only scopes with a limit of their OWN are touched. An uncapped session shares its login
    scope with every other session there, and that scope is not this session's to bias.

    It never lowers an adj (a member already at or above `adj` is counted and left), and never
    writes a process it may not: EPERM (another uid, as in an agent box) is counted as refused.

    `omps` is every omp process on the machine (`omp_processes`), so a member's name is not read
    again: each /proc open costs about 1 ms at load 400, and a scope can hold hundreds.
    """
    counts = {"scopes": 0, "raised": 0, "already": 0, "refused": 0, "gone": 0, "failed": 0, "no_leader": 0}
    every_omp = {pid for pid, _cgroup in omps}
    cgroups = sorted({cgroup for _pid, cgroup in omps})
    for cgroup in cgroups:
        if time.monotonic() > deadline:
            counts["unfinished"] = counts.get("unfinished", 0) + 1
            continue
        if not effective_limit(cgroup)[2]:
            continue
        counts["scopes"] += 1
        members = scope_tasks(cgroup)
        inside = set(members)
        omp_members = [pid for pid in members if pid in every_omp]
        protected = {pid for pid in omp_members if parent_of(pid) not in inside}
        if not protected:
            counts["no_leader"] += 1
            protected = set(omp_members)
        for pid in members:
            if pid in protected:
                continue
            path = PROC_ROOT / str(pid) / "oom_score_adj"
            try:
                current = int(path.read_text().strip())
            except (FileNotFoundError, ProcessLookupError):
                counts["gone"] += 1
                continue
            except (OSError, ValueError):
                counts["failed"] += 1
                continue
            if current >= adj:
                counts["already"] += 1
                continue
            if dry_run:
                counts["raised"] += 1
                continue
            try:
                path.write_text(f"{adj}\n")
                counts["raised"] += 1
            except PermissionError:
                counts["refused"] += 1
            except (FileNotFoundError, ProcessLookupError):
                counts["gone"] += 1
            except OSError:
                counts["failed"] += 1
    return counts


def oom_bias_note(counts: dict[str, int], adj: int, dry_run: bool) -> str:
    verb = "would raise" if dry_run else "raised"
    note = (
        f"oom bias +{adj}: {counts['scopes']} capped scope(s), {verb} {counts['raised']},"
        f" {counts['already']} already at or above, {counts['refused']} refused (EPERM),"
        f" {counts['gone']} gone"
    )
    if counts["failed"]:
        note += f", {counts['failed']} failed"
    if counts["no_leader"]:
        note += f", {counts['no_leader']} scope(s) with no session omp found (every omp left)"
    if counts.get("unfinished"):
        note += f", {counts['unfinished']} scope(s) left for the next run (out of time)"
    return note


# ------------------------------------------------------------ resume a pane whose omp died

# What a resumed pane runs. The shim by its absolute path: a pane that starts omp from PATH can
# miss PI_CONFIG_FILES, which broke three sessions on 2026-11-01.
OMP_SHIM = Path.home() / ".dotfiles/shims/omp"
AGENTBOX = Path.home() / ".dotfiles/scripts/agentbox"
# A pane last seen running omp longer ago than this died while nothing watched; it is left.
RESTART_STALE = 3600.0
# How long a pane's session, read from the omp's open files, is reused while the same process runs.
SID_REFRESH = 300.0
# How long a recorded pane may run something other than omp before it is forgotten.
BUSY_FORGET = 120.0
# When each acting pass must stop, in seconds from the run's start. The unit kills a run at 25 s,
# and at nice 15 and load 425 on 2026-11-02 an unbounded pane pass took 33 s and the unit killed
# the run. The alerting itself is not bounded; a pass out of time stops, and the next run goes on.
BIAS_DEADLINE = 6.0
RESTART_DEADLINE = 14.0
# Open-file scans a run may make: about 0.2 s each at that load.
SCAN_BUDGET = 10
PANE_FORMAT = "#{pane_id}\t#{pane_pid}\t#{pane_dead}\t#{session_name}:#{window_index}.#{pane_index}"
BOX_NAME_RE = re.compile(r"--name[=\s]+(agentbox-[0-9a-f]{12})\b")
PANE_WALK_DEPTH = 4
PANE_WALK_MAX = 64

_SIBLINGS: dict = {}


def sibling(name: str):
    """Load a script beside this one as a module, once: the discovery and the exit test are
    tmux-resurrect-omp's and envoy-role-holder-watch's, never a second copy."""
    if name not in _SIBLINGS:
        path = Path(SELF_PATH).parent / name
        loader = importlib.machinery.SourceFileLoader(name.replace("-", "_"), str(path))
        spec = importlib.util.spec_from_loader(loader.name, loader)
        module = importlib.util.module_from_spec(spec)
        loader.exec_module(module)
        _SIBLINGS[name] = module
    return _SIBLINGS[name]


def tmux_panes() -> list[dict] | None:
    """Every pane of the default tmux server, or None when there is no server to ask."""
    try:
        done = subprocess.run(
            ["tmux", "list-panes", "-a", "-F", PANE_FORMAT],
            capture_output=True, text=True, timeout=10, stdin=subprocess.DEVNULL,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    if done.returncode != 0:
        return None
    rows = []
    for line in done.stdout.splitlines():
        parts = line.split("\t")
        if len(parts) == 4 and parts[1].isdigit():
            rows.append({"id": parts[0], "pid": int(parts[1]), "dead": parts[2] == "1", "target": parts[3]})
    return rows


def process_table() -> dict:
    """Every process on the machine from one read of each /proc/<pid>/stat: its children, its
    name and its start time.

    tmux-resurrect-omp's `children` reads /proc/<pid>/task/*/children, one file per THREAD, and
    an omp has dozens: walking 273 panes that way took 7.5 of a 9.3 s run at load 400 on
    2026-11-02. At that load each /proc open costs about 1 ms, so the walk reads nothing else per
    process, and a command line (the slowest file: it takes the process's mmap lock) only where
    a decision needs it.
    """
    children: dict[int, list[int]] = {}
    names: dict[int, str] = {}
    starts: dict[int, int] = {}
    for entry in os.listdir(PROC_ROOT):
        if not entry.isdigit():
            continue
        try:
            data = (PROC_ROOT / entry / "stat").read_text()
            fields = data[data.rfind(")") + 2 :].split()
            parent, start = int(fields[1]), int(fields[19])
        except (OSError, ValueError, IndexError):
            continue
        pid = int(entry)
        names[pid] = data[data.find("(") + 1 : data.rfind(")")]
        starts[pid] = start
        children.setdefault(parent, []).append(pid)
    return {"children": children, "names": names, "starts": starts}


def pane_processes(pane_pid: int, resurrect, table: dict | None = None) -> list[tuple[int, str]]:
    """(pid, comm) of the processes below the pane's own process, nearest first.

    The walk stops at an omp: what runs below it is that session's tools, not the pane's. From
    `table` when given (one /proc pass for the whole run), else read fresh."""
    found: list[tuple[int, str]] = []
    frontier = [pane_pid]
    for _ in range(PANE_WALK_DEPTH):
        next_frontier: list[int] = []
        for pid in frontier:
            kids = table["children"].get(pid, []) if table is not None else resurrect.children(pid)
            for kid in kids:
                name = table["names"].get(kid, "") if table is not None else resurrect.comm(kid)
                found.append((kid, name))
                if len(found) >= PANE_WALK_MAX:
                    return found
                if name != "omp":
                    next_frontier.append(kid)
        frontier = next_frontier
    return found


def cwd_of(pid: int) -> str:
    try:
        return os.readlink(f"/proc/{pid}/cwd")
    except OSError:
        return ""


def pane_state(
    pane: dict, resurrect, known: dict | None = None, now: float = 0.0, table: dict | None = None,
    budget: dict | None = None,
) -> tuple[str, dict]:
    """("host" | "box" | "idle" | "busy", what was read) for one pane.

    host: an omp runs below the pane. box: an `agentbox new ... --` launcher does (its omp runs
    in the box under another uid). idle: nothing runs below the pane's shell, or the pane is
    dead. busy: something else runs there. The session is found the way tmux-resurrect-omp finds
    it: the session file the omp holds open, else the id on its command line.

    The open-file scan is the expensive part (6.4 s for 171 host panes on 2026-11-02, 30 s at
    nice 15 and load 425), so the pane's last record (`known`) is reused while the same omp
    process runs and its session was read less than SID_REFRESH ago, and a run scans at most
    `budget["scans"]` panes; a pane over the budget keeps what it had, else the id on its
    command line, and is scanned on a later run. A session switched in-app (/new) less than
    SID_REFRESH before its omp was killed is resumed at the session it ran before the switch.
    """
    if pane["dead"]:
        return "idle", {}
    procs = pane_processes(pane["pid"], resurrect, table)
    if not procs:
        return "idle", {}
    starts = table["starts"] if table is not None else {}
    for pid, name in procs:
        if name != "omp":
            continue
        start = starts.get(pid) or pid_start(pid)
        same = bool(known) and known.get("kind") == "host" and known.get("pid") == pid and known.get("start") == start
        resolved = float(known.get("resolved") or 0) if same else 0.0
        sid = known.get("sid") if same else None
        if not (sid and now - resolved < SID_REFRESH):
            deadline = (budget or {}).get("deadline", float("inf"))
            if (budget is None or budget["scans"] > 0) and time.monotonic() < deadline - 1:
                if budget is not None:
                    budget["scans"] -= 1
                sid, resolved = resurrect.open_session(pid) or resurrect.named_session(resurrect.cmdline(pid)), now
            elif not sid:
                sid = resurrect.named_session(resurrect.cmdline(pid))
        cwd = known.get("cwd") if same and known.get("cwd") else cwd_of(pid)
        return "host", {"pid": pid, "start": start, "sid": sid, "resolved": resolved, "cwd": cwd}
    for pid, _name in procs:
        command = resurrect.cmdline(pid)
        launch = resurrect.LAUNCH_SPEC.search(command)
        if launch:
            box = next(
                (m.group(1) for p, _n in procs if (m := BOX_NAME_RE.search(resurrect.cmdline(p)))), ""
            )
            return "box", {
                "pid": pid, "start": starts.get(pid) or pid_start(pid), "sid": resurrect.named_session(command),
                "spec": launch.group("spec"), "box": box, "cwd": cwd_of(pid),
            }
    return "busy", {"comm": procs[0][1]}


def find_transcript(sid: str, holder) -> str:
    """The newest transcript of a session id (or id prefix), else ""."""
    found = sorted(SESSION_ROOT.glob(f"*/*_{sid}*.jsonl"), key=lambda p: p.stat().st_mtime if p.exists() else 0)
    if found:
        return str(found[-1])
    if UUID_RE.fullmatch(sid):
        path = holder.transcript_of(sid)
        if path:
            return str(path)
    return ""


def same_session(a: str, b: str) -> bool:
    return bool(a and b) and (a.startswith(b) or b.startswith(a))


def live_holder(sid: str, omps: list[tuple[int, str]], resurrect, records: dict, pane_id: str, now: float) -> str:
    """Who else runs this session, else "": another pane this watch saw running it within
    SID_REFRESH (read from that omp's open files), or a live omp whose command line names it.

    No open-file scan here: one per omp is about 0.2 s at load 400, a hundred omps would cost the
    whole run, and the pane records already hold what those scans found."""
    for other, record in records.items():
        if other != pane_id and now - float(record.get("seen") or 0) < SID_REFRESH and same_session(record.get("sid") or "", sid):
            return f"pane {other}"
    for pid, _cgroup in omps:
        if same_session(resurrect.named_session(cmdline_of(pid)) or "", sid):
            return f"omp pid {pid}"
    return ""


RESUME_WAKE_NOTICE = (
    "omp-memory-watch: this session's omp ended without a normal exit, so its pane was resumed."
    " Go on with the work you were doing. (An automated notice, not a person.)"
)


def resume_command(record: dict) -> str:
    """What the lead runs by hand, with the launcher by its absolute path.

    The resume carries no prompt: omp records a positional as a user message, and the `.` this
    used to end with was counted as text the person typed by the transcript store. The session is
    woken instead by one Envoy notice, sent by `agentbox move --wake` once the resumed process has
    registered; it runs in the background beside the launcher and logs to wake-<id>.log."""
    cwd, sid = shlex.quote(record["cwd"]), shlex.quote(record["sid"])
    log = shlex.quote(str(Path.home() / ".cache" / "omp" / "agentbox" / f"wake-{record['sid']}.log"))
    wake = (
        f"( setsid {shlex.quote(str(AGENTBOX))} move --wake {sid} {shlex.quote(RESUME_WAKE_NOTICE)}"
        f" </dev/null >>{log} 2>&1 & ); "
    )
    if record["kind"] == "box":
        return f"{wake}cd {cwd} && {shlex.quote(str(AGENTBOX))} new {record['spec']} -- omp --resume {sid}"
    return f"{wake}cd {cwd} && {shlex.quote(str(OMP_SHIM))} --resume {sid}"


def pane_now(pane_id: str) -> dict | None:
    """The pane as tmux has it at this moment: its process and whether it is dead, or None."""
    try:
        done = subprocess.run(
            ["tmux", "display-message", "-p", "-t", pane_id, "#{pane_pid}\t#{pane_dead}"],
            capture_output=True, text=True, timeout=10, stdin=subprocess.DEVNULL,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    parts = done.stdout.strip().split("\t")
    if done.returncode != 0 or len(parts) != 2 or not parts[0].isdigit():
        return None
    return {"pid": int(parts[0]), "dead": parts[1] == "1"}


def respawn_pane(pane_id: str, cwd: str, command: str) -> tuple[bool, str]:
    argv = ["tmux", "respawn-pane", "-k", "-t", pane_id, "-c", cwd, "bash", "-i", "-c", f"{command}; exec bash -i"]
    try:
        done = subprocess.run(argv, capture_output=True, text=True, timeout=10, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError) as error:
        return False, str(error)
    return done.returncode == 0, done.stderr.strip()


def restart_decision(record: dict, omps: list, restarts: dict, options: argparse.Namespace, now: float,
                     resurrect, holder, records: dict, pane_id: str) -> str:
    """"" when the pane's session should be resumed, else why it is left. Cheap tests first."""
    sid = record.get("sid") or ""
    if not sid:
        return "left: the session it ran could not be read while it was alive"
    if now - float(record.get("seen") or 0) > RESTART_STALE:
        return f"left: last seen running at {iso(record.get('seen'))}, more than {human(RESTART_STALE)} ago"
    if not record.get("cwd") or not os.path.isdir(record["cwd"]):
        return f"left: its working directory {record.get('cwd') or '(unknown)'} is gone"
    if record.get("kind") == "box" and not record.get("spec"):
        return "left: the agentbox launcher line names no spec"
    last = float(restarts.get(sid) or 0)
    if last and now - last < options.restart_cooldown:
        return f"left: resumed at {iso(last)}, less than {human(options.restart_cooldown)} ago"
    transcript = find_transcript(sid, holder)
    if not transcript:
        return "left: no transcript found, so whether it ended on purpose cannot be told"
    ended = holder.normal_exit_at(transcript)
    if ended:
        return f"left: the session ended normally at {ended}"
    elsewhere = live_holder(sid, omps, resurrect, records, pane_id, now)
    if elsewhere:
        return f"left: the session is live in {elsewhere}"
    return ""


def restart_pass(
    options: argparse.Namespace, state: State, omps: list[tuple[int, str]], now: float,
    deadline: float = float("inf"),
) -> str:
    """Resume each tmux pane whose omp died without ending its session on purpose.

    Each run records, for every pane running omp (on the host or through `agentbox new`), the
    session it runs, its working directory and, for a box, the launcher's spec. A recorded pane
    that is now idle -- its shell has no child, or tmux marks it dead -- is resumed with
    `tmux respawn-pane -k`, unless: no session was read for it; it was last seen running more
    than an hour ago; its directory is gone; the session's transcript ends in a normal
    `session_exit` (envoy-role-holder-watch's normal_exit_at); another omp holds the session;
    or the session was resumed less than --restart-cooldown ago. Every decision is logged.
    """
    if not os.access(OMP_SHIM, os.X_OK):
        return f"panes: restarter off here, no {OMP_SHIM}"
    panes = tmux_panes()
    if panes is None:
        return "panes: no tmux server"
    resurrect = sibling("tmux-resurrect-omp")
    holder = sibling("envoy-role-holder-watch")
    dry = options.dry_run or options.restart_dry_run
    records: dict = state.data.setdefault("panes", {})
    restarts: dict = state.data.setdefault("restarts", {})
    for sid in [sid for sid, at in restarts.items() if now - float(at) > max(options.restart_cooldown, RESTART_STALE)]:
        restarts.pop(sid, None)
    live = resumed = left = 0
    box_lookups = 0
    table = process_table()
    budget = {"scans": SCAN_BUDGET, "deadline": deadline}
    present = {pane["id"] for pane in panes}
    for pane_id in [pane_id for pane_id in records if pane_id not in present]:
        old = records.pop(pane_id)
        log(f"pane {pane_id} ({old.get('target')}) session {old.get('sid') or 'unknown'}: forgotten, the pane is gone")
    # A run that runs out of RESTART_BUDGET stops where it is, and the next run starts there, so
    # every pane is read within a few runs however loaded the box is and the watch's alerting
    # never waits on it.
    start = int(state.data.get("pane_cursor") or 0) % max(len(panes), 1)
    order = panes[start:] + panes[:start]
    unread = 0
    for index, pane in enumerate(order):
        if time.monotonic() > deadline:
            unread = len(order) - index
            state.data["pane_cursor"] = (start + index) % len(panes)
            break
        old = records.get(pane["id"])
        kind, seen = pane_state(pane, resurrect, old, now, table, budget)
        if kind in ("host", "box"):
            live += 1
            same_process = old and old.get("pid") == seen["pid"] and old.get("start") == seen["start"]
            if not seen["sid"] and same_process:
                seen["sid"] = old.get("sid")
            if kind == "box":
                seen["looked"] = old.get("looked", 0) if same_process else 0
            if (
                kind == "box" and not seen["sid"] and seen["box"] and box_lookups < 1
                and now - float(seen["looked"]) >= SID_REFRESH and deadline - time.monotonic() > 11.0
            ):
                # One box a run, only with 11 s to spare, and one try a pane per SID_REFRESH: a
                # docker exec costs about 1.5 s and box_sessions waits 10 s at most.
                box_lookups += 1
                seen["looked"] = now
                try:
                    found = resurrect.box_sessions([seen["box"]]).get(pane["id"])
                except (OSError, subprocess.SubprocessError):
                    found = None
                if found:
                    seen["sid"] = found[1]
            records[pane["id"]] = dict(seen, kind=kind, target=pane["target"], seen=now)
            continue
        if not old:
            continue
        name = f"pane {pane['id']} ({pane['target']}) session {old.get('sid') or 'unknown'}"
        if kind == "busy":
            # A pane is busy for a moment after its omp dies: the shim's bash finishing, then the
            # `exec bash -i` reading .bashrc (seconds at load 400). Only a pane that stays busy is
            # running something else on purpose.
            busy_since = float(old.setdefault("busy_since", now))
            if now - busy_since < BUSY_FORGET:
                continue
            log(f"{name}: left: the pane has run {seen['comm']}, not omp, for {human(now - busy_since)}; forgotten")
            records.pop(pane["id"], None)
            left += 1
            continue
        reason = restart_decision(old, omps, restarts, options, now, resurrect, holder, records, pane["id"])
        if reason:
            log(f"{name}: {reason}")
            records.pop(pane["id"], None)
            left += 1
            continue
        command = resume_command(old)
        if dry:
            log(f"{name}: DRY RUN, would resume: its omp is gone and the session did not end normally: {command}")
            resumed += 1
            continue
        # The pane as it is NOW, not as the listing at the start of this run had it: `agentbox
        # move` hangs a session's omp up and respawns its pane into the box launcher seconds
        # later, and a run that decided in that gap read the old pane pid, found nothing under it,
        # and killed the launcher with its own respawn (01a14b36, pane %7, 2026-11-02T05:38:05Z).
        current = pane_now(pane["id"])
        if current is None or current["pid"] != pane["pid"]:
            log(f"{name}: left: the pane was respawned while this run decided")
            continue
        if pane_processes(current["pid"], resurrect) and not current["dead"]:
            log(f"{name}: left: something started in the pane while this run decided")
            continue
        restarts[old["sid"]] = now
        state.commit(options)
        ok, error = respawn_pane(pane["id"], old["cwd"], command)
        if ok:
            log(f"{name}: RESUMED: its omp is gone and the session did not end normally: {command}")
            old["seen"] = now
            resumed += 1
        else:
            log(f"{name}: respawn-pane failed: {error}")
            left += 1
    verb = "would resume" if dry else "resumed"
    note = f"panes: {live} running omp, {verb} {resumed}, left {left}"
    if unread:
        note += f", {unread} not read this run (out of time; the next run starts there)"
    return note


def run_once(options: argparse.Namespace) -> int:
    started = time.time()
    run_clock = time.monotonic()
    envoy = Envoy(timeout=options.http_timeout)
    state = State(options.state)
    if not state.locked:
        log(f"another run holds {options.state}; skipping this period")
        return 0
    scopes_state: dict = state.data.setdefault("scopes", {})
    # Crossing memory, keyed by scope. A scope belongs to one session start (`systemd-run
    # --scope` never reuses a name), and the omp pid and its start time are kept with it so a
    # different process in the same scope starts over.
    incidents: dict = state.data.setdefault("incidents", {})
    # How many separate crossings each SESSION has had. The second one goes to the chief of
    # staff: one session that keeps coming back is a lane problem, not a spike.
    crossings: dict = state.data.setdefault("crossings", {})
    # Whether this state file has no WALL memory at all. On such a run -- the first after this
    # trigger was added, or the first after the state file was lost -- every scope's counters
    # are SEEDED and nothing is reported: a counter already above zero says a touch happened at
    # an unknown time in the past, often before this trigger existed, and reporting the whole
    # backlog at once (31 scopes on ossv-agent-open on 2026-10-30) would bury the owners in
    # history. The crossing state is no part of this test: a state file written by the version
    # before this trigger has every scope in `scopes` and no wall memory at all, and must still
    # seed. A scope that appears while the file already knows others is genuinely new, so its
    # baseline is zero and its first real touch IS reported.
    cold_start = not state.data.get("walls")
    # The wall memory, keyed by scope name and NOT reset with the pid: `systemd-run --scope`
    # never reuses a name, so a key lives exactly as long as the scope does.
    walls: dict = state.data.setdefault("walls", {})
    # Touches waiting for the box-health owner's next digest. They accumulate across runs, so a
    # digest window never loses one.
    pending_wall: list = state.data.setdefault("wall_pending", [])

    # What each omp process is measured against. Two shapes exist on this box:
    #
    #  * a CAPPED scope of its own (`shims/omp` runs each session under `systemd-run --user
    #    --scope -p MemoryMax=$OMP_MEMORY_MAX`): the scope is the session's whole budget, its
    #    tool subprocesses included, and it is exactly what the memcg OOM killer measures.
    #  * NO scope of its own: the session runs in the login session's scope
    #    (`session-c45.scope` here, 744 processes and 51 GiB of other people's work), which no
    #    cgroup limits. Charging that to one session would alert on every session in the login,
    #    so an uncapped session is measured on its OWN process RSS instead, against the
    #    machine's RAM -- the ceiling that kills it is then the global OOM killer.
    targets = []
    by_scope: dict[str, int] = {}
    omps = omp_processes()
    for pid, cgroup in omps:
        limit, limit_from, limited = effective_limit(cgroup)
        if limit <= 0:
            continue
        scope = cgroup.rsplit("/", 1)[-1]
        if limited:
            # One capped scope is one session: its several omp processes are that session's own
            # subagent lanes, and they share the one budget. The largest is the session itself.
            if scope in by_scope and rss_of(by_scope[scope]) >= rss_of(pid):
                continue
            by_scope[scope] = pid
            usage, current, fields = scope_pressure(cgroup)
            events = memory_events(cgroup)
            # memory.peak is the high-water mark of memory.current. It exists from Linux 5.19;
            # where it does not, memory.current is the best this run has and the peak test is
            # simply weaker, while the memory.events test is unaffected.
            peak = read_int(CGROUP_ROOT / cgroup.strip("/") / "memory.peak")
            targets.append(
                dict(
                    key=scope, scope=scope, cgroup=cgroup, pid=pid, limit=limit, limit_from=limit_from,
                    limited=True, usage=usage, current=current,
                    events=events, peak_bytes=peak if peak is not None else current,
                    swap_max=swap_setting(cgroup), stats=fields,
                    measured="the scope's unreclaimable memory (anon+shmem+kernel+sock), which is what"
                    " the kernel's memcg OOM killer compares with the ceiling",
                )
            )
        else:
            usage = rss_of(pid)
            targets.append(
                dict(
                    key=f"{scope}:pid{pid}", scope=scope, cgroup=cgroup, pid=pid, limit=limit,
                    limit_from=limit_from, limited=False, usage=usage, current=usage,
                    measured="this omp process's own RSS. It has NO memory ceiling of its own: it runs"
                    f" in the shared login scope {scope}, so nothing caps it and nothing but the"
                    " machine's RAM stops it",
                )
            )

    # Neither pass may fail the watch: an error is logged and the run goes on.
    bias_note = "oom bias: off"
    if options.oom_bias:
        try:
            counts = oom_bias_pass(omps, options.oom_bias_adj, options.dry_run, run_clock + BIAS_DEADLINE)
            bias_note = oom_bias_note(counts, options.oom_bias_adj, options.dry_run)
        except Exception as error:  # noqa: BLE001 -- the alerting below must still run
            bias_note = f"oom bias failed: {type(error).__name__}: {error}"

    alerts = clears = watched = walls_hit = urgent = 0
    for target in sorted(targets, key=lambda t: t["key"]):
        key, scope, cgroup, pid = target["key"], target["scope"], target["cgroup"], target["pid"]
        limit, limit_from, usage, current = target["limit"], target["limit_from"], target["usage"], target["current"]
        # The wall test first, and independent of everything below it: a scope AT memory.max is
        # reported whether or not its unreclaimable memory ever sits above the warn level, and
        # whether or not a crossing is open for it.
        if target["limited"]:
            touch = wall_touch(target, walls, options, started, cold_start)
            if touch:
                walls_hit += 1
                # Before the text exists: a report sent to an id that is not live here reaches
                # whoever holds it elsewhere, not a silent owner.
                verify_touch_session(envoy, touch)
                text = wall_text(touch) + (touch.get("session_note") or "")
                if touch["suppressed"]:
                    text += (
                        f"\nIt also touched the wall {touch['suppressed']} more time(s) inside the"
                        f" last {human(options.wall_cooldown)}, which this one report covers."
                    )
                entry = {
                    name: touch[name]
                    for name in (
                        "at", "scope", "session", "session_claim", "worker", "peak", "limit",
                        "events_delta", "top", "task_count", "rss_sum", "stats", "current",
                        "events_oom_kill",
                    )
                }
                pending_wall.append(entry)
                del pending_wall[: max(0, len(pending_wall) - options.wall_pending_max)]
                state.commit(options)
                if touch["session"] and not options.dry_run:
                    envoy.send(touch["session"], text)
                # A touch the hourly digest must not wait for. Everything else rides the
                # digest; these two are the shapes that end in a kill.
                reason = urgent_reason(touch, options)
                if reason:
                    urgent += 1
                    note = urgent_text(touch, reason)
                    if not options.dry_run:
                        heard = tell_box_health(envoy, note)
                    else:
                        heard = "(dry run)"
                    log(f"{key}: URGENT ({reason}) -> {heard or 'nobody: every route refused it'}")
                    if options.print_alert:
                        print(note)
                log(
                    f"{key}: WALL ({gib(touch['peak'])} peak of {gib(limit)}, memory.events max"
                    f" +{touch['events_delta']}) -> "
                    + (
                        f"session {touch['session']}"
                        + (f" (claim {touch['session_claim']} is not live here)" if touch.get("session_claim") else "")
                        if touch["session"]
                        else "no live session on this box could be matched"
                    )
                )
                if options.print_alert:
                    print(text)
        warn_at = limit * options.fraction
        if not target["limited"]:
            # Nothing caps this session, so "a fraction of the ceiling" would be a number no
            # session on a 251 GiB box ever reaches alone. The level that matters is the one a
            # capped session is warned at: a single uncapped session past it is as dangerous to
            # the box as a capped one is to itself.
            warn_at = min(warn_at, options.unlimited_warn * GIB)
        # Hysteresis: a crossing clears well under the level that opened it, so one session
        # sitting on the threshold cannot send an alert and a clear every period.
        clear_at = warn_at * (options.clear_fraction / options.fraction)
        record = scopes_state.setdefault(key, {})
        if record.get("pid") != pid or record.get("pid_start") != pid_start(pid):
            record.clear()
            record["pid"] = pid
            record["pid_start"] = pid_start(pid)
        samples: list = record.setdefault("samples", [])
        # Samples are kept only once a target is close to its threshold, which keeps the state
        # file small and still gives a measured rise rate well before the alert.
        if usage >= warn_at * (options.sample_fraction / options.fraction):
            samples.append([started, usage])
            del samples[: max(0, len(samples) - options.samples)]
            watched += 1
        elif samples:
            samples.clear()

        incident = incidents.get(key)
        if usage < clear_at or (incident and incident.get("pid") != pid):
            if incident:
                cause = (
                    f"it fell to {gib(usage)}, under the {gib(clear_at)} clear level"
                    if incident.get("pid") == pid
                    else f"the omp process changed: pid {incident.get('pid')} is gone, pid {pid} runs there now"
                )
                if send_clear(envoy, options, key, incident, cause, started):
                    clears += 1
                incidents.pop(key, None)
                state.commit(options)
            continue
        if usage < warn_at:
            # Between the clear level and the threshold: an open crossing stays open, and a
            # target with no crossing is simply not one yet.
            if incident:
                log(f"{key}: {gib(usage)} is between clear {gib(clear_at)} and warn {gib(warn_at)}; crossing stays open")
            continue

        incident = incidents.setdefault(key, {})
        incident.setdefault("opened_at", started)
        incident["pid"] = pid
        incident["scope"] = scope
        incident["limit"] = limit
        incident["limit_from"] = limit_from
        incident["limited"] = target["limited"]
        incident["measured"] = target["measured"]
        incident["warn_at"] = warn_at
        incident["current"] = current
        incident["swap_max"] = target.get("swap_max") or ""
        incident["usage"] = usage
        incident["peak"] = max(incident.get("peak") or 0, usage)
        incident["omp_rss"] = rss_of(pid)
        incident["task_count"] = len(scope_tasks(cgroup)) if target["limited"] else 1
        rate = rate_per_min(samples)
        if rate is not None:
            incident["rate"] = rate
            incident["rate_span"] = samples[-1][0] - samples[0][0]
        over_for = started - incident["opened_at"]
        if over_for < options.grace:
            log(f"{key}: over {gib(warn_at)} for {int(over_for)} s (< {options.grace} s grace), holding")
            state.commit(options)
            continue

        if not incident.get("alerted_at"):
            session = session_of(pid)
            incident["session"] = session
            incident["self_watch"] = self_watch_of(cgroup, pid) if target["limited"] else self_watch_anywhere(pid)
            count = crossings.get(session or key, 0) + 1
            crossings[session or key] = count
            incident["crossing_number"] = count
            # The session hears first: it owns the shedding. One session can be two of these
            # (the box-health owner's own session, say), and nobody needs the same alert twice.
            # The box-health role is a recipient like any other here, so its holder is told once.
            recipients: list[tuple[str, str]] = []
            for who, why in (
                (session, "the session itself"),
                (BOX_HEALTH_ROLE_TOPIC, "box-health owner"),
            ):
                if who and who not in {already for already, _ in recipients}:
                    recipients.append((who, why))
            text = alert_text(key, incident, started, "first alert")
            if count >= 2:
                text += f"\nThis is crossing number {count} for this session since this watch began counting."
            if not session:
                text += (
                    "\nThe session id could not be resolved from /proc, so the session itself could"
                    " not be told: only the box-health owner has this."
                )
            # On disk before a single message leaves: a resent first alert is worse than a late one.
            incident["alerted_at"] = started
            incident["alert_usage"] = usage
            incident["told"] = [who for who, _ in recipients]
            state.commit(options)
            told = []
            for who, why in recipients:
                if options.dry_run or tell(envoy, who, text):
                    told.append(who)
                    log(f"  -> {who} ({why})")
            incident["told"] = told or incident["told"]
            alerts += 1
            log(f"{key}: ALERT ({gib(usage)} of {gib(limit)}) sent to {len(told)} recipients")
            if options.print_alert:
                print(text)
        elif (
            started - incident["alerted_at"] >= options.escalate
            and not incident.get("escalated_at")
            and usage > (incident.get("alert_usage") or 0)
        ):
            text = alert_text(key, incident, started, "STILL RISING after 10 minutes")
            text += (
                f"\nNobody has shed anything since the first alert at {iso(incident['alerted_at'])}:"
                f" it was {gib(incident.get('alert_usage') or 0)} then and is {gib(usage)} now."
            )
            incident["escalated_at"] = started
            state.commit(options)
            if not options.dry_run:
                # Whoever hears a crossing must hear its clear, and only once per message: the
                # role is added to "told" when it is not already a recipient of the alert.
                heard = tell_box_health(envoy, text)
                if heard and heard not in (incident.get("told") or []):
                    incident["told"] = (incident.get("told") or []) + [heard]
            log(f"{key}: ESCALATED to the box-health owner")
        else:
            log(f"{key}: over for {human(over_for)}, already alerted at {iso(incident.get('alerted_at'))}")
        state.commit(options)

    # Forget what is no longer running, so the state file cannot grow without bound. A crossing
    # whose target is gone clears: the session ended, by its own restart or by the kernel.
    live_keys = {t["key"] for t in targets}
    for key in list(scopes_state):
        if key not in live_keys:
            scopes_state.pop(key, None)
    for key in list(incidents):
        if key not in live_keys:
            incident = incidents[key]
            if send_clear(envoy, options, key, incident, "the omp process ended: the session is no longer running", started):
                clears += 1
            incidents.pop(key, None)
    for key in list(walls):
        if key not in live_keys:
            walls.pop(key, None)

    # The box-health owner's batched view. The per-scope reports have already gone to their
    # owners; this is one message per window however many scopes touched their wall in it.
    #
    # In `collect` mode this box sends NO digest: its touches wait in the state file until a
    # collector drains them with --wall-pending-json and sends ONE message for the whole fleet.
    # Eight lane VMs each sending their own every 15 minutes was 32 messages an hour into one
    # session (Sami, 2026-10-31). Urgent touches never wait for either, so collect mode loses
    # no danger, only its share of a list.
    digests = 0
    if options.wall_digest_mode == "collect":
        if pending_wall:
            log(f"wall digest: collect mode, {len(pending_wall)} touch(es) held for the collector")
    elif pending_wall and started - (state.data.get("wall_digest_at") or 0) >= options.wall_digest:
        text = wall_digest_text(pending_wall, options.wall_digest)
        state.data["wall_digest_at"] = started
        sent = pending_wall[:]
        del pending_wall[:]
        state.commit(options)
        heard = BOX_HEALTH_ROLE_TOPIC
        if not options.dry_run:
            heard = tell_box_health(envoy, text)
        digests = len(sent)
        log(f"wall digest: {digests} touch(es) -> {heard or 'nobody: every route refused it'}")
        if options.print_alert:
            print(text)

    restart_note = "panes: restarter off"
    if options.restart:
        try:
            restart_note = restart_pass(options, state, omps, started, run_clock + RESTART_DEADLINE)
        except Exception as error:  # noqa: BLE001 -- the run's own record must still be written
            restart_note = f"panes: restarter failed: {type(error).__name__}: {error}"

    state.commit(options)
    state.close()
    log(
        f"checked {len(targets)} omp session(s), {watched} close enough to sample, in "
        f"{time.time() - started:.2f}s; {alerts} alert(s), {clears} clear(s),"
        f" {walls_hit} wall touch(es) ({urgent} urgent), {len(pending_wall)} waiting for the digest;"
        f" {bias_note}; {restart_note}"
    )
    return 0


def drain_pending(options: argparse.Namespace) -> int:
    """Print this box's waiting wall touches as JSON and clear them. For the fleet collector.

    Under the same exclusive lock as a run, so a touch is never printed twice and never lost
    between the print and the clear: the state is written before this process prints a byte.
    Each touch is stamped with this box's short name, which is the collector's only way to say
    which box a line came from. It sends nothing and decides nothing.
    """
    state = State(options.state)
    if not state.locked:
        log(f"another run holds {options.state}; nothing drained")
        print(json.dumps({"box": socket.gethostname().split(".")[0], "locked_out": True, "touches": []}))
        return 0
    box = socket.gethostname().split(".")[0]
    pending: list = state.data.setdefault("wall_pending", [])
    touches = [dict(touch, box=touch.get("box") or box) for touch in pending]
    del pending[:]
    state.commit(options)
    state.close()
    print(json.dumps({"box": box, "locked_out": False, "touches": touches}))
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument(
        "--fraction",
        type=float,
        default=0.70,
        help="alert at this fraction of the scope's ceiling (0.70 of 24 GiB = 16.8 GiB, 7.2 GiB of headroom)",
    )
    parser.add_argument("--clear-fraction", type=float, default=0.62, help="clear below this fraction (hysteresis)")
    parser.add_argument("--sample-fraction", type=float, default=0.45, help="keep rise samples above this fraction")
    parser.add_argument("--samples", type=int, default=24, help="samples kept per scope (24 x 30 s = 12 min of rise)")
    parser.add_argument("--unlimited-warn", type=float, default=16.8, help="GiB at which an UNCAPPED scope alerts")
    parser.add_argument("--grace", type=float, default=60.0, help="seconds over the threshold before it alerts")
    parser.add_argument("--escalate", type=float, default=600.0, help="seconds after an alert before the box-health owner is told")
    parser.add_argument(
        "--wall-fraction",
        type=float,
        default=0.98,
        help="memory.peak at or above this fraction of the ceiling counts as reaching the wall",
    )
    parser.add_argument(
        "--wall-cooldown", type=float, default=900.0, help="seconds between wall reports for one scope"
    )
    parser.add_argument(
        "--wall-digest", type=float, default=900.0, help="seconds between the box-health owner's batched wall digests"
    )
    parser.add_argument("--wall-top", type=int, default=3, help="processes by RSS named in a wall report")
    parser.add_argument(
        "--wall-pending-max", type=int, default=400, help="touches kept waiting for a digest before the oldest are dropped"
    )
    parser.add_argument(
        "--wall-digest-mode",
        choices=("send", "collect"),
        default="send",
        help="send: this box sends its own digest. collect: it holds its touches for a"
        " fleet collector to drain with --wall-pending-json and send as one message",
    )
    parser.add_argument(
        "--wall-urgent-anon",
        type=float,
        default=0.50,
        help="a touch whose anon is at least this fraction of the peak is sent at once, not"
        " held for the digest (an oom_kill always is)",
    )
    parser.add_argument(
        "--wall-pending-json",
        action="store_true",
        help="print this box's waiting touches as JSON and clear them, then exit; for the"
        " fleet collector. It decides nothing and sends nothing",
    )
    parser.add_argument(
        "--state",
        type=Path,
        default=DEFAULT_STATE,
        help="the owned state file; another path is for tests and never sends",
    )
    parser.add_argument("--http-timeout", type=float, default=8.0)
    parser.add_argument("--dry-run", action="store_true", help="decide and log, send nothing")
    parser.add_argument("--write-state", action="store_true", help="with --dry-run, still write the state file")
    parser.add_argument("--print-alert", action="store_true", help="print the alert text it would send")
    parser.add_argument(
        "--no-oom-bias",
        dest="oom_bias",
        action="store_false",
        help="do not raise the oom_score_adj of the processes in each capped omp scope",
    )
    parser.add_argument(
        "--oom-bias-adj",
        type=int,
        default=500,
        help="the oom_score_adj every process in a capped omp scope but the session's own omp is"
        " raised to (1-1000; +500 adds half the scope's limit to each one's OOM badness)",
    )
    parser.add_argument(
        "--no-restart",
        dest="restart",
        action="store_false",
        help="do not record omp panes nor resume a pane whose omp died",
    )
    parser.add_argument(
        "--restart-dry-run",
        action="store_true",
        help="decide and log which panes would be resumed, resume none (--dry-run implies it)",
    )
    parser.add_argument(
        "--restart-cooldown",
        type=float,
        default=3600.0,
        help="seconds before one session may be resumed again",
    )
    options = parser.parse_args()
    if not 1 <= options.oom_bias_adj <= 1000:
        parser.error("--oom-bias-adj must be between 1 and 1000")
    box_health_owner()  # refuse an unusable BOX_HEALTH_OWNER before any work
    # The once-per-crossing record lives in one file. A run on any other state file has its own
    # memory of what was already said, so it may never send: two state files are what sent two
    # "first alert" messages for one incident on 2026-10-27 at 07:53:20Z and 07:55:18Z.
    if options.state != DEFAULT_STATE and not options.dry_run:
        options.dry_run = True
        log(f"--state is not {DEFAULT_STATE}: running as --dry-run, sending nothing")
    if options.wall_pending_json:
        return drain_pending(options)
    try:
        return run_once(options)
    except Exception as error:  # a crashing watch must say so in the journal, not vanish
        log(f"run failed: {type(error).__name__}: {error}")
        return 1


if __name__ == "__main__":
    sys.exit(main())
