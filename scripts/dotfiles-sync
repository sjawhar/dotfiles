#!/usr/bin/env bash
# dotfiles-sync [--old SHA] [HOST...]: put each machine's ~/.dotfiles working copy on origin's
# main. HOST is an ssh destination, or `local` for this machine; with none, every machine in
# MACHINES below. --old is the tip main had before a history rewrite (scripts/dotfiles-squash
# prints it and tags it pre-squash-<date>); commits from that old history are dropped, while
# anything a machine holds that is neither on main nor in the old history is kept and named.
#
# A jj checkout keeps its working-copy change: it is rebased onto main, and the run refuses a
# conflict instead of resolving it. The refusal comes before the rebase: a duplicate of the
# change is rebased onto main first and abandoned, and only a duplicate with no conflict lets the
# working copy move, so a refused run leaves every file on disk as it was (the tree is production,
# and a rebased working copy writes jj's conflict markers into it). Before fetching, the working
# copy's parent is pinned with a bookmark, so the fetch cannot abandon it and roll the files on
# disk back to an older ancestor while live sessions run them. Without --old, a commit under the
# working copy whose change main lacks refuses the run, naming the commit and its session, since
# moving the working copy alone would drop that change from disk; one whose change main has (the
# original dotfiles-publish leaves when it pushes a copy) is abandoned after the move, unless a
# commit outside that set still builds on it. A plain git checkout moves only when it is clean
# and holds no commit origin's main lacks, and it lands on its `main` branch, so a session can
# commit there and `git pull --rebase`.
set -euo pipefail

# HOSTNAME=DESTINATION, every machine by user@MagicDNS name. The entry whose name is this
# machine's hostname syncs locally.
MACHINES=(
  sami=sami@sami
  oryx=agent@oryx
  sami-leanperf=sami@sami-leanperf
  sami-rocqperf=sami@sami-rocqperf
)

# on_main <commit>: true when $main already has <commit>'s change, as when dotfiles-publish pushed
# a copy of it and left the original under the working copy: applying it to main changes nothing,
# or a commit on main since the fork point ($main_patches) carries the same patch.
on_main() {
  local tree
  tree=$(git merge-tree --write-tree --merge-base="$1^" "$main" "$1" 2>/dev/null) \
    && [ "$tree" = "$(git rev-parse "$main^{tree}")" ] && return 0
  [ -n "$main_patches" ] && grep -qx "$(git diff-tree -p "$1" | git patch-id --stable | cut -d' ' -f1)" <<<"$main_patches"
}

sync_here() {
  local old="$1"
  set +eu
  # shellcheck disable=SC1090
  source ~/.dotfiles/.bashrc >/dev/null 2>&1
  set -eu
  cd ~/.dotfiles
  if [ -n "$old" ] && ! git cat-file -e "$old^{commit}" 2>/dev/null; then
    git fetch -q origin "$old"
  fi
  if [ -d .jj ] && jj --version >/dev/null 2>&1; then
    local anchor=dotfiles-sync-anchor wc before after local_only=""
    jj bookmark create "$anchor" -r @- >/dev/null 2>&1 || jj bookmark set "$anchor" -r @- --allow-backwards >/dev/null
    # Commits under the working copy that the old main never had are this machine's own.
    [ -z "$old" ] || local_only=$(git log --oneline "$(jj log -r @- --no-graph -T 'commit_id')" ^"$old")
    wc=$(jj log -r @ --no-graph -T 'change_id')
    before=$(jj diff -r @ --git | { grep -v '^index ' || true; } | sha256sum)
    jj git fetch --quiet
    # Commits under the working copy that main lacks (after a squash, --old handles them below).
    # Moving the working copy alone onto main would drop their changes from the files on disk, so
    # one whose change main does not have stops the run; the others, originals dotfiles-publish
    # left when it pushed a copy, are abandoned once the working copy is on main.
    local main="" main_patches="" c below="" published="" unpublished=""
    [ -n "$old" ] || below=$(jj log -r "::@- ~ ::main@origin" --no-graph -T 'commit_id ++ " "')
    if [ -n "$below" ]; then
      main=$(jj log -r main@origin --no-graph -T 'commit_id')
      main_patches=$(git log -p --no-merges "$(git merge-base "$main" "$(jj log -r @- --no-graph -T 'commit_id')")..$main" | git patch-id --stable | cut -d' ' -f1) || main_patches=""
      for c in $below; do
        if on_main "$c"; then published+="${published:+|}$c"; else unpublished+="${unpublished:+|}$c"; fi
      done
      if [ -n "$unpublished" ]; then
        echo "UNPUBLISHED: commits under the working copy that main lacks; not moved, nothing on disk changed. Each session publishes its own with dotfiles-publish <commit>:" >&2
        jj log -r "$unpublished" --no-graph >&2 \
          -T 'commit_id.short() ++ " " ++ trailers.filter(|t| t.key() == "Omp-Session").map(|t| t.value()).join(",") ++ " " ++ description.first_line() ++ "\n"'
        jj bookmark delete "$anchor" >/dev/null
        return 1
      fi
    fi
    if [ "$(jj log -r @ --no-graph -T 'empty')" = true ]; then
      jj new --quiet main@origin
    else
      # Trial first, on a duplicate that no working copy holds, so a conflict never reaches disk.
      local trial trial_conflict
      # awk reads to the end: an early `exit` would leave jj a broken pipe, which it exits 3 on.
      trial=$(jj duplicate --color never "$wc" --onto main@origin 2>&1 | awk '/^Duplicated / && !n {print $5; n = 1}')
      if [ -z "$trial" ]; then
        echo "could not trial-rebase the working-copy change $wc onto main; not moved" >&2
        return 1
      fi
      trial_conflict=$(jj log -r "$trial" --no-graph -T 'conflict')
      # The trial is this run's own copy; it carries the working copy's description, which omp's
      # per-session jj config can make immutable here.
      jj abandon --quiet --ignore-immutable "$trial"
      if [ "$trial_conflict" = true ]; then
        echo "CONFLICT: the working-copy change $wc conflicts with main; not moved, nothing on disk changed; resolve it here" >&2
        return 1
      fi
      jj rebase --quiet -r "$wc" -d main@origin
      if [ "$(jj log -r "$wc" --no-graph -T 'conflict')" = true ]; then
        echo "CONFLICT: the working-copy change $wc conflicts with main; resolve it here" >&2
        return 1
      fi
      after=$(jj diff -r "$wc" --git | { grep -v '^index ' || true; } | sha256sum)
      if [ "$(jj log -r "$wc" --no-graph -T 'empty')" = true ]; then
        jj new --quiet main@origin
        # Moving off an empty, undescribed change abandons it; a described one stays.
        if jj log -r "$wc" --no-graph -T 'change_id' >/dev/null 2>&1; then
          jj abandon --quiet "$wc"
        fi
        echo "working-copy change already on main; dropped"
      elif [ "$before" != "$after" ]; then
        echo "kept working-copy change (diff text changed by the rebase, review it):"; jj diff -r "$wc" --stat
      else
        echo "kept working-copy change unchanged:"; jj diff -r "$wc" --stat
      fi
    fi
    if [ -n "$local_only" ]; then
      printf 'local commits that were never on main, left in place under bookmark %s:\n%s\n' "$anchor-kept" "$local_only"
      jj bookmark set "$anchor-kept" -r "$anchor" --allow-backwards >/dev/null
    elif [ -n "$old" ]; then
      # The old week's commits, except any another workspace's working copy still sits on.
      jj abandon --quiet --ignore-immutable "::$anchor ~ ::main@origin ~ ::working_copies()"
    fi
    jj bookmark delete "$anchor" >/dev/null
    if [ -n "$published" ]; then
      # Their changes are on main. One that any commit outside them still builds on (a working
      # copy, another session's side branch) stays: abandoning it would rebase that commit, and
      # on 2026-11-02 at 20:29Z this step rebased eight such commits, three into conflicts. None
      # is under a working copy, so jj leaves the working copy alone: its checkout step lost a
      # race to another session's `jj commit` the same minute ("Concurrent checkout").
      published="($published) ~ ::(visible_heads() ~ ($published))"
      echo "dropped commits whose changes main already has:"
      jj log --ignore-working-copy -r "$published" --no-graph -T 'commit_id.short() ++ " " ++ description.first_line() ++ "\n"'
      jj abandon --ignore-working-copy --quiet --ignore-immutable "$published"
    fi
    printf '%s on %s\n' "$(hostname)" "$(jj log -r @- --no-graph -T 'commit_id.short()')"
  else
    git fetch -q origin
    if [ -n "$(git status --porcelain)" ]; then
      echo "DIRTY: $(hostname) has uncommitted changes; not moved" >&2
      git status --short >&2
      return 1
    fi
    # Commits on HEAD or the main branch that origin's main (and, after a squash, the old
    # history) lacks are this machine's own; moving main would drop them from the branch.
    local own
    own=$(git rev-list HEAD $(git rev-parse -q --verify refs/heads/main) ^origin/main ${old:+"^$old"})
    if [ -n "$own" ]; then
      echo "LOCAL COMMITS on $(hostname); not moved:" >&2
      git log --oneline --no-walk $own >&2
      return 1
    fi
    git checkout -q -B main origin/main
    git branch -q --set-upstream-to=origin/main main
    printf '%s on %s\n' "$(hostname)" "$(git rev-parse --short HEAD)"
  fi
  # A checkout rewrites a changed file with the writer's umask (mailbox.toml was found at 0664
  # after one), and mailbox refuses a group-writable config; restore the installer's mode.
  [ ! -f mailbox.toml ] || chmod 600 mailbox.toml
}

if [ "${1:-}" = --here ]; then
  sync_here "${2:-}"
  exit
fi

old=""
if [ "${1:-}" = --old ]; then
  old="$2"; shift 2
  # A tag name is resolved here, so no machine imports the tag (jj would keep the old history visible).
  [[ "$old" =~ ^[0-9a-f]{7,40}$ ]] || old=$(git -C ~/.dotfiles ls-remote origin "refs/tags/$old" | cut -f1)
  [ -n "$old" ] || { echo "--old: no such commit or tag on origin" >&2; exit 2; }
fi
dest_for() {
  local m
  for m in "${MACHINES[@]}"; do
    if [ "${m%%=*}" = "$1" ]; then echo "${m#*=}"; return; fi
  done
  echo "$1"
}
hosts=("$@")
if [ ${#hosts[@]} -eq 0 ]; then
  for m in "${MACHINES[@]}"; do hosts+=("${m%%=*}"); done
fi

status=0
for h in "${hosts[@]}"; do
  echo "== $h"
  if [ "$h" = local ] || [ "$h" = "$(hostname)" ]; then
    "$0" --here "$old" || status=1
  else
    timeout 180 ssh -o BatchMode=yes -o ConnectTimeout=10 "$(dest_for "$h")" bash -s -- --here "$old" < "$0" || status=1
  fi
done
exit $status
