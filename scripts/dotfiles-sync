#!/usr/bin/env bash
# dotfiles-sync [--old SHA] [HOST...]: put each machine's ~/.dotfiles working copy on origin's
# main. HOST is an ssh destination, or `local` for this machine; with none, every machine in
# MACHINES below. --old is the tip main had before a history rewrite (scripts/dotfiles-squash
# prints it and tags it pre-squash-<date>); commits from that old history are dropped, except one
# that a commit outside it still builds on, while anything a machine holds that is neither on main
# nor in the old history is kept and named.
#
# After the move, each host path runs the tools step on the machine it moved, in the same ssh
# session for a remote host: `mise install` in the checkout, then `bun install --frozen-lockfile`
# in omp/plugins when its package.json is there, with the mise binary and MISE_DATA_DIR (and
# MISE_CACHE_DIR where it sets one) that the checkout's .bashrc gives a shell. It runs after every
# move that ends on main, also when main brought nothing new, so a later sync installs a pin an
# earlier step did not. `mise install` holds an exclusive lock on
# $MISE_DATA_DIR/.dotfiles-install.lock, the one dotfiles-follow and agent-session take for their
# own installs, so a launch during the install waits for it instead of finding no binary. A failed
# `mise install` stops the step before Bun, whose mise shim could install outside that lock. Each
# command has DOTFILES_TOOLS_TIMEOUT seconds (a whole number 1-600; default 600), the lock wait
# included; a failure or a command past its limit prints the command, its status and the last
# lines of its output, keeps the move, and the run exits non-zero after the other hosts. A remote
# host's ssh limit is its parts: 180 s for the move, the 300 s default sync-lock wait, and each
# command's limit plus its 10 s kill grace. The sync lock is released before the step, so an
# install does not hold off another move.
#
# Internal modes: --here OLD is the move alone, which dotfiles-follow calls and follows with its
# own tools step (it reports a failed install as TOOLS NOT INSTALLED, not as a failed move);
# --here-tools OLD is the move and then the step; --tools DIR is the step alone, which
# dotfiles-publish runs after a rebase that moved the files.
#
# A jj checkout keeps its working-copy change: it is rebased onto main, and the run refuses a
# conflict instead of resolving it. The refusal comes before the rebase: a duplicate of the
# change is rebased onto main first and abandoned, and only a duplicate with no conflict lets the
# working copy move, so a refused run leaves every file on disk as it was (the tree is production,
# and a rebased working copy writes jj's conflict markers into it). Before fetching, the working
# copy's parent is pinned with a bookmark, so the fetch cannot abandon it and roll the files on
# disk back to an older ancestor while live sessions run them. Without --old, a commit under the
# working copy whose change main lacks refuses the run, naming the commit and its session, since
# moving the working copy alone would drop that change from disk; one whose change main has (the
# original dotfiles-publish leaves when it pushes a copy) is abandoned after the move, unless a
# commit outside that set still builds on it. A plain git checkout moves only when it is clean
# and holds no commit origin's main lacks, and it lands on its `main` branch, so a session can
# commit there and `git pull --rebase`.
set -euo pipefail

# dotfiles-follow uses this status only for a failed jj fetch. Other non-zero exits are sync
# refusals, which follow reports immediately.
JJ_FETCH_FAILURE=75

# HOSTNAME=DESTINATION, every machine by user@MagicDNS name. The entry whose name is this
# machine's hostname syncs locally. oryx follows main by its own dotfiles-follow timer.
MACHINES=(
  sami=sami@sami
  sami-leanperf=sami@sami-leanperf
  sami-rocqperf=sami@sami-rocqperf
)

# hunks: a -U0 patch on stdin, written as one line per hunk (its path, then its - and + lines, no
# line numbers) and one per mode change, sorted. A binary change prints `binary`, which no hunk on
# main matches.
hunks() {
  awk '
    function flush() { if (rec != "") print rec; rec = "" }
    /^diff --git / { flush(); hdr = 1; path = substr($0, index($0, " b/") + 3); next }
    hdr && /^(old|new|deleted file|new file) mode / { print path "\037" $0; next }
    hdr && /^(Binary files|GIT binary patch)/ { print "binary"; next }
    /^@@/ { flush(); hdr = 0; rec = path; next }
    !hdr && /^[-+\\]/ { rec = rec "\037" $0 }
    END { flush() }' | LC_ALL=C sort -u
}

# on_main <commit>: true when $main already has <commit>'s change, as when dotfiles-publish pushed
# a copy of it and left the original under the working copy: applying it to main changes nothing,
# or a commit on main since the fork point ($main_patches) carries the same patch, or every hunk of
# <commit>, read without context lines or line numbers, is one that a commit on main since the fork
# point made ($main_hunks). The last case is a copy whose lines main changed again after the push:
# on 2026-11-03 four such originals under sami-rocqperf's working copy (their copies 317e320e,
# ded161f2, 261cb431 and 74bf4ce7 on main) stopped every sync there as UNPUBLISHED.
on_main() {
  local tree own
  tree=$(git merge-tree --write-tree --merge-base="$1^" "$main" "$1" 2>/dev/null) \
    && [ "$tree" = "$(git rev-parse "$main^{tree}")" ] && return 0
  [ -n "$main_patches" ] && grep -qx "$(git diff-tree -p "$1" | git patch-id --stable | cut -d' ' -f1)" <<<"$main_patches" && return 0
  own=$(git diff-tree -p -U0 --no-renames "$1" | hunks)
  [ -n "$own" ] && [ -n "$main_hunks" ] && ! grep -qx binary <<<"$own" \
    && [ -z "$(LC_ALL=C comm -23 <(printf '%s\n' "$own") <(printf '%s\n' "$main_hunks"))" ]
}

tools_limit() {
  local raw="${DOTFILES_TOOLS_TIMEOUT:-}" value
  if [[ -z ${DOTFILES_TOOLS_TIMEOUT+x} ]]; then
    printf '%s\n' 600
    return
  fi
  if [[ "$raw" =~ ^0*([1-9][0-9]*)$ ]]; then
    value="${BASH_REMATCH[1]}"
    if (( ${#value} <= 3 && 10#$value <= 600 )); then
      printf '%s\n' "$value"
      return
    fi
  fi
  printf 'dotfiles-sync: DOTFILES_TOOLS_TIMEOUT=%s is invalid; using 600\n' "$raw" >&2
  printf '%s\n' 600
}

tools_error() {
  local command="$1" dir="$2" status="$3" limit="$4" output="$5" tick='`'
  printf 'dotfiles-sync: tools step: %s%s%s in %s exited %s' "$tick" "$command" "$tick" "$dir" "$status" >&2
  if [[ "$status" = 124 || "$status" = 137 ]]; then
    printf ' (past its limit of %s s, lock wait included)' "$limit" >&2
  fi
  printf '\nlast lines of its output:\n' >&2
  tail -n 20 "$output" >&2 || true
}

tools_step() (
  local dir limit lock mise output status
  # The checkout as an absolute path: mise reads the pins of the directory it runs in, so the
  # install runs there whatever the caller's directory, and DIR/bin/mise must still name it.
  if ! dir="$(cd -- "$1" 2>/dev/null && pwd)"; then
    echo "dotfiles-sync: tools step: no checkout at $1" >&2
    return 1
  fi
  set +eu
  if [[ -f "$dir/.bashrc" ]]; then
    DOTFILES_DIR="$dir"
    export DOTFILES_DIR
    # shellcheck disable=SC1091
    source "$dir/.bashrc" >/dev/null 2>&1
  fi
  set -eu

  export MISE_DATA_DIR="${MISE_DATA_DIR:-$HOME/.mise}"
  # A directory it cannot make is reported below, as flock's failure to open the lock.
  mkdir -p "$MISE_DATA_DIR" 2>/dev/null || true
  limit="$(tools_limit)"
  lock="$MISE_DATA_DIR/.dotfiles-install.lock"
  output="$(mktemp)"
  if [[ -x "$dir/bin/mise" ]]; then
    mise="$dir/bin/mise"
  elif ! mise="$(command -v mise 2>/dev/null)"; then
    printf 'mise: command not found\n' >"$output"
    tools_error "mise install" "$dir" 127 "$limit" "$output"
    rm -f "$output" || true
    return 127
  fi
  if (cd "$dir" && timeout -k 10 "$limit" flock "$lock" "$mise" install) >"$output" 2>&1; then
    printf 'tools: %smise install%s passed in %s\n' '`' '`' "$dir"
  else
    status=$?
    tools_error "mise install" "$dir" "$status" "$limit" "$output"
    rm -f "$output" || true
    return "$status"
  fi
  rm -f "$output"

  [[ -f "$dir/omp/plugins/package.json" ]] || return 0
  output="$(mktemp)"
  if (cd "$dir/omp/plugins" && timeout -k 10 "$limit" bun install --frozen-lockfile) >"$output" 2>&1; then
    printf 'tools: %sbun install --frozen-lockfile%s passed in %s/omp/plugins\n' '`' '`' "$dir"
  else
    status=$?
    tools_error "bun install --frozen-lockfile" "$dir/omp/plugins" "$status" "$limit" "$output"
    rm -f "$output" || true
    return "$status"
  fi
  rm -f "$output"
)

sync_here() {
  local old="$1"
  set +eu
  # shellcheck disable=SC1090
  source ~/.dotfiles/.bashrc >/dev/null 2>&1
  set -eu
  cd ~/.dotfiles
  local lock
  lock="$(git rev-parse --git-common-dir)/dotfiles-sync.lock"
  exec 8>"$lock"
  if ! flock -w "${DOTFILES_SYNC_LOCK_WAIT:-300}" 8; then
    echo "another dotfiles-sync holds $lock; not moved" >&2
    return 1
  fi
  if [ -n "$old" ] && ! git cat-file -e "$old^{commit}" 2>/dev/null; then
    git fetch -q origin "$old"
  fi
  if [ -d .jj ] && jj --version >/dev/null 2>&1; then
    local anchor=dotfiles-sync-anchor wc before after local_only=""
    jj bookmark create "$anchor" -r @- >/dev/null 2>&1 || jj bookmark set "$anchor" -r @- --allow-backwards >/dev/null
    # Any exit, a failed jj command under set -e included, drops the anchor; every refusal below also
    # drops it before it returns.
    trap 'jj bookmark delete dotfiles-sync-anchor >/dev/null 2>&1 || true' EXIT
    # Commits under the working copy that the old main never had are this machine's own.
    [ -z "$old" ] || local_only=$(git log --oneline "$(jj log -r @- --no-graph -T 'commit_id')" ^"$old")
    wc=$(jj log -r @ --no-graph -T 'change_id')
    before=$(jj diff -r @ --git | { grep -v '^index ' || true; } | sha256sum)
    if ! jj git fetch --quiet; then
      jj bookmark delete "$anchor" >/dev/null
      return "$JJ_FETCH_FAILURE"
    fi
    # Commits under the working copy that main lacks (after a squash, --old handles them below).
    # Moving the working copy alone onto main would drop their changes from the files on disk, so
    # one whose change main does not have stops the run; the others, originals dotfiles-publish
    # left when it pushed a copy, are abandoned once the working copy is on main.
    local main="" main_patches="" main_hunks="" fork c below="" published="" unpublished=""
    [ -n "$old" ] || below=$(jj log -r "::@- ~ ::main@origin" --no-graph -T 'commit_id ++ " "')
    if [ -n "$below" ]; then
      main=$(jj log -r main@origin --no-graph -T 'commit_id')
      fork=$(git merge-base "$main" "$(jj log -r @- --no-graph -T 'commit_id')")
      main_patches=$(git log -p --no-merges "$fork..$main" | git patch-id --stable | cut -d' ' -f1) || main_patches=""
      main_hunks=$(git rev-list --no-merges "$fork..$main" | git diff-tree --stdin -p -U0 --no-renames | hunks) || main_hunks=""
      for c in $below; do
        if on_main "$c"; then published+="${published:+|}$c"; else unpublished+="${unpublished:+|}$c"; fi
      done
      if [ -n "$unpublished" ]; then
        echo "UNPUBLISHED: commits under the working copy that main lacks; not moved, nothing on disk changed. Each session publishes its own with dotfiles-publish <commit>:" >&2
        jj log -r "$unpublished" --no-graph >&2 \
          -T 'commit_id.short() ++ " " ++ trailers.filter(|t| t.key() == "Omp-Session").map(|t| t.value()).join(",") ++ " " ++ description.first_line() ++ "\n"'
        jj bookmark delete "$anchor" >/dev/null
        return 1
      fi
    fi
    if [ "$(jj log -r @ --no-graph -T 'empty')" = true ]; then
      jj new --quiet main@origin
    else
      # Trial first, on a duplicate that no working copy holds, so a conflict never reaches disk.
      local trial trial_conflict duplicated
      # A failed duplicate is a refusal like the others: say it and drop the anchor.
      duplicated=$(jj duplicate --color never "$wc" --onto main@origin 2>&1) || true
      trial=$(awk '/^Duplicated / && !n {print $5; n = 1}' <<< "$duplicated")
      if [ -z "$trial" ]; then
        echo "could not trial-rebase the working-copy change $wc onto main; not moved" >&2
        [ -z "$duplicated" ] || printf '%s\n' "$duplicated" >&2
        jj bookmark delete "$anchor" >/dev/null
        return 1
      fi
      trial_conflict=$(jj log -r "$trial" --no-graph -T 'conflict')
      # The trial is this run's own copy; it carries the working copy's description, which omp's
      # per-session jj config can make immutable here.
      jj abandon --quiet --ignore-immutable "$trial"
      if [ "$trial_conflict" = true ]; then
        echo "CONFLICT: the working-copy change $wc conflicts with main; not moved, nothing on disk changed; resolve it here" >&2
        jj bookmark delete "$anchor" >/dev/null
        return 1
      fi
      jj rebase --quiet -r "$wc" -d main@origin
      if [ "$(jj log -r "$wc" --no-graph -T 'conflict')" = true ]; then
        echo "CONFLICT: the working-copy change $wc conflicts with main; resolve it here" >&2
        jj bookmark delete "$anchor" >/dev/null
        return 1
      fi
      after=$(jj diff -r "$wc" --git | { grep -v '^index ' || true; } | sha256sum)
      if [ "$(jj log -r "$wc" --no-graph -T 'empty')" = true ]; then
        jj new --quiet main@origin
        # Moving off an empty, undescribed change abandons it; a described one stays.
        if jj log -r "$wc" --no-graph -T 'change_id' >/dev/null 2>&1; then
          jj abandon --quiet "$wc"
        fi
        echo "working-copy change already on main; dropped"
      elif [ "$before" != "$after" ]; then
        echo "kept working-copy change (diff text changed by the rebase, review it):"; jj diff -r "$wc" --stat
      else
        echo "kept working-copy change unchanged:"; jj diff -r "$wc" --stat
      fi
    fi
    if [ -n "$local_only" ]; then
      printf 'local commits that were never on main, left in place under bookmark %s:\n%s\n' "$anchor-kept" "$local_only"
      jj bookmark set "$anchor-kept" -r "$anchor" --allow-backwards >/dev/null
    elif [ -n "$old" ]; then
      # The old week's commits, except one that any commit outside them still builds on (a working
      # copy, another session's side branch): abandoning it would rebase that commit, and on
      # 2026-11-02 at 05:04:54Z this step abandoned 524 commits and rebased the 165 commits built on
      # them, most into conflicts. The working copy already sits on main, so jj leaves it alone.
      local week="::$anchor ~ ::main@origin"
      jj abandon --ignore-working-copy --quiet --ignore-immutable "($week) ~ ::(visible_heads() ~ ($week))"
    fi
    jj bookmark delete "$anchor" >/dev/null
    if [ -n "$published" ]; then
      # Their changes are on main. One that any commit outside them still builds on (a working
      # copy, another session's side branch) stays: abandoning it would rebase that commit, and
      # on 2026-11-02 at 20:29Z this step rebased eight such commits, three into conflicts. None
      # is under a working copy, so jj leaves the working copy alone: its checkout step lost a
      # race to another session's `jj commit` the same minute ("Concurrent checkout").
      published="($published) ~ ::(visible_heads() ~ ($published))"
      echo "dropped commits whose changes main already has:"
      jj log --ignore-working-copy -r "$published" --no-graph -T 'commit_id.short() ++ " " ++ description.first_line() ++ "\n"'
      jj abandon --ignore-working-copy --quiet --ignore-immutable "$published"
    fi
    printf '%s on %s\n' "$(hostname)" "$(jj log -r @- --no-graph -T 'commit_id.short()')"
  else
    git fetch -q origin
    if [ -n "$(git status --porcelain)" ]; then
      echo "DIRTY: $(hostname) has uncommitted changes; not moved" >&2
      git status --short >&2
      return 1
    fi
    # Commits on HEAD or the main branch that origin's main (and, after a squash, the old
    # history) lacks are this machine's own; moving main would drop them from the branch.
    local own
    own=$(git rev-list HEAD $(git rev-parse -q --verify refs/heads/main) ^origin/main ${old:+"^$old"})
    if [ -n "$own" ]; then
      echo "LOCAL COMMITS on $(hostname); not moved:" >&2
      git log --oneline --no-walk $own >&2
      return 1
    fi
    git checkout -q -B main origin/main
    git branch -q --set-upstream-to=origin/main main
    printf '%s on %s\n' "$(hostname)" "$(git rev-parse --short HEAD)"
  fi
  # A checkout rewrites a changed file with the writer's umask (mailbox.toml was found at 0664
  # after one), and mailbox refuses a group-writable config; restore the installer's mode.
  [ ! -f mailbox.toml ] || chmod 600 mailbox.toml
}

if [ "${1:-}" = --here ]; then
  sync_here "${2:-}"
  exit
fi
if [ "${1:-}" = --here-tools ]; then
  sync_here "${2:-}"
  exec 8>&-
  tools_step "$HOME/.dotfiles"
  exit
fi
if [ "${1:-}" = --tools ]; then
  [[ $# -eq 2 ]] || { echo "--tools: require a checkout directory" >&2; exit 2; }
  tools_step "$2"
  exit
fi

old=""
if [ "${1:-}" = --old ]; then
  old="$2"; shift 2
  # A tag name is resolved here, so no machine imports the tag (jj would keep the old history visible).
  [[ "$old" =~ ^[0-9a-f]{7,40}$ ]] || old=$(git -C ~/.dotfiles ls-remote origin "refs/tags/$old" | cut -f1)
  [ -n "$old" ] || { echo "--old: no such commit or tag on origin" >&2; exit 2; }
fi
dest_for() {
  local m
  for m in "${MACHINES[@]}"; do
    if [ "${m%%=*}" = "$1" ]; then echo "${m#*=}"; return; fi
  done
  echo "$1"
}
hosts=("$@")
if [ ${#hosts[@]} -eq 0 ]; then
  for m in "${MACHINES[@]}"; do hosts+=("${m%%=*}"); done
fi

tools_timeout="$(tools_limit)"
remote_move_timeout=180
remote_sync_lock_wait=300
remote_tools_grace=10
remote_tools_commands=2
remote_limit=$((remote_move_timeout + remote_sync_lock_wait + remote_tools_commands * (tools_timeout + remote_tools_grace)))

status=0
for h in "${hosts[@]}"; do
  echo "== $h"
  if [ "$h" = local ] || [ "$h" = "$(hostname)" ]; then
    DOTFILES_TOOLS_TIMEOUT="$tools_timeout" "$0" --here-tools "$old" || status=1
  else
    timeout "$remote_limit" ssh -o BatchMode=yes -o ConnectTimeout=10 "$(dest_for "$h")" env DOTFILES_TOOLS_TIMEOUT="$tools_timeout" bash -s -- --here-tools "$old" < "$0" || status=1
  fi
done
exit $status
