#!/usr/bin/env bash
# ossv-box-gateway-key -- (sami-rocqperf, sami-devbox) keep this box's OSS Verify model-gateway key in tmpfs, and in
# the models.yml omp reads, where omp/models.local.yml's `apiKeyFile` points scripts/omp-models-build
# (dispatch://INFRA-398).
#
# The key is consumer `box` (team box) of agent-infra's model-gateway/ stack, which mints it and writes it to Secret
# Manager as theorem-agent-infra's agent-secrets-box-model-gateway-key. Only the gateway VM's own account may read
# that secret, so this asks the gateway VM, over ssh on the tailnet, to read the newest version with its own metadata
# token. The policy grants sami-rocqperf's two addresses tag:model-gateway on tcp:22 (agent-infra#335) and tcp:4000
# (#336); sami-devbox reaches the VM the same way, with the ossv-vm key the secrets broker installs there
# (`bin/ossv-vm ssh model-gateway true` passed there 2026-11-03 17:21Z). Its omp signs in to the gateway with the
# dev-box@ ID token of ossv-box-gateway-token; the key file serves the tools that need the key itself (a Claude Code
# `apiKeyHelper`). The key is written 0600 to $XDG_RUNTIME_DIR/ossv-box/gateway-key, which is tmpfs, so it is gone
# after a reboot and this unit puts it back. After each run that has the key, it runs scripts/omp-models-build, which
# writes the key into ~/.omp/agent/models.yml (mode 0600) as a literal for each provider that names the file as
# `apiKeyFile`, so omp starts no process to read it. A rotated key reaches each omp at its next start. The key passes
# through this process only, and is never printed or logged.
set -uo pipefail
# The unit runs in systemd's non-login environment, whose PATH has no gcloud, and ossv-vm calls gcloud whenever its
# instance cache misses: every run failed with "gcloud: command not found" from 2026-10-26 23:06Z until this line.
# shims/gcloud finds the SDK on either machine (sami-devbox's is in ~/.gcloud). mise's shims give omp-models-build
# its yq.
export PATH="$HOME/.dotfiles/shims:$HOME/.dotfiles/bin:$HOME/.mise/shims:$PATH"
d="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/ossv-box"
f="$d/gateway-key"
install -d -m 700 "$d" || exit 1
k="$(timeout 120 "$HOME/src/oss-verifier/bin/ossv-vm" ssh model-gateway 'bash -s' << 'EOF' 2> /dev/null | tr -d '\r\n'
set -euo pipefail
t="$(curl -fsS -m 10 -H 'Metadata-Flavor: Google' \
  http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token | jq -er .access_token)"
curl -fsS -m 20 -K <(printf 'header = "Authorization: Bearer %s"\n' "$t") \
  "https://secretmanager.googleapis.com/v1/projects/theorem-agent-infra/secrets/agent-secrets-box-model-gateway-key/versions/latest:access" \
  | jq -er .payload.data | base64 -d
EOF
)" || k=""
case "$k" in
  sk-*)
    if ! { [ -s "$f" ] && [ "$(cat "$f")" = "$k" ]; }; then
      umask 077
      printf %s "$k" > "$f.new" && mv -f "$f.new" "$f"
      logger -t ossv-box-gateway-key -- "key written to $f"
    fi
    # Every run, not only on a new key: the build also repairs a models.yml written while this file was missing.
    "$HOME/.dotfiles/scripts/omp-models-build" || {
      logger -t ossv-box-gateway-key -- "omp-models-build failed"
      echo "ossv-box-gateway-key: omp-models-build failed" >&2
      exit 1
    }
    ;;
  *)
    rm -f "$f.new"
    logger -t ossv-box-gateway-key -- "no key from Secret Manager through ossv-model-gateway"
    echo "ossv-box-gateway-key: no key from Secret Manager through ossv-model-gateway" >&2
    exit 1
    ;;
esac
