#!/usr/bin/env python3
"""omp-fork: ask a read-only fork of an omp session one question, and print its answer as JSON.

  omp-fork [--at ENTRY] [--model M] [--max-time T] [--cwd DIR] [--keep DIR]
           SESSION.jsonl (PROMPT | --prompt-file FILE)

The session file is copied into a private scratch directory and omp is asked to FORK that copy
for one non-interactive turn (`omp -p --mode json --fork`), in the session's own working
directory and with its own model unless --model or --cwd say otherwise. The original file is
never written.

--at ENTRY cuts the copy after that line of the file, so the fork answers as the agent stood then.
The cut moves back to the last message after which no tool call is waiting for its result; a call
whose result never arrived within 60 lines is treated as abandoned. omp's own `--fork` does not
cut; it takes the whole file it is given, which is why the cut copy exists.

`--fork` gives the run a session id of ITS OWN, recorded with `parentSession` set to the source,
and resolves it before any session is created; it keeps every non-header entry, so the fork
answers with the source's full context. That new id is what makes this safe: everything keyed by
session id -- Envoy's registry of sessions, roles and messages, and secretsd's registry of
tokens and grants -- sees a new session rather than a second copy of the live one. A plain
`omp --resume` of the copy kept the live session's id, and both registries were taken over by
it: Envoy on 2026-11-05, and on 2026-11-07 secretsd, where the copy's REGISTER revoked the live
session's grants and its exit UNREGISTERed the id, leaving 59 of 153 live sessions answering
UNKNOWN_TOKEN (dispatch://INFRA-1644). The fork therefore runs with the caller's own environment,
Envoy, profile and secretsd included. Telling the fork not to change anything is the prompt's job.

Prints {"text", "model", "fallback", "cost", "tokens", "cut", "fork_session"} on stdout. `fallback` is
true when an answer came from a model other than the session's own (omp's fallback chain, often
after a refusal); `fork_session` is the fork's own transcript when --keep DIR saved it, else null.
Exits 1 when the fork gave no answer.
"""
import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

ABANDONED_AFTER = 60


def cut_line(path: Path, at: int) -> int:
    pending: dict[str, int] = {}
    best = 0
    with path.open("rb") as fh:
        for n, raw in enumerate(fh, 1):
            if n > at:
                break
            entry = json.loads(raw)
            if entry.get("type") != "message":
                continue
            msg = entry["message"]
            if msg.get("role") == "assistant":
                for block in msg.get("content") or []:
                    if isinstance(block, dict) and block.get("type") == "toolCall":
                        pending[block.get("id")] = n
            elif msg.get("role") == "toolResult":
                pending.pop(msg.get("toolCallId"), None)
            if not any(n - line <= ABANDONED_AFTER for line in pending.values()):
                best = n
    if best == 0:
        sys.exit(f"omp-fork: no complete message at or before line {at} of {path}")
    return best


def session_cwd(path: Path) -> str:
    with path.open("rb") as fh:
        for raw in fh:
            entry = json.loads(raw)
            if entry.get("type") == "session":
                return entry["cwd"]
    sys.exit(f"omp-fork: {path} has no session header")


def last_model(path: Path) -> str | None:
    """The model the copy resumes on: its last model_change, without a thinking suffix."""
    model = None
    with path.open("rb") as fh:
        for raw in fh:
            if b'"type":"model_change"' in raw[:60]:
                model = json.loads(raw).get("model")
    return model.split(":")[0] if model else None


def main() -> None:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("session", type=Path)
    ap.add_argument("prompt", nargs="?")
    ap.add_argument("--prompt-file", type=Path)
    ap.add_argument("--at", type=int, help="cut the copy after this line of the session file")
    ap.add_argument("--model", help="model for the fork; default: the session's own")
    ap.add_argument("--max-time", default="15m", help="omp --max-time for the fork (default 15m)")
    ap.add_argument("--cwd", help="working directory; default: the session's own")
    ap.add_argument("--keep", type=Path, help="copy the fork's transcript into this directory")
    args = ap.parse_args()
    if (args.prompt is None) == (args.prompt_file is None):
        ap.error("give exactly one of PROMPT and --prompt-file")
    prompt = args.prompt if args.prompt is not None else args.prompt_file.read_text()
    session = args.session.resolve()
    cwd = args.cwd or session_cwd(session)
    if not Path(cwd).is_dir():
        sys.exit(f"omp-fork: working directory {cwd} does not exist; pass --cwd")

    scratch = Path(tempfile.mkdtemp(prefix="omp-fork-"))
    try:
        os.chmod(scratch, 0o700)
        copy = scratch / session.name
        cut = None
        if args.at is None:
            shutil.copyfile(session, copy)
        else:
            cut = cut_line(session, args.at)
            with session.open("rb") as src, copy.open("wb") as dst:
                for n, raw in enumerate(src, 1):
                    if n > cut:
                        break
                    dst.write(raw)
        expected = args.model.split(":")[0] if args.model else last_model(copy)
        before = set(scratch.glob("*.jsonl"))
        # --fork, never --resume: the run gets a session id of its own, so nothing keyed by
        # session id (Envoy, secretsd) is taken from the live session the copy was cut from.
        cmd = ["omp", "-p", "--mode", "json", "--session-dir", str(scratch), "--fork", str(copy), "--max-time", args.max_time]
        if args.model:
            cmd += ["--model", args.model]
        proc = subprocess.run(cmd + [prompt], cwd=cwd, capture_output=True, text=True)
        text, cost, model, models = "", 0.0, None, set()
        tokens = {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0}
        for line in proc.stdout.splitlines():
            try:
                event = json.loads(line)
            except json.JSONDecodeError:
                continue
            msg = event.get("message") or {}
            if event.get("type") == "message_end" and msg.get("role") == "assistant":
                usage = msg.get("usage") or {}
                cost += (usage.get("cost") or {}).get("total") or 0.0
                for key in tokens:
                    tokens[key] += usage.get(key) or 0
                model = f"{msg.get('provider')}/{msg.get('model')}"
                models.add(model)
                said = "".join(b.get("text", "") for b in msg.get("content") or [] if isinstance(b, dict))
                if said.strip():
                    text = said.strip()
        fork_session = None
        if args.keep:
            args.keep.mkdir(parents=True, exist_ok=True)
            written = sorted(set(scratch.glob("*.jsonl")) - before) or [copy]
            fork_session = str(args.keep / written[-1].name)
            shutil.copyfile(written[-1], fork_session)
        fallback = expected is not None and any(m != expected for m in models)
        print(json.dumps({"text": text, "model": model, "fallback": fallback, "cost": round(cost, 4), "tokens": tokens,
                          "cut": cut, "fork_session": fork_session}))
        if not text:
            # A Bun crash prints source lines and a stack after its error line, so the tail alone can
            # hide the cause (an agent.db SQLITE_BUSY showed only stack frames): name that line first.
            err = proc.stderr.strip()
            cause = next((l.strip() for l in reversed(err.splitlines()) if re.match(r"\s*\w*Error\b", l)), "")
            tail = err[-300:]
            shown = f"{cause} | {tail}" if cause and cause not in tail else tail
            sys.exit(f"omp-fork: the fork gave no answer (omp exit {proc.returncode}): {shown}")
    finally:
        shutil.rmtree(scratch, ignore_errors=True)


if __name__ == "__main__":
    main()
