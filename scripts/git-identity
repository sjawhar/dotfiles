#!/bin/bash
# Set (or show) the commit identity for the current repo, for git and jj at once.
#
# Every identity signs with the same key and every one is trusted in
# jj-allowed-signers, so any of them verifies. The catch is that they must AGREE
# within a repo: jj's signing.behavior = "own" only signs when a commit's author
# email matches jj's configured user.email, and when it doesn't match it DROPS
# the signature on rewrite rather than keeping it. A repo where git says
# cybermonk and jj says trajectorylabs therefore produces commits that silently
# lose their signature the first time jj rewrites them. Setting both together is
# what prevents that.
#
#   git-identity                 show the effective identity for both tools
#   git-identity tl|trajectory   use sami@trajectorylabs.net for this repo
#   git-identity cm|cybermonk    use sami@thecybermonk.com for this repo
#   git-identity th|theorem      use sami@theorem.dev for this repo
#   git-identity nr|noreply      use sjawhar@users.noreply.github.com for this repo
#
# Every theorem-labs repository (sami@theorem.dev) and every cybermonklabs
# repository but oh-my-pi (sami@thecybermonk.com) get their identity by rule. git
# matches a clone's remote URL (.gitconfig). jj has no remote condition, so
# .jjconfig.toml matches a jj checkout, and every workspace of it, by path: under
# ~/Code/personal/theorem, and at ~/src/legion or ~/Code/legion. A jj checkout of
# such a repository elsewhere needs `git-identity th` or `cm`. oh-my-pi commits as
# noreply: jj by the same rule in every workspace of ~/src/oh-my-pi, `knives start`
# workspaces included, and git by that checkout's own config, so any other clone
# of it needs `git-identity nr`.
#
# Elsewhere noreply is opt-in, for a checkout whose commits must carry no
# personal address: a fork whose own forbidden-term list holds the default
# address, so a commit made with it is refused at a release cut.
# Set it in your own workspace of such a repo before you commit there. It is
# scoped to that workspace, never the repo, because knives' workspaces of one
# fork share the jj repo config and the git config of its canonical checkout,
# so a repo-scoped change would re-identify every other session's workspace:
# jj is set with --workspace; git with --worktree only where
# extensions.worktreeConfig keeps that per worktree, else (a linked worktree
# sharing its config) git is left alone and plain git commits there keep the
# repo's identity, so commit with jj.
set -euo pipefail

NAME="Sami Jawhar"
TL_EMAIL="sami@trajectorylabs.net"
CM_EMAIL="sami@thecybermonk.com"
TH_EMAIL="sami@theorem.dev"
NR_EMAIL="sjawhar@users.noreply.github.com"

git rev-parse --git-dir >/dev/null 2>&1 || { echo "not a git repo" >&2; exit 1; }
in_jj() { jj root >/dev/null 2>&1; }

show() {
    local g j
    g=$(git config user.email 2>/dev/null || echo "(unset)")
    echo "git: ${g}"
    if in_jj; then
        j=$(jj config get user.email 2>/dev/null || echo "(unset)")
        echo "jj:  ${j}"
        if [ "$g" != "$j" ] && [ "$j" = "$NR_EMAIL" ]; then
            echo "note: jj uses the noreply identity here and git does not; commit with jj here, since plain git commits keep git's identity" >&2
        elif [ "$g" != "$j" ]; then
            echo "MISMATCH — jj will drop signatures on rewrite. Run: git-identity tl|cm|th|nr" >&2
        fi
    else
        echo "jj:  (not a jj repo)"
    fi
}

case "${1-}" in
    "") show ;;
    tl | trajectory | trajectorylabs) EMAIL="$TL_EMAIL" ;;
    cm | cybermonk | thecybermonk) EMAIL="$CM_EMAIL" ;;
    th | theorem) EMAIL="$TH_EMAIL" ;;
    nr | noreply) EMAIL="$NR_EMAIL" ;;
    -h | --help)
        sed -n '2,39p' "$0" | sed 's/^# \?//'
        exit 0
        ;;
    *)
        echo "unknown identity: $1 (want tl, cm, th or nr)" >&2
        exit 1
        ;;
esac

if [ -n "${EMAIL-}" ]; then
    if [ "$EMAIL" = "$NR_EMAIL" ]; then
        JJ_SCOPE=--workspace
        if [ "$(git config --bool extensions.worktreeConfig 2>/dev/null)" = true ]; then
            git config --worktree user.email "$EMAIL"
            git config --worktree user.name "$NAME"
        elif [ "$(git rev-parse --git-dir)" != "$(git rev-parse --git-common-dir)" ]; then
            echo "note: this git worktree shares its config with $(git rev-parse --git-common-dir); git's identity is left as it is. Commit with jj here." >&2
        else
            git config --local user.email "$EMAIL"
            git config --local user.name "$NAME"
        fi
    else
        JJ_SCOPE=--repo
        git config --local user.email "$EMAIL"
        git config --local user.name "$NAME"
    fi
    if in_jj; then
        jj config set "$JJ_SCOPE" user.email "$EMAIL"
        jj config set "$JJ_SCOPE" user.name "$NAME"

        # Config only affects future commits, so the change already in the
        # working copy keeps the old author — leaving it mismatched, which is
        # exactly the state where jj drops the signature on the next rewrite.
        # Re-author @ to close that gap. Skipped when @ is immutable or carries
        # a bookmark, since re-authoring changes the commit id and that would
        # mean a force push for anything already pushed.
        marks=$(jj log --no-graph -r @ -T 'if(immutable, "immutable ") ++ bookmarks.map(|b| b.name()).join(",")' 2>/dev/null || true)
        if [ -z "$marks" ]; then
            jj metaedit --update-author --quiet 2>/dev/null || true
        else
            echo "note: @ is ${marks% } — left its author alone." >&2
            echo "      re-author it yourself if you want it signed under the new identity:" >&2
            echo "      jj metaedit --update-author" >&2
        fi
    fi
    show
fi
