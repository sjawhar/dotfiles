#!/bin/bash
set -euo pipefail

# aws-eic-proxy REGION KEY USER INSTANCE PORT
#
# ssh ProxyCommand for an EC2 instance reached over AWS Session Manager that
# signs in with a fresh key instead of one an ssh agent holds. It writes a new
# ed25519 key pair at KEY, pushes the public half to INSTANCE for USER through
# EC2 Instance Connect, which accepts it for 60 seconds, and then becomes the
# Session Manager tunnel to PORT. The calling ssh must sign in with KEY alone
# (IdentityFile KEY, IdentitiesOnly yes, IdentityAgent none).
#
# Needs only a live AWS login that may call ec2-instance-connect
# SendSSHPublicKey and ssm StartSession, and the ec2-instance-connect package
# on the instance. Nothing is added to the instance's authorized_keys.

if [ "$#" -ne 5 ]; then
    echo "usage: aws-eic-proxy REGION KEY USER INSTANCE PORT" >&2
    exit 2
fi
region=$1 key=$2 user=$3 instance=$4 port=$5

mkdir -p "$(dirname "$key")"
chmod 700 "$(dirname "$key")"
rm -f "$key" "$key.pub"
ssh-keygen -q -t ed25519 -N '' -C "aws-eic-proxy@$(hostname -s)" -f "$key"
aws ec2-instance-connect send-ssh-public-key --region "$region" --instance-id "$instance" \
    --instance-os-user "$user" --ssh-public-key "file://$key.pub" >/dev/null
exec aws ssm start-session --region "$region" --target "$instance" \
    --document-name AWS-StartSSHSession --parameters "portNumber=$port"
