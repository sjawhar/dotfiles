#!/bin/bash
# Sign this machine's model broker (omp/omp-auth-broker.service) in, once, as yourself.
#
#   omp-broker-login                  # Anthropic, then OpenAI Codex
#   omp-broker-login anthropic        # one provider
#
# The broker keeps its logins in a database of its own (~/.omp/auth-broker), so this is a sign-in
# of its own, separate from the one your sessions use: a copy of theirs would put two refreshers
# on one token chain, which is the race that emptied the box on 2026-10-25 (dispatch://INFRA-387).
# Each login prints a URL; open it, approve, and the login lands in the broker's database. The
# broker restarts afterwards so it serves the new login at once.
set -euo pipefail

broker_dir="$HOME/.omp/auth-broker"
providers=("$@")
[[ ${#providers[@]} -gt 0 ]] || providers=(anthropic openai-codex)

for provider in "${providers[@]}"; do
    echo "== signing the broker in to $provider"
    # The broker's own directory, and no broker client settings: the login must land in the
    # broker's database, not be sent to a broker.
    env -u OMP_AUTH_BROKER_URL -u OMP_AUTH_BROKER_TOKEN PI_CODING_AGENT_DIR="$broker_dir" \
        "$HOME/.mise/shims/omp" auth-broker login "$provider"
done

systemctl --user restart omp-auth-broker.service
echo "== the broker now holds"
sqlite3 -separator '  ' "$broker_dir/agent.db" \
    "SELECT provider, CASE WHEN disabled_cause IS NULL THEN 'live' ELSE 'disabled: ' || disabled_cause END FROM auth_credentials ORDER BY provider"
