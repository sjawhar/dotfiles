#!/usr/bin/env python3
"""Check Docker's configured route, or retrieve a credential without printing it.

Usage: docker-registry-auth-check REGISTRY [configured|retrieve] [--timeout SECONDS]
Exit 0: the requested check passed. Exit 10: no route. Exit 1: unusable route.
The probe does not log in or write Docker configuration. Helpers use the documented get protocol:
https://docs.docker.com/reference/cli/docker/login/#credential-helper-protocol
"""

from __future__ import annotations

import argparse
import base64
import binascii
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path
from urllib.parse import urlsplit


def report(message: str, status: int = 1) -> int:
    print(message)
    return status


def server_name(value: str) -> str:
    return urlsplit(value).netloc if "://" in value else value.split("/", 1)[0]


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("registry")
    parser.add_argument("mode", nargs="?", choices=("configured", "retrieve"), default="configured")
    parser.add_argument("--timeout", type=float, default=60)
    args = parser.parse_args()
    if args.timeout <= 0:
        parser.error("--timeout must be positive")
    config = Path(os.environ.get("DOCKER_CONFIG") or Path.home() / ".docker") / "config.json"
    try:
        data = json.loads(config.read_bytes())
    except FileNotFoundError:
        return report(f"no Docker credential route for {args.registry}", 10)
    except (OSError, ValueError):
        return report(f"Docker configuration {config} is unreadable or invalid")
    if not isinstance(data, dict):
        return report(f"Docker configuration {config} is not an object")
    helpers = data.get("credHelpers") or {}
    auths = data.get("auths") or {}
    if not isinstance(helpers, dict) or not isinstance(auths, dict):
        return report(f"Docker configuration {config} has invalid credential maps")

    # A present empty per-registry helper selects file auth, not the global store.
    helper = helpers[args.registry] if args.registry in helpers else data.get("credsStore", "")
    if helper is None:
        helper = ""
    if not isinstance(helper, str):
        return report(f"Docker configuration {config} has an invalid credential helper")
    if helper:
        command = shutil.which("docker-credential-" + helper)
        if command is None:
            return report(f"Docker helper {helper} is not on PATH")
        if args.mode == "configured":
            return report(f"Docker helper {helper} is configured for {args.registry}", 0)
        try:
            result = subprocess.run([command, "get"], input=args.registry.encode(),
                                    capture_output=True, timeout=args.timeout, check=False)
        except subprocess.TimeoutExpired:
            return report(f"Docker helper {helper} get timed out")
        except OSError:
            return report(f"Docker helper {helper} could not run")
        if result.returncode:
            return report(f"Docker helper {helper} get exited {result.returncode}")
        try:
            credential = json.loads(
                result.stdout,
                object_pairs_hook=lambda fields: {key.casefold(): value for key, value in fields},
            )
        except (ValueError, UnicodeError):
            return report(f"Docker helper {helper} returned invalid native-protocol JSON")
        if not isinstance(credential, dict) or not all(
            isinstance(credential.get(field), str) and credential[field]
            for field in ("username", "secret")
        ):
            return report(f"Docker helper {helper} returned an incomplete native credential")
        return report(f"Docker helper {helper} returned a credential for {args.registry}", 0)

    if args.registry in auths:
        auth = auths[args.registry]
    else:
        auth = next((value for server, value in auths.items()
                     if server_name(server) == server_name(args.registry)), {})
    if auth is None:
        auth = {}
    if not isinstance(auth, dict):
        return report(f"Docker configuration {config} has an invalid registry auth entry")
    if any(isinstance(auth.get(field), str) and auth[field]
           for field in ("identitytoken", "registrytoken")):
        return report(f"inline Docker token is configured for {args.registry}", 0)
    encoded = auth.get("auth")
    if encoded:
        if not isinstance(encoded, str):
            return report(f"inline Docker auth for {args.registry} is invalid")
        try:
            decoded = base64.b64decode(encoded.replace("\r", "").replace("\n", ""), validate=True)
        except (ValueError, binascii.Error):
            return report(f"inline Docker auth for {args.registry} is invalid")
        username, separator, password = decoded.partition(b":")
        if not separator or not username or not password.rstrip(b"\x00"):
            return report(f"inline Docker auth for {args.registry} is incomplete")
        return report(f"inline Docker credential is configured for {args.registry}", 0)
    if all(isinstance(auth.get(field), str) and auth[field] for field in ("username", "password")):
        return report(f"inline Docker credential is configured for {args.registry}", 0)
    return report(f"no Docker credential route for {args.registry}", 10)


if __name__ == "__main__":
    sys.exit(main())
