#!/usr/bin/env bash
# Docker credential helper: dhi.io (Docker Hardened Images) and Docker Hub answer
# with the trajectorylabs org's pull-only access token, read from the secrets
# store at the moment docker asks (`secrets DOCKER_HUB_OAT`, agent tier), so no
# registry token sits in any config.json. Wire it in with
#   {"credHelpers": {"dhi.io": "secretsd", "https://index.docker.io/v1/": "secretsd"}}
# -- agentbox/entrypoint.sh writes exactly that into each box's ~/.docker/config.json
# at launch, since the user's own docker login is deliberately not mounted there. Read-only: `store` and `erase`
# are refused so a `docker login` cannot appear to succeed against it.
# Protocol: https://github.com/docker/docker-credential-helpers (get/store/erase/list).
set -euo pipefail

readonly USERNAME=trajectorylabs

case "${1:-}" in
    get)
        # docker writes the server URL without a trailing newline, so `read`
        # returns non-zero at EOF while still having filled the variable.
        IFS= read -r server || [ -n "$server" ]
        case "$server" in
            dhi.io|*://dhi.io*|*docker.io*)
                exec secrets DOCKER_HUB_OAT -- sh -c \
                    'printf "{\"ServerURL\":\"%s\",\"Username\":\"%s\",\"Secret\":\"%s\"}\n" "$1" "$2" "$DOCKER_HUB_OAT"' \
                    sh "$server" "$USERNAME"
                ;;
            *)
                # The exact string docker expects for "no credential here".
                echo "credentials not found in native keychain"
                exit 1
                ;;
        esac
        ;;
    list)
        printf '{"dhi.io":"%s","https://index.docker.io/v1/":"%s"}\n' "$USERNAME" "$USERNAME"
        ;;
    store|erase)
        echo "docker-credential-secretsd: read-only helper; credentials live in the secrets store" >&2
        exit 1
        ;;
    *)
        echo "usage: docker-credential-secretsd get|list|store|erase" >&2
        exit 2
        ;;
esac
