#!/usr/bin/env bash
# Mirror the curated skill sources into oh-my-pi's flat skills dir as symlinks.
# The source list matches opencode/plugins/dotfiles-bridge.ts (the canonical
# curation of which pools are exposed); OMP discovers <skills-dir>/<name>/SKILL.md,
# so the farm is flat and collisions are renamed <namespace>--<basename>,
# matching the omp-sync-prompts convention.
# Idempotent: safe to re-run; refreshes links and prunes dangling ones.
set -euo pipefail

DOTFILES_DIR="${DOTFILES_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
SKILLS_DIR="${SKILLS_DIR:-$HOME/.omp/agent/skills}"

# Keep in sync with the sources list in opencode/plugins/dotfiles-bridge.ts,
# PLUS the namespaces OpenCode discovers natively through the
# ~/.config/opencode/skills/* symlinks (no bridge entry). Those are mirrored
# here from their canonical sources, or OMP never sees them.
NAMESPACES=(
  "sjawhar:$DOTFILES_DIR/plugins/sjawhar/skills"
  "music:$DOTFILES_DIR/vendor/claude-ai-music-skills/skills"
  "wispr:$DOTFILES_DIR/vendor/ghost-wispr/.opencode/skills"
  "gh:$DOTFILES_DIR/vendor/gh-stack/skills"
  "pup:$DOTFILES_DIR/vendor/pup/skills"
  "cursor-harvest:$DOTFILES_DIR/plugins/cursor-harvest/skills"
  "sentry:$DOTFILES_DIR/vendor/sentry-for-ai/skills"
  "sentry-cli:$DOTFILES_DIR/vendor/sentry-cli/plugins/sentry-cli/skills"
  "core-ops:$HOME/core-ops/skills"
  "time-tracker:$DOTFILES_DIR/vendor/time-tracker/.opencode/skills"
  "compound-engineering:$DOTFILES_DIR/vendor/compound-engineering/skills"
)

# Deliberately hidden from the OMP farm even though their namespace is linked:
# git-workflow and auto-runner skills that conflict with this jj/omp harness.
EXCLUDES=(
  "compound-engineering:ce-commit-push-pr"
  "compound-engineering:ce-debug"
  "compound-engineering:ce-work"
  "compound-engineering:ce-worktree"
  "compound-engineering:lfg"
)

# Namespaces where ONLY the listed skills are linked (keep-few-of-many pools).
# sentry-for-ai ships ~25 per-platform SDK skills; Sami keeps only the Python SDK.
declare -A ONLY=(
  ["sentry"]="sentry-python-sdk"
)

mkdir -p "$SKILLS_DIR"

linked=0; collided=0; pruned=0
declare -A OWNER=()

for pair in "${NAMESPACES[@]}"; do
  ns="${pair%%:*}"; src="${pair#*:}"
  [ -d "$src" ] || { echo "skip namespace $ns (no such dir: $src)"; continue; }
  for dir in "$src"/*/; do
    dir="${dir%/}"
    [ -f "$dir/SKILL.md" ] || continue
    base=$(basename "$dir")
    if [[ " ${EXCLUDES[*]} " == *" ${ns}:${base} "* ]]; then
      echo "skip ${ns}/${base} (excluded)"
      continue
    fi
    if [ -n "${ONLY[$ns]:-}" ] && [[ " ${ONLY[$ns]} " != *" ${base} "* ]]; then
      continue
    fi
    name="$base"
    if [ -n "${OWNER[$name]:-}" ] && [ "${OWNER[$name]}" != "$dir" ]; then
      name="${ns}--${base}"
      collided=$((collided + 1))
    fi
    OWNER[$name]="$dir"
    ln -sfn "$dir" "$SKILLS_DIR/$name"
    linked=$((linked + 1))
  done
done

# Mirror semantics: the farm contains exactly what this run linked. Any link
# not created above (dropped namespace, renamed skill, dangling target) is
# removed, so editing NAMESPACES and re-running is the entire workflow.
for link in "$SKILLS_DIR"/*; do
  [ -L "$link" ] || continue
  name=$(basename "$link")
  [ -n "${OWNER[$name]:-}" ] && continue
  rm "$link"
  pruned=$((pruned + 1))
done

echo "linked=$linked collision-renamed=$collided pruned=$pruned"
