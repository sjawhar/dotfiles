#!/usr/bin/env bash
# agent-access: print which logins and credentials THIS session already holds,
# so an agent checks here before asking Sami for access it already has
# (CLAUDE.md "Don't Outsource to the User").
#
# Every check below runs in parallel with its own timeout, never prompts for
# input, and never prints a secret or token value - only the identity, expiry
# and status a non-interactive status command exposes. `--json` emits the same
# rows as a JSON array for scripts. Each command uses the 6 s `TIMEOUT_S`
# timeout, so the run takes about as long as the slowest check.
#
# A check that errors prints that error as its detail; it never falls back to
# a different, silently-chosen command.
set -uo pipefail

json=0
case "${1:-}" in
    --json) json=1 ;;
    "") ;;
    *)
        echo "usage: agent-access [--json]" >&2
        exit 2
        ;;
esac

TIMEOUT_S=6

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

# row NAME STATUS IDENTITY EXPIRY COMMAND [DETAIL]: write one tab-separated
# result row. row removes each carriage return from IDENTITY, EXPIRY, COMMAND
# and DETAIL, makes each tab and newline in them a space, and writes NAME and
# STATUS as the caller gives them.
row() {
    local name=$1 status=$2 field fields=()
    for field in "$3" "$4" "$5" "${6:-}"; do
        field=${field//$'\r'/}
        fields+=("${field//[$'\t\n']/ }")
    done
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$name" "$status" "${fields[@]}" >"$tmp/$name"
}

# first_line TEXT: print TEXT's first non-empty line, CR removed; a line of only spaces and tabs counts as empty.
first_line() { awk '{ gsub(/\r/, "") } NF { print; exit }' <<<"$1"; }

# last_line TEXT: print TEXT's last non-empty line, CR removed, empty as in first_line; for a check that reads the
# last line on purpose, as when a tool writes its error after its advisories.
last_line() { awk '{ gsub(/\r/, "") } NF { l = $0 } END { print l }' <<<"$1"; }

# failure_detail RC TEXT: TEXT, unless RC is 124: `timeout` killed the command, and what it printed is not its answer.
# An empty TEXT gives `exit RC, no output`, so a failed row never has an empty detail.
failure_detail() {
    if (($1 == 124)); then
        printf 'timed out after %ss' "$TIMEOUT_S"
    elif [[ -z "$2" ]]; then
        printf 'exit %s, no output' "$1"
    else
        printf '%s' "$2"
    fi
}

# jwt_field FIELD: print FIELD from the JWT payload in $JWT_FIELD_TOKEN, or
# nothing (rc 1). The token goes through the environment, never argv
# (scripts/AGENTS.md: a secret in argv is readable from /proc/<pid>/cmdline)
# and never via stdin, which `python3 -c` needs for its own script source.
jwt_field() {
    python3 -c '
import base64, json, os, sys

field = sys.argv[1]
token = os.environ.get("JWT_FIELD_TOKEN", "")
parts = token.split(".")
if len(parts) < 2:
    sys.exit(1)
pad = lambda s: s + "=" * (-len(s) % 4)
try:
    payload = json.loads(base64.urlsafe_b64decode(pad(parts[1])))
except Exception:
    sys.exit(1)
value = payload.get(field)
if value is None:
    sys.exit(1)
print(value)
' "$1"
}

iso() { python3 -c "import datetime,sys; print(datetime.datetime.fromtimestamp(int(sys.argv[1]), datetime.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ'))" "$1" 2>/dev/null; }

# aws can write a warning to stderr when it answers, so stdout alone is parsed;
# a failure reports stderr's first non-empty line (aws starts an error with an
# empty line), or stdout's when stderr is empty.
check_aws() {
    local out rc arn detail err="$tmp/aws.stderr"
    out="$(timeout "$TIMEOUT_S" aws sts get-caller-identity --output json 2>"$err")"
    rc=$?
    if ((rc == 0)); then
        arn="$(jq -r '.Arn // empty' <<<"$out" 2>/dev/null)"
        row aws live "${arn:-unknown}" "n/a (instance-role session, no fixed expiry)" "aws sts get-caller-identity"
    else
        detail="$(first_line "$(<"$err")")"
        row aws missing - - "aws sts get-caller-identity" "$(failure_detail "$rc" "${detail:-$(first_line "$out")}")"
    fi
}

# GitHub is never a personal login in an agent session (shims/gh refuses
# `gh auth login/logout/switch`; pushes go through the GitHub App per repo
# owner). Read gh-app-token's own installation cache instead of minting a
# fresh token just to report status.
check_github_app() {
    local f owners dir="/mnt/nvme/${USER:-$(id -un)}/gh-app-token"
    # gh-app-token's cache is on /mnt/nvme/<user> where that disk is (default_cache_dir in shims/gh-app-token).
    [[ -d "/mnt/nvme/${USER:-$(id -un)}" ]] || dir="$HOME/.cache/gh-app-token"
    f="$(find "$dir" -maxdepth 1 -name 'covered-*.json' -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -n1 | cut -d' ' -f2-)"
    if [[ -z "$f" ]]; then
        row github_app unknown - - "ls $dir/covered-*.json" \
            "no installation discovered yet this host; shims/gh mints on first push/API call. Personal gh login is refused by design."
        return
    fi
    # gh-app-token reads a covered-owner file that is not a JSON object as invalid, never as no owners.
    if ! owners="$(jq -rn 'input | if type == "object" then keys | join(", ") else error("not a JSON object") end' "$f" 2>/dev/null)"; then
        row github_app unknown - - "cat $dir/covered-*.json" "unreadable covered-owner cache: $f"
        return
    fi
    row github_app live "App covers: ${owners:-unknown}; other owners -> GH_PUBLIC_REPO_PAT fallback" \
        "n/a (installation tokens auto-mint, ~1h)" "cat $dir/covered-*.json" \
        "personal gh login is refused by design (shims/gh)"
}

# The login, the expiry and `expired` are matched in stdout and stderr together, since no run here has shown which
# stream ant answers on and each is a fixed pattern; a failure reports stderr's first non-empty line, or stdout's when
# stderr is empty.
check_ant() {
    local out rc email exp status detail err="$tmp/ant.stderr"
    out="$(timeout "$TIMEOUT_S" ant auth status 2>"$err")"
    rc=$?
    if ((rc != 0)); then
        detail="$(first_line "$(<"$err")")"
        row anthropic_ant missing - - "ant auth status" "$(failure_detail "$rc" "${detail:-$(first_line "$out")}")"
        return
    fi
    out+=$'\n'"$(<"$err")"
    email="$(grep -oP 'Logged in to .* as \K\S+' <<<"$out" || true)"
    exp="$(grep -oP 'expires:\s+\K\S+' <<<"$out" || true)"
    if grep -qi 'expired' <<<"$out"; then status=expired; else status=live; fi
    row anthropic_ant "$status" "${email:-unknown}" "${exp:-unknown}" "ant auth status"
}

# vercel can write a notice (an available update) to stderr, so the identity is
# stdout's last non-empty line; a failure reports stderr's last non-empty line,
# or stdout's when stderr is empty.
check_vercel() {
    local out rc user detail err="$tmp/vercel.stderr"
    out="$(timeout "$TIMEOUT_S" vercel whoami 2>"$err")"
    rc=$?
    if ((rc == 0)); then
        user="$(last_line "$out")"
        row vercel live "${user:-unknown}" "n/a" "vercel whoami"
    else
        detail="$(last_line "$(<"$err")")"
        row vercel missing - - "vercel whoami" "$(failure_detail "$rc" "${detail:-$(last_line "$out")}")"
    fi
}

# pup exits 0 and writes "Not authenticated" to stderr when it holds no token, so the exit code and a text
# match on "Authenticated" both read as live; its --no-agent JSON on stdout carries the real answer. A missing
# row reports the JSON's .status, else stderr's first non-empty line, else stdout's first non-empty line.
check_datadog() {
    local out rc site exp detail err="$tmp/pup.stderr"
    out="$(timeout "$TIMEOUT_S" pup --no-agent auth status 2>"$err")"
    rc=$?
    if ((rc == 0)) && jq -e '.authenticated == true' >/dev/null 2>&1 <<<"$out"; then
        site="$(jq -r '.site // empty' <<<"$out" 2>/dev/null)"
        exp="$(jq -r '.expires_at // empty' <<<"$out" 2>/dev/null)"
        row datadog_pup live "${site:-unknown}" "${exp:-unknown}" "pup --no-agent auth status"
    else
        detail="$(jq -r '.status // empty' <<<"$out" 2>/dev/null)"
        detail="${detail:-$(first_line "$(<"$err")")}"
        row datadog_pup missing - - "pup --no-agent auth status" \
            "$(failure_detail "$rc" "${detail:-$(first_line "$out")}")"
    fi
}

# gcloud can write a warning to stderr when it answers, so stdout alone is
# parsed. Only a JSON list with no ACTIVE account is `no ACTIVE account`; an
# answer that is not a JSON list is `unknown`. A failure reports stderr's first
# non-empty line, or stdout's when stderr is empty.
check_gcloud() {
    local out rc active detail err="$tmp/gcloud.stderr"
    out="$(timeout "$TIMEOUT_S" gcloud auth list --format=json 2>"$err")"
    rc=$?
    if ((rc != 0)); then
        detail="$(first_line "$(<"$err")")"
        row gcloud missing - - "gcloud auth list" "$(failure_detail "$rc" "${detail:-$(first_line "$out")}")"
        return
    fi
    if ! active="$(jq -rn 'input | if type == "array" then [.[] | select(.status == "ACTIVE")][0].account // empty else error("not a JSON list") end' <<<"$out" 2>/dev/null)"; then
        row gcloud unknown - - "gcloud auth list" "unparseable answer: $(first_line "$out")"
    elif [[ -n "$active" ]]; then
        row gcloud live "$active" "n/a" "gcloud auth list"
    else
        row gcloud missing - - "gcloud auth list" "no ACTIVE account"
    fi
}

check_gws() {
    # One row per account in gws-accounts' registry, or one google_workspace row
    # when the registry is absent, unreadable, not an object, or empty. The probe
    # is the Gmail profile: every account's read tier holds Gmail read-only, and
    # some (wren) hold nothing else. gws writes advisories ("Using keyring
    # backend: ...") to stderr, so stdout alone is parsed and a failure reports
    # stderr's last non-empty line, or stdout's first non-empty line when stderr
    # is empty.
    local accounts_file="$HOME/.config/gws/accounts.json" accounts account out rc email err detail
    if [[ ! -f "$accounts_file" ]]; then
        row google_workspace missing - - "jq keys $accounts_file" "no $accounts_file"
        return
    fi
    if ! accounts="$(jq -r 'if type == "object" then keys[] else error("not a JSON object") end' "$accounts_file" 2>&1)"; then
        row google_workspace missing - - "jq keys $accounts_file" "$(first_line "$accounts")"
        return
    fi
    if [[ -z "$accounts" ]]; then
        row google_workspace missing - - "jq keys $accounts_file" "no accounts in $accounts_file"
        return
    fi
    while IFS= read -r account; do
        (
            err="$tmp/gws_${account}.stderr"
            out="$(GWS_ACCOUNT="$account" timeout "$TIMEOUT_S" gws gmail users getProfile --params '{"userId":"me"}' 2>"$err")"
            rc=$?
            if ((rc == 0)); then
                email="$(jq -r '.emailAddress // empty' <<<"$out" 2>/dev/null)"
                row "google_workspace_${account}" live "${email:-unknown}" "n/a" "GWS_ACCOUNT=${account} gws gmail users getProfile"
            else
                detail="$(last_line "$(<"$err")")"
                row "google_workspace_${account}" missing - - "GWS_ACCOUNT=${account} gws gmail users getProfile" \
                    "$(failure_detail "$rc" "${detail:-$(first_line "$out")}")"
            fi
        ) &
    done <<<"$accounts"
    wait
}

# The exit code alone decides a live row, whose identity is the email in ~/.fleet/config. A failure reports
# stderr's last non-empty line, or stdout's last non-empty line when stderr is empty.
check_fleetctl() {
    local out rc email detail err="$tmp/fleetctl.stderr"
    out="$(timeout "$TIMEOUT_S" fleetctl get config --json 2>"$err")"
    rc=$?
    email="$(awk -F': *' '/^ *email:/{print $2; exit}' "$HOME/.fleet/config" 2>/dev/null | tr -d '\r')"
    if ((rc == 0)); then
        row fleetctl live "${email:-unknown}" "n/a" "fleetctl get config"
    else
        detail="$(last_line "$(<"$err")")"
        row fleetctl missing - - "fleetctl get config" "$(failure_detail "$rc" "${detail:-$(last_line "$out")}")"
    fi
}

# sentry-cli info prints its configuration on stdout and its error on stderr, so the User: line is read from stdout
# alone; a failure reports stderr's first non-empty line, or stdout's when stderr is empty.
check_sentry() {
    local out rc user detail err="$tmp/sentry.stderr"
    out="$(timeout "$TIMEOUT_S" sentry-cli info 2>"$err")"
    rc=$?
    user="$(grep -oP '^\s*User:\s*\K\S+' <<<"$out" || true)"
    if ((rc == 0)) && [[ -n "$user" ]]; then
        row sentry live "$user" "n/a (auth token)" "sentry-cli info"
    elif ((rc == 0)); then
        # An org auth token answers with no User: line; its first line (`Sentry Server: ...`) reads as an answer.
        row sentry missing - - "sentry-cli info" "no User: line in sentry-cli info"
    else
        detail="$(first_line "$(<"$err")")"
        row sentry missing - - "sentry-cli info" "$(failure_detail "$rc" "${detail:-$(first_line "$out")}")"
    fi
}

# kubectl can write a warning to stderr, so the context and the Username line are read from stdout alone; a failure
# of either call reports stderr's first non-empty line, or stdout's when stderr is empty. A context with no visible
# character is `unknown`.
check_kubectl() {
    local ctx rc out username detail err="$tmp/kubectl.stderr"
    ctx="$(timeout "$TIMEOUT_S" kubectl config current-context 2>"$err")"
    rc=$?
    if ((rc != 0)); then
        detail="$(first_line "$(<"$err")")"
        row kubectl missing - - "kubectl config current-context" \
            "$(failure_detail "$rc" "${detail:-$(first_line "$ctx")}")"
        return
    fi
    [[ "$ctx" =~ [^[:space:]] ]] || ctx=unknown
    out="$(timeout "$TIMEOUT_S" kubectl auth whoami 2>"$err")"
    rc=$?
    if ((rc == 0)); then
        username="$(grep -oP '^Username\s+\K\S+' <<<"$out" || true)"
        row kubectl live "${username:-unknown} (context: $ctx)" "n/a (assumed-role session)" "kubectl auth whoami"
    else
        detail="$(first_line "$(<"$err")")"
        row kubectl missing - - "kubectl auth whoami" \
            "context: $ctx; $(failure_detail "$rc" "${detail:-$(first_line "$out")}")"
    fi
}

# The secret keys secretsd grants to every session and scope (names only, never
# values). `secrets grants` heads its secret-grant table `KEY` (v3.8.4 and
# earlier) or `SECRET GRANT` (after); the table ends at an empty line or at a
# `KIND` line, which starts a second table, of requests, receipts and
# capabilities, that is not read. Only stdout is parsed. A failure reports
# stderr's last non-empty line (the secrets shim writes a notice to stderr
# before the client runs), or stdout's first non-empty line when stderr is
# empty. A lone `no active grants` line means no keys; an answer of no known
# shape reports `unknown`.
check_secretsd() {
    local out rc err detail line first key keys=""
    err="$tmp/secretsd.stderr"
    out="$(timeout "$TIMEOUT_S" secrets grants 2>"$err")"
    rc=$?
    if ((rc != 0)); then
        detail="$(last_line "$(<"$err")")"
        row secretsd_grants missing - - "secrets grants" "$(failure_detail "$rc" "${detail:-$(first_line "$out")}")"
        return
    fi
    {
        IFS= read -r line
        IFS=$'\t' read -r first _ <<<"$line"
        case "$first" in
            KEY | "SECRET GRANT")
                while IFS=$'\t' read -r key _ && [[ -n "$key" && "$key" != KIND ]]; do
                    keys+="${keys:+,}$key"
                done
                ;;
            KIND) ;;
            *)
                if [[ "$line" != "no active grants" ]]; then
                    row secretsd_grants unknown - - "secrets grants" "unrecognised answer: $line"
                    return
                fi
                ;;
        esac
    } <<<"$out"
    row secretsd_grants live "${keys:-none}" "see \`secrets grants\`" "secrets grants" "keys of every session and scope; names only, never values"
}

check_agent_secrets_broker() {
    local out rc detail err="$tmp/agent-secrets.stderr"
    out="$(timeout "$TIMEOUT_S" agent-secrets identity 2>"$err")"
    rc=$?
    if ((rc == 0)); then
        row agent_secrets_broker live "this process is a registered broker session" "n/a" "agent-secrets identity" \
            "agent-secrets reaches the broker as this session"
    else
        # The detail is the non-empty lines of stderr, else of stdout, which row makes one line; a stream with no
        # non-empty line is passed over, and two such streams give the fallback.
        detail="$(awk '{ gsub(/\r/, "") } NF' <<<"$(<"$err")")"
        [[ -n "$detail" ]] || detail="$(awk '{ gsub(/\r/, "") } NF' <<<"$out")"
        [[ -n "$detail" ]] || detail="no broker identity"
        row agent_secrets_broker missing - - "agent-secrets identity" "$(failure_detail "$rc" "$detail")"
    fi
}

check_modal() {
    if command -v modal >/dev/null 2>&1; then
        row modal unknown - - "command -v modal" "modal is on PATH but agent-access has no verified non-interactive status command for it"
    else
        row modal missing - - "command -v modal" "modal CLI not installed on this machine"
    fi
}

# Dispatch: the session's harness plugin (pi-envoy, claude-envoy) puts
# `dispatch` on its shell's PATH and names the
# session for it; `dispatch whoami` answers whom Dispatch takes it for. The
# identity is stdout's first non-empty line, so a warning on stderr is not it;
# a failure reports stderr's first non-empty line, or stdout's when stderr is
# empty.
check_dispatch() {
    local out rc identity detail err="$tmp/dispatch.stderr"
    if ! command -v dispatch >/dev/null 2>&1; then
        row dispatch missing - - "command -v dispatch" \
            "no dispatch on PATH; the session's harness plugin puts it there, so this shell is not an agent session's"
        return
    fi
    out="$(timeout "$TIMEOUT_S" dispatch whoami 2>"$err")"
    rc=$?
    if ((rc == 0)); then
        identity="$(first_line "$out")"
        row dispatch live "${identity:-unknown}" "n/a" "dispatch whoami"
    else
        detail="$(first_line "$(<"$err")")"
        row dispatch missing - - "dispatch whoami" "$(failure_detail "$rc" "${detail:-$(first_line "$out")}")"
    fi
}

# A check whose name would name a customer lives in the private repository theorem-labs/sami,
# cloned at <dotfiles>/.secrets: each <dotfiles>/.secrets/dotfiles/agent-access.d/*.sh is sourced
# here, defines its check functions on the helpers above, and appends them to extra_checks and
# the row names they write to extra_rows. A machine without that clone runs only the checks above.
dotfiles="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
extra_checks=()
extra_rows=()
for extra in "$dotfiles"/.secrets/dotfiles/agent-access.d/*.sh; do
    [[ -r "$extra" ]] || continue
    # shellcheck disable=SC1090
    source "$extra"
done

for fn in check_aws check_github_app check_ant "${extra_checks[@]}" check_vercel \
    check_datadog check_gcloud check_gws check_fleetctl check_sentry check_kubectl \
    check_secretsd check_agent_secrets_broker check_modal check_dispatch; do
    "$fn" &
done
wait

# check_gws writes one row per account in the gws registry, so those names come
# from the files it wrote. An unmatched glob stays literal, and the loops below
# skip a name with no row file.
gws_rows=("$tmp"/google_workspace_*)
order=(aws github_app anthropic_ant "${extra_rows[@]}" google_workspace "${gws_rows[@]##*/}" \
    gcloud vercel datadog_pup \
    fleetctl sentry kubectl secretsd_grants agent_secrets_broker modal dispatch)

if ((json)); then
    # jq splits each row on every tab: `IFS=$'\t' read` makes a run of tabs one
    # separator, so an empty field would move each later field one place left.
    for name in "${order[@]}"; do
        [[ -f "$tmp/$name" ]] || continue
        jq -c -R 'split("\t") | {name:.[0],status:.[1],identity:.[2],expiry:.[3],command:.[4],detail:(.[5] // "")}' <"$tmp/$name"
    done | jq -s '.'
else
    # No dependency on `column`: it is not on PATH inside an agent box image.
    {
        printf 'NAME\tSTATUS\tIDENTITY\tEXPIRY\tCOMMAND\tDETAIL\n'
        for name in "${order[@]}"; do
            [[ -f "$tmp/$name" ]] || continue
            cat "$tmp/$name"
        done
    } | awk -F'\t' '
        { for (i = 1; i <= NF; i++) if (length($i) > w[i]) w[i] = length($i); n = NF; lines[NR] = $0 }
        END {
            for (r = 1; r <= NR; r++) {
                m = split(lines[r], f, "\t")
                line = ""
                for (i = 1; i <= m; i++) {
                    line = line f[i]
                    if (i < m) { for (j = length(f[i]); j < w[i] + 2; j++) line = line " " }
                }
                print line
            }
        }'
fi
