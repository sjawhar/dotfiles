#!/usr/bin/env bash
# agent-access: print which logins and credentials THIS session already holds,
# so an agent checks here before asking Sami for access it already has
# (CLAUDE.md "Don't Outsource to the User").
#
# Every check below runs in parallel with its own timeout, never prompts for
# input, and never prints a secret or token value - only the identity, expiry
# and status a non-interactive status command exposes. `--json` emits the same
# rows as a JSON array for scripts. Each command uses the 6 s `TIMEOUT_S`
# timeout, so the run takes about as long as the slowest check.
#
# A check that errors prints that error as its detail; it never falls back to
# a different, silently-chosen command.
set -uo pipefail

json=0
case "${1:-}" in
    --json) json=1 ;;
    "") ;;
    *)
        echo "usage: agent-access [--json]" >&2
        exit 2
        ;;
esac

TIMEOUT_S=6

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

# row NAME STATUS IDENTITY EXPIRY COMMAND [DETAIL]: write one tab-separated
# result row. row makes each tab and newline in IDENTITY, EXPIRY, COMMAND and
# DETAIL a space, and writes NAME and STATUS as the caller gives them.
row() {
    local name=$1 status=$2 identity=$3 expiry=$4 command=$5 detail=${6:-}
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$name" "$status" "${identity//[$'\t\n']/ }" "${expiry//[$'\t\n']/ }" \
        "${command//[$'\t\n']/ }" "${detail//[$'\t\n']/ }" >"$tmp/$name"
}

first_line() { head -n1 <<<"$1" | tr -d '\r'; }

# failure_detail RC TEXT: TEXT, unless RC is 124: `timeout` killed the command, and what it printed is not its answer.
failure_detail() {
    if (($1 == 124)); then
        printf 'timed out after %ss' "$TIMEOUT_S"
    else
        printf '%s' "$2"
    fi
}

# jwt_field FIELD: print FIELD from the JWT payload in $JWT_FIELD_TOKEN, or
# nothing (rc 1). The token goes through the environment, never argv
# (scripts/AGENTS.md: a secret in argv is readable from /proc/<pid>/cmdline)
# and never via stdin, which `python3 -c` needs for its own script source.
jwt_field() {
    python3 -c '
import base64, json, os, sys

field = sys.argv[1]
token = os.environ.get("JWT_FIELD_TOKEN", "")
parts = token.split(".")
if len(parts) < 2:
    sys.exit(1)
pad = lambda s: s + "=" * (-len(s) % 4)
try:
    payload = json.loads(base64.urlsafe_b64decode(pad(parts[1])))
except Exception:
    sys.exit(1)
value = payload.get(field)
if value is None:
    sys.exit(1)
print(value)
' "$1"
}

iso() { python3 -c "import datetime,sys; print(datetime.datetime.fromtimestamp(int(sys.argv[1]), datetime.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ'))" "$1" 2>/dev/null; }

check_aws() {
    local out rc arn
    out="$(timeout "$TIMEOUT_S" aws sts get-caller-identity --output json 2>&1)"
    rc=$?
    if ((rc == 0)); then
        arn="$(jq -r '.Arn // empty' <<<"$out" 2>/dev/null)"
        row aws live "${arn:-unknown}" "n/a (instance-role session, no fixed expiry)" "aws sts get-caller-identity"
    else
        row aws missing - - "aws sts get-caller-identity" "$(failure_detail "$rc" "$(first_line "$out")")"
    fi
}

# GitHub is never a personal login in an agent session (shims/gh refuses
# `gh auth login/logout/switch`; pushes go through the GitHub App per repo
# owner). Read gh-app-token's own installation cache instead of minting a
# fresh token just to report status.
check_github_app() {
    local f owners dir="/mnt/nvme/${USER:-$(id -un)}/gh-app-token"
    # gh-app-token's cache is on /mnt/nvme/<user> where that disk is (default_cache_dir in shims/gh-app-token).
    [[ -d "/mnt/nvme/${USER:-$(id -un)}" ]] || dir="$HOME/.cache/gh-app-token"
    f="$(find "$dir" -maxdepth 1 -name 'covered-*.json' -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -n1 | cut -d' ' -f2-)"
    if [[ -z "$f" ]]; then
        row github_app unknown - - "ls $dir/covered-*.json" \
            "no installation discovered yet this host; shims/gh mints on first push/API call. Personal gh login is refused by design."
        return
    fi
    owners="$(jq -r 'keys | join(", ")' "$f" 2>/dev/null)"
    row github_app live "App covers: ${owners:-unknown}; other owners -> GH_PUBLIC_REPO_PAT fallback" \
        "n/a (installation tokens auto-mint, ~1h)" "cat $dir/covered-*.json" \
        "personal gh login is refused by design (shims/gh)"
}

check_ant() {
    local out rc email exp status
    out="$(timeout "$TIMEOUT_S" ant auth status 2>&1)"
    rc=$?
    if ((rc != 0)); then
        row anthropic_ant missing - - "ant auth status" "$(failure_detail "$rc" "$(first_line "$out")")"
        return
    fi
    email="$(grep -oP 'Logged in to .* as \K\S+' <<<"$out" || true)"
    exp="$(grep -oP 'expires:\s+\K\S+' <<<"$out" || true)"
    if grep -qi 'expired' <<<"$out"; then status=expired; else status=live; fi
    row anthropic_ant "$status" "${email:-unknown}" "${exp:-unknown}" "ant auth status"
}

check_vercel() {
    local out rc user
    out="$(timeout "$TIMEOUT_S" vercel whoami 2>&1)"
    rc=$?
    if ((rc == 0)); then
        user="$(tail -n1 <<<"$out" | tr -d '\r')"
        row vercel live "$user" "n/a" "vercel whoami"
    else
        row vercel missing - - "vercel whoami" "$(failure_detail "$rc" "$(tail -n1 <<<"$out" | tr -d '\r')")"
    fi
}

# pup exits 0 and prints "Not authenticated" when it holds no token, so the exit code and a text
# match on "Authenticated" both read as live; its --no-agent JSON carries the real answer.
check_datadog() {
    local out rc site exp
    out="$(timeout "$TIMEOUT_S" pup --no-agent auth status 2>/dev/null)"
    rc=$?
    if ((rc == 0)) && jq -e '.authenticated == true' >/dev/null 2>&1 <<<"$out"; then
        site="$(jq -r '.site // empty' <<<"$out" 2>/dev/null)"
        exp="$(jq -r '.expires_at // empty' <<<"$out" 2>/dev/null)"
        row datadog_pup live "${site:-unknown}" "${exp:-unknown}" "pup --no-agent auth status"
    else
        row datadog_pup missing - - "pup --no-agent auth status" \
            "$(failure_detail "$rc" "$(jq -r '.status // empty' <<<"$out" 2>/dev/null || first_line "$out")")"
    fi
}

check_gcloud() {
    local out rc active
    out="$(timeout "$TIMEOUT_S" gcloud auth list --format=json 2>&1)"
    rc=$?
    if ((rc == 0)); then
        active="$(jq -r '[.[] | select(.status=="ACTIVE")][0].account // empty' <<<"$out" 2>/dev/null)"
        if [[ -n "$active" ]]; then
            row gcloud live "$active" "n/a" "gcloud auth list"
        else
            row gcloud missing - - "gcloud auth list" "no ACTIVE account"
        fi
    else
        row gcloud missing - - "gcloud auth list" "$(failure_detail "$rc" "$(first_line "$out")")"
    fi
}

check_gws() {
    # One row per account in gws-accounts' registry, or one google_workspace row
    # when the registry is absent, unreadable, not an object, or empty. The probe
    # is the Gmail profile: every account's read tier holds Gmail read-only, and
    # some (wren) hold nothing else. gws writes advisories ("Using keyring
    # backend: ...") to stderr, so stdout alone is parsed and a failure reports
    # stderr's last line, or a timeout that it timed out.
    local accounts_file="$HOME/.config/gws/accounts.json" accounts account out rc email err
    if [[ ! -f "$accounts_file" ]]; then
        row google_workspace missing - - "jq keys $accounts_file" "no $accounts_file"
        return
    fi
    if ! accounts="$(jq -r 'if type == "object" then keys[] else error("not a JSON object") end' "$accounts_file" 2>&1)"; then
        row google_workspace missing - - "jq keys $accounts_file" "$(first_line "$accounts")"
        return
    fi
    if [[ -z "$accounts" ]]; then
        row google_workspace missing - - "jq keys $accounts_file" "no accounts in $accounts_file"
        return
    fi
    while IFS= read -r account; do
        (
            err="$tmp/gws_${account}.stderr"
            out="$(GWS_ACCOUNT="$account" timeout "$TIMEOUT_S" gws gmail users getProfile --params '{"userId":"me"}' 2>"$err")"
            rc=$?
            if ((rc == 0)); then
                email="$(jq -r '.emailAddress // empty' <<<"$out" 2>/dev/null)"
                row "google_workspace_${account}" live "${email:-unknown}" "n/a" "GWS_ACCOUNT=${account} gws gmail users getProfile"
            else
                row "google_workspace_${account}" missing - - "GWS_ACCOUNT=${account} gws gmail users getProfile" \
                    "$(failure_detail "$rc" "$(tail -n1 "$err")")"
            fi
        ) &
    done <<<"$accounts"
    wait
}

check_fleetctl() {
    local out rc email
    out="$(timeout "$TIMEOUT_S" fleetctl get config --json 2>&1)"
    rc=$?
    email="$(awk -F': *' '/^ *email:/{print $2; exit}' "$HOME/.fleet/config" 2>/dev/null | tr -d '\r')"
    if ((rc == 0)); then
        row fleetctl live "${email:-unknown}" "n/a" "fleetctl get config"
    else
        row fleetctl missing - - "fleetctl get config" "$(failure_detail "$rc" "$(tail -n1 <<<"$out")")"
    fi
}

check_sentry() {
    local out rc user
    out="$(timeout "$TIMEOUT_S" sentry-cli info 2>&1)"
    rc=$?
    user="$(grep -oP '^\s*User:\s*\K\S+' <<<"$out" || true)"
    if ((rc == 0)) && [[ -n "$user" ]]; then
        row sentry live "$user" "n/a (auth token)" "sentry-cli info"
    else
        row sentry missing - - "sentry-cli info" "$(failure_detail "$rc" "$(first_line "$out")")"
    fi
}

check_kubectl() {
    local ctx rc out username
    ctx="$(timeout "$TIMEOUT_S" kubectl config current-context 2>&1)"
    rc=$?
    if ((rc != 0)); then
        row kubectl missing - - "kubectl config current-context" "$(failure_detail "$rc" "$(first_line "$ctx")")"
        return
    fi
    out="$(timeout "$TIMEOUT_S" kubectl auth whoami 2>&1)"
    rc=$?
    if ((rc == 0)); then
        username="$(grep -oP '^Username\s+\K\S+' <<<"$out" || true)"
        row kubectl live "${username:-unknown} (context: $ctx)" "n/a (assumed-role session)" "kubectl auth whoami"
    else
        row kubectl missing - - "kubectl auth whoami" "context: $ctx; $(failure_detail "$rc" "$(first_line "$out")")"
    fi
}

# The secret keys secretsd grants to every session and scope (names only, never
# values). `secrets grants` heads its secret-grant table `KEY` (v3.8.4 and
# earlier) or `SECRET GRANT` (after); the table ends at an empty line or at a
# `KIND` line, which starts a second table, of requests, receipts and
# capabilities, that is not read. Only stdout is parsed. A failure reports
# stderr's last line (the secrets shim writes a notice to stderr before the
# client runs), or stdout's first line when stderr is empty, and a timeout
# reports that it timed out. A lone `no active grants` line means no keys; an
# answer of no known shape reports `unknown`.
check_secretsd() {
    local out rc err detail line first key keys=""
    err="$tmp/secretsd.stderr"
    out="$(timeout "$TIMEOUT_S" secrets grants 2>"$err")"
    rc=$?
    if ((rc != 0)); then
        detail="$(tail -n1 "$err")"
        detail="$(first_line "${detail:-$out}")"
        row secretsd_grants missing - - "secrets grants" "$(failure_detail "$rc" "$detail")"
        return
    fi
    {
        IFS= read -r line
        IFS=$'\t' read -r first _ <<<"$line"
        case "$first" in
            KEY | "SECRET GRANT")
                while IFS=$'\t' read -r key _ && [[ -n "$key" && "$key" != KIND ]]; do
                    keys+="${keys:+,}$key"
                done
                ;;
            KIND) ;;
            *)
                if [[ "$line" != "no active grants" ]]; then
                    row secretsd_grants unknown - - "secrets grants" "unrecognised answer: $line"
                    return
                fi
                ;;
        esac
    } <<<"$out"
    row secretsd_grants live "${keys:-none}" "see \`secrets grants\`" "secrets grants" "keys of every session and scope; names only, never values"
}

check_agent_secrets_broker() {
    local out rc
    out="$(timeout "$TIMEOUT_S" agent-secrets identity 2>&1)"
    rc=$?
    if ((rc == 0)); then
        row agent_secrets_broker live "this process is a registered broker session" "n/a" "agent-secrets identity" \
            "secret-run uses the broker instead of secretsd for this session"
    else
        row agent_secrets_broker missing - - "agent-secrets identity" \
            "$(failure_detail "$rc" "${out:-no broker identity; secret-run falls back to secretsd}")"
    fi
}

check_modal() {
    if command -v modal >/dev/null 2>&1; then
        row modal unknown - - "command -v modal" "modal is on PATH but agent-access has no verified non-interactive status command for it"
    else
        row modal missing - - "command -v modal" "modal CLI not installed on this machine"
    fi
}

# Dispatch: the session's harness plugin (pi-envoy, claude-envoy) puts
# `dispatch` on its shell's PATH and names the
# session for it; `dispatch whoami` answers whom Dispatch takes it for.
check_dispatch() {
    local out rc
    if ! command -v dispatch >/dev/null 2>&1; then
        row dispatch missing - - "command -v dispatch" \
            "no dispatch on PATH; the session's harness plugin puts it there, so this shell is not an agent session's"
        return
    fi
    out="$(timeout "$TIMEOUT_S" dispatch whoami 2>&1)"
    rc=$?
    if ((rc == 0)); then
        row dispatch live "$(first_line "$out")" "n/a" "dispatch whoami"
    else
        row dispatch missing - - "dispatch whoami" "$(failure_detail "$rc" "$(first_line "$out")")"
    fi
}

# A check whose name would name a customer lives in the private repository theorem-labs/sami,
# cloned at <dotfiles>/.secrets: each <dotfiles>/.secrets/dotfiles/agent-access.d/*.sh is sourced
# here, defines its check functions on the helpers above, and appends them to extra_checks and
# the row names they write to extra_rows. A machine without that clone runs only the checks above.
dotfiles="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
extra_checks=()
extra_rows=()
for extra in "$dotfiles"/.secrets/dotfiles/agent-access.d/*.sh; do
    [[ -r "$extra" ]] || continue
    # shellcheck disable=SC1090
    source "$extra"
done

for fn in check_aws check_github_app check_ant "${extra_checks[@]}" check_vercel \
    check_datadog check_gcloud check_gws check_fleetctl check_sentry check_kubectl \
    check_secretsd check_agent_secrets_broker check_modal check_dispatch; do
    "$fn" &
done
wait

# check_gws writes one row per account in the gws registry, so those names come
# from the files it wrote. An unmatched glob stays literal, and the loops below
# skip a name with no row file.
gws_rows=("$tmp"/google_workspace_*)
order=(aws github_app anthropic_ant "${extra_rows[@]}" google_workspace "${gws_rows[@]##*/}" \
    gcloud vercel datadog_pup \
    fleetctl sentry kubectl secretsd_grants agent_secrets_broker modal dispatch)

if ((json)); then
    for name in "${order[@]}"; do
        [[ -f "$tmp/$name" ]] || continue
        IFS=$'\t' read -r n status identity expiry command detail <"$tmp/$name"
        jq -c -n --arg name "$n" --arg status "$status" --arg identity "$identity" \
            --arg expiry "$expiry" --arg command "$command" --arg detail "$detail" \
            '{name:$name,status:$status,identity:$identity,expiry:$expiry,command:$command,detail:$detail}'
    done | jq -s '.'
else
    # No dependency on `column`: it is not on PATH inside an agent box image.
    {
        printf 'NAME\tSTATUS\tIDENTITY\tEXPIRY\tCOMMAND\tDETAIL\n'
        for name in "${order[@]}"; do
            [[ -f "$tmp/$name" ]] || continue
            cat "$tmp/$name"
        done
    } | awk -F'\t' '
        { for (i = 1; i <= NF; i++) if (length($i) > w[i]) w[i] = length($i); n = NF; lines[NR] = $0 }
        END {
            for (r = 1; r <= NR; r++) {
                m = split(lines[r], f, "\t")
                line = ""
                for (i = 1; i <= m; i++) {
                    line = line f[i]
                    if (i < m) { for (j = length(f[i]); j < w[i] + 2; j++) line = line " " }
                }
                print line
            }
        }'
fi
