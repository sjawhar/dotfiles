#!/usr/bin/env bpftrace
/*
 * Who deleted it? Every unlink and rmdir under /mnt/nvme/<user>/tmp, with the process that did it.
 *
 * Written after /mnt/nvme/sami/tmp/CICDLead was emptied between 20:05:20Z and about 20:08Z on
 * 2026-11-07 and nothing on the box could say by what: no container died in the window, every
 * host cleaner had skipped, and the kernel keeps no record of unlinks. inotify cannot answer it
 * either, because it reports the path and not the process.
 *
 * This kernel's bpftrace refuses `path()` ("BPF_FUNC_d_path not available"), so the directory is
 * named by walking three dentries up and printing the names, and the filter is those names
 * rather than a resolved path: a delete is reported when it sits under a directory `tmp` whose
 * own parent is `sami`. That is the tree in question and nothing else matches it, and the cost
 * is three pointer reads on a hook that only fires on a delete.
 */

kfunc:security_path_unlink
{
	$d1 = str(args->dentry->d_parent->d_name.name);
	$d2 = str(args->dentry->d_parent->d_parent->d_name.name);
	$d3 = str(args->dentry->d_parent->d_parent->d_parent->d_name.name);
	if (($d1 == "tmp" && $d2 == "sami") || ($d2 == "tmp" && $d3 == "sami")) {
		printf("%s unlink pid=%-8d %-16s %s/%s/%s/%s\n", strftime("%H:%M:%SZ", nsecs), pid, comm,
		    $d3, $d2, $d1, str(args->dentry->d_name.name));
	}
}

kfunc:security_path_rmdir
{
	$d1 = str(args->dentry->d_parent->d_name.name);
	$d2 = str(args->dentry->d_parent->d_parent->d_name.name);
	$d3 = str(args->dentry->d_parent->d_parent->d_parent->d_name.name);
	if (($d1 == "tmp" && $d2 == "sami") || ($d2 == "tmp" && $d3 == "sami")) {
		printf("%s rmdir  pid=%-8d %-16s %s/%s/%s/%s\n", strftime("%H:%M:%SZ", nsecs), pid, comm,
		    $d3, $d2, $d1, str(args->dentry->d_name.name));
	}
}
