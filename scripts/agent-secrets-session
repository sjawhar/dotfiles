#!/usr/bin/env bash
# agent-secrets-session: exec an agent harness as a registered host session of the
# agent-secrets helper (AGENTC-393), so every process under it gets secrets-broker proofs from
# the helper. The launchers (shims/omp, scripts/cld, scripts/oc) exec their agent through this,
# and it execs in turn, so the pid the helper pins is the agent's.
#
#   agent-secrets-session <agent argv…>
#
# The argv runs unregistered when this is not a host session on a helper machine: a box or pod
# (AGENT_SECRETS_KEY_DIR; its key dir is its identity), or a machine without the helper's user
# unit (installers/agent-secrets.sh, which devbox/install.sh runs). It also runs unregistered,
# with one line on stderr, when registering could only cost the launch: agent-secrets is not on
# PATH, or `launcher login-status` prints no known state on stdout. No state means the client
# cannot run (a mise shim whose pinned version failed to install exits 1, and exec'ing `register`
# through it would end the launch) or the helper does not answer (stopped or crashed: `register`
# would redial it for 10 s before launching).
#
# Otherwise it registers, adding `--wait 10` only while the helper holds a live launcher
# credential, so the agent starts enrolled: the pinned client (legion-envoy-v3.16.0) waits the
# whole `--wait` for an enrollment that cannot happen without one. From the legion #1589 release
# `register --wait` answers at once without a credential, and the `issued` case below can go.
#
# Registering without a credential is deliberate (DotfilesDeepReview B1). The helper keeps
# retrying enrollment for every registered session, so a session launched before
# `agent-secrets-login` moves to the broker once the login happens, with no restart. Until then
# the #1589 release's helper answers `sign` with NO_CREDENTIAL, and `agent-secrets identity`
# exits 1 on it with a notice, so secret-run in that session uses secretsd. An older helper
# answers NOT_ENROLLED, which `identity` counts as a broker identity: that is why no consumer
# calls secret-run until that release is pinned and the helper restarted on it (plan v14).
set -euo pipefail

DOTFILES_DIR="${DOTFILES_DIR:-$HOME/.dotfiles}"

(( $# )) || { echo "usage: agent-secrets-session <agent argv…>" >&2; exit 2; }

if [[ -n "${AGENT_SECRETS_KEY_DIR:-}" || ! -e "$HOME/.config/systemd/user/agent-secrets-helper.service" ]]; then
    exec "$@"
fi

unregistered() { echo "agent-secrets-session: ${1%%$'\n'*}; this session has no secrets-broker identity" >&2; }

if ! command -v agent-secrets >/dev/null 2>&1; then
    unregistered "agent-secrets is not on PATH (mise install agent-secrets)"
    exec "$@"
fi
export AGENT_SECRETS_HELPER_SOCK="${AGENT_SECRETS_HELPER_SOCK:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/agent-secrets/helper.sock}"
if [[ -z "${AGENT_SECRETS_URL:-}" ]]; then
    # shellcheck source=SCRIPTDIR/../agent-secrets/broker.env
    . "$DOTFILES_DIR/agent-secrets/broker.env"
fi
export AGENT_SECRETS_URL

# login-status prints the helper's login state (none, pending, denied, expired, issued) on stdout
# whenever the helper answers, and nothing there when it cannot be asked. The state is read from
# stdout alone, because stderr carries other lines around it: mise's auto-install progress on the
# first launch after a pin bump, before it, and from the legion #1589 release a line saying what
# to do, after every state but issued. stderr goes to its own capture, and its last line is the
# notice when there is no known state: a failed auto-install prints its progress first and its
# cause last. ($(<…) has already dropped the trailing newlines, so the last line is not empty.)
errfile="$(mktemp)" || errfile=""
status="$(agent-secrets launcher login-status 2>"${errfile:-/dev/null}" || true)"
why=""
if [[ -n "$errfile" ]]; then why="$(<"$errfile")"; rm -f "$errfile"; fi
case "$status" in
    issued) exec agent-secrets register --wait 10 --exec -- "$@" ;;
    none | pending | denied | expired) exec agent-secrets register --exec -- "$@" ;;
    *)
        why="${why##*$'\n'}" first="${status%%$'\n'*}"
        unregistered "${why:-agent-secrets launcher login-status printed no state (stdout: ${first:-empty})}"
        exec "$@"
        ;;
esac
