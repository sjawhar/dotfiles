#!/usr/bin/env bash
# omp-session-live <session id, id prefix, or transcript path>: print "<pid>\t<how>" for each live
# omp process on this machine that runs that session, and exit 0 when there is one, 1 when there
# is none. scripts/agent-session and `agentbox new` ask it before any `omp --resume`, so no
# resume path (tmux-resurrect-omp, a pane restarter, a move's relauncher, a person) starts a
# session a second time: on 2026-11-03 a second tmux server's restore resumed 50 live sessions
# again (00:30Z), and a pane restarter resumed one whose omp was alive because a CHILD of it had
# been killed (00:37Z).
#
# An omp runs a session when its own command line names it (`--resume <id>` or a path ending in
# `_<id>.jsonl`), or when it holds that transcript open FOR WRITING (a new session or one
# resumed by a prefix). omp's helper processes (`__omp_worker_*`) are not sessions. A process
# inside an agent box is seen by its command line; its descriptors are the box's.
# OMP_SESSION_LIVE_PROC replaces /proc for the tests.
#
# Only a writer runs a transcript. omp's session writer holds its file O_WRONLY|O_APPEND for its
# life (flags 02102001 in /proc/<pid>/fdinfo/<fd> on every writer here), while an omp opens
# ANOTHER session's transcript read-only whenever a tool reads it. At 2026-11-03 05:59:13Z omp
# 2559955, which runs 01a170df, held 01a170e0's transcript read-only, and omp-dup-watch, which
# used the descriptor alone, reported 01a170e0 as run by two omps. A read-only descriptor here
# would refuse a legitimate resume, so the access mode is read too.
#
# A transcript path names one file, not every file of its session. So an omp runs a path when it
# holds that same file open (device and inode) or its command line names that same real path (a
# relative one read from that omp's directory). One that names the session by id alone runs the
# transcript of it that it holds; for a boxed omp the box is asked (`docker exec`), since the
# host cannot read its descriptors. When it holds none that can be seen (a transcript not opened
# yet, a box that does not answer), it may run this one, and it counts.
#
# A transcript path names one file, not every file of its session, and a path on a command line
# counts for a bare id when its file name ends `_<id>.jsonl` -- wherever that file is. It used to
# have to sit in a folder named `sessions`, which made every session started with a
# `--session-dir` (or PI_CODING_AGENT_SESSION_DIR) of another name invisible: on 2026-11-04 at
# 20:00Z, of 103 ids that agent boxes' own `ps` named on sami-devbox, this script called 2 dead --
# 01a1a682-6912 and -6922, both resumed from `.../RefreezeAM17/session/<stamp>_<id>.jsonl`, both
# working. Every resume path asks this script first, so their duplicate refusal was off too, and
# twins were started.
#
# --wait SECONDS: ask again every 2 s until no omp runs the session or SECONDS pass. A relaunch
# that follows a hang-up (a move, a restart, `respawn-pane -k`) starts while the old omp is still
# tearing down, and must not be refused for it.
set -uo pipefail
P="${OMP_SESSION_LIVE_PROC:-/proc}"
wait_for=0
if [[ "${1:-}" == --wait ]]; then wait_for="${2:-0}"; shift 2; fi
target="${1:-}"
[[ -n "$target" ]] || { echo "usage: omp-session-live [--wait SECONDS] <session id | id prefix | transcript path>" >&2; exit 2; }
# Inside an agent box this script can see only the box's own processes, so "no omp runs that
# session" is a thing it cannot know, and saying it would be a failed read wearing the shape of
# a clean answer. Exit 3, distinct from 1, and say what to run instead. At 13:47Z on 2026-11-05
# a fleet broadcast gated on this script, run from a box, judged all 99 registered sessions dead
# and sent nothing while reporting "delivered to 0 live sessions"; the same loop on the host
# reached 71. OMP_SESSION_LIVE_PROC means a caller supplies its own /proc (the tests), which is
# an answer about that tree and not about the host, so the guard stands aside for it.
if [[ -z "${OMP_SESSION_LIVE_PROC:-}" && -e /.dockerenv ]]; then
    echo "omp-session-live: this is an agent box (/.dockerenv), which sees only its own processes, so whether an omp on the host runs $target cannot be answered here. Ask the host: ssh ${AGENTBOX_HOST:-<host>} omp-session-live $target" >&2
    exit 3
fi
if (( wait_for > 0 )); then
    deadline=$((SECONDS + wait_for))
    while out="$("$0" "$target")"; do
        (( SECONDS < deadline )) || { printf '%s\n' "$out"; exit 0; }
        sleep 2
    done
    exit 1
fi
uuid='[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}'
file="" inode=""
if [[ "$target" =~ _(${uuid})\.jsonl$ ]]; then
    want="${BASH_REMATCH[1]}"
    file="$(realpath -m -- "$target")"
    inode="$(stat -L -c %d:%i -- "$target" 2>/dev/null)"
elif [[ "$target" =~ ^[0-9a-f][0-9a-f-]{7,35}$ ]]; then
    want="$target"
else
    exit 1
fi
found=1
pids=()
for d in "$P"/[0-9]*; do
    c=""; read -r c 2>/dev/null <"$d/comm" || continue
    [[ "$c" == omp ]] && pids+=("${d##*/}")
done
# writer FD: true when the descriptor $P/<pid>/fd/<n> is open for writing: the access mode of the
# octal `flags:` of its fdinfo is O_WRONLY (1) or O_RDWR (2), never O_RDONLY (0). A descriptor
# closed between the find and this read has no fdinfo, and counts as no writer.
writer() {
    local flags
    flags="$(awk '/^flags:/ { print $2 }' "${1/\/fd\//\/fdinfo\/}" 2>/dev/null)"
    [[ "$flags" =~ ^[0-7]+$ ]] && (( (8#$flags & 3) != 0 ))
}

# Who holds the transcript open, for every omp at once: one `find`, not one per process. For a
# path, which file each holds, by device and inode (one `stat`): the file itself, or another
# transcript of the session (`other`).
declare -A holds=() other=()
if (( ${#pids[@]} )); then
    fds=(); for pid in "${pids[@]}"; do fds+=("$P/$pid/fd"); done
    pattern="*_${want}*.jsonl"; [[ -n "$file" ]] && pattern="*_${want}.jsonl"
    links=()
    while IFS=$'\t' read -r l t; do
        [[ "$t" =~ _(${uuid})\.jsonl$ && "${BASH_REMATCH[1]}" == "$want"* ]] && writer "$l" || continue
        if [[ -n "$file" ]]; then links+=("$l")
        else l="${l#"$P"/}"; holds[${l%%/*}]="$t"; fi
    done < <(find "${fds[@]}" -maxdepth 1 -type l -lname "$pattern" -printf '%p\t%l\n' 2>/dev/null || true)
    if (( ${#links[@]} )); then
        while IFS=$'\t' read -r n l; do
            l="${l#"$P"/}"
            if [[ -n "$inode" && "$n" == "$inode" ]]; then holds[${l%%/*}]="$file"; else other[${l%%/*}]=1; fi
        done < <(stat -L -c $'%d:%i\t%n' -- "${links[@]}" 2>/dev/null || true)
    fi
fi
# box_holds PID: device:inode of each transcript of the session that the boxed omp PID holds, one
# per line, read in its box: the container from its cgroup, its pid there from NSpid. Nothing
# when PID is in no box or the box does not answer.
box_holds() {
    local cg="" ns cid
    { cg="$(<"$P/$1/cgroup")"; } 2>/dev/null
    [[ "$cg" =~ docker-([0-9a-f]{64})\.scope ]] || return 0
    cid="${BASH_REMATCH[1]}"
    ns="$(awk '/^NSpid:/ {print $NF}' "$P/$1/status" 2>/dev/null)"
    [[ "$ns" =~ ^[0-9]+$ ]] || return 0
    # The box's own fdinfo, the same rule: a descriptor the box holds read-only runs nothing.
    timeout 10 docker exec "$cid" sh -c '
        for fd in $(find "/proc/'"$ns"'/fd" -maxdepth 1 -type l -lname "*_'"$want"'.jsonl" 2>/dev/null); do
            flags=$(awk "/^flags:/ { print \$2 }" "/proc/'"$ns"'/fdinfo/${fd##*/}" 2>/dev/null)
            [ -n "$flags" ] && [ $(( 0$flags & 3 )) -ne 0 ] && stat -L -c %d:%i "$fd"
        done' 2>/dev/null
}
for pid in ${pids[@]+"${pids[@]}"}; do
    [[ "$pid" == "$$" ]] && continue
    mapfile -d '' -t args 2>/dev/null <"$P/$pid/cmdline" || continue
    case " ${args[*]} " in *__omp_worker*) continue ;; esac
    how="" byid=""
    for ((i = 1; i < ${#args[@]}; i++)); do
        a="${args[i]}"
        if [[ "$a" =~ _(${uuid})\.jsonl$ ]]; then id="${BASH_REMATCH[1]}"
        elif [[ "$a" =~ ^${uuid}$ ]]; then id="$a"
        else continue; fi
        [[ "$id" == "$want"* ]] || continue
        # A relative path is read from that omp's directory. Where that cannot be read, the id is
        # all there is.
        if [[ "$a" != "$id" && "$a" != /* ]]; then
            if cwd="$(readlink "$P/$pid/cwd" 2>/dev/null)"; then a="$cwd/$a"; else a="$id"; fi
        fi
        if [[ -z "$file" ]]; then
            # The file name already carries the id; where it sits says nothing about whose it is.
            how="its command line names $id"; break
        elif [[ "$a" == "$id" ]]; then byid=1
        elif [[ "$(realpath -m -- "$a")" == "$file" ]]; then how="its command line names $file"; break
        fi
    done
    [[ -z "$how" && -n "${holds[$pid]:-}" ]] && how="it holds ${holds[$pid]} open"
    if [[ -z "$how" && -n "$byid" && -z "${other[$pid]:-}" ]]; then
        seen="$(box_holds "$pid")"
        if [[ -z "$seen" ]]; then how="its command line names $want"
        elif [[ -n "$inode" && $'\n'"$seen"$'\n' == *$'\n'"$inode"$'\n'* ]]; then how="it holds $file open in its box"; fi
    fi
    if [[ -n "$how" ]]; then printf '%s\t%s\n' "$pid" "$how"; found=0; fi
done
exit "$found"
