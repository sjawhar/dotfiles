#!/usr/bin/env bash
# agentbox: one disposable Sysbox container per agent session, working in a
# checkout made for it.
#
#   agentbox new [-e NAME[=VALUE]]… [--memory SIZE] [--cpus N] [--pids N] [--disk SIZE]
#                [--dir PATH]… [--drop-gone-dirs] [<repo>…] -- <cmd> [args…]
#                                       run a command in a fresh box holding a
#                                       checkout of each repo, working in the
#                                       first; each --dir gives the box one
#                                       existing host directory, read-write at
#                                       its own path, and the box works in the
#                                       first --dir when no repo is named; each
#                                       -e sets a variable in the box
#                                       (docker run -e: a bare NAME passes the
#                                       caller's value); --memory/--cpus/--disk
#                                       raise or lower this box's limits
#                                       (defaults below); --drop-gone-dirs,
#                                       for a resume, leaves out a --dir after
#                                       the first that is no longer a directory
#   agentbox sh <box|session-id> [cmd…] exec into a running session's box
#   agentbox grow <box|session-id> SIZE grow a running box's filesystem without restarting it
#   agentbox finish [--reason TEXT] [--dry-run]
#                                       box only: disable this session's restart, then end its box
#   agentbox ls                         running boxes
#   agentbox doctor                     health checks, host side and box side
#   agentbox rebuild                    build the image now; list boxes on older tags
#   agentbox restart <box|session-id>… | --all [--now]
#                                       relaunch a box's omp in place on the current
#                                       pin/plugins: asks the agent over Envoy to run
#                                       `agentbox restart` (in-box form: this session,
#                                       now) when safe; --now hangs it up at once
#   agentbox move --plan [--json]       the live host sessions this machine runs outside a box,
#                                       with the box each one would get, every path that box
#                                       gets and why it gets it, and its disk cost
#   agentbox move --self [--dry-run] [--dir PATH]…
#                                       run by a session in its own pane at a safe point: it
#                                       relaunches that pane into its own box, resuming this
#                                       session in the same directory. The box's paths are
#                                       inferred from the session's own processes; each --dir
#                                       adds one the inference missed, after the inferred ones
#   agentbox move <session-id>… | --all [--now] [--dry-run]
#                                       ask each host session over Envoy to run
#                                       `agentbox move --self` when safe; --now relaunches
#                                       its pane at once
#
# Each <repo> is a canonical checkout under ~/src. The box holds a git clone of
# its own of each, from the canonical checkout's origin, at <boxes>/<box>/<repo>
# — /mnt/nvme/<user>/agentbox/boxes on a machine with that disk, else ~/boxes
# (BOXES below) — and works in the first. At exit a clone holding nothing its
# remote lacks is removed with the box; a clone with uncommitted changes or
# commits no remote has keeps <boxes>/<box> in place, named on the pane, for its
# owner to push or remove. omp flags pass straight through after `--`.
#
# Every box leaves a RECORD of its own beside its image, <boxes>/../disks/<box>.info:
# `box=`, `session=` (the owning omp session), `created=` and `command=`, written
# when the box is made and removed with the image, so a sweep over what a crash
# left behind can say whose an image is without asking anybody. And a box that
# RESUMES a session takes its predecessor away: once the new box's session has
# registered on Envoy, `agentbox reap-previous` (started by `new`, detached, log
# in ~/.cache/omp/agentbox/reap-<box>.log) removes that session's older boxes on
# this host, keeping any one that still has a container, holds work no remote
# has, or cannot be read, with one line saying which test it was.
#
# A session whose work is NOT a checkout — a lane's scratch tree, a directory of
# worktrees, a coordination root — names it with --dir instead of a repo
# (dispatch://INFRA-702): 50 of this host's 82 live sessions on 2026-11-01 worked
# in a directory that is not a repository, so a box could not be started for them
# at all. A --dir is the HOST's directory, bind-mounted read-write at its own path
# and never cloned or copied: it is shared with the host and with every other box
# that names it, it outlives the box, and writes in it are outside the box's disk
# image and so outside its disk limit. The cpu, memory and pids limits apply as
# always. ~/src is already in every box, so a --dir under it adds only the working
# directory; a path anywhere else (a lane tree under /mnt/nvme, ~/Code/...) is
# reachable in a box only when it is named.
#
# The box mounts an allow-list of $HOME (below). Host services arrive two ways:
# the session bus, the metadata service and the Envoy API through socat relays
# (Sysbox maps the box onto a subordinate uid range and dbus-daemon refuses a
# peer whose uid is not the user's; the relayed bus is what makes the keyring -
# and every tool that keeps a login in it - work unchanged inside), and the
# secretsd socket by direct mount. secretsd pins the process that REGISTERs a
# session and serves only that process's descendants; a forking relay makes
# every connection a different, short-lived peer, so nothing through a relay is
# ever a descendant of anything. The daemon (>= 3.2.3) accepts the mapped uid.
# Image: agentbox/Dockerfile.
#
# Secrets: each box gets a broker identity, a P-256 key and an enrollment of it.
# The launcher makes the enrollment from the host with the operator's launcher credential
# (agent-secrets-login, once per host), which lives in the host helper's memory. For a box with
# an omp session id, the key is the host's key for that session. The host makes it under
# $RUN_BASE/session-keys/<sid> and copies it into the box (ensure_session_key, enroll_key). A box
# with no session id, or one whose session key the host cannot make, makes its key inside itself
# (docker exec … agent-secrets keygen), in its private runtime dir. The launcher bind-mounts the
# key dir into that box only. A detached `agent-secrets renew` loop in the box (start_renew,
# RENEW_LOOP) keeps the lease, which lapses within 15 min when nothing renews it. When the broker
# refuses renew as not live, the launcher enrolls the key the box holds again
# (reenroll_if_not_live). A failed attempt keeps the key, and the launcher tries again later.
# close_box revokes a box's own enrollment at once (unenroll_box). It gives a session's
# enrollment to a detached waiter, which ends it after a grace unless another box of the session
# uses it. A box started while the host's helper holds no live launcher credential gets no
# identity at all (no key, no enrollment.pending). Its agents use secretsd, and `new` says so
# (broker_ready). The same holds for a box whose first enrollment fails: enroll_failed removes
# its key.
set -euo pipefail

DOTFILES_DIR="${DOTFILES_DIR:-$HOME/.dotfiles}"
SRC="${AGENTBOX_SRC:-$HOME/src}"
# `agentbox new --no-host-writes`: the box gets no writable host path at all except the ones
# its caller names with --dir. For a harness that runs untrusted or replayed sessions with
# their tools on, where a write escaping into a lane's tree is the hazard, not a bug to find
# afterwards. mount_args does the three parts: no durable bind, $SRC redirected to an empty
# per-box directory, and every home allow-list entry read-only.
NO_HOST_WRITES=false
[[ "${AGENTBOX_NO_HOST_WRITES:-}" == 1 ]] && NO_HOST_WRITES=true
# A box's checkouts, and the template clone per repo every one of them is copied from
# (clone_checkout). Both go on the machine's big
# disk where it has one, /mnt/nvme/<user>, tested as `.bashrc` tests it for the language caches:
# a clone per box per repo does not fit on the root disk of sami-rocqperf, which held 11 GiB free
# of 495 GiB on 2026-10-31 against an 18 GiB floor, while /mnt/nvme had 94 GiB. They move
# together because a box's clone hardlinks its objects from the template (`cp -al`), which works
# only within one filesystem. A machine without that disk keeps the old paths under $HOME, so
# nothing else changes; AGENTBOX_BOXES and AGENTBOX_CLONE_TEMPLATES override either.
if [[ -d "/mnt/nvme/$(id -un)" ]]; then
    BOXES="${AGENTBOX_BOXES:-/mnt/nvme/$(id -un)/agentbox/boxes}"
    CLONE_TEMPLATES="${AGENTBOX_CLONE_TEMPLATES:-/mnt/nvme/$(id -un)/agentbox/clones}"
else
    BOXES="${AGENTBOX_BOXES:-$HOME/boxes}"
    CLONE_TEMPLATES="${AGENTBOX_CLONE_TEMPLATES:-${XDG_CACHE_HOME:-$HOME/.cache}/agentbox-clones}"
fi
# The machine's LOCAL SSD, where everything a box writes that dies with the box belongs: its
# disk image and its build cache. On sami-devbox that is /mnt/scratch, 17.6 TiB of md raid0 that
# came with the machine shape, 21% used on 2026-11-04, against 81% on the 16 TiB persistent disk
# /mnt/nvme, which is paid for by the gigabyte-month and shared with every lane's work
# (dispatch://INFRA-1192). WHAT IT COSTS: a local SSD is EMPTY after a machine stop, and a raid0
# of them is gone if one member fails. Nothing durable may live here. A box's disk image holds
# only the box's private $HOME, its /tmp and its clones, all three of which already die with the
# box (agentbox/AGENTS.md), and the box cache holds only build caches; the box TREES, the clone
# templates and the host's record of a box's home (box_home_carry) stay on /mnt/nvme. The one
# thing lost that a stop did not already take: the image of a box kept in place because a clone
# in it held unpushed work (close_box), which a stop would take with the machine's uptime
# anyway.
# Only a real mount counts: a /mnt/scratch that is a plain directory of the root disk would put
# every box image on a 484 GiB filesystem, under the 500 GiB admission floor, and no box would
# start at all. AGENTBOX_SCRATCH names another root and skips that test; a machine with no such
# mount keeps /mnt/nvme, so nothing changes anywhere else.
BOX_SCRATCH=""
if [[ "${1:-}" != finish ]] && { [[ -n "${AGENTBOX_SCRATCH:-}" ]] || mountpoint -q /mnt/scratch 2>/dev/null; }; then
    if mkdir -p "${AGENTBOX_SCRATCH:-/mnt/scratch}/$(id -un)" 2>/dev/null; then
        BOX_SCRATCH="${AGENTBOX_SCRATCH:-/mnt/scratch}/$(id -un)"
    fi
fi
# Build caches live outside the sparse home image, separately for each box.
if [[ -n "$BOX_SCRATCH" ]]; then
    BOX_CACHE_ROOT="${AGENTBOX_CACHE_ROOT:-$BOX_SCRATCH/box-cache}"
elif [[ -d "/mnt/nvme/$(id -un)" ]]; then
    BOX_CACHE_ROOT="${AGENTBOX_CACHE_ROOT:-/mnt/nvme/$(id -un)/box-cache}"
else
    BOX_CACHE_ROOT="${AGENTBOX_CACHE_ROOT:-$HOME/.cache/box-cache}"
fi
# Every repo is a git clone of the box's own (AGENTC-1420, Sami, 2026-10-02: "Let's just switch to
# Git everywhere"). On the shared jj store of agent-c, 298 workspaces and 135,748 refs/jj/keep refs,
# every jj command took about 11 s against 0.1 s for git. A repo listed here also gets a sparse
# checkout with these patterns, set before the first checkout. agent-c leaves out tasks/ (3.8 GB of
# its 4.2 GB tree): a full clone takes 194 s and this one about 30 s. Every tasks/*/basic_info.json
# stays, because tl validate's deployment-catalog check reads all of them; an agent adds the task it
# works on with `git sparse-checkout add /tasks/<id>/`.
declare -A CLONE_SPARSE=([agent-c]='/* !/tasks/ /tasks/*/basic_info.json')
# git with the same GitHub App credential routing a box's own git has (session_env), so a clone made
# here acts as the repo owner's App whoever runs the launcher.
APP_GIT=(env GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=include.path "GIT_CONFIG_VALUE_0=$DOTFILES_DIR/gh-app-routes.gitconfig" git)
RUNTIME=sysbox-runc
NETWORK=agentbox
# Resource limits per box (dispatch://INFRA-702). A box that runs away is stopped by its own
# cgroup, and no other box is touched. Measured on sami-rocqperf 2026-10-31 over 44 live agent
# sessions (RSS+swap of each session's process tree; RSS overcounts shared pages): memory p50
# 2.3 GiB, p95 14.1 GiB, max 17.8 GiB; CPU over 10 s p50 0.15 cores, p95 1.74, max 3.09. So
# 24 GiB of memory with 8 GiB of swap beyond it, and 8 cores, hold every session measured with
# room to spare. `agentbox new --memory SIZE --cpus N` changes one box; AGENTBOX_MEMORY and
# AGENTBOX_CPUS do too, but a session's environment reaches every box it later starts, so prefer
# the flag.
# The per-box limit does not bound the sum: 44 boxes at 24 GiB may claim 1,056 GiB on a 251 GiB
# host. So every box runs under one parent slice, user-<uid>-agentbox.slice, which systemd nests in
# user-<uid>.slice by its name. Boxes and host sessions then share that slice's one ceiling
# (MemoryMax=92% from /etc/systemd/system/user-.slice.d/60-omp-memory-guard.conf), as host
# sessions alone did before; docker's default parent, system.slice, has no such ceiling.
# The default follows the machine: a twentieth of its memory, never under 24 GiB (shims/omp uses
# the same formula for a host session, dotfiles 306d0323). 24 GiB was measured on sami-rocqperf,
# a 251 GiB machine, and on sami-devbox (2.2 TiB) it left 8 boxes at their limit with kernel OOM
# kills every few minutes on 2026-11-03. So: rocqperf 24g, devbox 109g.
box_mem_total_kb="$(awk '$1 == "MemTotal:" { print $2; exit }' /proc/meminfo 2>/dev/null || true)"
box_default_g=$(( ${box_mem_total_kb:-0} / 20 >> 20 ))
(( box_default_g >= 24 )) || box_default_g=24
BOX_MEMORY="${AGENTBOX_MEMORY:-${box_default_g}g}"
BOX_CPUS="${AGENTBOX_CPUS:-8}"
# Swap a box may use beyond its memory limit; docker takes the two added together (--memory-swap).
BOX_SWAP=8g
# A box above these starves the machine instead of its own session, so the launcher refuses it.
BOX_MEMORY_CAP="$((box_default_g * 4))g"
BOX_CPUS_CAP=32
# Processes per box: a fork bomb inside one otherwise takes the host's pid space. The limit
# counts THREADS, not just processes, which is why 8192 was not the large number it looked:
# on 2026-11-08 a plain `go test` at default parallelism on this 288-core host held 69 compile
# processes and 5,602 threads in one box. Three boxes reached 8192 that night and one died of
# it whole — the kernel refuses every fork at the limit, docker removes the container, and the
# runner inside cannot even log its exit, so the session lost three workers and its /tmp
# (dispatch://INFRA-1739). The host is nowhere near its own ceiling: the agentbox slice allows
# 1,384,119 and held 32,059 across 65 boxes, so one box at 32768 is 2.4% of the slice.
BOX_PIDS="${AGENTBOX_PIDS:-32768}"
# Above this a box can still starve the host's pid space, so the launcher refuses it.
BOX_PIDS_CAP=262144
# Disk per box (dispatch://INFRA-702, the third limit its title asks for). docker's
# --storage-opt size= is not available here: it needs the overlay2 driver on xfs with project
# quotas, and this host's docker data root (/var/lib/docker, a bind of /dev/md127[/docker],
# measured 2026-11-01) is ext4 under the overlayfs snapshotter, where docker refuses the option.
# ext4 project quotas are not available either: /dev/md127 carries neither the `project` nor the
# `quota` feature (tune2fs -l, 2026-11-01), and adding them means tune2fs plus a remount of a
# 3.4 TiB filesystem holding every session's work.
# So a box gets a FILESYSTEM of its own instead: a sparse ext4 image under BOX_DISKS,
# loop-mounted at <boxes>/<box> before the clones are made (open_box_disk). Everything a session
# writes without being told where - its clones, its $HOME overlay and /tmp, all three inside that
# directory (mount_args) - is then bounded by one limit, a write past it is ENOSPC inside the box
# alone, and the space returns to the host when the image is removed at close. The image is
# sparse, so a limit reserves nothing: N boxes at 32 GiB do not claim 32N GiB, exactly as the
# memory limit above does not bound the sum.
# sami-devbox has room for 128 GiB sparse homes. Other hosts keep the 32 GiB default.
# An explicit --disk or AGENTBOX_DISK still wins. A sparse limit reserves no host space.
case "${AGENTBOX_HOST:-$(hostname -s)}" in
    sami-devbox|sami-devbox.*) BOX_DISK="${AGENTBOX_DISK:-128g}" ;;
    *) BOX_DISK="${AGENTBOX_DISK:-32g}" ;;
esac
# A box above this takes the shared disk rather than its own session's share, so it is refused;
# below the floor ext4 has no room for its own metadata plus a clone.
BOX_DISK_CAP=512g
BOX_DISK_MIN=1g
# The box images: on the local SSD where the machine has one (BOX_SCRATCH above), else beside
# the box trees and the clone templates. The image is loop-mounted at $BOXES/<box>, so it need
# not share a filesystem with them; a box's clone hardlinks its objects out of a template, and
# that already crosses into the image's own filesystem.
if [[ -n "$BOX_SCRATCH" ]]; then
    BOX_DISKS="${AGENTBOX_DISKS:-$BOX_SCRATCH/agentbox/disks}"
else
    BOX_DISKS="${AGENTBOX_DISKS:-$(dirname "$BOXES")/disks}"
fi
# EVERY BOX LEAVES A RECORD OF ITS OWN, so a sweep over what a crash left behind can say whose
# an image is without asking anybody. At 20:05Z on 2026-11-04 this host held 103 box images from
# before the 18:06Z reboot, 416.2 GiB, each belonging to a session that was alive in a NEW box
# with no container of its own; clearing them took an owner round of 69 sessions, because most
# images record no session anywhere. The record is a small key=value file written when the box
# is created, `<box>.info` beside `<box>.img`:
#
#     box=agentbox-0123456789ab
#     session=01a18385-f8c8-74a9-b6ff-694fb5fe87a7   (empty until the box's omp reveals it)
#     created=2026-11-04T20:31:07Z
#     command=omp --resume /home/sami/.omp/.../_01a18385….jsonl
#
# It is NOT inside $BOXES/<box>, although that is "the box's directory": from open_box_disk on,
# that directory is the mount point of the box's own filesystem, so everything written through it
# lives in the image. An image that is not mounted - which is exactly the state of an orphan
# after a reboot - leaves an EMPTY directory behind (measured on this host: 216 box directories,
# every unmounted one empty), so a record kept in there would answer nothing in the one case it
# exists for. It dies with the image instead (close_box_disk), so a record on disk means an image
# on disk.
BOX_RECORDS="${AGENTBOX_RECORDS:-$BOX_DISKS}"
box_record() { echo "$BOX_RECORDS/$1.info"; }

# box_record_write BOX SID CMD…: the record, at creation. SID is empty for a box that starts a
# new session (omp has not told anybody its id yet); box_record_session fills it in once it has.
# A record that cannot be written is one line on stderr and never a failed launch.
box_record_write() {
    local box="$1" sid="$2" rec
    shift 2
    rec="$(box_record "$box")"
    # Beside the image, so the record exists exactly where images do: the directory is NOT made
    # here, because `open_box_disk` deliberately leaves it absent for a box with no disk limit
    # (`--disk 0`), and such a box has no image to orphan.
    [[ -d "${rec%/*}" ]] || return 0
    # %q keeps the command on one line whatever it holds, and keeps it runnable.
    {
        printf 'box=%s\n' "$box"
        printf 'session=%s\n' "$sid"
        printf 'created=%s\n' "$(date -u +%FT%TZ)"
        printf 'command=%s\n' "$(printf '%q ' "$@")"
    } >"$rec" 2>/dev/null || echo "agentbox: could not write $box's record at $rec" >&2
    return 0
}

# box_record_get BOX FIELD: one field's value, nothing when the box has no record.
box_record_get() {
    local rec; rec="$(box_record "$1")"
    [[ -f "$rec" ]] || return 0
    sed -n "s/^$2=//p" "$rec" | head -1
}

# box_record_session BOX SID: the owning session, once the box's omp has revealed it
# (box_session_id). The first id wins: a box runs one session.
box_record_session() {
    local box="$1" sid="$2" rec tmp
    [[ -n "$sid" ]] || return 0
    rec="$(box_record "$box")"
    [[ -f "$rec" ]] || return 0
    [[ -z "$(box_record_get "$box" session)" ]] || return 0
    tmp="$rec.$$"
    sed "s|^session=.*|session=$sid|" "$rec" >"$tmp" 2>/dev/null && mv -f "$tmp" "$rec" 2>/dev/null \
        || { rm -f "$tmp"; echo "agentbox: could not record $sid as $box's session in $rec" >&2; }
    return 0
}

# Where every box's exit status is kept, one TSV line per box that ended. Durable and shared, so
# a count survives the box, the pane and a reboot.
#
# Why this exists: `docker run --rm` removes the container the moment it ends, so its exit status
# lives only in this launcher's $rc and then in `exit $rc`, which nothing reads -- a tmux pane is
# not a record. On 2026-11-07 the fleet could not answer "how many boxes aborted tonight": the
# host journal carries each box's tmux RELAY exiting 143 on a normal stop and nothing about the
# omp inside, so a scan for SIGABRT (134) found zero while three aborts were known from stderr
# files and bun.report links. A session that aborts cannot write its own abort into its
# transcript either, so a transcript scan is blind to it as well. This file is the surface that
# can count them (dispatch://INFRA-1537).
# Not DURABLE_DIR: that is set further down this file. Same expression it uses.
BOX_EXITS="${AGENTBOX_EXITS:-/mnt/durable/$(id -un)/agentbox-exits.tsv}"

# record_box_exit BOX SID RC: append one line for a box that ended. Never fails the launcher and
# never blocks its cleanup: a missing directory, a full disk or a read-only mount costs the
# record, not the box's removal.
record_box_exit() {
    local box="$1" sid="$2" rc="${3:-}" signal="" dir marker oom="." finished="."
    # One row, one line. `box_session_id` answers with whatever the box said, and on a box whose
    # command is not omp that can be a multi-line docker error -- which, written through, breaks
    # every reader of this file. Only a UUID is a session id; anything else is no session.
    [[ "$sid" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] || sid=""
    # Written at most once per box. The launcher, close_box, the reaper and the sweep each try,
    # because any one of them may be the only one that runs; the marker is what keeps the tally
    # one row per box. It sits beside the box record, so it goes when the record goes.
    marker="$(box_record "$box").exit"
    [[ -e "$marker" ]] && return 0
    # Without --rm the container is still there after it ends, so docker can be asked what
    # happened. This is the whole point of the change: a launcher that died recorded nothing,
    # and now whoever arrives next can still read it.
    if [[ -z "$rc" ]]; then
        rc="$(docker inspect -f '{{.State.ExitCode}}' "$box" 2>/dev/null)" || rc=""
    fi
    oom="$(docker inspect -f '{{.State.OOMKilled}}' "$box" 2>/dev/null)" || oom=""
    finished="$(docker inspect -f '{{.State.FinishedAt}}' "$box" 2>/dev/null)" || finished=""
    # Nothing to say and nothing to ask: no row, and no marker either, so a later caller that
    # can see the container still gets its chance.
    [[ -z "$rc" ]] && return 0
    # 128+N is a signal death; name the ones that matter rather than leaving a bare number.
    case "$rc" in
        134) signal=SIGABRT ;;
        137) signal=SIGKILL ;;
        139) signal=SIGSEGV ;;
        143) signal=SIGTERM ;;
        *) signal="" ;;
    esac
    dir="$(dirname "$BOX_EXITS")"
    [[ -d "$dir" ]] || return 0
    # One short line, opened O_APPEND: concurrent launchers do not interleave it. The two
    # columns after the signal are new in 2026-11: the kernel OOM flag and docker's own finish
    # time, which a reader of this file previously had no way to get at all.
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$box" "${sid:-(no session)}" "$rc" "${signal:-.}" \
        "${oom:-.}" "${finished:-.}" \
        >>"$BOX_EXITS" 2>/dev/null || true
    : >"$marker" 2>/dev/null || true
    return 0
}

# sweep_exited_boxes: remove agentbox containers that ended more than SWEEP_EXITED_AFTER ago and
# whose box is gone, recording each first. Without --rm an exited container is new state on this
# machine, and a reaper that never runs must not be able to accumulate them. A container whose
# box directory or record still exists is left alone: that is the reaper's to judge, not this.
SWEEP_EXITED_AFTER="${AGENTBOX_SWEEP_EXITED_AFTER:-6h}"
sweep_exited_boxes() {
    local c swept=0
    while read -r c; do
        [[ -n "$c" ]] || continue
        [[ -e "$(box_record "$c")" || -d "$BOXES/$c" ]] && continue
        record_box_exit "$c" "" ""
        docker rm "$c" >/dev/null 2>&1 && swept=$((swept + 1))
    done < <(docker ps -a --filter 'name=^agentbox-' --filter status=exited \
        --filter "until=$SWEEP_EXITED_AFTER" --format '{{.Names}}' 2>/dev/null)
    (( swept )) && echo "agentbox: swept $swept exited container(s) older than $SWEEP_EXITED_AFTER"
    return 0
}
EMBED_NAME=omp-embed
EMBED_PORT="${OMP_EMBED_PORT:-8087}"
IMDS_PORT="${AGENTBOX_IMDS_PORT:-8169}"
# The Envoy HTTP API listens on the host's loopback (envoy-listener, :9020);
# a box reaches it through the same kind of forwarder as the metadata service,
# and the box's entrypoint relays its own 127.0.0.1:$ENVOY_PORT to that
# forwarder, so the URL in the envoy.json a host session reads serves a box
# session too.
ENVOY_PORT="${AGENTBOX_ENVOY_PORT:-9020}"
UID_="$(id -u)"
# AGENTBOX_RUN_BASE: the tests' own tree, and it reaches a detached child that runs this script
# again (the unenroll waiter's `session-live-box`), which a shell variable would not.
RUN_BASE="${AGENTBOX_RUN_BASE:-/run/user/$UID_/agentbox}"
# The relayed session bus, in its own dir so a box sees the socket socat
# recreates after a unit restart.
BUS_SOCK="$RUN_BASE/bus/bus"
# systemd's secretsd.socket unit holds this listener, so the node is stable
# across daemon restarts and a bare-file bind stays live.
SECRETSD_SOCK="/run/user/$UID_/secretsd.sock"
# The secrets broker (AGENTC-393): the URL the caller chose, else this machine's env.local, else
# broker.env's (agent-secrets/broker-url.sh).
# shellcheck source=SCRIPTDIR/../agent-secrets/broker-url.sh
. "$DOTFILES_DIR/agent-secrets/broker-url.sh"
# The operator agent-secrets-login recorded.
LAUNCHER_DIR="$HOME/.config/agent-secrets"
# Why broker_ready last said no, with the command that fixes it.
BROKER_UNREADY=""
# The user's directory on the durable disk (/mnt/durable/<user>, a network disk with about 2 TB
# free, against /mnt/nvme's 160 GB on 2026-11-02), where lanes put new staging and caches. Every
# box binds it whole, read-write, at its own path (mount_args), so a box that writes there writes
# to the durable disk. A box that bound only three subdirectories of it had, at the directory
# itself, a root-owned 0755 stub docker made on the box's own disk: a write there was refused,
# and `df` there answered /mnt/nvme's free space (KNOTCURVE, 2026-11-02 16:00Z). The launcher
# passes the path into the box as AGENTBOX_DURABLE (session_env), since the box's user is not
# the host's; "none" there means the host has no such directory. AGENTBOX_DURABLE replaces the
# path for the tests too. Empty when there is nothing to bind.
DURABLE_DIR="${AGENTBOX_DURABLE:-/mnt/durable/$(id -un)}"
# The compute ledger `ossv-vm` writes (/mnt/nvme/<user>/compute-inventory): every box gets it rw at
# the same path, made when missing, on every host that has /mnt/nvme/<user>; a box without it
# failed its ledger write in `ossv-vm create` (2026-11-03 03:01Z, FileNotFoundError). The
# launcher passes it as AGENTBOX_COMPUTE_INVENTORY, which doctor checks; empty when the host has
# no /mnt/nvme/<user>.
# The shared ssh identity and known_hosts of bin/ossv-vm, in every box whose host has it.
OSSV_SSH="${AGENTBOX_OSSV_SSH:-}"
if [[ -z "$OSSV_SSH" && -d "/mnt/nvme/$(id -un)/oss-verifier/ssh" ]]; then OSSV_SSH="/mnt/nvme/$(id -un)/oss-verifier/ssh"; fi
COMPUTE_INVENTORY="${AGENTBOX_COMPUTE_INVENTORY:-}"
if [[ -z "$COMPUTE_INVENTORY" && -d "/mnt/nvme/$(id -un)" ]]; then COMPUTE_INVENTORY="/mnt/nvme/$(id -un)/compute-inventory"; fi
[[ "$DURABLE_DIR" == /* && -d "$DURABLE_DIR" ]] || DURABLE_DIR=""
# The grading farm's three host paths (installers/grade-farm.sh), in every box whose host has
# them, each at its own path — never /mnt/nvme/<user> whole (Sami,
# dispatch://INFRA-702/comment/11d4bf79-4369-4beb-8691-ec688cee53ab):
#   farm-pkg     the package `farm` is: ~/.local/bin/farm, which every box has through the
#                .local/bin mount, is a SYMLINK to farm-pkg/bin/farm, so in a box without this
#                directory `farm` is a dangling link and every call dies `No such file or
#                directory`. That is what every box on sami-devbox had after the 18:05Z re-box
#                on 2026-11-04, and it stopped the release builds. Bound READ-ONLY: the shim,
#                its grading-tools clone and its venv are written by installers/grade-farm.sh
#                on the host alone, and a run writes nothing in it.
#   grade-farm   the farm root (FARM_DIR: fleet, boxes, ssh_config, known_hosts, the no-start
#                switch and the ssh control sockets each run opens). Read-write.
#   boxid        the box identity's ssh key and its gcloud configuration, whose token cache
#                gcloud rewrites on every refresh. Read-write.
# AGENTBOX_FARM_PKG, AGENTBOX_FARM_ROOT and AGENTBOX_FARM_BOXID replace the paths, as
# AGENTBOX_COMPUTE_INVENTORY replaces the ledger's. Each is empty when the host has no such
# directory (a machine with no grading farm), and an empty one binds nothing.
FARM_PKG="${AGENTBOX_FARM_PKG:-/mnt/nvme/$(id -un)/farm-pkg}"
FARM_ROOT="${AGENTBOX_FARM_ROOT:-/mnt/nvme/$(id -un)/grade-farm}"
FARM_BOXID="${AGENTBOX_FARM_BOXID:-/mnt/nvme/$(id -un)/boxid}"
[[ "$FARM_PKG" == /* && -d "$FARM_PKG" ]] || FARM_PKG=""
[[ "$FARM_ROOT" == /* && -d "$FARM_ROOT" ]] || FARM_ROOT=""
[[ "$FARM_BOXID" == /* && -d "$FARM_BOXID" ]] || FARM_BOXID=""
# The durable filesystem as `agentbox doctor` compares it: device number, total blocks, block
# size, available blocks. The device and not statfs's filesystem id: two stat builds on this host
# print the id's two words in opposite orders (`stat -f -c %i`, 2026-11-02), while a bind keeps
# st_dev, and a box answers 66305 for /mnt/durable/sami as the host does.
durable_fs() { echo "$(stat -c %d "$DURABLE_DIR") $(stat -f -c '%b %S %a' "$DURABLE_DIR")"; }

# What a session relies on, and nothing more: agentbox/mounts, one "<rw|ro>
# <path>" per line. Read here (host) and by doctor (box); both see the file
# because the dotfiles are mounted. A path whose name would name a customer is
# listed in the same form in the private repository theorem-labs/sami (cloned at
# .secrets), PRIVATE_MOUNTS_FILE; a machine without that clone has none of them.
MOUNTS_FILE="$DOTFILES_DIR/agentbox/mounts"
PRIVATE_MOUNTS_FILE="$DOTFILES_DIR/.secrets/dotfiles/agentbox/mounts"
# The entries of one mode, one path per line, from both lists.
mounts_of() {
    local files=("$MOUNTS_FILE")
    [[ -r "$PRIVATE_MOUNTS_FILE" ]] && files+=("$PRIVATE_MOUNTS_FILE")
    awk -v m="$1" '$1 == m { print $2 }' "${files[@]}"
}

# MOVE_SAID: a refusal was printed, so the exit is explained (cmd_move --to checks it).
MOVE_SAID=""
die() { MOVE_SAID=1; echo "agentbox: $*" >&2; exit 1; }

# A limit the launcher will not set: exit 2, apart from every other refusal, so a caller can tell
# "your value is out of range" from "this host cannot start a box".
refuse() { MOVE_SAID=1; echo "agentbox: $*" >&2; exit 2; }

# envoy_send_text [--source envoy] <session id> <text>: one Envoy message, its body on stdin.
# `envoy send` refuses a body given as a command-line word in an agent session, because the
# shell expands backticks and $(...) in such a word before envoy sees it, and agentbox runs
# inside agent sessions. The body is this script's own text either way; stdin keeps it out of
# every argv (/proc/<pid>/cmdline is world-readable) and sends its bytes verbatim.
envoy_send_text() {
    # Each option here takes a VALUE, and the value does not start with `--`, so it has to be
    # taken with its flag: collecting flags alone left `envoy` as the session id and the real
    # session id as the body, so `--source envoy "$sid" "$text"` sent the id to a target called
    # "envoy" and the text nowhere.
    local -a opts=()
    while [[ "${1:-}" == --* ]]; do
        [[ $# -ge 2 ]] || die "envoy_send_text: $1 takes a value"
        opts+=("$1" "$2")
        shift 2
    done
    local sid="$1" text="$2"
    envoy send ${opts[@]+"${opts[@]}"} --message-file - "$sid" <<<"$text"
}

# A docker size (b/k/m/g, 1024-based; no suffix means bytes) in bytes; non-zero on anything else.
size_bytes() {
    local value="${1,,}"
    [[ "$value" =~ ^([0-9]+(\.[0-9]+)?)([bkmg])?$ ]] || return 1
    awk -v n="${BASH_REMATCH[1]}" -v u="${BASH_REMATCH[3]:-b}" \
        'BEGIN { f = (u == "g" ? 1073741824 : (u == "m" ? 1048576 : (u == "k" ? 1024 : 1))); printf "%d", n * f }'
}

# Bytes as the shortest exact docker size, so a derived limit reads like the one it came from.
size_text() {
    local bytes="$1"
    if (( bytes % 1073741824 == 0 )); then echo "$((bytes / 1073741824))g"
    elif (( bytes % 1048576 == 0 )); then echo "$((bytes / 1048576))m"
    else echo "${bytes}b"; fi
}

# RESOURCE_ARGS: the docker run limits for one box, from BOX_MEMORY and BOX_CPUS. $1 and $2 name
# where each value came from, for the refusal message. It runs in the launcher itself and sets a
# global rather than printing, because a $(…) would swallow its exit.
RESOURCE_ARGS=()
set_resource_args() {
    local mem_from="${1:---memory}" cpu_from="${2:---cpus}" pids_from="${3:---pids}" bytes cap swap
    bytes="$(size_bytes "$BOX_MEMORY")" || refuse "$mem_from '$BOX_MEMORY' is not a size (24g, 512m, or bytes)"
    cap="$(size_bytes "$BOX_MEMORY_CAP")"
    (( bytes > 0 )) || refuse "$mem_from '$BOX_MEMORY' is not a usable memory limit"
    (( bytes <= cap )) || refuse "$mem_from '$BOX_MEMORY' is above the $BOX_MEMORY_CAP limit per box"
    [[ "$BOX_CPUS" =~ ^[0-9]+(\.[0-9]+)?$ ]] || refuse "$cpu_from '$BOX_CPUS' is not a number of cores"
    awk -v c="$BOX_CPUS" -v cap="$BOX_CPUS_CAP" 'BEGIN { exit !(c > 0 && c <= cap) }' \
        || refuse "$cpu_from '$BOX_CPUS' is above the $BOX_CPUS_CAP cores limit per box"
    [[ "$BOX_PIDS" =~ ^[0-9]+$ ]] || refuse "$pids_from '$BOX_PIDS' is not a number of processes"
    (( BOX_PIDS > 0 )) || refuse "$pids_from '$BOX_PIDS' is not a usable process limit"
    (( BOX_PIDS <= BOX_PIDS_CAP )) \
        || refuse "$pids_from '$BOX_PIDS' is above the $BOX_PIDS_CAP processes limit per box"
    swap="$(size_bytes "$BOX_SWAP")"
    RESOURCE_ARGS=(
        --memory "$BOX_MEMORY" --memory-swap "$(size_text $((bytes + swap)))"
        --cpus "$BOX_CPUS" --pids-limit "$BOX_PIDS"
        --cgroup-parent "user-${UID_}-agentbox.slice"
    )
}

# BOX_DISK_BYTES: this box's disk limit in bytes, 0 when the caller turned it off. $1 names where
# the value came from, for the refusal. Set in the launcher itself, like set_resource_args.
BOX_DISK_BYTES=0
set_disk_bytes() {
    local from="${1:---disk}" cap min
    if [[ "$BOX_DISK" == 0 || "$BOX_DISK" == none ]]; then BOX_DISK_BYTES=0; return 0; fi
    BOX_DISK_BYTES="$(size_bytes "$BOX_DISK")" || refuse "$from '$BOX_DISK' is not a size (32g, 512m, or bytes)"
    cap="$(size_bytes "$BOX_DISK_CAP")"
    min="$(size_bytes "$BOX_DISK_MIN")"
    (( BOX_DISK_BYTES >= min )) || refuse "$from '$BOX_DISK' is below the $BOX_DISK_MIN minimum per box"
    (( BOX_DISK_BYTES <= cap )) || refuse "$from '$BOX_DISK' is above the $BOX_DISK_CAP limit per box"
}

# Check the filesystem that will hold the images, not the box's loop filesystem.
check_box_disk_space() {
    local path="$BOX_DISKS" free
    while [[ ! -d "$path" ]]; do path="$(dirname "$path")"; done
    free="$(df -B1 --output=avail "$path" | awk 'NR == 2 {print $1}')" \
        || die "cannot read free space for box images at $BOX_DISKS"
    [[ "$free" =~ ^[0-9]+$ ]] || die "cannot read free space for box images at $BOX_DISKS"
    (( free >= 500 * 1073741824 )) \
        || die "box images at $BOX_DISKS have $((free / 1073741824)) GiB free; at least 500 GiB is required to create a box. No box was started."
}

# Cargo keeps its binaries and configuration in the mounted CARGO_HOME. Only its download
# stores move. Never share CARGO_TARGET_DIR: concurrent builds would contend on its lock.
box_cache_mounts() {
    local cache="$BOX_CACHE_ROOT/$1"
    mkdir -p "$cache"/{go-build,go-mod,npm,bun,uv,pip,cargo-registry,cargo-git} || return 1
    box_dir_have "$cache" || printf '%s\n' -v "$cache:$cache"
    printf '%s\n' -v "$cache/cargo-registry:$HOME/.cargo/registry" \
        -v "$cache/cargo-git:$HOME/.cargo/git"
}

# Sami 2026-11-04: agent clutter must be cleaned up. A box's cache goes with its container,
# and only once docker confirms that container is gone: a live box keeps writing into it.
close_box_cache() {
    local box="$1" cache="$BOX_CACHE_ROOT/$1" names
    [[ -d "$cache" ]] || return 0
    if ! names="$(docker ps -a --filter "name=^${box}\$" --format '{{.Names}}' 2>/dev/null)"; then
        echo "agentbox: cannot confirm $box is removed; its cache $cache is kept" >&2
        return 0
    fi
    if [[ -n "$names" ]]; then
        echo "agentbox: $box still exists; its cache $cache is kept" >&2
        return 0
    fi
    # A Go module cache is mode 0444 by design, and `rm -rf` cannot delete a read-only file in
    # a read-only directory: it fails per entry and the tree stays. Measured 2026-11-06: twelve
    # boxes that no longer exist had left 13,851 MiB behind here, and every exiting box's pane
    # ends in a run of `rm: cannot remove '.../go-mod/...': Permission denied`. Make the tree
    # writable first, then remove, then CHECK -- `rm -rf` reports failure per file but the
    # caller never sees which, and a teardown that half-worked must not read as success
    # (ORCH and TAIL, dispatch://INFRA-586).
    chmod -R u+w "${cache:?}" 2> /dev/null || true
    rm -rf "${cache:?}"
    if [[ -d "$cache" ]]; then
        echo "agentbox: $box's cache $cache did not go; it is left for the box-health owner" >&2
        return 0
    fi
}

# The box's own filesystem at $BOXES/<box>: a sparse ext4 image loop-mounted there, so every
# path the box writes through that directory - its clones, its $HOME overlay and its /tmp
# (mount_args) - shares one limit and nothing it writes can take the host's disk or another
# box's. Called before the clones, since they land inside it.
#
# ROOT: the loop mount is the only step that needs it, as `sudo mount -o loop,discard <image>
# <dir>` here and `sudo umount <dir>` in close_box_disk. Everything else (the sparse file, mkfs,
# the image's removal) runs as the user. mkfs gives the filesystem's root directory to the
# launching user (-E root_owner), so the box dir has the owner it had before, and -m 0 leaves no
# blocks reserved for root, so the session may use every byte of its limit. discard makes the
# loop device punch holes in the image, so space a box frees goes back to the host at once
# rather than at close.
open_box_disk() {
    local box="$1" img="$BOX_DISKS/$1.img"
    check_box_disk_space
    mkdir -p "$BOXES/$box"
    (( BOX_DISK_BYTES )) || return 0
    mkdir -p "$BOX_DISKS"
    rm -f "$img"
    truncate -s "$BOX_DISK_BYTES" "$img" || die "could not make the box disk image $img"
    # mkfs.ext4 lives in /usr/sbin, which a session's PATH carries and a systemd unit's or a
    # restore script's often does not; the launcher must work from either.
    PATH="$PATH:/usr/sbin:/sbin" mkfs.ext4 -q -F -m 0 -E "root_owner=$UID_:$(id -g)" "$img" \
        || die "mkfs.ext4 failed on the box disk image $img"
    sudo -n mount -o loop,noatime,discard "$img" "$BOXES/$box" || {
        rm -f "$img"
        die "could not mount the box disk ($BOX_DISK) at $BOXES/$box: 'sudo -n mount -o loop' failed; start the box with --disk 0 on a machine without that sudo rule"
    }
    # mke2fs puts a root-owned 0700 lost+found in every ext4 filesystem, and this one is the
    # directory a session works in: without this, `du`, `find` or a sweep run from the box tree
    # meets a permission denial in its own workspace. Nothing here is ever fscked - the image
    # dies with the box - so the session may have it.
    sudo -n chown "$UID_:$(id -g)" "$BOXES/$box/lost+found" 2>/dev/null || true
}

# BOX_DIRS: the host directories this box was NAMED with (--dir), each at its own path,
# read-write. cmd_new works in the first when no repo is named, and session_env passes them on as
# AGENTBOX_DIRS. A path is taken as the caller typed it after readlink -f, so a symlink reaches
# the box as the directory it names, the way $SRC's symlinked checkouts already do.
BOX_DIRS=()
# True when this launch is a resume that may leave out a --dir gone from the host
# (--drop-gone-dirs). session_env passes it to the box, where the entrypoint's bind check uses
# it to decide whether an unbound --dir after the first refuses the launch or is only said.
BOX_DROP_GONE_DIRS=false
# What mount_args actually BINDS for them, which is not the same list: a named directory the box
# already has at that path is not bound a second time (docker refuses two mounts at one
# destination), and the git object store of a named tree is bound although nobody named it.
BOX_MOUNTS=()

# These exact destinations belong to the box. Replacing them breaks its disk
# accounting or runtime brokers rather than adding access to shared host state.
#
# The last case is the one that cost a lane its trees. A box builds its own
# /mnt/nvme/<user> for its disks, caches and clones, so a --dir naming that exact
# path is SHADOWED by the box's copy: `agentbox move --self --dir /mnt/nvme/sami`
# reported success, the path existed in the box, it held plausible content
# (agentbox, boxid, clones, compute-inventory, farm-pkg, grade-farm), and the
# session's own gate-briefs and gate-runs were simply absent. A bind that fails
# loudly sends its owner back with the right path; this one hands them a
# same-named directory with different contents, so a lane can WRITE into it
# believing it is the host tree, and that work dies with the box (SRE, 2026-11-07,
# box agentbox-b935af17a8e1). Name the subdirectories you actually work in.
box_dir_private_why() {
    local state_root
    state_root="$(dirname "$(dirname "$BOXES")")"
    case "$1" in
        /tmp) echo "every box has a /tmp of its own, inside its disk limit" ;;
        "$HOME/.omp/run") echo "every box has its own ~/.omp/run, or one box's omp broker deletes another's live scopes" ;;
        "/run/user/$UID_") echo "every box has a runtime dir of its own, holding the host's sockets at their usual paths" ;;
        "$state_root")
            echo "a box builds its own $state_root for its disks, caches and clones, so this bind is shadowed by the box's copy and your trees under it are NOT in the box, with no error at any point; name the subdirectories you work in instead, e.g. $(printf -- '--dir %s/<your-tree>' "$state_root")"
            ;;
        *) return 1 ;;
    esac
}

# Keep an already mounted --dir as the working directory without a duplicate bind.
# How "already covered" is decided: $1 is add_box_dir's path AFTER `readlink -f`, so the kernel
# has resolved every symlink and `..` in it, and it is compared with literal bind destinations the
# box has at that same path: under the durable disk by move_within, which compares whole
# components ("$root" or "$root"/..., so /mnt/durable/sami2 is not under /mnt/durable/sami), and
# equal to $SRC, the dotfiles, an allow-list entry or the realpath of one of $SRC's symlinks.
# A path that only LOOKS covered - typed under a root but leading out of it through a symlink or
# `..` - is resolved out of it first and gets a bind of its own, so a wrong answer here costs at
# most a redundant bind, never a path the box silently lacks.
box_dir_bound_why() {
    local path="$1" p
    [[ "$path" == "$SRC" ]] && { echo "every box has $SRC"; return 0; }
    [[ "$path" == "$HOME/.docker" ]] && { echo "every box has a private snapshot of the host Docker config at this path"; return 0; }
    [[ "$path" == "$HOME/.dotfiles" || "$path" == "$DOTFILES_DIR" ]] && { echo "every box has the dotfiles"; return 0; }
    if [[ -n "$DURABLE_DIR" ]] && move_within "$path" "$DURABLE_DIR"; then
        echo "every box has the durable disk $DURABLE_DIR"; return 0
    fi
    if [[ -n "$FARM_PKG" ]] && move_within "$path" "$FARM_PKG"; then
        echo "every box has the grading farm's package $FARM_PKG READ-ONLY"; return 0
    fi
    if [[ -n "$FARM_ROOT" ]] && move_within "$path" "$FARM_ROOT"; then
        echo "every box has the grading farm's root $FARM_ROOT"; return 0
    fi
    if [[ -n "$FARM_BOXID" ]] && move_within "$path" "$FARM_BOXID"; then
        echo "every box has the grading farm's box identity $FARM_BOXID"; return 0
    fi
    for p in "$SRC"/*; do
        [[ -L "$p" ]] || continue
        [[ "$(readlink -f "$p")" == "$path" ]] && { echo "every box has it already: $p links to it and $SRC is mounted"; return 0; }
    done
    while read -r p; do
        [[ "$HOME/$p" == "$path" ]] && { echo "the box allow-list ($MOUNTS_FILE or its private part) gives every box this path read-write"; return 0; }
    done < <(mounts_of rw)
    while read -r p; do
        [[ "$HOME/$p" == "$path" ]] && { echo "the box allow-list ($MOUNTS_FILE or its private part) gives every box this path READ-ONLY"; return 0; }
    done < <(mounts_of ro)
    return 1
}

# One host path this box must bind, once.
box_add_mount() {
    local path="$1" p
    for p in ${BOX_MOUNTS[@]+"${BOX_MOUNTS[@]}"}; do
        [[ "$p" == "$path" ]] && return 0
    done
    BOX_MOUNTS+=("$path")
}

# Does the box get this path without being told? Either it has it by construction ($SRC, the
# dotfiles, the home allow-list) or something already in BOX_MOUNTS contains it.
# box_dir_named PATH: true when --dir names this exact mount destination.
box_dir_named() {
    local p
    for p in ${BOX_DIRS[@]+"${BOX_DIRS[@]}"}; do [[ "$p" == "$1" ]] && return 0; done
    return 1
}

box_dir_have() {
    local path="$1" p
    move_dir_in_box "$path" && return 0
    for p in ${BOX_MOUNTS[@]+"${BOX_MOUNTS[@]}"}; do
        move_within "$path" "$p" && return 0
    done
    return 1
}

# A TREE IS NOT ITS OBJECTS. `~/src/machcsl-riscv/.git/objects` on this host is a SYMLINK to
# /mnt/nvme/sami/git-objects/machcsl-riscv, and so are the task repository's,
# machcsl-riscv-experimental's, link-eval-accept29's and ossvp-ulimit's. A box given the tree and
# not the store answers `not a git repository` for every command in it - measured 2026-11-01 in
# box agentbox-a0875d5a6f7c, started with `--dir ~/src/machcsl-riscv`, where `git rev-parse HEAD`
# answered `fatal: not a git repository` and the objects symlink dangled. `agentbox move` has
# followed the store since it existed (move_take_storage) because it infers its own paths and had
# to; `new` never did, because a --dir was treated as one directory the caller had already
# thought about. The same reader answers for both: move_git_storage, which follows a `.git` FILE,
# `commondir`, `objects` through any symlink, and every line of `objects/info/alternates`.
add_box_dir_storage() {
    local path="$1" tree store
    move_git_root_var "$path" || return 0
    tree="$MOVE_GIT_ROOT"
    while IFS= read -r store; do
        [[ -n "$store" ]] || continue
        [[ -d "$store" ]] || store="${store%/*}"
        [[ -n "$store" && -d "$store" ]] || continue
        store="$(readlink -f "$store")" || continue
        [[ -z "$store" || "$store" == / || "$store" == "$HOME" ]] && continue
        box_dir_private_why "$store" >/dev/null && continue
        box_dir_have "$store" && continue
        box_add_mount "$store"
        echo "agentbox: --dir '$path': its git tree $tree keeps objects in $store, outside the tree; the box gets that too" >&2
    done < <(move_git_storage "$tree")
    return 0
}

# Validate --dir before allocating a box. A directory must exist. The container
# root, private home, tmp, and runtime destinations cannot be replaced.
add_box_dir() {
    local raw="$1" path why
    [[ -d "$raw" ]] || die "--dir '$raw' is not an existing directory"
    path="$(readlink -f "$raw")" || die "--dir '$raw' cannot be resolved"
    case "$path" in
        /) die "--dir / would replace the box root filesystem with the whole host filesystem" ;;
        "$HOME") die "--dir $HOME would shadow the box's own home and its allow-list ($MOUNTS_FILE); name the directory you work in" ;;
    esac
    why="$(box_dir_private_why "$path")" \
        && die "--dir '$path' cannot be given to a box: $why; name the directory you work in instead"
    BOX_DIRS+=("$path")
    if why="$(box_dir_bound_why "$path")"; then
        echo "agentbox: --dir '$path' is not mounted again: $why" >&2
    else
        box_add_mount "$path"
    fi
    add_box_dir_storage "$path"
}

# The box's filesystem and its image, given back. Everything the box wrote goes with the image,
# which is why close_box removes the image before it removes the (now empty) mountpoint. A box
# started with --disk 0 has neither and this is a no-op, as it is for a box whose launcher never
# got as far as the mount.
close_box_disk() {
    local box="$1" img="$BOX_DISKS/$1.img"
    if mountpoint -q "$BOXES/$box" 2>/dev/null; then
        sudo -n umount "$BOXES/$box" \
            || { echo "agentbox: could not unmount $BOXES/$box; its disk image $img is left in place (sudo umount '$BOXES/$box' && rm -f '$img')" >&2; return 1; }
    fi
    # The record goes with the image it describes: a record left on disk means an image left on
    # disk, which is what a sweep over this directory reads.
    rm -f "$img" "$(box_record "$box")"
}

# Whether a new box can get a broker identity: the client installed and the helper holding a live
# launcher credential (which also means the helper answers and an operator logged in). Until then
# (a host before its one `agent-secrets-login`, a helper restarted since) a box starts without
# one: no key, no enrollment.pending, so its agents use secretsd. Sets BROKER_UNREADY when it
# answers no, with login-status's own answer.
broker_ready() {
    local status
    BROKER_UNREADY=""
    if ! command -v agent-secrets >/dev/null 2>&1; then
        BROKER_UNREADY="agent-secrets is not installed (run: mise install agent-secrets)"
        return 1
    fi
    status="$(agent-secrets machine login-status 2>&1)" && return 0
    BROKER_UNREADY="the helper holds no live launcher credential (login-status: ${status%%$'\n'*}; run: agent-secrets-login <email>)"
    return 1
}

# The host side of a box's key dir: bind-mounted at /run/user/$UID_/agent-secrets in that box only.
box_keydir() { echo "$RUN_BASE/$1/run-user/agent-secrets"; }

# The box's key dir is the box's to write too (keygen writes key.pem there as the box's user), so
# the host keeps its own files beside it, in $RUN_BASE/<box>, which no box mounts: each enroll
# attempt's error (enroll.attempt-error) and the enrollment id close_box revokes (enrollment-id).
# What agentbox itself puts in the key dir is written to a temp file in $RUN_BASE/<box> and
# renamed into place, which replaces whatever the box left at that name (a symlink included)
# instead of following it. The `enrollment` file is the client's own: at the pin, the host-side
# `agent-secrets enroll` (cmdEnrollHelper) writes it atomically, through writeFileAtomic.
put_keyfile() {
    local box="$1" name="$2" content="$3" tmp
    tmp="$(mktemp "$RUN_BASE/$box/.keyfile.XXXXXX")" || return 1
    printf '%s' "$content" >"$tmp" && mv -fT "$tmp" "$(box_keydir "$box")/$name"
}

# A session's broker identity belongs to the SESSION, not to the box it is running in today.
# Before this, a box's key was generated inside it, into tmpfs, and its enrollment was keyed by
# the box's name, so `agentbox move` — or any respawn that makes a new box — gave the session a
# new key and a new enrollment id. A pending credential request is bound to the enrollment id
# alone (broker requests/machine_read.go: a release to any other enrollment is NOT_YOURS), and
# ending an enrollment then cancelled every request still pending under it and revoked its grants
# (broker enroll.go endEnrollment, before the broker's carry). So a move orphaned every card Sami
# had not yet answered and threw away every grant he had already given (dispatch://INFRA-1167;
# the orphans of 2026-11-04 are b4cc297b and 7363fc76).
#
# So the HOST makes the key, once per omp session id. The broker keys the enrollment by a runtime
# id that names that session, not the box. While the enrollment is live, the same key under the
# same runtime id gets the SAME enrollment back (broker enroll.go recoverConflict). Its pending
# requests and grants stay on it. Once the enrollment lapses or the helper revokes it, the same
# key gets a new id. Those two ends do not cancel what a session's enrollment holds. The broker's
# carry keeps its grants and pending requests dormant, 12 h by default. The session's next
# enrollment takes them (enroll.go endEnrollment, adopt). The directory is under $RUN_BASE, the
# host's own tmpfs: 0700, no box mounts it, and it clears at a reboot — which ends every session
# anyway, so there is nothing for a key on disk to follow.
session_keydir() { echo "$RUN_BASE/session-keys/$1"; }

# The session's key and the thumbprint of it, made at that session's first box and reused by
# every box after. keygen overwrites key.pem, so it runs only where there is none; the thumbprint
# is kept beside the key because keygen is the one thing that prints one. Sets SESSION_TP.
ensure_session_key() {
    local sid="$1" skd tp
    skd="$(session_keydir "$sid")"
    SESSION_TP=""
    mkdir -p -m 700 "$RUN_BASE/session-keys" "$skd" || return 1
    if [[ -s "$skd/key.pem" && -s "$skd/thumbprint" ]]; then
        SESSION_TP="$(<"$skd/thumbprint")"
        [[ "$SESSION_TP" =~ ^[A-Za-z0-9_-]{43}$ ]] || return 1
        return 0
    fi
    tp="$(agent-secrets keygen --out "$skd" 2>"$RUN_BASE/session-keys/keygen-error")" || return 1
    tp="${tp//[[:space:]]/}"
    [[ "$tp" =~ ^[A-Za-z0-9_-]{43}$ ]] || return 1
    (umask 077; printf '%s\n' "$tp" >"$skd/thumbprint") || return 1
    SESSION_TP="$tp"
}

# A session key outlives its box on purpose; it must not outlive the sessions. tmpfs clears at a
# reboot, and a directory nothing has enrolled for a week belongs to a session long gone.
prune_session_keys() {
    [[ -d "$RUN_BASE/session-keys" ]] || return 0
    find "$RUN_BASE/session-keys" -mindepth 1 -maxdepth 1 -type d -mtime +7 \
        -exec rm -rf {} + 2>/dev/null || true
    return 0
}

# put_keyfile for a file whose bytes must arrive whole: a PEM read through `$(<…)` loses its last
# newline, and the key the box signs with is not a thing to hand over approximately.
copy_keyfile() {
    local box="$1" name="$2" src="$3" tmp
    tmp="$(mktemp "$RUN_BASE/$box/.keyfile.XXXXXX")" || return 1
    cat "$src" >"$tmp" && chmod 600 "$tmp" && mv -fT "$tmp" "$(box_keydir "$box")/$name"
}

# How a box's enrollment ends when it does not end enrolled: the reason in enrollment.error
# (`agentbox doctor` reports it), then key.pem and the enrollment.pending marker removed, so the
# box has no broker identity and its agents use secretsd, as when the host could not enroll it.
enroll_failed() {
    local keydir; keydir="$(box_keydir "$1")"
    put_keyfile "$1" enrollment.error "$2"$'\n'
    rm -f "$keydir/key.pem" "$keydir/enrollment.pending"
    return 1
}

# Wait for the container to be Running (docker exec needs that) for as long as the launcher's
# docker run child lives: a box can take minutes to reach Running when several start at once, and
# the child's exit is the only sign that it never will. Each pass renews the enrollment.pending
# marker, so a client that starts with the box finds it fresh however long the start took.
wait_for_running() {
    local box="$1" child="$2"
    while :; do
        [[ "$(docker inspect -f '{{.State.Running}}' "$box" 2>/dev/null)" == true ]] && return 0
        kill -0 "$child" 2>/dev/null || return 1
        put_keyfile "$box" enrollment.pending ""
        sleep 0.5
    done
}

# What the launcher's box is enrolled as, for enrolling it again (reenroll_if_not_live).
# ENROLLED_BOX is the box's name once enroll_box has enrolled it, and empty before that and after
# a failure. ENROLLED_SID is the session id passed as --session-id (empty for none);
# ENROLLED_RUNTIME and ENROLLED_TP are the runtime id and the thumbprint of the key the box holds;
# ENROLLED_SKD is the session's host key dir when the enrollment is the session's, and empty when
# it is the box's own (no session id, no host key for the session, or the 409 fallback, which
# still passes --session-id); ENROLLED_ID is the id the last enrollment got back. ENROLL_ERROR is
# why the last key step or enroll call failed.
ENROLLED_BOX="" ENROLLED_SID="" ENROLLED_RUNTIME="" ENROLLED_TP="" ENROLLED_SKD="" ENROLLED_ID=""
ENROLL_ERROR=""

# enroll_key BOX SID: give the box the key it enrolls with, and set ENROLLED_SID,
# ENROLLED_RUNTIME, ENROLLED_TP and ENROLLED_SKD for it. A box whose omp session id is known
# enrolls as that SESSION: the host's key for it (ensure_session_key), copied into the key dir,
# and the runtime id `session-<sid>`, so the same session in a new box gets the same enrollment id
# back and keeps the cards Sami has not answered and the grants he has given. A box with no
# session id (a `--` command that is not omp, `doctor`, an `omp --no-session` run) keeps the old
# shape: a key generated INSIDE the box by a process in its namespaces, into its private runtime
# dir (tmpfs, this box only), enrolled under the box's own name, with only the public thumbprint
# coming back. keygen writes over the key the box holds, so the re-enrollment runs this only for a
# box that holds none. Status 1 with the reason in ENROLL_ERROR.
enroll_key() {
    local box="$1" sid="$2" errfile tp="" skd="" runtime="$1"
    errfile="$RUN_BASE/$box/enroll.attempt-error"
    if [[ -n "$sid" ]]; then
        prune_session_keys
        if ensure_session_key "$sid"; then
            skd="$(session_keydir "$sid")"
            tp="$SESSION_TP"
            runtime="session-$sid"
            touch "$skd"
            copy_keyfile "$box" key.pem "$skd/key.pem" \
                || { ENROLL_ERROR="could not give $box the key of session $sid"; return 1; }
        else
            # Not fatal: the box still gets an identity of its own, it just does not carry the
            # session's pending cards into its next box.
            echo "agentbox: no host key for session $sid ($(cat "$RUN_BASE/session-keys/keygen-error" 2>/dev/null)); $box enrolls under its own name and its pending broker cards will not follow the session" >&2
        fi
    fi
    if [[ -z "$skd" ]]; then
        if ! tp="$(docker exec --user ubuntu "$box" agent-secrets keygen --out "/run/user/$UID_/agent-secrets" 2>"$errfile")"; then
            ENROLL_ERROR="agent-secrets keygen failed in $box: $(<"$errfile")"
            return 1
        fi
        tp="${tp//[[:space:]]/}"
        if [[ ! "$tp" =~ ^[A-Za-z0-9_-]{43}$ ]]; then
            ENROLL_ERROR="agent-secrets keygen printed no thumbprint: '$tp'"
            return 1
        fi
    fi
    ENROLLED_SID="$sid" ENROLLED_RUNTIME="$runtime" ENROLLED_TP="$tp" ENROLLED_SKD="$skd"
}

# enroll_attempts BOX ATTEMPTS [fallback]: the broker call of an enrollment, for the key the box
# holds, as ENROLLED_RUNTIME, ENROLLED_TP and ENROLLED_SID name it. The enrollment is made from the
# host with the launcher credential, which no box can read, and the client writes the enrollment
# id beside the key. Up to ATTEMPTS attempts 3 s apart, each one call (two with the 409 fallback
# below), with the enrollment.pending marker renewed before each call: from the legion #1589
# release a client in the box waits on a marker younger than 160 s, so it stays fresh for exactly
# as long as the launcher is still working, however slow the broker. Success records the
# enrollment on the host, sets ENROLLED_BOX and ENROLLED_ID, and removes the marker and every
# error file. A failure leaves the marker for its caller to end, with the reason in ENROLL_ERROR.
# `fallback` allows the 409 fallback below.
enroll_attempts() {
    local box="$1" attempts="$2" fallback="${3:-}" keydir errfile eid attempt=1 args
    keydir="$(box_keydir "$box")"
    errfile="$RUN_BASE/$box/enroll.attempt-error"
    while :; do
        args=(enroll --helper --runtime-id "$ENROLLED_RUNTIME" --thumbprint "$ENROLLED_TP")
        [[ -n "$ENROLLED_SID" ]] && args+=(--session-id "$ENROLLED_SID")
        put_keyfile "$box" enrollment.pending ""
        # enroll prints the enrollment id alone, and writes it into the key dir for the box.
        if eid="$(AGENT_SECRETS_URL="$AGENT_SECRETS_URL" AGENT_SECRETS_KEY_DIR="$keydir" \
            agent-secrets "${args[@]}" 2>"$errfile")"; then
            if [[ -z "$eid" || ! -s "$keydir/enrollment" ]]; then
                ENROLL_ERROR="agent-secrets enroll printed '$eid' and left $keydir/enrollment empty"
                return 1
            fi
            printf '%s\n' "$eid" >"$RUN_BASE/$box/enrollment-id"
            if [[ -n "$ENROLLED_SKD" ]]; then
                # Which box holds the session's enrollment now: the waiter an earlier box left
                # behind reads this and leaves the enrollment alone (unenroll_box). The session's
                # key dir can be gone by the time the box enrolls again (prune_session_keys
                # removes one untouched for 7 days); the enrollment is still the session's.
                printf '%s\n' "$ENROLLED_SID" >"$RUN_BASE/$box/enrollment-session"
                { printf '%s\n' "$eid" >"$ENROLLED_SKD/enrollment-id" \
                    && printf '%s\n' "$box" >"$ENROLLED_SKD/owner"; } 2>/dev/null || true
            else
                # The box's own enrollment. A record of the session's, left by the box's
                # enrollment before a 409 fallback, must go, or unenroll_box would hand this
                # enrollment to the session's waiter instead of revoking it at once.
                rm -f "$RUN_BASE/$box/enrollment-session"
            fi
            rm -f "$keydir/enrollment.pending" "$keydir/enrollment.error" "$errfile"
            ENROLLED_BOX="$box" ENROLLED_ID="$eid"
            return 0
        fi
        # A live enrollment of this session under a key the host no longer holds — its key dir
        # went with a reboot while the old lease still ran — refuses every attempt with the same
        # 409 until that lease lapses, up to 15 minutes. Rather than leave the box with no
        # identity for that long, fall back to the box's own runtime id, where any key is
        # accepted; the session gets its continuity back at its next box. The fallback call is
        # part of the same attempt, made at once: the 409 is the broker's answer, not an outage to
        # wait out, and a re-enrollment pass has one attempt only.
        if [[ -n "$fallback" && -n "$ENROLLED_SKD" && "$(<"$errfile")" == *ALREADY_ENROLLED* ]]; then
            echo "agentbox: the broker still holds a live enrollment for session $ENROLLED_SID under a key this host does not have; $box enrolls under its own name and its pending broker cards will not follow the session" >&2
            ENROLLED_SKD="" ENROLLED_RUNTIME="$box"
            continue
        fi
        (( attempt < attempts )) || break
        (( attempt += 1 ))
        sleep 3
    done
    if (( attempts > 1 )); then
        ENROLL_ERROR="agent-secrets enroll failed $attempts times; last: $(<"$errfile")"
    else
        ENROLL_ERROR="agent-secrets enroll failed: $(<"$errfile")"
    fi
    return 1
}

# Enroll a running box with the secrets broker: its key (enroll_key), then the broker call
# (enroll_attempts), ten attempts 3 s apart. The enrollment.pending marker (cmd_new creates it
# before docker run) is renewed before the key step and before each attempt. Success removes the
# marker and every error file and leaves the enrollment in the ENROLLED_* globals; every other
# end is enroll_failed. The box runs on either way. This is not the way to enroll a box again:
# for a box with no session id it makes a new key over the enrolled one, which the broker refuses
# (409) while that enrollment is live, and enroll_failed then removes the key. reenroll_box
# enrolls the key the box already holds.
enroll_box() {
    local box="$1" sid="$2"
    ENROLLED_BOX=""
    broker_ready || { enroll_failed "$box" "not enrolled: $BROKER_UNREADY"; return 1; }
    put_keyfile "$box" enrollment.pending ""
    enroll_key "$box" "$sid" || { enroll_failed "$box" "$ENROLL_ERROR"; return 1; }
    enroll_attempts "$box" 10 fallback || { enroll_failed "$box" "$ENROLL_ERROR"; return 1; }
}

# reenroll_box BOX: one attempt to enroll the launcher's box again, through enroll_box's broker
# call (enroll_attempts) and never with a new key while the box holds the one it is enrolled
# with. With key.pem in its key dir it enrolls the runtime id, thumbprint and session id the
# ENROLLED_* globals hold, and no keygen and no key copy runs: the broker gives an enrollment
# that is still live its own id back, and one that lapsed or was revoked a new id (under
# --session-id, with the session's grants and pending requests carried to it). Only a box that
# holds no key.pem gets enroll_box's key step again (enroll_key), with the 409 fallback.
# broker_ready comes first: a helper with no live launcher credential is a failed attempt with
# no enroll call. Success leaves the id in ENROLLED_ID (the old one when the enrollment was live)
# and the host's records written as enroll_box writes them. A failure keeps key.pem, puts the
# reason (ENROLL_ERROR) in enrollment.error, removes enrollment.pending, and is never
# enroll_failed.
reenroll_box() {
    local box="$1" keydir
    keydir="$(box_keydir "$box")"
    if ! broker_ready; then
        ENROLL_ERROR="$BROKER_UNREADY"
    elif [[ -e "$keydir/key.pem" ]]; then
        enroll_attempts "$box" 1 && return 0
    else
        put_keyfile "$box" enrollment.pending "" || true
        enroll_key "$box" "$ENROLLED_SID" && enroll_attempts "$box" 1 fallback && return 0
    fi
    put_keyfile "$box" enrollment.error "$ENROLL_ERROR"$'\n' || true
    rm -f "$keydir/enrollment.pending" || true
    return 1
}

# The box's enrollment lease: `agent-secrets renew` inside it, for every box, started again after
# it exits. renew retries every timeout and every other refusal itself, and exits 76 only when the
# broker refuses the enrollment as not live (it lapsed or was revoked); it also exits 2 with no
# identity and 0 on SIGTERM, and something in the box can kill it. Without the restart the lease
# would lapse while the box kept its key. A 76 from a renew started with an id in `enrollment` is
# the one exit that reaches the host: the loop writes enrollment.not-live, which the box's
# launcher (reenroll_if_not_live) only tests for and removes, enrolling the same key again and
# writing the new id into `enrollment`. The loop then reads `enrollment` every 2 s for its delay
# or 90 s, whichever is longer (one launcher pass and one enroll attempt, with room to spare),
# counting its polls rather than reading the clock: a new id starts renew again at once with the
# delay back at 10 s, and the same id runs renew again when the wait ends. Any other exit waits
# the delay. The delay starts at 10 s, doubles after each wait up to 10 min, and goes back to 10 s
# after a renew that ran over a minute, so an enrollment nothing enrolls again costs the broker
# one call per 10 min. Each exit, each wait and the next delay go to renew.log beside renew's own
# output. The loop survives an omp relaunch (`agentbox restart`, same container) and dies with
# the box.
# shellcheck disable=SC2016  # expands in the box's sh
RENEW_LOOP='d=10
while :; do
    id=$(cat "$AGENT_SECRETS_KEY_DIR/enrollment" 2>/dev/null)
    s=$(date +%s)
    agent-secrets renew
    rc=$?
    [ $(($(date +%s) - s)) -gt 60 ] && d=10
    if [ "$rc" -eq 76 ] && [ -n "$id" ]; then
        : >"$AGENT_SECRETS_KEY_DIR/enrollment.not-live"
        echo "agentbox: agent-secrets renew exited 76: enrollment $id is not live; the host enrols this box again"
        polls=$((d / 2))
        [ "$polls" -lt 45 ] && polls=45
        n=0 new=$id
        while [ "$n" -lt "$polls" ] && { [ -z "$new" ] || [ "$new" = "$id" ]; }; do
            sleep 2
            n=$((n + 1))
            new=$(cat "$AGENT_SECRETS_KEY_DIR/enrollment" 2>/dev/null)
        done
        if [ -n "$new" ] && [ "$new" != "$id" ]; then
            d=10
            continue
        fi
        echo "agentbox: enrollment $id is still not live after $((n * 2))s; renewing again"
    else
        echo "agentbox: agent-secrets renew exited $rc; restarting in ${d}s"
        sleep "$d"
    fi
    d=$((d * 2))
    [ "$d" -gt 600 ] && d=600
done >>"$AGENT_SECRETS_KEY_DIR/renew.log" 2>&1'
start_renew() {
    docker exec -d --user ubuntu "$1" sh -c "$RENEW_LOOP"
}

# box_renew_log BOX LINE: LINE, after the UTC time and a space, at the end of the box's renew.log,
# appended by a process in the box (its namespaces, its user), so a link the box planted at that
# name cannot turn it into a write on the host. A box that is gone takes the line with it.
box_renew_log() {
    # shellcheck disable=SC2016  # expands in the box's sh
    docker exec --user ubuntu "$1" sh -c 'printf "%s\n" "$1" >>"$AGENT_SECRETS_KEY_DIR/renew.log"' \
        sh "$(date -u +%FT%TZ) $2" >/dev/null 2>&1 || true
}

# The launcher's answer to the renew loop's enrollment.not-live (RENEW_LOOP), run on every pass of
# its waits for the box (cmd_new's session-id poll, box_wait). Nothing happens unless the box is
# the one enroll_box enrolled, the marker is there, and the back-off after a failed attempt has
# passed. The marker is the box's to write, so it is only a doorbell: tested with -e or -L and
# removed with rm -f, never read or opened, so a link or a FIFO there cannot make the host read a
# host file or hang; the old id is the host's own record. One attempt (reenroll_box), then one
# line in the box's renew.log: both ids, the same id when the enrollment was live after all, or
# the reason and the next try. Success removes the marker and resets the back-off, also when the
# id came back the same (a stray marker). A failure keeps the marker and waits 30 s, doubling to
# 600 s (the renew loop's cap, below the 900 s default lease), plus 0-9 s so that the boxes of one
# host that all saw the same outage do not all call at once; SECONDS measures it, and no pass
# sleeps. reenroll_box's stderr goes nowhere: the launcher's terminal is the box's, and the
# outcome is in the log line.
REENROLL_BACKOFF=30 REENROLL_AT=0
reenroll_if_not_live() {
    local box="$1" keydir old delay ok=0
    # No new attempt once cmd_new's HUP, TERM or INT trap has set `interrupted`: the box is
    # ending, and an attempt would cost a helper call, up to about 60 s of its close, and for a
    # box with no session id an enrollment that close_box then revokes at once.
    [[ "${interrupted:-0}" == 0 ]] || return 0
    [[ "$ENROLLED_BOX" == "$box" ]] || return 0
    keydir="$(box_keydir "$box")"
    [[ -e "$keydir/enrollment.not-live" || -L "$keydir/enrollment.not-live" ]] || return 0
    (( SECONDS >= REENROLL_AT )) || return 0
    old="$(cat "$RUN_BASE/$box/enrollment-id" 2>/dev/null || true)"
    reenroll_box "$box" 2>/dev/null && ok=1
    # The 2>/dev/null saves fd 2 and puts it back when reenroll_box returns. A hangup during the
    # call runs cmd_new's HUP trap there, and that return undoes the trap's `exec >/dev/null 2>&1`
    # for fd 2: stderr is the hung-up terminal again, a write to it fails with EIO, and set -e ends
    # the launcher before close_box's rm -rf. So the trap's redirect is made again here (hung_up
    # is cmd_new's, and unset for any other caller).
    [[ "${hung_up:-0}" == 0 ]] || exec >/dev/null 2>&1
    if (( ok )); then
        rm -f "$keydir/enrollment.not-live" 2>/dev/null || true
        REENROLL_BACKOFF=30 REENROLL_AT=0
        if [[ "$ENROLLED_ID" == "$old" ]]; then
            box_renew_log "$box" "agentbox: enrollment $old is live; $box not enrolled again"
        else
            box_renew_log "$box" "agentbox: $box enrolled again: enrollment $old -> $ENROLLED_ID"
        fi
    else
        delay=$(( REENROLL_BACKOFF + RANDOM % 10 ))
        REENROLL_AT=$(( SECONDS + delay ))
        REENROLL_BACKOFF=$(( REENROLL_BACKOFF * 2 < 600 ? REENROLL_BACKOFF * 2 : 600 ))
        box_renew_log "$box" "agentbox: enrolling $box again failed: ${ENROLL_ERROR//$'\n'/ }; next try in ${delay}s"
    fi
    return 0
}

# box_wait BOX CHILD: the launcher's wait for an enrolled box while CHILD, its `docker run` (a
# child of this shell), lives. Each pass runs reenroll_if_not_live, then waits for the child or
# 10 s, whichever ends first, so a box that ends is closed at once and a renew refused as not
# live is acted on within 10 s. A trapped HUP, TERM or INT ends the wait with 128+n and its trap
# acts at once, as in the blocking `wait`; the loop goes on while the child lives. `wait -n` with
# ids needs bash 5.1 (the hosts run 5.2). Returns once the child has exited; `wait "$child"`
# still returns the child's own status afterwards.
box_wait() {
    local box="$1" child="$2" sleep_pid
    while kill -0 "$child" 2>/dev/null; do
        reenroll_if_not_live "$box"
        sleep 10 &
        sleep_pid=$!
        wait -n "$child" "$sleep_pid" || true
        kill "$sleep_pid" 2>/dev/null || true
        wait "$sleep_pid" || true
    done
}

# Enroll a box from `new` once it is up, then start its renew: for omp once its session id is
# known (omp opens its session file 4–10 s after start, before any tool can run), so the
# enrollment carries the id the broker wakes on a decision; any other command at once; after
# 120 s of running without a session id (an omp --no-session run) without one. The deadline
# starts once the box is Running, so a box that was slow to start still enrolls with its id. The
# enrollment.pending marker is renewed on every pass of both waits, so it stays inside the
# client's 160 s trust window however long the box takes. A box that never runs, or ends first,
# ends in enroll_failed too.
enroll_when_up() {
    local box="$1" child="$2" cmd="$3" sid="" deadline
    wait_for_running "$box" "$child" || { enroll_failed "$box" "$box never reached Running; not enrolled"; return 1; }
    deadline=$(( SECONDS + 120 ))
    while kill -0 "$child" 2>/dev/null; do
        put_keyfile "$box" enrollment.pending ""
        [[ "$cmd" == omp ]] && sid="$(box_session_id "$box")"
        if [[ "$cmd" != omp || -n "$sid" ]] || (( SECONDS >= deadline )); then
            enroll_box "$box" "$sid" || return 1
            start_renew "$box" || echo "agentbox: renew start for $box failed; its enrollment lapses within 15 min" >&2
            return 0
        fi
        sleep 2
    done
    enroll_failed "$box" "$box ended before it was enrolled"
}

# How long a session's enrollment is held for the box that comes back with it. A move's respawn
# takes well under a minute, and the broker ends an enrollment nothing renews within 15 minutes
# anyway, so this only decides how much of that window a session that has really ended keeps.
AGENTBOX_UNENROLL_GRACE="${AGENTBOX_UNENROLL_GRACE:-180}"

# Revoke a box's enrollment and every grant under it: the id the host recorded at enrollment,
# never the box-writable copy. Idempotent on the broker; a failure is noted, and the lease the
# box stopped renewing lapses within 15 minutes.
# A SESSION's enrollment (enroll_box, when the box had an omp session id) is not this box's to
# end: revoking it ends the id every box of the session signs with. The broker keeps the
# session's pending requests and grants dormant for its carry (12 h by default) and hands them to
# the session's next enrollment (broker enroll.go endEnrollment, adopt), but a move must keep the
# id itself. So it goes to a detached waiter that gives the session its grace to come back in
# another box and ends the enrollment only if none did. Detached because close_box runs in the
# pane the respawn is taking back, and nothing may wait here.
#
# The waiter has TWO tests, because the first one alone is blind to the box that enrolled
# BEFORE this one. `owner` holds the name of the last box that enrolled for the session, so
# when a DUPLICATE box of a live session ends, owner still names the duplicate and the waiter
# reads that as "nobody came back" - at 20:17Z on 2026-11-04 it ended the enrollment of a
# session that was running the whole time in its ORIGINAL box, which lost its broker identity
# three minutes after the duplicate closed and noticed 25 minutes later, when its last cached
# GitHub token expired. The enrollment is the SESSION's (runtime id `session-<id>`), not the
# box's, so any live box of that session is using it. The second test asks exactly that
# (`session-live-box`, below), at wake time rather than now, since a box can come up during the
# grace.
unenroll_box() {
    local box="$1" eid sid="" skd
    [[ -s "$RUN_BASE/$box/enrollment-id" ]] || return 0
    eid="$(<"$RUN_BASE/$box/enrollment-id")"
    if [[ -s "$RUN_BASE/$box/enrollment-session" ]]; then
        sid="$(<"$RUN_BASE/$box/enrollment-session")"
    fi
    if [[ -z "$sid" ]]; then
        AGENT_SECRETS_URL="$AGENT_SECRETS_URL" agent-secrets unenroll --helper --enrollment "$eid" \
            || echo "agentbox: unenroll $box ($eid) failed; the broker drops it when its lease lapses (15 min)" >&2
        return 0
    fi
    skd="$(session_keydir "$sid")"
    setsid env AGENT_SECRETS_URL="$AGENT_SECRETS_URL" bash -c '
        sleep "$1"
        [[ "$(cat "$2/owner" 2>/dev/null)" == "$3" ]] || {
            echo "$(date -u +%FT%TZ) $3: session $4 came back in $(cat "$2/owner" 2>/dev/null); enrollment $5 left alone"
            exit 0
        }
        if live="$("$6" session-live-box "$4" "$3" 2>/dev/null)" && [[ -n "$live" ]]; then
            echo "$(date -u +%FT%TZ) $3: session $4 is live in box $live; enrollment $5 left alone"
            exit 0
        fi
        rm -rf "${2:?}"
        echo "$(date -u +%FT%TZ) $3: session $4 did not come back; ending enrollment $5"
        agent-secrets unenroll --helper --enrollment "$5" \
            || echo "$(date -u +%FT%TZ) $3: unenroll $5 failed; the broker drops it when its lease lapses (15 min)"
    ' agentbox-unenroll "$AGENTBOX_UNENROLL_GRACE" "$skd" "$box" "$sid" "$eid" \
        "$DOTFILES_DIR/scripts/agentbox" \
        </dev/null >>"$RUN_BASE/session-keys/unenroll.log" 2>&1 &
    return 0
}

# session_live_box SID EXCEPT: the name of a box other than EXCEPT that enrolled for session SID
# and whose container still exists, or nothing. The run directory of every box holds the session
# it enrolled for (`enrollment-session`, written by enroll_box) and is removed with the box, so
# this is the host's own record of who is using the session's broker identity.
session_live_box() {
    local sid="$1" except="${2:-}" d box
    [[ -n "$sid" && -d "$RUN_BASE" ]] || return 1
    for d in "$RUN_BASE"/*/; do
        box="$(basename "$d")"
        [[ "$box" == "$except" || "$box" == session-keys ]] && continue
        [[ -s "$d/enrollment-session" ]] || continue
        [[ "$(<"$d/enrollment-session")" == "$sid" ]] || continue
        [[ -n "$(docker ps -a --filter "name=^${box}\$" --format '{{.Names}}' 2>/dev/null)" ]] || continue
        printf '%s\n' "$box"
        return 0
    done
    return 1
}

# Run a command as a fresh process under the user manager: a child of systemd --user, inside
# no registered host session. What a check of the helper's refusal, or of a brand-new
# registration, needs when the caller itself runs inside an agent session. The unit
# environment carries nothing of ours, so the broker, socket and a PATH holding the real
# binary (a mise shim cannot run there) are passed explicitly.
fresh_process() {
    local bin_dir
    bin_dir="$(mise where agent-secrets)/bin" || return 1
    systemd-run --user --pipe --wait --quiet --collect \
        --setenv="AGENT_SECRETS_URL=$AGENT_SECRETS_URL" \
        --setenv="AGENT_SECRETS_HELPER_SOCK=/run/user/$UID_/agent-secrets/helper.sock" \
        --setenv="PATH=$bin_dir:/usr/local/bin:/usr/bin:/bin" \
        -- "$@"
}

# The canonical checkouts, one name per line: each entry of $SRC that holds a .git. Hidden entries
# and plain directories there (~/src/.cloudflare, ~/src/.hawk-token) are not checkouts.
repos() {
    local d
    for d in "$SRC"/*; do
        [[ -d "$d" && -e "$d/.git" ]] && printf '%s\n' "${d##*/}"
    done | sort
}

# Image tag is the content hash of what builds it, so an edit to any image
# input yields a new tag built on the next launch; running boxes on the old
# tag are listed by `rebuild` and move when their sessions restart.
image_tag() {
    local h
    h="$(cat "$DOTFILES_DIR/agentbox/Dockerfile" "$DOTFILES_DIR/agentbox/entrypoint.sh" \
        "$DOTFILES_DIR/agentbox/box-ssh-config" "$DOTFILES_DIR/agentbox/agentbox_sandbox_skips.py" | sha256sum | cut -c1-12)"
    echo "agentbox:$h"
}

build_image() {
    local tag="$1"
    if [[ -z "$(docker image ls -q "$tag")" ]]; then
        echo "agentbox: building $tag" >&2
        # buildx with the default builder: ~/.docker/config.json may alias
        # `docker build` to depot, which needs a project this image has none of.
        docker buildx build --builder default --load -t "$tag" "$DOTFILES_DIR/agentbox" >&2
    fi
}

ensure_network() {
    docker network inspect "$NETWORK" >/dev/null 2>&1 || docker network create "$NETWORK" >/dev/null
    # omp-embed (installers/omp-embed.sh) serves mnemopi embeddings for every
    # session on the machine; boxes reach it by name on this network.
    if docker inspect "$EMBED_NAME" >/dev/null 2>&1 \
        && ! docker inspect -f '{{json .NetworkSettings.Networks}}' "$EMBED_NAME" | grep -q "\"$NETWORK\""; then
        docker network connect "$NETWORK" "$EMBED_NAME"
    fi
    NETWORK_GATEWAY="$(docker network inspect -f '{{(index .IPAM.Config 0).Gateway}}' "$NETWORK")"
    NETWORK_SUBNET="$(docker network inspect -f '{{(index .IPAM.Config 0).Subnet}}' "$NETWORK")"
    [[ -n "$NETWORK_GATEWAY" && -n "$NETWORK_SUBNET" ]] || die "network $NETWORK has no IPv4 gateway/subnet"
}

# Host forwarders as transient user units, restarted if socat dies. TCP ones
# bind the box network's gateway and admit only that network; unix ones are
# 0600 sockets under $RUN_BASE.
start_unit() {
    local unit="$1" err; shift
    systemctl --user is-active --quiet "$unit" && return 0
    systemctl --user reset-failed "$unit" 2>/dev/null || true
    err="$(systemd-run --user --unit "$unit" --quiet --collect --property=Restart=always --property=RestartSec=1 "$@" 2>&1)" && return 0
    # The `is-active` above asks the user manager, and on a loaded box that answer times out
    # ("Failed to retrieve unit state: Connection timed out", measured 2026-11-01 at load 410):
    # a forwarder another box already started then looks absent, systemd-run refuses it as
    # already loaded, and a launch died on a unit that was running the whole time
    # (dispatch://INFRA-950). These units are shared between boxes, so ask once more, and leave
    # the verdict to the socket or the port the caller waits for.
    systemctl --user is-active --quiet "$unit" && return 0
    [[ -n "$err" ]] && echo "agentbox: $unit: $err" >&2
    return 1
}

wait_for() {
    local _
    for _ in $(seq 1 20); do
        "$@" && return 0
        sleep 0.25
    done
    return 1
}

ensure_tcp_forwarder() {
    local unit="$1" port="$2" target="$3"
    # A forwarder already running toward another address is stopped first: forward's channels
    # move between this host's two loopback addresses when its config changes, and a unit
    # started before that would relay every box to an address nothing listens on.
    if systemctl --user is-active --quiet "$unit" \
        && ! systemctl --user show -p ExecStart --value "$unit" 2>/dev/null | grep -qF "TCP4:$target"; then
        systemctl --user stop "$unit" 2>/dev/null || true
    fi
    start_unit "$unit" socat "TCP4-LISTEN:$port,bind=$NETWORK_GATEWAY,range=$NETWORK_SUBNET,fork,reuseaddr" "TCP4:$target" || true
    wait_for bash -c "ss -ltn 'sport = :$port' | grep -q '$NETWORK_GATEWAY:$port'" \
        || die "forwarder $unit did not bind $NETWORK_GATEWAY:$port (journalctl --user -u $unit)"
}

# $4 = "optional": return 1 instead of ending the launch. A box cannot work without the session
# bus; it can work without the host's tmux.
ensure_unix_forwarder() {
    local unit="$1" sock="$2" target="$3" optional="${4:-}"
    # A unit already relaying somewhere else is stopped first, as the TCP one is: the host's
    # tmux socket path follows TMUX_TMPDIR, and a stale unit would relay every box to a socket
    # nothing listens on.
    if systemctl --user is-active --quiet "$unit" \
        && ! systemctl --user show -p ExecStart --value "$unit" 2>/dev/null | grep -qF "UNIX-CONNECT:$target"; then
        systemctl --user stop "$unit" 2>/dev/null || true
    fi
    mkdir -p "$(dirname "$sock")"
    # The socket is the verdict, not the unit's start: a start that failed because the unit was
    # already there leaves a working relay behind it (start_unit).
    start_unit "$unit" socat "UNIX-LISTEN:$sock,fork,mode=600,unlink-early" "UNIX-CONNECT:$target" || true
    if ! wait_for test -S "$sock"; then
        [[ -n "$optional" ]] && return 1
        die "forwarder $unit did not open $sock (journalctl --user -u $unit)"
    fi
    return 0
}

# The host's tmux server, for a lead that drives other sessions' panes (`tmux new-window`,
# `send-keys`, `capture-pane`, `list-panes`). It needs a relay, exactly as the session bus does,
# and for the same reason: Sysbox maps the box onto a subordinate uid range, and the tmux server
# refuses a client whose SO_PEERCRED uid is not its own. Measured 2026-11-01 in a throwaway box
# with the host's socket bind-mounted directly: connect(2) succeeded (Sysbox id-maps the bind,
# so the node is the box user's) and every tmux command answered `access not allowed`, exit 1.
# Through this relay, which connects onward as the user, the server sees the user. tmux's
# non-attaching commands survive a relay - measured on the host, `display-message -p
# '#{version}'` through a socat UNIX-LISTEN/UNIX-CONNECT pair answered 3.8 - which is what a
# lead uses; attaching inside a box is not a thing anyone does, since the box has no terminal of
# the host's.
#
# WHAT THIS GIVES A BOX, stated plainly: control of the host's tmux server. A box can read any
# pane (`capture-pane`), type into any pane (`send-keys`, which in a pane at a shell is a
# command as the host user, outside the box's cgroup and disk limit), respawn or kill any pane,
# and `kill-server`, which would end every agent pane on the machine. It is given because the
# relayed session bus already reaches the host's systemd user manager, so a box can already
# `systemctl --user restart` the host's services (agentbox/AGENTS.md), and because a lead that
# cannot drive panes cannot be boxed at all - which would leave the coordination sessions, the
# heaviest on the host, outside every limit this work exists to apply.
#
# The relay is ONE unit shared by every box on the host, so it always points at the host's
# DEFAULT tmux server, never at the server a launch happens to come from: on 2026-11-02 one
# `agentbox new` from a drill's `tmux -L devbox-drill` pane re-pointed the unit, and from
# 17:18:45Z to 17:58Z every box's `tmux` reached that drill server instead of `agents`. The
# default server is the workspace server, $HOME/.tmux/sockets/tmux-<uid>/default (.bashrc's
# TMUX_TMPDIR; .tmux.conf restores the snapshot on that server only), whatever the caller's TMUX
# or TMUX_TMPDIR: on 2026-11-03 a server at /tmp/tmux-1000/default, also named `default`, was
# started by a `tmux new-session` run without TMUX_TMPDIR, and a launch from it would have
# relayed every box there. AGENTBOX_TMUX_SOCK overrides, and a host with no workspace server
# gets no relay and no mount.
# Inside, it is TMUX_TMPDIR/tmux-<box uid>/default, which is where a bare `tmux` looks: the box
# user is uid 1000 by the image (agentbox/Dockerfile), whatever the host's uid.
BOX_UID=1000
HOST_TMUX_SOCK=""
host_tmux_sock() {
    HOST_TMUX_SOCK="${AGENTBOX_TMUX_SOCK:-$HOME/.tmux/sockets/tmux-$UID_/default}"
    [[ -S "$HOST_TMUX_SOCK" ]] || HOST_TMUX_SOCK=""
}

# The pane's tmux identity for the box, as `-e` and `NAME=VALUE` lines (session_env). TMUX is
# `<socket>,<server pid>,<session index>`; the box gets the relay's path in the socket field, so
# its tmux reaches the host's default server. Only a launch FROM that server gets it, and only
# that launch gets TMUX_PANE: a pane id is a pane of one server, and %0 of a `-L` server is
# another session's pane on the default one, which a box's `move --self` or `move --to` rollback
# would respawn. A launch from any other server keeps its own TMUX, which does not resolve in
# the box (omp only needs to know it is under tmux), and no pane, and is told so.
box_tmux_env() {
    [[ -n "${TMUX:-}" ]] || return 0
    host_tmux_sock
    local caller="${TMUX%%,*}"
    if [[ -n "$HOST_TMUX_SOCK" && "$(readlink -f "$caller" 2>/dev/null)" == "$(readlink -f "$HOST_TMUX_SOCK")" ]]; then
        printf -- '-e\nTMUX=/run/user/%s/tmux/tmux-%s/default,%s\n' "$UID_" "$BOX_UID" "${TMUX#*,}"
        [[ -n "${TMUX_PANE:-}" ]] && printf -- '-e\nTMUX_PANE=%s\n' "$TMUX_PANE"
        return 0
    fi
    printf -- '-e\nTMUX=%s\n' "$TMUX"
    echo "agentbox: this launch is under tmux server $caller, not the host's default (${HOST_TMUX_SOCK:-none found}), which is the only server a box's tmux reaches; this box gets no TMUX_PANE, so it cannot drive or respawn its own pane" >&2
}
# One socket per BOX, not one for the host, and it no longer carries tmux's own protocol: the
# box's end is answered by scripts/agentbox-tmux-guard, which runs the command with the HOST's
# tmux client and refuses `kill-server` and any kill aimed at a pane the box does not own
# (dispatch://INFRA-1192; at 16:53:58Z on 2026-11-04 the host server died and took every pane on
# this machine with it).
#
# WHY NOT A FILTER IN FRONT OF THE SOCKET. tmux's client/server protocol is binary imsg frames
# whose command type is an `enum msgtype` value that moves between releases, and the client
# hands the server descriptors over SCM_RIGHTS; a byte filter would have to parse that and
# follow both ends' versions. The guard speaks one line per argument instead, which also ends
# the version coupling that stopped a boxed move on 2026-11-03 (the image's tmux 3.4 against
# this host's 3.8): the client that talks to the server is now always the host's own.
#
# THE BOX IS IDENTIFIED BY THE SOCKET IT REACHES, never by anything it says: the socket is 0600
# under $RUN_BASE/<box>, bind-mounted into that box alone, and the unit's environment carries
# the box's name and the pane the box was launched from. The box cannot see another box's
# socket and cannot write this unit.
#
# A GUARD, NOT A BOUNDARY. The relayed session bus already gives a box the host's systemd user
# manager, so a box that means to can start a relay of its own; and `send-keys` into a pane at a
# shell runs a command as the host user. Boxes are segregation, not isolation (Sami,
# dispatch://INFRA-702/comment/41bdfb9d). This stops the accident, which is what took the
# machine down.
box_tmux_dir() { echo "$RUN_BASE/$1/tmux"; }
tmux_guard_bin() { echo "${AGENTBOX_TMUX_GUARD_BIN:-$DOTFILES_DIR/scripts/agentbox-tmux-guard}"; }
ensure_tmux_forwarder() {
    local box="${1:-}" sock unit guard
    [[ -n "$box" ]] || return 0
    host_tmux_sock
    [[ -n "$HOST_TMUX_SOCK" ]] || return 0
    guard="$(tmux_guard_bin)"
    [[ -x "$guard" ]] || { echo "agentbox: $guard is not executable; this box gets no host tmux" >&2; return 0; }
    sock="$(box_tmux_dir "$box")/tmux-$BOX_UID/default"
    unit="agentbox-tmux-$box"
    mkdir -p -m 700 "$(dirname "$sock")"
    # NEVER fatal. The session bus and the metadata service are what a box cannot work without;
    # the host's tmux is what a LEAD wants, and a box with no relay is still a usable box. Under
    # load this host's `systemd-run` times out on the bus (measured 2026-11-01 at load 300+,
    # "Failed to start transient service unit: Connection timed out"), and a launch must not die
    # of that.
    #
    # `nofork` hands the accepted connection to the guard as its own stdin and stdout, so the
    # guard owns the conversation and nothing relays bytes it has not read.
    start_unit "$unit" \
        --setenv=AGENTBOX_GUARD_BOX="$box" \
        --setenv=AGENTBOX_GUARD_PANE="${TMUX_PANE:-}" \
        --setenv=AGENTBOX_GUARD_SOCK="$HOST_TMUX_SOCK" \
        --setenv=AGENTBOX_GUARD_STATE="$RUN_BASE/$box" \
        --setenv=AGENTBOX_GUARD_TMUX="${AGENTBOX_TMUX_CLIENT:-}" \
        socat "UNIX-LISTEN:$sock,fork,mode=600,unlink-early" "EXEC:$guard,nofork" || true
    wait_for test -S "$sock" \
        || echo "agentbox: the host tmux relay did not start; this box has no host tmux (journalctl --user -u $unit)" >&2
    return 0
}
# The relay unit is the box's own, so it goes when the box does; $RUN_BASE/<box> (the guard's
# state: the panes the box created, its log) is removed by close_box just after this.
stop_tmux_forwarder() {
    systemctl --user stop "agentbox-tmux-$1" >/dev/null 2>&1 || true
    systemctl --user reset-failed "agentbox-tmux-$1" >/dev/null 2>&1 || true
}

# Legacy SSH pairs need their configured loopback channels relayed into a box's
# own loopback. Tailnet addresses route directly and must not be bound in the box.
# Match each role-specific endpoint against live listeners, including custom
# ports outside 128xx; the port-only gateway cannot relay two addresses per port.
FORWARD_CHANNELS=()
forward_channels() {
    local channels
    FORWARD_CHANNELS=()
    if [[ "${XDG_CONFIG_HOME:-$HOME/.config}" != "$HOME/.config" ]]; then
        echo "agentbox: XDG_CONFIG_HOME must be unset or exactly $HOME/.config; Forward's user units and agent boxes use ~/.config/forward." >&2
        return 1
    fi
    channels="$(python3 - "$HOME/.config/forward/config.toml" "$ENVOY_PORT" "$IMDS_PORT" "${LOOPBACK_SERVICE_PORTS[*]}" <<'PY'
import ipaddress
from pathlib import Path
import subprocess
import sys
import tomllib

path = Path(sys.argv[1])
try:
    try:
        config = tomllib.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        sys.exit(0)
    addresses = {}
    for key, default in (("listen", "127.0.0.1"), ("peer", "")):
        value = config.get(key, default)
        if not value:
            continue
        address = ipaddress.ip_address(value)
        if address.version == 4 and address.is_loopback:
            addresses[key] = str(address)
    wanted = set()
    if "listen" in addresses:
        wanted.add(f"{addresses['listen']}:12802")  # File preview is not configurable.
    if "peer" in addresses:
        wanted.add(f"{addresses['peer']}:12800")  # URL channel is not configurable.
    for role, key, default in (
        ("listen", "bridge_port", 12801),
        ("listen", "grant_port", 12805),
        ("peer", "relay_port", 12803),
        ("peer", "pcsc_port", 12804),
        ("peer", "pulse_port", 12806),
    ):
        port = config.get(key, default)
        if type(port) is not int or not 0 <= port <= 65535:
            raise ValueError(f"{key} must be an integer port from 0 to 65535")
        if port and role in addresses:
            wanted.add(f"{addresses[role]}:{port}")
    if wanted:
        listeners = subprocess.check_output(["ss", "-Hltn"], text=True)
        found = {fields[3] for line in listeners.splitlines() if len(fields := line.split()) >= 4}
        routes = {}

        def claim(port, target):
            previous = routes.get(port)
            if previous is not None and previous != target:
                raise ValueError(f"{previous} and {target} share gateway port {port}; the port-only agentbox forwarder cannot relay both; configure distinct channel ports")
            routes[port] = target
            return previous is None

        envoy_port, imds_port = sys.argv[2:4]
        claim(envoy_port, f"127.0.0.1:{envoy_port}")
        claim(imds_port, "metadata service")
        service_ports = set(sys.argv[4].split())
        for endpoint in sorted(found):
            host, _, port = endpoint.rpartition(":")
            if port in service_ports and host.startswith("127.0.0."):
                claim(port, endpoint)
        channels = []
        for channel in sorted(wanted & found):
            if claim(channel.rsplit(":", 1)[1], channel):
                channels.append(channel)
        for channel in channels:
            print(channel)
except (OSError, ValueError, subprocess.SubprocessError) as error:
    sys.exit(f"agentbox: cannot discover forward channels from {path}: {error}; fix the serve config or rerun installers/forward.sh serve.")
PY
)" || return 1
    if [[ -n "$channels" ]]; then
        mapfile -t FORWARD_CHANNELS <<<"$channels"
    fi
}

ensure_forward_channels() {
    local channel
    forward_channels || return 1
    for channel in "${FORWARD_CHANNELS[@]}"; do
        ensure_tcp_forwarder "agentbox-fwd-${channel##*:}" "${channel##*:}" "$channel"
    done
}

# Host services that are not forward's but listen on this host's loopback all the same, by port.
# Each one that has a listener gets exactly what a forward channel gets: a forwarder on the box
# network's gateway (agentbox-loopback-<port>) and, through AGENTBOX_FORWARD_CHANNELS, a relay in
# the box on the same address and port, so a session reaches it at the address it uses on the
# host. A port with no listener is skipped, so a host without the service starts its boxes
# without it. 5005 is the OSS Verify MLflow tracking server: the machine-local unit
# ossv-mlflow-tunnel.service holds an IAP tunnel to VM ossv-mlflow on 127.0.0.1:5005, and on
# 2026-11-02 every route to it from a box failed and two lanes waited on it - the box's own
# loopback, the box network's gateway, docker0's 172.17.0.1, and the tailnet (`tailscale serve`'s
# :8449 listener is bound to the tailscale0 device, so a packet from a box bridge never reaches
# it). 5432 is the Cloud SQL Auth Proxy to agents-postgres
# (omp/cloud-sql-proxy-agents-postgres.service): omp's session store writes a session's transcript
# to the omp_sessions database through it (dispatch://INFRA-1192), and the DSN names 127.0.0.1:5432,
# so the relay has to put the listener back on that exact address for one DSN to serve the host and
# every box. The instance takes no raw TCP from here at all - measured 2026-11-04, its public
# 136.117.143.83 and its private 10.54.0.8 both refuse 5432 and 6432 from the host and from inside a
# box - so the proxy, and this relay, are the whole route. AGENTBOX_LOOPBACK_PORTS (space-separated
# ports) replaces the list.
read -r -a LOOPBACK_SERVICE_PORTS <<<"${AGENTBOX_LOOPBACK_PORTS-5005 5432}"
LOOPBACK_SERVICES=()
loopback_services() {
    LOOPBACK_SERVICES=()
    (( ${#LOOPBACK_SERVICE_PORTS[@]} )) || return 0
    local ports
    ports="$(IFS='|'; echo "${LOOPBACK_SERVICE_PORTS[*]}")"
    mapfile -t LOOPBACK_SERVICES < <(
        ss -Hltn | awk '{ print $4 }' | grep -E "^127\.0\.0\.[0-9]+:($ports)\$" | sort -u
    )
}

# Not fatal, as the tmux relay is not: a box works without MLflow, and a launch must not die of it.
ensure_loopback_services() {
    local service port
    loopback_services
    for service in ${LOOPBACK_SERVICES[@]+"${LOOPBACK_SERVICES[@]}"}; do
        port="${service##*:}"
        ( ensure_tcp_forwarder "agentbox-loopback-$port" "$port" "$service" ) \
            || echo "agentbox: the relay of host service $service did not start; this box cannot reach it (journalctl --user -u agentbox-loopback-$port)" >&2
    done
    return 0
}

# This machine's own `tailscale serve` listeners, which a box cannot reach: each is bound to the
# tailnet address ON the tailscale0 device (`100.112.105.63%tailscale0:8448`), so a packet that
# arrives over a box bridge is not accepted even though it reaches the host. Sessions verify
# their dashboards by the tailnet URL and read the refusal as the service being down (2026-11-04:
# curl to :8448 answered 000 in every box and 200 on the host). Each serve port gets a relay on
# the box network's gateway, and the box resolves this machine's tailnet names to that gateway
# (box_tailnet_hosts), so the URL works unchanged and TLS still verifies: the relay carries raw
# TCP, the handshake is with the real serve listener, and the name is the one on its certificate.
# Only the ports `tailscale serve` itself reports: tailscale's own ephemeral peerapi listener is
# on that device too and is no one's service.
# Boxes are for segregation, not isolation (Sami, dispatch://INFRA-702, 2026-11-04 00:50Z): a box
# reaches what the host reaches.
TAILNET_ADDRESS=""
TAILNET_NAMES=()
TAILNET_SERVE_PORTS=()
tailnet_serve() {
    TAILNET_ADDRESS=""
    TAILNET_NAMES=()
    TAILNET_SERVE_PORTS=()
    command -v tailscale >/dev/null 2>&1 || return 0
    local status
    status="$(timeout 10 tailscale status --json 2>/dev/null)" || return 0
    [[ -n "$status" ]] || return 0
    TAILNET_ADDRESS="$(jq -r '[.Self.TailscaleIPs // [] | .[] | select(test(":") | not)][0] // ""' <<<"$status")"
    [[ -n "$TAILNET_ADDRESS" ]] || return 0
    mapfile -t TAILNET_NAMES < <(
        jq -r '.Self.DNSName // "" | sub("\\.$"; "") | select(. != "")' <<<"$status"
        jq -r '.Self.DNSName // "" | sub("\\..*$"; "") | select(. != "")' <<<"$status"
    )
    mapfile -t TAILNET_SERVE_PORTS < <(
        timeout 10 tailscale serve status --json 2>/dev/null \
            | jq -r '(.TCP // {}) | keys[]' 2>/dev/null | sort -un
    )
}

# Not fatal: a box works without the host's dashboards, and a launch must not die of one.
ensure_tailnet_serve() {
    local port
    tailnet_serve
    [[ -n "$TAILNET_ADDRESS" ]] || return 0
    for port in ${TAILNET_SERVE_PORTS[@]+"${TAILNET_SERVE_PORTS[@]}"}; do
        ( ensure_tcp_forwarder "agentbox-tailnet-$port" "$port" "$TAILNET_ADDRESS:$port" ) \
            || echo "agentbox: the relay of this machine's tailnet port $port did not start; this box cannot reach it (journalctl --user -u agentbox-tailnet-$port)" >&2
    done
    return 0
}

# `docker run --add-host` arguments: this machine's tailnet names, resolved in the box to the
# gateway the relays above listen on. Every other host service is reachable there already, since
# the gateway address is the host's (sshd binds 0.0.0.0), so the name keeps working for all of
# them; a tailnet name of ANOTHER machine is untouched and still goes over the tailnet.
box_tailnet_hosts() {
    local name
    [[ -n "$TAILNET_ADDRESS" && -n "$NETWORK_GATEWAY" ]] || return 0
    for name in ${TAILNET_NAMES[@]+"${TAILNET_NAMES[@]}"}; do
        printf '%s\n' "--add-host" "$name:$NETWORK_GATEWAY"
    done
}

# $1 is the box this launch is for, where there is one: its tmux relay is its own. `doctor`'s
# host check passes none and gets the shared forwarders alone.
ensure_forwarders() {
    local box="${1:-}"
    if "$DOTFILES_DIR/scripts/on-google-vm" 2>/dev/null; then
        # Google's metadata server refuses a Host header naming the relay, so a byte relay will
        # not do: scripts/agentbox-gce-metadata-relay rewrites it.
        local relay="$DOTFILES_DIR/scripts/agentbox-gce-metadata-relay"
        if systemctl --user is-active --quiet agentbox-imds \
            && ! systemctl --user show -p ExecStart --value agentbox-imds 2>/dev/null | grep -qF "$relay"; then
            systemctl --user stop agentbox-imds 2>/dev/null || true
        fi
        start_unit agentbox-imds python3 "$relay" "$NETWORK_GATEWAY" "$IMDS_PORT" "$NETWORK_SUBNET" || true
        wait_for bash -c "ss -ltn 'sport = :$IMDS_PORT' | grep -q '$NETWORK_GATEWAY:$IMDS_PORT'" \
            || die "forwarder agentbox-imds did not bind $NETWORK_GATEWAY:$IMDS_PORT (journalctl --user -u agentbox-imds)"
    else
        ensure_tcp_forwarder agentbox-imds "$IMDS_PORT" 169.254.169.254:80
    fi
    ensure_tcp_forwarder agentbox-envoy "$ENVOY_PORT" "127.0.0.1:$ENVOY_PORT"
    ensure_unix_forwarder agentbox-bus "$BUS_SOCK" "/run/user/$UID_/bus"
    ensure_tmux_forwarder "$box"
    ensure_forward_channels || return 1
    ensure_loopback_services
    ensure_tailnet_serve
}

# The allow-list, as docker -v arguments. rw dirs are created on the host
# first so docker never creates them root-owned; symlinked entries (the
# dotfiles' config files) are bound by target so the box sees content, not a
# link into an unmounted path.
mount_args() {
    local box="$1" a=() p src
    # --no-host-writes: this box may not write anything another lane can see. The two disks
    # every box gets are the ones to take away first -- ~/src and /mnt/durable/<user> are host
    # binds in EVERY box, so a sandboxed copy with its tools on writes real files there, which
    # is how an eval harness overwrote four lanes' trees on 2026-11-08 (dispatch://BET-831).
    # $SRC moves to an empty per-box directory rather than being dropped: the bind is
    # unconditional below and "$SRC" empty would hand docker `-v ":"`, and pointing it
    # elsewhere leaves /home/<user>/src unbound, so it is the box's own private home and a
    # write there dies with the box. A --dir is the explicit way back to one writable host path.
    if $NO_HOST_WRITES; then
        SRC="$BOXES/$box/empty-src"
        DURABLE_DIR=""
        mkdir -p "$SRC"
    fi
    # Made here, as the user, when absent (a new machine): docker would make a missing bind source
    # as root, and nothing the user runs could then write under it (sami-devbox, 2026-11-02).
    mkdir -p "$SRC"
    a+=(-v "$SRC:$SRC")
    # $SRC may hold symlinks to checkouts elsewhere (~/src/dotfiles → ~/.dotfiles);
    # each target is mounted at its own path so the link resolves inside. A target on the durable
    # disk (a tree moved to src-cold) is in the box through that disk's bind below, and binding it
    # again stacked 71 more mounts on top of it (2026-11-02).
    for p in "$SRC"/*; do
        [[ -L "$p" ]] || continue
        src="$(readlink -f "$p")"
        [[ -n "$DURABLE_DIR" ]] && move_within "$src" "$DURABLE_DIR" && continue
        a+=(-v "$src:$src")
    done
    # What the --dir flags come to (BOX_MOUNTS, add_box_dir): each named directory the box does
    # not already have at that path, plus the git object store of every tree one of them is in.
    # Docker nests binds by destination whatever their order here, so one under $SRC or under a
    # listed home path mounts on top of it; one anywhere else is the only way that path reaches
    # the box. A path the box already binds is NOT in this list, because docker refuses two
    # mounts at one destination and ends the launch.
    for p in ${BOX_MOUNTS[@]+"${BOX_MOUNTS[@]}"}; do
        a+=(-v "$p:$p")
    done
    # The object stores the shared checkouts BORROW. A checkout under $SRC may keep its
    # objects elsewhere and name it in objects/info/alternates (the oss-verifier clones:
    # /mnt/nvme/<user>/oss-verifier/oss-verify-proofs-internal and -src). A box's own clone of
    # such a repository inherits that alternates file, so without the store the box has a
    # repository git refuses to read: the release owner's box on sami-devbox answered "unable to
    # normalize alternate object path" and it made a full clone of its own (23:47Z, 2026-11-03).
    local alt_file alt_line alt_dir
    local -A alt_seen=()
    for alt_file in "$SRC"/*/.git/objects/info/alternates "$SRC"/*/.git/modules/*/objects/info/alternates; do
        [[ -r "$alt_file" ]] || continue
        while IFS= read -r alt_line; do
            [[ -n "$alt_line" && "$alt_line" != \#* ]] || continue
            case "$alt_line" in /*) alt_dir="$alt_line" ;; *) alt_dir="${alt_file%/info/alternates}/$alt_line" ;; esac
            alt_dir="$(readlink -f "$alt_dir" 2>/dev/null || true)"
            [[ -n "$alt_dir" && -d "$alt_dir" ]] || continue
            # The repository that holds the store, not its objects directory alone: a box that
            # reads the store also reads its config and packs through the same path.
            [[ "$alt_dir" == */objects ]] && alt_dir="${alt_dir%/objects}"
            [[ -z "${alt_seen[$alt_dir]:-}" ]] || continue
            alt_seen[$alt_dir]=1
            box_dir_have "$alt_dir" && continue
            a+=(-v "$alt_dir:$alt_dir")
        done <"$alt_file"
    done

    # The durable disk, whole (DURABLE_DIR). It holds what every box needs from it besides a
    # lane's staging and caches: the transcripts archived to omp-sessions-moved, behind symlinks
    # under ~/.omp/agent/sessions (without them a resumed omp exits `Session "<id>" not found`,
    # 2026-11-01, lane box h-dgn-t1), and the cold trees in nvme-cold and src-cold, behind
    # symlinks at their old paths (2026-11-02). A --dir or an object store under it is not in
    # BOX_MOUNTS (box_dir_bound_why, box_dir_have), so nothing here binds it twice.
    [[ -z "$DURABLE_DIR" ]] || a+=(-v "$DURABLE_DIR:$DURABLE_DIR")
    if [[ -n "$COMPUTE_INVENTORY" ]]; then
        mkdir -p "$COMPUTE_INVENTORY" || { echo "agentbox: cannot make $COMPUTE_INVENTORY, the compute ledger every box writes" >&2; return 1; }
        box_dir_have "$COMPUTE_INVENTORY" || a+=(-v "$COMPUTE_INVENTORY:$COMPUTE_INVENTORY")
    fi
    # The grading farm's three paths (FARM_PKG read-only, FARM_ROOT and FARM_BOXID read-write;
    # see them above), bound here as the durable disk is and for the same reason: a --dir that
    # names one, or a path under one, is recognised by box_dir_bound_why and so never reaches
    # BOX_MOUNTS, and docker refuses two mounts at one destination.
    [[ -z "$FARM_PKG" ]] || a+=(-v "$FARM_PKG:$FARM_PKG:ro")
    [[ -z "$FARM_ROOT" ]] || a+=(-v "$FARM_ROOT:$FARM_ROOT")
    [[ -z "$FARM_BOXID" ]] || a+=(-v "$FARM_BOXID:$FARM_BOXID")
    a+=(-v "$BOXES/$box:$BOXES/$box")
    # $HOME and /tmp inside the box's own directory, so the box's disk limit covers the two
    # places a session writes without being told where. Without them both land in the
    # container's writable layer, which is docker's data root on the shared disk and has no
    # limit of any kind here: a home path outside the allow-list is silently writable
    # (agentbox/AGENTS.md) and /tmp is where every tool puts its scratch. Docker nests binds by
    # destination, so every allow-listed path below still mounts on top of this $HOME, and the
    # startup prunes exact host mountpoints before assigning private home directories.
    mkdir -p "$BOXES/$box/home" "$BOXES/$box/tmp"
    chmod 1777 "$BOXES/$box/tmp"
    # When the box started, so close_box can tell what the session wrote in its home from what the
    # launch put there, and what the session's last box left in its home (box_home_carry).
    : >"$BOXES/$box/.started"
    seed_box_home "$box"
    local docker_source="${DOCKER_CONFIG:-$HOME/.docker}"
    local docker_snapshot="$BOXES/$box/docker-config" docker_links="$BOXES/$box/docker-binds"
    "$DOTFILES_DIR/scripts/agentbox-docker-snapshot" "$docker_source" "$docker_snapshot" "$docker_links" || return 1
    a+=(-v "$docker_snapshot:$HOME/.docker")
    local docker_target docker_alias docker_helper docker_invocation docker_logical docker_exec
    local docker_source_real helper_index=0 docker_box_dir docker_box_has
    docker_source_real="$(readlink -f "$docker_source" 2>/dev/null || true)"
    while IFS= read -r -d '' docker_target && IFS= read -r -d '' docker_alias; do
        a+=(-v "$docker_target:$docker_alias")
    done <"$docker_links"
    mkdir -p "$BOXES/$box/docker-helpers"
    a+=(-v "$BOXES/$box/docker-helpers:/opt/agentbox/docker-helpers")
    while IFS= read -r docker_helper; do
        # A helper the box's own PATH (session_env) already finds needs no wrapper. The launcher's
        # PATH can differ: a non-login launch on sami-devbox found snap's docker-credential-gcloud
        # first, which runs only as snap, so gcloud's helper failed in the box (2026-11-04).
        docker_box_has=false
        for docker_box_dir in "$DOTFILES_DIR/shims" "$DOTFILES_DIR/bin" "$HOME/.dotfiles/bin" \
            "$DOTFILES_DIR/scripts" "$HOME/.local/bin" "$HOME/.pulumi/bin"; do
            docker_invocation="$docker_box_dir/docker-credential-$docker_helper"
            [[ -x "$docker_invocation" ]] || continue
            docker_target="$(readlink -f "$docker_invocation")" || continue
            box_dir_have "$docker_invocation" && box_dir_have "$docker_target" && { docker_box_has=true; break; }
        done
        [[ "$docker_box_has" == true ]] && continue
        docker_invocation="$(command -v "docker-credential-$docker_helper" 2>/dev/null)" || continue
        [[ "$docker_invocation" == /* ]] || docker_invocation="$PWD/$docker_invocation"
        docker_target="$(readlink -f "$docker_invocation")" || continue
        [[ -f "$docker_target" ]] || continue
        docker_logical="$(readlink -f "${docker_invocation%/*}")/${docker_invocation##*/}"
        if [[ -n "$docker_source_real" ]] && move_within "$docker_logical" "$docker_source_real"; then
            docker_exec="$HOME/.docker/${docker_logical#"$docker_source_real"/}"
        elif box_dir_have "$docker_invocation" && box_dir_have "$docker_target"; then
            [[ "${docker_invocation%/*}" == "$HOME/.mise/shims" ]] && continue
            docker_exec="$docker_invocation"
        else
            docker_exec="/opt/agentbox/docker-helper-bin/$helper_index/${docker_invocation##*/}"
            (( helper_index += 1 ))
            a+=(-v "$docker_target:$docker_exec")
        fi
        printf '#!/bin/bash\nexec %q "$@"\n' "$docker_exec" >"$BOXES/$box/docker-helpers/docker-credential-$docker_helper"
        chmod 755 "$BOXES/$box/docker-helpers/docker-credential-$docker_helper"
    done < <(jq -r '[(.credHelpers // {} | .[]), (.credsStore // empty)] | unique | .[]' "$docker_snapshot/config.json" 2>/dev/null)
    a+=(-v "$BOXES/$box/home:$HOME")
    a+=(-v "$BOXES/$box/tmp:/tmp")
    local cache_mounts
    cache_mounts="$(box_cache_mounts "$box")" || return 1
    while IFS= read -r p; do a+=("$p"); done <<<"$cache_mounts"
    [[ "$DOTFILES_DIR" == "$SRC"/* || "$(readlink -f "$DOTFILES_DIR")" == "$(readlink -f "$HOME/.dotfiles")" ]] \
        || a+=(-v "$DOTFILES_DIR:$DOTFILES_DIR")
    a+=(-v "$HOME/.dotfiles:$HOME/.dotfiles")
    # The home allow-list is the surface a lane does not think of: about fifty rw entries bound
    # from the host home into every box, ~/.omp (every session's transcripts) and ~/.ssh among
    # them. Under --no-host-writes each is read-only, so the box still READS the logins and
    # settings it needs to work and can change none of them.
    local home_mode=""
    $NO_HOST_WRITES && home_mode=":ro"
    while read -r p; do
        if [[ ! -e "$HOME/$p" ]]; then
            case "$p" in .npmrc|.gitconfig) continue ;; esac
            mkdir -p "$HOME/$p"
        fi
        a+=(-v "$(readlink -f "$HOME/$p"):$HOME/$p$home_mode")
    done < <(mounts_of rw)
    while read -r p; do
        [[ -e "$HOME/$p" ]] || continue
        a+=(-v "$(readlink -f "$HOME/$p"):$HOME/$p:ro")
    done < <(mounts_of ro)
    # omp's runtime state under ~/.omp/run (daemon brokers, their sockets,
    # tokens and leases) holds for one PID and network namespace only: a
    # broker that starts deletes every sibling scope older than 5 minutes whose
    # pids it cannot see, and from another box it sees none. So each box gets
    # a private ~/.omp/run under its box dir, dying with it, while the rest of
    # ~/.omp stays shared. collab-hosts is bound back on top from the host so
    # `omp collab` discovery still spans the host and every box: its entries
    # and sockets live in that directory, and it prunes an entry only when its
    # socket is gone or refuses. Docker mounts by destination depth (~/.omp, then
    # ~/.omp/run, then collab-hosts); the host-side mkdirs make each
    # mountpoint the user's, 0700 like omp's own.
    mkdir -p -m 700 "$HOME/.omp/run" "$BOXES/$box/omp-run"
    mkdir -p -m 700 "$HOME/.omp/run/collab-hosts" "$BOXES/$box/omp-run/collab-hosts"
    a+=(-v "$BOXES/$box/omp-run:$HOME/.omp/run")
    a+=(-v "$HOME/.omp/run/collab-hosts:$HOME/.omp/run/collab-hosts")
    # A read-only ~/.omp would leave omp unable to write its own transcript, so under
    # --no-host-writes the session store is a private directory under the box, exactly as
    # ~/.omp/run is above. It dies with the box, which is the trade the flag makes: a run whose
    # record must survive passes a --dir and writes it there.
    if $NO_HOST_WRITES; then
        mkdir -p -m 700 "$BOXES/$box/omp-sessions"
        a+=(-v "$BOXES/$box/omp-sessions:$HOME/.omp/agent/sessions")
    fi
    # A per-box runtime dir owned by ubuntu (omp refuses a root-owned one), with
    # the host sockets bound at their usual paths. Never the host's whole
    # /run/user/$UID_. secretsd/ is the token dir the omp extension writes to;
    # created here so it is the user's, 0700, not a root-owned mountpoint.
    # agent-secrets/ holds the box's broker key (written by keygen inside the box) and its
    # enrollment id (written by the launcher, enroll_box): tmpfs, this box only, gone with it.
    # 0700 for the directory itself, not only its key dirs: a plain mkdir takes the launcher
    # umask, 002 in these sessions, and left it 0775 (all 20 live boxes on 2026-11-04 at
    # 22:13Z). secretsd refuses to start on a runtime directory other users may write
    # ("writable by other users"), so a boxed session that started its own secretsd got none.
    # The chmod stays beside the -m, since $RUN_BASE/$box may exist already from enroll_box.
    local run_user="$RUN_BASE/$box/run-user"
    mkdir -p -m 700 "$run_user"
    mkdir -p "$run_user/bus" "$run_user/forward" "$run_user/secretsd" "$run_user/envoy" "$run_user/agent-secrets"
    chmod 700 "$run_user" "$run_user/secretsd" "$run_user/agent-secrets"
    a+=(-v "$run_user:/run/user/$UID_")
    a+=(-v "$(dirname "$BUS_SOCK"):/run/user/$UID_/bus")
    [[ -S "$SECRETSD_SOCK" ]] || die "secretsd socket $SECRETSD_SOCK missing (systemctl --user status secretsd.socket)"
    a+=(-v "$SECRETSD_SOCK:$SECRETSD_SOCK")
    # forward's sockets (arming, browser grant, pulse) all live in forward/,
    # mounted as a directory: a restarted `forward serve` rebinds them, which
    # a directory mount shows at once and a mount of a socket file would not.
    # Created here so a box started before the serve still sees it later.
    mkdir -p -m 700 "/run/user/$UID_/forward"
    a+=(-v "/run/user/$UID_/forward:/run/user/$UID_/forward")
    # The host's cached NATS nkey seed (scripts/envoy-nats-seed), which an envoy.json
    # `natsSeed: "!$HOME/.dotfiles/scripts/envoy-nats-seed --value"` command run in a box
    # reads. A directory, so the rename a refresh does reaches a running box,
    # and so an in-box fetch, when the host had none, lands in the host's cache.
    mkdir -p -m 700 "/run/user/$UID_/envoy"
    a+=(-v "/run/user/$UID_/envoy:/run/user/$UID_/envoy")
    # The verified-grader stream's gateway key and the omp session-store DSN are shared writable.
    # The DSN (scripts/omp-session-dsn, dispatch://INFRA-1192) is the machine's, not the box's: it
    # names the machine's IAM database user and no password, and the proxy it points at is the
    # host's, relayed in on the same address (LOOPBACK_SERVICE_PORTS). A named --dir already
    # supplies the same destination, so avoid a duplicate bind. Directories show atomic refreshes.
    # /run/user/<uid>/ossv-box was here until 2026-11-04 and is not any more: the gateway providers
    # mint this machine's identity token per call through the metadata relay a box already has
    # (scripts/gateway-token), so there is no gateway credential file for a box to read
    # (dispatch://INFRA-993/comment/be112388).
    mkdir -p -m 700 "/run/user/$UID_/verified-grader" "/run/user/$UID_/omp-session-sql"
    local key_dir
    for key_dir in "/run/user/$UID_/verified-grader" "/run/user/$UID_/omp-session-sql"; do
        box_dir_named "$key_dir" || a+=(-v "$key_dir:$key_dir")
    done
    # The shared ssh identity bin/ossv-vm uses to reach the gateway VM, where the host has it:
    # without it `ossv-vm` in a box cannot reach that VM at all (agentvm, 2026-11-03). A box is
    # for segregation, not for keeping a session from what its host gives it (Sami,
    # dispatch://INFRA-702/comment/41bdfb9d-18d5-4cd6-a5dd-75771b45cee7), so it is bound as the
    # host has it.
    [[ -z "$OSSV_SSH" ]] || box_dir_have "$OSSV_SSH" || a+=(-v "$OSSV_SSH:$OSSV_SSH")
    # The relayed host tmux server (ensure_tmux_forwarder), as a directory holding
    # tmux-<box uid>/default, so a bare `tmux` in the box under TMUX_TMPDIR (session_env) finds
    # it and a relay restarted since the box started is seen at once. A host with no tmux has
    # no relay and the directory is empty, where `tmux` starts a server of the box's own.
    mkdir -p -m 700 "$(box_tmux_dir "$box")/tmux-$BOX_UID"
    a+=(-v "$(box_tmux_dir "$box"):/run/user/$UID_/tmux")
    # The inner dockerd's image store: anonymous, dies with the box.
    a+=(-v /var/lib/docker)
    printf '%s\n' "${a[@]}"
}

session_env() {
    local box="$1" e=()
    e+=(-e "XDG_RUNTIME_DIR=/run/user/$UID_")
    e+=(-e "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$UID_/bus/bus")
    # What this box was given with --dir, so a session inside it can move again into a new box
    # holding these plus whatever else it has since found it needs (move_self_in_box). The
    # entrypoint also checks each one is really bound in here, since an unbound path is an empty
    # lookalike and never an error (agentbox/entrypoint.sh).
    (( ${#BOX_DIRS[@]} )) && e+=(-e "AGENTBOX_DIRS=$(IFS=:; echo "${BOX_DIRS[*]}")")
    # This launch is a RESUME that already dropped --dir paths gone from the host, so the
    # entrypoint says an unbound one after the first and starts anyway, rather than leaving a
    # live session's pane at a shell. The first --dir is fatal there either way.
    [[ "${BOX_DROP_GONE_DIRS:-}" != true ]] || e+=(-e "AGENTBOX_DROP_GONE_DIRS=1")
    # The host's tmux server through its relay, so `tmux new-window`, `send-keys` and
    # `capture-pane` in a box act on the host's panes, which is what a lead does. TMUX itself is
    # NOT set: a box is not inside a pane, and a tool that reads TMUX would address the wrong
    # terminal.
    e+=(-e "TMUX_TMPDIR=/run/user/$UID_/tmux")
    # That socket is answered by the guard (ensure_tmux_forwarder), not by tmux's own protocol,
    # so `shims/tmux` must speak to it rather than exec the real binary at it. Only a box gets
    # this variable, and only a box made after the change, so a host shell and a box started
    # before it behave exactly as before.
    e+=(-e "AGENTBOX_TMUX_GUARD_SOCK=/run/user/$UID_/tmux/tmux-$BOX_UID/default")
    e+=(-e "HOME=$HOME" -e USER=ubuntu -e "TERM=${TERM:-xterm-256color}" -e "DOTFILES_DIR=$DOTFILES_DIR")
    e+=(-e "MISE_DATA_DIR=$HOME/.mise")
    local cache="$BOX_CACHE_ROOT/$box"
    e+=(-e "AGENTBOX_CACHE=$cache" -e "XDG_CACHE_HOME=$cache")
    e+=(-e "GOCACHE=$cache/go-build" -e "GOMODCACHE=$cache/go-mod")
    e+=(-e "npm_config_cache=$cache/npm" -e "BUN_INSTALL_CACHE_DIR=$cache/bun")
    e+=(-e "UV_CACHE_DIR=$cache/uv" -e "PIP_CACHE_DIR=$cache/pip")
    # $HOME/.dotfiles/bin holds gitignored binaries (mise, a local jj) a
    # checkout under test does not have.
    e+=(-e "PATH=$DOTFILES_DIR/shims:/opt/agentbox/docker-helpers:$DOTFILES_DIR/bin:$HOME/.dotfiles/bin:$DOTFILES_DIR/scripts:$HOME/.mise/shims:$HOME/.local/bin:$HOME/.pulumi/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin")
    e+=(-e "JJ_CONFIG=$HOME/.config/jj/config.toml:$DOTFILES_DIR/.jjconfig.toml")
    # ~/.cache/ms-playwright is mounted rw from the host; without this, a box's `playwright
    # install` deletes the browser builds of every checkout it cannot see (agentbox/AGENTS.md).
    e+=(-e PLAYWRIGHT_SKIP_BROWSER_GC=1)
    # Machine-local session environment (dispatch://BET-765), the same file scripts/agent-session
    # sources for a host session. A box builds its variables from scratch and never runs
    # agent-session, so without this the file is visible in the box (agentbox/mounts has
    # `ro .config/agent-session`) and nothing reads it: measured 2026-11-09 in a fresh box as
    # BOX_ENVFILE=PRESENT with the variable UNSET. Sourced in a subshell on the host so a bad
    # file cannot disturb the launcher, and only what it exports is passed on. Skipped unless it
    # is owned by this user and not group- or world-writable, as it runs as the session.
    local session_env_file="${XDG_CONFIG_HOME:-$HOME/.config}/agent-session/env"
    if [[ -f "$session_env_file" && -O "$session_env_file" ]] \
        && [[ -z "$(find "$session_env_file" -perm /022 -print -quit 2> /dev/null)" ]]; then
        local kv
        while IFS= read -r kv; do
            [[ -n "$kv" ]] && e+=(-e "$kv")
        done < <(env -i HOME="$HOME" DOTFILES_DIR="$DOTFILES_DIR" PATH="$PATH" bash -c '
            before="$(compgen -e | sort)"
            # shellcheck source=/dev/null
            source "$1" 2> /dev/null || exit 0
            comm -13 <(printf "%s\n" "$before") <(compgen -e | sort) | while read -r n; do
                printf "%s=%s\n" "$n" "${!n}"
            done' _ "$session_env_file")
    fi
    # The team memory graph's server, which `ctx` (mise.toml) sends every command to, as host
    # shells get it from .bashrc. A box reaches the tailnet through the host, so the server names
    # a box's caller by the host's Tailscale login. The launcher's own value wins.
    e+=(-e "CTX_SERVER=${CTX_SERVER:-http://ctx-memory.tail12ec1c.ts.net}")
    # Registries whose credential helper trades an identity the box already holds for a token:
    # ECR (`ecr-login`, the instance role) and Artifact Registry (`gcloud`, the machine's gcloud
    # identity). docker asks a helper only when the config names it for that registry host, and
    # sends nothing otherwise ("no basic auth credentials" for ECR, measured 2026-09-26;
    # "Unauthenticated request" for Artifact Registry, 2026-11-02). Pass the host's OWN entries for
    # those two helpers so a box mirrors the machine and no second list can drift; empty when the
    # host has none. No other helper: secretsd's entries are the entrypoint's own.
    e+=(-e "DOCKER_CONFIG=$HOME/.docker")
    e+=(-e "AGENTBOX_CRED_HELPERS=$(jq -c '(.credHelpers // {}) | with_entries(select(.value == "ecr-login" or .value == "gcloud"))' "$BOXES/$box/docker-config/config.json" 2>/dev/null || echo '{}')")
    # Also the inner dockerd's firewall rule (agentbox/entrypoint.sh).
    e+=(-e "AWS_EC2_METADATA_SERVICE_ENDPOINT=http://$NETWORK_GATEWAY:$IMDS_PORT")
    e+=(-e "AGENTBOX_IMDS_FORWARDER=$NETWORK_GATEWAY:$IMDS_PORT")
    # On a Google VM the same relay reaches Google's metadata server, which is also
    # 169.254.169.254:80 (dispatch://INFRA-993): gcloud, google-auth and Go's compute/metadata
    # then act as the VM's attached account with no credential file. Each reads its own name:
    # gcloud GCE_METADATA_ROOT (core/credentials/gce_read.py), google-auth GCE_METADATA_HOST then
    # GCE_METADATA_ROOT, and GCE_METADATA_IP for its probe (compute_engine/_metadata.py), Go
    # GCE_METADATA_HOST, which alone also makes it decide it is on GCE. On another machine none is
    # set, so no client takes the AWS or Azure metadata service for Google's.
    if "$DOTFILES_DIR/scripts/on-google-vm" 2>/dev/null; then
        e+=(-e "GCE_METADATA_HOST=$NETWORK_GATEWAY:$IMDS_PORT" -e "GCE_METADATA_ROOT=$NETWORK_GATEWAY:$IMDS_PORT")
        e+=(-e "GCE_METADATA_IP=$NETWORK_GATEWAY:$IMDS_PORT")
    fi
    # Relay the profile's loopback URL without overriding connection settings or credentials.
    e+=(-e "AGENTBOX_ENVOY_FORWARDER=$NETWORK_GATEWAY:$ENVOY_PORT")
    # Each forward channel this host serves and each loopback service it has (loopback_services),
    # "addr:port,…", for the box's own relays (entrypoint.sh). Read here rather than in the box,
    # which cannot see the host's loopback; a host with neither passes none and the box starts
    # without them. The entrypoint relays every entry the same way, so a service rides the list
    # named for forward's channels and no image change is needed for one.
    forward_channels || return 1
    loopback_services
    local relays=("${FORWARD_CHANNELS[@]}" ${LOOPBACK_SERVICES[@]+"${LOOPBACK_SERVICES[@]}"})
    e+=(-e "AGENTBOX_FORWARD_CHANNELS=$(IFS=,; echo "${relays[*]}")")
    e+=(-e GIT_CONFIG_COUNT=1 -e GIT_CONFIG_KEY_0=include.path -e "GIT_CONFIG_VALUE_0=$DOTFILES_DIR/gh-app-routes.gitconfig")
    e+=(-e "AGENTBOX_BOX=$box" -e AGENTBOX_USER=ubuntu)
    # The machine the box runs on, since the box's own hostname is its name: what a marker of
    # `move --to` names as `from=`, which agentbox-run.ts and agent-session compare with it.
    e+=(-e "AGENTBOX_HOST=${AGENTBOX_HOST:-$(hostname -s)}")
    # Identity groups boxes under their physical host. Profile connection settings stay unchanged.
    local envoy_machine="${AGENTBOX_HOST:-$(hostname -s)}"
    e+=(-e "ENVOY_MACHINE_ID=${envoy_machine%%.*}")
    # The durable disk and the host's figures for it, which `agentbox doctor --here` compares
    # with its own (DURABLE_CHECK); "none" on a host that has no durable directory.
    if [[ -n "$DURABLE_DIR" ]]; then
        e+=(-e "AGENTBOX_DURABLE=$DURABLE_DIR" -e "AGENTBOX_DURABLE_FS=$(durable_fs)")
    else
        e+=(-e AGENTBOX_DURABLE=none)
    fi
    e+=(-e "AGENTBOX_COMPUTE_INVENTORY=${COMPUTE_INVENTORY:-none}")
    # The box's disk limit, so a session and `agentbox doctor --here` can name the ceiling their
    # ENOSPC came from; 0 for a box started with --disk 0, which has no filesystem of its own.
    e+=(-e "AGENTBOX_DISK=$(if (( BOX_DISK_BYTES )); then size_text "$BOX_DISK_BYTES"; else echo 0; fi)")
    # The box's broker identity: its key dir (mount_args) and the broker. The launcher enrolls
    # the key once the box is up (enroll_box). No helper socket: a box is not a host session.
    e+=(-e "AGENT_SECRETS_URL=$AGENT_SECRETS_URL" -e "AGENT_SECRETS_KEY_DIR=/run/user/$UID_/agent-secrets")
    if curl -fsS -m 1 "http://127.0.0.1:${EMBED_PORT}/health" >/dev/null 2>&1; then
        e+=(-e "MNEMOPI_EMBEDDING_API_URL=http://$EMBED_NAME/v1")
    fi
    # The pane's tmux identity, as a host omp in the same pane sees it. TMUX_PANE
    # is how tmux-resurrect-omp finds the omp inside the box; TMUX is how omp
    # knows to wrap graphics and notification sequences in tmux's DCS
    # passthrough - without it the bare kitty APC it emits on every reflow
    # reaches tmux, which takes any APC string as the pane title
    # ("Ga=d,d=A,q=2"); TERM_PROGRAM(_VERSION) is what its hyperlink policy
    # reads.
    #
    # TMUX is `<socket>,<server pid>,<session index>`, and tmux itself reads that socket before
    # it ever looks at TMUX_TMPDIR. The host's socket path is not mounted, so a box that got the
    # host's value verbatim had a `tmux` that answered `error connecting to
    # /home/sami/.tmux/sockets/tmux-1000/default (No such file or directory)` while the relay
    # sat unused beside it (measured 2026-11-01 in agentbox-9edcc822bf2b). So the socket field
    # is replaced with the relay's path inside the box and the rest is kept: omp still knows it
    # is under tmux, and tmux reaches the host's server.
    local v
    for v in TERM_PROGRAM TERM_PROGRAM_VERSION; do
        [[ -n "${!v:-}" ]] && e+=(-e "$v=${!v}")
    done
    mapfile -t -O "${#e[@]}" e < <(box_tmux_env)
    printf '%s\n' "${e[@]}"
}

# The session id of the omp running in a box: the file it holds open,
# ~/.omp/agent/sessions/<dir>/<ts>_<id>.jsonl, read from its fd table (omp
# exports OMP_SESSION_ID to its children, not itself) - or, when none is open
# (idle after a resume or a full-file rewrite), the newest session file of the
# box's own directory under <boxes>, which omp keys by cwd and whose box name is
# never reused. A box working in a host directory (--dir) has no such fallback,
# on purpose: omp keys that directory by the path, which the host and every
# other box naming it share, so its newest file is very often another session's
# - measured 2026-11-01, where a glob by working directory answered with a live
# HOST session's id for both test boxes. Acting on that id would notify the
# wrong session on `agentbox restart` and release ANOTHER session's knives
# claims at close, so an empty answer is the right one. Empty also until a
# session has materialized, and for a --no-session run.
box_session_id() {
    local sid
    # Only a transcript held for WRITING names this box's session. omp's session writer holds
    # its own file O_WRONLY|O_APPEND for its life, while an omp opens ANOTHER session's
    # transcript read-only whenever a tool reads one -- which is why `omp-session-live` reads
    # the access mode too. Without that filter this answered with a session that merely passed
    # through: on 2026-11-08 the grading lane's box reported 01a1b8ff, a live session working
    # in /mnt/nvme/sami/gate-runs, and `agentbox sh <that id>` then ran a command in the
    # GRADING lane's box. For restart that is a hang-up of the wrong lane, and at close it is
    # another session's knives claims released.
    sid="$(docker exec "$1" sh -c '
        for p in $(pgrep -x omp); do
            for fd in /proc/$p/fd/*; do
                case "$(readlink "$fd" 2>/dev/null)" in
                    *.jsonl) ;;
                    *) continue ;;
                esac
                flags=$(sed -n "s/^flags:[[:space:]]*//p" "/proc/$p/fdinfo/${fd##*/}" 2>/dev/null)
                [ -n "$flags" ] || continue
                # O_WRONLY (1) or O_RDWR (2) in the low two bits: a reader has neither.
                [ $(( 0$flags & 3 )) -ne 0 ] || continue
                readlink "$fd" 2>/dev/null
            done
        done | sed -n "s#.*/\\.omp/agent/sessions/[^/]*/[0-9T:-]*Z_\\([0-9a-f-]\\{36\\}\\)\\.jsonl\$#\\1#p" | head -1' 2>/dev/null || true)"
    [[ -n "$sid" ]] && { echo "$sid"; return 0; }
    # The launch line the runner logged for this box. Under the SQL session store omp holds no
    # transcript open at all, so the scan above now answers empty for EVERY box -- 0 of 12 host
    # omp processes held one when measured on 2026-11-08 -- and with only the cwd fallback left,
    # `agentbox restart|sh|grow <session id>` could not find a live, healthy box: the grading
    # lane's at 02:03Z and the librarian's at 02:35Z, each with its omp alive and its cgroup
    # naming the box (dispatch://INFRA-1720). This route is safe where the cwd glob is not,
    # because it is not a guess from a shared directory: a resume names its own session in its
    # own argv, so the id belongs to the omp this box started. A box launched with a brief and
    # never resumed carries no id here and still answers empty.
    local launched
    launched="$(sed -n 's/.*: omp started ([^)]*): .*--resume \([^ ]*\).*/\1/p' \
        "$HOME/.cache/omp/agentbox/$1.log" 2>/dev/null | tail -1 || true)"
    # Either a bare id or a transcript path, whose own file name carries the id.
    sid="$(sed -n 's#^\([0-9a-f-]\{36\}\)$#\1#p; s#.*Z_\([0-9a-f-]\{36\}\)\.jsonl$#\1#p' <<<"$launched" | tail -1)"
    [[ -n "$sid" ]] && { echo "$sid"; return 0; }
    # Callers run under set -e: this must succeed, empty, while no file exists.
    local files
    files="$(ls -t "$HOME/.omp/agent/sessions/-boxes-$1-"*/*.jsonl 2>/dev/null || true)"
    sed -n '1s#.*Z_\([0-9a-f-]\{36\}\)\.jsonl$#\1#p' <<<"$files"
}

# A clone and the close-phase knives run in their own session (`setsid`): the
# pane's hangup reaches only the terminal's session, and jj, which knives runs,
# cannot be made to ignore it - it installs its own SIGHUP handler (ctrlc,
# "termination") that exits 1, replacing whatever disposition it inherited.
# `-w` returns the child's status.
detached() { setsid -w "$@"; }

# Release every knives claim the session holds. Claims are keyed by the omp
# session id (kind harness-session), so acting as that session releases them
# without --force; knives forgets and removes the workspace itself and keeps
# the commits. A claim's `repo` is its fork's lowercase upstream name
# (`metr/hawk`), which `knives repos --json` reports as `upstream_name`
# beside the checkout path.
finish_knives_claims() {
    local sid="$1" state="$HOME/.config/knives/state.json" repo branch path
    [[ -n "$sid" && -s "$state" ]] || return 0
    while IFS=$'\t' read -r repo branch; do
        [[ -n "$repo" && -n "$branch" ]] || continue
        # `knives repos` exits 3 whenever its scan has a problem (an ambiguous
        # checkout, a fork not on this machine) and still prints every row, so
        # judge the JSON, not the exit status: under set -euo pipefail the
        # status would abort close_box before it released anything.
        path="$( { detached knives repos --json 2>/dev/null || true; } | jq -r --arg r "$repo" '.repos[] | select(.upstream_name == $r) | .path')"
        if [[ -z "$path" || ! -d "$path" ]]; then
            echo "agentbox: knives claim $repo/$branch: checkout not found; left as is" >&2
            continue
        fi
        if ! (cd "$path" && OMP_SESSION_ID="$sid" detached knives finish "$branch"); then
            echo "agentbox: knives finish $repo/$branch failed; left as is" >&2
        fi
    done < <(jq -r --arg s "$sid" '.. | objects | select(.owner? == $s) | "\(.repo)\t\(.branch)"' "$state")
}

# urls_guarded SSHCMD URL...: true when some URL is GUARD for the leak check's pre-push hook (dispatch://BET-706,
# the rule shims/git's jj push gate and the hook sweep use): a GitHub repository that is public or whose visibility
# cannot be read, or a URL whose host part cannot be parsed. A private or internal repository, a local path and
# another host are not. A helper that exits other than 0 is unknown, whatever it printed (spec R4). SSHCMD, the
# deciding checkout's effective core.sshCommand (empty when none), goes to the helper as GIT_SSH_COMMAND, as shims/git
# gives it: an ssh alias is unknown where git would run an ssh command of its own, which may resolve it otherwise
# than ssh -G.
urls_guarded() {
    local sshcmd="$1" u v
    shift
    for u in "$@"; do
        v="$(GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-$sshcmd}" "$DOTFILES_DIR/scripts/github-repo-visibility" "$u" 2>/dev/null)" || v=unknown
        case "$v" in private | internal | not-github) ;; *) return 0 ;; esac
    done
    return 1
}

# origin_guarded CHECKOUT URL...: urls_guarded with CHECKOUT's effective core.sshCommand. A new template is cloned from
# its source's origin and has no other remote, so that URL alone decides for it, with the source checkout's ssh
# command; an existing template and a moved tree are decided by every URL of every remote (remote_urls_guarded).
origin_guarded() {
    local co="$1" sshcmd
    shift
    sshcmd="$(git -C "$co" config --get core.sshCommand 2>/dev/null)" || sshcmd=""
    urls_guarded "$sshcmd" "$@"
}

# has_prepush_hook CHECKOUT: true when the pre-push hook git runs in CHECKOUT is the leak check's wrapper and git can
# run it (executable: git skips a hook it cannot run, and a box clone copies the template's hook with its mode). The
# hook is named as the installer names it, the hooks directory (`--git-path hooks`) plus /pre-push: with
# --path-format=absolute, `--git-path hooks/pre-push` resolves a symlinked pre-push to its target's path.
has_prepush_hook() {
    local hooks
    hooks="$(git -C "$1" rev-parse --path-format=absolute --git-path hooks 2>/dev/null)" || return 1
    [[ -x "$hooks/pre-push" ]] && grep -qs PUBLIC-LEAK-CHECK-WRAPPER "$hooks/pre-push"
}

# prepush_saved_is_committed TOP REL SAVED: true when SAVED is, as git keeps a file, what the index of the work tree
# TOP holds at REL: a symlink whose link text is the indexed symlink's, byte for byte (the link is never followed),
# or a regular file, not a symlink, byte for byte the indexed file. Each read ends with a sentinel `x` inside its
# command substitution, so trailing newlines in a link's text count (`impl` and `impl<newline>` differ), and a read
# that fails is never equality. The leak check's installer keeps an existing hook as pre-push.local by renaming it,
# link or file, so a saved hook that passes is the committed hook as a checkout writes it; any other is someone's, a
# symlink above all, whose target its owner may change later. Written for the target's bash too, since
# MOVE_TO_HOOK_SH carries it to a move's target.
prepush_saved_is_committed() {
    local entry saved committed
    entry="$(git -C "$1" ls-files -s -- "$2" 2>/dev/null)" || return 1
    case "${entry%% *}" in
        120000)
            [ -L "$3" ] || return 1
            saved="$(readlink -n -- "$3" && printf x)" || return 1
            committed="$(git -C "$1" cat-file blob ":$2" 2>/dev/null && printf x)" || return 1
            [ "$saved" = "$committed" ]
            ;;
        100644 | 100755) [ -f "$3" ] && [ ! -L "$3" ] && git -C "$1" cat-file blob ":$2" 2>/dev/null | cmp -s - "$3" ;;
        *) return 1 ;;
    esac
}

# untrack_prepush_install CHECKOUT: when CHECKOUT's pre-push hook is a file the repository tracks (core.hooksPath
# inside the work tree, such as `.hooks`) and the installer put the wrapper there, keeping the tracked hook as
# pre-push.local, puts the tracked hook back, so a forced checkout finds that file as committed and the installer can
# run again after it (it refuses a directory holding both pre-push and pre-push.local). Only when pre-push.local is
# the committed hook as git keeps it (prepush_saved_is_committed: a tracked symlink as that same symlink, a tracked
# file as a regular file with its bytes) is it moved back, a symlink as the link itself: anything else is someone's
# edit, the only copy of it, which a forced checkout over the tracked file would destroy, so it refuses (1), every
# file left as it was.
untrack_prepush_install() {
    local hook top rel
    hook="$(git -C "$1" rev-parse --path-format=absolute --git-path hooks 2>/dev/null)/pre-push" || return 0
    top="$(git -C "$1" rev-parse --show-toplevel 2>/dev/null)" || return 0
    [[ "$hook" == "$top"/* ]] && [[ -e "${hook}.local" || -L "${hook}.local" ]] && grep -qs PUBLIC-LEAK-CHECK-WRAPPER "$hook" || return 0
    rel="${hook#"$top"/}"
    git -C "$top" ls-files --error-unmatch -- "$rel" >/dev/null 2>&1 || return 0
    if prepush_saved_is_committed "$top" "$rel" "${hook}.local"; then
        mv -fT -- "${hook}.local" "$hook"
        return 0
    fi
    echo "agentbox: ${hook}.local differs from the committed $rel the leak check's installer saved it from: it is someone's edit, and refreshing the template $1 would overwrite it, so nothing was changed. Move that file somewhere safe (or make it match the committed hook), then launch again." >&2
    return 1
}

# prepush_install_preflight CHECKOUT: true when the leak check's installer can run on CHECKOUT without replacing an
# owner's symlink, else prints why and returns 1, every file left as it is. The installer (agent-infra
# install-prepush-hook.sh) tests both hook files with `[ -e ]`, which follows a link, so it does not see a dangling
# one: it renames pre-push over a pre-push.local that is a symlink to nothing, and writes the wrapper over a pre-push
# that is one. Every installer call in this script runs this first (refresh_template, clone_checkout, and the move's
# ensure_hook through MOVE_TO_HOOK_SH, which carries it to the target).
prepush_install_preflight() {
    local d
    d="$(git -C "$1" rev-parse --path-format=absolute --git-path hooks 2>/dev/null)" || return 0
    if [ -L "$d/pre-push" ] && [ ! -e "$d/pre-push" ]; then
        echo "pre-push hook install: $d/pre-push is a symlink to nothing, which the leak check's installer would replace with its wrapper; resolve by hand"
        return 1
    fi
    if [ -L "$d/pre-push.local" ] && [ ! -e "$d/pre-push.local" ] && [ -e "$d/pre-push" ] \
        && ! grep -qs PUBLIC-LEAK-CHECK-WRAPPER "$d/pre-push"; then
        echo "pre-push hook install: $d/pre-push.local is a symlink to nothing, which the leak check's installer would replace with $d/pre-push; resolve by hand"
        return 1
    fi
}

# remote_urls GIT-OPTION...: every URL any remote of the repository those git global options name (-C CHECKOUT,
# --git-dir=DIR) fetches from or pushes to, once each, with insteadOf and pushInsteadOf applied (`git remote get-url
# --all` and `--push --all` per remote; `git remote -v` adds a partial clone's filter, ` [blob:none]`, after the URL).
# A remote's name goes after `--`, since git allows one that begins with `-`. Returns 1 when git cannot list them
# all, which the callers count as unknown, so GUARD (spec R4). MOVE_TO_URLS_SH carries it to a move's target.
remote_urls() {
    local r url names fetch push
    local -A seen=()
    names="$(git "$@" remote 2>/dev/null)" || return 1
    while IFS= read -r r; do
        [[ -n "$r" ]] || continue
        fetch="$(git "$@" remote get-url --all -- "$r" 2>/dev/null)" \
            && push="$(git "$@" remote get-url --push --all -- "$r" 2>/dev/null)" || return 1
        while IFS= read -r url; do
            [[ -n "$url" && -z "${seen[$url]:-}" ]] || continue
            seen[$url]=1
            printf '%s\n' "$url"
        done <<<"$fetch"$'\n'"$push"
    done <<<"$names"
}

# remote_urls_guarded CHECKOUT: true when some URL of CHECKOUT's remotes (remote_urls) is GUARD (origin_guarded, with
# CHECKOUT's own core.sshCommand), or when they cannot all be read. For a checkout on this machine whose .git goes
# whole where it is used: an existing template, which every box clone copies, and a move's source tree.
remote_urls_guarded() {
    local listing urls=()
    listing="$(remote_urls -C "$1")" || return 0
    [[ -n "$listing" ]] || return 1
    mapfile -t urls <<<"$listing"
    origin_guarded "$1" "${urls[@]}"
}

# The template of one repo, at the remote's current default branch: made on first use as a clone
# without old file contents (git fetches a file's contents from GitHub the first time something
# reads them), with the repo's sparse patterns (CLONE_SPARSE) set before the first checkout so the
# files it keeps arrive in one fetch, then brought up to date by a fetch on every launch. Automatic
# maintenance is off: with it on, every on-demand fetch starts a background repack, and adding 1,040
# small files to a test clone took over 900 s, a repack notice after each file's fetch; with it off,
# adding a 94-file task took 1.4 s. Callers hold the repo's template lock and run this under `||`,
# where set -e does not apply, so every step checks its own status. TEMPLATE_HOOK is set to 1 when the
# template, and so every box clone of it, must have the leak check's pre-push hook, else 0.
TEMPLATE_HOOK=0
refresh_template() {
    local repo="$1" tpl="$CLONE_TEMPLATES/$1" url="" upstream pats=() installer=""
    TEMPLATE_HOOK=0
    # `agentbox new` copies the template's .git/hooks into every box clone, so a template without the
    # public-text leak-check pre-push hook gives each box a clone that pushes unchecked. A template
    # whose origin is GUARD (origin_guarded) must have the hook (dispatch://BET-706 R2): a new one,
    # decided by the URL it is cloned from; an existing one that has the hook, which keeps it and costs
    # no visibility lookup; an existing one that lacks it, decided by every URL of every remote it
    # carries (remote_urls_guarded; URLs git cannot list count as GUARD), since the box clone copies its
    # .git/config. That decision is made before the
    # forced checkout below and holds whatever the checkout leaves: a hooks path inside the work tree
    # can hold a tracked hook, which the checkout restores over the wrapper. So the wrapper is
    # installed and checked after the checkout, where git runs it (a new template also gets it before
    # it is moved into place, so a failed install leaves no hookless template for the next launch).
    # The installer is the machine's own copy in ~/.local/share/public-leak-check-hooks, which
    # provisioning installs on each machine (on sami-devbox, step prepush of
    # devbox/sami-devbox-provision); there is no fallback to another copy (dispatch://BET-706 R5). It is
    # checked before the clone.
    if [[ ! -d "$tpl/.git" ]]; then
        # Its source checkout's core.sshCommand applies.
        url="$(git -C "$SRC/$repo" remote get-url origin)" || return 1
        if origin_guarded "$SRC/$repo" "$url"; then TEMPLATE_HOOK=1; fi
    elif has_prepush_hook "$tpl" || remote_urls_guarded "$tpl"; then
        TEMPLATE_HOOK=1
    fi
    if ((TEMPLATE_HOOK)); then
        installer="$HOME/.local/share/public-leak-check-hooks/install-prepush-hook.sh"
        [[ -x "$installer" ]] || {
            echo "agentbox: no leak-check pre-push hook for the template $tpl: $installer is missing or not executable; ~/.local/share/public-leak-check-hooks is per machine, installed by provisioning on each machine (on sami-devbox, step prepush of devbox/sami-devbox-provision); a box clone of $repo would push unchecked" >&2
            return 1
        }
    fi
    if [[ ! -d "$tpl/.git" ]]; then
        rm -rf "$tpl.partial"
        detached "${APP_GIT[@]}" clone --quiet --filter=blob:none --no-checkout "$url" "$tpl.partial" >&2 || return 1
        git -C "$tpl.partial" config gc.auto 0 && git -C "$tpl.partial" config maintenance.auto false || return 1
        if [[ -n "${CLONE_SPARSE[$repo]:-}" ]]; then
            read -ra pats <<<"${CLONE_SPARSE[$repo]}"
            "${APP_GIT[@]}" -C "$tpl.partial" sparse-checkout set --no-cone "${pats[@]}" || return 1
        fi
        if [[ -n "$installer" ]]; then
            prepush_install_preflight "$tpl.partial" >&2 && "$installer" "$tpl.partial" >&2 || {
                echo "agentbox: no leak-check pre-push hook in the new template $tpl ($installer failed, or would replace a symlink of yours: see above); a box clone of $repo would push unchecked" >&2
                return 1
            }
        fi
        mv "$tpl.partial" "$tpl" || return 1
    elif ((TEMPLATE_HOOK)); then
        untrack_prepush_install "$tpl" || return 1
    fi
    detached "${APP_GIT[@]}" -C "$tpl" fetch --quiet --prune origin >&2 || return 1
    upstream="$(git -C "$tpl" symbolic-ref --short refs/remotes/origin/HEAD)" || return 1
    detached "${APP_GIT[@]}" -C "$tpl" checkout --quiet -f -B "${upstream#origin/}" "$upstream" >&2 || return 1
    if ((TEMPLATE_HOOK)) && ! has_prepush_hook "$tpl"; then
        prepush_install_preflight "$tpl" >&2 && "$installer" "$tpl" >&2 && has_prepush_hook "$tpl" || {
            echo "agentbox: no leak-check pre-push hook in the template $tpl ($installer failed, would replace a symlink of yours, or left none where git runs it: see above); a box clone of $repo would push unchecked" >&2
            return 1
        }
    fi
}

# A template's object store into a box's clone: hard-linked on one filesystem, copied across two.
# `cp -al` fails with EXDEV the moment the box has a filesystem of its own, and the device of the
# destination's parent is what decides, since the destination does not exist yet.
copy_objects() {
    local src="$1" dest="$2"
    if [[ "$(stat -c %d "$src")" == "$(stat -c %d "$(dirname "$dest")")" ]]; then
        cp -al "$src" "$dest"
    else
        cp -a "$src" "$dest"
    fi
}

# The box's git clone of one repo at $ws: a copy of the repo's template, refreshed first. Its .git is
# copied, all but the objects and the index; the objects are hard-linked where the template and the
# box tree are on one filesystem, which is what a local `git clone` does and is safe because git
# never changes an object file in place. A box with a disk limit has a filesystem of its own
# (open_box_disk), where a hard link cannot reach the template, and the objects are copied instead:
# a quota that bounds a box has to own the bytes it bounds, so there is nothing to share. A checkout
# from those local objects then writes the working tree and a fresh index, needing no network. Each
# box's clone is its own repository - refs, config and index - and stays whole if the template is
# rebuilt or deleted. A fresh clone of agent-c took 64-78 s at load 200 (2026-10-02), almost all of
# it the checkout fetching the kept files' contents; the copy took 1.4 s and its checkout 17.6 s. (A
# local `git clone` of a clone without old file contents fails: `pack has 1 unresolved delta`.) The
# lock keeps a launch from copying a template another launch is refreshing. When the template must have the leak
# check's pre-push hook (TEMPLATE_HOOK, refresh_template's decision, made before its checkout), so must the clone,
# checked after the clone's own checkout at the path its git runs the hook from: the wrapper reaches the clone with
# its .git, unless the effective hooks path is in the work tree (a relative core.hooksPath such as `.hooks`, which
# the copied config keeps), whose files come from the checkout, a tracked hook among them. The clone is then hooked
# there, and a launch that cannot do that fails rather than give the box a clone that pushes unchecked
# (dispatch://BET-706 R2).
clone_checkout() {
    local repo="$1" ws="$2" tpl hook=0 installer="$HOME/.local/share/public-leak-check-hooks/install-prepush-hook.sh"
    tpl="$CLONE_TEMPLATES/$repo"
    mkdir -p "$CLONE_TEMPLATES" || return 1
    if ! {
        flock 9 \
            && refresh_template "$repo" \
            && hook=$TEMPLATE_HOOK \
            && mkdir -p "$ws/.git" \
            && tar -C "$tpl/.git" --exclude=./objects --exclude=./index -cf - . | tar -C "$ws/.git" -xf - \
            && copy_objects "$tpl/.git/objects" "$ws/.git/objects"
    } 9>"$CLONE_TEMPLATES/$repo.lock"; then
        echo "agentbox: could not copy $repo from its template $tpl; remove that directory to have the next launch rebuild it, once anything of yours in it is saved (see the lines above)" >&2
        return 1
    fi
    detached git -C "$ws" checkout --quiet -f HEAD >&2 || return 1
    if ((hook)) && ! has_prepush_hook "$ws"; then
        [[ -x "$installer" ]] && prepush_install_preflight "$ws" >&2 && "$installer" "$ws" >&2 && has_prepush_hook "$ws" || {
            echo "agentbox: no leak-check pre-push hook where the box clone $ws runs it ($installer missing, failed, or would replace a symlink of yours: see above); a box clone of $repo would push unchecked" >&2
            return 1
        }
    fi
}

# What a box's clone holds that its remote does not, as one line, empty when nothing: uncommitted
# changes, tracked or untracked, and each branch, stash or detached HEAD with commits no
# remote-tracking ref reaches. A clone the launcher never finished checking out holds nothing; one git
# cannot read says so, and close_box keeps it like any other.
unpushed_work() {
    local ws="$1" status ref found=()
    git -C "$ws" rev-parse --verify --quiet HEAD >/dev/null || return 0
    if ! status="$(git -C "$ws" status --porcelain 2>&1)"; then
        echo "a checkout git cannot read: ${status%%$'\n'*}"
        return 0
    fi
    if [[ -n "$status" ]]; then found+=("$(wc -l <<<"$status") uncommitted paths"); fi
    if ! git -C "$ws" symbolic-ref --quiet HEAD >/dev/null && [[ -n "$(git -C "$ws" rev-list -1 HEAD --not --remotes)" ]]; then
        found+=("a detached HEAD")
    fi
    while read -r ref; do
        if [[ -n "$(git -C "$ws" rev-list -1 "$ref" --not --remotes)" ]]; then found+=("${ref#refs/heads/}"); fi
    done < <(git -C "$ws" for-each-ref --format='%(refname)' refs/heads refs/stash)
    if (( ${#found[@]} )); then echo "${found[*]}"; fi
    return 0
}

# $HOME in a box is $BOXES/<box>/home on the host, so every file a session writes in its home and
# not under a --dir path lives there and dies with the box. `agentbox move --self` on sami-devbox
# removed box agentbox-74a3ddaacbdc with its home at 17:22Z, and PEER's WAKE-peer-01a13837.md and
# .leanperf.md, written minutes before, went with it (2026-11-03). So a home with files NEWER than
# the box's start is never removed unseen: they are copied under BOX_HOMES, keyed by the session,
# and the next box of that session (a rebox, a resume) starts with them in place. A copy that is
# too big or that fails keeps the whole box directory instead.
BOX_HOMES="${AGENTBOX_BOX_HOMES:-${XDG_STATE_HOME:-$HOME/.local/state}/agentbox/box-homes}"
BOX_HOME_CARRY_BYTES="${AGENTBOX_BOX_HOME_CARRY_BYTES:-2000000000}"

# box_home_is_credential PATH: true when PATH, relative to the box home as `find .` prints it, is a
# live credential store. A carry copies a box home into $BOX_HOMES, which outlives the box and the
# session, so a token copied there is a long-lived secret nobody is watching: the 2026-11-03 and
# 11-04 snapshots held gcloud refresh and access tokens and a docker `auth` line, under a tree that
# was world-readable until an SRE set it 0700 (INFRA-6). The list is explicit on purpose -- each
# entry is a file format that holds a usable token -- with two short patterns standing in for whole
# credential trees: a *token*/*credential* basename anywhere under .config, and a gcloud or docker
# store wherever a session put one (the 11-04 snapshot's gcloud store was under
# scratch/<peer>/agentbox-gcloud-session/gcloud/, not in .config at all). Everything else is carried
# as before; a session's notes are the point of the carry.
box_home_is_credential() {
    local p="${1#./}" base
    case "$p" in
        .netrc|*/.netrc) return 0 ;;
        .kube/config|*/.kube/config) return 0 ;;
        .docker/config.json|*/.docker/config.json) return 0 ;;
        .azure/msal_token_cache*|*/.azure/msal_token_cache*) return 0 ;;
        .azure/accessTokens.json|*/.azure/accessTokens.json) return 0 ;;
        */legacy_credentials/*) return 0 ;;
        .config/gh/hosts.yml|.config/gh-*/hosts.yml|*/.config/gh/hosts.yml|*/.config/gh-*/hosts.yml) return 0 ;;
    esac
    base="${p##*/}"
    case "$base" in
        credentials.db|access_tokens.db|application_default_credentials.json) return 0 ;;
    esac
    # The documented pattern: under .config, a name that says token or credential.
    case "$p" in
        .config/*|*/.config/*)
            case "${base,,}" in *token*|*credential*) return 0 ;; esac
            ;;
    esac
    return 1
}

# A session id, and nothing else, may become a directory name under $BOX_HOMES. A caller once
# passed docker's stderr ("OCI runtime exec failed: ..."), which became a directory of its own
# there, and the five sessions whose homes landed under it never got them back on a rebox, since
# seed_box_home looks under the real id. A value that is not a UUID is dropped, and the carry is
# keyed by the box instead: still on disk, still findable, just not attributed to a session.
BOX_SID_RE='^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$'

# box_home_carry BOX SID: copy what the session wrote in BOX's home; prints the directory it wrote,
# or nothing when the home holds no new file. Status 1 when the home must be kept in place.
box_home_carry() {
    local box="$1" sid="${2:-}" list dest bytes n
    if [[ -n "$sid" && ! "$sid" =~ $BOX_SID_RE ]]; then
        echo "agentbox: the session id given for $box is not a UUID (${#sid} characters); this carry is keyed by the box" >&2
        sid=
    fi
    local home="$BOXES/$box/home" stamp="$BOXES/$box/.started"
    [[ -d "$home" ]] || return 0
    list="$(mktemp)" || return 1
    if [[ -e "$stamp" ]]; then
        (cd "$home" && find . -newer "$stamp" \( -type f -o -type l \) -print0 >"$list")
    else
        # A box from before the stamp: everything in its home counts as the session's.
        (cd "$home" && find . \( -type f -o -type l \) -print0 >"$list")
    fi
    if [[ ! -s "$list" ]]; then rm -f "$list"; return 0; fi
    # A credential store is never carried; its NAME (never its contents) goes in the summary.
    local keep path skipped=()
    keep="$(mktemp)" || { rm -f "$list"; return 1; }
    while IFS= read -r -d '' path; do
        if box_home_is_credential "$path"; then
            skipped+=("${path#./}")
        else
            printf '%s\0' "$path" >>"$keep"
        fi
    done <"$list"
    rm -f "$list"
    list="$keep"
    if (( ${#skipped[@]} )); then
        echo "agentbox: ${#skipped[@]} credential file(s) in $home are NOT carried: ${skipped[*]}" >&2
    fi
    if [[ ! -s "$list" ]]; then rm -f "$list"; return 0; fi
    n="$(tr -dc '\0' <"$list" | wc -c)"
    # -B1, never -b: `du -b` is --apparent-size, which counts a sparse file's holes.
    bytes="$(cd "$home" && xargs -0r du -scB1 <"$list" 2>/dev/null | awk '$2 == "total" { print $1 }')"
    if [[ -n "$bytes" ]] && (( bytes > BOX_HOME_CARRY_BYTES )); then
        rm -f "$list"
        echo "agentbox: $home holds $(numfmt --to=iec "$bytes") written since the box started, over the $(numfmt --to=iec "$BOX_HOME_CARRY_BYTES") a close copies; $BOXES/$box is left in place for its owner" >&2
        return 1
    fi
    dest="$BOX_HOMES/${sid:-$box}/$box-$(date -u +%Y%m%dT%H%M%SZ)"
    # 0700 for the root and every directory under it: a carry holds a session's private files.
    # tar, not `cp -a --parents`: cp recreates each parent with the SOURCE's mode, so a
    # read-only directory -- Go's module cache is 0555 throughout -- cannot then receive the file
    # under it, and the whole carry fails. On 2026-11-07 that happened twice, at 15:19:26Z and
    # 17:25:54Z, each time leaving a box behind with part of its home copied. tar applies a
    # directory's permissions after writing its contents, which is the case cp gets wrong, and
    # preserves modes, symlinks and sparse files the same way.
    if ! (umask 077; mkdir -p "$dest") || ! chmod 700 "$BOX_HOMES" "$BOX_HOMES/${sid:-$box}" "$dest" \
        || ! (cd "$home" && tar --null --no-recursion -T "$list" -cf - 2>/dev/null) \
             | (cd "$dest" && tar -xf - 2>/dev/null); then
        rm -f "$list"
        echo "agentbox: could not copy what $home holds to $dest; $BOXES/$box is left in place for its owner" >&2
        return 1
    fi
    rm -f "$list"
    echo "agentbox: $n file(s) the session wrote in its box home are kept in $dest" >&2
    printf '%s\n' "$dest"
    return 0
}

# seed_box_home BOX: put what the session's last box left in its home (box_home_carry) into the new
# box's home, so a rebox keeps it. BOX_SEED_SID names the session; without it nothing is seeded. A
# file the new home has already is NOT replaced, and the carried copy stays on disk.
seed_box_home() {
    local box="$1" last sid="${BOX_SEED_SID:-}"
    if [[ -n "$sid" && ! "$sid" =~ $BOX_SID_RE ]]; then
        echo "agentbox: BOX_SEED_SID is not a UUID (${#sid} characters); nothing is seeded into $box" >&2
        return 0
    fi
    [[ -n "$sid" && -d "$BOX_HOMES/$sid" ]] || return 0
    last="$(find "$BOX_HOMES/$sid" -mindepth 1 -maxdepth 1 -type d -printf '%T@\t%p\n' 2>/dev/null | sort -rn | head -1 | cut -f2-)"
    [[ -n "$last" ]] || return 0
    if cp -a -n "$last/." "$BOXES/$box/home/" 2>/dev/null; then
        echo "agentbox: what this session's last box left in its home is in this box's home ($last)" >&2
    else
        echo "agentbox: could not put $last into $BOXES/$box/home; those files are still in $last" >&2
    fi
    return 0
}

# box_reclaim BOX: drop the page cache a running box's cgroup holds, just before agentbox stops
# the box. sami-devbox's 7.0 kernel lacks upstream f6988c90671e: a cgroup that dies holding many
# page-cache inodes has every one of them switched to another writeback context, one at a time,
# and every umount and `agentbox new` on the machine waits behind that (02:27-02:40Z 2026-11-04,
# after two boxes with large data closed at 02:18:48Z). Reclaimed first, the cgroup dies holding
# few. The same step as devbox/bulk-copy/pull-unit.sh. Bounded: three tries of 10 s each, then the
# stop goes on whatever is left; a box whose cgroup cannot be found or written is stopped as before.
BOX_CGROUP_ROOT="${AGENTBOX_CGROUP_ROOT:-/sys/fs/cgroup}"
box_reclaim() {
    local box="$1" pid cg dir try cur
    pid="$(docker inspect -f '{{.State.Pid}}' "$box" 2>/dev/null)" || return 0
    [[ "$pid" =~ ^[1-9][0-9]*$ ]] || return 0
    cg="$(awk -F: '$1 == "0" { print $3; exit }' "${PROC:-/proc}/$pid/cgroup" 2>/dev/null)" || return 0
    [[ -n "$cg" ]] || return 0
    # The container's own cgroup (docker-<id>.scope), not a nested one inside it.
    dir="$BOX_CGROUP_ROOT$cg"
    while [[ "${dir##*/}" != docker-*.scope && "$dir" == "$BOX_CGROUP_ROOT"/* ]]; do dir="${dir%/*}"; done
    [[ "${dir##*/}" == docker-*.scope && -e "$dir/memory.reclaim" ]] || return 0
    for try in 1 2 3; do
        cur="$(cat "$dir/memory.current" 2>/dev/null)" || break
        [[ "$cur" =~ ^[0-9]+$ ]] || break
        (( cur < 268435456 )) && break
        if [[ -w "$dir/memory.reclaim" ]]; then
            printf '%s\n' "$cur" | timeout 10 tee "$dir/memory.reclaim" >/dev/null 2>&1 || true
        else
            printf '%s\n' "$cur" | timeout 10 sudo -n tee "$dir/memory.reclaim" >/dev/null 2>&1 || break
        fi
    done
    return 0
}

# Everything the box made goes: the knives claims its session holds, then the directory. The
# container must be gone first — it holds the mounts, and docker recreates a removed mountpoint
# root-owned. The work in a clone is its agent's to push or remove (Sami, AGENTC-1420, 2026-10-02:
# "Just tell the agents to migrate off of the JJ workspaces, and then they can handle it"), and
# nothing is saved for it; a clone holding work its remote does not have keeps the whole box
# directory in place, named on the pane, so nothing is discarded unseen.
close_box() {
    local box="$1" sid="$2" repo ws work kept=0 _
    shift 2
    # Without --rm the container does not disappear on its own, so the wait is for it to STOP,
    # not to vanish. A container that is already gone (an older box, a forced removal) leaves
    # the loop at once.
    for _ in $(seq 1 60); do
        docker inspect "$box" >/dev/null 2>&1 || break
        [[ "$(docker inspect -f '{{.State.Running}}' "$box" 2>/dev/null)" == true ]] || break
        sleep 1
    done
    if [[ "$(docker inspect -f '{{.State.Running}}' "$box" 2>/dev/null)" == true ]]; then
        # Still running after 60 s: there is no clean exit to record, and the page cache must be
        # reclaimed before the container goes or every umount on the machine queues behind it.
        echo "agentbox: $box is still running after 60s; removing it" >&2
        box_reclaim "$box"
        docker rm -f "$box" >/dev/null 2>&1 || true
    elif docker inspect "$box" >/dev/null 2>&1; then
        # Exited, and without --rm it is still there with its status readable. Write the row
        # before removing it; record_box_exit is a no-op when the launcher already wrote one.
        record_box_exit "$box" "$sid" ""
        docker rm "$box" >/dev/null 2>&1 || true
    fi
    # An omp in the box may have queued this pane for the attention cockpit, and
    # its own shutdown drop died with the container. The launcher runs in the same
    # host pane, so it drops that pane here, stamped after everything the box sent.
    if [[ -n "${TMUX_PANE:-}" ]]; then
        "$DOTFILES_DIR/scripts/tmux-attention" drop "$TMUX_PANE" >/dev/null || true
    fi
    # The container is gone: nothing inside can use the key any more, and the broker must not
    # accept it either. Before the rm -rf below, which takes the key dir with it.
    unenroll_box "$box"
    close_box_cache "$box"
    finish_knives_claims "$sid"
    for repo in "$@"; do
        ws="$BOXES/$box/$repo"
        [[ -d "$ws/.git" ]] || continue
        work="$(unpushed_work "$ws")"
        if [[ -n "$work" ]]; then
            echo "agentbox: $ws holds work its remote does not have ($work); $BOXES/$box is left in place for its owner to push or remove" >&2
            if mountpoint -q "$BOXES/$box" 2>/dev/null; then
                echo "agentbox: that directory is the box's own filesystem; release it with: sudo umount '$BOXES/$box' && rm -f '$BOX_DISKS/$box.img'" >&2
            fi
            kept=1
        fi
    done
    # What the session wrote in its box home, before anything is removed.
    box_home_carry "$box" "$sid" >/dev/null || kept=1
    stop_tmux_forwarder "$box"
    rm -rf "${RUN_BASE:?}/$box"
    # The box's own filesystem takes everything in it (close_box_disk), leaving the mountpoint
    # for the rm below; a box with no disk limit has no image and the rm does all of it. A
    # filesystem that will not unmount keeps its directory, with the command that frees it.
    if (( ! kept )) && close_box_disk "$box"; then
        rm -rf "${BOXES:?}/$box"
    fi
}

# THE PREDECESSOR GOES WHEN THE NEW BOX IS UP. A session that is resumed - a move, a re-box, a
# restarter's respawn, a tmux restore after a reboot - gets a NEW box every time, and its old
# box's image stays on disk whenever the old launcher did not get to run close_box: the machine
# went down under it, its pane was killed, it was killed. At 20:05Z on 2026-11-04 that was 103
# images and 416.2 GiB on this host, each one belonging to a session alive in a new box, one
# session having left two of them in a day. Nothing ever removed them, because nothing knew
# whose they were; the record above is what makes them nameable and this is what collects them.
#
# The care close_box takes, with one deliberate difference and the reason for it:
#   - a box whose container still exists, in any state, is never touched;
#   - a clone holding work no remote has keeps the whole box, named in the log;
#   - what the session wrote in the old box's home is carried out first (box_home_carry), and a
#     carry that cannot be made keeps the box;
#   - the knives claims are NOT released. close_box releases the claims of the session whose box
#     it closes; here that session is ALIVE in the new box and holds those same claims - knives
#     keys a claim by session id and the box and the host share one state file
#     (agentbox/AGENTS.md), so `knives finish` as that id would take a live session's branches
#     away from it. The predecessor holds no claim of its own.
# Everything else is close_box's own path: unenroll_box, close_box_cache, the runtime dir, then
# close_box_disk and the directory. Anything that cannot be shown safe keeps the box and says in
# one line which test it was.
REAP_LOG_DIR="${AGENTBOX_REAP_LOG_DIR:-$HOME/.cache/omp/agentbox}"
# How long the reaper waits for the new box's session to register before it gives up and removes
# nothing: the wake's own ceiling (MOVE_WAKE_TOTAL, defined below this line and read the same
# way) and the same registration test.
REAP_WAIT_TOTAL="${AGENTBOX_REAP_WAIT_TOTAL:-${AGENTBOX_WAKE_TOTAL:-7200}}"
REAP_WAIT_STEP="${AGENTBOX_REAP_WAIT_STEP:-10}"
# How long the one privileged step of a removal, the loop mount of an image that is not
# mounted, may take before the box is kept instead.
REAP_MOUNT_WAIT="${AGENTBOX_REAP_MOUNT_WAIT:-60}"

reap_say() { echo "$(date -u +%FT%TZ) agentbox reap: $*"; }

# box_predecessors SID KEEP: every box of SID on this host except KEEP, oldest first, from the
# records. A box from before records exist names no session and is never reaped: a sweep with a
# person in it is the only thing that can place those.
box_predecessors() {
    local sid="$1" keep="$2" rec box
    [[ -n "$sid" && -d "$BOX_RECORDS" ]] || return 0
    for rec in "$BOX_RECORDS"/*.info; do
        [[ -f "$rec" ]] || continue
        box="$(basename "$rec" .info)"
        [[ "$box" == "$keep" ]] && continue
        [[ "$(box_record_get "$box" session)" == "$sid" ]] || continue
        printf '%s\t%s\n' "$(box_record_get "$box" created)" "$box"
    done | sort | cut -f2
}

# reap_box BOX SID: remove the predecessor BOX of session SID, or keep it and say why. Status 1
# when it is kept.
reap_box() {
    local box="$1" sid="$2" names ws work found=() mounted_here=0 img="$BOX_DISKS/$1.img" freed=""
    if [[ ! -e "$img" && ! -d "$BOXES/$box" ]]; then
        rm -f "$(box_record "$box")"
        reap_say "$box has no image and no directory; its record is removed"
        return 0
    fi
    # A LIVE container means the box may still be in use: never touched, never killed. An exited
    # one is the case this function exists for since --rm was dropped: its status is read, the
    # tally row is written, and then it is removed. Before that change an exited container could
    # not be seen here at all, which is why a launcher that died left no record.
    if ! names="$(docker ps -a --filter "name=^${box}\$" --format '{{.Names}}' 2>/dev/null)"; then
        reap_say "$box kept: docker could not be asked whether its container is gone"
        return 1
    fi
    if [[ -n "$names" ]]; then
        if [[ "$(docker inspect -f '{{.State.Status}}' "$box" 2>/dev/null)" != exited ]]; then
            reap_say "$box kept: its container is not exited"
            return 1
        fi
        record_box_exit "$box" "$sid" ""
        if ! docker rm "$box" >/dev/null 2>&1; then
            reap_say "$box kept: its exited container could not be removed"
            return 1
        fi
        reap_say "$box: its exited container was recorded and removed"
    fi
    # Its clones and its home are inside its own filesystem, so an image that is not mounted
    # (the usual state after a reboot) is mounted here to be read. Read-write: a carry copies
    # out of it, and ext4 recovers its journal at mount either way. Bounded: on 2026-11-04 this
    # machine spent 74 minutes with a mount of a box image stuck in uninterruptible sleep, and
    # a collector of old boxes must not be the thing that waits in it.
    if [[ -e "$img" ]] && ! mountpoint -q "$BOXES/$box" 2>/dev/null; then
        mkdir -p "$BOXES/$box" 2>/dev/null || true
        if ! timeout "$REAP_MOUNT_WAIT" sudo -n mount -o loop,noatime "$img" "$BOXES/$box" 2>/dev/null; then
            reap_say "$box kept: its image $img could not be mounted within ${REAP_MOUNT_WAIT}s, so its clones could not be checked"
            return 1
        fi
        mounted_here=1
    fi
    for ws in "$BOXES/$box"/*/; do
        ws="${ws%/}"
        [[ -d "$ws/.git" ]] || continue
        work="$(unpushed_work "$ws")"
        [[ -n "$work" ]] && found+=("$ws ($work)")
    done
    if (( ${#found[@]} )); then
        reap_say "$box kept: it holds work no remote has: ${found[*]}"
        (( mounted_here )) && sudo -n umount "$BOXES/$box" 2>/dev/null
        return 1
    fi
    # What the session wrote in that box's home, kept for it under BOX_HOMES exactly as a close
    # would keep it; a carry that cannot be made keeps the whole box.
    if ! box_home_carry "$box" "$sid" >/dev/null; then
        reap_say "$box kept: what its home holds could not be carried out (above)"
        (( mounted_here )) && sudo -n umount "$BOXES/$box" 2>/dev/null
        return 1
    fi
    # What the host actually gets back: the image's allocated blocks, not its sparse size.
    freed="$(du -B1 -s "$img" 2>/dev/null | cut -f1)"
    unenroll_box "$box"
    close_box_cache "$box"
    rm -rf "${RUN_BASE:?}/$box"
    if ! close_box_disk "$box"; then
        reap_say "$box kept: its filesystem would not unmount (above)"
        return 1
    fi
    rm -rf "${BOXES:?}/$box"
    reap_say "$box removed: the predecessor of $sid, $( [[ -n "$freed" ]] && numfmt --to=iec "$freed" || echo "its image") freed"
    return 0
}

# cmd_reap SID BOX SINCE: run detached by the launcher of BOX once its omp has said which session
# it is. It waits for that session to REGISTER on Envoy - move_wake's own test, so a box that
# never comes up removes nothing - and then collects the session's older boxes on this host.
cmd_reap() {
    local sid="$1" box="$2" since="${3:-0}" waited=0 p kept=0 n=0
    [[ -n "$sid" && -n "$box" ]] || die "usage: agentbox reap-previous <session-id> <box> [since-ms]"
    while :; do
        box_registered "$sid" "$since" && break
        if (( waited >= REAP_WAIT_TOTAL )); then
            reap_say "$sid did not register on Envoy within ${REAP_WAIT_TOTAL}s; no box of this session was removed"
            return 1
        fi
        sleep "$REAP_WAIT_STEP"
        waited=$((waited + REAP_WAIT_STEP))
    done
    while read -r p; do
        [[ -n "$p" ]] || continue
        n=$((n + 1))
        reap_box "$p" "$sid" || kept=1
    done < <(box_predecessors "$sid" "$box")
    (( n )) || reap_say "$sid has no older box on this host; nothing to remove"
    # The reaper is the one thing that already runs after every box with a predecessor, so it is
    # where the sweep belongs: no new unit, which this machine does not take.
    sweep_exited_boxes
    return "$kept"
}

# reap_start BOX SID SINCE: the reaper, detached from the launcher's pane and its signals, with
# its own log beside the box's. TMUX_PANE is dropped: close_box's attention step must never run
# for the live pane from here.
reap_start() {
    local box="$1" sid="$2" since="$3"
    # Nothing to collect, nothing to start: a session's FIRST box is the common case, and a
    # reaper of its own per box would poll Envoy and the process census for two hours for
    # nothing (this host runs ~110 boxes). The records are read once, here.
    [[ -n "$(box_predecessors "$sid" "$box")" ]] || return 0
    mkdir -p "$REAP_LOG_DIR" 2>/dev/null || return 0
    ( env -u TMUX_PANE setsid "$DOTFILES_DIR/scripts/agentbox" reap-previous "$sid" "$box" "$since" \
        >>"$REAP_LOG_DIR/reap-$box.log" 2>&1 & ) &
    return 0
}

cmd_new() {
    local usage="usage: agentbox new [-e NAME[=VALUE]]… [--memory SIZE] [--cpus N] [--pids N] [--disk SIZE] [--dir PATH]… [--no-host-writes] [--drop-gone-dirs] [<repo>…] -- <cmd> [args…]"
    local user_env=() box_repos=() repo a drop_gone=false dirs_seen=0
    # --drop-gone-dirs: this launch RESUMES a session (move_pane_command, tmux-resurrect-omp),
    # so its --dir paths were right when they were recorded, and
    # the session is already hung up: a refusal here leaves its pane a shell until a person runs
    # `omp --resume` by hand. So a --dir after the first that is no longer a directory is left out
    # with a line on stderr naming the path and why, instead of refusing the whole resume: one
    # removed since (a lane's finished scratch tree, a per-session TMPDIR an older move recorded:
    # 01a1798a on 2026-11-02, whose resume stopped at a shell on "is not an existing directory"),
    # and one that is a FILE, or a symlink to one (2026-11-04 10:09:59Z: a re-box named
    # /mnt/nvme/sami/tmp/ossv172-codex-turns.md, was refused, and its session was dead for 20
    # minutes). A box cannot be given a file as a --dir in any case, so leaving it out loses nothing
    # the box could have had. A --dir the box already has through another mount (the durable disk,
    # $SRC, the allow-list) is no refusal either: add_box_dir binds it no second time and says so.
    # What stays FATAL is a resume that would be unusable: its first --dir not a directory, since
    # that is the directory the session works in and a box in any other is not the session's tree
    # (the first --dir is never dropped); no repo and no --dir at all; and a --dir no box may be
    # given (/, $HOME, the box's private /tmp, runtime dir or ~/.omp/run), which a recorded spec
    # never holds (move_spec_usable leaves those out) and so means a broken spec, not a stale one.
    # Read before the loop, since add_box_dir refuses a non-directory as each --dir is read.
    for a in "$@"; do
        [[ "$a" == -- ]] && break
        [[ "$a" == --drop-gone-dirs ]] && drop_gone=true
    done
    # session_env passes this to the box as AGENTBOX_DROP_GONE_DIRS, so the entrypoint's bind
    # check knows this launch is a resume and says an unbound --dir after the first instead of
    # refusing it.
    BOX_DROP_GONE_DIRS=$drop_gone
    # Where each limit came from, so a refusal names what the caller actually set.
    local mem_from="AGENTBOX_MEMORY" cpu_from="AGENTBOX_CPUS" disk_from="AGENTBOX_DISK"
    local pids_from="AGENTBOX_PIDS"
    [[ -n "${AGENTBOX_MEMORY:-}" ]] || mem_from="the default memory limit"
    [[ -n "${AGENTBOX_CPUS:-}" ]] || cpu_from="the default cpu limit"
    [[ -n "${AGENTBOX_DISK:-}" ]] || disk_from="the default disk limit"
    [[ -n "${AGENTBOX_PIDS:-}" ]] || pids_from="the default process limit"
    while (( $# )) && [[ "$1" != -- ]]; do
        case "$1" in
            -e)
                [[ "${2:-}" =~ ^[A-Za-z_][A-Za-z0-9_]*(=.*)?$ ]] || die "-e takes NAME or NAME=VALUE, got '${2:-}'  ($usage)"
                user_env+=(-e "$2")
                shift 2
                ;;
            --memory)
                [[ -n "${2:-}" ]] || die "--memory takes a size, e.g. --memory 32g  ($usage)"
                BOX_MEMORY="$2" mem_from="--memory"
                shift 2
                ;;
            --cpus)
                [[ -n "${2:-}" ]] || die "--cpus takes a number of cores, e.g. --cpus 4  ($usage)"
                BOX_CPUS="$2" cpu_from="--cpus"
                shift 2
                ;;
            --pids)
                [[ -n "${2:-}" ]] || die "--pids takes a number of processes, e.g. --pids 65536  ($usage)"
                BOX_PIDS="$2" pids_from="--pids"
                shift 2
                ;;
            --disk)
                [[ -n "${2:-}" ]] || die "--disk takes a size, e.g. --disk 64g, or 0 for no limit  ($usage)"
                BOX_DISK="$2" disk_from="--disk"
                shift 2
                ;;
            --drop-gone-dirs) shift ;;
            --no-host-writes)
                NO_HOST_WRITES=true
                shift
                ;;
            --dir)
                [[ -n "${2:-}" ]] || die "--dir takes an existing directory, e.g. --dir ~/src/bet-grade  ($usage)"
                dirs_seen=$((dirs_seen + 1))
                if $drop_gone && [[ ! -d "$2" ]]; then
                    local not_dir="no longer exists"
                    [[ -e "$2" ]] && not_dir="is not a directory ($(stat -L -c %F -- "$2" 2>/dev/null || echo 'not a directory'))"
                    [[ ! -e "$2" && -L "$2" ]] && not_dir="is a symlink to nothing that exists"
                    (( dirs_seen > 1 )) || die "--dir '$2', the first --dir and so the directory this resume works in, $not_dir; nothing was started"
                    echo "agentbox: --dir '$2' $not_dir; this resume goes on without it" >&2
                    shift 2
                    continue
                fi
                add_box_dir "$2"
                shift 2
                ;;
            -*) die "unknown option '$1'; the command goes after \`--\`  ($usage)" ;;
            *) box_repos+=("$1"); shift ;;
        esac
    done
    # A box has each pointer file in agentbox/mounts but not what it names (move_config_dirs).
    # `move` adds those as --dirs; `new` must bind them as well, or every box it makes refuses
    # `gh pr create|edit|comment` for want of the leak check, and looks healthy until the lane's
    # first PR (measured 2026-11-01 in agentbox-d7c1bb68a0a4, made after 3c55860).
    local cfg_dir _why
    while IFS=$'\t' read -r cfg_dir _why; do
        box_dir_have "$cfg_dir" || box_add_mount "$cfg_dir"
    done < <(move_config_dirs)
    # The box-wide disk gate's state. `scripts/disk-gate` serialises every lane's large writes
    # through one lock and one count in this directory; a box that cannot see it writes into a
    # root-owned stub of its own, so `disk-gate reserve` takes no lock, counts nothing and reports
    # an empty reserved figure - the failure the gate exists to end (three lane boxes within six
    # minutes of the gate's announcement, 2026-11-02). The path is disk-gate's DEFAULT, never the
    # caller's DISK_GATE_STATE: session_env builds the box's environment from scratch, so the
    # disk-gate in the box always uses its default, and a launcher that bound the caller's value
    # bound a directory the box never reads. That is how the first version of this block failed:
    # its author's shell still exported DISK_GATE_STATE=/tmp/dg-test-47661 from testing the gate,
    # so two test boxes got that directory and not this one. Made here when absent, as mount_args
    # makes each rw allow-list path, so docker never creates it root-owned.
    local gate_state
    gate_state="/mnt/nvme/$(id -un)/scratch/disk-gate"
    if [[ -d "${gate_state%/*}" ]]; then
        mkdir -p "$gate_state"
        box_dir_have "$gate_state" || box_add_mount "$gate_state"
    fi
    # The OSS Verify N6 farm's work root on the state disk (bin/ossv-n6-farm, N6_WORK_NVME): a run
    # that disk-gate admits there keeps its directory in it, and `collect`, `peaks` and `clean` of
    # that run read it later, often from another session. A box that cannot see it stages into its
    # own overlay, which goes with the box; the run index that names it is in the allow-list
    # (.cache/ossv-n6-runs). Made here when absent, as the gate's state is.
    local n6_work
    n6_work="/mnt/nvme/$(id -un)/ossv-n6"
    if [[ -d "${n6_work%/*}" ]]; then
        mkdir -p "$n6_work"
        box_dir_have "$n6_work" || box_add_mount "$n6_work"
    fi
    set_resource_args "$mem_from" "$cpu_from" "$pids_from"
    set_disk_bytes "$disk_from"
    [[ "${1:-}" == -- ]] && (( ${#box_repos[@]} + ${#BOX_DIRS[@]} )) \
        || die "$usage  (a box needs a repo or a --dir; repos: $(repos | tr '\n' ' '))"
    shift
    (( $# )) || die "$usage"
    # A box that resumes a session must not start while an omp on this HOST runs it: the box's
    # own agent-session sees only the box's processes. On 2026-11-03 tmux-resurrect-omp started
    # 15 live boxed sessions a second time, each in a new box (scripts/omp-session-live; it waits
    # up to 60 s for an omp a hang-up is ending, as after a move's respawn).
    if [[ "$1" == omp ]]; then
        local a prev="" resume_target="" live
        for a in "$@"; do
            [[ "$a" == -- ]] && break
            case "$prev" in --resume|-r|--session) resume_target="$a" ;; esac
            case "$a" in --resume=*|--session=*) resume_target="${a#*=}" ;; esac
            prev="$a"
        done
        # The session this box resumes: its last box's home comes with it (seed_box_home).
        if [[ -n "$resume_target" ]]; then
            BOX_SEED_SID="$(basename "$resume_target")"
            BOX_SEED_SID="${BOX_SEED_SID%.jsonl}"
            BOX_SEED_SID="${BOX_SEED_SID##*_}"
        fi
        if [[ -n "$resume_target" ]] \
            && live="$("$DOTFILES_DIR/scripts/omp-session-live" --wait "${AGENT_SESSION_LIVE_WAIT:-60}" "$resume_target")"; then
            die "session $resume_target is running already on this machine ($(sed 's/\t/: /' <<<"$live" | paste -sd ';')); one session must not run twice, so no box is started for it. If that omp is stuck, end it by its pid first."
        fi
    fi
    for repo in "${box_repos[@]}"; do
        [[ -d "$SRC/$repo" ]] || die "no checkout $SRC/$repo (repos: $(repos | tr '\n' ' '))"
        git -C "$SRC/$repo" remote get-url origin >/dev/null 2>&1 || die "$SRC/$repo has no origin remote to clone from"
    done
    local dup
    if (( ${#box_repos[@]} )); then
        dup="$(printf '%s\n' "${box_repos[@]}" | sort | uniq -d)"
        [[ -z "$dup" ]] || die "repo listed twice: $dup"
    fi
    check_box_disk_space
    local use_broker=1
    broker_ready || use_broker=0
    local box tag
    box="agentbox-$(tr -d '-' </proc/sys/kernel/random/uuid | cut -c1-12)"
    echo "agentbox: box $box" >&2
    if (( ! use_broker )); then
        echo "agentbox: $box starts without a secrets-broker identity, so its agents use secretsd: $BROKER_UNREADY" >&2
    fi
    tag="$(image_tag)"
    build_image "$tag"
    ensure_network
    ensure_forwarders "$box"

    # From here the box has state on disk: whatever fails before or during the
    # session, its directory never outlives the launcher (close_box).
    # Values are expanded now (the trap outlives this function's locals) and
    # the trap runs only in the launcher itself, never in a $(…) subshell,
    # which inherits EXIT traps in bash.
    local launcher_pid=$BASHPID
    # shellcheck disable=SC2064
    trap "[[ \$BASHPID == $launcher_pid ]] && close_box '$box' '' $(printf '%q ' "${box_repos[@]}")" EXIT
    # A pane kill or TERM lands here; the trap forwards a hangup into the box
    # (--init delivers it to the command), --rm fires, close runs. Before the
    # box exists it is remembered instead and honoured once the clone returns.
    # After a hangup the terminal is gone: a write to it fails with EIO, and
    # under set -e the first chatty step of close_box (an echo) would end the
    # launcher before the rm -rf - which is how ~/boxes/<box> trees outlived
    # their boxes. Nothing printed from here on has a reader. hung_up tells
    # reenroll_if_not_live to make the HUP trap's redirect again after a call
    # whose own redirect undid it.
    local interrupted=0 hung_up=0
    trap 'interrupted=1; hung_up=1; box_reclaim "$box"; docker kill -s SIGHUP "$box" >/dev/null 2>&1 || true; exec >/dev/null 2>&1' HUP
    trap 'interrupted=1; box_reclaim "$box"; docker kill -s SIGHUP "$box" >/dev/null 2>&1 || true' TERM INT
    # The box's record (box_record_write), beside its image and under the same trap: a launch
    # that fails from here on takes it away with the image. After open_box_disk, since the
    # record lives in the images directory that step makes, and a box with no image gets none.
    # The session is known already when this launch resumes one; otherwise box_record_session
    # fills it in once the box's omp says which session it is. box_started_ms is what the
    # predecessor reaper measures registration against - the box's start, not the reaper's,
    # since a session can register before the launcher gets its id.
    local box_started_ms
    box_started_ms="$(date +%s%3N)"
    open_box_disk "$box"
    box_record_write "$box" "${BOX_SEED_SID:-}" "$@"
    # Every repo is cloned at once, each in a subshell that ignores the hangup and TERM/INT: the
    # launcher acts on those itself, once every clone has returned, and the clones' git runs detached
    # (see `detached`). A trapped signal ends `wait` early with 128+n while the clone still runs, so a
    # clone that is still alive is waited for again.
    local pids=() pid rc failed=0
    for repo in "${box_repos[@]}"; do
        ( trap '' HUP TERM INT; clone_checkout "$repo" "$BOXES/$box/$repo" ) &
        pids+=("$!")
    done
    for pid in "${pids[@]}"; do
        while :; do
            rc=0; wait "$pid" || rc=$?
            (( rc > 128 )) && kill -0 "$pid" 2>/dev/null && continue
            break
        done
        (( rc == 0 )) || failed=1
    done
    (( failed )) && exit 1
    (( interrupted )) && exit 130

    local mounts=() env=()
    # Not `mapfile < <(mount_args …)`: a refusal inside a process substitution does not stop the
    # launch, and the box then started with no mount at all (measured 2026-11-02 on a host with
    # no secretsd socket: `docker inspect` listed no bind, and the box's $HOME was empty).
    local mount_out
    mount_out="$(mount_args "$box")" || exit 1
    mapfile -t mounts <<<"$mount_out"
    # mount_args made the key dir. From the legion #1589 release, enrollment.pending tells the
    # box's agent-secrets that an enrollment is on its way; enroll_box renews it and ends it
    # either way. A box with no broker identity gets no marker and no key.
    if (( use_broker )); then : >"$(box_keydir "$box")/enrollment.pending"; fi
    local env_out
    env_out="$(session_env "$box")" || exit 1
    mapfile -t env <<<"$env_out"
    # omp runs under the in-box runner so `restart` can relaunch it in the same
    # container (scripts/agentbox-run.ts); any other command runs bare.
    local cmd=("$@")
    if [[ "$1" == omp ]]; then cmd=(bun "$DOTFILES_DIR/scripts/agentbox-run.ts" "$@"); fi
    # Where the box works: its first clone, as always, or - for a box given directories instead
    # of repositories - the first of those.
    local workdir="${BOX_DIRS[0]:-}"
    if (( ${#box_repos[@]} )); then workdir="$BOXES/$box/${box_repos[0]}"; fi
    local tty=(-i)
    [[ -t 0 && -t 1 ]] && tty=(-it)
    # This machine's tailnet names, pointed at the gateway its serve relays listen on
    # (ensure_tailnet_serve), so a dashboard URL a session was given works inside the box.
    local add_hosts=()
    mapfile -t add_hosts < <(box_tailnet_hosts)
    # Not exec'd: close_box must run after the container exits, whatever the
    # exit reason.
    local rc=0 child sid="" stdin_fd
    # The explicit stdin dup matters: a job-control-less background child gets
    # /dev/null for stdin, which -it refuses ("stdin is not a terminal").
    exec {stdin_fd}<&0
    # --log-driver none: stdout is the omp TUI's redraw stream, gigabytes a day
    # per box that nothing reads (the transcript is in ~/.omp; attach is live).
    docker run --init --runtime "$RUNTIME" --name "$box" --hostname "$box" --log-driver none \
        --network "$NETWORK" --dns 100.100.100.100 --dns 1.1.1.1 \
        "${RESOURCE_ARGS[@]}" \
        -w "$workdir" "${tty[@]}" ${add_hosts[@]+"${add_hosts[@]}"} \
        "${mounts[@]}" "${env[@]}" "${user_env[@]}" "$tag" "${cmd[@]}" <&"$stdin_fd" &
    child=$!
    # The broker identity first (enroll_when_up), when the host can give one.
    if (( use_broker )); then enroll_when_up "$box" "$child" "$1" || true; fi
    # An omp inside reveals its session id once up; close releases that session's knives claims.
    # Other commands have none, so for them this poll lasts the box's whole life. Each pass also
    # enrolls the box again when its renew loop has marked its enrollment not live
    # (reenroll_if_not_live).
    while kill -0 "$child" 2>/dev/null; do
        reenroll_if_not_live "$box"
        sid="$(box_session_id "$box")"
        [[ -n "$sid" ]] && break
        sleep 2
    done
    # Now the box's record names its session, and the session's OLDER boxes on this host can go:
    # a detached reaper waits for this session to register on Envoy and then collects them
    # (cmd_reap). It outlives nothing - it is the launcher's own session id, removing boxes that
    # hold no container - and it removes nothing at all if this box never comes up.
    if [[ -n "$sid" ]]; then
        box_record_session "$box" "$sid"
        reap_start "$box" "$sid" "$box_started_ms"
    fi
    # A box with a broker identity is waited for by box_wait, which goes on enrolling it again
    # while it runs and returns once the child has exited, so nothing enrolls it after that and
    # close_box below revokes the id the last re-enrollment recorded. A box with none goes
    # straight to the wait below. An interrupted wait re-waits: the first return after a signal
    # carries 128+sig, the child's real status arrives once it is reaped.
    if [[ "$ENROLLED_BOX" == "$box" ]]; then box_wait "$box" "$child"; fi
    while :; do
        if wait "$child"; then rc=0; else rc=$?; fi
        kill -0 "$child" 2>/dev/null || break
    done
    # Record the status before anything else: close_box and the exit below are where it would be
    # lost, and a box that aborted is exactly the one whose cleanup is most likely to go wrong.
    record_box_exit "$box" "$sid" "$rc"
    # The pane can go away while close is still running (a pane kill, a server
    # exit). That must not stop the box's removal: the launcher ignores the
    # hangup from here on (knives runs in its own session, see `detached`), and
    # its output goes through a reader that writes to the terminal while it
    # exists and drops the rest - a direct write to a hung-up pty fails with
    # EIO, which set -e would turn into an exit before the rm -rf.
    trap - TERM INT EXIT
    trap '' HUP
    exec > >(while IFS= read -r line; do printf '%s\n' "$line" 2>/dev/null || :; done) 2>&1
    close_box "$box" "$sid" "${box_repos[@]}"
    exit "$rc"
}

# The box a target names: a running box (exact name or unique prefix), or the
# omp session id (or prefix) of the omp running in one.
resolve_box() {
    local target="$1" b matches=()
    mapfile -t matches < <(docker ps --filter name='^agentbox-' --format '{{.Names}}' | grep -E "^(agentbox-)?${target}" || true)
    if (( ${#matches[@]} == 1 )); then printf '%s\n' "${matches[0]}"; return 0; fi
    for b in $(docker ps --filter name='^agentbox-' --format '{{.Names}}'); do
        if [[ "$(box_session_id "$b")" == "$target"* ]]; then printf '%s\n' "$b"; return 0; fi
    done
    return 1
}

cmd_grow() {
    (( $# == 2 )) || die "usage: agentbox grow <box|session-id> SIZE"
    local box img loop mounted old
    box="$(resolve_box "$1")" || die "no running box matches $1"
    [[ "$box" =~ ^agentbox-[a-zA-Z0-9-]+$ ]] || die "invalid box name $box"
    img="$BOX_DISKS/$box.img"
    [[ -f "$img" && ! -L "$img" ]] || die "$box has no disk image at $img"
    BOX_DISK="$2"
    set_disk_bytes "grow size"
    (( BOX_DISK_BYTES )) || refuse "grow size must be positive"
    # Keep two grow commands from changing one image at the same time.
    exec 9<>"$img"
    flock -x 9
    old="$(stat -c %s "$img")"
    (( BOX_DISK_BYTES >= old )) || refuse "cannot shrink $box from $(size_text "$old") to $2"
    mountpoint -q "$BOXES/$box" || die "$box's disk is not mounted at $BOXES/$box"
    loop="$(sudo -n losetup -j "$img" --noheadings --output NAME)" \
        || die "cannot find the loop device for $img"
    [[ "$loop" =~ ^/dev/loop[0-9]+$ ]] || die "expected one loop device for $img, got '$loop'"
    mounted="$(findmnt -n -o SOURCE --mountpoint "$BOXES/$box")" \
        || die "cannot find the mounted device for $box"
    [[ "$mounted" == "$loop" ]] || die "$BOXES/$box is on $mounted, not $loop"
    truncate -s "$BOX_DISK_BYTES" "$img" || die "could not extend $img"
    sudo -n losetup -c "$loop" || die "could not refresh $loop; retry agentbox grow $box $2"
    sudo -n resize2fs "$loop" || die "could not resize $loop; retry agentbox grow $box $2"
    exec 9>&-
    echo "agentbox: $box now has a $(size_text "$BOX_DISK_BYTES") disk; its session was not restarted"
}

cmd_sh() {
    local target="${1:-}"
    [[ -n "$target" ]] || die "box name or session id required"
    shift
    local box wdir
    box="$(resolve_box "$target")" || die "no running box matches $target"
    wdir="$(docker inspect -f '{{.Config.WorkingDir}}' "$box")"
    local tty=(-i)
    [[ -t 0 && -t 1 ]] && tty=(-it)
    local cmd=("$@")
    (( ${#cmd[@]} )) || cmd=(bash)
    # docker exec carries the container's launch env (PATH, routing, sockets);
    # only the caller's terminal needs passing through.
    exec docker exec "${tty[@]}" --user ubuntu -e "TERM=${TERM:-xterm-256color}" -w "$wdir" "$box" "${cmd[@]}"
}

cmd_rebuild() {
    local tag
    tag="$(image_tag)"
    build_image "$tag"
    local stale
    stale="$(docker ps --filter name='^agentbox-' --format '{{.Names}} {{.Image}}' | awk -v t="$tag" '$2 != t {print $1}')"
    if [[ -n "$stale" ]]; then
        echo "agentbox: boxes on an older image (they move to it in a new box, not via agentbox restart):" >&2
        echo "$stale" >&2
    fi
    echo "agentbox: image $tag"
}

# What a path uses, for a listing: never a failure, since `set -o pipefail` would otherwise make
# one unreadable directory inside a box tree end the whole command (it did, on the ext4 image's
# root-owned lost+found, before open_box_disk gave that one to the user).
dir_size() { du -sh --one-file-system "$1" 2>/dev/null | cut -f1 || true; }

# Running boxes, then anything a box left on disk and nothing is using: a tree kept at close for
# unpushed work, or one whose launcher was killed before it could close (the trap cannot run on a
# SIGKILL, and a reboot drops the loop mount while the image keeps its contents). Nothing is
# removed here - the tree may hold an agent's only copy of its work - so each one is named with
# the command that frees it.
cmd_ls() {
    docker ps --filter name='^agentbox-' --format 'table {{.Names}}\t{{.Image}}\t{{.Status}}'
    local running box dir img left=()
    running="$(docker ps -a --filter name='^agentbox-' --format '{{.Names}}')"
    for dir in "$BOXES"/agentbox-*; do
        [[ -d "$dir" ]] || continue
        box="${dir##*/}"
        if grep -qxF "$box" <<<"$running"; then continue; fi
        img="$BOX_DISKS/$box.img"
        if mountpoint -q "$dir" 2>/dev/null; then
            left+=("$box  $(dir_size "$dir") on its own filesystem; release: sudo umount '$dir' && rm -f '$img' && rmdir '$dir'")
        elif [[ -s "$img" ]]; then
            left+=("$box  an unmounted filesystem image ($(dir_size "$img") used); read it: sudo mount -o loop '$img' '$dir'")
        else
            left+=("$box  $(dir_size "$dir"); release: rm -rf '$dir'")
        fi
    done
    (( ${#left[@]} )) || return 0
    echo
    echo "box trees with no box running:"
    printf '  %s\n' "${left[@]}"
}

# The runner's pid in a box (agentbox-run.ts is pid 1's only child), empty for
# a box running something else - a bare omp would take SIGUSR1 itself.
box_runner_pid() {
    docker exec "$1" sh -c 'p=$(pgrep -P 1 | head -1); [ -n "$p" ] && tr "\0" " " </proc/$p/cmdline | grep -q agentbox-run && echo "$p"' 2>/dev/null || true
}

RESTART_NOTICE='agentbox: a restart of your omp is pending (new omp/plugins on the host). Finish the current step and start no new subagents or long jobs. When `read proc://` lists none of your jobs or services still running, run `agentbox restart` from your bash tool: omp quits gracefully and relaunches in this same box with --resume of this session; the box, its workspace and /tmp stay, supervised processes only if started with persist. If you are idle, do it now.'

cmd_restart() {
    # Inside a box this is the agent's own trigger. omp's bash tool has a
    # builtin kill that refuses the shell's ancestors - the runner is one - so
    # the signal is sent from here, a real process.
    if [[ -n "${AGENTBOX_RUNNER_PID:-}" ]]; then
        (( $# == 0 )) || die "inside a box, agentbox restart takes no arguments: it restarts this session"
        exec kill -USR1 "$AGENTBOX_RUNNER_PID"
    fi
    local now=false all=false t targets=() boxes=() box sid
    for t in "$@"; do
        case "$t" in
            --now) now=true ;;
            --all) all=true ;;
            -*) die "unknown option $t" ;;
            *) targets+=("$t") ;;
        esac
    done
    if $all; then
        mapfile -t boxes < <(docker ps --filter name='^agentbox-' --format '{{.Names}}')
    else
        (( ${#targets[@]} )) || die "usage: agentbox restart <box|session-id>… | --all [--now]"
        for t in "${targets[@]}"; do
            box="$(resolve_box "$t")" || die "no running box matches $t"
            boxes+=("$box")
        done
    fi
    for box in "${boxes[@]}"; do
        if [[ -z "$(box_runner_pid "$box")" ]]; then
            echo "agentbox: $box does not run omp under the runner; quit it and relaunch with --resume instead" >&2
            continue
        fi
        if $now; then
            # pid 1 (docker-init) forwards the signal to the runner.
            docker kill -s USR1 "$box" >/dev/null
            echo "agentbox: $box restarting now"
            continue
        fi
        sid="$(box_session_id "$box")"
        [[ -n "$sid" ]] || { echo "agentbox: $box: omp holds no session file open right now; retry, or use --now" >&2; continue; }
        envoy_send_text "$sid" "$RESTART_NOTICE" >/dev/null || die "envoy send to $sid failed"
        echo "agentbox: $box (session $sid) notified; it restarts when it reaches a safe point"
    done
}

# ── move: the sessions already running on this host (dispatch://INFRA-702) ───────────────────
#
# `agentbox new` starts a box for a NEW session. `move` is for the ones already running on the
# host: it reads every live top-level omp outside a box, works out the box each one would get,
# and relaunches its pane into that box with `omp --resume <id>`, so the session comes back with
# its id, its transcript and the tree it works in.
#
# WHY A MOVE NEVER NAMES A REPO. `agentbox new <repo>` gives the box a clone of its own and
# works in it (cmd_new: a repo wins the working directory). For a NEW session that is right. For
# a LIVE one it is not: the session would come back in a tree that is not the one it had - no
# uncommitted changes, no index, no branch, and, for the 17 sessions sharing
# the task repository's canonical checkout on 2026-11-01, none of each other's work either. $SRC is
# bind-mounted read-write into every box already (mount_args), so `--dir <cwd>` of a checkout or
# of a worktree under it adds no mount and no clone at all, and the session resumes in exactly
# the directory it was in. So a move's spec is --dir only, and the only new disk it claims is
# the box's own sparse filesystem image. A session that wants a clone of its own asks for one
# the ordinary way, after the move: `agentbox new <repo> -- omp --resume <id>`.
#
# A move hangs omp up (SIGHUP: the ordinary graceful teardown agentbox-run.ts uses for a
# restart), waits for it to go, and only then respawns its pane into the launcher - from a
# DETACHED process, because `move --self` runs in the session's own bash tool and dies with the
# omp it hangs up.

# /proc, so the census can be run against a fixture tree (scripts/tests/test_agentbox_move.py).
# Nothing else reads it.
PROC="${AGENTBOX_PROC:-/proc}"

# The field separator of a census row. NOT a tab: a tab is an IFS whitespace character, so
# `IFS=$'\t' read` folds two of them into one and every field after an empty one shifts left -
# which read a session's pane id as its session id while this was being written. A unit
# separator is not whitespace, so empty fields survive.
SEP=$'\x1f'

# What free space a move must leave on the disk the box IMAGES go on: a hard reserve, 20 GiB on
# /mnt/nvme or the local SSD and 10 GiB on the root disk. Not disk-fill-watch's alert floors (84 GB, 18 GiB): those
# tell a person early, and a move refused at them stopped all 70 ready sessions at 17:32Z on
# 2026-11-01 while a box claims about 0.3 GiB at launch (its sparse image). This bounds what the
# moves claim at launch, not what the sessions can later grow into.
move_floor_bytes() {
    local target
    target="$(df --output=target "$1" 2>/dev/null | tail -1 || true)"
    case "$target" in
        /mnt/nvme|/mnt/scratch) echo 21474836480 ;;
        *) echo 10737418240 ;;
    esac
}

move_free_bytes() { df -B1 --output=avail "$1" 2>/dev/null | tail -1 || echo 0; }

# Bytes as GiB, for a line a person reads.
move_gib() { awk -v b="$1" 'BEGIN { printf "%.1f", b / 1073741824 }'; }

# What ONE box claims on the host's disk the moment it starts: its own filesystem image
# (open_box_disk) and, since a move clones nothing, nothing else. The image is sparse, so only
# ext4's metadata is written and the rest of the limit is claimed as the session writes. The
# number is measured, not guessed: one mkfs of the size this move would use, in the directory
# the real images go in, read with du and removed (32 GiB → 261 MiB, 2 GiB → 66 MiB on this
# host, 2026-11-01). Measured once per run.
MOVE_IMAGE_BYTES=""
move_image_bytes() {
    local bytes="$1" probe used=""
    if [[ -n "$MOVE_IMAGE_BYTES" ]]; then echo "$MOVE_IMAGE_BYTES"; return 0; fi
    if (( ! bytes )); then MOVE_IMAGE_BYTES=0; echo 0; return 0; fi
    mkdir -p "$BOX_DISKS" 2>/dev/null || { echo 0; return 0; }
    probe="$BOX_DISKS/.move-probe.$$.img"
    rm -f "$probe"
    if truncate -s "$bytes" "$probe" 2>/dev/null \
        && PATH="$PATH:/usr/sbin:/sbin" mkfs.ext4 -q -F -m 0 "$probe" 2>/dev/null; then
        used="$(du -s --block-size=1 "$probe" 2>/dev/null | cut -f1 || true)"
    fi
    rm -f "$probe"
    MOVE_IMAGE_BYTES="${used:-0}"
    echo "$MOVE_IMAGE_BYTES"
}

# Refuse a move that would take the disk under that reserve. One box at a time: the check is made
# again by every session that moves, so a window that runs out of room stops itself.
#
# MOVE_FORCE_FLOOR (the `--force-floor` flag) says the person running the window has decided
# otherwise and prints what it is overriding.
MOVE_FORCE_FLOOR=false
move_check_floor() {
    local image="$1" dir free floor
    # Where the IMAGE lands, which since the move to the local SSD is not the box tree's disk.
    dir="$BOX_DISKS"
    while [[ ! -d "$dir" ]]; do dir="$(dirname "$dir")"; done
    free="$(move_free_bytes "$dir")"
    floor="$(move_floor_bytes "$dir")"
    if (( free - image < floor )); then
        if $MOVE_FORCE_FLOOR; then
            echo "agentbox: --force-floor: a box leaves $(move_gib $((free - image))) GiB free on $dir, under its $(move_gib "$floor") GiB reserve; moving anyway" >&2
            return 0
        fi
        echo "a box would leave $(move_gib $((free - image))) GiB free on $dir, under its $(move_gib "$floor") GiB reserve; free space first, then move, or --force-floor to decide otherwise" >&2
        return 1
    fi
    return 0
}

# ── the paths a box must be given ────────────────────────────────────────────────────────────
#
# A move's spec was the session's working directory and its git tree, and nothing else. That is
# not the tree a lane works in. Measured over the sessions notified on 2026-11-01: a session
# whose cwd is ~/src/oss-verifier writes in /mnt/nvme/sami/oss-verifier/..., /mnt/nvme/sami/tmp/...
# and ~/.worktrees/...; session 01a16640's cwd is ~/Code/legion, a real checkout of legion, while
# the worktrees it has open are ~/src/legion/.worktrees/infra-140-s5 and
# /mnt/nvme/sami/worktrees/legion/stopped-tree - so the cwd alone would have given it a box whose
# `git status` answers about ANOTHER checkout. A path a box is not given is not absent inside it:
# a home path is silently writable into the box's own filesystem and lost with the box
# (agentbox/AGENTS.md), which is the dangerous failure. So the spec is inferred from what the
# session's own processes actually use, and `--plan` and the notice print every path with why it
# was chosen, so a lane sees its box before it moves and adds what is missing with
# `agentbox move --self --dir PATH`.

# The roots that hold MANY sessions' trees. A path below one of these is never mounted at the
# root: the box gets the first directory under it, which is the session's own tree. The deepest
# matching root wins, so /mnt/nvme/<user>/tmp/<name> keeps <name> rather than tmp. A git working
# tree is resolved by git instead (move_resolve_dir), which is the exact boundary where there is
# one; this is the bound for everything else. AGENTBOX_MOVE_ROOTS (colon-separated) replaces the
# list, as AGENTBOX_PROC replaces /proc: the test fixture's own temporary tree lives under one of
# these roots on this host, which would otherwise make the suite's answers depend on TMPDIR.
MOVE_SHARED_ROOTS=()
move_shared_roots() {
    if (( ${#MOVE_SHARED_ROOTS[@]} )); then return 0; fi
    if [[ -n "${AGENTBOX_MOVE_ROOTS:-}" ]]; then
        IFS=: read -r -a MOVE_SHARED_ROOTS <<<"$AGENTBOX_MOVE_ROOTS"
        return 0
    fi
    local nvme="/mnt/nvme/$(id -un)"
    MOVE_SHARED_ROOTS=("$HOME/Code" "$HOME/Code/personal" "$HOME/.worktrees" "$HOME/tmp")
    # session-tmp holds one directory per session (devbox/session-scratch-reap) and tmp one per
    # `work-dir NAME`, so both are roots and neither is ever a path a box is given. `wt` is the
    # same: the box preamble puts one worktree per session under it (323 GB of every session's
    # worktrees on 2026-11-03), and without it every path below it collapsed into the root, so a
    # session that touched one worktree there got all of them (20 of this host's 44 live sessions
    # on 2026-11-04; PROCS's move at 07:09Z on 2026-11-03 and SQLPAGE's box carried it whole).
    MOVE_SHARED_ROOTS+=("$nvme" "$nvme/tmp" "$nvme/session-tmp" "$nvme/worktrees" "$nvme/scratch" "$nvme/wt")
}

# The paths every box already has at their own path: $SRC and the targets of its symlinks, the
# dotfiles, and every entry of the home allow-list (agentbox/mounts). An inferred path under one
# of them is left out of the spec - naming it would change nothing. A worktree under
# ~/src/<repo>/.worktrees/... is in this class: $SRC is bind-mounted read-write into every box,
# so such a tree IS in the box, with no --dir at all.
MOVE_IN_BOX=()
move_in_box_paths() {
    if (( ${#MOVE_IN_BOX[@]} )); then return 0; fi
    local p
    MOVE_IN_BOX=("$SRC" "$HOME/.dotfiles" "$DOTFILES_DIR")
    # Every symlink under $SRC resolved by ONE realpath, not a readlink fork each: one per link
    # took 40 s for this host's ~/src at load 300, and the $(…) subshells of a move each paid it
    # again (2026-11-03). A caller that forks computes this first, so the subshells inherit it.
    while IFS= read -r p; do
        [[ -n "$p" ]] && MOVE_IN_BOX+=("$p")
    done < <(find "$SRC" -mindepth 1 -maxdepth 1 -type l -print0 2>/dev/null | xargs -0 -r realpath -q -- 2>/dev/null || true)
    while read -r p; do [[ -n "$p" ]] && MOVE_IN_BOX+=("$HOME/$p"); done < <(mounts_of rw; mounts_of ro)
    [[ -z "$DURABLE_DIR" ]] || MOVE_IN_BOX+=("$DURABLE_DIR")
    # The grading farm's three paths: every box binds them (mount_args), so a move never names
    # one and a --dir that does is bound no second time.
    [[ -z "$FARM_PKG" ]] || MOVE_IN_BOX+=("$FARM_PKG")
    [[ -z "$FARM_ROOT" ]] || MOVE_IN_BOX+=("$FARM_ROOT")
    [[ -z "$FARM_BOXID" ]] || MOVE_IN_BOX+=("$FARM_BOXID")
}

move_within() { [[ "$1" == "$2" || "$1" == "$2"/* ]]; }

# A path no box should be given: the host's system directories (a box has its own), /tmp (the
# box's own, inside its disk limit), anything at or above $HOME, $SRC, the box tree or one of the
# shared roots above. The session's own working directory is exempt - it is where the session
# works, and a box without it is no move at all - but nothing inferred is.
move_dir_too_broad() {
    local path="$1" root
    case "$path" in
        /|/proc/*|/proc|/sys/*|/sys|/dev/*|/dev|/run/*|/run|/tmp|/tmp/*|/var|/var/*|/usr|/usr/*) return 0 ;;
        /etc|/etc/*|/opt|/opt/*|/boot|/boot/*|/snap|/snap/*|/bin|/bin/*|/sbin|/sbin/*|/lib*) return 0 ;;
    esac
    move_shared_roots
    for root in "$HOME" "$SRC" "$BOXES" "${MOVE_SHARED_ROOTS[@]}"; do
        # at or above one of these: /, /home, /mnt, /mnt/nvme, $HOME, ~/Code, /mnt/<user>/tmp …
        if move_within "$root" "$path"; then return 0; fi
    done
    return 1
}

move_dir_in_box() {
    local path="$1" p
    move_in_box_paths
    for p in "${MOVE_IN_BOX[@]}"; do
        if move_within "$path" "$p"; then return 0; fi
    done
    return 1
}

# An INFERRED path that is a strict ancestor of a path every box already has (MOVE_IN_BOX) is too
# broad as well: the box has the part of it the session can use, and the rest is everyone else's.
# One `ls /mnt/durable` in a session's record made the whole durable disk - other lanes' work and
# every other user's directory - a --dir of its box (S2, 2026-11-04), because the in-box check
# tests the other way round and /mnt/durable is not a root move_dir_too_broad looks above. Only
# the inference asks this: the working directory and a path named with --dir keep their place.
move_dir_above_box() {
    local path="$1" p
    move_in_box_paths
    for p in "${MOVE_IN_BOX[@]}"; do
        if [[ "$p" == "$path"/* ]]; then return 0; fi
    done
    return 1
}

# A path that is removed when the omp a move hangs up exits: its per-session TMPDIR.
# scripts/agent-session makes one for every agent session, `mktemp -d
# /mnt/nvme/<user>/session-tmp/$$-XXXXXXXX`, exports it as TMPDIR and AGENT_SESSION_SCRATCH, and
# devbox/session-scratch-reap removes it once no live process holds it. A spec that names one
# names a path the next `agentbox new` refuses ("is not an existing directory"): 01a1798a's move at
# 10:42Z on 2026-11-02 recorded /mnt/nvme/sami/session-tmp/53458-LivaHYZv, the TMPDIR of its omp
# (pid 53458), and when the session ended at 16:23Z the restarter's resume of that spec stopped at
# a shell. The box needs none of it: the session there gets a TMPDIR of its
# own. So nothing under the session-tmp root (AGENTBOX_SESSION_TMP replaces it, as the tests need:
# their own tree is under this host's real root) and nothing under the omp's own
# AGENT_SESSION_SCRATCH, wherever that is (MOVE_SCRATCH, set by move_dirs_why), is ever a --dir.
MOVE_SESSION_TMP="${AGENTBOX_SESSION_TMP:-/mnt/nvme/$(id -un)/session-tmp}"
MOVE_SCRATCH=""
move_dir_dies_with_omp() {
    if move_within "$1" "$MOVE_SESSION_TMP"; then return 0; fi
    [[ -n "$MOVE_SCRATCH" ]] && move_within "$1" "$MOVE_SCRATCH"
}

# The omp's own AGENT_SESSION_SCRATCH, from its environment, or nothing.
move_omp_scratch() {
    local kv
    while IFS= read -r -d '' kv; do
        if [[ "$kv" == AGENT_SESSION_SCRATCH=/* ]]; then printf '%s\n' "${kv#*=}"; return 0; fi
    done < <(cat "$PROC/$1/environ" 2>/dev/null || true)
    return 0
}

# The root of the git working tree a path is in, printed, or nothing. No fork: the first ancestor
# holding a `.git` IS the working tree's root, for a checkout (a .git directory) and for a linked
# worktree (a .git FILE naming its common dir) alike, which is exactly what `git rev-parse
# --show-toplevel` answers. It is done by hand because the plan asks it of every candidate of
# every session on the host - 1,700 git processes in one run at load 300, which is most of why a
# plan took four minutes. The walk stops at $HOME, at a shared root and at /, so it never leaves
# the region a box may be given.
MOVE_GIT_ROOT=""
move_git_root_var() {
    local path="$1" guard=0
    MOVE_GIT_ROOT=""
    move_shared_roots
    while [[ -n "$path" && "$path" != / && $guard -lt 64 ]]; do
        guard=$((guard + 1))
        [[ -e "$path/.git" ]] && { MOVE_GIT_ROOT="$path"; return 0; }
        [[ "$path" == "$HOME" ]] && return 1
        path="${path%/*}"
    done
    return 1
}

# The same, printed, for a caller that wants one answer.
move_git_root() {
    move_git_root_var "$1" || return 1
    printf '%s\n' "$MOVE_GIT_ROOT"
}

# The checkout that owns a linked worktree, for a `.git` FILE holding `gitdir: <common>/worktrees/<name>`.
# Also no fork.
move_git_owner() {
    local tree="$1" line common
    [[ -f "$tree/.git" ]] || return 1
    read -r _ common 2>/dev/null <"$tree/.git" || return 1
    [[ -n "$common" ]] || return 1
    common="${common%/worktrees/*}"
    [[ "${common##*/}" == .git ]] && common="${common%/*}"
    [[ -n "$common" && -d "$common" ]] || return 1
    printf '%s\n' "$common"
}

# Where a git working tree's OBJECTS actually live, one absolute path per line. A checkout's
# `.git/objects` is not always inside the tree: on this host `~/src/machcsl-riscv/.git/objects`
# is a SYMLINK to /mnt/nvme/sami/git-objects/machcsl-riscv, and so are
# the task repository's, link-eval-accept29's, machcsl-riscv-experimental's and
# ossvp-ulimit's. A box given the tree but not the store answers `not a git repository` for every
# command in it, and `knives gh` fails with it (measured 2026-11-01 by session 01a1798a-995f in
# box agentbox-676432b23e44). So four things are followed for every tree in the spec, including
# one under $SRC, whose own mount says nothing about where its objects are:
#
#   * `.git` itself, when it is a FILE naming a git dir elsewhere (a linked worktree);
#   * `commondir` in that git dir, which names the checkout the worktree borrows from;
#   * `objects`, resolved through any symlink;
#   * every line of `objects/info/alternates`, which is how a borrowed object store is declared.
move_git_storage() {
    local tree="$1" gitdir common objects line
    gitdir="$tree/.git"
    if [[ -f "$gitdir" ]]; then
        read -r _ line 2>/dev/null <"$gitdir" || true
        [[ -n "${line:-}" ]] && gitdir="$line"
    fi
    [[ -d "$gitdir" ]] || return 0
    printf '%s\n' "$gitdir"
    common="$gitdir"
    if [[ -f "$gitdir/commondir" ]]; then
        read -r line 2>/dev/null <"$gitdir/commondir" || line=""
        if [[ -n "$line" ]]; then
            case "$line" in /*) common="$line" ;; *) common="$gitdir/$line" ;; esac
            common="$(readlink -f "$common" 2>/dev/null || true)"
            [[ -n "$common" ]] && printf '%s\n' "$common"
        fi
    fi
    objects="$(readlink -f "$common/objects" 2>/dev/null || true)"
    [[ -n "$objects" && -d "$objects" ]] && printf '%s\n' "$objects"
    if [[ -f "$common/objects/info/alternates" ]]; then
        while IFS= read -r line; do
            [[ -n "$line" && "$line" != \#* ]] || continue
            case "$line" in /*) ;; *) line="$common/objects/$line" ;; esac
            line="$(readlink -f "$line" 2>/dev/null || true)"
            [[ -n "$line" && -d "$line" ]] && printf '%s\n' "$line"
        done <"$common/objects/info/alternates"
    fi
    return 0
}

# A config file whose CONTENT is a path to something outside the box. The allow-list can carry
# the config, but not what it points at: `shims/gh` refuses `gh pr edit|create|comment` unless it
# finds the public-text leak check, whose location is `~/.config/public-leak-check/path`. On
# sami-devbox it names `~/.local/share/public-leak-check/public-leak-check.sh` (step leakcheck of
# devbox/sami-devbox-provision writes both), which every box has through the allow-list
# (`rw .local/share/public-leak-check` beside `rw .config/public-leak-check` in agentbox/mounts),
# so nothing is added for it. On sami-rocqperf it still names
# `/mnt/nvme/sami/frac-verify/shared/leak-check/public-leak-check.sh` (2026-11-05), outside every
# box: a box there had the pointer and nothing to follow it to, and every public text write from
# it was refused (dispatch://INFRA-702, 2026-11-01). Each file here is read for one absolute path
# on its first line, and the directory holding that path is a candidate for the spec, which the
# callers drop when the box has it already. Adding another is one line.
MOVE_POINTER_FILES=()
move_pointer_files() {
    if (( ${#MOVE_POINTER_FILES[@]} )); then return 0; fi
    MOVE_POINTER_FILES=("$HOME/.config/public-leak-check/path")
    [[ -n "${AGENTBOX_POINTER_FILES:-}" ]] && IFS=: read -r -a MOVE_POINTER_FILES <<<"$AGENTBOX_POINTER_FILES"
    return 0
}

# "<dir>\t<why>" for every pointer file that names something a box would not have.
move_config_dirs() {
    local file target
    move_pointer_files
    for file in "${MOVE_POINTER_FILES[@]}"; do
        [[ -f "$file" && -r "$file" ]] || continue
        read -r target 2>/dev/null <"$file" || continue
        [[ "$target" == /* ]] || continue
        [[ -d "$target" ]] || target="${target%/*}"
        [[ -n "$target" && -d "$target" ]] || continue
        printf '%s\t%s\n' "$target" "$file names something in it, and a box has the pointer only"
    done
    return 0
}

# One candidate directory as the box should get it, in MOVE_RESOLVED: the root of its git working
# tree when it is in one (the exact boundary, and what makes a worktree of a session's open file
# arrive whole), else the first directory below the deepest shared root above it.
#
# It sets a global and prints nothing, because the record of one session names hundreds of
# distinct paths and a `$(…)` around this is a fork for each: at 84 sessions the forks, not the
# reading, were what made a plan take six minutes.
MOVE_RESOLVED=""
# MOVE_EXACT: a move to ANOTHER machine copies what it infers, so a directory below a shared root
# is kept as it is, the deepest one the session used, never bounded at the first directory below
# the root: LINUX-1248's inference became /mnt/nvme/sami/tmp/verified-linux (other agents' trees,
# ~20 unreadable paths) for a session that used verified-linux/LINUX-1248 (2026-11-03). A box on
# THIS host is given the bounded one, since a bind costs nothing and a wider one survives a new
# subdirectory.
MOVE_EXACT=false
move_resolve_dir_var() {
    local path="$1" root best="" rest
    if move_git_root_var "$path"; then MOVE_RESOLVED="$MOVE_GIT_ROOT"; return 0; fi
    if $MOVE_EXACT; then MOVE_RESOLVED="$path"; return 0; fi
    move_shared_roots
    for root in "${MOVE_SHARED_ROOTS[@]}"; do
        if [[ "$path" == "$root"/* ]] && (( ${#root} > ${#best} )); then best="$root"; fi
    done
    if [[ -n "$best" ]]; then
        rest="${path#"$best"/}"
        path="$best/${rest%%/*}"
    fi
    MOVE_RESOLVED="$path"
    return 0
}

# The same, printed, for a caller that wants one answer (the tests, and move_take_storage).
move_resolve_dir() {
    move_resolve_dir_var "$1"
    printf '%s\n' "$MOVE_RESOLVED"
}

# pid -> its children, for every process on this host, read once: the plan asks this of 80+
# sessions and one pass costs a builtin read per process. Built in the caller's shell, so the
# subshell each move_dirs runs in inherits it (cmd_move_plan, cmd_move_self and cmd_move_notify
# call it before their loop).
declare -A MOVE_KIDS=()
MOVE_KIDS_READ=false
move_read_kids() {
    if $MOVE_KIDS_READ; then return 0; fi
    MOVE_KIDS_READ=true
    local d pid line rest parent
    for d in "$PROC"/[0-9]*; do
        pid="${d##*/}"
        # 2>/dev/null BEFORE the input redirection: bash applies them left to right, and a
        # process that exits between the glob and the open otherwise prints its own error.
        read -r line 2>/dev/null <"$d/stat" || continue
        rest="${line#*\(}"
        rest="${rest##*\) }"
        read -r _ parent _ <<<"$rest"
        [[ -n "$parent" ]] || continue
        MOVE_KIDS[$parent]="${MOVE_KIDS[$parent]:-} $pid"
    done
}

# A process and every live descendant of it: a session is its omp plus the tools it runs, and a
# lane's real paths are in the children (a `git -C <tree>`, an editor, a build) far more often
# than in omp's own cwd.
move_descendants() {
    local queue=("$1") pid kid guard=0
    local -A seen=([$1]=1)
    while (( ${#queue[@]} && guard < 4096 )); do
        guard=$((guard + 1))
        pid="${queue[0]}"
        queue=("${queue[@]:1}")
        printf '%s\n' "$pid"
        for kid in ${MOVE_KIDS[$pid]:-}; do
            [[ -z "${seen[$kid]:-}" ]] || continue
            seen[$kid]=1
            queue+=("$kid")
        done
    done
}

# Every directory one of a session's processes works in or writes into, as "<dir>\t<why>": the
# cwd of each, and the directory of every file one of them holds OPEN FOR WRITING (O_WRONLY or
# O_RDWR in /proc/<pid>/fdinfo/<fd> flags). The fd targets are read with one `find` over the
# whole subtree - `find` skips a path that goes away instead of stopping.
#
# Everything after that find is a shell builtin, and each directory is answered once. The plan
# asks this of every session on the host at once, so a fork per open file is not affordable: a
# first version read the flags with `awk` per fd and the plan took 3 m 26 s over 66 movable
# sessions on 2026-11-01. A directory the box has already (the home allow-list, $SRC, the
# dotfiles) is dropped here rather than by the caller, because those are most of a session's
# open files - the mise store, the language caches, ~/.omp - and dropping them first is what
# makes the flags read rare.
#
# `move --to` needs the trees under $SRC too, since another machine has none of them: with
# MOVE_PROC_KEEP_SRC=true those stay in. MOVE_PROC_MEMO is one pid's answer computed already
# (MOVE_PROC_MEMO_PID), so a move to another machine walks a session's processes once.
MOVE_PROC_KEEP_SRC=false
MOVE_PROC_MEMO_PID="" MOVE_PROC_MEMO=""
move_proc_dirs() {
    if [[ -n "$MOVE_PROC_MEMO_PID" && "$MOVE_PROC_MEMO_PID" == "$1" ]]; then
        local line
        while IFS= read -r line; do
            [[ -n "$line" ]] || continue
            # What only the keep mode keeps: a tree under $SRC, or a git tree of the session's own
            # in a path every box has.
            if ! $MOVE_PROC_KEEP_SRC; then
                move_within "${line%%$'\t'*}" "$SRC" && continue
                move_dir_in_box "${line%%$'\t'*}" && continue
            fi
            printf '%s\n' "$line"
        done <<<"$MOVE_PROC_MEMO"
        return 0
    fi
    local root="$1" pids=() pid args=() src target comm fd flags dir key value
    local -A said=() dropped=()
    move_read_kids
    mapfile -t pids < <(move_descendants "$root")
    (( ${#pids[@]} )) || return 0
    for pid in "${pids[@]}"; do args+=("$PROC/$pid/cwd" "$PROC/$pid/fd"); done
    while IFS=$'\t' read -r src target; do
        [[ "$target" == /* && "$target" != *" (deleted)" ]] || continue
        if [[ "$src" == */cwd ]]; then dir="$target"; else dir="${target%/*}"; fi
        # A target directly under / leaves an empty dirname, and no box is given / anyway.
        [[ -n "$dir" && "$dir" != / ]] || continue
        [[ -n "${said[$dir]:-}" || -n "${dropped[$dir]:-}" ]] && continue
        case "$target" in /proc/*|/sys/*|/dev/*|/run/*) continue ;; esac
        # A directory decided once: a lead's processes hold thousands of files in a few dozen.
        if move_dir_in_box "$dir"; then
            $MOVE_PROC_KEEP_SRC && { move_within "$dir" "$SRC" || move_to_own_git_tree "$dir" >/dev/null; } || { dropped[$dir]=1; continue; }
        fi
        pid="${src#"$PROC"/}"
        pid="${pid%%/*}"
        read -r comm 2>/dev/null <"$PROC/$pid/comm" || comm="?"
        if [[ "$src" == */cwd ]]; then
            [[ -d "$target" ]] || continue
            said[$dir]=1
            printf '%s\t%s\n' "$dir" "the working directory of $comm (pid $pid)"
            continue
        fi
        [[ -f "$target" ]] || continue
        fd="${src##*/}"
        flags=""
        while read -r key value; do
            [[ "$key" == flags: ]] || continue
            flags="$value"
            break
        done 2>/dev/null <"$PROC/$pid/fdinfo/$fd"
        [[ -n "$flags" ]] || continue
        # O_WRONLY (1) or O_RDWR (2) in the low two bits of the octal open flags.
        (( (8#$flags & 3) )) || continue
        said[$dir]=1
        printf '%s\t%s\n' "$dir" "$comm (pid $pid) holds ${target##*/} open for writing"
    done < <(find "${args[@]}" -maxdepth 1 -type l -printf '%p\t%l\n' 2>/dev/null)
}

# ── the session's own record ─────────────────────────────────────────────────────────────────
#
# A live-process scan sees only what a session is doing AT THIS INSTANT, and that misses two
# shapes measured on 2026-11-01, both of which end with a path silently writable inside the box
# and lost with it:
#
#  * a SUPERVISOR writes almost nothing itself. Its subagents do, and they have exited: a dead
#    worker leaves no cwd and holds no open file. Session 01a16220's live scan gave two
#    directories and missed four it works in (~/.worktrees/agent-orchestration-owner/s1-pool,
#    /mnt/nvme/sami/tmp/verified-linux, /mnt/nvme/sami/tmp/poolr2-close, /mnt/nvme/sami/infra132).
#  * TRANSIENT use. Session 01a16640 works in /mnt/nvme/sami/worktrees/legion/stopped-tree only
#    through one-shot `cd <path> && git …` calls, so at no instant is a process there.
#
# So the session's own transcript is read too. It records every tool call it made: the `cwd` of
# its bash calls, the `path` of its read/write/grep/glob calls, the `[path#tag]` headers of its
# edit calls, and every absolute path inside a bash `command` or an eval `code` - which is what
# catches `cd <path> &&` and `git -C <path>`. Each candidate is bounded exactly as a live one is
# (git working-tree root, else the first directory below a shared root) and must exist, so the
# wider net costs noise, not reach: on 01a16220, 137 raw candidates became a handful of mounts.
#
# The window is today by default (AGENTBOX_MOVE_SINCE overrides, and the test fixture sets it).
# The transcript is found by its own name, `<stamp>_<session id>.jsonl`, under ~/.omp/agent/sessions
# (AGENTBOX_SESSION_ROOTS replaces it), where an archived one is a symlink.
MOVE_RECORD_SINCE="${AGENTBOX_MOVE_SINCE:-$(date -u +%FT00:00:00Z)}"
SESSION_ROOTS=()
move_session_roots() {
    if (( ${#SESSION_ROOTS[@]} )); then return 0; fi
    if [[ -n "${AGENTBOX_SESSION_ROOTS:-}" ]]; then
        IFS=: read -r -a SESSION_ROOTS <<<"$AGENTBOX_SESSION_ROOTS"
        return 0
    fi
    # The local tree only. A transcript archived to /mnt/durable/<user>/omp-sessions-moved stays
    # behind a symlink here, which the listing takes whatever its mtime. Listing the durable tree
    # itself, with an mtime test on every file of a network disk, held the INFRA lead's
    # `move --to` dry run for over 5 minutes at load 300 (2026-11-03).
    SESSION_ROOTS=("$HOME/.omp/agent/sessions")
    return 0
}

# session id -> its transcript, from ONE find over the session roots: the plan asks this of every
# session on the host, and a find per session cost 2.4 s each here. Only a file written inside the
# window can hold a tool call from it, so -newermt drops the rest before anything is read.
declare -A MOVE_TRANSCRIPT=()
MOVE_TRANSCRIPT_READ=false
move_read_transcripts() {
    if $MOVE_TRANSCRIPT_READ; then return 0; fi
    MOVE_TRANSCRIPT_READ=true
    move_session_roots
    local root roots=() file base sid
    for root in "${SESSION_ROOTS[@]}"; do [[ -d "$root" ]] && roots+=("$root"); done
    (( ${#roots[@]} )) || return 0
    while IFS= read -r file; do
        base="${file##*/}"
        sid="${base##*_}"
        sid="${sid%.jsonl}"
        [[ "$sid" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] || continue
        MOVE_TRANSCRIPT[$sid]="$file"
    done < <(find "${roots[@]}" -mindepth 2 -maxdepth 2 -name '*_*.jsonl' \( -type l -o -newermt "$MOVE_RECORD_SINCE" \) 2>/dev/null)
    return 0
}

# The reader. argv: <since> <session id>=<transcript>…; stdout: "<session id>\t<why>\t<path>".
# It binary-searches each file for the first entry at or after the window's start (a transcript is
# append-only, so its timestamps rise), then reads forward to the end, at most 64 MiB. A line
# without `"toolCall"` in its bytes is skipped before any JSON is parsed, which is most of them.
IFS= read -r -d '' MOVE_RECORD_PY <<'PYEOF' || true
import json, os, re, sys

CUTOFF = sys.argv[1]
CAP = 64 * 1024 * 1024
HDR = re.compile(r"^\[([^\]\n]+)#[0-9A-Fa-f]{4}\]", re.M)
ABS = re.compile(r"(?<![\w/])(/[A-Za-z0-9._][A-Za-z0-9._/-]{3,})")

def stamp(line):
    try:
        return json.loads(line).get("timestamp") or ""
    except Exception:
        return ""

def start_offset(f, size):
    lo, hi = 0, size
    while lo < hi:
        mid = (lo + hi) // 2
        f.seek(mid)
        f.readline()
        pos = f.tell()
        line = f.readline()
        if not line:
            hi = mid
            continue
        t = stamp(line)
        if t and t < CUTOFF:
            lo = pos + len(line)
        else:
            hi = mid
    return lo

def scan(sid, path, out):
    try:
        size = os.path.getsize(path)
        f = open(path, "rb")
    except OSError:
        return
    off = start_offset(f, size)
    if size - off > CAP:
        # Clamped to the newest CAP bytes, which lands mid-line: skip that partial line.
        f.seek(size - CAP)
        f.readline()
    else:
        # start_offset is already the start of a line, so nothing may be skipped here: a
        # transcript whose whole window is one entry would otherwise read as empty.
        f.seek(off)
    seen = set()

    def emit(why, value):
        if not isinstance(value, str) or not value.startswith("/"):
            return
        value = value.rstrip("/")
        if value and value not in seen:
            seen.add(value)
            out.write("%s\t%s\t%s\n" % (sid, why, value))

    for raw in f:
        if b'"toolCall"' not in raw:
            continue
        try:
            entry = json.loads(raw)
        except Exception:
            continue
        if entry.get("type") != "message":
            continue
        content = entry.get("message", {}).get("content")
        if not isinstance(content, list):
            continue
        for block in content:
            if not isinstance(block, dict) or block.get("type") != "toolCall":
                continue
            name = block.get("name")
            args = block.get("arguments")
            if not isinstance(args, dict):
                continue
            emit("a bash call of its own ran in it", args.get("cwd"))
            if name in ("read", "write", "grep", "glob"):
                emit("a %s call of its own named a file in it" % name, args.get("path"))
            if name == "edit" and isinstance(args.get("input"), str):
                for match in HDR.findall(args["input"]):
                    emit("an edit call of its own named a file in it", match)
            for key in ("command", "code"):
                if isinstance(args.get(key), str):
                    for match in ABS.findall(args[key]):
                        emit("a %s call of its own named it" % name, match)
    f.close()

for pair in sys.argv[2:]:
    sid, _, path = pair.partition("=")
    if path:
        scan(sid, path, sys.stdout)
PYEOF

# The record of EVERY session, read into a cache file the plan's subshells share, several
# transcripts at a time. One python process per session, run one after another, was the whole
# cost of a plan: 70 sessions, some with a 65 MiB transcript, took 4 of the run's 6 minutes.
# Each worker appends its own lines; a line here is one short path, far under PIPE_BUF, so an
# O_APPEND write of it is not torn by another worker's.
MOVE_RECORD_CACHE=""
MOVE_RECORD_JOBS="${AGENTBOX_MOVE_JOBS:-16}"
#
# Each argument is SID or SID:PID. A session the listing does not have is found through its own
# omp (move_record_file): the listing reads only `<root>/<bucket>/<file>.jsonl`, and a session
# started from another session's turn keeps its file one level deeper, in THAT session's
# directory. S2 (01a170e0, `…/-Code-personal-theorem/<FRAC's 01a13b68 dir>/…_01a170e0….jsonl`)
# was such a session: its record was read from no file at all, and its `move --self --dry-run`
# at 12:52Z on 2026-11-04 named only its working directory and the one --dir it gave, while its
# transcript named /mnt/nvme/sami/frac-verify (61 calls today), gate-runs and its tmp trees.
move_record_prefetch() {
    local arg sid pid file pairs=()
    # The listing once, in this shell (the $(…) below would each walk it again), and through the
    # process only for a session the listing does not have, so a plan of ~100 sessions does not
    # pay for a second lookup of every one (its resume check already makes one).
    move_read_transcripts
    for arg in "$@"; do
        sid="${arg%%:*}" pid=""
        [[ "$arg" == *:* ]] && pid="${arg#*:}"
        [[ -n "$sid" ]] || continue
        file="${MOVE_TRANSCRIPT[$sid]:-}"
        [[ -n "$file" ]] || file="$(move_record_file "$sid" "$pid")"
        [[ -n "$file" ]] && pairs+=("$sid=$file")
    done
    (( ${#pairs[@]} )) || return 0
    MOVE_RECORD_CACHE="$(mktemp -t agentbox-record.XXXXXX)"
    printf '%s\n' "${pairs[@]}" \
        | MOVE_RECORD_PY="$MOVE_RECORD_PY" MOVE_RECORD_SINCE="$MOVE_RECORD_SINCE" \
          MOVE_RECORD_CACHE="$MOVE_RECORD_CACHE" \
          xargs -r -P "$MOVE_RECORD_JOBS" -n 2 \
              sh -c 'python3 -c "$MOVE_RECORD_PY" "$MOVE_RECORD_SINCE" "$@" >>"$MOVE_RECORD_CACHE" 2>/dev/null' sh \
        || true
    return 0
}

# move_record_file SID [PID]: the transcript whose record is read for SID, in the order it always
# was - the listing when this run has read it, else, for a session in this run's census, its own
# process (that listing took 14-156 s at load 450, most of a `move --to`'s time, 2026-11-03), else
# the listing - and then, new, through the session's own omp (PID) when the listing does not have
# it: move_transcript finds the file the omp holds open, names in --resume, or keeps under its
# agent directory at any depth, which is where a nested transcript is.
move_record_file() {
    local sid="$1" pid="${2:-}" file="${MOVE_TRANSCRIPT[$sid]:-}" row_pid="" _c _r
    if [[ -z "$file" && -n "${MT_ROW_OF[$sid]:-}" ]]; then
        IFS="$SEP" read -r _c row_pid _r <<<"${MT_ROW_OF[$sid]}"
        file="$(move_transcript "$row_pid" "$sid" 2>/dev/null || true)"
    fi
    if [[ -z "$file" ]]; then
        move_read_transcripts
        file="${MOVE_TRANSCRIPT[$sid]:-}"
    fi
    if [[ -z "$file" && -n "$pid" && "$pid" != "$row_pid" ]]; then
        file="$(move_transcript "$pid" "$sid" 2>/dev/null || true)"
    fi
    # A path the sweep deleted (move_transcript's last source) has nothing left to read.
    [[ -n "$file" && -r "$file" ]] && printf '%s\n' "$file"
    return 0
}

# One session's record candidates, as "<path>\t<why>". $2, when given, is the session's omp pid.
move_record_dirs() {
    local sid="$1" pid="${2:-}" file
    [[ -n "$sid" ]] || return 0
    if [[ -n "$MOVE_RECORD_CACHE" && -f "$MOVE_RECORD_CACHE" ]]; then
        awk -F'\t' -v s="$sid" '$1 == s { print $3 "\t" $2 }' "$MOVE_RECORD_CACHE"
        return 0
    fi
    file="$(move_record_file "$sid" "$pid")"
    [[ -n "$file" ]] || return 0
    python3 -c "$MOVE_RECORD_PY" "$MOVE_RECORD_SINCE" "$sid=$file" 2>/dev/null \
        | awk -F'\t' '{ print $3 "\t" $2 }'
    return 0
}

# What `move --plan` last inferred for a session, so `move --self` can take the union of that and
# what it sees now. The two commands run minutes apart and a live-process scan is a snapshot: at
# 18:48:20Z on 2026-11-01 the plan gave 01a1798a `--dir ~/src/machcsl-riscv --dir
# /mnt/nvme/sami/tmp/verified-linux` because one bash held a file open in the second, and the
# move minutes later gave the cwd alone because nothing did any more - so the box lost the
# directory holding that session's own state. A plan row is a promise; this file keeps it.
MOVE_PLAN_DIR="${AGENTBOX_PLAN_DIR:-$(dirname "$BOXES")/plan}"
move_plan_write() {
    local sid="$1" tmp
    shift
    [[ -n "$sid" ]] || return 0
    mkdir -p "$MOVE_PLAN_DIR" 2>/dev/null || return 0
    # Written to a temp file and renamed, so two `move --plan` runs at once never leave a session
    # half a file, and a `move --self` reading it sees one version or the other.
    tmp="$(mktemp "$MOVE_PLAN_DIR/.$sid.XXXXXX" 2>/dev/null)" || return 0
    printf '%s\n' "$@" >"$tmp" 2>/dev/null && mv -f "$tmp" "$MOVE_PLAN_DIR/$sid" 2>/dev/null
    rm -f "$tmp" 2>/dev/null
    return 0
}
move_plan_read() {
    local sid="$1"
    [[ -n "$sid" && -f "$MOVE_PLAN_DIR/$sid" ]] || return 0
    cat "$MOVE_PLAN_DIR/$sid" 2>/dev/null || true
    return 0
}

# The spec being built: the paths and, beside each, why it is there.
MOVE_D=()
MOVE_W=()
# Keep one path, shallowest ancestor wins: a path inside one the spec already has adds nothing,
# and one that CONTAINS others replaces them - except the first, the session's own working
# directory, which stays first because `agentbox new` works in the first --dir.
move_keep() {
    local path="$1" why="$2" i out=() outw=()
    for ((i = 0; i < ${#MOVE_D[@]}; i++)); do
        if move_within "$path" "${MOVE_D[i]}"; then return 0; fi
    done
    for ((i = 0; i < ${#MOVE_D[@]}; i++)); do
        if (( i > 0 )) && move_within "${MOVE_D[i]}" "$path"; then continue; fi
        out+=("${MOVE_D[i]}")
        outw+=("${MOVE_W[i]}")
    done
    MOVE_D=("${out[@]}" "$path")
    MOVE_W=("${outw[@]}" "$why")
}

# The directories a box must be given so a session keeps the tree it works in, as
# "<path>\t<why>", the session's own working directory FIRST (cmd_new works in the first --dir).
# Five sources, in this order:
#
#   1. the working directory itself, and - when it is in a git working tree outside $SRC - that
#      tree's root and the checkout that owns it (a worktree's .git is a file naming a common dir
#      in another tree; without it the box has the working files and no repository);
#   2. every directory the session's own LIVE processes use (move_proc_dirs);
#   3. every directory its own RECORD names today (move_record_dirs), which is the only source
#      that sees a dead subagent's tree or a `cd <path> && …` one-shot;
#   4. what `move --plan` last inferred for this session (move_plan_read), when MOVE_USE_PLAN is
#      on - `--self` turns it on, so a path the plan promised is never dropped because the
#      process that held it has since exited;
#   5. each path the caller named with --dir, in the order given.
#
# Every candidate but the working directory is resolved to its git tree root or bounded at the
# first directory below a shared root, must exist, and is dropped when the box has it already
# ($SRC, the dotfiles, the home allow-list, the durable directory), when it is too broad, or when
# it is above a path the box has (move_dir_above_box). A path named with --dir skips these checks.
#
# $2 is the session's omp pid (no live inference without it) and $3 its session id (no record and
# no plan file without it); every argument after those is an explicit --dir. A working directory
# no box can be given fails here, with the reason on stderr.
MOVE_USE_PLAN=false
move_dirs_why() {
    local cwd="$1" pid="${2:-}" sid="${3:-}" top="" owner="" cand path why
    shift $(( $# > 3 ? 3 : $# ))
    [[ -n "$cwd" ]] || { echo "its working directory cannot be read" >&2; return 1; }
    [[ -d "$cwd" ]] || { echo "its working directory $cwd is gone" >&2; return 1; }
    MOVE_SCRATCH=""
    [[ -n "$pid" ]] && MOVE_SCRATCH="$(move_omp_scratch "$pid")"
    if move_dir_dies_with_omp "$cwd"; then
        echo "it works in $cwd, a per-session TMPDIR that is removed when this omp exits, so the box could never be resumed there; cd to the tree it works in first" >&2
        return 1
    fi
    case "$cwd" in
        /) echo "it works in /, which a box cannot be given (that is the whole host filesystem)" >&2; return 1 ;;
        "$HOME") echo "it works in \$HOME, which would shadow the box's own home and its allow-list" >&2; return 1 ;;
        "$BOXES"|"$BOXES"/*) echo "it already works inside the box tree $BOXES" >&2; return 1 ;;
    esac
    MOVE_D=("$cwd")
    MOVE_W=("its own working directory")
    if move_git_root_var "$cwd"; then
        top="$MOVE_GIT_ROOT"
        owner="$(move_git_owner "$top" || true)"
        for cand in "$top" "$owner"; do
            [[ -n "$cand" && -d "$cand" ]] || continue
            [[ "$cand" != / && "$cand" != "$HOME" ]] || continue
            if move_within "$cand" "$SRC"; then continue; fi
            if [[ "$cand" == "$top" ]]; then
                move_keep "$cand" "the git tree its working directory is in"
            else
                move_keep "$cand" "the checkout that owns that worktree"
            fi
        done
    fi
    # Many processes of one session share a cwd, a build opens dozens of files in one directory,
    # and a record names the same tree hundreds of times, so each distinct raw path is resolved
    # once and each bounded path is kept once.
    local -A raw_seen=() resolved=() stored=()
    # The object store of a tree, wherever it is. Run for EVERY tree the session touches, the
    # ones under $SRC included: a path's own mount says nothing about where its objects live.
    move_take_storage() {
        local tree="$1" store bounded known
        # The walk up to `.git` is a stat per ancestor, and the record of one session names
        # hundreds of paths inside a handful of trees: a path inside a tree already answered is
        # answered, and the string compare is far cheaper than the walk.
        for known in "${!stored[@]}"; do
            if move_within "$tree" "$known"; then return 0; fi
        done
        move_git_root_var "$tree" || return 0
        tree="$MOVE_GIT_ROOT"
        [[ -z "${stored[$tree]:-}" ]] || return 0
        stored[$tree]=1
        while IFS= read -r store; do
            [[ -n "$store" ]] || continue
            [[ -d "$store" ]] || store="${store%/*}"
            [[ -n "$store" && -d "$store" ]] || continue
            if move_dir_in_box "$store"; then continue; fi
            move_resolve_dir_var "$store"
            bounded="$MOVE_RESOLVED"
            [[ -n "$bounded" && -d "$bounded" ]] || continue
            if move_dir_in_box "$bounded" || move_dir_too_broad "$bounded" || move_dir_above_box "$bounded" || move_dir_dies_with_omp "$bounded"; then continue; fi
            move_keep "$bounded" "the git object store of $tree, which is outside it"
        done < <(move_git_storage "$tree")
        return 0
    }
    move_take_candidates() {
        local path why
        while IFS=$'\t' read -r path why; do
            [[ -n "$path" ]] || continue
            [[ -z "${raw_seen[$path]:-}" ]] || continue
            raw_seen[$path]=1
            # move_take_storage is skipped for a path the box has already AND whose tree it has:
            # the tree walk is cheap, but it is the one thing that must run even for a path under
            # $SRC, since a checkout's objects can live outside it.
            move_take_storage "$path"
            if move_dir_in_box "$path"; then continue; fi
            if [[ -z "${resolved[$path]:-}" ]]; then
                move_resolve_dir_var "$path"
                resolved[$path]="$MOVE_RESOLVED"
            fi
            path="${resolved[$path]}"
            [[ -n "$path" && -d "$path" ]] || continue
            if move_dir_in_box "$path" || move_dir_too_broad "$path" || move_dir_above_box "$path" || move_dir_dies_with_omp "$path"; then continue; fi
            move_keep "$path" "$why"
        done
    }
    move_take_storage "$cwd"
    move_take_candidates < <(move_config_dirs)
    [[ -n "$pid" ]] && move_take_candidates < <(move_proc_dirs "$pid")
    if [[ -n "$sid" ]]; then
        # A record candidate may be a FILE, and may carry a read selector (`path:600-700`); the
        # directory is what a box is given either way. For a move to another machine (MOVE_EXACT)
        # a file outside every git tree is copied as itself, not its directory: a file it read is
        # not a tree it works in. They come out last, as "<file>\tFILE: <why>" lines.
        local -A files_seen=()
        move_take_candidates < <(
            while IFS=$'\t' read -r path why; do
                path="${path%%:[0-9]*}"
                [[ -n "$path" ]] || continue
                if [[ -d "$path" ]]; then printf '%s\tits own record today, %s\n' "$path" "$why"
                elif [[ -f "$path" ]]; then printf '%s\tits own record today, %s\n' "$path" "$why"
                fi
            done < <(move_record_dirs "$sid" "$pid") | while IFS=$'\t' read -r path why; do
                if [[ -f "$path" ]]; then
                    if $MOVE_EXACT && ! move_git_root_var "${path%/*}"; then printf 'FILE\t%s\t%s\n' "$path" "$why" >&3; continue; fi
                    path="${path%/*}"
                fi
                printf '%s\t%s\n' "$path" "$why"
            done 3>"${MOVE_EXACT_FILES:-/dev/null}"
        )
        # Not for a move to another machine: the plan's paths are bounded ones, for boxes here.
        if $MOVE_USE_PLAN && ! $MOVE_EXACT; then
            move_take_candidates < <(
                while IFS=$'\t' read -r path why; do
                    [[ -d "$path" ]] || continue
                    printf '%s\tthe last `agentbox move --plan` gave it to this session\n' "$path"
                done < <(move_plan_read "$sid")
            )
        fi
    fi
    # A named path keeps its place whatever the box has (it is the caller's correction of the
    # inference), but its tree's object store still has to come with it: a --dir naming a
    # checkout whose `.git/objects` is a symlink elsewhere is a box that answers `not a git
    # repository`, exactly as `agentbox new --dir` did before add_box_dir_storage.
    for cand in "$@"; do
        if move_dir_dies_with_omp "$cand"; then
            echo "--dir $cand is a per-session TMPDIR, which is removed when this omp exits, so a box given it could not be resumed; name a directory that outlives the session" >&2
            return 1
        fi
        move_take_storage "$cand"
        move_keep "$cand" "you named it with --dir"
    done
    for ((cand = 0; cand < ${#MOVE_D[@]}; cand++)); do
        printf '%s\t%s\n' "${MOVE_D[cand]}" "${MOVE_W[cand]}"
    done
    # The files a move to another machine copies as themselves: each one no kept path holds,
    # once, and none the box has already or that is too broad to name.
    if $MOVE_EXACT && [[ -s "$MOVE_EXACT_FILES" ]]; then
        local tag f fwhy i in_kept
        while IFS=$'\t' read -r tag f fwhy; do
            [[ -z "${files_seen[$f]:-}" ]] || continue
            files_seen[$f]=1
            in_kept=false
            for ((i = 0; i < ${#MOVE_D[@]}; i++)); do move_within "$f" "${MOVE_D[i]}" && { in_kept=true; break; }; done
            $in_kept && continue
            move_dir_in_box "$f" && continue
            [[ "${f%/*}" == "$HOME" || -z "${f%/*}" ]] && continue
            move_dir_dies_with_omp "$f" && continue
            printf '%s\tFILE: %s\n' "$f" "$fwhy"
        done <"$MOVE_EXACT_FILES"
    fi
}

# The same, paths alone, one per line.
move_dirs() { move_dirs_why "$@" | cut -f1; }

# The `agentbox new` arguments for a working directory, one token per line.
move_spec() {
    local d
    while read -r d; do printf -- '--dir\n%s\n' "$d"; done < <(move_dirs "$@")
}

# ── is the inferred set short? ───────────────────────────────────────────────────────────────
#
# move_short_set PID TRANSCRIPT DIR…: a WARNING when the paths a box would get (DIR…) leave out
# most of the trees the session's own transcript names, and nothing otherwise.
#
# It is a second, independent reading of the record. The inference above reads the record of
# the file it LOOKS UP for the session, today only; this reads TRANSCRIPT, the file the box will
# resume (move_resume_check found it, so it is the session's own), over the last 24 hours. Each
# path one of its tool calls names is bounded exactly as an inferred candidate is (its git tree,
# else the first directory below a shared root), and kept when it exists, is not in every box
# already and is neither too broad nor one that dies with this omp. Those are the trees it names.
#
# "Much smaller" is: at least MOVE_SHORT_MIN (2) of those trees are outside every DIR, AND the
# box gets fewer than half of them. Why both: a single tree named once and left out is what a
# session that read one file elsewhere looks like, and the inference keeps today's anyway; the
# half rule is what separates "the inference missed a tree" from "the inference read nothing".
# Measured over sami-devbox's 35 live host sessions at 13:2xZ on 2026-11-04: by the unchanged
# inference it warned for 2, S2 (its transcript named 20 trees, the box got 1) and 01a1a3a6 (14
# trees, 3 in the box: worktrees it worked in from 23:02Z the day before, which a record read
# from 00:00Z does not see). With S2's record read (move_record_file) it warns for 01a1a3a6 alone.
# The 33 quiet ones include 01a1a2ff (3 of 16 trees outside the box), 01a1a3af (3 of 7) and
# 01a1a350 (1 of 1): left-out trees, but not a set much smaller than the transcript's.
MOVE_SHORT_MIN="${AGENTBOX_MOVE_SHORT_MIN:-2}"
MOVE_SHORT_SINCE="${AGENTBOX_MOVE_SHORT_SINCE:-$(date -u -d '24 hours ago' +%FT%TZ 2>/dev/null || echo "$MOVE_RECORD_SINCE")}"
MOVE_SHORT_TREES=() MOVE_SHORT_MISSING=()
move_short_trees() {
    local pid="$1" transcript="$2" path _why tree d covered
    shift 2
    local -A seen=() raw=()
    MOVE_SHORT_TREES=() MOVE_SHORT_MISSING=()
    [[ -n "$transcript" && -r "$transcript" ]] || return 0
    MOVE_SCRATCH="$(move_omp_scratch "$pid")"
    while IFS=$'\t' read -r _ _why path; do
        path="${path%%:[0-9]*}"
        [[ -n "$path" && -z "${raw[$path]:-}" ]] || continue
        raw[$path]=1
        [[ -f "$path" ]] && path="${path%/*}"
        [[ -d "$path" ]] || continue
        move_dir_in_box "$path" && continue
        move_resolve_dir_var "$path"
        tree="$MOVE_RESOLVED"
        [[ -n "$tree" && -d "$tree" && -z "${seen[$tree]:-}" ]] || continue
        seen[$tree]=1
        if move_dir_in_box "$tree" || move_dir_too_broad "$tree" || move_dir_above_box "$tree" || move_dir_dies_with_omp "$tree"; then continue; fi
        MOVE_SHORT_TREES+=("$tree")
        covered=false
        for d in "$@"; do move_within "$tree" "$d" && { covered=true; break; }; done
        $covered || MOVE_SHORT_MISSING+=("$tree")
    done < <(python3 -c "$MOVE_RECORD_PY" "$MOVE_SHORT_SINCE" "short=$transcript" 2>/dev/null)
    return 0
}
move_short_set() {
    local total missing kept
    move_short_trees "$@"
    total=${#MOVE_SHORT_TREES[@]} missing=${#MOVE_SHORT_MISSING[@]}
    kept=$((total - missing))
    (( missing >= MOVE_SHORT_MIN && kept * 2 < total )) || return 0
    echo "agentbox: WARNING: the inferred set looks short. This session's own transcript names $total trees since $MOVE_SHORT_SINCE and the box gets $kept of them; NOT in the box (each is writable there and lost with it):"
    printf '  %s\n' "${MOVE_SHORT_MISSING[@]}"
    echo "  Add each one you still work in with --dir."
}

# Every live top-level omp process on this machine, one TSV row each:
#
#   class  pid  session-id  pane-id  tmux-pane  cwd  detail
#
# class is one of: host (a session a move takes), no-pane (a top-level omp with no tmux pane - a
# headless `omp -p`, a systemd unit, a scheduler step agent - which only a person can decide),
# boxed (already in an agentbox), sandbox (an omp inside a grading sandbox: a /work working
# directory, a bwrap ancestor, or a container that is not a box), subagent (an omp under another
# omp, which is not a session at all). omp's own helper processes (`__omp_worker_*`) run the
# same binary and are not listed.
#
# A process's command name and parent, cached: /proc/<pid>/stat read by the shell itself, since
# one `awk` over /proc/[0-9]*/stat dies the first time a process exits between the glob and the
# open — mawk makes an unopenable file fatal and stops, which silently cut this host's 100 omp
# processes to the 40 awk had reached before the first vanished pid. The comm is parenthesised
# and may hold spaces and parentheses, so it is taken up to the LAST ")".
move_stat() {
    local line rest
    MOVE_COMM="" MOVE_PPID=""
    line="$(cat "$PROC/$1/stat" 2>/dev/null)" || return 1
    [[ -n "$line" ]] || return 1
    rest="${line#*\(}"
    MOVE_COMM="${rest%)*}"
    rest="${rest##*\) }"
    read -r _ MOVE_PPID _ <<<"$rest"
    [[ -n "$MOVE_PPID" ]] || return 1
    return 0
}

# The tmux client to talk to a server with: that server's OWN binary, from /proc/<pid>/exe. A
# client of another version cannot talk to it: LANE-E's tool shell had /usr/bin ahead of mise on
# PATH (2026-11-02), and its tmux 3.4 against this host's 3.8 server answered "server exited
# unexpectedly" on the right socket. `tmux` from PATH when the binary cannot be read.
# A tmux client in a BOX that can talk to the host's server through the relay: a client of another
# version cannot ("server exited unexpectedly"), and the image's tmux is 3.4 while this host's
# server is 3.8, so a boxed move could not start its relauncher (2026-11-03). Tries the caller's
# choice, then PATH, then every tmux the host's mise install dir holds (it is mounted in the box),
# then /usr/bin/tmux, and takes the first that the server answers. Prints it, or nothing.
MOVE_BOX_TMUX=""
move_box_tmux() {
    local t
    if [[ -n "$MOVE_BOX_TMUX" ]]; then printf '%s\n' "$MOVE_BOX_TMUX"; return 0; fi
    for t in ${AGENTBOX_TMUX_CLIENT:+"$AGENTBOX_TMUX_CLIENT"} tmux \
        "$HOME"/.mise/installs/*tmux*/*/bin/tmux "$HOME"/.local/share/mise/installs/*tmux*/*/bin/tmux \
        /usr/bin/tmux; do
        command -v "$t" >/dev/null 2>&1 || [[ -x "$t" ]] || continue
        if "$t" list-sessions >/dev/null 2>&1; then
            MOVE_BOX_TMUX="$t"
            printf '%s\n' "$t"
            return 0
        fi
    done
    return 1
}

MOVE_TMUX_BIN=tmux
move_tmux_bin() {
    MOVE_TMUX_BIN=tmux
    if [[ -n "${1:-}" && -x "$PROC/$1/exe" ]]; then
        MOVE_TMUX_BIN="$(readlink -f "$PROC/$1/exe" 2>/dev/null || true)"
        [[ -x "$MOVE_TMUX_BIN" ]] || MOVE_TMUX_BIN=tmux
    fi
    return 0
}

# move_env_pane OMP_PID PANE_PID SERVER_PID: the tmux pane an omp runs in, from the omp's own
# environment, for the case where the census's `tmux list-panes` found no entry for it (a tool
# shell whose environment dropped TMUX and TMUX_TMPDIR talks to /tmp/tmux-<uid>/default, where
# this host's server is not, and one whose tmux is another version cannot talk to the server at
# all: 2026-11-02, LANE-E read "no-pane" while its walk reached the server). TMUX_PANE names the
# pane, TMUX's first comma field the server's socket and its second the server's pid. The pane
# counts when that server, asked with its own binary, says the pane's process is PANE_PID, the
# process the walk came up through. When the server cannot be asked at all, it counts on /proc
# alone: TMUX names SERVER_PID, the tmux server the walk reached, and PANE_PID is that server's
# direct child; the pane's location is then unknown. Sets MOVE_PANE_ID and MOVE_PANE_AT.
move_env_pane() {
    local kv pane="" tmuxv="" out pane_pid at rest
    MOVE_PANE_ID="" MOVE_PANE_AT=""
    while IFS= read -r -d '' kv; do
        case "$kv" in
            TMUX_PANE=*) pane="${kv#TMUX_PANE=}" ;;
            TMUX=*) tmuxv="${kv#TMUX=}" ;;
        esac
    done < <(cat "$PROC/$1/environ" 2>/dev/null || true)
    [[ "$pane" == %* && -n "$tmuxv" ]] || return 1
    move_tmux_bin "$3"
    if out="$("$MOVE_TMUX_BIN" -S "${tmuxv%%,*}" display-message -p -t "$pane" "#{pane_pid}"$'\t'"#{session_name}:#{window_index}.#{pane_index}" 2>/dev/null)" \
        && [[ -n "$out" ]]; then
        IFS=$'\t' read -r pane_pid at <<<"$out"
        [[ "$pane_pid" == "$2" ]] || return 1
        MOVE_PANE_ID="$pane" MOVE_PANE_AT="$at"
        return 0
    fi
    rest="${tmuxv#*,}"
    [[ "$tmuxv" == *,* && "${rest%%,*}" == "$3" ]] || return 1
    move_stat "$2" || return 1
    [[ "$MOVE_PPID" == "$3" ]] || return 1
    MOVE_PANE_ID="$pane" MOVE_PANE_AT=""
}

# The variables of an omp's environment that decide where its session lives: the profile, the
# agent and config directories, the session directory, the session storage and its SQL DSN file,
# and the XDG roots omp puts its data and state under. A moved session's box gets each one the
# omp had, through `-e`, since the caller's environment never reaches a box: METARQ
# (01a170d9, 2026-11-02) ran with OMP_PROFILE=pbc and its box's omp started without it.
MOVE_SESSION_ENV=(OMP_PROFILE PI_PROFILE PI_CONFIG_DIR PI_CODING_AGENT_DIR PI_CODING_AGENT_SESSION_DIR
    OMP_SESSION_STORAGE OMP_SESSION_SQL_DSN_FILE XDG_DATA_HOME XDG_STATE_HOME XDG_CONFIG_HOME)

# move_session_env PID: `-e` and `NAME=VALUE`, one per line, for each of those the omp has set.
move_session_env() {
    local kv name n
    while IFS= read -r -d '' kv; do
        name="${kv%%=*}"
        for n in "${MOVE_SESSION_ENV[@]}"; do
            [[ "$name" == "$n" ]] && printf -- '-e\n%s\n' "$kv"
        done
    done < <(cat "$PROC/$1/environ" 2>/dev/null || true)
}

# move_agent_dir PID: the agent directory that omp's environment selects, as omp's dirs.ts does:
# a named profile's own (OMP_PROFILE, else PI_PROFILE), else PI_CODING_AGENT_DIR, else the
# default, under $HOME/${PI_CONFIG_DIR:-.omp}.
move_agent_dir() {
    local kv profile="" pi_profile="" omp_set=false config=".omp" agent=""
    while IFS= read -r -d '' kv; do
        case "$kv" in
            OMP_PROFILE=*) profile="${kv#*=}"; omp_set=true ;;
            PI_PROFILE=*) pi_profile="${kv#*=}" ;;
            PI_CONFIG_DIR=*) config="${kv#*=}" ;;
            PI_CODING_AGENT_DIR=*) agent="${kv#*=}" ;;
        esac
    done < <(cat "$PROC/$1/environ" 2>/dev/null || true)
    $omp_set || profile="$pi_profile"
    [[ "$profile" == default ]] && profile=""
    if [[ -n "$profile" ]]; then echo "$HOME/$config/profiles/$profile/agent"
    elif [[ -n "$agent" ]]; then echo "$agent"
    else echo "$HOME/$config/agent"; fi
}

# move_transcript PID SID: the absolute path of the transcript session SID is in. A move resumes
# the session by this path, never by its id: `omp --resume <id>` finds only a transcript at the
# top of its working directory's session directory, and a session started from another session's
# turn has its file inside THAT session's directory (METARQ: `…/-Code-personal-theorem/<FRAC's
# session>/<stamp>_01a170d9-….jsonl`), so the id found nothing, in the box or on the host, and the
# moved session ended. In order: the file named `_<SID>.jsonl` the omp holds open under a
# `sessions` directory; its own `--resume` argument when that is such a file; the one file of that
# name under the agent directory its environment selects; else the path the session sweep
# (dispatch://OSSV-240, `omp-session-sql-sweep.timer`) recorded when it imported the file into
# Postgres and deleted it, since it deletes a transcript idle for 6 hours even while its omp
# still runs, and omp resumes such a session by that full path from the table
# (dispatch://INFRA-754). Nothing, when none of them answers.
MOVE_SWEEP_RECORD="${AGENTBOX_SWEEP_RECORD:-$HOME/.local/share/omp-session-sql/deleted.tsv}"
# Set by a command that asks about many sessions (move_to_index_transcripts): a directory holding
# one walk of each agent directory, which move_transcript then reads instead of walking again.
MOVE_DEEP_INDEX_DIR=""
move_to_index_transcripts() {
    # Under agentbox's own cache, not TMPDIR: a session's TMPDIR can be reaped mid-run, and the
    # index went with it (SPEEDCOACH's plan, 2026-11-03). move_exit removes it, so a `move --plan`
    # leaves nothing behind.
    mkdir -p "$MOVE_TO_JOBS/index" 2>/dev/null || true
    MOVE_DEEP_INDEX_DIR="$(mktemp -d -p "$MOVE_TO_JOBS/index" run.XXXXXX 2>/dev/null || mktemp -d)"
}
# Progress of `move --to` before its hand-off: one line a second on stderr naming the step
# (move_step) and the seconds since the start, and a bound (AGENTBOX_MOVE_SCAN_LIMIT, 600 s) after
# which it gives up and says the step it was in. Nothing is hung up before the hand-off, so giving
# up costs nothing. Two leads' dry runs printed nothing for 600 and 900 s (2026-11-03).
MOVE_PROGRESS_FILE="" MOVE_PROGRESS_PID="" MOVE_PROGRESS_START=0
MOVE_SCAN_LIMIT="${AGENTBOX_MOVE_SCAN_LIMIT:-600}"
move_step() { [[ -z "$MOVE_PROGRESS_FILE" ]] || printf '%s\n' "$*" >"$MOVE_PROGRESS_FILE"; }
move_progress_start() {
    local main=$$ limit="$MOVE_SCAN_LIMIT"
    MOVE_PROGRESS_FILE="$(mktemp)"
    MOVE_PROGRESS_START=$SECONDS
    echo "starting" >"$MOVE_PROGRESS_FILE"
    # A limit of 0 means no bound (the tests, and a session that asks for none).
    (( limit > 0 )) || limit=0
    (
        local start=$SECONDS step e
        local st
        while sleep 1; do
            kill -0 "$main" 2>/dev/null || exit 0
            # A main shell that has exited but is not reaped yet is a zombie, which kill -0 still
            # finds; its caller may be waiting for this line's pipe to close before it reaps it.
            st=""; read -r _ _ st _ 2>/dev/null <"/proc/$main/stat" || exit 0
            [[ "$st" != Z ]] || exit 0
            step="$(cat "$MOVE_PROGRESS_FILE" 2>/dev/null)" || exit 0
            e=$((SECONDS - start))
            echo "agentbox: ${e}s: $step" >&2
            if (( limit > 0 && e >= limit )); then
                echo "agentbox: move --to gave up after ${e}s (AGENTBOX_MOVE_SCAN_LIMIT) in: $step; nothing was hung up" >&2
                kill -TERM "$main" 2>/dev/null
                exit 0
            fi
        done
    ) >/dev/null &
    MOVE_PROGRESS_PID=$!
    trap 'MOVE_SAID=1; exit 124' TERM
}
move_progress_stop() {
    [[ -z "$MOVE_PROGRESS_PID" ]] || kill "$MOVE_PROGRESS_PID" 2>/dev/null || true
    [[ -z "$MOVE_PROGRESS_FILE" ]] || rm -f "$MOVE_PROGRESS_FILE"
    MOVE_PROGRESS_PID="" MOVE_PROGRESS_FILE=""
}

# The one EXIT trap of `agentbox move` (cmd_move): it removes the index and the copy's delta
# directory, and for `--to` it says why the command ended when no refusal did. A second
# `trap … EXIT` replaced the first and silenced that message, so nothing else sets one.
MOVE_FORM=""
move_exit() {
    local rc=$?
    move_progress_stop
    [[ -z "$MOVE_DEEP_INDEX_DIR" ]] || rm -rf "$MOVE_DEEP_INDEX_DIR"
    [[ -z "$MOVE_TO_DELTA_DIR" ]] || rm -rf "$MOVE_TO_DELTA_DIR"
    if [[ "$MOVE_FORM" == --to ]] && (( rc != 0 )) && [[ -z "$MOVE_SAID" ]]; then
        echo "agentbox: move --to stopped with exit $rc and no message of its own; nothing was hung up. This is a bug: report it with the command you ran." >&2
    fi
}
move_transcript() {
    local pid="$1" sid="$2" fd link arg found=() dir
    [[ -n "$sid" ]] || return 1
    # One `find` over the descriptors, not a `readlink` fork per descriptor: a lead's omp holds
    # thousands, and at load 500 the forks made a group's plan run for half an hour (2026-11-02).
    # Any path, not only one under a `sessions/` directory: an archived transcript is open at its
    # target under /mnt/durable/<user>/omp-sessions-moved (SPEEDCOACH's 01a16c67, 2026-11-03).
    link="$(find "$PROC/$pid/fd" -maxdepth 1 -type l -lname "/*_${sid}.jsonl" -printf '%l\n' -quit 2>/dev/null || true)"
    if [[ -n "$link" ]]; then printf '%s\n' "$link"; return 0; fi
    # A subagent's transcript it holds open is `<own transcript without .jsonl>/<name>.jsonl`:
    # an idle lead holds only those (01a15237, 2026-11-03).
    link="$(find "$PROC/$pid/fd" -maxdepth 1 -type l -lname "/*_${sid}/*.jsonl" -printf '%l\n' -quit 2>/dev/null || true)"
    if [[ -n "$link" && -e "${link%/*}.jsonl" ]]; then printf '%s\n' "${link%/*}.jsonl"; return 0; fi
    while IFS= read -r -d '' arg; do
        if [[ "$arg" == /*_"$sid".jsonl && -f "$arg" ]]; then printf '%s\n' "$arg"; return 0; fi
    done < <(cat "$PROC/$pid/cmdline" 2>/dev/null || true)
    dir="$(move_agent_dir "$pid")/sessions"
    # Then by name, no deeper than <bucket>/<session dir>/<file>.jsonl, without following symlinks:
    # first in the bucket of the omp's working directory, which omp names after it, then in every
    # bucket, at depth 3 (a subagent's transcript is one level deeper, in its parent's directory). `find -L … -maxdepth 4` over this host's 1,768 buckets, through every subagent log
    # offloaded behind a symlink to /mnt/durable, ran past 20 minutes at load 300 for one idle
    # lead (2026-11-03) and held the whole `move --to` there; a glob at depth 3 took 80 s.
    local cwd bucket
    cwd="$(readlink "$PROC/$pid/cwd" 2>/dev/null || true)"
    if [[ -n "$cwd" ]]; then
        bucket="${cwd#"$HOME"}"
        bucket="-${bucket#/}"
        bucket="${bucket//\//-}"
        found=()
        for link in "$dir/$bucket"/*_"$sid".jsonl; do [[ -e "$link" || -L "$link" ]] && found+=("$link"); done
        if (( ${#found[@]} == 1 )); then printf '%s\n' "${found[0]}"; return 0; fi
    fi
    if [[ -n "$MOVE_DEEP_INDEX_DIR" ]]; then
        # One listing of the buckets for every session a run asks about, kept in a file that the
        # $(…) subshells this is called in share.
        local idx
        idx="$MOVE_DEEP_INDEX_DIR/$(printf '%s' "$dir" | md5sum | cut -c1-16)"
        if [[ ! -e "$idx" ]]; then
            mkdir -p "$MOVE_DEEP_INDEX_DIR" 2>/dev/null || true
            if find "$dir" -mindepth 2 -maxdepth 3 -name '*_*.jsonl' >"$idx.$BASHPID" 2>/dev/null; then
                mv -f "$idx.$BASHPID" "$idx" 2>/dev/null || true
            fi
        fi
        if [[ -r "$idx" ]]; then
            mapfile -t found < <(grep -- "_${sid}\.jsonl\$" "$idx" || true)
        else
            mapfile -t found < <(find "$dir" -mindepth 2 -maxdepth 3 -name "*_${sid}.jsonl" 2>/dev/null)
        fi
    else
        mapfile -t found < <(find "$dir" -mindepth 2 -maxdepth 3 -name "*_${sid}.jsonl" 2>/dev/null)
    fi
    if (( ${#found[@]} == 1 )); then printf '%s\n' "${found[0]}"; return 0; fi
    if [[ -r "$MOVE_SWEEP_RECORD" ]]; then
        # Column 1 of deleted.tsv is the deleted file's path; the last row for the id wins.
        link="$(awk -F'\t' -v s="_${sid}.jsonl" 'length($1) > length(s) && substr($1, length($1) - length(s) + 1) == s { p = $1 } END { print p }' "$MOVE_SWEEP_RECORD" 2>/dev/null || true)"
        if [[ -n "$link" && ! -e "$link" ]]; then printf '%s\n' "$link"; return 0; fi
    fi
    return 1
}

# move_resume_check PID SID SPEC…: refuse BEFORE the hang-up when the box would not find the
# session. Sets MOVE_RESUME to the transcript path and returns 0, or sets MOVE_RESUME_WHY and
# returns 1: no transcript can be read, or the box would not see it (a path outside the home
# allow-list, $SRC, the dotfiles and the --dir paths of SPEC).
MOVE_RESUME="" MOVE_RESUME_WHY=""
move_resume_check() {
    local pid="$1" sid="$2" path real a prev="" d
    shift 2
    MOVE_RESUME="" MOVE_RESUME_WHY=""
    if ! path="$(move_transcript "$pid" "$sid")"; then
        MOVE_RESUME_WHY="no transcript of session $sid can be read (no open file, no --resume path, no single *_${sid}.jsonl under $(move_agent_dir "$pid")/sessions), so the box could not resume it"
        return 1
    fi
    real="$(readlink -f "$path" 2>/dev/null || echo "$path")"
    if move_dir_in_box "$real"; then MOVE_RESUME="$path"; return 0; fi
    for a in "$@"; do
        if [[ "$prev" == --dir ]]; then
            d="$(readlink -f "$a" 2>/dev/null || echo "$a")"
            if move_within "$real" "$d"; then MOVE_RESUME="$path"; return 0; fi
        fi
        prev="$a"
    done
    MOVE_RESUME_WHY="its transcript $real is not in any path the box gets (the home allow-list, \$SRC, the dotfiles, its --dir paths), so the box could not resume it; add its directory with --dir"
    return 1
}

# move_omp_flags PID: every launch flag the omp at PID was started with, in MOVE_OMP_FLAGS, so a
# move resumes the session as `omp <those flags> --resume <transcript>`. The respawn used to be a
# bare `omp --resume <transcript>`: S2 (01a170e0) ran as `omp --config
# /mnt/nvme/sami/frac-verify/omp-bet59.yml --resume <jsonl>`, and its dry run at 12:52Z on
# 2026-11-04 would have brought it back on the wrong configuration.
#
# Nothing here lists the flags to keep. The omp's own argv (/proc/PID/cmdline) is read, and only
# what the move replaces is taken out: the session source (--resume, --session, --continue,
# --fork, …; the move names its own) and positional words, which omp records as a message the
# person typed. Telling a flag's value from a positional needs each flag's arity, which is
# relaunchArgv's job in scripts/agentbox-run.ts, the box runner's restart: one implementation of
# the rule, asked here through bun. An unknown long flag keeps the word after it as its value.
# Returns 1, with MOVE_OMP_FLAGS_WHY, when the argv or bun cannot be read: a move that cannot say
# how the session was launched must not guess, so the caller refuses before the hang-up.
MOVE_OMP_FLAGS=() MOVE_OMP_FLAGS_WHY=""
IFS= read -r -d '' MOVE_OMP_FLAGS_JS <<'JSEOF' || true
const { relaunchArgv } = await import(process.env.AGENTBOX_RUN_TS);
const words = (await Bun.stdin.text()).split("\0");
if (words.at(-1) === "") words.pop();
// argv[0] is the omp executable; relaunchArgv keeps it first and ends with `--resume <sid>`.
const kept = relaunchArgv(["omp", ...words.slice(1)], "-").slice(1, -2);
process.stdout.write(kept.map(w => `${w}\0`).join(""));
JSEOF
move_omp_flags() {
    local pid="$1" bun argv out rc=0
    MOVE_OMP_FLAGS=() MOVE_OMP_FLAGS_WHY=""
    bun="$(command -v bun 2>/dev/null || mise which bun 2>/dev/null || true)"
    if [[ -z "$bun" ]]; then
        MOVE_OMP_FLAGS_WHY="no bun on PATH (nor through mise), which reads omp $pid's launch flags (scripts/agentbox-run.ts relaunchArgv), so they could not be carried"
        return 1
    fi
    # The argv is copied to a regular file first: bun reads a stdin redirected from a /proc file,
    # whose size is 0, as empty (measured on sami-devbox, bun 1.4.4), and the flags would be lost
    # without a word. Both files hold NUL-separated words, as a value may hold spaces or newlines.
    argv="$(mktemp -t agentbox-argv.XXXXXX)" && out="$(mktemp -t agentbox-flags.XXXXXX)" \
        || { MOVE_OMP_FLAGS_WHY="no temporary file for omp $pid's launch flags"; rm -f "${argv:-}"; return 1; }
    if ! cat "$PROC/$pid/cmdline" >"$argv" 2>/dev/null || [[ ! -s "$argv" ]]; then
        rm -f "$argv" "$out"
        MOVE_OMP_FLAGS_WHY="the command line of omp $pid ($PROC/$pid/cmdline) cannot be read, so the flags it was launched with could not be carried"
        return 1
    fi
    AGENTBOX_RUN_TS="$DOTFILES_DIR/scripts/agentbox-run.ts" "$bun" -e "$MOVE_OMP_FLAGS_JS" \
        <"$argv" >"$out" 2>/dev/null || rc=$?
    if (( rc == 0 )); then mapfile -t -d '' MOVE_OMP_FLAGS <"$out"; fi
    rm -f "$argv" "$out"
    if (( rc != 0 )); then
        MOVE_OMP_FLAGS_WHY="reading omp $pid's launch flags with $bun and scripts/agentbox-run.ts failed (exit $rc), so they could not be carried"
        return 1
    fi
    return 0
}

# move_omp_line RESUME FLAG…: the omp command a moved pane runs, quoted for a person to read.
move_omp_line() {
    local resume="$1"
    shift
    printf 'omp%s --resume %s' "$( (( $# )) && printf ' %q' "$@")" "$resume"
}

# move_session_spec PID SID DIR…: the `agentbox new` options a move gives this session - the
# session environment (move_session_env), then `--dir` for each DIR - in MOVE_SPEC, the resume
# check on them (move_resume_check: MOVE_RESUME or MOVE_RESUME_WHY, and its status), and the
# omp's launch flags in MOVE_OMP_FLAGS (move_omp_flags; one it cannot read is a refusal too).
# `--self`, `move <id>` and `--plan` all ask this one function, so the plan shows exactly the
# check a move will run.
MOVE_SPEC=() MOVE_SPEC_FLAGS=()
move_session_spec() {
    local pid="$1" sid="$2" d
    shift 2
    mapfile -t MOVE_SPEC < <(move_session_env "$pid")
    for d in "$@"; do MOVE_SPEC+=(--dir "$d"); done
    move_resume_check "$pid" "$sid" "${MOVE_SPEC[@]}" || return 1
    move_omp_flags "$pid" || { MOVE_RESUME_WHY="$MOVE_OMP_FLAGS_WHY"; return 1; }
}

# One census per run when MOVE_CENSUS_ONCE is on (a `move --to` or `--self` asks it to identify
# the caller and again to read the host; each read costs ~20 s at load 300).
MOVE_CENSUS_ONCE=false MOVE_CENSUS_SAVED="" MOVE_CENSUS_HAVE=false
move_census() {
    if $MOVE_CENSUS_ONCE && $MOVE_CENSUS_HAVE; then
        [[ -z "$MOVE_CENSUS_SAVED" ]] || printf '%s\n' "$MOVE_CENSUS_SAVED"
        return 0
    fi
    if $MOVE_CENSUS_ONCE; then
        MOVE_CENSUS_SAVED="$(move_census_read)"
        MOVE_CENSUS_HAVE=true
        [[ -z "$MOVE_CENSUS_SAVED" ]] || printf '%s\n' "$MOVE_CENSUS_SAVED"
        return 0
    fi
    move_census_read
}
move_census_read() {
    local -A pane_id=() pane_at=() cname=() comm=() ppid=() ctr=() unit=() cwd=() sid=()
    local pids=() files=() pid parent key name value id class detail chain found guard line leaf child
    local server=() panes="" err rc=0
    mapfile -t pids < <(pgrep -x omp 2>/dev/null || true)
    (( ${#pids[@]} )) || return 0
    # 1. the tmux panes, by the pid of each pane's own process (a login shell, normally), on the
    # server of this process's own TMUX when it has one. A failure is said, not hidden: the walk
    # below then reads each omp's pane from its own environment.
    [[ -n "${TMUX:-}" ]] && server=(-S "${TMUX%%,*}")
    err="$(mktemp)"
    panes="$(tmux "${server[@]}" list-panes -a -F "#{pane_pid}"$'\t'"#{pane_id}"$'\t'"#{session_name}:#{window_index}.#{pane_index}" 2>"$err")" || rc=$?
    if (( rc != 0 )); then
        echo "agentbox: \`tmux ${server[*]:+${server[*]} }list-panes -a\` failed (exit $rc): $(head -n 1 "$err"); each omp's pane is read from its own TMUX and TMUX_PANE instead" >&2
        panes=""
    fi
    rm -f "$err"
    while IFS=$'\t' read -r key id name; do
        [[ -n "$key" ]] || continue
        pane_id[$key]="$id"
        pane_at[$key]="$name"
    done <<<"$panes"
    # 2. the container each omp sits in, and the systemd unit of one that sits in no container.
    # A box is a container whose name starts with agentbox-; any other container is a sandbox.
    while read -r id name; do cname[${id:0:12}]="$name"; done < <(docker ps --no-trunc --format '{{.ID}} {{.Names}}' 2>/dev/null || true)
    for pid in "${pids[@]}"; do
        while IFS= read -r line; do
            if [[ -z "${ctr[$pid]:-}" && "$line" =~ docker-([0-9a-f]{12}) ]]; then
                ctr[$pid]="${BASH_REMATCH[1]}"
            fi
            # The DEEPEST unit of the path, not the first: every process of a user manager sits
            # under user@1000.service, which says nothing about what runs it.
            if [[ -z "${unit[$pid]:-}" ]]; then
                leaf="${line%/}"
                while [[ "$leaf" == */* ]]; do
                    case "${leaf##*/}" in
                        *.service|*.scope) unit[$pid]="${leaf##*/}"; break ;;
                    esac
                    leaf="${leaf%/*}"
                done
            fi
        done < <(cat "$PROC/$pid/cgroup" 2>/dev/null || true)
    done
    # 3. each omp's working directory and the session file it holds open, from one `find` over
    # the cwd links and the file-descriptor directories — `find` skips a path that goes away
    # instead of stopping. The session file names its session in FULL; a prefix would resume
    # another session.
    files=()
    for pid in "${pids[@]}"; do files+=("$PROC/$pid/cwd" "$PROC/$pid/fd"); done
    while IFS=$'\t' read -r key name value; do
        case "$name" in
            cwd) cwd[$key]="$value" ;;
            *) [[ -n "${sid[$key]:-}" ]] || sid[$key]="$value" ;;
        esac
    done < <(find "${files[@]}" -maxdepth 1 -type l -printf '%p\t%l\n' 2>/dev/null \
        | sed -n -e "s#^$PROC/\([0-9]\+\)/cwd\t#\1\tcwd\t#p" \
                 -e "s#^$PROC/\([0-9]\+\)/fd/[0-9]\+\t.*/sessions/.*/[0-9T:-]*Z_\([0-9a-f-]\{36\}\)\.jsonl\$#\1\tsid\t\2#p")
    # 4. the session id of an omp that holds no writer on its transcript, from its own `--resume`
    # argument. A session idle after a resume is in that state (the same reason agentbox-run.ts
    # has a second source): 10 of this host's 83 host sessions were, at 16:30Z on 2026-11-01.
    # The argument is the id itself, or the session file, whose name carries the id in full. It
    # is this process's OWN argument, never inherited, unlike an OMP_SESSION_ID read from a
    # descendant (scripts/disk-fill-watch's SOURCE_PHRASE: the environment is the weakest
    # source, and it named 39 unrelated processes as one session on 2026-10-30). Where both a
    # held transcript and a --resume argument existed, all 83 agreed.
    #
    # The id must come from the FILE NAME and from nowhere else in that path, and an id two
    # processes claim is no id at all. Two live omp processes here on 2026-11-01 were resumed
    # from a SUBAGENT transcript, `…/<stamp>_<parent id>/<stamp>_<session id>/ArityLane.jsonl`
    # and `…/GuardLane.jsonl`: a pattern that took the last uuid anywhere in the path would have
    # given both the id of a THIRD, live session, and a move would then have resumed one session
    # in three boxes, each overwriting the others' transcript. So the name must end in
    # `_<id>.jsonl`, and an id claimed more than once goes to the process HOLDING it and to
    # nobody else. The rest are left with no id, which every path here refuses to act on.
    local -A claims=() claimed=()
    for pid in "${pids[@]}"; do
        if [[ -n "${sid[$pid]:-}" ]]; then
            claimed[${sid[$pid]}]=held
            continue
        fi
        # `cat`, not a `<` redirection: a process that exits between pgrep and here makes the
        # shell's own redirection fail, which `set -e` turns into the end of the census (it did,
        # at pid 780324). `|| true` keeps the pipeline's own failure from doing the same.
        claims[$pid]="$(cat "$PROC/$pid/cmdline" 2>/dev/null | tr '\0' '\n' \
            | sed -n -e 's#^.*/[0-9T:-]*Z_\([0-9a-f-]\{36\}\)\.jsonl$#\1#p' \
                     -e 's#^\([0-9a-f]\{8\}-[0-9a-f]\{4\}-[0-9a-f]\{4\}-[0-9a-f]\{4\}-[0-9a-f]\{12\}\)$#\1#p' \
            | head -1 || true)"
        [[ -n "${claims[$pid]}" ]] || continue
        case "${claimed[${claims[$pid]}]:-}" in
            "") claimed[${claims[$pid]}]="$pid" ;;
            *) claimed[${claims[$pid]}]=many ;;
        esac
    done
    for pid in "${pids[@]}"; do
        [[ -n "${claims[$pid]:-}" ]] || continue
        if [[ "${claimed[${claims[$pid]}]}" == "$pid" ]]; then sid[$pid]="${claims[$pid]}"; fi
    done
    for pid in "${pids[@]}"; do
        # omp's own helper processes (`__omp_worker_*`) run the same binary and are not sessions.
        if grep -qa '__omp_worker' "$PROC/$pid/cmdline" 2>/dev/null; then continue; fi
        if [[ -z "${comm[$pid]:-}" ]]; then
            move_stat "$pid" || continue
            comm[$pid]="$MOVE_COMM"
            ppid[$pid]="$MOVE_PPID"
        fi
        class=host
        detail=""
        if [[ -z "${sid[$pid]:-}" && -n "${claims[$pid]:-}" ]]; then
            detail="its --resume names session ${claims[$pid]}, which another live omp holds open or claims too; a move must never resume one session twice"
        fi
        chain=""
        found=0
        name="${ctr[$pid]:-}"
        if [[ -n "$name" ]]; then
            detail="${cname[$name]:-container $name}"
            if [[ "$detail" == agentbox-* ]]; then class=boxed; else class=sandbox; fi
        fi
        parent="${ppid[$pid]}"
        child="$pid"
        guard=0
        while (( guard < 64 )); do
            guard=$((guard + 1))
            [[ -n "$parent" && "$parent" != 0 && "$parent" != 1 ]] || break
            if [[ -n "${pane_id[$parent]:-}" ]]; then found="$parent"; break; fi
            if [[ -z "${comm[$parent]:-}" ]]; then
                move_stat "$parent" || break
                comm[$parent]="$MOVE_COMM"
                ppid[$parent]="$MOVE_PPID"
            fi
            case "${comm[$parent]}" in
                omp)
                    if [[ "$class" == host ]]; then class=subagent; detail="under omp $parent"; fi
                    break
                    ;;
                bwrap)
                    if [[ "$class" == host ]]; then class=sandbox; detail="a bwrap sandbox (pid $parent)"; fi
                    break
                    ;;
                "tmux: server")
                    # A pane's process sits directly under the server. The pane list had no
                    # entry for it (the list-panes above reached no server, or another one, or
                    # spoke another version), so ask the server the omp's own environment names.
                    if [[ "$child" != "$pid" ]] && move_env_pane "$pid" "$child" "$parent"; then
                        pane_id[$child]="$MOVE_PANE_ID"
                        pane_at[$child]="$MOVE_PANE_AT"
                        found="$child"
                    fi
                    chain="$chain ${parent}:${comm[$parent]}"
                    break
                    ;;
            esac
            chain="$chain ${parent}:${comm[$parent]}"
            child="$parent"
            parent="${ppid[$parent]}"
        done
        case "${cwd[$pid]:-}" in
            /work|/work/*)
                class=sandbox
                detail="${detail:-a grading sandbox (/work)}"
                ;;
        esac
        if [[ "$class" == host && "$found" == 0 ]]; then
            class=no-pane
            detail="parent ${ppid[$pid]}:${comm[${ppid[$pid]}]:-?}${chain:+, above${chain}}${unit[$pid]:+, unit ${unit[$pid]}}"
        fi
        printf "%s$SEP%s$SEP%s$SEP%s$SEP%s$SEP%s$SEP%s\n" "$class" "$pid" "${sid[$pid]:-}" \
            "${pane_id[$found]:-}" "${pane_at[$found]:-}" "${cwd[$pid]:-}" "$detail"
    done
}

# One session's row from the census, by full session id or by a unique prefix of it.
move_find() {
    local target="$1" rows=()
    mapfile -t rows < <(move_census | awk -F"$SEP" -v t="$target" '$3 != "" && index($3, t) == 1')
    (( ${#rows[@]} == 1 )) || return 1
    printf '%s\n' "${rows[0]}"
}

cmd_move_plan() {
    local json=false a target="" all=false group=""
    while (( $# )); do
        a="$1"
        case "$a" in
            --json) json=true ;;
            --to) [[ -n "${2:-}" && "$2" != -* ]] || die "--to takes a machine name. $MOVE_USAGE"; target="$2"; shift ;;
            --all) all=true ;;
            --group) [[ -n "${2:-}" && "$2" != -* ]] || die "--group takes a session id or a prefix of one. $MOVE_USAGE"; group="$2"; shift ;;
            --self|--now|--dry-run|--force-floor)
                die "agentbox move --plan takes only --json or --to <machine> [--group <session> | --all]; '$a' belongs to another form of the command. $MOVE_USAGE" ;;
            *) die "agentbox move --plan takes only --json or --to <machine> [--group <session> | --all], not '$a'. $MOVE_USAGE" ;;
        esac
        shift
    done
    if [[ -n "$target" ]]; then
        $json && die "agentbox move --plan --to prints a table only; --json is the plan of moves into boxes here. $MOVE_USAGE"
        [[ -z "$group" ]] || ! $all || die "--group and --all are two different plans; give one. $MOVE_USAGE"
        if $all; then cmd_move_plan_to "$target" all
        elif [[ -n "$group" ]]; then cmd_move_plan_to "$target" group "$group"
        else cmd_move_plan_to "$target" self "${OMP_SESSION_ID:-}"; fi
        return $?
    fi
    $all || [[ -n "$group" ]] && die "--all and --group go with --to <machine>. $MOVE_USAGE"
    # Say what is happening BEFORE the first slow step. Three sessions read this command as a
    # hang on 2026-11-01 and killed it at 45-120 s because it printed nothing at all until the
    # table at the end; one of them ran it three times. Every progress line goes to stderr, so
    # `--json` stays a clean document on stdout.
    echo "agentbox move --plan: reading this host's live omp sessions; progress on stderr, the table at the end." >&2
    local census_rows=() total=0 done_n=0
    mapfile -t census_rows < <(move_census)
    local class pid sid pane at cwd detail spec reason line path why note resume flags_note
    local dirs=() whys=() rows=() why_rows=() blocked=0 movable=0 sids=() refused_sids=()
    local -A counts=([host]=0 [no-pane]=0 [boxed]=0 [sandbox]=0 [subagent]=0)
    for line in "${census_rows[@]}"; do
        IFS="$SEP" read -r class pid sid pane at cwd detail <<<"$line"
        [[ "$class" == host || "$class" == no-pane ]] || continue
        total=$((total + 1))
        [[ -n "$sid" ]] && sids+=("$sid:$pid")
    done
    echo "agentbox: ${#census_rows[@]} live omp processes, $total sessions to read (their processes and their records)." >&2
    # One pass over /proc for every session's process tree, and ONE python run over every
    # session's transcript, in the plan's own shell: each move_dirs_why below runs in a subshell,
    # which inherits what these built.
    move_read_kids
    move_record_prefetch "${sids[@]+"${sids[@]}"}"
    local image dir free floor
    image="$(move_image_bytes "$BOX_DISK_BYTES")"
    dir="$(dirname "$BOXES")"
    free="$(move_free_bytes "$dir")"
    floor="$(move_floor_bytes "$dir")"
    for line in "${census_rows[@]}"; do
        IFS="$SEP" read -r class pid sid pane at cwd detail <<<"$line"
        counts[$class]=$(( ${counts[$class]:-0} + 1 ))
        [[ "$class" == host || "$class" == no-pane ]] || continue
        done_n=$((done_n + 1))
        spec=""
        reason=""
        dirs=()
        whys=()
        while IFS=$'\t' read -r path why; do
            [[ -n "$path" ]] || continue
            dirs+=("$path")
            whys+=("$path"$'\x1f'"$why")
        done < <(move_dirs_why "$cwd" "$pid" "$sid" 2>/dev/null)
        printf 'agentbox: [%d/%d] %s %s -> %d path(s)\n' "$done_n" "$total" "${sid:-pid $pid}" "$cwd" "${#dirs[@]}" >&2
        if (( ${#dirs[@]} )); then
            spec="$(printf -- '--dir %s ' "${dirs[@]}")"
            spec="${spec% }"
            for why in "${whys[@]}"; do
                why_rows+=("${sid:-pid $pid}	${why%%$'\x1f'*}	${why#*$'\x1f'}")
            done
            # The promise. `move --self` reads this back and takes the union with what it sees
            # then, so a path this row gave is never dropped because the process holding it has
            # exited in between (01a1798a, 2026-11-01: the plan gave it
            # /mnt/nvme/sami/tmp/verified-linux, which holds its own state, and the move minutes
            # later gave the cwd alone).
            [[ -n "$sid" ]] && move_plan_write "$sid" "${whys[@]//$'\x1f'/$'\t'}"
        else
            reason="$(move_dirs_why "$cwd" "$pid" "$sid" 2>&1 >/dev/null || true)"
        fi
        if [[ -z "$sid" ]]; then
            reason="${reason:-${detail:-its omp holds no session file open, so a move cannot name it in full}}"
        fi
        # The resume check the move will run, by the same function (move_session_spec), so a
        # person sees before any notice which sessions would not come back. Its spec, session
        # environment included, is the one the row shows.
        resume="" flags_note=""
        if [[ -n "$sid" ]]; then
            if move_session_spec "$pid" "$sid" "${dirs[@]+"${dirs[@]}"}"; then
                resume="resume: $MOVE_RESUME"
                (( ${#MOVE_OMP_FLAGS[@]} )) && flags_note="omp launch flags carried: $(printf '%q ' "${MOVE_OMP_FLAGS[@]}")"
            else
                resume="REFUSED: $MOVE_RESUME_WHY"
                refused_sids+=("$sid")
            fi
            (( ${#MOVE_SPEC[@]} )) && spec="${MOVE_SPEC[*]}"
        fi
        if [[ "$class" == host && -z "$reason" && "$resume" != REFUSED:* ]]; then
            movable=$((movable + 1))
        elif [[ "$class" == host ]]; then
            blocked=$((blocked + 1))
        fi
        # A session with no live child process has nothing for a live scan to read, and a lane
        # that sees two directories must know that before it moves. It goes in the NOTE and never
        # in the refusal reason, which is what decides whether a session can move at all.
        note="${reason:-$detail}"
        if [[ -z "${MOVE_KIDS[$pid]:-}" ]]; then
            note="${note:+$note; }$MOVE_NOTICE_NOKIDS"
        fi
        [[ -z "$flags_note" ]] || note="${note:+$note; }${flags_note% }"
        # What of the session the hang-up ends (move_orphans): the move refuses until it is a unit,
        # is stopped, or the session passes --accept-orphans.
        local orphans
        orphans="$(move_orphans "$pid")"
        [[ -z "$orphans" ]] || note="${note:+$note; }DIES WITH THE MOVE (not a unit; the move refuses without --accept-orphans): $(move_orphans_list "$orphans")"
        line="$(printf '%s\x1e' "${whys[@]+"${whys[@]}"}")"
        rows+=("$class	$sid	$pid	$pane	$at	$cwd	${spec:--}	$(move_gib "$image")	$note	${resume:--}	${line%$'\x1e'}")
    done
    local new_total=$((movable * image))
    if $json; then
        jq -Rn --argjson summary "$(jq -n \
                --argjson movable "$movable" --argjson blocked "$blocked" --argjson refused "${#refused_sids[@]}" \
                --argjson nopane "${counts[no-pane]:-0}" --argjson boxed "${counts[boxed]:-0}" \
                --argjson sandbox "${counts[sandbox]:-0}" --argjson subagent "${counts[subagent]:-0}" \
                --argjson image "$image" --argjson total "$new_total" --argjson free "$free" --argjson floor "$floor" \
                '{movable: $movable, blocked: $blocked, resume_refused: $refused, not_a_pane: $nopane,
                  already_boxed: $boxed, sandboxes: $sandbox, subagents: $subagent, new_disk_per_box_bytes: $image,
                  new_disk_total_bytes: $total, free_bytes: $free, floor_bytes: $floor,
                  headroom_bytes: ($free - $floor - $total)}')" \
            '{summary: $summary, sessions: [inputs | split("\t") |
                {class: .[0], session: .[1], pid: (.[2] | tonumber), pane: .[3], tmux: .[4],
                 cwd: .[5], spec: .[6], new_disk_gib: (.[7] | tonumber), note: .[8],
                 resume: (if (.[9] | startswith("resume: ")) then .[9][8:] else null end),
                 resume_refused: (if (.[9] | startswith("REFUSED: ")) then .[9][9:] else null end),
                 dirs: (if (.[10] // "") == "" then []
                        else (.[10] | split("\u001e") | map(split("\u001f") | {path: .[0], why: .[1]})) end)}]}' \
            < <(printf '%s\n' "${rows[@]}")
        return 0
    fi
    echo "agentbox move --plan: $(hostname -s), $(date -u +%FT%TZ)"
    echo
    { echo "CLASS	SESSION	PID	PANE	TMUX	CWD	SPEC	NEW-GiB	NOTE	RESUME"
      printf '%s\n' "${rows[@]}" | cut -f1-10 | sort -t$'\t' -k1,1 -k6,6
    } | column -t -s $'\t'
    echo
    if (( ${#why_rows[@]} )); then
        echo "each path and why the box gets it (a path under $SRC, the dotfiles or the home allow-list is"
        echo "in every box already and is never listed - a worktree under $SRC/<repo>/.worktrees/... included):"
        { echo "SESSION	PATH	WHY"
          printf '%s\n' "${why_rows[@]}"
        } | column -t -s $'\t'
        echo
    fi
    echo "host sessions outside a box: $((movable + blocked)) ($movable with a spec, $blocked that need a decision)"
    echo "resume check: ${#refused_sids[@]} REFUSED, would not come back in a box and are not moved${refused_sids[*]:+: ${refused_sids[*]}}"
    echo "not a pane (headless or unit-run, yours to decide): ${counts[no-pane]:-0}"
    echo "excluded: ${counts[boxed]:-0} already in a box, ${counts[sandbox]:-0} in a grading sandbox, ${counts[subagent]:-0} subagents of another omp"
    echo "new disk: $(move_gib "$image") GiB per box (its sparse ext4 image; a move clones nothing), $(move_gib "$new_total") GiB for $movable boxes"
    echo "$dir: $(move_gib "$free") GiB free − $(move_gib "$floor") GiB reserve − $(move_gib "$new_total") GiB = $(move_gib $((free - floor - new_total))) GiB left over"
    echo "a path the inference missed is added by the session itself: agentbox move --self --dir PATH"
}

# The omp process a command runs under: the nearest ancestor whose command is omp.
move_own_omp() {
    local p="${1:-$$}" guard=0
    while (( guard < 64 )); do
        guard=$((guard + 1))
        [[ -r "$PROC/$p/stat" ]] || return 1
        if [[ "$(cat "$PROC/$p/comm" 2>/dev/null || true)" == omp ]]; then echo "$p"; return 0; fi
        p="$(awk '{ i = index($0, ") "); split(substr($0, i + 2), g, " "); print g[2] }' "$PROC/$p/stat" 2>/dev/null || true)"
        [[ -n "$p" && "$p" != 0 && "$p" != 1 ]] || return 1
    done
    return 1
}

# The detached step, and the only one that touches a session: hang omp up, wait for its teardown,
# respawn its pane into the launcher. `move --self` runs in the session's own bash tool, which
# dies with the omp it hangs up, and `--now` must not hold the caller's terminal for a minute per
# session, so both hand this to a process of their own.
move_hand_off() {
    local sid="$2" log="${XDG_CACHE_HOME:-$HOME/.cache}/omp/agentbox/move-$2.log"
    mkdir -p "$(dirname "$log")"
    local before=0
    [[ -f "$log" ]] && before="$(wc -c <"$log")"
    # A PRIVATE COPY of this file, not the file itself. The relauncher waits up to 180 s for
    # omp's teardown, and ~/.dotfiles is production: every publish REPLACES this script on disk
    # while sessions are using it. Bash reads a script incrementally by byte offset, so a file
    # swapped under a running one makes it read the new bytes from the old offset and die where
    # it stands, silently.
    #
    # That is what happened on 2026-11-05. FRAC's relauncher started at 08:27:25Z and BASELINE's
    # at 08:29:05Z, both logged "hung up; waiting for its teardown", and this file was rewritten
    # at 08:30:17Z by a publish. Both were inside the sleep loop; neither logged another line,
    # and the loop always logs on exit. Two leads sat at a shell with their omp hung up until a
    # person respawned their panes. The copy is removed when the relauncher ends.
    #
    # By absolute path, not $0: the relauncher outlives a caller that was started by a relative
    # path from a directory the pane is about to leave.
    local run_copy
    run_copy="$(mktemp "${TMPDIR:-/tmp}/agentbox-relaunch-XXXXXX")" || return 1
    cat "$(readlink -f "${BASH_SOURCE[0]}")" >"$run_copy" && chmod +x "$run_copy" || {
        rm -f "$run_copy"
        return 1
    }
    # The wrapper RUNS the copy rather than exec-ing it, and removes it on the way out: `exec`
    # replaces the shell, which discards the trap and leaks the copy (measured).  Its own script
    # text is an argument to `bash -c`, so the wrapper itself is in memory.
    #
    # `--fork` IS WHAT MAKES THE RELAUNCHER SURVIVE THE HANG-UP IT PERFORMS, and without it this
    # strands the session it is moving. Measured 2026-11-05 over 32 observations on two omp
    # builds: omp's hang-up teardown SIGTERMs what is still reachable from it BY PARENT LINK,
    # and `setsid` alone changes session and process group but NOT the parent -- so a plain
    # setsid child is killed 86 ms to 2.2 s after the hang-up and, in every case, BEFORE the omp
    # itself exits (fastest: 94 ms). `setsid --fork` makes the child's ppid 1 before it runs
    # anything, and was never once touched, 4 of 4, on both builds. That is how FRAC and
    # BASELINE were stranded at 08:27:25Z and 08:29:05Z: each relauncher hung its omp up and was
    # dead ~2 s later, three minutes before the publish I first blamed. The sibling `move --to`
    # path already used --fork for a different symptom of the same thing (line ~7785).
    setsid --fork bash -c 'c="$1"; shift; trap '"'"'rm -f "$c"'"'"' EXIT; "$@"' _ "$run_copy" \
        "$run_copy" move --relaunch "$@" </dev/null >>"$log" 2>&1 &
    local child=$!
    # It must be RUNNING before this says so: LANE-C's `move --self` returned 0 twice and nothing
    # ever moved (2026-11-03). The relauncher's first line is its own; waiting for the log to grow
    # also catches a relauncher that dies at once (setsid itself exits straight away, so its pid
    # says nothing).
    local waited=0
    while (( waited < MOVE_HAND_OFF_WAIT )); do
        if [[ -f "$log" ]] && (( $(wc -c <"$log") > before )); then
            echo "agentbox: session $sid handed to a detached relauncher; log: $log"
            return 0
        fi
        sleep 1
        waited=$((waited + 1))
    done
    wait "$child" 2>/dev/null || true
    die "the relauncher of session $sid wrote nothing to $log within ${MOVE_HAND_OFF_WAIT}s, so the move did NOT start; nothing was hung up. Read that log and tell the box-health lead"
}
# How long move_hand_off waits for its relauncher's first line.
MOVE_HAND_OFF_WAIT="${AGENTBOX_HAND_OFF_WAIT:-30}"

# How long the respawn below keeps trying, and the gap between tries. Ten minutes: what it rides
# out is the machine's, and the relauncher is detached, so nothing waits on it.
MOVE_RESPAWN_TRIES="${AGENTBOX_RESPAWN_TRIES:-40}"
MOVE_RESPAWN_WAIT="${AGENTBOX_RESPAWN_WAIT:-15}"

# Respawn a moved session's pane into its box launcher. The session is already hung up when this
# runs, so a tmux that cannot fork right now destroys it: on 2026-11-01 four moves at 17:47-17:48Z
# got `fork failed: No such device`, left their panes with no process, and ended three sessions for
# good - a send to one of them was still refused `no live session` at 21:08Z - and the only record
# of any of it was this move's log, which nobody reads (dispatch://INFRA-950). Moves ten minutes
# later forked normally, so a failure here is ridden out rather than taken as final: it tries
# again, then types the launcher into the shell the pane still runs, which needs no pty of tmux's,
# and when the pane has no process either it says so in the pane's title, since such a pane keeps
# showing the dead session's last screen and looks alive. It returns 1 when the pane is there and
# refuses, 3 when two omp hold the session after it, and 2 when the server does not have the pane
# at all, which no retry can change: R3A's
# rollback retried a gone pane 40 times over ten minutes of downtime, and its caller's own
# fallback, a window of its own, never ran (2026-11-03).
# move_one_omp SID [WAIT]: wait up to WAIT seconds (default MOVE_ONE_OMP_WAIT) until exactly one
# live omp on THIS machine runs SID, and print those pids when more than one is left. `tmux
# respawn-pane -k` does not always end the old omp before the new one starts, and the session
# then ran twice (the INFRA-681 double loop); a respawn waits for the old one before it reports
# success. Status 0 when one or none runs, 1 when more than one does.
MOVE_ONE_OMP_WAIT="${AGENTBOX_ONE_OMP_WAIT:-60}"
move_one_omp() {
    local sid="$1" wait_for="${2:-$MOVE_ONE_OMP_WAIT}" waited=0 running
    while :; do
        running="$(move_to_running "" "$sid")"
        (( $(grep -c . <<<"${running:-}") <= 1 )) && return 0
        (( waited < wait_for )) || break
        sleep 1
        waited=$((waited + 1))
    done
    printf '%s\n' "$running"
    return 1
}

move_respawn() {
    local sid="$1" pane="$2" cwd="$3" inner="$4" what="$5" attempt=0 err run two
    # An interactive bash, as scripts/agent-new starts a pane: the box launcher needs the
    # session environment .bashrc sets up (shims first on PATH). The shell that stays behind is
    # what makes a box that ends leave a usable pane instead of a dead one.
    run="$inner; echo; echo 'agentbox: the box has exited; this pane is a shell again'; exec bash -i"
    while (( attempt < MOVE_RESPAWN_TRIES )); do
        attempt=$((attempt + 1))
        local run_file
        run_file="$(move_pane_script "$sid" "$run")" || run_file=""
        if err="$(if [[ -n "$run_file" ]]; then
                "$MOVE_TMUX_BIN" "${MOVE_TMUX[@]}" respawn-pane -k -t "$pane" -c "$cwd" bash -i "$run_file" 2>&1
            else
                "$MOVE_TMUX_BIN" "${MOVE_TMUX[@]}" respawn-pane -k -t "$pane" -c "$cwd" bash -i -c "$run" 2>&1
            fi)"; then
            echo "$(date -u +%FT%TZ) move $sid: pane $pane respawned into agentbox new $what"
            if ! two="$(move_one_omp "$sid")"; then
                echo "$(date -u +%FT%TZ) move $sid: TWO omp processes hold this session after the respawn: $(tr '\n' ' ' <<<"$two"); end the older one by its pid" >&2
                return 3
            fi
            return 0
        fi
        echo "$(date -u +%FT%TZ) move $sid: respawn of pane $pane failed (try $attempt of $MOVE_RESPAWN_TRIES): ${err:-tmux printed nothing}"
        case "$err" in
            *"find pane"*|*"no such pane"*|*"pane not found"*)
                echo "$(date -u +%FT%TZ) move $sid: pane $pane is gone from its server; not retried"
                return 2
                ;;
        esac
        if (( attempt < MOVE_RESPAWN_TRIES )); then sleep "$MOVE_RESPAWN_WAIT"; fi
    done
    if [[ -n "$("$MOVE_TMUX_BIN" "${MOVE_TMUX[@]}" display-message -p -t "$pane" '#{pane_pid}' 2>/dev/null)" ]] \
        && "$MOVE_TMUX_BIN" "${MOVE_TMUX[@]}" send-keys -t "$pane" "$inner" Enter 2>/dev/null; then
        echo "$(date -u +%FT%TZ) move $sid: pane $pane would not respawn; the launcher was typed into the shell it still runs"
        return 0
    fi
    "$MOVE_TMUX_BIN" "${MOVE_TMUX[@]}" select-pane -t "$pane" -T "agentbox: session $sid is down; pane $pane would not respawn" 2>/dev/null || true
    return 1
}

# The resumed session gets no prompt. A positional after `--resume <id>` is a user message to omp,
# so the `.` that used to wake it was recorded as text the person typed: the transcript store
# counted it so for 33 moved sessions from 18:50Z on 2026-11-01 (found by the librarian). Without
# it the session sits at its prompt until something arrives, so the wake is an Envoy notice
# instead, which omp records as a custom message. The waker runs on the host beside the launcher,
# from the pane command (move_pane_command), so a move from a box, whose own processes end with
# that box, wakes its session too. It waits for the session's NEW process to register (an Envoy
# update after the waker started, when the old omp is already gone) and sends the notice once.
# %HOST% is the machine the session now runs on, filled in where the waker runs. A rollback passes
# its own text (MOVE_PANE_WAKE_NOTICE): S3 was told "the move is done" at 03:57:58Z on 2026-11-04
# when its move had failed and it was resumed back on the machine it started on.
MOVE_WAKE_NOTICE='agentbox: the move is done: this session was resumed in its agent box on %HOST%. Go on with the work you were doing before the move. (An automated notice from agentbox, not a person.)'
# The waker polls fast for MOVE_WAKE_WAIT seconds (every 5 s), then slowly (every
# MOVE_WAKE_SLOW) until MOVE_WAKE_TOTAL, because a box that is slow to come up is the normal
# case on a loaded host and not a reason to leave a session asleep: after the 17:0xZ resumes on
# 2026-11-04, 76 of 83 wake logs in ~/.cache/omp/agentbox ended in the give-up line (35 at
# 17:09Z alone) and each of those sessions then sat at its prompt for about an hour, about 70
# agent-hours in one afternoon. A poll costs one `envoy ps --json` (0.34 s on this host,
# measured 2026-11-04) and nothing else: the /proc census of move_wake_landed, 5.7 s here, runs
# only after a registration newer than the waker is seen, so it is paid once. At 60 s the slow
# phase costs a twelfth of what the fast phase costs, and 90 waiting sessions together spend
# about half a core.
MOVE_WAKE_WAIT="${AGENTBOX_WAKE_WAIT:-600}"
MOVE_WAKE_SLOW="${AGENTBOX_WAKE_SLOW:-60}"
MOVE_WAKE_TOTAL="${AGENTBOX_WAKE_TOTAL:-7200}"
# move_wake_landed SID: true when the session really is running HERE - an omp of its own on this
# machine (scripts/omp-session-live, which reads a box's processes too) and no move marker saying
# it left this machine.
move_wake_landed() {
    local sid="$1" marker="$MOVE_MARKER_INDEX/$sid" here
    # The census of THIS machine (one scan of /proc), which sees a box's omp too.
    [[ -n "$(move_to_running "" "$sid" 2>/dev/null)" ]] || return 1
    if [[ -r "$marker" ]]; then
        here="${AGENTBOX_HOST:-$(hostname -s)}"
        [[ "$(sed -n 's/^from=//p' "$marker" | head -1)" == "$here" ]] && return 1
    fi
    return 0
}
# box_registered SID SINCE: the one test for "the resumed session is up HERE" - an Envoy
# registration of SID newer than SINCE (epoch milliseconds) and an omp of it on this machine.
# The wake sends its notice on it; the predecessor reaper removes an old box only on it, so a
# box that never comes up removes nothing.
box_registered() {
    local sid="$1" since="$2" seen
    seen="$(envoy ps --json 2>/dev/null | jq -r --arg s "$sid" \
        '[(if type == "array" then . else (.sessions // []) end)[] | select(.session_id == $s) | .updated_at // 0] | max // 0' 2>/dev/null || true)"
    # An Envoy registration says the session is up SOMEWHERE: R3A's rolled-back copy on its old
    # machine registered, and its move sent "the move is done" although nothing had been hung up
    # (01:39Z, 2026-11-04). So the registration must be this machine's.
    (( ${seen:-0} > since )) && move_wake_landed "$sid"
}
move_wake() {
    # The notice is the move's unless the caller names its own (agentbox-run.ts: a restart's).
    local sid="$1" notice="${2:-$MOVE_WAKE_NOTICE}" since waited=0 step=5 slow_said=false
    notice="${notice//%HOST%/${AGENTBOX_HOST:-$(hostname -s)}}"
    since="$(date +%s%3N)"
    while (( waited < MOVE_WAKE_TOTAL )); do
        if box_registered "$sid" "$since" \
            && envoy_send_text --source envoy "$sid" "$notice" >/dev/null; then
            echo "$(date -u +%FT%TZ) move $sid: the resumed session registered on Envoy; wake notice sent"
            return 0
        fi
        # The slow phase: the box is taking longer than a healthy one does, which is not a
        # reason to stop waiting for it. Said once, so a reader of the log sees the stall and
        # when it began.
        if (( waited >= MOVE_WAKE_WAIT )) && ! $slow_said; then
            step="$MOVE_WAKE_SLOW"
            slow_said=true
            echo "$(date -u +%FT%TZ) move $sid: still not registered after ${MOVE_WAKE_WAIT}s; this box is slow to come up. Polling every ${MOVE_WAKE_SLOW}s now, up to ${MOVE_WAKE_TOTAL}s in all"
        fi
        sleep "$step"
        waited=$((waited + step))
    done
    echo "$(date -u +%FT%TZ) move $sid: the resumed session did not register on Envoy within ${MOVE_WAKE_TOTAL}s; no wake notice sent, so it waits at its prompt until something reaches it"
    return 1
}

# The command a moved pane runs: the waker in the background and the box launcher resuming the
# session with no prompt, by RESUME: the transcript's path (move_transcript), which omp opens
# wherever it is, and which the box sees at the same path. This file by its absolute path too.
# move_spec_usable SPEC…: the spec with every --dir `agentbox new` would refuse left out (/tmp
# and the other roots no box may be given, a path that is gone). R3A's rollback respawned its pane
# with the box's old list, which held /tmp; `agentbox new` refused the whole launch and the pane
# sat at a shell for six minutes (01:44-01:50Z, 2026-11-04). The FIRST --dir is where the box
# works, so one that is refused is still named: a resume without it is not that session's.
move_spec_usable() {
    local first=true out=() i=1 d
    local -a spec=("$@")
    # MOVE_SPEC_KEEP_GONE=1: a path that is absent HERE is kept (the target decides against its
    # own disk with --drop-gone-dirs); a path a box may never be given is dropped either way.
    #
    # A --dir is dropped WITH its value, and a word that is neither a flag nor a flag's value is
    # dropped too: `agentbox new` reads a bare path as a repository name and refuses the whole
    # launch ("no checkout /home/sami/src//mnt/nvme/sami/gate-briefs"), so LANE-E's rollback box
    # exited at once and the session was down on both machines until a person respawned it
    # (03:57:42Z, 2026-11-04). Whatever shape the spec arrives in, nothing but flags and their
    # own values leaves here.
    while (( i <= ${#spec[@]} )); do
        d="${spec[i-1]}"
        case "$d" in
            --dir)
                local value="${spec[i]:-}"
                # A --dir followed by another flag has no path: only it is dropped, and the flag
                # is read next. LANE-E's job spec held `--dir --dir /mnt/nvme/sami/gate-briefs`
                # three times (a hand edit cut three paths and left their --dir words, 00:26Z
                # 2026-11-04); taking the second --dir as the first one's path dropped "--dir" and
                # then gate-briefs and midrun as bare words, so its box lacked both.
                if [[ -z "$value" || "$value" == -* ]]; then
                    echo "agentbox: a --dir with no path is left out of this resume" >&2
                    i=$((i + 1))
                    continue
                fi
                i=$((i + 2))
                if $first; then
                    first=false
                elif { [[ ! -d "$value" ]] && [[ -z "${MOVE_SPEC_KEEP_GONE:-}" ]]; } || move_dir_too_broad "$value"; then
                    echo "agentbox: --dir $value is left out of this resume: a box may not be given it" >&2
                    continue
                fi
                out+=(--dir "$value")
                ;;
            -e)
                out+=(-e "${spec[i]:-}")
                i=$((i + 2))
                ;;
            -*)
                out+=("$d")
                i=$((i + 1))
                ;;
            *)
                # Not a flag and not consumed as one's value: `agentbox new` would read it as a
                # repository. It is named and left out.
                echo "agentbox: $d is left out of this resume: it is not a flag or a flag's value, and \`agentbox new\` would read it as a repository" >&2
                i=$((i + 1))
                ;;
        esac
    done
    printf '%s\n' ${out[@]+"${out[@]}"}
}

# move_split_flags SPEC… [-- FLAG…]: the `agentbox new` options before the first `--` in
# MOVE_SPLIT_SPEC and the omp launch flags after it (move_omp_flags) in MOVE_SPLIT_FLAGS. A spec
# word is never `--` itself: it holds -e NAME=VALUE, --dir PATH and launcher flags.
MOVE_SPLIT_SPEC=() MOVE_SPLIT_FLAGS=()
move_split_flags() {
    MOVE_SPLIT_SPEC=() MOVE_SPLIT_FLAGS=()
    while (( $# )) && [[ "$1" != -- ]]; do MOVE_SPLIT_SPEC+=("$1"); shift; done
    (( $# )) && shift
    MOVE_SPLIT_FLAGS=("$@")
}

# move_pane_command SID RESUME SPEC… [-- FLAG…]: the line a moved pane runs; FLAG… are the omp's
# own launch flags (move_omp_flags), given back to it before `--resume`.
move_pane_command() {
    local sid="$1" resume="$2" log
    shift 2
    local -a usable=() flags=()
    move_split_flags "$@"
    flags=(${MOVE_SPLIT_FLAGS[@]+"${MOVE_SPLIT_FLAGS[@]}"})
    mapfile -t usable < <(move_spec_usable ${MOVE_SPLIT_SPEC[@]+"${MOVE_SPLIT_SPEC[@]}"})
    set -- ${usable[@]+"${usable[@]}"}
    # The waker runs on the host after this box closes. XDG_CACHE_HOME belongs to the old box
    # and close_box removes it; ~/.cache/omp is a shared mount that survives the move. Make its
    # parent now: a failed shell redirection prevents the waker from starting at all.
    log="$HOME/.cache/omp/agentbox/move-$sid.log"
    mkdir -p "$(dirname "$log")" || return 1
    # MOVE_PANE_WAKE_NOTICE: the notice the session gets when it is up again, when the caller has
    # its own (a rollback); else the waker's own "the move is done".
    printf '( setsid %q move --wake %q%s </dev/null >>%q 2>&1 & ); %s' \
        "$(readlink -f "${BASH_SOURCE[0]}")" "$sid" "${MOVE_PANE_WAKE_NOTICE:+ $(printf '%q' "$MOVE_PANE_WAKE_NOTICE")}" "$log" \
        "$(printf '%q ' agentbox new --drop-gone-dirs "$@" -- omp ${flags[@]+"${flags[@]}"} --resume "$resume")"
}

# The tmux server a relauncher drives its pane through: `-S <socket>` from the TARGET omp's own
# TMUX, read before the hang-up while its /proc entry still exists, and that server's own binary
# (move_tmux_bin, from the pid TMUX names). The relauncher of `--all`, `move <id>`, `--now` or
# `--self` runs in the caller's environment, and a caller whose TMUX is unset or names another
# server talks to tmux's default socket, where this host's server is not
# (/tmp/tmux-1000/default against ~/.tmux/sockets/tmux-1000/default on 2026-11-02), while one
# whose PATH finds another tmux version cannot talk to the server at all. Empty, it is the
# caller's own server and tmux, as before.
MOVE_TMUX=()
move_target_tmux() {
    local kv tmuxv="" rest=""
    MOVE_TMUX=()
    while IFS= read -r -d '' kv; do
        [[ "$kv" == TMUX=* ]] && tmuxv="${kv#TMUX=}"
    done < <(cat "$PROC/$1/environ" 2>/dev/null || true)
    [[ -n "$tmuxv" ]] && MOVE_TMUX=(-S "${tmuxv%%,*}")
    [[ "$tmuxv" == *,* ]] && rest="${tmuxv#*,}"
    move_tmux_bin "${rest%%,*}"
    return 0
}

# move_relaunch PID SID PANE CWD RESUME SPEC… [-- FLAG…]
move_relaunch() {
    local pid="$1" sid="$2" pane="$3" cwd="$4" resume="$5" waited=0 inner omp_line
    shift 5
    move_split_flags "$@"
    local spec=(${MOVE_SPLIT_SPEC[@]+"${MOVE_SPLIT_SPEC[@]}"}) flags=(${MOVE_SPLIT_FLAGS[@]+"${MOVE_SPLIT_FLAGS[@]}"})
    omp_line="$(move_omp_line "$resume" ${flags[@]+"${flags[@]}"})"
    echo "$(date -u +%FT%TZ) move $sid: pid $pid, pane $pane, cwd $cwd, resume $resume, spec ${spec[*]}, omp line $omp_line"
    move_target_tmux "$pid"
    echo "$(date -u +%FT%TZ) move $sid: tmux server ${MOVE_TMUX[1]:-from the environment of this process}, client $MOVE_TMUX_BIN"
    # Pids are reused: never signal one that is no longer this session's omp.
    if [[ "$(cat "$PROC/$pid/comm" 2>/dev/null || true)" == omp ]]; then
        kill -HUP "$pid" 2>/dev/null || true
        echo "$(date -u +%FT%TZ) move $sid: omp $pid hung up; waiting for its teardown"
        while (( waited < 180 )) && kill -0 "$pid" 2>/dev/null; do
            sleep 1
            waited=$((waited + 1))
        done
    fi
    if kill -0 "$pid" 2>/dev/null; then
        echo "$(date -u +%FT%TZ) move $sid: omp $pid is still up after ${waited}s; the respawn ends it"
    else
        echo "$(date -u +%FT%TZ) move $sid: omp $pid exited after ${waited}s"
    fi
    # The answer, not the exit code: tmux 3.8 answers display-message for a pane that no longer
    # exists with exit 0 and an empty line (measured 2026-11-02), so for the closed pane %1665 of a
    # drill session at 15:19:08Z this test passed and each respawn try then failed `can't find
    # pane` for 10 minutes, as for 01a16c67's pane %74 at 10:20:48-10:32:00Z.
    if [[ -z "$("$MOVE_TMUX_BIN" "${MOVE_TMUX[@]}" display-message -p -t "$pane" '#{pane_id}' 2>/dev/null)" ]]; then
        echo "$(date -u +%FT%TZ) move $sid: pane $pane is gone; nothing respawned. Resume it by hand: agentbox new ${spec[*]} -- $omp_line"
        return 1
    fi
    # The launcher leaves out a --dir that is gone, or is not a directory, by the time it runs
    # (--drop-gone-dirs), since a respawn can come ten minutes after the spec was read. This log
    # says which, as the pane's own lines reach nobody.
    local i
    for ((i = 0; i + 1 < ${#spec[@]}; i++)); do
        [[ "${spec[i]}" == --dir ]] || continue
        if [[ ! -e "${spec[i+1]}" ]]; then
            echo "$(date -u +%FT%TZ) move $sid: --dir ${spec[i+1]} no longer exists; the box starts without it"
        elif [[ ! -d "${spec[i+1]}" ]]; then
            echo "$(date -u +%FT%TZ) move $sid: --dir ${spec[i+1]} is not a directory; the box starts without it"
        fi
    done
    inner="$(move_pane_command "$sid" "$resume" ${spec[@]+"${spec[@]}"} -- ${flags[@]+"${flags[@]}"})"
    if ! move_respawn "$sid" "$pane" "$cwd" "$inner" "${spec[*]}"; then
        echo "$(date -u +%FT%TZ) move $sid: pane $pane holds no process and would not respawn; the session is DOWN. Bring it back from a host session: $MOVE_TMUX_BIN ${MOVE_TMUX[*]:+${MOVE_TMUX[*]} }respawn-pane -k -t $pane -c $cwd bash -i -c '$inner; exec bash -i'"
        return 1
    fi
}

# move_orphans OMP [CALLER]: "<pid>\t<descendants>\t<command line>" for each process the session
# started that dies with the hang-up: every live process under its omp but omp's own helpers (the
# worker broker, the python runner; what they start is listed) and the move command's own chain
# (CALLER, its ancestors and descendants). A server, a watcher or a dashboard started from a tool
# call is a child of the omp, and a hang-up ends it: KNOTCURVE's dashboard, started by hand from
# its session, died with the move at 16:21Z on 2026-11-02 and was down about four hours. One row
# per top process, with how many processes are under it. A process `setsid` detached - its own
# session leader, so the pane's hang-up does not reach it - is not an orphan, and neither is what
# it started; nor is a systemd unit, which is not under the omp at all.
move_orphans() {
    local omp="$1" caller="${2:-}" p q cmd n
    local -A skip=()
    move_read_kids
    if [[ -n "$caller" ]]; then
        p="$caller"
        while [[ -n "$p" && "$p" != "$omp" && "$p" != 0 && "$p" != 1 ]]; do
            skip[$p]=1
            move_stat "$p" || break
            p="$MOVE_PPID"
        done
        while IFS= read -r q; do skip[$q]=1; done < <(move_descendants "$caller")
    fi
    local queue=() i=0
    read -r -a queue <<<"${MOVE_KIDS[$omp]:-}"
    while (( i < ${#queue[@]} )); do
        p="${queue[i]}"
        i=$((i + 1))
        # Read by the shell itself, not a `tr` fork per process.
        cmd=""
        if [[ -r "$PROC/$p/cmdline" ]]; then
            local parts=()
            mapfile -d '' -t parts 2>/dev/null <"$PROC/$p/cmdline" || true
            cmd="${parts[*]}"
        fi
        [[ -n "$cmd" ]] || continue
        case "$cmd" in
            *__omp_worker*|*/omp-python-runner*/runner-*.py*) skip[$p]=helper ;;
        esac
        # Field 6 of /proc/<pid>/stat is the session id: its own means `setsid`, and SIGHUP of the
        # pane's session does not reach it.
        if [[ -z "${skip[$p]:-}" ]]; then
            local stat_line sess
            if stat_line="$(<"$PROC/$p/stat")" 2>/dev/null; then
                stat_line="${stat_line##*) }"
                set -- $stat_line
                sess="${4:-}"
                [[ "$sess" == "$p" ]] && skip[$p]=detached
            fi
        fi
        if [[ -n "${skip[$p]:-}" ]]; then
            # A detached process takes its own children with it: the hang-up reaches none of them.
            # omp's helpers and the move's own chain do not, so what they started is still listed.
            if [[ "${skip[$p]}" != detached ]]; then
                read -r -a q <<<"${MOVE_KIDS[$p]:-}"
                queue+=(${q[@]+"${q[@]}"})
            fi
            continue
        fi
        n="$(move_descendants "$p" | wc -l)"
        # Whose it is, when its own environment says so: a subagent's bash tool and an eval
        # runner carry the session they belong to, so a lead sees which of its sessions to ask.
        local owner=""
        if [[ -r "$PROC/$p/environ" ]]; then
            local kv
            while IFS= read -r -d "" kv; do
                case "$kv" in
                    OMP_SESSION_ID=*) owner="${kv#OMP_SESSION_ID=}" ;;
                    PI_SESSION_FILE=*) [[ -n "$owner" ]] || { owner="${kv#PI_SESSION_FILE=}"; owner="${owner##*/}"; owner="${owner%.jsonl}"; } ;;
                esac
            done <"$PROC/$p/environ"
        fi
        printf '%s\t%s\t%s\t%s\n' "$p" "$((n - 1))" "${cmd% }" "$owner"
    done
}

# The rows of move_orphans as one line a person reads.
move_orphans_list() {
    awk -F'\t' '{ printf "%s%s (pid %s%s%s)", (NR > 1 ? "; " : ""), $3, $1,
        ($2 > 0 ? ", " $2 " under it" : ""), ($4 != "" ? ", of session " $4 : "") }' <<<"$1"
}

# move_orphans_gate OMP CALLER DRY: say what of the session dies with the hang-up; return 1 with
# MOVE_ORPHANS_WHY unless there is nothing, the caller passed --accept-orphans, or this is a
# dry run (which only says it).
MOVE_ACCEPT_ORPHANS=false
MOVE_ORPHANS_WHY=""
move_orphans_gate() {
    local orphans list
    MOVE_ORPHANS_WHY=""
    orphans="$(move_orphans "$1" "$2")"
    [[ -n "$orphans" ]] || return 0
    list="$(move_orphans_list "$orphans")"
    # WHY, settled by measurement on 2026-11-05 (32 observations, two omp builds): omp's
    # hang-up teardown SIGTERMs what is still reachable from it BY PARENT LINK. `setsid` alone
    # changes session and process group but NOT the parent, so a plain setsid child is killed
    # 86 ms to 2.2 s after the hang-up, before the omp itself exits. `setsid --fork` sets the
    # child's ppid to 1 before it runs anything and was never touched, 4 of 4. It is a RACE
    # rather than a certainty -- 19 of 26 plain-setsid arms died -- and it is NOT specific to
    # one omp build: both builds killed at the same rate. Earlier explanations (a dotfiles
    # publish; omp adopting the child as a subreaper) were each disproved, the second by the
    # omp lead reading the code and then by this experiment, in which no probe's ppid ever
    # became an omp's pid.
    MOVE_ORPHANS_WHY="these processes of this session die with the hang-up of the move: $list. Plain \`setsid\` does NOT save them: omp's teardown signals what is reachable from it by parent link, and setsid changes session and process group but not the parent, so such a child is killed within about 2 s of the hang-up (measured 2026-11-05, 19 of 26). \`setsid --fork\` does save it, by making its parent init before it runs. What is safest is not a descendant of the session at all: a host service (a \`~/.config/stream-jobs/<name>.job\` file, \`scripts/stream-job.md\`) or a systemd user unit. Otherwise stop it, or move anyway with --accept-orphans, which ends exactly those pids"
    if $MOVE_ACCEPT_ORPHANS; then
        echo "agentbox: --accept-orphans: the hang-up of the move ends $list" >&2
        return 0
    fi
    if [[ "$3" == true ]]; then
        echo "agentbox: the move would refuse: $MOVE_ORPHANS_WHY"
        return 0
    fi
    return 1
}

# A box is not a one-way door. Every box defect found so far is fixed by moving again with one
# more --dir, and a session INSIDE a box could do neither: `--dir <host path>` was checked in the
# box's own view, where an unmounted host path does not exist ("--dir '<path>' is not an existing
# directory"), and `--self` then refused outright. So in a box the paths are NOT checked here -
# the `agentbox new` that the host pane runs checks every one of them with the same add_box_dir -
# and `--self` relaunches the pane into a new box holding this box's paths plus the new ones.
# AGENTBOX_DIRS (session_env) is what this box was given; the pane is the host's, reached through
# the relayed tmux server.
# MOVE_ONLY_DIRS=true: the caller named the WHOLE list, so this box's own --dir paths are not
# carried. A box cannot otherwise shed a bind it inherited (SQLPAGE's whole /mnt/nvme/sami/wt,
# 2026-11-04), since every re-box adds to AGENTBOX_DIRS.
MOVE_ONLY_DIRS=false
move_self_in_box() {
    local dry="$1" sid cwd pane dirs=() d inner
    shift
    dirs=()
    if ! $MOVE_ONLY_DIRS; then
        [[ -n "${AGENTBOX_DIRS:-}" ]] && IFS=: read -r -a dirs <<<"$AGENTBOX_DIRS"
    fi
    for d in "$@"; do
        [[ -n "$d" ]] || continue
        dirs+=("$d")
    done
    (( ${#dirs[@]} )) || die "this box was started with no --dir, so there is nothing to carry into a new one; ask a host session to run 'agentbox move --plan'"
    sid="${OMP_SESSION_ID:-}"
    [[ -n "$sid" ]] || die "no OMP_SESSION_ID in this box, so a relaunch could not name the session to resume"
    pane="${TMUX_PANE:-}"
    cwd="$PWD"
    local spec=() own resume="" flags=() flags_note=""
    # The session is resumed by its transcript's path and keeps its session environment and its
    # omp's launch flags, as a move from the host does (move_transcript, move_session_env,
    # move_omp_flags); ~/.omp is the same path here.
    if own="$(move_own_omp)"; then
        resume="$(move_transcript "$own" "$sid" || true)"
        mapfile -t spec < <(move_session_env "$own")
        move_omp_flags "$own" || die "session $sid cannot be moved: $MOVE_OMP_FLAGS_WHY; nothing was hung up"
        flags=(${MOVE_OMP_FLAGS[@]+"${MOVE_OMP_FLAGS[@]}"})
    else
        flags_note="  (no omp process is an ancestor of this shell, so no launch flags of the session's omp could be read, and none are carried)"
    fi
    [[ -n "$resume" || "${PI_SESSION_FILE:-}" != *_"$sid".jsonl ]] || resume="$PI_SESSION_FILE"
    [[ -n "$resume" ]] || die "no transcript of session $sid can be read here, so a new box could not resume it; nothing was hung up"
    for d in "${dirs[@]}"; do spec+=(--dir "$d"); done
    echo "agentbox: this session is already in box ${AGENTBOX_BOX:-a box}; moving again into a new one with:"
    echo "  agentbox new ${spec[*]} -- $(move_omp_line "$resume" ${flags[@]+"${flags[@]}"})"
    [[ -z "$flags_note" ]] || echo "$flags_note"
    [[ -n "$pane" ]] || die "this box has no TMUX_PANE, so it cannot respawn its own pane; run the line above from a host session"
    if [[ -n "${own:-}" ]]; then move_orphans_gate "$own" "$$" "$dry" || die "nothing was hung up: $MOVE_ORPHANS_WHY"; fi
    if [[ "$dry" == true ]]; then return 0; fi
    # MOVE_SPEC_KEEP_GONE: the paths are the HOST's, and a box sees only what it was given. A
    # re-box exists to ADD a path, so testing existence in the box's own namespace dropped
    # exactly the new one ("a box may not be given it": LINUX-1301 and
    # /mnt/nvme/sami/linuxadapt/deploy-ossvtls1 at 05:05Z, 2026-11-04). The host's launcher
    # judges each path instead, with --drop-gone-dirs.
    inner="$(MOVE_SPEC_KEEP_GONE=1 move_pane_command "$sid" "$resume" "${spec[@]}" -- ${flags[@]+"${flags[@]}"})"
    # The host's tmux server, through the relay every box has. respawn-pane -k kills what the
    # pane runs - the `agentbox new` of THIS box, so this box and this process end with it - and
    # starts the new launcher in its place. tmux has the command before anything dies.
    tmux respawn-pane -k -t "$pane" -c "$cwd" \
        bash -i -c "$inner; echo; echo 'agentbox: the box has exited; this pane is a shell again'; exec bash -i" \
        || die "could not respawn pane $pane through the host's tmux (is the relay up? \`tmux list-sessions\`); run the line above from a host session"
}

# Record the owner's decision before respawning a pane (as move_self_in_box does), or stopping
# a headless box through its host. A plain in-box kill cannot signal the root-owned docker-init.
cmd_finish() {
    # The help says what finish DOES to the registry, because that is the part a reader has to
    # weigh and `agentbox finish --help` did not mention it. Two lanes could not confirm it from
    # the help on 2026-11-05 and a third had to read scripts/agentbox to settle it, after a fleet
    # prune told sessions to finish anything complete. A session whose work today is done can
    # still be the thing that runs a dated check next week, and finishing it cancels that
    # silently: its entry is rewritten with auto_restart=no before anything is ended.
    local usage='agentbox finish [--reason TEXT] [--dry-run]' dry=false reason='all tasks complete'
    local help="$usage

  Ends this box and the session in it.

  Before anything is ended it rewrites this session's restart-registry entry with
  auto_restart=no and an owner note, so nothing brings the session back. That includes
  any DATED work this session was the one to do: a check due next week is cancelled
  silently by finishing today. A session holding a future obligation must not be finished.

  --reason TEXT  one line, recorded in the entry's owner note (default: all tasks complete)
  --dry-run      print what would be written to the entry and end nothing"
    local sid="${OMP_SESSION_ID:-}" box="${AGENTBOX_BOX:-}" host="${AGENTBOX_HOST:-}" pane="${TMUX_PANE:-}"
    while (( $# )); do
        case "$1" in
            --reason) [[ -n "${2:-}" ]] || die "--reason takes text ($usage)"; reason="$2"; shift ;;
            --dry-run) dry=true ;;
            -h|--help) echo "$help"; return 0 ;;
            *) die "$usage" ;;
        esac
        shift
    done
    [[ -e "$AGENTBOX_IDENTITY_FILE" ]] || die "finish is a box-only command. On the host, exit the session normally, or run 'docker stop <box>' to end a box."
    [[ "$sid" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] \
        || die "finish needs this session's full OMP_SESSION_ID; nothing was ended"
    if [[ -n "${PI_SESSION_FILE:-}" && "${PI_SESSION_FILE##*/}" != *_"$sid".jsonl ]]; then
        die "a subagent cannot finish its parent's session; tell the session to run '$usage' after its tasks finish. Nothing was ended."
    fi
    [[ "$box" =~ ^agentbox-[0-9a-f]{12}$ ]] || die "finish needs this box's AGENTBOX_BOX; nothing was ended"
    [[ "$reason" != *$'\n'* && "$reason" != *$'\r'* ]] || die "--reason must be one line; nothing was ended"
    if [[ -z "$pane" ]]; then
        [[ "$host" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]] || die "a headless finish needs AGENTBOX_HOST; nothing was ended"
    fi
    local stamp note entry="" message inner action=() registry_status=3
    stamp="$(date -u +%FT%TZ)"
    note="Finished deliberately at $stamp: $reason"
    [[ -z "$DURABLE_DIR" ]] || entry="$DURABLE_DIR/restart-registry/sessions/$sid.entry"
    if [[ -n "$entry" ]]; then
        registry_status=0
        # Atomic replacement keeps a watcher from seeing a partial entry. Sync and read it back
        # before ending the box; a failed record must never turn into an automatic restart loop.
        python3 - "$entry" "$sid" "$note" "$dry" <<'PY' || registry_status=$?
import os
import pathlib
import stat
import sys
import tempfile

entry, sid, note, dry = sys.argv[1:]
path = pathlib.Path(entry)
temporary = None
try:
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except FileNotFoundError:
        sys.exit(3)  # No entry, unlike an unreadable one: nothing could restart this session.
    with os.fdopen(fd, encoding="utf-8", newline="") as source:
        mode = os.fstat(source.fileno()).st_mode
        if not stat.S_ISREG(mode):
            raise ValueError("the registry entry is not a regular file")
        lines = source.read().splitlines(keepends=True)
    if [line.rstrip("\r\n") for line in lines if line.startswith("session=")] != [f"session={sid}"]:
        raise ValueError("the registry entry does not name this session alone")
    kept = "".join(line for line in lines if not line.startswith(("auto_restart=", "owner_note=")))
    if kept and not kept.endswith("\n"):
        kept += "\n"
    content = kept + f"auto_restart=no\nowner_note={note}\n"
    if dry != "true":
        fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.finish-", dir=path.parent)
        with os.fdopen(fd, "w", encoding="utf-8", newline="") as target:
            os.fchmod(target.fileno(), stat.S_IMODE(mode))
            target.write(content)
            target.flush()
            os.fsync(target.fileno())
        os.replace(temporary, path)
        temporary = None
        fd = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(fd)
        finally:
            os.close(fd)
        with path.open(encoding="utf-8", newline="") as recorded:
            if recorded.read() != content:
                raise ValueError("the recorded finish could not be verified")
except (OSError, ValueError) as error:
    print(f"agentbox: {error}", file=sys.stderr)
    sys.exit(1)
finally:
    if temporary is not None:
        os.unlink(temporary)
PY
    fi
    if (( registry_status == 0 )); then
        if $dry; then echo "agentbox: dry run: would update $entry:"; else echo "agentbox: recorded finish in $entry:"; fi
        printf '  auto_restart=no\n  owner_note=%s\n' "$note"
    elif (( registry_status == 3 )); then
        echo "agentbox: no restart-registry entry for session $sid${entry:+ at $entry}; nothing to restart."
    else
        die "could not record finish in $entry; nothing was ended"
    fi
    if [[ -n "$pane" ]]; then
        message="agentbox: session $sid finished deliberately; this pane is a shell again."
        inner="printf '%s\\n' $(printf '%q' "$message"); exec bash -i"
        action=(tmux respawn-pane -k -t "$pane" -c "$HOME" bash -c "$inner")
    else
        # Verified from inside a throwaway agentbox: stopping itself through host SSH ends it.
        # The host's docker client outlives the box, unlike a local tool signalling its own omp.
        action=(ssh -o BatchMode=yes -o ConnectTimeout=20 "$host" docker stop "$box")
    fi
    if $dry; then
        echo "agentbox: dry run: would end box $box with:"
        printf '  '; printf '%q ' "${action[@]}"; printf '\n'
        return 0
    fi
    if [[ -n "$pane" ]]; then
        echo "agentbox: ending box $box through pane $pane; this pane will become an interactive shell."
        "${action[@]}" || die "could not respawn pane $pane through the host's tmux; restart remains disabled. Ask a host session${host:+ on $host} to run: docker stop $box"
    else
        echo "agentbox: ending box $box through host SSH to $host."
        "${action[@]}" || die "could not stop $box through host SSH; restart remains disabled. Ask a host session on $host to run: docker stop $box"
    fi
}

# The host session a `move --self` or `move --to` is run from, identified from the command's own
# process, in MOVE_SELF_PID, _SID, _PANE, _AT, _CWD and _DETAIL; dies with the reason when the
# caller is not a host session a move can take. $1 is the command, for the refusals.
MOVE_SELF_PID="" MOVE_SELF_SID="" MOVE_SELF_PANE="" MOVE_SELF_AT="" MOVE_SELF_CWD="" MOVE_SELF_DETAIL=""
move_self_identify() {
    local caller="$1" row class _pid
    # A SUBAGENT's bash tool reaches the same omp process as its parent's, so a move run there
    # would hang up the session that started it, in the middle of the subagent's own work.
    # omp gives a subagent its own transcript, `…/<session dir>/<name>.jsonl`, while a session's
    # own file ends in `_<id>.jsonl`; that is what tells the two apart (measured in this
    # session: PI_SESSION_FILE named AgentBoxMove.jsonl while OMP_SESSION_ID was the parent's).
    if [[ -n "${PI_SESSION_FILE:-}" ]]; then
        case "$(basename -- "$PI_SESSION_FILE")" in
            *_[0-9a-f]*-*-*-*-*.jsonl) ;;
            *) die "a subagent cannot move its session: $PI_SESSION_FILE is a subagent transcript, and the move would hang up the session that started you. Tell the session to run it when the subagent is done." ;;
        esac
    fi
    MOVE_SELF_PID="$(move_own_omp)" || die "no omp process above this command: run '$caller' from the session's own bash tool"
    row="$(move_census | awk -F"$SEP" -v p="$MOVE_SELF_PID" '$2 == p')"
    [[ -n "$row" ]] || die "omp $MOVE_SELF_PID is not in this host's session census; run 'agentbox move --plan' and look for it"
    IFS="$SEP" read -r class _pid MOVE_SELF_SID MOVE_SELF_PANE MOVE_SELF_AT MOVE_SELF_CWD MOVE_SELF_DETAIL <<<"$row"
    [[ "$class" == host ]] || die "this session is $class ($MOVE_SELF_DETAIL), not a host session a move can take"
    [[ -n "$MOVE_SELF_SID" ]] || die "this omp holds no session file open, so a move cannot name its session in full and --resume would take the wrong one; try again in a moment"
    # The caller's own OMP_SESSION_ID, which omp sets for its tools, must be the session the
    # census read from the process. A disagreement means the walk up the process tree reached
    # another session's omp, and resuming that one in this pane would take a session nobody
    # asked to move.
    if [[ -n "${OMP_SESSION_ID:-}" && "$OMP_SESSION_ID" != "$MOVE_SELF_SID" ]]; then
        die "the omp above this command runs session $MOVE_SELF_SID, while this tool's OMP_SESSION_ID is $OMP_SESSION_ID; a move must not resume a session it has not identified. Run 'agentbox move --plan' and move it by id."
    fi
    [[ -n "$MOVE_SELF_PANE" ]] || die "this session has no tmux pane to relaunch ($MOVE_SELF_DETAIL); it is one of the plan's not-a-pane rows and needs a person"
    return 0
}

cmd_move_self() {
    local dry=false a usage="$MOVE_USAGE" in_box=false raw_dirs=() only_dirs=false
    [[ -n "${AGENTBOX_BOX:-}" || -e "$AGENTBOX_IDENTITY_FILE" ]] && in_box=true
    # --dir is the session's own answer to an inference that missed something: a path it works in
    # that no process of it had open when the plan ran. On the host each is checked exactly as
    # `agentbox new --dir` checks it (add_box_dir); in a box it cannot be, since the path is the
    # HOST's and the box does not have it - the launcher on the host checks it instead.
    while (( $# )); do
        a="$1"
        case "$a" in
            --dry-run) dry=true ;;
            --force-floor) MOVE_FORCE_FLOOR=true ;;
            --accept-orphans) MOVE_ACCEPT_ORPHANS=true ;;
            # In a box the new box gets this box's --dir paths plus what is named here. A session
            # shedding a bind it inherited (a whole shared root an earlier launch gave it) has no
            # way to drop one: --only-dirs makes the named paths the WHOLE list.
            --only-dirs) only_dirs=true ;;
            --dir)
                [[ -n "${2:-}" ]] || die "--dir takes an existing directory, e.g. --dir /mnt/nvme/$(id -un)/my-lane  ($usage)"
                if $in_box; then raw_dirs+=("$2"); else add_box_dir "$2"; fi
                shift
                ;;
            *) die "$usage" ;;
        esac
        shift
    done
    if $in_box; then
        if $only_dirs; then
            (( ${#raw_dirs[@]} )) || die "--only-dirs takes the whole list of paths the new box gets: name at least one --dir"
            MOVE_ONLY_DIRS=true
        fi
        move_self_in_box "$dry" "${raw_dirs[@]+"${raw_dirs[@]}"}"
        return $?
    fi
    if $only_dirs; then
        die "--only-dirs is for a session already in a box: it replaces the box's inherited --dir list. On the host the inference decides, and --dir adds to it"
    fi
    # As `move --to` does: one census and one list of the in-box paths, read in this shell so
    # the $(…) subshells below inherit them.
    MOVE_CENSUS_ONCE=true
    move_census >/dev/null
    move_in_box_paths
    move_self_identify "agentbox move --self"
    local pid="$MOVE_SELF_PID" sid="$MOVE_SELF_SID" pane="$MOVE_SELF_PANE" at="$MOVE_SELF_AT" cwd="$MOVE_SELF_CWD" detail="$MOVE_SELF_DETAIL"
    local dirs=() whys=() spec=() d path why
    move_read_kids
    # --self takes the UNION of what it sees now, what the session's own record names and what
    # the last `move --plan` gave this session, because the two commands run minutes apart and a
    # live scan is a snapshot.
    MOVE_USE_PLAN=true
    while IFS=$'\t' read -r path why; do
        [[ -n "$path" ]] || continue
        dirs+=("$path")
        whys+=("  $path — $why")
    done < <(move_dirs_why "$cwd" "$pid" "$sid" "${BOX_DIRS[@]+"${BOX_DIRS[@]}"}" 2>/dev/null)
    (( ${#dirs[@]} )) || die "$(move_dirs_why "$cwd" "$pid" "$sid" 2>&1 >/dev/null || true)"
    # Where the session lives goes into the box with it, and the box must be able to open it:
    # both are settled before anything is hung up.
    move_session_spec "$pid" "$sid" "${dirs[@]}" \
        || die "session $sid cannot be moved: $MOVE_RESUME_WHY; nothing was hung up"
    spec=("${MOVE_SPEC[@]}")
    local flags=(${MOVE_OMP_FLAGS[@]+"${MOVE_OMP_FLAGS[@]}"}) short
    if [[ -z "${MOVE_KIDS[$pid]:-}" ]]; then
        whys+=("  (this session has no live child process, so only its working directory, its own record and the last plan were read)")
    fi
    # Trees its own transcript names that the box would not get (move_short_set): said, never a
    # refusal, since the session is the one who knows whether it still works there.
    short="$(move_short_set "$pid" "$MOVE_RESUME" "${dirs[@]}")"
    move_check_floor "$(move_image_bytes "$BOX_DISK_BYTES")" || exit 2
    # The relauncher hangs this omp up BEFORE it respawns the pane, so a pane the relauncher
    # cannot reach would leave the session down. The census may have found the pane from /proc
    # alone (move_env_pane), so ask the server now, from here, as the relauncher will.
    move_target_tmux "$pid"
    if [[ -z "$("$MOVE_TMUX_BIN" "${MOVE_TMUX[@]}" display-message -p -t "$pane" '#{pane_pid}' 2>/dev/null)" ]]; then
        local lead="agentbox move $sid --now" b
        for b in "${BOX_DIRS[@]+"${BOX_DIRS[@]}"}"; do lead+=" --dir $(printf '%q' "$b")"; done
        die "tmux cannot reach pane $pane from this shell ($MOVE_TMUX_BIN ${MOVE_TMUX[*]} display-message failed), so the relauncher could not respawn it after the hang-up; nothing was hung up. Ask a host session to move this session from outside: $lead"
    fi
    move_orphans_gate "$pid" "$$" "$dry" || die "nothing was hung up: $MOVE_ORPHANS_WHY"
    if $dry; then
        echo "agentbox: would hang omp $pid up and respawn pane $pane ($at) as:"
        echo "  agentbox new ${spec[*]} -- $(move_omp_line "$MOVE_RESUME" ${flags[@]+"${flags[@]}"})"
        echo "each path and why:"
        printf '%s\n' "${whys[@]}"
        [[ -z "$short" ]] || printf '%s\n' "$short"
        echo "anything else you work in is NOT in that box and is lost with it: add it with --dir."
        return 0
    fi
    printf '%s\n' "agentbox: the box gets these paths:" "${whys[@]}"
    [[ -z "$short" ]] || printf '%s\n' "$short"
    move_hand_off "$pid" "$sid" "$pane" "$cwd" "$MOVE_RESUME" "${spec[@]}" -- ${flags[@]+"${flags[@]}"}
}

# The idle test is ancestry, never `read proc://`: under a shared omp worker broker that lists the
# services of every session the broker serves (measured 2026-11-02: a session saw seven, none of
# them its own, and so never found the moment to move). What the hang-up ends is exactly the
# omp's own process tree, so that tree is the test. %PID% is the session's omp pid.
MOVE_NOTICE_HEAD='agentbox: this session moves into an agent box (dispatch://INFRA-702). Do not stop, delay or shorten any work for it. The next time none of YOUR jobs is running, write your handover into the transcript and run `agentbox move --self` from your bash tool. A job is yours when its process descends from this session'"'"'s omp, pid %PID%: `pstree -p %PID%` shows them all (the bash tool you run it in is one; ignore it). Do not use `read proc://` to decide: it also lists services of other sessions that share an omp worker broker. If this session is finished or is ending, do not move it: end as you planned. A move starts a new omp, and the secrets broker drops this session'"'"'s human-tier grants (GITHUB_ADMIN_PAT and the like): each needs Sami'"'"'s approval again, which nobody gives while he is away, so if you still need one before he is back, move after you no longer need it. `move --self` hangs this omp up gracefully and respawns this pane as'
# A move that WORKS comes back to the caller as a tool error: the relauncher hangs the session's
# omp up, which kills the bash tool's own shell before any exit status can be returned, so the
# harness reports the command as failed and hands back whatever stdout it had. Measured over four
# clean moves on 2026-11-05 (MoveSelfSmoke): 4 of 4 succeeded, 4 of 4 reported an error. Each
# agent worked it out from the Envoy wake notice afterwards, but a session told to stop at the
# first failed command would report its own successful move as broken, or retry it.
MOVE_NOTICE_TAIL='so you come back with the same session id, the same transcript and the same working directory, in a box with a cpu, memory, pids and disk limit of its own. Your tree is the host'"'"'s own directory, bind-mounted at its own path: uncommitted work included, nothing cloned, nothing copied. ONE THING TO EXPECT: a move that WORKS looks like a failed tool call. Hanging your omp up kills the shell the command runs in, so no exit status comes back and the harness reports an error with whatever output it had. That is the normal, successful shape (measured: 4 of 4 clean moves reported an error). Do not retry it and do not report it as broken; you wake in the new box with a notice saying the move is done.'
# What the box gets, and the one thing the session must check before it runs the command. The
# paths come from the session's live processes, from its own record of today and from the last
# plan; an unnamed path is not absent in the box, it is writable there and lost with the box.
MOVE_NOTICE_DIRS='The box gets these paths of yours, and nothing else outside ~/src, the dotfiles and the home allow-list (a worktree under ~/src/<repo>/.worktrees/... is in ~/src, so it IS in the box). They come from your live processes, from your own record of today (the tool calls in your transcript) and from the last `move --plan`:'
MOVE_NOTICE_ADD='Read that list. If you work in a path it does not name, add it yourself: `agentbox move --self --dir PATH --dir PATH`. A path no box is given is still writable inside the box and is lost when the box ends. If you are idle, do it now.'
# A supervisor whose workers have exited has nothing for a live scan to read, and a lane that
# sees two directories must be told that before it decides the list is complete.
MOVE_NOTICE_NOKIDS='(this session has no live child process, so only its working directory, its own record and the last plan were read)'

cmd_move_notify() {
    local now=false dry=false all=false t targets=() rows=() row
    # --dir names a path the inference missed, for a session moved from outside (a lead's
    # `move <id> --now` for a session whose own shell cannot reach tmux). Checked exactly as
    # `agentbox new --dir` checks it, and given to one session only: paths are per session.
    while (( $# )); do
        t="$1"
        case "$t" in
            --now) now=true ;;
            --dry-run) dry=true ;;
            --all) all=true ;;
            --force-floor) MOVE_FORCE_FLOOR=true ;;
            --accept-orphans) MOVE_ACCEPT_ORPHANS=true ;;
            --dir)
                [[ -n "${2:-}" ]] || die "--dir takes an existing directory, e.g. --dir /mnt/nvme/$(id -un)/my-lane. $MOVE_USAGE"
                add_box_dir "$2"
                shift
                ;;
            -*) die "unknown option $t. $MOVE_USAGE" ;;
            *) targets+=("$t") ;;
        esac
        shift
    done
    if (( ${#BOX_DIRS[@]} )) && { $all || (( ${#targets[@]} != 1 )); }; then
        die "--dir names paths of ONE session: give exactly one session id with it, not --all. $MOVE_USAGE"
    fi
    if $all; then
        mapfile -t rows < <(move_census | awk -F"$SEP" '$1 == "host" && $3 != "" && $4 != ""')
    else
        (( ${#targets[@]} )) || die "$MOVE_USAGE"
        for t in "${targets[@]}"; do
            row="$(move_find "$t")" || die "no live host session matches $t (agentbox move --plan lists them)"
            rows+=("$row")
        done
    fi
    (( ${#rows[@]} )) || { echo "agentbox: no host session to move"; return 0; }
    local class pid sid pane at cwd detail dir why dirs=() whys=() spec=() d image
    image="$(move_image_bytes "$BOX_DISK_BYTES")"
    move_read_kids
    for row in "${rows[@]}"; do
        IFS="$SEP" read -r class pid sid pane at cwd detail <<<"$row"
        if [[ "$class" != host ]]; then
            echo "agentbox: $sid is $class ($detail); not moved" >&2
            continue
        fi
        dirs=()
        whys=()
        while IFS=$'\t' read -r dir why; do
            [[ -n "$dir" ]] || continue
            dirs+=("$dir")
            whys+=("$dir ($why)")
        done < <(move_dirs_why "$cwd" "$pid" "$sid" "${BOX_DIRS[@]+"${BOX_DIRS[@]}"}" 2>/dev/null)
        if (( ! ${#dirs[@]} )); then
            echo "agentbox: $sid cannot be moved: $(move_dirs_why "$cwd" "$pid" "$sid" "${BOX_DIRS[@]+"${BOX_DIRS[@]}"}" 2>&1 >/dev/null || true)" >&2
            continue
        fi
        if [[ -z "${MOVE_KIDS[$pid]:-}" ]]; then
            whys+=("$MOVE_NOTICE_NOKIDS")
        fi
        # Where the session lives goes into its box with it, and the box must be able to open it
        # (move_session_spec), before any notice or hang-up.
        if ! move_session_spec "$pid" "$sid" "${dirs[@]}"; then
            echo "agentbox: $sid cannot be moved: $MOVE_RESUME_WHY; not notified, nothing hung up" >&2
            continue
        fi
        spec=("${MOVE_SPEC[@]}")
        local flags=(${MOVE_OMP_FLAGS[@]+"${MOVE_OMP_FLAGS[@]}"}) omp_line short
        omp_line="$(move_omp_line "$MOVE_RESUME" ${flags[@]+"${flags[@]}"})"
        short="$(move_short_set "$pid" "$MOVE_RESUME" "${dirs[@]}")"
        if ! move_check_floor "$image"; then return 2; fi
        if $now; then
            if ! move_orphans_gate "$pid" "" "$dry"; then
                echo "agentbox: $sid cannot be moved now, nothing hung up: $MOVE_ORPHANS_WHY" >&2
                continue
            fi
            if $dry; then
                echo "agentbox: would relaunch pane $pane ($at) now: agentbox new ${spec[*]} -- $omp_line"
                [[ -z "$short" ]] || printf '%s\n' "$short"
                continue
            fi
            [[ -z "$short" ]] || printf '%s\n' "$short"
            move_hand_off "$pid" "$sid" "$pane" "$cwd" "$MOVE_RESUME" "${spec[@]}" -- ${flags[@]+"${flags[@]}"}
            continue
        fi
        local notice="${MOVE_NOTICE_HEAD//%PID%/$pid} \`agentbox new ${spec[*]} -- $omp_line\`, $MOVE_NOTICE_TAIL $MOVE_NOTICE_DIRS $(printf '%s; ' "${whys[@]}" | sed 's/; $//'). $MOVE_NOTICE_ADD"
        [[ -z "$short" ]] || notice+=" ${short//$'\n'/ }"
        # What dies with the hang-up, so the session decides before it runs the move.
        local orphans
        orphans="$(move_orphans "$pid")"
        [[ -z "$orphans" ]] || notice+=" Your move refuses until you deal with these: the hang-up ends them: $(move_orphans_list "$orphans"). Start each one detached (\`setsid <command> </dev/null >>log 2>&1 &\`) or as an omp background job, stop it, or run the move with --accept-orphans."
        if $dry; then
            echo "agentbox: would notify $sid (pane $pane, $at): $notice"
            continue
        fi
        envoy_send_text "$sid" "$notice" >/dev/null || die "envoy send to $sid failed"
        echo "agentbox: $sid (pane $pane, $at) notified; it moves when it reaches a safe point"
    done
}

# ── agentbox move --to <machine>: a group of sessions to another machine (dispatch://INFRA-993) ──
#
# `move --self` moves a session into a box on THIS machine; `move --to <machine>` moves it to a
# box on another one, sami-devbox, with the same session id. The session's own process runs it
# at its safe point, as it runs `--self`. It reaches the target over Tailscale SSH as
# $MOVE_TO_USER and, for the session's GROUP - every live host session that works in one of its
# git working trees (move_to_find_group), since a shared tree moves once, with all its users:
#
#   1. hangs each session up gracefully (SIGHUP, as `--self` does);
#   2. copies to the target each session's transcript tree (its file, its own directory with the
#      subagent transcripts, and what a symlink there points at on /mnt/durable), the paths
#      `move --plan` infers for it, and its own trees under $SRC, which every box on THIS host
#      has already and so the inference leaves out (move_to_src_trees). Git working trees and
#      the transcripts are MIRRORED (`rsync --delete`; a file the target held and the copy
#      replaced or deleted is kept under $MOVE_TO_CUTOVER/replaced/<stamp> there). Everything
#      else is MERGED - nothing newer on the target is replaced and nothing is deleted: git
#      storage, which another moved worktree of the same checkout may have written, and every
#      directory in no git tree, which is where many sessions share state (caches, a tool's run
#      directory, a lane or lead root);
#   3. writes the marker `agentbox-moved` in each session's directory on THIS host, which
#      scripts/agent-session and scripts/agentbox-run.ts refuse to resume;
#   4. starts each session in tmux session `moved` on the target, one window per session named
#      for its id, as `agentbox new <its -e environment and --dir paths> -- omp --resume
#      <transcript path>`, and waits until that omp has run for $MOVE_TO_SETTLE seconds;
#   5. appends one line per session to the target's move log, $MOVE_TO_LOG (on its state disk):
#      time, session, group, from, to, result, transcript.
#
# Any failure after the hang-up rolls the WHOLE group back: the target's windows are closed,
# every marker is removed, and each session resumes here in a box (`agentbox new … -- omp
# --resume <path>`, as `move --self` would), whose files the move never changed. Nothing is
# moved while the target's provisioning has not written $MOVE_TO_READY, after two failed moves
# in a row, or once a session id was found running on both machines, until the box-health lead
# runs `agentbox move --to <machine> --clear-halt`.
#
# A session of a group of several only says it is at its safe point (a ready file); the last one
# of the group to run `move --to` moves them all, and each other one is asked over Envoy to run
# it at its own safe point. A session in a box runs the same command in the box; its group is
# itself, and the host does the move through the relayed tmux server (move_to_in_box).
MOVE_TO_USER="${AGENTBOX_MOVE_USER:-sami}"
read -r -a MOVE_TO_SSH <<<"${AGENTBOX_MOVE_SSH:-ssh -o BatchMode=yes -o ConnectTimeout=20}"
MOVE_TO_CUTOVER="${AGENTBOX_MOVE_CUTOVER:-/mnt/nvme/$(id -un)/cutover}"
MOVE_TO_LOG="$MOVE_TO_CUTOVER/move-log.tsv"
MOVE_TO_READY="$MOVE_TO_CUTOVER/target-ready"
MOVE_TO_AGENTBOX="${AGENTBOX_MOVE_TARGET_AGENTBOX:-$HOME/.dotfiles/scripts/agentbox}"
MOVE_TO_TMUX_SESSION=moved
# The file every box has, which says a process runs in one. A variable, not the literal path,
# because the tests of this script now run INSIDE a box themselves (every session does), where
# the literal would make each of them take the in-box path and test nothing of the host's.
AGENTBOX_IDENTITY_FILE="${AGENTBOX_IDENTITY_FILE:-/etc/agentbox-identity}"
MOVE_TO_START_WAIT="${AGENTBOX_MOVE_START_WAIT:-300}"
MOVE_TO_SETTLE="${AGENTBOX_MOVE_SETTLE:-30}"
MOVE_TO_POLL="${AGENTBOX_MOVE_POLL:-5}"
MOVE_TO_HANGUP_WAIT="${AGENTBOX_MOVE_HANGUP_WAIT:-180}"
# A member's ready file counts for 10 min. A member that ran `move --to` and then went back to
# work must not be hung up when the last member runs it hours later (asked of LINUX-1248's group
# on 2026-11-03, when a 2 h window could have done exactly that); one whose file is older is
# asked again.
MOVE_TO_READY_TTL="${AGENTBOX_MOVE_READY_TTL:-600}"
# How long a move waits for the target's health check to write target-ready again (a run takes
# about 6 min); a dry run sets it to 0 and says what it would wait for.
MOVE_TO_READY_WAIT="${AGENTBOX_MOVE_READY_WAIT:-420}"
# Under ~/.cache/omp, which every box mounts at the same path, so a job a box writes is read by
# the host's relauncher.
MOVE_TO_JOBS="${XDG_CACHE_HOME:-$HOME/.cache}/omp/agentbox/move-to"
MOVE_MARKER=agentbox-moved
MOVE_MARKER_INDEX="$HOME/.omp/agentbox-moved"

# The arguments as one JSON array of strings. Not `jq --args`: jq reads a value such as `--dir`
# there as an option of its own.
move_json_array() {
    (( $# )) || { echo '[]'; return 0; }
    printf '%s\0' "$@" | jq -cRs 'split("\u0000")[:-1]'
}

# One command on the target, in a login shell (its PATH: tmux, rsync, agentbox's tools).
move_remote() {
    local target="$1" script="$2"
    "${MOVE_TO_SSH[@]}" "$MOVE_TO_USER@$target" "bash -lc $(printf '%q' "$script")"
}

# Every omp on a machine, one line each, unit-separated (an empty field must not fold into the
# next, as a tab would under `read`): pid, start time, command line, the .jsonl files it holds
# open. Run on the target through move_remote and here with bash -c. The command line is what
# names a moved session on the target (`omp --resume <path>`), and it is readable for a box's
# processes too, whose file descriptors the host user cannot read.
# shellcheck disable=SC2016  # expanded where it runs
# (`exec 2>/dev/null`: a process that exits between pgrep and the read is skipped, not reported.)
MOVE_TO_OMP_PS='exec 2>/dev/null; P="${AGENTBOX_PROC:-/proc}"
for p in $(pgrep -x omp 2>/dev/null); do
    c="$(tr "\0" " " <"$P/$p/cmdline" 2>/dev/null)" || continue
    s="$(cut -d" " -f22 "$P/$p/stat" 2>/dev/null)" || s=""
    f="$(for l in "$P/$p/fd"/*; do readlink "$l" 2>/dev/null; done | grep "\.jsonl$" | tr "\n" " ")"
    printf "%s\037%s\037%s\037%s\n" "$p" "$s" "$c" "$f"
done'

# move_to_running TARGET SID…: "<sid>\t<pid>" for each SID an omp on TARGET runs, or on this
# machine when TARGET is empty; status 2 when TARGET cannot be asked. Here the census answers
# (one `find` over every omp's descriptors): reading each descriptor of this host's hundred omp
# processes one `readlink` at a time took three minutes at load 300 in the 2026-11-02 drill.
# move_omp_is_session SID CMDLINE OPEN-FILES: true when this omp IS that session. Two things make
# it one: it holds the session's transcript, or its command line resumes it (`--resume <id>`,
# `--resume <path>`, `-r`, `--session`). The id is read from the LAST component of the path only -
# the .jsonl file's own name - because a subagent's transcript lives UNDER its parent's directory,
# so the parent's id is in the path of every child: agentbox halted FRAC's move saying its session
# already ran on sami-devbox, where that pid was BET-64's session in a transcript under FRAC's
# directory (22:57Z, 2026-11-03). A mention of the id anywhere else in argv is never a match (a
# lane's prompt held CAS's id and a move hung up that lane, 20:57Z).
move_omp_is_session() {
    local sid="$1" cmd="$2" fds="$3" word prev="" f
    for f in $fds; do
        move_jsonl_is_session "$sid" "$f" && return 0
    done
    for word in $cmd; do
        case "$prev" in
            --resume|-r|--session)
                [[ "$word" == "$sid" ]] && return 0
                move_jsonl_is_session "$sid" "$word" && return 0
                ;;
        esac
        case "$word" in
            --resume=*|--session=*)
                [[ "${word#*=}" == "$sid" ]] && return 0
                move_jsonl_is_session "$sid" "${word#*=}" && return 0
                ;;
        esac
        prev="$word"
    done
    return 1
}
# move_jsonl_is_session SID PATH: true when PATH is that session's transcript: its FILE NAME holds
# the id, whatever the directories above it hold.
move_jsonl_is_session() {
    local sid="$1" name="${2##*/}"
    [[ "$name" == *.jsonl ]] || return 1
    [[ "$name" == *"$sid"* ]]
}

move_to_running() {
    local target="$1" out sid pid _st cmd fds
    shift
    if [[ -n "$target" ]]; then
        out="$(move_remote "$target" "$MOVE_TO_OMP_PS" </dev/null)" || return 2
    else
        out="$(move_census | awk -F"$SEP" -v OFS=$'\x1f' '$3 != "" { print $2, "", "", $3 }')"
    fi
    # Every omp that holds the session, not the first: two of them is exactly what the callers
    # look for (one session must not run twice on a machine).
    # An omp belongs to a session when it HOLDS that session's transcript, or when its command
    # line names it as the session to resume - never because the id appears somewhere in argv: a
    # lane's prompt held another session's id, and a move hung up the wrong omp (CAS and its lane
    # R17Pin, 2026-11-03 20:57Z).
    for sid in "$@"; do
        while IFS=$'\x1f' read -r pid _st cmd fds; do
            [[ -n "$pid" ]] || continue
            # The census has already said whose each omp here is (it reads the transcript the
            # process holds), so its answer is an id, not a path; the target's listing is a
            # command line and open files, which move_omp_is_session reads.
            if [[ "$fds" == "$sid" ]] || move_omp_is_session "$sid" "$cmd" "$fds"; then
                printf '%s\t%s\n' "$sid" "$pid"
            fi
        done <<<"$out"
    done
    return 0
}

# The background services a session left running on THIS machine. omp's worker broker is parented
# to init and outlives the omp, so a moved session's services keep running on the source: the
# chief's six loops ran twice for five hours after its move (two sweeps, two ticks, two pilot
# schedulers, cursor files advancing apart; 2026-11-03). Each broker keeps its services under
# <omp run>/daemons/<broker>/daemons/<name>/meta.json, with the session that started one in
# .daemon.owner, and the broker's project directory in <broker>/scope.json; `omp ps --dir <dir>
# stop <name>` is how a service is stopped. A session's own processes are also in its systemd user
# scopes, run-c<sid>*.scope.
MOVE_OMP_RUN="${OMP_RUN_DIR:-$HOME/.omp/run}"
# move_to_session_services SID: "<project dir>\t<name>" for each service of SID still running here.
move_to_session_services() {
    local sid="$1" meta dir name state owner
    for meta in "$MOVE_OMP_RUN"/daemons/*/daemons/*/meta.json; do
        [[ -r "$meta" ]] || continue
        owner="$(jq -r '.daemon.owner // empty' "$meta" 2>/dev/null)" || continue
        [[ "$owner" == "$sid" ]] || continue
        state="$(jq -r '.daemon.state // empty' "$meta" 2>/dev/null)"
        case "$state" in exited|stopped|failed|"") continue ;; esac
        name="$(jq -r '.daemon.name // empty' "$meta" 2>/dev/null)"
        [[ -n "$name" ]] || continue
        dir="$(jq -r '.projectDir // empty' "${meta%/daemons/*/meta.json}/scope.json" 2>/dev/null)"
        printf '%s\t%s\n' "$dir" "$name"
    done
}
# move_to_session_scopes SID: this session's systemd user scopes, which hold what its tools started.
move_to_session_scopes() {
    systemctl --user list-units --type=scope --no-legend --plain 2>/dev/null \
        | awk -v s="run-c$1" '$1 ~ "^" s { print $1 }'
}
# move_to_stop_services SID: stop what SID left running here, AFTER it is confirmed on the target.
# Everything it finds is logged, stopped or not; what will not stop is said to the session and to
# the box-health role, since a service that runs twice writes twice.
MOVE_TO_STOP_SERVICES="${AGENTBOX_MOVE_STOP_SERVICES:-1}"
move_to_stop_services() {
    local sid="$1" dir name scope left=() found=0
    (( MOVE_TO_STOP_SERVICES )) || return 0
    while IFS=$'\t' read -r dir name; do
        [[ -n "$name" ]] || continue
        found=1
        if omp ps ${dir:+--dir "$dir"} stop "$name" --timeout 10 >/dev/null 2>&1; then
            say "$sid: service $name (${dir:-this machine}) stopped here; it moved with the session"
        else
            left+=("$name (${dir:-this machine})")
            say "$sid: service $name (${dir:-this machine}) would NOT stop here"
        fi
    done < <(move_to_session_services "$sid")
    while IFS= read -r scope; do
        [[ -n "$scope" ]] || continue
        found=1
        if systemctl --user stop "$scope" >/dev/null 2>&1; then
            say "$sid: scope $scope stopped here"
        else
            left+=("$scope")
            say "$sid: scope $scope would NOT stop here"
        fi
    done < <(move_to_session_scopes "$sid")
    (( found )) || say "$sid: no service or scope of this session is left running here"
    if (( ${#left[@]} )); then
        local text="agentbox: session $sid moved to $target, and these background services stay on $me: ${left[*]}. They run twice until a person ends them. (An automated notice from agentbox.)"
        envoy_send_text --source envoy "$sid" "$text" >/dev/null 2>&1 || true
        envoy notify --message-file - notifications.role.lead-box-health <<<"$text" >/dev/null 2>&1 || true
    fi
    return 0
}

# move_to_log TARGET LINE…: append each tab-separated line to the target's move log; a line the
# target would not take is kept here, in $MOVE_TO_JOBS/move-log-unsent.tsv, and said.
move_to_log() {
    local target="$1"
    shift
    if printf '%s\n' "$@" | move_remote "$target" "mkdir -p $(printf '%q' "$MOVE_TO_CUTOVER") && cat >>$(printf '%q' "$MOVE_TO_LOG")"; then
        return 0
    fi
    mkdir -p "$MOVE_TO_JOBS" && printf '%s\n' "$@" >>"$MOVE_TO_JOBS/move-log-unsent.tsv"
    echo "$(date -u +%FT%TZ) move-to: $target would not take its move log lines; kept in $MOVE_TO_JOBS/move-log-unsent.tsv"
    return 1
}

# Why moves to TARGET are halted, from its move log, or nothing. One attempt is the lines that
# share a time and a group; it failed when any of its lines is not `moved`. Halted: the last two
# attempts failed, or any `both-machines` line - each since the last `halt-cleared` line.
move_to_halted() {
    local target="$1" log
    log="$(move_remote "$target" "cat $(printf '%q' "$MOVE_TO_LOG") 2>/dev/null || true" </dev/null)" || return 2
    awk -F'\t' '
        NF < 6 { next }
        $6 == "halt-cleared" { n = 0; both = ""; split("", seen); split("", bad); next }
        $6 == "both-machines" { both = $2 " (" $1 ")" }
        {
            k = $1 SUBSEP $3
            if (!(k in seen)) { seen[k] = 1; order[++n] = k; label[k] = "group " $3 " at " $1 }
            if ($6 != "moved") bad[k] = 1
        }
        END {
            if (both != "") { print "session " both " was found running on both machines"; exit }
            if (n >= 2 && (order[n] in bad) && (order[n - 1] in bad))
                print "the last two moves failed (" label[order[n - 1]] ", " label[order[n]] ")"
        }' <<<"$log"
}

# move_to_preflight TARGET SID…: everything that must hold before anything is hung up. Sets
# MOVE_TO_WHY and returns 1 when it does not. A session the target already runs is running on
# both machines, which halts every later move too.
MOVE_TO_WHY=""
# The state of the target's health check (devbox/sami-devbox-check), from its newest log
# $MOVE_TO_CUTOVER/a2-<UTC stamp>.log there: it deletes target-ready when it starts and writes it
# again only after a run with no failure, usually 8-13 minutes later.
move_to_check_state() {
    local target="$1" out name rest
    out="$(move_remote "$target" "f=\$(ls -1t $(printf '%q' "$MOVE_TO_CUTOVER")/a2-*.log 2>/dev/null | head -n 1); [ -n \"\$f\" ] || exit 0; printf '%s\\n' \"\$f\"; tail -n 20 \"\$f\" | grep -c '^FAIL' || true" </dev/null 2>/dev/null)" || out=""
    name="$(sed -n 1p <<<"$out")"
    rest="$(sed -n 2p <<<"$out")"
    if [[ -z "$name" ]]; then
        echo "Its health check (devbox/sami-devbox-check) has written no log there; the box-health lead decides"
        return 0
    fi
    name="${name##*/a2-}"
    name="${name%.log}"
    local when="${name:0:4}-${name:4:2}-${name:6:2} ${name:9:2}:${name:11:2}:${name:13:2}Z"
    if [[ "${rest:-0}" != 0 ]]; then
        echo "The last health check (devbox/sami-devbox-check, started $when) FAILED, so it is not written again until a check passes; the box-health lead decides"
    else
        echo "A health check (devbox/sami-devbox-check) started at $when deletes it while it runs and writes it again when it passes, usually 8-13 min after its start. Run the move again then"
    fi
}

move_to_preflight() {
    local target="$1" halted running me
    shift
    MOVE_TO_WHY=""
    if ! move_remote "$target" true </dev/null >/dev/null 2>&1; then
        MOVE_TO_WHY="$target does not answer \`${MOVE_TO_SSH[*]} $MOVE_TO_USER@$target\`"
        return 1
    fi
    # The target's health check (devbox/sami-devbox-check) DELETES this marker when it starts and
    # writes it again only after a run with no failure, and a run takes about 6 minutes. A missing
    # marker is therefore usually a check in flight, not a target that failed, so the move waits
    # for it (MOVE_TO_READY_WAIT, 0 in a dry run, which says what it would wait for).
    if ! move_remote "$target" "test -e $(printf '%q' "$MOVE_TO_READY")" </dev/null >/dev/null 2>&1; then
        local waited=0
        while (( waited < MOVE_TO_READY_WAIT )); do
            (( waited == 0 )) && echo "agentbox: $target has no $MOVE_TO_READY; its health check deletes it while it runs (about 6 min), so this waits up to $((MOVE_TO_READY_WAIT / 60)) min for it" >&2
            sleep "$MOVE_TO_POLL"
            waited=$((waited + MOVE_TO_POLL))
            if move_remote "$target" "test -e $(printf '%q' "$MOVE_TO_READY")" </dev/null >/dev/null 2>&1; then
                echo "agentbox: $MOVE_TO_READY is back on $target after ${waited}s; the move goes on" >&2
                waited=-1
                break
            fi
        done
        if (( waited >= 0 )); then
            MOVE_TO_WHY="$target has no $MOVE_TO_READY$( (( MOVE_TO_READY_WAIT > 0 )) && echo " (waited ${waited}s)"). $(move_to_check_state "$target")"
            return 1
        fi
    fi
    halted="$(move_to_halted "$target")" || { MOVE_TO_WHY="the move log on $target cannot be read"; return 1; }
    if [[ -n "$halted" ]]; then
        MOVE_TO_WHY="moves to $target are halted: $halted. The box-health lead decides, then runs \`agentbox move --to $target --clear-halt\`"
        return 1
    fi
    running="$(move_to_running "$target" "$@")" || { MOVE_TO_WHY="the omp processes on $target cannot be listed"; return 1; }
    if [[ -n "$running" ]]; then
        me="${AGENTBOX_HOST:-$(hostname -s)}"
        local sid pid lines=() landed=() both=()
        # A session that runs on the target and NOT here has already moved: this job is stale (a
        # relaunch job named LANE-E after it had landed on sami-devbox at 01:40Z, 2026-11-04).
        # That refuses this job alone. One that runs on BOTH machines is the dangerous one, and
        # it halts every move to the target for the box-health lead.
        while IFS=$'\t' read -r sid pid; do
            [[ -n "$sid" ]] || continue
            if [[ -n "$(move_to_running "" "$sid")" ]]; then
                both+=("$sid (pid $pid there)")
                lines+=("$(date -u +%FT%TZ)	$sid	-	$me	$target	both-machines	pid $pid on $target")
            else
                landed+=("$sid (pid $pid there)")
            fi
        done <<<"$running"
        if (( ${#both[@]} )); then
            move_to_log "$target" "${lines[@]}" || true
            MOVE_TO_WHY="${both[*]} already runs on $target while it runs here: one session is running on both machines, so moves to $target are halted for the box-health lead"
            return 1
        fi
        MOVE_TO_WHY="${landed[*]} is on $target already and not here: this session has moved, and this job is stale. Nothing was hung up and no move is halted"
        return 1
    fi
    return 0
}

# move_to_target_worktrees TARGET: refuse a copy whose destination on the target is a git WORK
# TREE while the source here is not the same repository's: rocqperf's ~/src/oss-verifier has no
# .git of its own (its GIT_DIR is elsewhere), so a move copied it as a plain directory into the
# target's clone and left 272 untracked files there (N6Ready, 2026-11-03). A source that is the
# same repository (its own .git, or the worktree the move registers through git) is fine.
move_to_target_worktrees() {
    local target="$1" p bad=()
    for p in ${MOVE_TO_MIRROR[@]+"${MOVE_TO_MIRROR[@]}"} ${MOVE_TO_MERGE[@]+"${MOVE_TO_MERGE[@]}"}; do
        [[ -d "$p" ]] || continue
        [[ -e "$p/.git" ]] && continue
        [[ -e "$p/HEAD" && -e "$p/objects" ]] && continue
        move_remote "$target" "test -e $(printf '%q' "$p/.git")" </dev/null >/dev/null 2>&1 && bad+=("$p")
    done
    (( ${#bad[@]} == 0 )) && return 0
    MOVE_TO_WHY="$target keeps a git clone at $(printf '%s ' "${bad[@]}")and this machine's copy is not that repository's work tree (no .git of its own, so its GIT_DIR is elsewhere): copying it would leave untracked files in the clone. Commit and push what you need, then move with --leave for each of those paths"
    return 1
}

# move_to_mcp_logins TARGET: the MCP servers this machine's omp holds an OAuth login for and TARGET's
# does not, one server URL per line. omp keeps those logins in each machine's own
# ~/.omp/agent/agent.db, which every box on that machine binds, so a session moved to a machine
# without one loses the server: it answers HTTP 401 when the session starts and its tools never
# mount (the chief of staff's Slack tools after its move to sami-devbox, 2026-11-03). Only the
# credential names are read, never their data. A login stays per machine: two machines refreshing
# copies of one rotating refresh token would revoke each other's, so the remedy is one sign-in on
# the target, which every box there then shares.
MCP_LOGINS_SQL="select distinct provider from auth_credentials where provider like 'mcp_oauth:%' and disabled_cause is null"
move_to_mcp_logins() {
    local target="$1" here there
    here="$(sqlite3 -readonly "$HOME/.omp/agent/agent.db" "$MCP_LOGINS_SQL" 2>/dev/null)" || return 0
    [[ -n "$here" ]] || return 0
    # A target whose agent.db cannot be read holds no login a session could use there.
    there="$(move_remote "$target" "sqlite3 -readonly \"\$HOME/.omp/agent/agent.db\" $(printf '%q' "$MCP_LOGINS_SQL")" </dev/null 2>/dev/null)" || there=""
    comm -23 <(sort -u <<<"$here") <(sort -u <<<"$there") | sed 's/^mcp_oauth:profile:[^:]*://; s/^mcp_oauth://'
}

# move_to_warn_mcp_logins TARGET: say on stderr which MCP servers a session moved to TARGET will not
# reach for want of a login there, and the one step that fixes it. A warning, not a refusal: the
# session still moves, and once someone signs in on TARGET the session gets the server back when
# it restarts or runs `/mcp reconnect <server>`.
move_to_warn_mcp_logins() {
    local target="$1" missing
    missing="$(move_to_mcp_logins "$target")"
    [[ -n "$missing" ]] || return 0
    echo "agentbox: warning: omp on $target holds no login for the MCP server(s) $(tr '\n' ' ' <<<"$missing")- a session moved there gets none of their tools until someone signs in on $target once: start omp there and run \`/mcp reauth <server>\` (every box on $target shares that login)" >&2
}

# move_to_dests_writable TARGET: every path the copy writes on the target must be writable by the
# move's user: the path itself when it exists, else its nearest existing ancestor. An EMPTY
# directory owned by root there is what docker leaves when a box is started with a --dir that did
# not exist yet; it is removed with `sudo -n rmdir` (empty only) and named. LINUX-1248's first
# move (2026-11-03 02:48Z) hung up, then failed in rsync on such a directory, made at 02:18Z, and
# rolled back. Asked BEFORE the hang-up; sets MOVE_TO_WHY and returns 1 when a path stays unwritable.
move_to_dests_writable() {
    local target="$1" out
    local -a paths=(${MOVE_TO_MIRROR[@]+"${MOVE_TO_MIRROR[@]}"} ${MOVE_TO_MERGE[@]+"${MOVE_TO_MERGE[@]}"} ${MOVE_TO_MKDIR[@]+"${MOVE_TO_MKDIR[@]}"})
    (( ${#paths[@]} )) || return 0
    # shellcheck disable=SC2016  # expanded on the target
    out="$(printf '%s\0' "${paths[@]}" | move_remote "$target" '
        while IFS= read -r -d "" p; do
            q="$p"
            if [ -d "$q" ] && [ ! -w "$q" ] && [ "$(stat -c %u "$q")" = 0 ] && [ -z "$(ls -A "$q" 2>/dev/null)" ]; then
                if sudo -n rmdir "$q" 2>/dev/null; then echo "REMOVED $q"; else echo "BLOCKED $q (an empty directory owned by root, and sudo -n rmdir failed)"; continue; fi
            fi
            while [ ! -e "$q" ] && [ "$q" != / ]; do q="$(dirname "$q")"; done
            if [ -d "$q" ]; then [ -w "$q" ] || echo "BLOCKED $p ($q is not writable by $(id -un))"
            else [ -w "$q" ] || [ "$q" != "$p" ] || echo "BLOCKED $p (not writable by $(id -un))"; fi
        done' 2>&1)" || { MOVE_TO_WHY="the copy destinations on $target could not be checked: $out"; return 1; }
    local line blocked=()
    while IFS= read -r line; do
        case "$line" in
            "REMOVED "*) echo "agentbox: removed the empty root-owned directory ${line#REMOVED } on $target (a box started with it before it existed)" >&2 ;;
            "BLOCKED "*) blocked+=("${line#BLOCKED }") ;;
        esac
    done <<<"$out"
    (( ${#blocked[@]} == 0 )) && return 0
    MOVE_TO_WHY="the copy cannot write on $target: $(printf '%s; ' "${blocked[@]}")fix those there first"
    return 1
}

# move_to_cwds_present TARGET CWD…: each working directory the copy does not bring (one every
# box has, or a root of many sessions' trees, which a move never copies) must already be on the
# target, since a box cannot start without its first --dir and --drop-gone-dirs never drops it.
# Asked BEFORE the hang-up, so such a session is refused while it still runs; MOVE_TO_MIRROR and
# MOVE_TO_MERGE must be built. Sets MOVE_TO_WHY with EVERY one missing (LANE-C: a refusal that
# names one path at a time costs a round of work for each, 2026-11-03) and returns 1.
move_to_cwds_present() {
    local target="$1" cwd p covered missing=()
    shift
    for cwd in "$@"; do
        covered=false
        for p in ${MOVE_TO_MIRROR[@]+"${MOVE_TO_MIRROR[@]}"} ${MOVE_TO_MERGE[@]+"${MOVE_TO_MERGE[@]}"} ${MOVE_TO_MKDIR[@]+"${MOVE_TO_MKDIR[@]}"}; do
            if move_within "$cwd" "$p"; then covered=true; break; fi
        done
        $covered && continue
        move_remote "$target" "test -d $(printf '%q' "$cwd")" </dev/null >/dev/null 2>&1 || missing+=("$cwd")
    done
    if (( ${#missing[@]} )); then
        MOVE_TO_WHY="these working directories are not on $target, and a move does not copy them (every box here has them, or they hold many sessions' trees): $(printf '%s ' "${missing[@]}"); make them there first"
        return 1
    fi
    return 0
}


# move_to_src_trees CWD PID: "mirror\t<path>" for each git working tree under $SRC the session's
# own live processes name (its working directory, theirs, the files they hold open for writing),
# and "merge\t<path>" for the directory right under $SRC that holds such a path in no git tree.
# The dotfiles are left out: they change only by commit and push, and each machine pulls them.
move_to_src_trees() {
    local cwd="$1" pid="$2" path _why tree rel real dots kind
    local -A seen=()
    dots="$(readlink -f "$DOTFILES_DIR" 2>/dev/null || echo "$DOTFILES_DIR")"
    while IFS=$'\t' read -r path _why; do
        [[ -n "$path" ]] || continue
        [[ -d "$path" ]] || path="${path%/*}"
        if ! { move_within "$path" "$SRC" && [[ "$path" != "$SRC" ]]; }; then
            # A git tree of the session's own elsewhere that every box has (…/wt/<name>).
            tree="$(move_to_own_git_tree "$path")" || continue
            [[ -z "${seen[$tree]:-}" ]] || continue
            seen[$tree]=1
            printf 'mirror\t%s\n' "$tree"
            continue
        fi
        kind=mirror
        if move_git_root_var "$path" && move_within "$MOVE_GIT_ROOT" "$SRC" && [[ "$MOVE_GIT_ROOT" != "$SRC" ]]; then
            tree="$MOVE_GIT_ROOT"
        else
            rel="${path#"$SRC"/}"
            tree="$SRC/${rel%%/*}"
            kind=merge
        fi
        [[ -z "${seen[$tree]:-}" ]] || continue
        seen[$tree]=1
        real="$(readlink -f "$tree" 2>/dev/null || echo "$tree")"
        if move_within "$real" "$dots" || move_within "$real" "$HOME/.dotfiles"; then continue; fi
        printf '%s\t%s\n' "$kind" "$tree"
    done < <(printf '%s\tits working directory\n' "$cwd"; [[ -n "$pid" ]] && MOVE_PROC_KEEP_SRC=true move_proc_dirs "$pid")
    return 0
}

# move_to_transcript_paths PATH: "mirror\t<path>" for what a session's transcript is on disk: the
# file, its own directory (the path without `.jsonl`: its subagents' transcripts, and the
# marker's place), and what a symlink among them points at, since an archived transcript stays
# behind a symlink to /mnt/durable. A transcript the session sweep took has no file and is read
# from Postgres on the target as here.
move_to_transcript_paths() {
    local t="$1" p real link
    for p in "$t" "${t%.jsonl}"; do
        [[ -e "$p" || -L "$p" ]] || continue
        printf 'mirror\t%s\n' "$p"
        if [[ -L "$p" ]]; then
            real="$(readlink -f "$p" 2>/dev/null || true)"
            [[ -n "$real" && -e "$real" ]] && printf 'mirror\t%s\n' "$real"
        fi
    done
    [[ -d "${t%.jsonl}" ]] || return 0
    # Two levels: a subagent's transcript and its own subagents'. A lead's session directory holds
    # thousands of entries, and a walk of all of it ran for minutes at load 600.
    # The archiver moves a session directory's files to the same relative place under its own
    # root and leaves a symlink for each, so a lead's offloaded logs were 330 paths of one plan;
    # a target inside a directory named as this session's own is copied as that directory, once.
    local own base d
    local -A said=()
    own="$(readlink -f "${t%.jsonl}")"
    base="${own##*/}"
    # The link's own target, from the `find`; `readlink -f` (a fork) only for a relative one.
    while IFS=$'\t' read -r -d '' link real; do
        [[ "$real" == /* ]] || real="$(readlink -f "$link" 2>/dev/null)" || continue
        [[ -e "$real" ]] || continue
        move_within "$real" "$own" && continue
        d="$real"
        while [[ "$d" == /*/* && "${d##*/}" != "$base" ]]; do d="${d%/*}"; done
        [[ "${d##*/}" == "$base" ]] && real="$d"
        [[ -z "${said[$real]:-}" ]] || continue
        said[$real]=1
        printf 'mirror\t%s\n' "$real"
    done < <(find -H "${t%.jsonl}" -maxdepth 2 -type l -printf '%p\t%l\0' 2>/dev/null)
    return 0
}

# move_to_session_paths PID SID CWD [DIR…]: what a move to another machine takes for one session.
# MOVE_TO_DIRS: its --dir paths, exactly as `move --self` gives them (DIR… are the caller's
# own). MOVE_TO_SHARE: the paths that put two sessions in one group - its git working trees.
# MOVE_TO_COPY: "mirror\t<path>" (those trees) and "merge\t<path>" (everything else: git
# storage, the checkout that owns a worktree, a directory in no git tree)
# lines, move_to_copy_lists' input. Only git trees group: on 2026-11-02 the paths of this host's
# 46 sessions put 45 of them in one group, through caches (/mnt/nvme/<user>/cache, gocache,
# gotmp), a review tool's run directory (gate-runs, 16 sessions), /mnt/durable and lead roots;
# their git working trees alone made one group of 13 (a shared checkout), one of 2 and 31 of one.
# The working directory itself is neither copied nor shared when it is a path every box has (a
# tree under $SRC is its src tree instead) or a root that holds many sessions' trees ($SRC,
# /mnt/nvme/<user>, ~/Code): a lead on this host works in ~/src itself, and its copy would have
# been all of ~/src, its group every session with a tree there.
# `move --to --leave PATH`: trees the caller works in no more (its omp may still have its working
# directory there), and `--cwd PATH`: where it resumes instead. MOVE_TO_LEAVE_SID is the caller.
MOVE_TO_LEAVE=() MOVE_TO_LEAVE_SID=""
move_to_left() {
    local p
    # Only a path: a descriptor's `pipe:[…]` or `socket:[…]` resolved against the working
    # directory used to land inside the left tree (LINUX-1248's dry run, 2026-11-03).
    [[ "$1" == /* ]] || return 1
    for p in ${MOVE_TO_LEAVE[@]+"${MOVE_TO_LEAVE[@]}"}; do
        if move_within "$1" "$p" || move_within "$(readlink -f "$1" 2>/dev/null || echo "$1")" "$p"; then return 0; fi
    done
    return 1
}

# move_to_own_git_tree DIR: the root of the git working tree DIR is in, when that tree is one a
# move copies although its parent is a path every box has or a root of many sessions' trees: a
# worktree the box preamble puts under /mnt/nvme/<user>/wt, say. Not the dotfiles, and not a
# tree that is itself such a root.
move_to_own_git_tree() {
    local dots
    move_git_root_var "$1" || return 1
    move_dir_too_broad "$MOVE_GIT_ROOT" && return 1
    dots="$(readlink -f "$DOTFILES_DIR" 2>/dev/null || echo "$DOTFILES_DIR")"
    if move_within "$MOVE_GIT_ROOT" "$dots" || move_within "$MOVE_GIT_ROOT" "$HOME/.dotfiles"; then return 1; fi
    printf '%s\n' "$MOVE_GIT_ROOT"
}
# move_to_holds_trees DIR: DIR, in no git tree itself, has a git tree below it.
move_to_holds_trees() {
    [[ -n "$(find "$1" -mindepth 2 -maxdepth 4 -name .git -print -quit 2>/dev/null)" ]]
}
MOVE_TO_DIRS=() MOVE_TO_SHARE=() MOVE_TO_COPY=()
move_to_session_paths() {
    local pid="$1" sid="$2" cwd="$3" path why kind store
    shift 3
    MOVE_TO_DIRS=() MOVE_TO_SHARE=() MOVE_TO_COPY=()
    # What a pointer file names is the machine's own configuration, as the pointer is: the
    # target's `agentbox new` binds its own (move_config_dirs), and no move copies it. So the
    # inference reads no pointer file here. Dropping its entry afterwards was wrong: the entry is
    # bounded at a shared root (/mnt/nvme/<user>/frac-verify for the leak check), every path the
    # session named inside it collapsed into it, and S3's `--dir …/frac-verify/s3` vanished with
    # it, silently (2026-11-03).
    local MOVE_POINTER_FILES=(/nonexistent/agentbox-move-to-reads-no-pointer-file)
    # One walk of the session's processes, kept for both readers below.
    MOVE_PROC_MEMO_PID=""
    if [[ -n "$pid" ]]; then
        MOVE_PROC_MEMO="$(MOVE_PROC_KEEP_SRC=true move_proc_dirs "$pid")"
        MOVE_PROC_MEMO_PID="$pid"
    fi
    # The deepest paths the session used, and files it named as themselves (MOVE_EXACT).
    local MOVE_EXACT=true MOVE_EXACT_FILES dir_of
    MOVE_EXACT_FILES="$(mktemp)"
    while IFS=$'\t' read -r path why; do
        [[ -n "$path" ]] || continue
        if [[ "$why" == "FILE: "* ]]; then
            # Copied as itself; the box is given its directory, which the copy creates.
            MOVE_TO_COPY+=("merge	$path")
            dir_of="${path%/*}"
            [[ " ${MOVE_TO_DIRS[*]} " == *" $dir_of "* ]] || MOVE_TO_DIRS+=("$dir_of")
            continue
        fi
        MOVE_TO_DIRS+=("$path")
        if [[ "$path" == "$cwd" ]] && { move_dir_in_box "$path" || move_dir_too_broad "$path"; }; then
            # A git worktree of the session's own there is re-created on the target: mirrored,
            # or moved through git into the target's clone (LINUX-1248's worktree under
            # /mnt/nvme/sami/wt was refused as "not copied" on 2026-11-03).
            local own_tree
            if own_tree="$(move_to_own_git_tree "$path")"; then
                MOVE_TO_COPY+=("mirror	$own_tree")
                MOVE_TO_SHARE+=("$own_tree")
                continue
            fi
            echo "agentbox: $path (session $sid's working directory) is not copied: it holds many sessions' trees or every box has it; the target must have it already" >&2
            continue
        fi
        # A working directory that holds other trees (a lead's root, ~/Code/personal/theorem with
        # its worktrees, 881 MiB, for S3 on 2026-11-03) is made EMPTY on the target: the box starts
        # there, and only what the session used inside it is copied into it.
        if [[ "$path" == "$cwd" ]] && ! move_git_root_var "$path" && move_to_holds_trees "$path"; then
            echo "agentbox: $path (session $sid's working directory) is made empty on the target: it holds other trees, so only the paths the session used inside it are copied" >&2
            MOVE_TO_COPY+=("mkdir	$path")
            continue
        fi
        case "$why" in
            "the git object store of "*) MOVE_TO_COPY+=("merge	$path") ;;
            "the checkout that owns that worktree")
                while IFS= read -r store; do MOVE_TO_COPY+=("merge	$store"); done < <(move_git_storage "$path")
                ;;
            *)
                if move_git_root_var "$path"; then
                    MOVE_TO_COPY+=("mirror	$path")
                    MOVE_TO_SHARE+=("$path")
                else
                    MOVE_TO_COPY+=("merge	$path")
                fi
                ;;
        esac
    done < <(move_dirs_why "$cwd" "$pid" "$sid" "$@" 2>/dev/null)
    rm -f "$MOVE_EXACT_FILES"
    (( ${#MOVE_TO_DIRS[@]} )) || return 1
    while IFS=$'\t' read -r kind path; do
        MOVE_TO_COPY+=("$kind	$path")
        [[ "$kind" == mirror ]] && MOVE_TO_SHARE+=("$path")
    done < <(move_to_src_trees "$cwd" "$pid")
    MOVE_PROC_MEMO_PID="" MOVE_PROC_MEMO=""
    # The trees the caller leaves behind (`move --to --leave`) are neither copied nor shared.
    if [[ -n "$MOVE_TO_LEAVE_SID" && "$sid" == "$MOVE_TO_LEAVE_SID" ]]; then
        local kept=() line
        for line in ${MOVE_TO_DIRS[@]+"${MOVE_TO_DIRS[@]}"}; do move_to_left "$line" || kept+=("$line"); done
        MOVE_TO_DIRS=(${kept[@]+"${kept[@]}"}); kept=()
        for line in ${MOVE_TO_SHARE[@]+"${MOVE_TO_SHARE[@]}"}; do move_to_left "$line" || kept+=("$line"); done
        MOVE_TO_SHARE=(${kept[@]+"${kept[@]}"}); kept=()
        for line in "${MOVE_TO_COPY[@]}"; do
            # A left checkout's git storage stays: a worktree of it that the session keeps needs it.
            if [[ "${line#*$'\t'}" != */.git && "${line#*$'\t'}" != */.git/* ]] && move_to_left "${line#*$'\t'}"; then
                echo "agentbox: ${line#*$'\t'} is not copied: it is in a tree this session --leave's" >&2
            else
                kept+=("$line")
            fi
        done
        MOVE_TO_COPY=(${kept[@]+"${kept[@]}"})
    fi
    return 0
}

# move_to_gate ASKED…: what a move copies is what the session asked for - its --dir paths of
# this move, its working directory, its transcript - and what it was inferred to use at that
# path's exact size: a file as that file, a git tree as that tree, its git storage. An inferred
# directory in no git tree is copied only when it is under MOVE_TO_GATE_BYTES (5 GB); one over
# that, or that `du` cannot measure in MOVE_TO_GATE_WAIT seconds, leaves the copy and is listed
# in MOVE_TO_UNASKED with its size, to pass with --dir. PROCS's move (2026-11-03 07:09Z) held
# all of /mnt/nvme/sami/wt - 323 GB of every session's worktrees - for one file and one worktree
# of its own there.
MOVE_TO_GATE_BYTES="${AGENTBOX_MOVE_GATE_BYTES:-5000000000}"
MOVE_TO_GATE_WAIT="${AGENTBOX_MOVE_GATE_WAIT:-20}"
# The --dir paths of this move: named, so copied as themselves even when nothing infers them.
MOVE_TO_NAMED=()
MOVE_TO_UNASKED=()
# Paths no move ever copies: the kernel's own filesystems and the machine's run directories. One
# of them in a session's inferred paths would be copied into the target's /proc or /run.
move_to_kernel_path() {
    case "$1" in
        /proc|/proc/*|/sys|/sys/*|/dev|/dev/*|/run|/run/*) return 0 ;;
    esac
    return 1
}

move_to_gate() {
    local p a asked c real size
    local -a check=() keep_mirror=() keep_merge=()
    local -A sizes=() stores=()
    MOVE_TO_UNASKED=()
    for c in "$SRC"/*/.git; do
        [[ -d "$c/objects" ]] || continue
        real="$(readlink -f "$c/objects" 2>/dev/null)" && stores[$real]=1
    done
    move_to_gated() {
        local p="$1" a
        [[ -d "$p" && ! -L "$p" ]] || return 1
        for a in "${@:2}"; do [[ -n "$a" ]] && move_within "$p" "$a" && return 1; done
        [[ -e "$p/.git" || ( -e "$p/HEAD" && -e "$p/objects" ) || -n "${stores[$p]:-}" ]] && return 1
        move_git_root_var "$p" && return 1
        return 0
    }
    for p in ${MOVE_TO_MIRROR[@]+"${MOVE_TO_MIRROR[@]}"} ${MOVE_TO_MERGE[@]+"${MOVE_TO_MERGE[@]}"}; do
        move_to_gated "$p" "$@" && check+=("$p")
    done
    if (( ${#check[@]} )); then
        while IFS=$'\t' read -r size p; do
            [[ -n "$p" ]] && sizes[$p]="$size"
        done < <(printf '%s\0' "${check[@]}" \
            | xargs -0 -r -P "$MOVE_RECORD_JOBS" -n 1 timeout "$MOVE_TO_GATE_WAIT" du -sxB1 2>/dev/null || true)
    fi
    for p in ${MOVE_TO_MIRROR[@]+"${MOVE_TO_MIRROR[@]}"}; do
        move_to_kernel_path "$p" && { MOVE_TO_UNASKED+=("$p (a kernel filesystem; never copied)"); continue; }
        if move_to_gate_drops "$p"; then continue; fi
        keep_mirror+=("$p")
    done
    for p in ${MOVE_TO_MERGE[@]+"${MOVE_TO_MERGE[@]}"}; do
        move_to_kernel_path "$p" && { MOVE_TO_UNASKED+=("$p (a kernel filesystem; never copied)"); continue; }
        if move_to_gate_drops "$p"; then continue; fi
        keep_merge+=("$p")
    done
    # (b) A path the session NAMED narrows an inferred parent: the parent goes, the named one
    # stays, so `--dir <tree>/sub` never pulls in <tree>.
    local keep=() q narrowed
    for p in ${keep_mirror[@]+"${keep_mirror[@]}"}; do
        narrowed=false
        for q in "$@"; do
            [[ -n "$q" && "$q" != "$p" ]] && move_within "$q" "$p" && { narrowed=true; break; }
        done
        $narrowed || keep+=("$p")
    done
    keep_mirror=(${keep[@]+"${keep[@]}"}); keep=()
    for p in ${keep_merge[@]+"${keep_merge[@]}"}; do
        narrowed=false
        for q in "$@"; do
            [[ -n "$q" && "$q" != "$p" ]] && move_within "$q" "$p" && { narrowed=true; break; }
        done
        $narrowed || keep+=("$p")
    done
    keep_merge=(${keep[@]+"${keep[@]}"})
    # A path the session NAMED with --dir and that nothing else covers is copied as itself: it
    # was asked for. A working directory is not re-added: one that holds other sessions' trees is
    # made empty on the target, and one every box has must be there already.
    for q in ${MOVE_TO_NAMED[@]+"${MOVE_TO_NAMED[@]}"}; do
        [[ -n "$q" && -e "$q" ]] || continue
        move_to_kernel_path "$q" && continue
        for p in ${keep_mirror[@]+"${keep_mirror[@]}"} ${keep_merge[@]+"${keep_merge[@]}"} ${MOVE_TO_MKDIR[@]+"${MOVE_TO_MKDIR[@]}"}; do
            move_within "$q" "$p" && { q=""; break; }
        done
        [[ -z "$q" ]] && continue
        if move_git_root_var "$q" && [[ "$MOVE_GIT_ROOT" == "$q" ]]; then keep_mirror+=("$q"); else keep_merge+=("$q"); fi
    done
    MOVE_TO_MIRROR=(${keep_mirror[@]+"${keep_mirror[@]}"})
    MOVE_TO_MERGE=(${keep_merge[@]+"${keep_merge[@]}"})
}
# For move_to_gate, which sets check and sizes: true, and the path listed, when it is dropped.
move_to_gate_drops() {
    local p="$1" c
    for c in ${check[@]+"${check[@]}"}; do
        [[ "$c" == "$p" ]] || continue
        if [[ -z "${sizes[$p]:-}" ]]; then
            MOVE_TO_UNASKED+=("$p (not measured within ${MOVE_TO_GATE_WAIT}s)")
            return 0
        fi
        if (( sizes[$p] > MOVE_TO_GATE_BYTES )); then
            MOVE_TO_UNASKED+=("$p ($(numfmt --to=iec "${sizes[$p]}"))")
            return 0
        fi
        return 1
    done
    return 1
}

# move_to_not_carried TOUCHES: from "<link>\t<target>" lines (the session's processes' working
# directories and open files), each directory the session uses that the copy does not carry and
# the target does not have by itself: the list its owner says yes to before the hang-up.
move_to_not_carried() {
    local link t d p carried
    local -A seen=()
    while IFS=$'\t' read -r link t; do
        [[ "$t" == /* && "$t" != *" (deleted)" ]] || continue
        if [[ "$link" == */cwd ]]; then d="$t"; else d="${t%/*}"; fi
        [[ -n "$d" && -z "${seen[$d]:-}" ]] || continue
        seen[$d]=1
        case "$d" in /|/proc|/proc/*|/sys|/sys/*|/dev|/dev/*|/run|/run/*|/tmp|/tmp/*|/usr|/usr/*|/lib*|/etc|/etc/*|/opt|/opt/*|/bin|/bin/*|/sbin|/sbin/*|/var|/var/*|/snap/*) continue ;; esac
        move_dir_in_box "$d" && ! move_within "$d" "$SRC" && continue
        move_dir_dies_with_omp "$d" && continue
        carried=false
        for p in ${MOVE_TO_MIRROR[@]+"${MOVE_TO_MIRROR[@]}"} ${MOVE_TO_MERGE[@]+"${MOVE_TO_MERGE[@]}"} ${MOVE_TO_MKDIR[@]+"${MOVE_TO_MKDIR[@]}"}; do
            if move_within "$d" "$p" || move_within "$t" "$p"; then carried=true; break; fi
        done
        $carried || printf '%s\n' "$d"
    done | sort -u | awk 'NR == 1 || index($0, prev "/") != 1 { print; prev = $0 }' | head -40
}

# The two lists the owner says yes to, and what was left out for its size.
move_to_print_lists() {
    local target="$1" not_carried="$2" p
    echo "CARRIED to $target (say yes to this list):"
    for p in ${MOVE_TO_MIRROR[@]+"${MOVE_TO_MIRROR[@]}"}; do echo "  mirror  $p"; done
    for p in ${MOVE_TO_MERGE[@]+"${MOVE_TO_MERGE[@]}"}; do echo "  merge   $p"; done
    for p in ${MOVE_TO_MKDIR[@]+"${MOVE_TO_MKDIR[@]}"}; do echo "  empty   $p"; done
    echo "NOT CARRIED (the session will not see these on $target; pass --dir for any it needs):"
    if [[ -n "$not_carried" ]]; then sed 's/^/  /' <<<"$not_carried"; else echo "  (nothing its processes use now)"; fi
    if (( ${#MOVE_TO_UNASKED[@]} )); then
        echo "WOULD COPY, NOT ASKED FOR (inferred, over $(numfmt --to=si "$MOVE_TO_GATE_BYTES")B or not measurable; pass --dir to carry it):"
        printf '  %s\n' "${MOVE_TO_UNASKED[@]}"
    fi
}

# move_to_copy_lists: from "mirror\t<path>" / "merge\t<path>" lines on stdin, MOVE_TO_MIRROR
# (copied with deletions) and MOVE_TO_MERGE (no deletion, nothing newer replaced), each the
# smallest set of paths covering the others, with a symlink's target beside the link. A working
# tree's own .git directory goes to MOVE_TO_MERGE, and MOVE_TO_EXCLUDE keeps the mirror off it.
# "mkdir\t<path>" lines go to MOVE_TO_MKDIR: directories made EMPTY on the target, since the
# session works in them but they hold other sessions' trees (move_to_holds_trees).
MOVE_TO_MIRROR=() MOVE_TO_MERGE=() MOVE_TO_EXCLUDE=() MOVE_TO_MKDIR=()
move_to_copy_lists() {
    local kind path real store p q keep
    local -a mirror=() merge=() mkdirs=()
    while IFS=$'\t' read -r kind path; do
        [[ -n "$path" ]] || continue
        [[ -e "$path" || -L "$path" ]] || continue
        for p in "$path" "$(readlink -f "$path" 2>/dev/null || true)"; do
            [[ -n "$p" && ( -e "$p" || -L "$p" ) ]] || continue
            case "$kind" in merge) merge+=("$p") ;; mkdir) mkdirs+=("$p") ;; *) mirror+=("$p") ;; esac
        done
        if [[ "$kind" != mkdir && -d "$path" ]] && move_git_root_var "$path" && [[ "$MOVE_GIT_ROOT" == "$path" ]]; then
            while IFS= read -r store; do merge+=("$store"); done < <(move_git_storage "$path")
        fi
    done
    MOVE_TO_MIRROR=() MOVE_TO_MERGE=() MOVE_TO_EXCLUDE=() MOVE_TO_MKDIR=()
    mapfile -t MOVE_TO_MKDIR < <(printf '%s\n' ${mkdirs[@]+"${mkdirs[@]}"} | sed '/^$/d' | sort -u)
    # A directory made EMPTY on the target is never also copied: another reader of the same
    # session may name it too (its record, its src trees), and the copy would bring the tree the
    # mkdir exists to avoid.
    local m
    for m in ${MOVE_TO_MKDIR[@]+"${MOVE_TO_MKDIR[@]}"}; do
        local kept=()
        for p in ${mirror[@]+"${mirror[@]}"}; do [[ "$p" == "$m" ]] || kept+=("$p"); done
        mirror=(${kept[@]+"${kept[@]}"}); kept=()
        for p in ${merge[@]+"${merge[@]}"}; do [[ "$p" == "$m" ]] || kept+=("$p"); done
        merge=(${kept[@]+"${kept[@]}"})
    done
    local sorted=()
    mapfile -t sorted < <(printf '%s\n' "${mirror[@]+"${mirror[@]}"}" | sort -u)
    for p in "${sorted[@]}"; do
        [[ -n "$p" ]] || continue
        keep=1
        for q in ${MOVE_TO_MIRROR[@]+"${MOVE_TO_MIRROR[@]}"}; do move_within "$p" "$q" && { keep=0; break; }; done
        (( keep )) && MOVE_TO_MIRROR+=("$p")
    done
    mapfile -t sorted < <(printf '%s\n' "${merge[@]+"${merge[@]}"}" | sort -u)
    for p in "${sorted[@]}"; do
        [[ -n "$p" ]] || continue
        keep=1
        for q in ${MOVE_TO_MERGE[@]+"${MOVE_TO_MERGE[@]}"}; do move_within "$p" "$q" && { keep=0; break; }; done
        (( keep )) || continue
        MOVE_TO_MERGE+=("$p")
        for q in ${MOVE_TO_MIRROR[@]+"${MOVE_TO_MIRROR[@]}"}; do
            if move_within "$p" "$q" && [[ "$p" != "$q" ]]; then MOVE_TO_EXCLUDE+=("$p"); break; fi
        done
    done
    return 0
}

# One line of a copy's cost: the rsync's time and its --stats bytes.
move_to_copy_said() {
    local kind="$1" label="$2" secs="$3" f="$4" total literal files
    total="$(sed -n 's/^Total transferred file size: //p' "$f" | head -1)"
    literal="$(sed -n 's/^Literal data: //p' "$f" | head -1)"
    files="$(sed -n 's/^Number of regular files transferred: //p' "$f" | head -1)"
    say "rsync $kind $label: ${secs}s, ${files:-?} files transferred, ${total:-?} transferred file size, ${literal:-?} literal data"
}

# move_pane_script SID BODY: BODY in a file, and the file's path. tmux takes a pane's command as
# ARGUMENTS, and a box spec with hundreds of --dir paths made it too long: the omp lead's job
# carried 792 words (18 KB), `new-window` on the target failed, and 40 respawn attempts answered
# "command too long", which left the session DOWN (23:49-23:59Z, 2026-11-03). A file keeps every
# tmux command the same length whatever the spec holds.
move_pane_script() {
    local sid="$1" body="$2" path
    mkdir -p "$MOVE_TO_JOBS/panes" || return 1
    path="$MOVE_TO_JOBS/panes/$sid.sh"
    printf '%s\n' "$body" >"$path" || return 1
    chmod +x "$path" || return 1
    printf '%s\n' "$path"
}

# A long child of the relauncher (rsync, git push), run so that a signal reaches the relauncher at
# once: bash runs a trap only after its foreground child exits, and a TERM to a relauncher in the
# middle of a long copy otherwise waits for the copy. MOVE_TO_CHILD is what the handler stops.
MOVE_TO_CHILD=""
move_to_fg() {
    local rc
    "$@" &
    MOVE_TO_CHILD=$!
    wait "$MOVE_TO_CHILD"
    rc=$?
    MOVE_TO_CHILD=""
    return "$rc"
}

# One rsync of a move. A file that the session writes while the copy walks it is normal - a
# session at work has temporary files (`...packet.json_.gstmp`, an editor's `.#file`) - and rsync
# ends with 24 ("some files vanished"). That is NOT a failure: the pass after the hang-up copies
# whatever the first pass missed, and there a file the session no longer has is gone for good.
# LANE-C's move (2026-11-03 14:46Z) hit it in the merge pass. Each run says how long it took, so a
# long copy is not read as a dead move, and the vanished files are said once with their count.
MOVE_TO_RSYNC_TICK="${AGENTBOX_MOVE_RSYNC_TICK:-300}"
# What one progress line says: rsync's own `--info=progress2` record - bytes sent, how far, the
# rate and the time left - and how long the pass has run. It is read from the pass's stdout file,
# where progress records are separated by carriage returns.
move_to_rsync_progress() {
    tr '\r' '\n' <"$1" 2>/dev/null | grep -E '[0-9]+%' | tail -1 | tr -s ' ' | sed 's/^ //'
}
# Every step of a move says where it is through `say`, which the relauncher defines with its
# group's name. A function of this file called on its own (a test, a person debugging a copy) has
# no relauncher around it, so there is a plain one here that the relauncher's own shadows.
say() { echo "$(date -u +%FT%TZ) agentbox: $*"; }
# The progress subshell of the running rsync and that rsync's error file, as MOVE_TO_CHILD is its
# rsync: globals, so a signal that ends the relauncher in the middle of the copy stops the one and
# removes the other (move_to_run_signal, move_to_run_exit). Bash runs a trap between any two
# commands, so a signal can land between the subshell's fork and the line that records its pid:
# MOVE_TO_TICK_PID is then `starting`, and when $! has moved past MOVE_TO_TICK_BEFORE, the last
# background pid before the fork, $! is the subshell.
MOVE_TO_TICK_PID="" MOVE_TO_TICK_BEFORE="" MOVE_TO_RSYNC_ERR=""
move_to_rsync_tick_stop() {
    if [[ "$MOVE_TO_TICK_PID" == starting ]]; then
        MOVE_TO_TICK_PID=""
        [[ "${!:-}" == "$MOVE_TO_TICK_BEFORE" ]] || MOVE_TO_TICK_PID="$!"
    fi
    [[ -n "$MOVE_TO_TICK_PID" ]] || return 0
    kill "$MOVE_TO_TICK_PID" 2>/dev/null || true
    wait "$MOVE_TO_TICK_PID" 2>/dev/null || true
    MOVE_TO_TICK_PID=""
}

move_to_rsync() {
    local kind="$1" stats="$2" label="${MOVE_TO_RSYNC_LABEL:-}" line sid err_fd
    shift 2
    local rc=0 err start=$SECONDS
    # The global first: a signal right after the mktemp still finds the file to remove.
    MOVE_TO_RSYNC_ERR="$(mktemp)"
    err="$MOVE_TO_RSYNC_ERR"
    # A long pass said nothing until it ended, so its owners read it as a dead move (LANE-C's
    # merge pass, 76 minutes at 4 MB/s, 2026-11-03 14:46Z). Every MOVE_TO_RSYNC_TICK seconds the
    # pass says where it is, in the move log and to each session that waits for it.
    if (( MOVE_TO_RSYNC_TICK > 0 )); then
        MOVE_TO_TICK_BEFORE="${!:-}" MOVE_TO_TICK_PID=starting
        (
            # NO CHILD WAITS THE TICK: `read -t` on a pipe this subshell holds both ends of
            # waits inside bash, and a TERM runs the trap below at once. A `sleep` child
            # outlived the subshell: measured 2026-11-05, killing the subshell alone left seven
            # orphaned `sleep 300` with ppid 1, each holding the inherited stdout pipe open, so a
            # caller reading that pipe waited out the whole tick (in test_agentbox_move.py the 15
            # tests that do not set AGENTBOX_MOVE_RSYNC_TICK each paid 302 s for it, 4,530 s of
            # the suite's 4,929 s); and a sleep forked just before the TERM, whose pid the trap
            # did not have yet, still outlived it. Only a timeout is a tick.
            trap 'exit 0' TERM INT
            exec {tick_fd}<> <(:)
            wait "$!" 2>/dev/null || true
            while :; do
                waited=0
                read -r -t "$MOVE_TO_RSYNC_TICK" -u "$tick_fd" || waited=$?
                (( waited > 128 )) || break
                line="rsync $kind: ${label:-copying} for $((SECONDS - start))s: $(move_to_rsync_progress "$stats")"
                say "$line"
                for sid in ${MOVE_TO_ACTIVE_SIDS[@]+"${MOVE_TO_ACTIVE_SIDS[@]}"}; do
                    envoy_send_text --source envoy "$sid" "agentbox: your move goes on. $line (An automated notice from agentbox.)" >/dev/null 2>&1 || true
                done
            done
        ) &
        MOVE_TO_TICK_PID=$!
    fi
    # rsync's messages are kept AND still reach the log: `2>"$err"` alone would take the
    # relauncher's own signal line with them, since a trap runs inside the redirection of the
    # command it interrupts, and that line is the only record of a stopped move. tee gets the file
    # this shell opened, not its path: given the path, a tee that opens it after a signal's
    # move_to_run_exit removed it creates the file again, holding that line.
    exec {err_fd}>"$err"
    move_to_fg rsync "$@" >"$stats" 2> >(tee "/dev/fd/$err_fd" >&2) || rc=$?
    exec {err_fd}>&-
    move_to_rsync_tick_stop
    say "rsync $kind: $((SECONDS - start))s, exit $rc"
    if (( rc == 24 )); then
        say "rsync $kind: $(grep -c "^file has vanished" "$err" || true) file(s) vanished while they were copied; the move goes on (rsync exit 24)"
        rc=0
    elif (( rc == 23 )); then
        # 23 is "some files were not transferred". When every one of them is a source file that is
        # gone now (a session's temp file in a shared tree: LANE-E, 01:19:59Z on 2026-11-04), there
        # is nothing left to copy and the move goes on; any other error still fails it.
        local bad gone=0 other=0
        while IFS= read -r bad; do
            [[ -n "$bad" ]] || continue
            case "$bad" in
                # A source file gone before rsync reached it: the receiver's "No such file or
                # directory", and the SENDER's own link_stat of a tree another session deleted
                # while this one was listed (REMOVALS, 03:03:15Z 2026-11-04).
                *"No such file or directory"*|*"file has vanished"*|*link_stat*) gone=$((gone + 1)) ;;
                *) other=$((other + 1)) ;;
            esac
        done < <(grep -E '^rsync: |^file has vanished|link_stat' "$err" 2>/dev/null || true)
        if (( other == 0 && gone > 0 )); then
            say "rsync $kind: $gone source file(s) were gone before they could be copied; the move goes on (rsync exit 23)"
            rc=0
        fi
    fi
    rm -f "$err"
    MOVE_TO_RSYNC_ERR=""
    return "$rc"
}

# Every symlink in the copy lists whose target no listed path covers, added to the mirror list.
# Run on the job's own lists, so a job another tool wrote is carried whole too.
move_to_add_link_targets() {
    local p real covered other
    local -a add=()
    for p in ${MOVE_TO_MIRROR[@]+"${MOVE_TO_MIRROR[@]}"} ${MOVE_TO_MERGE[@]+"${MOVE_TO_MERGE[@]}"}; do
        [[ -L "$p" ]] || continue
        real="$(readlink -f -- "$p" 2>/dev/null)" || continue
        [[ -n "$real" && -e "$real" ]] || continue
        covered=0
        for other in ${MOVE_TO_MIRROR[@]+"${MOVE_TO_MIRROR[@]}"} ${MOVE_TO_MERGE[@]+"${MOVE_TO_MERGE[@]}"} ${add[@]+"${add[@]}"}; do
            [[ "$other" == "$p" ]] && continue
            move_within "$real" "$other" && { covered=1; break; }
        done
        (( covered )) && continue
        add+=("$real")
        say "$p is a symlink the job did not resolve; its target $real is carried too"
    done
    (( ${#add[@]} == 0 )) || MOVE_TO_MIRROR+=("${add[@]}")
    return 0
}

# move_to_settle_transcripts TRANSCRIPT…: after the hang-up and the last copy, make each member's
# transcript on the target byte for byte this machine's. The source omp has exited by now (the
# hang-up waits for its pid), so the file is final here. A mismatch is copied again, resolved
# path to resolved path, and checked again; after MOVE_TO_TRANSCRIPT_TRIES the move fails with
# nothing started, because a session resumed on a short transcript loses that history silently
# (29 of 99 sessions, 2026-11-03/04; their devbox copies were 500-2,000 lines short).
MOVE_TO_TRANSCRIPT_TRIES="${AGENTBOX_MOVE_TRANSCRIPT_TRIES:-3}"
move_to_settle_transcripts() {
    local t real try
    for t in "$@"; do
        [[ -n "$t" && -e "$t" ]] || continue
        real="$(readlink -f -- "$t" 2>/dev/null || printf '%s' "$t")"
        for (( try = 1; try <= MOVE_TO_TRANSCRIPT_TRIES; try++ )); do
            move_to_check_transcripts "$real" && break
            if (( try == MOVE_TO_TRANSCRIPT_TRIES )); then
                MOVE_TO_WHY="after $try tries, $real is still not the same on $target: $MOVE_TO_WHY"
                return 1
            fi
            say "$real differs on $target; copying it again (try $try)"
            move_to_fg rsync -aH --no-group --omit-dir-times --relative --inplace \
                -e "${MOVE_TO_SSH[*]}" "$real" "$MOVE_TO_USER@$target:/" >/dev/null 2>&1 || true
        done
    done
    return 0
}

# move_to_check_transcripts TRANSCRIPT…: each one's sha256 here against the target's, following
# a symlink on both sides (an offloaded transcript is a link into /mnt/durable). Sets MOVE_TO_WHY
# and returns 1 when one differs or cannot be read there: the session would resume on a stale
# copy, which is how R3A came back 2.65 MB short of its own history (03:04Z, 2026-11-04).
move_to_check_transcripts() {
    local t mine theirs out
    for t in "$@"; do
        [[ -n "$t" && -e "$t" ]] || continue
        mine="$(sha256sum -- "$t" 2>/dev/null | cut -d" " -f1)" || continue
        [[ -n "$mine" ]] || continue
        out="$(move_remote "$target" "sha256sum -- $(printf '%q' "$t") 2>/dev/null | cut -d' ' -f1" </dev/null 2>/dev/null)" || out=""
        theirs="$(tr -d '[:space:]' <<<"$out")"
        if [[ -z "$theirs" ]]; then
            MOVE_TO_WHY="the transcript $t is not on $target after the copy, so the session would resume with no history there"
            return 1
        fi
        if [[ "$theirs" != "$mine" ]]; then
            MOVE_TO_WHY="the transcript $t differs on $target after the copy ($mine here, $theirs there): the session would resume on a stale copy. An offloaded transcript is a symlink into the durable disk, and its TARGET is what must travel"
            return 1
        fi
    done
    return 0
}

# Every path of the move that is gone now, dropped from the copy lists and from the git-native
# plan, with a line each. Run right before the hang-up: a move holds for the session's `agentbox
# move --go`, and a session at work removes a tree (the librarian's ~/src/legion-turnfix, 17:27Z
# on 2026-11-03, whose native push then failed after the hang-up and rolled the group back). A
# native tree whose HEAD no longer resolves is copied as files instead.
move_to_drop_gone() {
    local p kept=() gone=() tree common
    for p in ${MOVE_TO_MIRROR[@]+"${MOVE_TO_MIRROR[@]}"}; do
        if [[ -e "$p" ]]; then kept+=("$p"); else gone+=("$p"); fi
    done
    MOVE_TO_MIRROR=(${kept[@]+"${kept[@]}"}); kept=()
    for p in ${MOVE_TO_MERGE[@]+"${MOVE_TO_MERGE[@]}"}; do
        if [[ -e "$p" ]]; then kept+=("$p"); else gone+=("$p"); fi
    done
    MOVE_TO_MERGE=(${kept[@]+"${kept[@]}"}); kept=()
    local -a native=()
    for p in ${MOVE_TO_NATIVE[@]+"${MOVE_TO_NATIVE[@]}"}; do
        tree="${p%%$'\t'*}" common="${p#*$'\t'}"
        if [[ ! -d "$tree" ]]; then
            gone+=("$tree")
            continue
        fi
        if ! git -C "$tree" rev-parse -q --verify HEAD >/dev/null 2>&1; then
            say "$tree has no commit to push any more; it is copied as files, in full"
            [[ " ${MOVE_TO_MIRROR[*]-} " == *" $tree "* ]] || MOVE_TO_MIRROR+=("$tree")
            [[ " ${MOVE_TO_MERGE[*]-} " == *" $common "* ]] || MOVE_TO_MERGE+=("$common")
            # A tree that went through git until now has had NO pass of the copy: every pass
            # after the first sends only what changed since the pass before it, so without this
            # the target would get the few files written since the move began and nothing else
            # (item 49, 2026-11-04). It is sent whole by the next pass.
            MOVE_TO_DELTA_FULL+=("$tree" "$common")
            continue
        fi
        native+=("$p")
    done
    MOVE_TO_NATIVE=(${native[@]+"${native[@]}"})
    (( ${#gone[@]} )) && say "gone since the job: not copied: $(printf '%s ' "${gone[@]}")"
    return 0
}

# move_to_copy TARGET STAMP: the two rsyncs, MOVE_TO_MIRROR then MOVE_TO_MERGE, every path at its
# own absolute path on the target. No marker is ever copied.
# A read-only source tree (LANE-C freezes its verification sets: 0555 directories, 0444 files,
# each checked against a sha256 manifest) arrives writable and is then set back to the source's
# modes. rsync gives a directory its final mode BEFORE it fills it, so a 0555 directory a pass
# made stops the next pass with "mkdir: Permission denied" (rsync 23; LANE-C 16:19Z and 16:30Z,
# 2026-11-03). Each pass runs twice: the copy with --chmod=Du+w, then a modes-only pass over the
# same list (--existing --size-only sends no data) that puts every mode back. The source is
# never chmod'ed.
# move_to_copy TARGET STAMP [LABEL]: as below; each rsync's time and its --stats bytes are
# logged through `say` when LABEL is given ("before the hang-up", "after the hang-up").
# What the last pass saw: the time it started and the file list of each kind, so the next pass
# copies only what changed since and deletes what went. The librarian's pass after the hang-up
# re-walked 14 mirrored and 192 merged paths (~49 GB) and had read 5.8 GB in 14 minutes with the
# session down (18:19-18:37Z, 2026-11-03).
MOVE_TO_DELTA_DIR=""
# Paths no pass of the copy has carried yet, which the next delta must send WHOLE: a git-native
# tree that lost its HEAD and became a plain copy after the first pass.
MOVE_TO_DELTA_FULL=()
# move_to_delta_record KIND PATH…: the list of every file of these paths, now, for the next pass.
move_to_delta_record() {
    local kind="$1"
    shift
    (( $# )) || { : >"$MOVE_TO_DELTA_DIR/$kind.new"; return 0; }
    # -H: a path NAMED in the copy list is followed when it is a symlink. An offloaded transcript
    # is a symlink into /mnt/durable, and a link's own mtime never changes when its target is
    # appended to, so without this the delta passes carried none of the session's new lines: 29 of
    # 99 sessions moved on 2026-11-03/04 landed with a transcript missing its last 500-2,000 lines.
    find -H "$@" \( -type f -o -type l \) -print 2>/dev/null | sort >"$MOVE_TO_DELTA_DIR/$kind.new"
}
# move_to_delta_files KIND SINCE PATH…: a --files-from list of what changed since SINCE (the
# stamp FILE the last pass left, so the comparison has the filesystem's own resolution and a file
# written in the same second as that pass is still caught) and of what the last pass saw and is
# gone now (rsync --delete-missing-args removes each of those on the target). Prints the list's
# path, or nothing when there is nothing to send.
move_to_delta_files() {
    local kind="$1" since="$2" p
    local out="$MOVE_TO_DELTA_DIR/$kind.files"
    shift 2
    : >"$out"
    if (( $# )); then
        find -H "$@" \( -newer "$since" -o -cnewer "$since" \) -print 2>/dev/null >>"$out"
        # Whole, not changed-only: a path this copy has never carried (move_to_drop_gone turned a
        # git-native tree into a plain one after the first pass).
        local full whole=()
        for full in ${MOVE_TO_DELTA_FULL[@]+"${MOVE_TO_DELTA_FULL[@]}"}; do
            for p in "$@"; do [[ "$full" == "$p" ]] && whole+=("$full") && break; done
        done
        (( ${#whole[@]} == 0 )) || find -H "${whole[@]}" \( -type f -o -type l \) -print 2>/dev/null >>"$out"
    fi
    if [[ -s "$MOVE_TO_DELTA_DIR/$kind.list" ]]; then
        comm -23 "$MOVE_TO_DELTA_DIR/$kind.list" "$MOVE_TO_DELTA_DIR/$kind.new" >>"$out"
    fi
    sort -u "$out" -o "$out"
    [[ -s "$out" ]] || return 1
    printf '%s\n' "$out"
}

# A path MANY sessions share on the target: a canonical checkout under $SRC, a tree under one of
# the roots that hold many sessions' trees (~/Code, ~/.worktrees, /mnt/<user>/{tmp,worktrees,…}),
# or one of the shared working roots named here. A mirror of such a path must never carry
# --delete: BP's mirror of /mnt/nvme/sami/worktrees deleted 72,862 files of other sessions on the
# target, a mirror of /theorem/knives-ws deleted 457,862, and older jobs deleted files in
# ~/src/machcsl-riscv, ~/Code/legion, ~/src/pivot and ~/src/ctx-memory (2026-11-03/04; the rule
# is Sami's through Main at 01:4xZ). The inference reaches such a path whenever a session's cwd
# or open file resolves into it, so the rule is applied to the copy, not to the inference alone.
move_path_shared() {
    local path="$1" root
    move_shared_roots
    for root in "$SRC" "$HOME/Code" "$HOME/.worktrees" /theorem "${MOVE_SHARED_ROOTS[@]}"; do
        [[ -n "$root" ]] || continue
        move_within "$path" "$root" && return 0
    done
    case "$path" in */verified-linux|*/verified-linux/*) return 0 ;; esac
    # A session's own directory holds OTHER sessions: a subagent that became a session of its own
    # keeps its transcript under its parent's directory (FRAC's holds METARQ, S3 and S2). A
    # --delete mirror of it removed METARQ's live 203 MB transcript on sami-devbox, where METARQ
    # runs (01:54:30Z, 2026-11-04), and the "backup" was a copy across filesystems, so everything
    # its writer appended after the copy was lost.
    move_session_dir "$path" && return 0
    return 1
}

# move_session_dir PATH: true when PATH is a session's own directory (a transcript path without
# `.jsonl`), which holds that session's subagents AND any of them that became sessions.
move_session_dir() {
    local name="${1##*/}"
    [[ "$1" == */sessions/* || "$1" == */sessions-moved/* ]] || return 1
    [[ "$name" =~ _[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]]
}

# move_to_exclude_other_sessions SID…: leave every OTHER session's transcript out of the copy.
# A session directory is carried for the move's own session - its subagents' files and the
# marker's place - and the nested `<time>_<uuid>.jsonl` files and `<time>_<uuid>/` directories in
# it belong to sessions of their own, which may be running on the target right now. Only a member
# of this move is carried; every other one is excluded by name.
move_to_exclude_other_sessions() {
    local dir entry name uuid member mine
    for dir in ${MOVE_TO_MIRROR[@]+"${MOVE_TO_MIRROR[@]}"}; do
        move_session_dir "$dir" || continue
        while IFS= read -r entry; do
            name="${entry##*/}"
            uuid="${name%.jsonl}"
            uuid="${uuid##*_}"
            [[ "$uuid" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] || continue
            mine=0
            for member in "$@"; do [[ "$member" == "$uuid" ]] && { mine=1; break; }; done
            (( mine )) && continue
            MOVE_TO_EXCLUDE+=("$entry")
            say "not copied: $entry is session $uuid's own transcript, which this move does not carry"
        done < <(find "$dir" -mindepth 1 -maxdepth 1 \( -name '*_*.jsonl' -o -name '*_*' -type d \) 2>/dev/null)
    done
    return 0
}

move_to_copy() {
    local target="$1" stamp="$2" label="${3:-}" excludes=() p stats start
    local since="" files
    # Each pass records what it saw, and every pass after the first sends only the difference.
    if [[ -z "$MOVE_TO_DELTA_DIR" ]]; then
        MOVE_TO_DELTA_DIR="$(mktemp -d)"
    elif [[ -e "$MOVE_TO_DELTA_DIR/stamp" ]]; then
        since="$MOVE_TO_DELTA_DIR/stamp"
    fi
    # The stats file lives in the delta directory, which move_exit removes, so a relauncher a
    # signal stops in the middle of a copy leaves neither in its TMPDIR.
    stats="$MOVE_TO_DELTA_DIR/stats"
    : >"$stats"
    # A second back, so a file written while the pass before it ran is in this one.
    touch -d "1 second ago" "$MOVE_TO_DELTA_DIR/stamp.new"
    move_to_delta_record mirror ${MOVE_TO_MIRROR[@]+"${MOVE_TO_MIRROR[@]}"}
    move_to_delta_record merge ${MOVE_TO_MERGE[@]+"${MOVE_TO_MERGE[@]}"}
    if (( ${#MOVE_TO_MKDIR[@]} )); then
        move_remote "$target" "mkdir -p $(printf '%q ' "${MOVE_TO_MKDIR[@]}")" </dev/null || return 1
    fi
    for p in ${MOVE_TO_EXCLUDE[@]+"${MOVE_TO_EXCLUDE[@]}"}; do
        if [[ -d "$p" ]]; then excludes+=("--exclude=$p/"); else excludes+=("--exclude=$p"); fi
    done
    # Files a running session makes and removes in the same second: the target does not want them
    # and each one is a vanished-file warning.
    excludes+=(--exclude="*.gstmp" --exclude=".#*" --exclude="*.tmp.*")
    # What a mirror replaces or deletes on the target is kept under $MOVE_TO_CUTOVER/replaced.
    # NOT a relative --backup-dir: with --relative and the destination `/`, rsync resolves a
    # relative backup dir against `/` itself, not beside each file, so the receiver tried to make
    # /.agentbox-replaced-<stamp> and every mirror failed in one second with "error in file IO
    # (code 11)" (dotfiles 5d7988d6, every job on sami-rocqperf from 03:02Z 2026-11-04). The
    # backup dir is one absolute directory again. A path on another filesystem is then copied
    # into it rather than renamed, which costs time; it no longer costs another session's data,
    # since a session directory's other transcripts are never mirrored (move_to_exclude_other_sessions)
    # and a shared tree is never mirrored with --delete (move_path_shared).
    local backup_dir="$MOVE_TO_CUTOVER/replaced/$stamp"
    # --no-group: the copy runs as the user, who cannot give a directory root's group (the
    # implied parents /home and /mnt, mirrored into the backup directory, failed a drill with it).
    if (( ${#MOVE_TO_MIRROR[@]} )); then
        start=$SECONDS
        MOVE_TO_RSYNC_LABEL="$label"
        # A shared destination is mirrored WITHOUT --delete (move_path_shared): the target's copy
        # holds other sessions' files, and this session's move may not remove them.
        local -a mirror_own=() mirror_shared=()
        for p in ${MOVE_TO_MIRROR[@]+"${MOVE_TO_MIRROR[@]}"}; do
            if move_path_shared "$p"; then mirror_shared+=("$p"); else mirror_own+=("$p"); fi
        done
        if (( ${#mirror_shared[@]} )); then
            say "mirrored WITHOUT --delete (shared on $target, other sessions' files live there): $(printf '%s ' "${mirror_shared[@]}")"
        fi
        if [[ -n "$since" ]]; then
            if files="$(move_to_delta_files mirror "$since" ${MOVE_TO_MIRROR[@]+"${MOVE_TO_MIRROR[@]}"})"; then
                move_to_rsync mirror "$stats" --info=progress2 -aH --no-group --omit-dir-times --relative \
                    --files-from="$files" --delete-missing-args --backup --backup-dir="$backup_dir" \
                    --chmod=Du+w --stats --exclude="$MOVE_MARKER" ${excludes[@]+"${excludes[@]}"} -e "${MOVE_TO_SSH[*]}" \
                    / "$MOVE_TO_USER@$target:/" || { rm -f "$stats"; return 1; }
            else
                say "rsync mirror ${label:-pass}: nothing changed since the last pass"
            fi
        else
        if (( ${#mirror_own[@]} )); then
            move_to_rsync mirror "$stats" --info=progress2 -aH --no-group --omit-dir-times --relative --delete --backup --backup-dir="$backup_dir" \
                --chmod=Du+w --stats --exclude="$MOVE_MARKER" ${excludes[@]+"${excludes[@]}"} -e "${MOVE_TO_SSH[*]}" \
                "${mirror_own[@]}" "$MOVE_TO_USER@$target:/" || { rm -f "$stats"; return 1; }
        fi
        if (( ${#mirror_shared[@]} )); then
            move_to_rsync mirror-shared "$stats" --info=progress2 -aH --no-group --omit-dir-times --relative \
                --chmod=Du+w --stats --exclude="$MOVE_MARKER" ${excludes[@]+"${excludes[@]}"} -e "${MOVE_TO_SSH[*]}" \
                "${mirror_shared[@]}" "$MOVE_TO_USER@$target:/" || { rm -f "$stats"; return 1; }
        fi
        fi
        if [[ -z "$since" ]]; then
            move_to_rsync mirror-modes "$stats" -rlptgoH --no-group --omit-dir-times --relative --existing --size-only \
                --exclude="$MOVE_MARKER" ${excludes[@]+"${excludes[@]}"} -e "${MOVE_TO_SSH[*]}" \
                "${MOVE_TO_MIRROR[@]}" "$MOVE_TO_USER@$target:/" || { rm -f "$stats"; return 1; }
        fi
        [[ -z "$label" ]] || move_to_copy_said "mirror" "$label" "$((SECONDS - start))" "$stats"
    fi
    if (( ${#MOVE_TO_MERGE[@]} )); then
        start=$SECONDS
        MOVE_TO_RSYNC_LABEL="$label"
        if [[ -n "$since" ]]; then
            if files="$(move_to_delta_files merge "$since" ${MOVE_TO_MERGE[@]+"${MOVE_TO_MERGE[@]}"})"; then
                move_to_rsync merge "$stats" --info=progress2 -aH --no-group --omit-dir-times --relative --update --stats \
                    --files-from="$files" --chmod=Du+w --exclude="$MOVE_MARKER" ${excludes[@]+"${excludes[@]}"} -e "${MOVE_TO_SSH[*]}" \
                    / "$MOVE_TO_USER@$target:/" || { rm -f "$stats"; return 1; }
            else
                say "rsync merge ${label:-pass}: nothing changed since the last pass"
            fi
        else
            move_to_rsync merge "$stats" --info=progress2 -aH --no-group --omit-dir-times --relative --update --stats \
                --chmod=Du+w --exclude="$MOVE_MARKER" ${excludes[@]+"${excludes[@]}"} -e "${MOVE_TO_SSH[*]}" \
                "${MOVE_TO_MERGE[@]}" "$MOVE_TO_USER@$target:/" || { rm -f "$stats"; return 1; }
            # --update, as the merge pass above has it: MERGE paths are shared with other
            # sessions on the target, and without it this pass is not modes-only. --size-only
            # calls two files of the same size identical, so it wrote the source's OLDER mtime
            # over a newer target file, and for a file of a DIFFERENT size it sent the source's
            # older content over the newer one - the merge pass's --update defeated by the pass
            # that follows it (job g-01a19e63 rewrote another session's evidence files on
            # sami-devbox at 02:58-03:02Z and 03:24-03:25Z, 2026-11-04).
            move_to_rsync merge-modes "$stats" -rlptgoH --no-group --omit-dir-times --relative --existing --size-only --update \
                --exclude="$MOVE_MARKER" ${excludes[@]+"${excludes[@]}"} -e "${MOVE_TO_SSH[*]}" \
                "${MOVE_TO_MERGE[@]}" "$MOVE_TO_USER@$target:/" || { rm -f "$stats"; return 1; }
        fi
        [[ -z "$label" ]] || move_to_copy_said "merge" "$label" "$((SECONDS - start))" "$stats"
    fi
    rm -f "$stats"
    # This pass is now the one the next delta measures against.
    mv "$MOVE_TO_DELTA_DIR/mirror.new" "$MOVE_TO_DELTA_DIR/mirror.list" 2>/dev/null || true
    mv "$MOVE_TO_DELTA_DIR/merge.new" "$MOVE_TO_DELTA_DIR/merge.list" 2>/dev/null || true
    mv "$MOVE_TO_DELTA_DIR/stamp.new" "$MOVE_TO_DELTA_DIR/stamp"
    return 0
}

# A git working tree whose repository the target has already (its own clone at the same path,
# made from GitHub) is moved through git, never by copying one .git over another: the commit
# the tree has checked out is pushed into the target's repository (git sends only the objects
# it lacks), the tree is registered there (`git worktree add --no-checkout`), its files are
# mirrored with its .git left out, and the index is rebuilt from HEAD, so uncommitted changes
# arrive as changes (what was staged arrives unstaged). The other local branches are pushed too,
# without force: one the target lacks is made there, and one it has only moves forward. Every
# other tree keeps the rsync of its storage.
# MOVE_TO_NATIVE holds "<tree>\t<common dir>" for each tree moved this way.
MOVE_TO_NATIVE=()
# MOVE_TO_TREES holds every mirrored git tree of the move, and MOVE_TO_HOOKED, as keys, those that must have the leak
# check's pre-push hook on the target (dispatch://BET-706 R2). A tree is decided by every URL of every remote it will
# have on the target, and by its source's too where they differ: the source's (remote_urls_guarded, here) for every
# tree, since a tree copied with rsync takes its .git with it and a fresh clone has the source's origin; and, where
# the target has the repository already (made by this move, kept from an earlier attempt of it, or there before),
# the target repository's own (move_to_target_guarded), since a tree that goes through git keeps the target's .git
# and its remotes. Those are read and their hosts resolved on the target, in its own ssh configuration.
# move_to_clone_missing decides that before the hang-up. move_to_git_native_finish, after the last copy, reads every
# tree's remotes on the target once more, as the move left them, adds any tree they guard, and puts the wrapper where
# git runs the hook of each tree that must have it, and checks it.
MOVE_TO_TREES=()
declare -gA MOVE_TO_HOOKED=()
# slug_answer_ok ANSWER: true when ANSWER, whole, is one answer `github-repo-visibility --slug` gives: exactly
# `not-github`, exactly `unknown`, or a canonical owner/name (the helper's own pattern), with no other line or text.
slug_answer_ok() {
    [[ "$1" == not-github || "$1" == unknown ]] && return 0
    [[ "$1" =~ ^[a-z0-9][a-z0-9-]{0,38}/[a-z0-9._-]{1,100}$ && "$1" != */. && "$1" != */.. ]]
}
# file_has_nul FILE: true when FILE holds a NUL byte (or cannot be read). bash drops NUL bytes from a `$(...)` capture
# without a word, so `not-github`, NUL, newline would read as `not-github`: output that must be judged whole is written
# to a file first, and one holding a NUL is no answer.
file_has_nul() {
    local all kept
    all=$(wc -c <"$1") && kept=$(tr -d '\000' <"$1" | wc -c) || return 0
    [ "$all" != "$kept" ]
}
# move_to_urls_sh: prints shell for the target defining list_urls GIT-OPTION..., which prints `R<TAB><answer>` for
# every URL of every remote of the repository those git options name (remote_urls, carried over), the answer being
# what this script's visibility helper, carried over too and run there, says with --slug: the repository's owner/name
# when the URL names GitHub, else not-github or unknown. So an ssh alias is resolved by the target's ssh -G, in the
# target's ssh configuration, and is unknown where that repository's core.sshCommand (or the target's own
# GIT_SSH_COMMAND or GIT_SSH) is set. The helper's whole output is the answer: written to a file, holding no NUL byte
# (file_has_nul, carried over), exactly one line, read with a sentinel so trailing newlines count, which
# slug_answer_ok (carried over) accepts; anything else (a NUL, more lines, more text, no output, an exit other than 0)
# is `unknown`. list_urls returns other than 0 when git cannot list the URLs.
move_to_urls_sh() {
    local helper
    helper="$(<"$DOTFILES_DIR/scripts/github-repo-visibility")" || return 1
    declare -f remote_urls slug_answer_ok file_has_nul
    printf 'helper=%q\n' "$helper"
    cat <<'EOF'
list_urls() {
    local s u url v t
    s=$(git "$@" config --get core.sshCommand 2>/dev/null) || s=
    u=$(remote_urls "$@") || return 1
    [ -n "$u" ] || return 0
    while IFS= read -r url; do
        v=unknown
        if t=$(mktemp); then
            if GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-$s}" bash -c "$helper" github-repo-visibility --slug "$url" </dev/null >"$t" 2>/dev/null \
                && ! file_has_nul "$t"; then
                v=$(cat -- "$t" && printf x) || v=
                case "$v" in *$'\n'x) v=${v%$'\n'x} ;; *) v=unknown ;; esac
            fi
            rm -f -- "$t"
        fi
        slug_answer_ok "$v" || v=unknown
        printf 'R\t%s\n' "$v"
    done <<<"$u"
}
EOF
}
# move_to_target_guarded TARGET SCRIPT: SCRIPT, shell for the target ending in a list_urls call, has a repository's
# remote URLs answered there (move_to_urls_sh); true (0) when one names GitHub and its repository is GUARD here
# (urls_guarded: public or unreadable), when one is unknown there or is no answer slug_answer_ok accepts, when the
# answers hold a NUL byte (file_has_nul: they are read from a file, never captured whole), or when they cannot be
# listed (spec R4); 1 when none is; 3 when SCRIPT exits 3 (no such checkout there). Lines without the `R` tag (a login
# shell's own output) are no answer.
move_to_target_guarded() {
    local script out rc=0 line v urls=() t
    script="$(move_to_urls_sh)" || return 0
    t="$(mktemp)" || return 0
    move_remote "$1" "$script
$2" </dev/null >"$t" 2>/dev/null || rc=$?
    if ((rc == 3)); then rm -f -- "$t"; return 3; fi
    if ((rc != 0)) || file_has_nul "$t"; then rm -f -- "$t"; return 0; fi
    out="$(<"$t")"
    rm -f -- "$t"
    while IFS= read -r line; do
        [[ "$line" == R$'\t'* ]] || continue
        v="${line#R$'\t'}"
        slug_answer_ok "$v" || return 0
        [[ "$v" == not-github ]] && continue
        [[ "$v" == unknown ]] && return 0
        urls+=("https://github.com/$v")
    done <<<"$out"
    ((${#urls[@]})) || return 1
    urls_guarded "" "${urls[@]}"
}
# MOVE_TO_HOOK_SH: shell for the target defining ensure_hook CHECKOUT, which leaves the leak check's wrapper,
# executable, where git runs CHECKOUT's pre-push hook, or prints why not and returns 5. The installer is the target's
# own copy. It keeps an existing hook as pre-push.local and refuses a directory holding both pre-push and
# pre-push.local. One pair is removed first: in a hooks path inside the work tree, an untracked pre-push.local and the
# tracked pre-push that are both the committed hook as git keeps it (prepush_saved_is_committed: a symlink as that
# same link, never followed; a file as a regular file with its bytes), which is what a later copy of the work tree
# leaves beside the hook the first install kept. The installer then keeps that hook once more, the same file or link
# as before. Any other pair, an owner's symlink or a hooks directory outside the work tree above all, is someone's,
# and ensure_hook refuses rather than touch it; so it does, through prepush_install_preflight, before the installer
# could replace a symlink to nothing.
MOVE_TO_HOOK_SH="$(declare -f prepush_saved_is_committed prepush_install_preflight)"'
i=$HOME/.local/share/public-leak-check-hooks/install-prepush-hook.sh
hooked() { h=$(git -C "$1" rev-parse --path-format=absolute --git-path hooks 2>/dev/null)/pre-push && [ -x "$h" ] && grep -q PUBLIC-LEAK-CHECK-WRAPPER "$h"; }
ensure_hook() {
    hooked "$1" && return 0
    h=$(git -C "$1" rev-parse --path-format=absolute --git-path hooks 2>/dev/null)/pre-push || { echo "pre-push hook install: git cannot name the hooks path of $1"; return 5; }
    t=$(git -C "$1" rev-parse --show-toplevel 2>/dev/null) || t=
    r=${h#"$t"/}
    if [ -n "$t" ] && [ "$r" != "$h" ] && { [ -e "$h.local" ] || [ -L "$h.local" ]; } \
        && git -C "$t" ls-files --error-unmatch -- "$r" >/dev/null 2>&1 \
        && ! git -C "$t" ls-files --error-unmatch -- "$r.local" >/dev/null 2>&1 \
        && prepush_saved_is_committed "$t" "$r" "$h" && prepush_saved_is_committed "$t" "$r" "$h.local"; then rm -f "$h.local"; fi
    prepush_install_preflight "$1" || return 5
    [ -x "$i" ] || { echo "pre-push hook install: $i is missing or not executable"; return 5; }
    "$i" "$1" >&2 && hooked "$1" || { echo "pre-push hook install failed: no executable wrapper at $h"; return 5; }
}'
# move_to_clone_missing TARGET: for each mirrored git tree whose repository the target lacks,
# clone it from its origin ON THE TARGET, before the hang-up, so move_to_git_native_plan can push
# into it and the object store stays out of the downtime (a full clone: the source checkouts are
# blob:none partial clones, so a clone from this host would lack blobs). Only into a path that is
# absent or an empty directory there - an empty root-owned one is removed as
# move_to_dests_writable does. A clone that fails says why and leaves that tree to rsync. Each
# clone's time and the repository's size on the target are logged. It also decides, for every mirrored git tree,
# whether the tree must have the leak check's pre-push hook on the target (MOVE_TO_TREES and MOVE_TO_HOOKED, above). A
# clone that must have it and cannot get it (the target's installer missing or failing, or no executable wrapper where
# git runs the hook after it) is removed, and the move is refused (1, with MOVE_TO_WHY): neither that clone nor an rsync
# copy of the tree would carry the hook. So is a move with any tree that must have it, to a target without the
# installer.
# $2 is a function that logs one line.
move_to_clone_missing() {
    local target="$1" log="${2:-echo}" w common dir url out rc hook
    MOVE_TO_TREES=() MOVE_TO_HOOKED=()
    for w in ${MOVE_TO_MIRROR[@]+"${MOVE_TO_MIRROR[@]}"}; do
        [[ -d "$w" && -e "$w/.git" ]] || continue
        common="$(git -C "$w" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || continue
        MOVE_TO_TREES+=("$w")
        # By the source's remotes, every URL of each: a copied tree takes them with its .git, and a clone made on the
        # target has the source's origin (dispatch://BET-706 R2), whether or not the source checkout has the hook;
        # without it a push from a moved session skips the check (DevboxProvision.PrepushParity, dispatch://INFRA-993,
        # BET-589).
        if remote_urls_guarded "$w"; then MOVE_TO_HOOKED[$w]=1; fi
        url="$(git -C "$w" remote get-url origin 2>/dev/null)" || url=""
        if move_remote "$target" "test -d $(printf '%q' "$common/objects")" </dev/null >/dev/null 2>&1; then
            # The target has this repository: the tree goes through git into it, whoever cloned it (this move, an
            # earlier attempt of it that failed after its clone, or someone before), and keeps the target's .git, so it
            # is decided by the target repository's remotes too.
            if [[ -z "${MOVE_TO_HOOKED[$w]:-}" ]] && move_to_target_guarded "$target" "list_urls --git-dir=$(printf '%q' "$common")"; then
                MOVE_TO_HOOKED[$w]=1
            fi
            continue
        fi
        dir="${common%/.git}"
        [[ "$common" == */.git ]] || continue
        if [[ -z "$url" ]]; then
            "$log" "$dir has no origin on $target and no origin remote here, so $w is copied with rsync"
            continue
        fi
        if [[ "$url" != https://github.com/* && "$url" != git@github.com:* ]]; then
            "$log" "the origin of $w is $url, which the target may not be able to clone, so it is copied with rsync"
            continue
        fi
        # A clone made on the target that must have the hook gets it at once. The installer is the target's own copy in
        # ~/.local/share/public-leak-check-hooks, which provisioning installs on each machine, with no fallback
        # (dispatch://BET-706 R5); it is checked before the clone, so a target without it gets no clone at all.
        hook="${MOVE_TO_HOOKED[$w]:-0}"
        if out="$(move_remote "$target" "set -e
$MOVE_TO_HOOK_SH
d=$(printf '%q' "$dir") u=$(printf '%q' "$url") hook=$hook
if [ \"\$hook\" = 1 ] && [ ! -x \"\$i\" ]; then
    echo \"\$i is missing or not executable; ~/.local/share/public-leak-check-hooks is per machine, installed by provisioning on each machine (on sami-devbox, step prepush of devbox/sami-devbox-provision)\"; exit 5
fi
if [ -e \"\$d\" ]; then
    if [ -d \"\$d\" ] && [ -z \"\$(ls -A \"\$d\" 2>/dev/null)\" ]; then
        [ -w \"\$d\" ] || sudo -n rmdir \"\$d\" 2>/dev/null || { echo 'the path exists and is an empty directory this user cannot remove'; exit 3; }
        [ -e \"\$d\" ] && rmdir \"\$d\"
    else
        echo 'the path exists on the target already'; exit 3
    fi
fi
s=\$(date +%s)
git clone --quiet \"\$u\" \"\$d\" 2>&1 || { echo 'git clone failed'; exit 4; }
if [ \"\$hook\" = 1 ]; then
    ensure_hook \"\$d\" || { rm -rf \"\$d\"; echo 'the clone is removed'; exit 5; }
fi
echo \"CLONED \$((\$(date +%s) - s))s \$(du -sh \"\$d/.git\" 2>/dev/null | cut -f1)\"" </dev/null 2>&1)"; then
            "$log" "cloned $url into $dir on $target (${out#CLONED }), so $w goes through git"
        else
            rc=$?
            if ((rc == 5)); then
                MOVE_TO_WHY="the leak check's pre-push hook could not be put in a clone of $url at $dir on $target ($(tr '\n' ' ' <<<"$out")); neither that clone nor a copy of $w would carry it"
                "$log" "no clone of $url into $dir on $target ($(tr '\n' ' ' <<<"$out")); refusing the move: $w would reach $target without the leak check's pre-push hook"
                return 1
            fi
            "$log" "no clone of $url into $dir on $target ($(tr '\n' ' ' <<<"$out")); $w is copied with rsync"
        fi
    done
    # Every tree that must have the hook gets it after the last copy (move_to_git_native_finish), from the target's
    # installer: a target without one refuses the move now, before the hang-up, not in the rollback after it.
    if ((${#MOVE_TO_HOOKED[@]})) && ! out="$(move_remote "$target" "$MOVE_TO_HOOK_SH
[ -x \"\$i\" ] || { echo \"\$i is missing or not executable\"; exit 5; }" </dev/null 2>&1)"; then
        MOVE_TO_WHY="the leak check's pre-push hook cannot be put in $(printf '%s ' "${!MOVE_TO_HOOKED[@]}")on $target ($(tr '\n' ' ' <<<"$out"))"
        "$log" "refusing the move: $MOVE_TO_WHY"
        return 1
    fi
    return 0
}

# MOVE_TO_UNBORN holds the common dirs of mirrored trees with NO commit: their files go by the
# plain mirror (nothing to push), but their storage still leaves the merge, since the target's
# clone of that repository must never be overwritten by one .git over another. LINUX-1248's
# ~/src/machcsl-riscv was such a tree on 2026-11-03 - an unborn branch, everything staged - and
# the push failed AFTER the hang-up, which rolled the move back.
MOVE_TO_UNBORN=()
# How long another move's push of the same repository to the same target stands for (minutes).
MOVE_TO_PUSH_AGAIN_MIN="${AGENTBOX_MOVE_PUSH_AGAIN_MIN:-60}"
move_to_git_native_plan() {
    local target="$1" w common keep p n
    local -a merge=()
    MOVE_TO_NATIVE=() MOVE_TO_UNBORN=()
    for w in ${MOVE_TO_MIRROR[@]+"${MOVE_TO_MIRROR[@]}"}; do
        [[ -d "$w" && -e "$w/.git" ]] || continue
        common="$(git -C "$w" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || continue
        move_remote "$target" "test -d $(printf '%q' "$common/objects")" </dev/null >/dev/null 2>&1 || continue
        if ! git -C "$w" rev-parse -q --verify HEAD >/dev/null 2>&1; then
            MOVE_TO_UNBORN+=("$common")
            continue
        fi
        MOVE_TO_NATIVE+=("$w	$common")
    done
    # Git storage the target has already - a merged common dir whose objects are there, at the
    # same path - is not copied either, whether or not a tree of it is mirrored: INFRA-1018's move
    # (2026-11-03 05:32Z) --leave'd ~/src/machcsl-riscv, so no tree of it went through git, and
    # 8.96 GB of /mnt/nvme/sami/git-objects/machcsl-riscv went to a target that had the clone.
    # An object store merged on its own (a tree's objects linked elsewhere, as
    # /mnt/nvme/<user>/git-objects/machcsl-riscv for ~/src/machcsl-riscv) counts as the checkout
    # whose .git/objects resolves to it: PROCS's job (06:53Z) carried that store alone.
    local -a held=()
    local -A store_of=()
    local c real
    for c in "$SRC"/*/.git; do
        [[ -d "$c/objects" ]] || continue
        real="$(readlink -f "$c/objects" 2>/dev/null)" || continue
        [[ "$real" == "$c/objects" ]] || store_of[$real]="$c"
    done
    for p in ${MOVE_TO_MERGE[@]+"${MOVE_TO_MERGE[@]}"}; do
        if [[ -e "$p/HEAD" && -e "$p/objects" ]]; then
            c="$p"
        elif [[ -n "${store_of[$(readlink -f "$p" 2>/dev/null || echo "$p")]:-}" ]]; then
            c="${store_of[$(readlink -f "$p" 2>/dev/null || echo "$p")]}"
        else
            continue
        fi
        move_remote "$target" "test -d $(printf '%q' "$c/objects")" </dev/null >/dev/null 2>&1 || continue
        held+=("$p")
    done
    (( ${#MOVE_TO_NATIVE[@]} + ${#MOVE_TO_UNBORN[@]} + ${#held[@]} )) || return 0
    # The target's repository is not overwritten: its storage leaves the merge, and each tree's
    # .git (a directory or a worktree's pointer file) leaves the mirror.
    for p in ${MOVE_TO_MERGE[@]+"${MOVE_TO_MERGE[@]}"}; do
        keep=1
        for n in ${MOVE_TO_NATIVE[@]+"${MOVE_TO_NATIVE[@]}"} ${MOVE_TO_UNBORN[@]+"${MOVE_TO_UNBORN[@]}"} ${held[@]+"${held[@]}"}; do
            common="${n#*$'\t'}"
            if move_within "$p" "$common" || move_within "$p" "$(readlink -f "$common/objects")"; then keep=0; break; fi
        done
        (( keep )) && merge+=("$p")
    done
    MOVE_TO_MERGE=(${merge[@]+"${merge[@]}"})
    for n in ${MOVE_TO_NATIVE[@]+"${MOVE_TO_NATIVE[@]}"}; do MOVE_TO_EXCLUDE+=("${n%%$'\t'*}/.git"); done
    # An unborn tree keeps its own .git out of the mirror too: the target's clone is the
    # repository there, and one .git over another is exactly what the merge rule forbids.
    local u w native_paths=" "
    for n in ${MOVE_TO_NATIVE[@]+"${MOVE_TO_NATIVE[@]}"}; do native_paths+="${n%%$'\t'*} "; done
    for u in ${MOVE_TO_UNBORN[@]+"${MOVE_TO_UNBORN[@]}"}; do
        for w in ${MOVE_TO_MIRROR[@]+"${MOVE_TO_MIRROR[@]}"}; do
            [[ "$native_paths" != *" $w "* && -e "$w/.git" ]] || continue
            [[ "$(git -C "$w" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" == "$u" ]] \
                && MOVE_TO_EXCLUDE+=("$w/.git")
        done
    done
    return 0
}

# BEFORE the hang-up: the local branches of each native tree's REPOSITORY, once per repository
# (S3's 50 worktrees of a few repositories each pushed every branch of the same repository,
# 1-535 s each, 40 minutes in all, 2026-11-03), and only the branches the target lacks or that
# moved, without force (a branch the target has only moves forward). From a blob:none partial
# clone a push packs every branch's objects, which took 3+ minutes for LINUX-1248's machcsl-riscv
# after its hang-up. A failure here is logged and costs nothing: those branches stay unpushed.
# $2 is a function that logs one line.
move_to_git_native_prepush() {
    local target="$1" log="${2:-echo}" n common start there ref sha
    local -A done_=() theirs=()
    local -a refs=()
    for n in ${MOVE_TO_NATIVE[@]+"${MOVE_TO_NATIVE[@]}"}; do
        common="${n#*$'\t'}"
        [[ -z "${done_[$common]:-}" ]] || continue
        done_[$common]=1
        start=$SECONDS
        # A repository another move pushed to this target in the last hour is left alone: the
        # branches of a shared checkout are the same for every session of it, and HARNESS and
        # SQLPAGE each spent 55+ min pushing the branches of oss-verify-proofs-internal-src
        # (17:05-18:05Z, 2026-11-03).
        local stamp="$MOVE_TO_JOBS/pushed/$target$(tr / _ <<<"$common")"
        if [[ -n "$(find "$stamp" -newermt "-$MOVE_TO_PUSH_AGAIN_MIN minutes" 2>/dev/null)" ]]; then
            "$log" "the branches of $common went to $target less than $MOVE_TO_PUSH_AGAIN_MIN min ago (another move); not pushed again"
            continue
        fi
        theirs=()
        there="$(GIT_SSH_COMMAND="${MOVE_TO_SSH[*]}" git --git-dir="$common" ls-remote --heads "$MOVE_TO_USER@$target:$common" 2>/dev/null)" || there=""
        while read -r sha ref; do [[ -n "$ref" ]] && theirs[$ref]="$sha"; done <<<"$there"
        refs=()
        local -a fetchable=()
        # Only the branches this move's own worktrees have checked out: a shared checkout holds
        # hundreds that belong to other sessions and other machines, and pushing all of them was
        # the slowest step of the move (item 23, 2026-11-03).
        local -A want=()
        local w2 b
        for w2 in ${MOVE_TO_NATIVE[@]+"${MOVE_TO_NATIVE[@]}"}; do
            [[ "${w2#*$'\t'}" == "$common" ]] || continue
            b="$(git -C "${w2%%$'\t'*}" symbolic-ref -q --short HEAD 2>/dev/null)" || continue
            [[ -n "$b" ]] && want[refs/heads/$b]=1
        done
        while read -r sha ref; do
            [[ -n "${want[$ref]:-}" ]] || continue
            [[ "${theirs[$ref]:-}" == "$sha" ]] && continue
            # A branch head GitHub has already: the target fetches it from origin, which a push
            # into a big partial clone could not do (item 26, 2026-11-03).
            if move_commit_on_origin "$common" "$sha"; then fetchable+=("$sha:$ref"); else refs+=("$ref:$ref"); fi
        done < <(git --git-dir="$common" for-each-ref --format='%(objectname) %(refname)' refs/heads 2>/dev/null)
        if (( ${#fetchable[@]} )); then
            if move_remote "$target" "git --git-dir=$(printf '%q' "$common") fetch --quiet --no-write-fetch-head origin $(printf '%q ' "${fetchable[@]}")" </dev/null; then
                "$log" "${#fetchable[@]} branch(es) of $common are on GitHub; $target fetched them from origin ($((SECONDS - start))s)"
            else
                "$log" "${#fetchable[@]} branch(es) of $common could not be fetched from origin on $target; they are pushed instead"
                local r2
                for r2 in "${fetchable[@]}"; do refs+=("${r2#*:}:${r2#*:}"); done
            fi
        fi
        if (( ${#refs[@]} == 0 )); then
            "$log" "the branches of $common are on $target already ($((SECONDS - start))s)"
        elif GIT_SSH_COMMAND="${MOVE_TO_SSH[*]}" move_to_fg git --git-dir="$common" push --quiet --no-verify \
            "$MOVE_TO_USER@$target:$common" "${refs[@]}" >/dev/null 2>&1; then
            "$log" "pushed ${#refs[@]} branch(es) of $common before the hang-up ($((SECONDS - start))s)"
            mkdir -p "${stamp%/*}" && : >"$stamp"
        else
            "$log" "${#refs[@]} branch(es) of $common were not all pushed ($((SECONDS - start))s; one the target has may not move forward); the move goes on"
        fi
    done
    return 0
}

# After the hang-up, before the mirror: push each tree's HEAD and register the tree on the
# target. Only HEAD, a small delta once the branches went before the hang-up. Sets MOVE_TO_WHY
# on failure.
# move_commit_on_origin TREE SHA: true when that commit is on the repository's GitHub origin, so
# the target can fetch it instead of taking a push (only local refs are read, no network).
move_commit_on_origin() {
    local tree="$1" sha="$2"
    [[ -n "$sha" ]] || return 1
    [[ -n "$(git -C "$tree" branch -r --contains "$sha" --list 'origin/*' 2>/dev/null | head -1)" ]]
}

move_to_git_native_push() {
    local target="$1" n w common tag head branch script
    for n in ${MOVE_TO_NATIVE[@]+"${MOVE_TO_NATIVE[@]}"}; do
        w="${n%%$'\t'*}" common="${n#*$'\t'}"
        tag="refs/agentbox-move/$(printf '%s' "$w" | md5sum | cut -c1-12)"
        head="$(git -C "$w" rev-parse -q --verify HEAD)" || { MOVE_TO_WHY="$w has no commit to push"; return 1; }
        branch="$(git -C "$w" symbolic-ref -q --short HEAD || true)"
        # A commit GitHub has already is FETCHED by the target, never pushed into its clone: a
        # push into sami-devbox's blob:none partial clone of oss-verify-proofs-internal-src (~11k
        # packs) failed for three moves on 2026-11-03 with non-fast-forward, exhausted file
        # descriptors and promisor fetches, while a fetch of the same commit from GitHub works.
        if move_commit_on_origin "$w" "$head" \
            && move_remote "$target" "git --git-dir=$(printf '%q' "$common") fetch --quiet --no-write-fetch-head origin $(printf '%q' "$head"):$(printf '%q' "$tag")" </dev/null; then
            :
        elif ! GIT_SSH_COMMAND="${MOVE_TO_SSH[*]}" move_to_fg git -C "$w" push --quiet --no-verify \
            "$MOVE_TO_USER@$target:$common" "+HEAD:$tag" 2>&1; then
            MOVE_TO_WHY="git push of $w to $target:$common failed"
            return 1
        fi
        script="set -e
w=$(printf '%q' "$w") c=$(printf '%q' "$common") tag=$(printf '%q' "$tag") head=$(printf '%q' "$head") b=$(printf '%q' "$branch")
if [ -e \"\$w/.git\" ] && git -C \"\$w\" rev-parse -q --git-dir >/dev/null 2>&1; then :
elif [ -e \"\$w\" ] && [ -n \"\$(ls -A \"\$w\")\" ]; then echo \"\$w is on the target already and is not a git tree\" >&2; exit 3
elif [ -n \"\$b\" ]; then
    git --git-dir=\"\$c\" update-ref \"refs/heads/\$b\" \"\$head\"
    git --git-dir=\"\$c\" worktree add --no-checkout --quiet \"\$w\" \"\$b\"
else
    git --git-dir=\"\$c\" worktree add --no-checkout --quiet --detach \"\$w\" \"\$head\"
fi
if [ -n \"\$b\" ]; then git --git-dir=\"\$c\" update-ref \"refs/heads/\$b\" \"\$head\"; git -C \"\$w\" symbolic-ref HEAD \"refs/heads/\$b\"
else git -C \"\$w\" update-ref --no-deref HEAD \"\$head\"; fi
git --git-dir=\"\$c\" update-ref -d \"\$tag\""
        if ! move_remote "$target" "$script" </dev/null; then
            MOVE_TO_WHY="the git tree $w could not be registered in $target:$common"
            return 1
        fi
    done
    return 0
}

# After the mirror: each tree's index from its HEAD, its files as the mirror left them. Then every git tree of the move
# (MOVE_TO_TREES) whose remotes, read on the target as the move left them, have a GUARD URL (or cannot be listed)
# joins those decided before the hang-up (MOVE_TO_HOOKED), and each tree that must have the leak check's pre-push hook
# gets the wrapper where git runs it: the mirror writes the work tree, and a hooks path inside it (a relative
# core.hooksPath such as `.hooks`) may hold a tracked hook the mirror wrote back over the wrapper; a copied .git
# carries the source's hooks. A tree git cannot read as a checkout of its own on the target (a tree whose .git the
# mirror left out, an unborn one) is passed over: no push goes from it. A tree that cannot be hooked fails the move
# (1, MOVE_TO_WHY), which rolls the group back before any session resumes on the target (dispatch://BET-706 R2).
move_to_git_native_finish() {
    local target="$1" n w q out own
    for n in ${MOVE_TO_NATIVE[@]+"${MOVE_TO_NATIVE[@]}"}; do
        w="${n%%$'\t'*}"
        move_remote "$target" "git -C $(printf '%q' "$w") reset -q" </dev/null \
            || { MOVE_TO_WHY="git reset of $w on $target failed"; return 1; }
    done
    for w in ${MOVE_TO_TREES[@]+"${MOVE_TO_TREES[@]}"}; do
        q="$(printf '%q' "$w")"
        # Shell for the target: exits 3 unless the tree is a checkout of its own there.
        own="t=\$(git -C $q rev-parse --show-toplevel 2>/dev/null) || exit 3
[ \"\$(cd -P -- \"\$t\" && pwd)\" = \"\$(cd -P -- $q && pwd)\" ] || exit 3"
        if [[ -z "${MOVE_TO_HOOKED[$w]:-}" ]]; then
            move_to_target_guarded "$target" "$own
list_urls -C $q" || continue
        fi
        out="$(move_remote "$target" "$MOVE_TO_HOOK_SH
$own
ensure_hook $q" </dev/null 2>&1)" && continue
        (($? == 3)) && continue
        MOVE_TO_WHY="the leak check's pre-push hook is not where git runs it in $w on $target after the copy ($(tr '\n' ' ' <<<"$out"))"
        return 1
    done
    return 0
}

# move_to_mark SID TRANSCRIPT TARGET / move_to_unmark SID TRANSCRIPT: the marker in the session's
# own directory and its copy in the id index (agent-session's lookup by id), on this machine.
# move_to_reroot TARGET TRANSCRIPT CWD: on the target, move the copied transcript to CWD's
# session bucket with omp's own tool (`omp session pack`, then `omp session unpack --cwd`), which
# rewrites the header's cwd and replaces the copy in the old bucket, so one id has one file. What
# the session's own directory holds beyond pack's artifacts (its subagents' transcripts) is put
# back beside the new file: pack carries the session file and its artifacts only. Prints the new
# transcript path.
move_to_reroot() {
    local target="$1" t="$2" cwd="$3"
    move_remote "$target" "set -e
t=$(printf '%q' "$t") c=$(printf '%q' "$cwd")
s=\$(mktemp -d)
mkdir -p \"\$s/keep\"
if [ -d \"\${t%.jsonl}\" ]; then cp -a \"\${t%.jsonl}/.\" \"\$s/keep/\"; fi
omp session pack \"\$t\" \"\$s/session.tar\" >/dev/null
new=\$(omp session unpack \"\$s/session.tar\" --cwd \"\$c\" | tail -n 1)
case \"\$new\" in /*.jsonl) ;; *) echo \"omp session unpack printed no transcript path: \$new\" >&2; exit 3 ;; esac
mkdir -p \"\${new%.jsonl}\"
cp -an \"\$s/keep/.\" \"\${new%.jsonl}/\"
if [ \"\$new\" != \"\$t\" ]; then rm -f \"\$t\"; rm -rf \"\${t%.jsonl}\"; fi
rm -rf \"\$s\"
printf '%s\\n' \"\$new\"" </dev/null
}

# move_to_cancel_start TARGET SID…: cancel and reap what a rollback leaves behind on the target -
# the `agentbox new` launcher of each session, whose window was just killed, and the box it may
# have made. A launcher that is only waiting for its window's shell to die goes with the window;
# one stuck in a mount or a pull does not, and four such launchers sat on sami-devbox until a
# person ended them (2026-11-03). Returns 1 with MOVE_TO_WHY when one will not go, so the
# rollback does not resume the session here while the target may still start it.
move_to_cancel_start() {
    local target="$1" out
    shift
    # shellcheck disable=SC2016  # expanded on the target
    out="$(printf '%s\0' "$@" | move_remote "$target" '
        left=""
        while IFS= read -r -d "" sid; do
            f="'"$MOVE_TO_CUTOVER"'/starting/$sid"
            pid=""; box=""
            [ -r "$f" ] && { pid=$(sed -n "s/^pid=//p" "$f"); box=$(sed -n "s/^box=//p" "$f"); }
            [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && { kill -TERM -"$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null; }
            # The box the launcher made, if it got that far: an agentbox container whose command
            # names this session (its `omp --resume <path>`), and the name the launcher recorded.
            for c in $(docker ps -a --filter "name=^agentbox-" --format "{{.Names}}" 2>/dev/null); do
                docker inspect -f "{{json .Config.Cmd}}" "$c" 2>/dev/null | grep -q "$sid" && docker rm -f "$c" >/dev/null 2>&1
            done
            [ -n "$box" ] && docker rm -f "$box" >/dev/null 2>&1
            n=0
            while [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && [ "$n" -lt 30 ]; do sleep 1; n=$((n + 1)); done
            if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
                kill -KILL -"$pid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null
                sleep 2
                # A process that has exited but whose parent has not reaped it is a zombie, which
                # kill -0 still finds; it runs nothing and starts no box.
                st=$(awk "{print \$3}" "/proc/$pid/stat" 2>/dev/null)
                if [ -n "$st" ] && [ "$st" != Z ]; then echo "STUCK $sid launcher pid $pid"; left=1; fi
            fi
            rm -f "$f"
        done
        exit 0')" || { MOVE_TO_WHY="the pending box starts on $target could not be cancelled (the target did not answer)"; return 1; }
    local stuck
    stuck="$(grep '^STUCK ' <<<"$out" || true)"
    [[ -z "$stuck" ]] || { MOVE_TO_WHY="a pending box start on $target will not die: $(tr '\n' '; ' <<<"$stuck")"; return 1; }
    return 0
}

move_to_mark() {
    local sid="$1" t="$2" target="$3" there="${4:-$2}" body
    body="from=${AGENTBOX_HOST:-$(hostname -s)}
to=$target
time=$(date -u +%FT%TZ)
session=$sid
transcript=$there
"
    mkdir -p "${t%.jsonl}" "$MOVE_MARKER_INDEX" || return 1
    printf '%s' "$body" >"${t%.jsonl}/$MOVE_MARKER" && printf '%s' "$body" >"$MOVE_MARKER_INDEX/$sid"
}
move_to_unmark() {
    local sid="$1" t="$2"
    rm -f "${t%.jsonl}/$MOVE_MARKER" "$MOVE_MARKER_INDEX/$sid"
    # The directory the marker made, when the session had none, goes with it.
    rmdir "${t%.jsonl}" 2>/dev/null || true
}

# At most this many sessions are started on the target at once while its one-minute load is at or
# above MOVE_TO_TARGET_LOAD: 21 moves in flight took sami-devbox to load 290-395 on 288 cores and
# the box starts began to fail (2026-11-04). The launchers name themselves in
# $MOVE_TO_CUTOVER/starting/<sid> on the target while they run, which is the count.
MOVE_TO_START_MAX="${AGENTBOX_MOVE_START_MAX:-3}"
MOVE_TO_TARGET_LOAD="${AGENTBOX_MOVE_TARGET_LOAD:-250}"
MOVE_TO_START_WAIT_MAX="${AGENTBOX_MOVE_START_WAIT_MAX:-900}"
# How long a failed box start on the target waits before its one retry.
MOVE_TO_RETRY_WAIT="${AGENTBOX_MOVE_RETRY_WAIT:-60}"
# move_to_start_slot TARGET: wait until the target can take another box start.
move_to_start_slot() {
    local target="$1" out load starting waited=0 said=""
    (( MOVE_TO_START_MAX > 0 )) || return 0
    while (( waited < MOVE_TO_START_WAIT_MAX )); do
        out="$(move_remote "$target" "cut -d' ' -f1 /proc/loadavg; ls -1 $(printf '%q' "$MOVE_TO_CUTOVER/starting") 2>/dev/null | wc -l" </dev/null 2>/dev/null)" || return 0
        load="$(head -1 <<<"$out")" starting="$(tail -1 <<<"$out")"
        [[ "$load" =~ ^[0-9]+ ]] || return 0
        (( ${load%%.*} >= MOVE_TO_TARGET_LOAD )) || return 0
        (( ${starting:-0} >= MOVE_TO_START_MAX )) || return 0
        if [[ "$said" != "$starting" ]]; then
            say "waiting to start on $target: its load is $load and $starting box start(s) run there (at most $MOVE_TO_START_MAX while the load is $MOVE_TO_TARGET_LOAD or more)"
            said="$starting"
        fi
        MOVE_TO_STATE="waiting for a box-start slot on $target (load $load, $starting starting)"
        sleep 10
        waited=$((waited + 10))
    done
    say "waited ${waited}s for a box-start slot on $target; starting anyway"
    return 0
}

# move_to_start TARGET SID CWD RESUME SPEC… [-- FLAG…]: one window in tmux session `moved` on the
# target, resuming the session in a box as a same-host move resumes it (the waker beside the
# launcher, the omp's own launch flags, and --drop-gone-dirs: a --dir after the first that the
# target does not have is left out, as on a resume here, while a missing first one - the working
# directory - still refuses the launch); prints the window's id.
move_to_start() {
    local target="$1" sid="$2" cwd="$3" resume="$4" log run script
    shift 4
    move_split_flags "$@"
    local -a flags=(${MOVE_SPLIT_FLAGS[@]+"${MOVE_SPLIT_FLAGS[@]}"})
    # The window the session had here (session:window name). The box gets it as
    # AGENTBOX_MOVED_FROM_WINDOW and the target's window keeps it in the @stream option, so a
    # stream's sessions can be counted on the target (pilot.py).
    local from_window="${MOVE_TO_FROM_WINDOW:-}"
    # The same filter the rollback uses: a --dir `agentbox new` refuses (/tmp and the other roots
    # no box may be given) makes the launcher on the TARGET refuse the whole start, and every one
    # of R3A's starts ended as "not resumed within 300 s" with nothing in its window (2026-11-04).
    # A path that is merely absent on the target is NOT dropped here - the target's launcher runs
    # --drop-gone-dirs and decides that itself, against its own disk.
    local -a usable=()
    mapfile -t usable < <(MOVE_SPEC_KEEP_GONE=1 move_spec_usable ${MOVE_SPLIT_SPEC[@]+"${MOVE_SPLIT_SPEC[@]}"})
    set -- ${usable[@]+"${usable[@]}"}
    [[ -z "$from_window" ]] || set -- -e "AGENTBOX_MOVED_FROM_WINDOW=$from_window" "$@"
    log="${XDG_CACHE_HOME:-$HOME/.cache}/omp/agentbox/move-$sid.log"
    run="$(printf '( setsid %q move --wake %q </dev/null >>%q 2>&1 & ); %s' "$MOVE_TO_AGENTBOX" "$sid" "$log" \
        "$(printf '%q ' "$MOVE_TO_AGENTBOX" new --drop-gone-dirs "$@" -- omp ${flags[@]+"${flags[@]}"} --resume "$resume")")"
    # The launcher names itself in $MOVE_TO_CUTOVER/starting/<sid> on the target - its pid, the
    # window and the box it will make - so a rollback can cancel and reap it (PUB and PEER,
    # 2026-11-03: four `agentbox new` launchers on sami-devbox waited behind a stuck umount after
    # their windows were killed, and a person ended them). It removes the file when it ends.
    local started="$MOVE_TO_CUTOVER/starting/$sid"
    run="$(printf 'mkdir -p %q; printf "pid=%%s\\nbox=%%s\\nwindow=%%s\\n" "$$" "${AGENTBOX_BOX:-}" "${TMUX_PANE:-}" >%q; trap "rm -f %q" EXIT; %s' \
        "${started%/*}" "$started" "$started" "$run")"
    run="$run; echo; echo 'agentbox: the box has exited; this window is a shell again'; exec bash -i"
    # The run line goes to the target as a FILE, and tmux is given that file: a box spec with
    # hundreds of --dir paths made the inline command too long for tmux, so no window opened on
    # the target and 40 respawns answered "command too long" (the omp lead, 23:49-23:59Z,
    # 2026-11-03). The file is written through stdin, so no command line carries it either.
    move_to_start_slot "$target"
    local runfile="$MOVE_TO_CUTOVER/start/$sid.sh"
    printf '%s\n' "$run" | move_remote "$target" "mkdir -p $(printf '%q' "${runfile%/*}") && cat >$(printf '%q' "$runfile") && chmod +x $(printf '%q' "$runfile")" \
        || { echo "agentbox: could not write the launcher script $runfile on $target" >&2; return 1; }
    script="s=$(printf '%q' "$MOVE_TO_TMUX_SESSION") n=$(printf '%q' "${sid:0:8}") c=$(printf '%q' "$cwd") r=$(printf '%q' "$runfile") w=$(printf '%q' "$from_window")
mkdir -p \"\$(dirname $(printf '%q' "$log"))\"
if tmux has-session -t \"=\$s\" 2>/dev/null; then
    id=\"\$(tmux new-window -d -P -F '#{window_id}' -t \"=\$s:\" -n \"\$n\" -c \"\$c\" bash -i \"\$r\")\"
else
    id=\"\$(tmux new-session -d -P -F '#{window_id}' -s \"\$s\" -n \"\$n\" -c \"\$c\" bash -i \"\$r\")\"
fi
[ -z \"\$w\" ] || tmux set-option -w -t \"\$id\" @stream \"\${w#*:}\" >/dev/null 2>&1 || true
printf '%s\\n' \"\$id\""
    move_remote "$target" "$script" </dev/null
}

# move_to_settled TARGET RESUME…: wait until, for every RESUME, one omp on the target started with
# `--resume RESUME` has stayed up MOVE_TO_SETTLE seconds - an omp that cannot load the session
# exits at once - or until MOVE_TO_START_WAIT runs out. MOVE_TO_OK holds each one that did.
declare -A MOVE_TO_OK=()
move_to_settled() {
    local target="$1" deadline out r found pid st cmd _fds pending
    shift
    local -A first=() key=()
    MOVE_TO_OK=()
    deadline=$((SECONDS + MOVE_TO_START_WAIT))
    while :; do
        out="$(move_remote "$target" "$MOVE_TO_OMP_PS" </dev/null 2>/dev/null)" || out=""
        pending=0
        for r in "$@"; do
            [[ -z "${MOVE_TO_OK[$r]:-}" ]] || continue
            found=""
            while IFS=$'\x1f' read -r pid st cmd _fds; do
                [[ -n "$pid" ]] || continue
                if [[ " $cmd " == *" --resume $r "* ]]; then found="$pid:$st"; break; fi
            done <<<"$out"
            if [[ -z "$found" ]]; then key[$r]=""; pending=1; continue; fi
            if [[ "${key[$r]:-}" != "$found" ]]; then key[$r]="$found"; first[$r]=$SECONDS; fi
            if (( SECONDS - first[$r] >= MOVE_TO_SETTLE )); then MOVE_TO_OK[$r]=1; else pending=1; fi
        done
        (( pending )) || return 0
        (( SECONDS < deadline )) || return 1
        sleep "$MOVE_TO_POLL"
    done
}

# Each session's --dir paths (MT_DIRS), group paths (MT_SHARE: its git working trees), copy
# lines (MT_COPY) and census row (MT_ROW), newline-joined, by session id; MOVE_TO_GROUP is the
# group move_to_find_group found.
declare -A MT_SHARE=() MT_ROW=() MT_COPY=() MT_DIRS=()
MOVE_TO_GROUP=()

# The host's sessions and their processes, read once: MT_ROW_OF (session id -> census row, for
# every host or no-pane session with an id) and MT_TOUCHES ("<session id>\t<link>\t<target>" for
# the working directory and every open file of each process of a session, from one `find` over
# /proc).
declare -A MT_ROW_OF=() MT_DONE=() MT_PTREES=()
MT_TOUCHES=""
move_to_scan_processes() {
    local rows=() line class pid sid pane at cwd detail p map
    mapfile -t rows < <(move_census)
    move_read_kids
    map="$(mktemp)"
    for line in "${rows[@]}"; do
        IFS="$SEP" read -r class pid sid pane at cwd detail <<<"$line"
        [[ ( "$class" == host || "$class" == no-pane ) && -n "$sid" ]] || continue
        MT_ROW_OF[$sid]="$line"
        while IFS= read -r p; do printf '%s\t%s\n' "$p" "$sid"; done < <(move_descendants "$pid") >>"$map"
    done
    MT_TOUCHES="$(find "$PROC"/[0-9]*/cwd "$PROC"/[0-9]*/fd -maxdepth 1 -type l -printf '%p\t%l\n' 2>/dev/null \
        | awk -F'\t' -v proc="$PROC/" 'NR == FNR { sid[$1] = $2; next }
            { p = substr($1, length(proc) + 1); sub(/\/.*/, "", p); if (p in sid) print sid[p] "\t" $0 }' "$map" - || true)"
    rm -f "$map"
}

# move_to_writes LINK: true when LINK, a /proc/<pid>/fd/<n> or /proc/<pid>/cwd, is a working
# directory or a file open for writing (O_WRONLY or O_RDWR), as move_proc_dirs counts it.
move_to_writes() {
    local link="$1" key value flags=""
    [[ "$link" == */cwd ]] && return 0
    local pid="${link#"$PROC"/}"
    pid="${pid%%/*}"
    while read -r key value; do
        [[ "$key" == flags: ]] && { flags="$value"; break; }
    done 2>/dev/null <"$PROC/$pid/fdinfo/${link##*/}" || true
    [[ -n "$flags" ]] && (( (8#$flags & 3) ))
}

# move_to_process_trees SID: the git working trees SID's own processes work in (a working
# directory, or a file open for writing, in one), one per line, from MT_TOUCHES: what a session
# shares with others, found without inferring its paths. Cached in MT_PTREES.
move_to_process_trees() {
    local s="$1" _sid link target dir
    local -A seen=() roots=()
    if [[ -z "${MT_PTREES[$s]+x}" ]]; then
        while IFS=$'\t' read -r _sid link target; do
            [[ "$target" == /* && "$target" != *" (deleted)" ]] || continue
            if [[ "$link" == */cwd ]]; then dir="$target"; else dir="${target%/*}"; fi
            [[ -n "$dir" && -z "${seen[$dir]:-}" ]] || continue
            case "$dir" in /proc|/proc/*|/sys|/sys/*|/dev|/dev/*|/run|/run/*|/tmp|/tmp/*) continue ;; esac
            move_git_root_var "$dir" || { seen[$dir]=1; continue; }
            move_to_writes "$link" || continue
            seen[$dir]=1
            move_dir_too_broad "$MOVE_GIT_ROOT" && continue
            move_within "$MOVE_GIT_ROOT" "$HOME/.dotfiles" && continue
            move_within "$MOVE_GIT_ROOT" "$DOTFILES_DIR" && continue
            [[ "$s" == "$MOVE_TO_LEAVE_SID" ]] && move_to_left "$MOVE_GIT_ROOT" && continue
            roots[$MOVE_GIT_ROOT]=1
        done < <(awk -F'\t' -v s="$s" '$1 == s' <<<"$MT_TOUCHES")
        MT_PTREES[$s]="$(printf '%s\n' "${!roots[@]}")"
    fi
    printf '%s\n' "${MT_PTREES[$s]}"
}

# move_to_records_parallel SID…: move_to_session_record for each SID not read yet, in parallel,
# MOVE_RECORD_JOBS at a time, each in a subshell that leaves its answer in files. It waits for its
# own workers by pid: a bare `wait` also waited for the progress line of `move --to`, which runs
# until the command ends, and so held every dry run to its time limit (2026-11-03).
move_to_records_parallel() {
    local s tmp todo=() workers=() w
    for s in "$@"; do [[ -n "${MT_DONE[$s]:-}" ]] || todo+=("$s"); done
    (( ${#todo[@]} )) || return 0
    tmp="$(mktemp -d)"
    for s in "${todo[@]}"; do
        (
            move_to_session_record "$s"
            printf '%s' "${MT_DIRS[$s]}" >"$tmp/$s.dirs"
            printf '%s' "${MT_SHARE[$s]}" >"$tmp/$s.share"
            printf '%s' "${MT_COPY[$s]}" >"$tmp/$s.copy"
        ) &
        workers+=("$!")
        if (( ${#workers[@]} >= MOVE_RECORD_JOBS )); then
            wait "${workers[0]}" 2>/dev/null || true
            workers=("${workers[@]:1}")
        fi
    done
    for w in ${workers[@]+"${workers[@]}"}; do wait "$w" 2>/dev/null || true; done
    for s in "${todo[@]}"; do
        MT_DONE[$s]=1
        MT_ROW[$s]="${MT_ROW_OF[$s]}"
        MT_DIRS[$s]="$(cat "$tmp/$s.dirs" 2>/dev/null || true)"
        MT_SHARE[$s]="$(cat "$tmp/$s.share" 2>/dev/null || true)"
        MT_COPY[$s]="$(cat "$tmp/$s.copy" 2>/dev/null || true)"
    done
    rm -rf "$tmp"
}

# move_to_session_record SID [DIR…]: MT_DIRS, MT_SHARE and MT_COPY of one session
# (move_to_session_paths), once; DIR… are the caller's own --dir paths.
move_to_session_record() {
    local s="$1" class pid sid pane at cwd detail
    shift
    [[ -z "${MT_DONE[$s]:-}" ]] || return 0
    MT_DONE[$s]=1
    MT_ROW[$s]="${MT_ROW_OF[$s]}"
    IFS="$SEP" read -r class pid sid pane at cwd detail <<<"${MT_ROW_OF[$s]}"
    MT_DIRS[$s]="" MT_SHARE[$s]="" MT_COPY[$s]=""
    if move_to_session_paths "$pid" "$s" "$cwd" "$@"; then
        MT_DIRS[$s]="$(printf '%s\n' "${MOVE_TO_DIRS[@]}")"
        MT_SHARE[$s]="$(printf '%s\n' ${MOVE_TO_SHARE[@]+"${MOVE_TO_SHARE[@]}"})"
        MT_COPY[$s]="$(printf '%s\n' ${MOVE_TO_COPY[@]+"${MOVE_TO_COPY[@]}"})"
    fi
}
# move_to_find_group SID [DIR…]: SID's group in MOVE_TO_GROUP (SID first): SID and every session
# with a process whose working directory, or a file open for writing, is in one of SID's own git
# trees - the trees its live processes work in (move_to_process_trees), the tree it resumes in,
# and the git trees its paths name. Only SID's trees: a member's other trees pull nobody in. The
# closure over every member's trees pulled most of this host into the INFRA lead's group, and its
# dry run ran past 400 s at load 500 (2026-11-03). A group of more than MOVE_TO_GROUP_MAX
# sessions is refused with the trees and sessions that make it, before any member's paths are
# inferred: such a tree is a shared checkout, which a session leaves with --leave or works in
# from a worktree of its own. Needs move_to_scan_processes. DIR… are SID's own --dir paths.
MOVE_TO_GROUP_MAX="${AGENTBOX_MOVE_GROUP_MAX:-6}"
move_to_find_group() {
    local self="$1" o link trees="" own_cwd_tree="" t
    shift
    local -A in=([$self]=1) why=()
    MOVE_USE_PLAN=true
    MOVE_TO_GROUP=("$self")
    move_to_session_record "$self" "$@"
    if [[ -n "$MOVE_SELF_CWD" ]] && move_git_root_var "$MOVE_SELF_CWD" && ! move_dir_too_broad "$MOVE_GIT_ROOT"; then
        own_cwd_tree="$MOVE_GIT_ROOT"
    fi
    # Only the trees its own live processes work in, and the one it resumes in: a tree it merely
    # NAMES (a --dir, or its record) is copied and groups nobody (S3's --dir of a checkout many
    # sessions work in grew a group whose listing ran past 900 s, 2026-11-03).
    trees="$(move_to_process_trees "$self")"$'\n'"$own_cwd_tree"
    while IFS=$'\t' read -r o link t; do
        [[ -n "${MT_ROW_OF[$o]:-}" && -z "${in[$o]:-}" ]] || continue
        move_to_writes "$link" || continue
        in[$o]=1
        why[$o]="$t"
        MOVE_TO_GROUP+=("$o")
    done < <(TREES="$trees" awk -F'\t' '
        BEGIN { n = split(ENVIRON["TREES"], t, "\n") }
        {
            p = $3
            if ($2 !~ /\/cwd$/) sub(/\/[^\/]*$/, "", p)
            for (k = 1; k <= n; k++) if (t[k] != "" && (p == t[k] || index(p, t[k] "/") == 1)) { print $1 "\t" $2 "\t" t[k]; next }
        }' <<<"$MT_TOUCHES")
    if (( ${#MOVE_TO_GROUP[@]} > MOVE_TO_GROUP_MAX )); then
        local o2 list=""
        for o2 in "${MOVE_TO_GROUP[@]:1}"; do list+="$o2 in ${why[$o2]}; "; done
        die "this session's group would be ${#MOVE_TO_GROUP[@]} sessions (over $MOVE_TO_GROUP_MAX), through shared trees: ${list% }. Nothing was hung up. Work in a worktree of your own and pass --leave for the shared tree (agentbox move --to <machine> --cwd <your tree> --leave <shared tree>), or name the group's sessions to Main"
    fi
    move_to_records_parallel "${MOVE_TO_GROUP[@]}"
}

# move_to_census_paths: MT_* for EVERY session, for `move --plan --to`, which shows every group
# (move_to_records_parallel, after one prefetch of every session's record).
move_to_census_paths() {
    move_to_scan_processes
    echo "agentbox: ${#MT_ROW_OF[@]} sessions with an id to read, $MOVE_RECORD_JOBS at a time" >&2
    move_record_prefetch "${!MT_ROW_OF[@]}"
    MOVE_USE_PLAN=true
    move_to_records_parallel "${!MT_ROW_OF[@]}"
    echo "agentbox: ${#MT_ROW_OF[@]} sessions read" >&2
    [[ -z "$MOVE_RECORD_CACHE" ]] || rm -f "$MOVE_RECORD_CACHE"
    MOVE_RECORD_CACHE=""
    return 0
}

# move_to_member SID TARGET: a group member as the relauncher's job needs it, one JSON object on
# stdout; or the reason it cannot be moved on stderr, status 1. Its paths are MT_DIRS[SID].
# move_transcript_cwd FILE: the cwd in the transcript's session header, which omp adopts on every
# resume when it exists (oh-my-pi session-manager.ts); nothing when there is none.
move_transcript_cwd() {
    [[ -r "$1" ]] || return 1
    local c
    c="$(head -n 5 "$1" 2>/dev/null | jq -r 'select(.type == "session") | .cwd // empty' 2>/dev/null | head -1)"
    [[ -n "$c" ]] || return 1
    printf '%s\n' "$c"
}

# --cwd of `move --to`, for move_to_member: the caller resumes there, and its transcript is
# re-rooted there on the target (move_to_reroot).
MOVE_TO_NEW_CWD=""
move_to_member() {
    local sid="$1" target="$2" class pid _sid pane at cwd detail dirs=() reroot=false hc
    IFS="$SEP" read -r class pid _sid pane at cwd detail <<<"${MT_ROW[$sid]}"
    [[ "$class" == host ]] || { echo "session $sid is $class ($detail), which only a person can move" >&2; return 1; }
    [[ -n "$pane" ]] || { echo "session $sid has no tmux pane" >&2; return 1; }
    mapfile -t dirs <<<"${MT_DIRS[$sid]}"
    [[ -n "${dirs[0]:-}" ]] || { echo "session $sid: $(move_dirs_why "$cwd" "$pid" "$sid" 2>&1 >/dev/null || true)" >&2; return 1; }
    move_session_spec "$pid" "$sid" "${dirs[@]}" || { echo "session $sid: $MOVE_RESUME_WHY" >&2; return 1; }
    move_target_tmux "$pid"
    if ! "$MOVE_TMUX_BIN" "${MOVE_TMUX[@]}" display-message -p -t "$pane" '#{pane_pid}' >/dev/null 2>&1; then
        echo "session $sid: tmux cannot reach its pane $pane from here ($MOVE_TMUX_BIN ${MOVE_TMUX[*]})" >&2
        return 1
    fi
    # The member resumes where omp will put it: its transcript header's cwd, which omp adopts on
    # every resume, not the shell's (LINUX-1248, 2026-11-03: its box worked in its worktree while
    # omp went back to the header's ~/src/machcsl-riscv). --cwd re-roots the transcript instead.
    if [[ -n "$MOVE_TO_NEW_CWD" && "$sid" == "$MOVE_TO_LEAVE_SID" ]]; then
        cwd="$MOVE_TO_NEW_CWD"
        hc="$(move_transcript_cwd "$MOVE_RESUME" || true)"
        [[ "$hc" == "$cwd" ]] || reroot=true
    elif hc="$(move_transcript_cwd "$MOVE_RESUME")"; then
        cwd="$hc"
    fi
    # Every directory this member CARRIES is bound in its new box, not only the one it works in:
    # SCIENCE landed on sami-devbox with its working directory alone and none of the trees the
    # move had copied (2026-11-03). A path the box has anyway, one too broad to bind, and a git
    # directory (the box's own --dir brings the tree's storage) are left out.
    local line kind path have p2
    while IFS= read -r line; do
        [[ -n "$line" ]] || continue
        kind="${line%%$'\t'*}" path="${line#*$'\t'}"
        [[ -d "$path" ]] || continue
        [[ "$path" == */.git || "$path" == */.git/* ]] && continue
        move_dir_in_box "$path" && continue
        move_dir_too_broad "$path" && continue
        have=0
        for p2 in "${MOVE_SPEC[@]}"; do
            [[ "$p2" == /* ]] || continue
            move_within "$path" "$p2" && { have=1; break; }
        done
        (( have )) || MOVE_SPEC+=(--dir "$path")
    done <<<"${MT_COPY[$sid]:-}"$'\n'"$(printf 'mirror\t%s\n' ${MT_SHARE[$sid]+${MT_SHARE[$sid]}})"

    # The window's NAME, not only its index: a stream's windows are named for the stream, and
    # pilot.py counts a stream's sessions by that name. `at` holds session:index.pane, which says
    # nothing about the stream once the session is on another machine.
    local window
    window="$("$MOVE_TMUX_BIN" "${MOVE_TMUX[@]}" display-message -p -t "$pane" '#{session_name}:#{window_name}' 2>/dev/null || true)"
    jq -cn --arg sid "$sid" --argjson pid "$pid" --arg pane "$pane" --arg at "$at" --arg cwd "$cwd" \
        --arg resume "$MOVE_RESUME" --arg tmux_bin "$MOVE_TMUX_BIN" --argjson reroot "$reroot" \
        --arg window "$window" \
        --argjson spec "$(move_json_array "${MOVE_SPEC[@]}")" \
        --argjson flags "$(move_json_array ${MOVE_OMP_FLAGS[@]+"${MOVE_OMP_FLAGS[@]}"})" \
        --argjson tmux "$(move_json_array ${MOVE_TMUX[@]+"${MOVE_TMUX[@]}"})" \
        '{sid: $sid, pid: $pid, box: "", pane: $pane, at: $at, cwd: $cwd, resume: $resume, spec: $spec,
          flags: $flags, tmux: $tmux, tmux_bin: $tmux_bin, reroot: $reroot, window: $window}'
}

# move_to_job TARGET GROUP MEMBER-JSON…: the relauncher's job file, with the copy lists of every
# member (MOVE_TO_MIRROR, MOVE_TO_MERGE, MOVE_TO_EXCLUDE, already built); prints its path.
move_to_job() {
    local target="$1" group="$2" job
    shift 2
    mkdir -p "$MOVE_TO_JOBS" || return 1
    job="$MOVE_TO_JOBS/$group-$(date -u +%Y%m%dT%H%M%SZ)-$$.json"
    jq -n --arg to "$target" --arg group "$group" --arg from "${AGENTBOX_HOST:-$(hostname -s)}" \
        --argjson members "$(printf '%s\n' "$@" | jq -cs .)" \
        --argjson mirror "$(move_json_array ${MOVE_TO_MIRROR[@]+"${MOVE_TO_MIRROR[@]}"})" \
        --argjson merge "$(move_json_array ${MOVE_TO_MERGE[@]+"${MOVE_TO_MERGE[@]}"})" \
        --argjson exclude "$(move_json_array ${MOVE_TO_EXCLUDE[@]+"${MOVE_TO_EXCLUDE[@]}"})" \
        --argjson mkdir "$(move_json_array ${MOVE_TO_MKDIR[@]+"${MOVE_TO_MKDIR[@]}"})" \
        --argjson ssh "$(move_json_array "${MOVE_TO_SSH[@]}")" \
        --arg lead "${AGENTBOX_MOVE_LEAD:-}" \
        '{to: $to, group: $group, from: $from, ssh: $ssh, lead: $lead, members: $members, mirror: $mirror, merge: $merge, exclude: $exclude, mkdir: $mkdir}' \
        >"$job" || return 1
    printf '%s\n' "$job"
}

# The notice to a member of a group that has not said it is at its safe point.
MOVE_TO_NOTICE='agentbox: this session moves to %TARGET% with its group (sessions %GROUP%), which shares a working tree with it (dispatch://INFRA-993). Do not stop, delay or shorten any work for it. The next time none of YOUR jobs is running (`pstree -p %PID%` shows them; ignore the bash tool you run it in), write your handover into the transcript, run `agentbox move --to %TARGET%` from your bash tool, and then end your turn and start no new work for 10 minutes (after that your readiness lapses and you are asked again): the last session of the group to run it moves the whole group, and hangs up every session in it. You come back on %TARGET% with the same session id, transcript and trees, uncommitted work included. If this session is finished or is ending, do not move it: end as you planned, and tell the session that sent this. (An automated notice from agentbox, not a person.)'

# A ready file says one session is at its safe point for a move to one target.
move_to_ready_mark() { mkdir -p "$MOVE_TO_JOBS/ready" && printf '%s\t%s\n' "$2" "$(date +%s)" >"$MOVE_TO_JOBS/ready/$1"; }
move_to_is_ready() {
    local target at
    [[ -r "$MOVE_TO_JOBS/ready/$1" ]] || return 1
    IFS=$'\t' read -r target at <"$MOVE_TO_JOBS/ready/$1" || return 1
    [[ "$target" == "$2" ]] && (( $(date +%s) - ${at:-0} <= MOVE_TO_READY_TTL ))
}

cmd_move_to() {
    local target="" dry=false clear=false in_box=false raw_dirs=() me new_cwd="" p only_dirs=false
    [[ -n "${AGENTBOX_BOX:-}" || -e "$AGENTBOX_IDENTITY_FILE" ]] && in_box=true
    while (( $# )); do
        case "$1" in
            --to) [[ -n "${2:-}" && "$2" != -* ]] || die "--to takes a machine name, e.g. --to sami-devbox. $MOVE_USAGE"; target="$2"; shift ;;
            --dry-run) dry=true ;;
            --clear-halt) clear=true ;;
            --accept-orphans) MOVE_ACCEPT_ORPHANS=true ;;
            # In a box: the named --dir paths are the WHOLE list of the new box, so a bind this
            # box inherited is dropped (a session cannot shed one otherwise).
            --only-dirs) only_dirs=true ;;
            --cwd)
                [[ -d "${2:-}" ]] || die "--cwd takes an existing directory, the one the session resumes in. $MOVE_USAGE"
                new_cwd="$(readlink -f "$2")"
                MOVE_TO_NEW_CWD="$new_cwd"
                shift
                ;;
            --leave)
                [[ -d "${2:-}" ]] || die "--leave takes an existing directory, a tree this session no longer works in. $MOVE_USAGE"
                MOVE_TO_LEAVE+=("$(readlink -f "$2")")
                [[ "$(readlink -f "$2")" == "${2%/}" ]] || MOVE_TO_LEAVE+=("${2%/}")
                shift
                ;;
            --dir)
                [[ -n "${2:-}" ]] || die "--dir takes an existing directory. $MOVE_USAGE"
                if $in_box; then raw_dirs+=("$2"); else add_box_dir "$2"; fi
                shift
                ;;
            *) die "agentbox move --to does not take '$1'. $MOVE_USAGE" ;;
        esac
        shift
    done
    [[ -n "$target" ]] || die "$MOVE_USAGE"
    me="${AGENTBOX_HOST:-$(hostname -s)}"
    [[ "$target" != "$me" ]] || die "$target is this machine; \`agentbox move --self\` moves a session into a box here"
    if $clear; then
        move_to_log "$target" "$(date -u +%FT%TZ)	-	-	$me	$target	halt-cleared	-" || exit 1
        echo "agentbox: moves to $target may go on; the halt is cleared in $target:$MOVE_TO_LOG"
        return 0
    fi
    if $in_box; then
        [[ -z "$new_cwd" && ${#MOVE_TO_LEAVE[@]} -eq 0 ]] || die "--cwd and --leave are for a host session; a boxed session's paths are its box's --dir paths"
        if $only_dirs; then
            (( ${#raw_dirs[@]} )) || die "--only-dirs takes the whole list of paths the new box gets: name at least one --dir"
            MOVE_ONLY_DIRS=true
        fi
        move_to_in_box "$target" "$dry" ${raw_dirs[@]+"${raw_dirs[@]}"}
        return $?
    fi
    if $only_dirs; then
        die "--only-dirs is for a session already in a box: it replaces the box's inherited --dir list. From a host session the inference decides, and --dir adds to it"
    fi
    move_progress_start
    # Read once, in this shell, what the $(…) subshells below would each read again.
    MOVE_CENSUS_ONCE=true
    move_step "reading this host's omp processes (the census)"
    move_census >/dev/null
    move_in_box_paths
    move_self_identify "agentbox move --to $target"
    local sid="$MOVE_SELF_SID" s members=() missing=() m err group
    move_to_index_transcripts
    move_step "reading this host's processes (one census, one find over /proc)"
    move_to_scan_processes
    # --cwd / --leave: the session resumes in another tree and leaves one it no longer works in, so
    # it does not group with the sessions there (LINUX-1248, 2026-11-03: its omp's working
    # directory was ~/src/machcsl-riscv, shared by three other sessions, after it had moved its
    # work to a worktree of its own). Refused while a process of its own, other than the omp,
    # holds a file open for writing in a left tree; a working directory alone is not work (the
    # session's tool shells and runners start in the omp's working directory).
    if [[ -n "$new_cwd" || ${#MOVE_TO_LEAVE[@]} -gt 0 ]]; then
        MOVE_TO_LEAVE_SID="$sid"
        [[ -z "$new_cwd" ]] || ! move_to_left "$new_cwd" || die "--cwd $new_cwd is inside a tree it --leave's"
        # Not the move command itself: its own processes (the tool shell running it, its pipes)
        # are the caller's chain from the omp down, and what they start.
        local busy p own_chain=" "
        p=$$
        while [[ -n "$p" && "$p" != "$MOVE_SELF_PID" && "$p" -gt 1 ]]; do
            own_chain+="$p "
            move_stat "$p" || break
            p="$MOVE_PPID"
        done
        while IFS= read -r p; do own_chain+="$p "; done < <(move_descendants $$)
        busy="$(awk -F'\t' -v s="$sid" -v omp="$PROC/$MOVE_SELF_PID/" '$1 == s && index($2, omp) != 1 { print $2 "\t" $3 }' <<<"$MT_TOUCHES" \
            | while IFS=$'\t' read -r link tgt; do
                [[ "$link" == */cwd || "$tgt" != /* ]] && continue
                l="${link#"$PROC"/}"
                [[ "$own_chain" != *" ${l%%/*} "* ]] || continue
                tgt="${tgt%/*}"
                if move_to_left "$tgt" && move_to_writes "$link"; then echo "pid ${l%%/*} ($tgt)"; fi
            done | sort -u | head -5 || true)"
        [[ -z "$busy" ]] || die "this session still works in a tree it would --leave: $(paste -sd ';' <<<"$busy"); nothing was hung up"
        if [[ -n "$new_cwd" ]]; then
            local f=()
            IFS="$SEP" read -r -a f <<<"${MT_ROW_OF[$sid]}"
            f[5]="$new_cwd"
            MT_ROW_OF[$sid]="$(IFS="$SEP"; echo "${f[*]}")"
            MOVE_SELF_CWD="$new_cwd"
        fi
    fi
    [[ -n "${MT_ROW_OF[$sid]:-}" ]] || die "session $sid is not in this host's census"
    move_step "finding this session's group and inferring its paths"
    move_to_find_group "$sid" ${BOX_DIRS[@]+"${BOX_DIRS[@]}"}
    [[ -n "${MT_DIRS[$sid]:-}" ]] || die "$(move_dirs_why "$MOVE_SELF_CWD" "$MOVE_SELF_PID" "$sid" 2>&1 >/dev/null || true)"
    group="g-$(printf '%s\n' "${MOVE_TO_GROUP[@]}" | sort | head -1 | cut -c1-8)"
    local k=0
    for s in "${MOVE_TO_GROUP[@]}"; do
        k=$((k + 1))
        move_step "reading member $k of ${#MOVE_TO_GROUP[@]} ($s): its transcript, its spec, its pane"
        err="$(mktemp)"
        if m="$(move_to_member "$s" "$target" 2>"$err")"; then members+=("$m"); else missing+=("$(<"$err")"); fi
        rm -f "$err"
    done
    if (( ${#missing[@]} )); then
        die "group $group (${MOVE_TO_GROUP[*]}) cannot move; nothing was hung up: $(printf '%s; ' "${missing[@]}")"
    fi
    # A dry run goes on past a refusal of the target's checks and says each one at the end, so
    # the copy list is seen even while the target is not ready; a real run stops at the first.
    local would=()
    # A dry run never waits for the target; it says what the move would wait for.
    $dry && MOVE_TO_READY_WAIT=0
    move_to_or_would() { if $dry; then would+=("$1"); else die "no move to $target; nothing was hung up: $1"; fi; }
    move_step "asking $target: ready, halts, the same sessions there"
    move_to_preflight "$target" "${MOVE_TO_GROUP[@]}" || move_to_or_would "$MOVE_TO_WHY"
    move_to_warn_mcp_logins "$target"
    local copy="" cwds=() tpaths="" t
    for s in "${MOVE_TO_GROUP[@]}"; do
        copy+="${MT_COPY[$s]}"$'\n'
        t="$(move_to_transcript_paths "$(jq -r --arg s "$s" 'select(.sid == $s) | .resume' <<<"$(printf '%s\n' "${members[@]}")")")"
        copy+="$t"$'\n'
        tpaths+="$(cut -f2 <<<"$t")"$'\n'
    done
    move_to_copy_lists <<<"$copy"
    mapfile -t cwds < <(printf '%s\n' "${members[@]}" | jq -r .cwd)
    # Only what was asked for, or inferred at its own size (move_to_gate).
    move_step "measuring the inferred directories the session did not name"
    local -a asked=()
    mapfile -t asked < <(printf '%s\n' ${BOX_DIRS[@]+"${BOX_DIRS[@]}"} "${cwds[@]}" $tpaths | sed '/^$/d')
    MOVE_TO_NAMED=(${BOX_DIRS[@]+"${BOX_DIRS[@]}"})
    move_to_gate "${asked[@]}"
    local not_carried
    not_carried="$(awk -F'\t' -v ids=" ${MOVE_TO_GROUP[*]} " 'index(ids, " " $1 " ") { print $2 "\t" $3 }' <<<"$MT_TOUCHES" | move_to_not_carried)"
    move_to_cwds_present "$target" "${cwds[@]}" || move_to_or_would "$MOVE_TO_WHY"
    move_to_dests_writable "$target" || move_to_or_would "$MOVE_TO_WHY"
    move_to_target_worktrees "$target" || move_to_or_would "$MOVE_TO_WHY"
    # What of THIS session dies with the hang-up; each other member asks its own when it runs this.
    move_orphans_gate "$MOVE_SELF_PID" "$$" "$dry" || die "no move to $target; nothing was hung up: $MOVE_ORPHANS_WHY"
    # Each other session of the group says itself that it is at its safe point.
    local waiting=() notice
    if (( ${#MOVE_TO_GROUP[@]} > 1 )); then
        $dry || move_to_ready_mark "$sid" "$target"
        for s in "${MOVE_TO_GROUP[@]:1}"; do
            move_to_is_ready "$s" "$target" || waiting+=("$s")
        done
    fi
    echo "agentbox: group $group, ${#MOVE_TO_GROUP[@]} session(s): ${MOVE_TO_GROUP[*]}"
    move_to_print_lists "$target" "$not_carried"
    for m in "${members[@]}"; do
        jq -r --arg t "$MOVE_TO_AGENTBOX" '"  \(.sid): tmux window moved:\(.sid[0:8]) on the target runs \($t) new \(.spec | join(" ")) -- omp \((.flags // []) | map(@sh + " ") | add // "")--resume \(.resume)"' <<<"$m"
    done
    if $dry && (( ${#would[@]} )); then
        MOVE_SAID=1
        printf 'agentbox: --dry-run: the move would REFUSE now, before any hang-up: %s\n' "${would[@]}" >&2
        return 1
    fi
    if (( ${#waiting[@]} )); then
        for s in "${waiting[@]}"; do
            IFS="$SEP" read -r _ m _ <<<"${MT_ROW[$s]}"
            notice="${MOVE_TO_NOTICE//%TARGET%/$target}"
            notice="${notice//%GROUP%/${MOVE_TO_GROUP[*]}}"
            notice="${notice//%PID%/$m}"
            if $dry; then echo "agentbox: would ask $s to run \`agentbox move --to $target\` at its safe point"; continue; fi
            envoy_send_text "$s" "$notice" >/dev/null || echo "agentbox: envoy send to $s failed" >&2
        done
        echo "agentbox: this session is ready; the group moves when ${waiting[*]} run(s) \`agentbox move --to $target\` too (each was asked over Envoy). Go on with your work until then; the last of them hangs this session up."
        return 0
    fi
    if $dry; then echo "agentbox: --dry-run: nothing was hung up, copied or sent"; return 0; fi
    local job log
    job="$(move_to_job "$target" "$group" "${members[@]}")" || die "could not write the move's job file under $MOVE_TO_JOBS; nothing was hung up"
    log="$MOVE_TO_JOBS/$group.log"
    setsid "$(readlink -f "${BASH_SOURCE[0]}")" move --to-run "$job" </dev/null >>"$log" 2>&1 &
    if (( MOVE_TO_HOLD_WAIT > 0 )); then
        echo "agentbox: the move of group $group to $target is handed to a detached relauncher; log: $log. Go on with your work: it checks, clones and copies first, then tells you over Envoy to run \`agentbox move --go\` at your safe point; only that hangs this session up."
    else
        echo "agentbox: the move of group $group to $target is handed to a detached relauncher; log: $log. This session is hung up within seconds: end your turn now."
    fi
}

# In a box: this session alone (a box cannot read the host's other sessions), with the paths the
# box was given and its own trees under $SRC, moved by the HOST: `tmux run-shell` on the relayed
# server starts the relauncher there, which hangs the box up (docker kill -s HUP) before the copy.
#
# move_to_box_only_paths: refuse a move whose copy list holds a path that exists only INSIDE this
# box. A bind of a host path has a device of its own (the host's filesystem); a path in the box's
# own layer or its disk image shares the device of `/` here, and the other machine would get
# nothing at that path (SPEC-skills lost /var/tmp/sc-head and sc-ablate, 2026-11-04).
move_to_box_only_paths() {
    local root_dev p dev bad=()
    root_dev="${AGENTBOX_ROOT_DEV:-}"
    [[ -n "$root_dev" ]] || root_dev="$(stat -c %d / 2>/dev/null)" || return 0
    [[ -n "$root_dev" ]] || return 0
    for p in ${MOVE_TO_MIRROR[@]+"${MOVE_TO_MIRROR[@]}"} ${MOVE_TO_MERGE[@]+"${MOVE_TO_MERGE[@]}"}; do
        [[ -e "$p" ]] || continue
        dev="$(stat -c %d "$p" 2>/dev/null)" || continue
        [[ "$dev" == "$root_dev" ]] && bad+=("$p")
    done
    (( ${#bad[@]} )) || return 0
    die "these paths live in THIS BOX only, not on a host path another machine can be given, so a move would lose them: $(printf '%s ' "${bad[@]}"). Nothing was hung up. Copy each one to a path the box has from the host (a --dir of this box, /mnt/nvme/$(id -un)/… or /mnt/durable/$(id -un)/…) and move again"
}

move_to_in_box() {
    local target="$1" dry="$2" sid cwd pane own resume="" spec=() dirs=() d copy=""
    shift 2
    if ! $MOVE_ONLY_DIRS; then
        [[ -n "${AGENTBOX_DIRS:-}" ]] && IFS=: read -r -a dirs <<<"$AGENTBOX_DIRS"
    fi
    for d in "$@"; do [[ -n "$d" ]] && dirs+=("$d"); done
    (( ${#dirs[@]} )) || die "this box was started with repositories, whose clones are in its own disk image and not at host paths another machine is given; push its branches and start the session on $target instead"
    sid="${OMP_SESSION_ID:-}"
    [[ -n "$sid" ]] || die "no OMP_SESSION_ID in this box, so the move could not name the session to resume"
    [[ -n "${AGENTBOX_BOX:-}" ]] || die "no AGENTBOX_BOX in this box, so the host could not tell which container to hang up"
    pane="${TMUX_PANE:-}"
    [[ -n "$pane" ]] || die "this box has no TMUX_PANE, so the host cannot put the session back in its pane if the move fails"
    cwd="$PWD"
    local flags=()
    if own="$(move_own_omp)"; then
        resume="$(move_transcript "$own" "$sid" || true)"
        mapfile -t spec < <(move_session_env "$own")
        move_omp_flags "$own" || die "session $sid cannot be moved: $MOVE_OMP_FLAGS_WHY; nothing was hung up"
        flags=(${MOVE_OMP_FLAGS[@]+"${MOVE_OMP_FLAGS[@]}"})
    fi
    [[ -n "$resume" || "${PI_SESSION_FILE:-}" != *_"$sid".jsonl ]] || resume="$PI_SESSION_FILE"
    [[ -n "$resume" ]] || die "no transcript of session $sid can be read here; nothing was hung up"
    # Where omp will resume: the transcript header's cwd, not this shell's (move_to_member).
    local hc
    hc="$(move_transcript_cwd "$resume")" && cwd="$hc"
    for d in "${dirs[@]}"; do
        spec+=(--dir "$d")
        if move_git_root_var "$d"; then copy+="mirror	$d"$'\n'; else copy+="merge	$d"$'\n'; fi
    done
    copy+="$(move_to_src_trees "$cwd" "${own:-}")"$'\n'
    local tpaths
    tpaths="$(move_to_transcript_paths "$resume")"
    copy+="$tpaths"$'\n'
    move_to_copy_lists <<<"$copy"
    # A path this box holds in its OWN layer - not a bind of a host path - dies with the container
    # at the hang-up and reaches no other machine: /var/tmp and the rest of the box's filesystem
    # are inside its disk image. SPEC-skills lost /var/tmp/sc-head and sc-ablate that way
    # (2026-11-04). Each copy path is tested by its device against the box's own root, and one
    # that is the box's own is named and refused before anything is hung up.
    move_to_box_only_paths
    # Only what was asked for - this move's --dir paths (the box's own are inferred), the working
    # directory, the transcript - or inferred at its own size (move_to_gate).
    local -a asked=()
    mapfile -t asked < <(printf '%s\n' "${@}" "$cwd" $(cut -f2 <<<"$tpaths") | sed '/^$/d')
    MOVE_TO_NAMED=("$@")
    move_to_gate "${asked[@]}"
    local touches="" p
    if [[ -n "${own:-}" ]]; then
        local -a procs=()
        while IFS= read -r p; do procs+=("$PROC/$p/cwd" "$PROC/$p/fd"); done < <(move_read_kids; move_descendants "$own")
        (( ${#procs[@]} )) && touches="$(find "${procs[@]}" -maxdepth 1 -type l -printf '%p\t%l\n' 2>/dev/null || true)"
    fi
    if [[ -n "${own:-}" ]]; then move_orphans_gate "$own" "$$" "$dry" || die "no move to $target; nothing was hung up: $MOVE_ORPHANS_WHY"; fi
    local group="g-${sid:0:8}" member job sock
    # The host server's own socket path, asked through the relay: the relauncher runs under that
    # server's run-shell, whose environment need not name it (a drill's rollback found no pane %0
    # on the host's default server).
    sock="$(tmux display-message -p '#{socket_path}' 2>/dev/null || true)"
    member="$(jq -cn --arg sid "$sid" --arg box "${AGENTBOX_BOX:-}" --arg pane "$pane" --arg cwd "$cwd" --arg resume "$resume" \
        --argjson spec "$(move_json_array "${spec[@]}")" --argjson tmux "$(move_json_array ${sock:+-S "$sock"})" \
        --argjson flags "$(move_json_array ${flags[@]+"${flags[@]}"})" \
        '{sid: $sid, pid: 0, box: $box, pane: $pane, at: "", cwd: $cwd, resume: $resume, spec: $spec, flags: $flags, tmux: $tmux, tmux_bin: ""}')"
    echo "agentbox: session $sid, in box ${AGENTBOX_BOX:-?}, moves to $target as: $MOVE_TO_AGENTBOX new ${spec[*]} -- $(move_omp_line "$resume" ${flags[@]+"${flags[@]}"})"
    move_to_print_lists "$target" "$(move_to_not_carried <<<"$touches")"
    if [[ "$dry" == true ]]; then echo "agentbox: --dry-run: nothing was hung up, copied or sent"; return 0; fi
    job="$(move_to_job "$target" "$group" "$member")" || die "could not write the move's job file under $MOVE_TO_JOBS"
    local box_tmux run_cmd started=false
    # --fork: `setsid` alone execs in place when it is not already a process group leader, so the
    # relauncher stayed a child of tmux's run-shell job and died with it the moment it had to wait
    # (LANE-E, 23:35:38Z and 23:58:46Z on 2026-11-03: "waiting: N moves in flight" then "stopped by
    # signal TERM" in the same second). With --fork it is a session of its own, and the run-shell
    # returns at once.
    run_cmd="$(printf 'setsid --fork %q move --to-run %q </dev/null >>%q 2>&1' \
        "$(readlink -f "${BASH_SOURCE[0]}")" "$job" "$MOVE_TO_JOBS/$group.log")"
    if box_tmux="$(move_box_tmux)" && "$box_tmux" run-shell -b -t "$pane" "$run_cmd"; then
        started=true
    else
        # No tmux client here speaks to the host's server: queue the job through the cache
        # both share for an operator to start on the host (move --to-run --wait-for-job).
        mkdir -p "$MOVE_TO_JOBS/queue" && ln -sf "$job" "$MOVE_TO_JOBS/queue/$(basename "$job")" \
            && started=queued
    fi
    [[ "$started" != false ]] || die "no way to start the relauncher on the host: no tmux client here speaks to its server, and $MOVE_TO_JOBS/queue could not be written; nothing was hung up"
    if [[ "$started" == queued ]]; then
        local waiting=0 queued_job
        for queued_job in "$MOVE_TO_JOBS/queue/"*.json; do
            [[ -e "$queued_job" ]] || continue
            waiting=$((waiting + 1))
        done
        echo "agentbox: no tmux client in this box speaks to the host's server, so the job is queued at $MOVE_TO_JOBS/queue; $waiting queued move(s) waiting. To start them, run \`agentbox move --run-queue\` on host ${AGENTBOX_HOST:-the host that runs this box}." >&2
    fi
    if (( MOVE_TO_HOLD_WAIT > 0 )); then
        echo "agentbox: the host checks $target, clones and copies, then tells you over Envoy to run \`agentbox move --go\`; only that hangs this box up. Log: $MOVE_TO_JOBS/$group.log. Go on with your work."
    else
        echo "agentbox: the host checks $target and then hangs this box up; log: $MOVE_TO_JOBS/$group.log. End your turn now."
    fi
}

# The relauncher of `move --to`, detached on the host: `move --to-run <job>`. Every member is in
# one of three states at the end, and each is logged: moved (running on the target, its old pane a
# shell that says where it went), back here (in a box on this machine, its marker removed), or
# both-machines (found running on both; nothing more is done to it, and moves halt).
#
# While it runs, $MOVE_TO_JOBS/active/<sid> says so for each member (pid=, target=, start=):
# written before the hang-up, removed on every exit, so a pane restarter never resumes a
# session whose move is in flight. A relauncher stopped by a signal says so, with the step
# it was in, so its log never ends at "copying".
MOVE_TO_ACTIVE="$MOVE_TO_JOBS/active"
# One relauncher per session: the lock each holds for its life, and the descriptors that hold them.
# The target of the relauncher's own job, for the signal handler and the alert helpers, which run
# where move_to_run's locals are gone (the flight queue, the EXIT trap).
MOVE_TO_TARGET=""
# 1 from the hang-up until the group is resumed somewhere: a signal then does not stop the
# relauncher, since the sessions are running nowhere until it finishes.
MOVE_TO_COMMITTED=0
MOVE_TO_LOCKS="$MOVE_TO_JOBS/locks"
MOVE_TO_LOCK_FDS=()
# Jobs a BOX queued because no tmux client there speaks to the host's server (move_to_in_box).
# Run them manually on the host: `agentbox move --run-queue`.
MOVE_TO_QUEUE="$MOVE_TO_JOBS/queue"
move_to_run_queue() {
    local link job group started=0
    [[ -d "$MOVE_TO_QUEUE" ]] || return 0
    for link in "$MOVE_TO_QUEUE"/*.json; do
        [[ -e "$link" ]] || continue
        job="$(readlink -f "$link")"
        rm -f "$link"
        [[ -r "$job" ]] || continue
        group="$(jq -r .group "$job" 2>/dev/null)" || continue
        setsid "$(readlink -f "${BASH_SOURCE[0]}")" move --to-run "$job" </dev/null >>"$MOVE_TO_JOBS/$group.log" 2>&1 &
        echo "agentbox: started the queued move of group $group (job $job); log: $MOVE_TO_JOBS/$group.log"
        started=$((started + 1))
    done
    (( started == 0 )) || echo "agentbox: $started queued move(s) started"
    return 0
}
MOVE_TO_MAX_FLIGHT="${AGENTBOX_MOVE_MAX_FLIGHT:-2}"
MOVE_TO_FLIGHT_POLL="${AGENTBOX_MOVE_FLIGHT_POLL:-10}"
# The hold before the hang-up: once everything before it is done (checks, clones, branches, the
# first copy), the relauncher writes $MOVE_TO_HOLD/<sid> for each member, tells each session over
# Envoy, and hangs up only after every member's own `agentbox move --go` removed its file; after
# MOVE_TO_HOLD_WAIT seconds (1800; 0 for no hold) it refuses with nothing hung up, and the first
# copy stays on the target for the next try. S3 restarted its 14 lanes during a 66-minute first
# copy, and its move had to be stopped by hand before the hang-up (2026-11-03 08:18Z).
MOVE_TO_HOLD="$MOVE_TO_JOBS/hold"
MOVE_TO_HOLD_WAIT="${AGENTBOX_MOVE_HOLD_WAIT:-1800}"
# A hold whose relauncher has not touched it for this long is a dead or stopped relauncher. Six
# polls of the default MOVE_TO_POLL (5 s), so a loaded host is not called dead.
MOVE_TO_HOLD_STALE="${AGENTBOX_MOVE_HOLD_STALE:-120}"
move_to_hold() {
    local target="$1" s left deadline start=$SECONDS
    shift
    (( MOVE_TO_HOLD_WAIT > 0 )) || return 0
    mkdir -p "$MOVE_TO_HOLD"
    deadline=$((SECONDS + MOVE_TO_HOLD_WAIT))
    for s in "$@"; do
        printf 'target=%s\ndeadline=%s\npid=%s\n' "$target" "$(( $(date +%s) + MOVE_TO_HOLD_WAIT ))" "$BASHPID" >"$MOVE_TO_HOLD/$s"
        envoy_send_text --source envoy "$s" "agentbox: your move to $target is ready to hang you up (checks, clones and the first copy are done). Go on working; \`agentbox move --go\` is the ONLY moment this move stops you, and nothing stops until you run it. Run it at your next safe point within $((MOVE_TO_HOLD_WAIT / 60)) min; it hangs this session up and resumes it on $target. If you do not, the move is refused with nothing hung up, and the copy stays on $target for the next try. (An automated notice from agentbox.)" >/dev/null 2>&1 || true
    done
    say "holding before the hang-up: waiting up to $((MOVE_TO_HOLD_WAIT / 60)) min for \`agentbox move --go\` from $*"
    while :; do
        left=""
        # Each pass touches the hold files it still holds. That mtime is the heartbeat `move --go`
        # reads: a session in a BOX cannot see the host's pids at all (every boxed --go answered
        # "the relauncher is GONE", LANE-E 03:38Z 2026-11-04), and a relauncher stopped with
        # SIGSTOP on the host still passes `kill -0` while it does nothing.
        for s in "$@"; do [[ -e "$MOVE_TO_HOLD/$s" ]] && { touch "$MOVE_TO_HOLD/$s" 2>/dev/null || true; left+="$s "; }; done
        if [[ -z "$left" ]]; then
            say "every member ran \`agentbox move --go\` after $((SECONDS - start))s; hanging up"
            return 0
        fi
        if (( SECONDS >= deadline )); then
            for s in "$@"; do rm -f "$MOVE_TO_HOLD/$s"; done
            MOVE_TO_WHY="no \`agentbox move --go\` from ${left% } within $((MOVE_TO_HOLD_WAIT / 60)) min of the hold; the first copy stays on $target for the next try"
            return 1
        fi
        sleep "$((MOVE_TO_POLL > 0 ? MOVE_TO_POLL : 1))"
    done
}

# `agentbox move --go`: run by a session whose move holds before the hang-up (move_to_hold). Its
# id is OMP_SESSION_ID, on the host and in a box (where ~/.cache/omp is the host's).
cmd_move_go() {
    local sid="${OMP_SESSION_ID:-}" f target
    [[ -n "$sid" ]] || die "no OMP_SESSION_ID here: run \`agentbox move --go\` from the session's own bash tool"
    f="$MOVE_TO_HOLD/$sid"
    if [[ ! -e "$f" ]]; then
        # A move of this session may be running and simply not at its hold yet: waiting for a
        # slot among the moves in flight, cloning, or in its first copy, which is hours for a big
        # tree. Telling such a session to "run move --to first" sends it to ask for a second move
        # of itself (item 42, 2026-11-04). Say which it is.
        local claim="$MOVE_TO_ACTIVE/$sid" started job_target
        if [[ -e "$claim" ]]; then
            job_target="$(sed -n 's/^target=//p' "$claim" | head -1)"
            started="$(sed -n 's/^start=//p' "$claim" | head -1)"
            die "your move to ${job_target:-the target} is RUNNING (started $(( $(date +%s) - ${started:-$(date +%s)} ))s ago) and has not reached its hold yet: it is waiting for a slot, cloning, or in its first copy. Nothing is hung up and --go is not needed yet; it sends you the notice to run --go when the copy is done. Go on working"
        fi
        # Only a job still in the QUEUE: that is one a box wrote for the host to start
        # (move_to_in_box), and the host removes its link when it starts it. A job file in
        # $MOVE_TO_JOBS is kept after its move ends, so reading those would call every finished
        # or refused move "queued".
        if grep -slF "\"$sid\"" "$MOVE_TO_QUEUE"/*.json >/dev/null 2>&1; then
            die "a move of session $sid is QUEUED (its job is written, its relauncher has not started it yet). Nothing is hung up and --go is not needed yet; wait for the notice. Ask for no second move"
        fi
        die "no move of session $sid is waiting for --go (nothing under $MOVE_TO_HOLD); run \`agentbox move --to <machine>\` first"
    fi
    target="$(sed -n 's/^target=//p' "$f")"
    local relauncher age
    relauncher="$(sed -n 's/^pid=//p' "$f")"
    # The relauncher must still be there to do the hang-up: when it is gone, nothing moves this
    # session and nothing hangs it up, and the session must know at once rather than wait (a
    # relauncher started from a box died in the queue twice on 2026-11-03, LANE-E). The test is
    # the hold file's own heartbeat, which the relauncher touches every poll: a boxed session
    # cannot see the host's pids (`kill -0` there called every live relauncher gone, 03:38Z
    # 2026-11-04) and a SIGSTOPped relauncher passes `kill -0` while it does nothing.
    age=$(( $(date +%s) - $(stat -c %Y "$f" 2>/dev/null || echo 0) ))
    rm -f "$f"
    if (( age > MOVE_TO_HOLD_STALE )); then
        die "the relauncher of this move (pid ${relauncher:-unknown}) has not touched its hold for ${age}s, so it is gone or stopped: --go hangs nothing up and this session stays here. Nothing was hung up; ask for the move again: agentbox move --to ${target:-<machine>}"
    fi
    echo "agentbox: --go: the move to ${target:-the target} hangs this session up within seconds and resumes it there. End your turn now."
}
# move_to_in_flight GROUP: the other groups with a live relauncher's active claim, space-separated.
move_to_in_flight() {
    local f pid job g
    local -A groups=()
    for f in "$MOVE_TO_ACTIVE"/*; do
        [[ -f "$f" ]] || continue
        pid="$(sed -n 's/^pid=//p' "$f" 2>/dev/null)"
        job="$(sed -n 's/^job=//p' "$f" 2>/dev/null)"
        [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null || continue
        g="${job##*/}"
        g="${g%%-2[0-9][0-9][0-9][0-9][0-9][0-9][0-9]T*}"
        [[ -n "$g" && "$g" != "$1" ]] && groups[$g]=1
    done
    printf '%s ' "${!groups[@]}"
}
# move_to_wait_flight GROUP: at most MOVE_TO_MAX_FLIGHT moves in flight from this host (default 2):
# ~35 sessions move themselves at once tonight, and each copy competes for the same disks and
# link. Waits while that many OTHER groups hold active claims with live relaunchers, logging
# each change through `say` (the caller's), and returns when fewer do.
move_to_wait_flight() {
    local group="$1" flight said_flight=""
    while flight="$(move_to_in_flight "$group")" && (( $(wc -w <<<"$flight") >= MOVE_TO_MAX_FLIGHT )); do
        if [[ "$flight" != "$said_flight" ]]; then
            say "waiting: $(wc -w <<<"$flight") moves in flight: $flight"
            said_flight="$flight"
        fi
        MOVE_TO_STATE="waiting for one of the moves in flight ($flight) to end"
        sleep "$MOVE_TO_FLIGHT_POLL"
    done
}

move_to_run() {
    local job="$1" target group n i stamp me reason=""
    MOVE_TO_STATE="reading the job"
    [[ -r "$job" ]] || die "no job file $job"
    target="$(jq -r .to "$job")" group="$(jq -r .group "$job")" n="$(jq '.members | length' "$job")"
    MOVE_TO_TARGET="$target"
    # The caller's ssh command, since the relauncher of a box's move runs under the host's tmux
    # server, whose environment is not the caller's.
    if [[ "$(jq '.ssh | length' "$job")" -gt 0 ]]; then mapfile -t MOVE_TO_SSH < <(jq -r '.ssh[]' "$job"); fi
    me="${AGENTBOX_HOST:-$(hostname -s)}"
    stamp="$(date -u +%Y%m%dT%H%M%SZ)"
    local sids=() pids=() boxes=() panes=() ats=() cwds=() resumes=() windows=() reroots=() there=() from_windows=()
    for ((i = 0; i < n; i++)); do
        sids[i]="$(jq -r ".members[$i].sid" "$job")" pids[i]="$(jq -r ".members[$i].pid" "$job")"
        boxes[i]="$(jq -r ".members[$i].box" "$job")" panes[i]="$(jq -r ".members[$i].pane" "$job")"
        cwds[i]="$(jq -r ".members[$i].cwd" "$job")" resumes[i]="$(jq -r ".members[$i].resume" "$job")"
        ats[i]="$(jq -r ".members[$i].at" "$job")"
        # The window the session had on this machine, as <tmux session>:<window name>: the target
        # keeps it (AGENTBOX_MOVED_FROM_WINDOW, the window's @stream option) and the move log
        # carries it, so a stream's sessions can be counted after the move.
        from_windows[i]="$(jq -r ".members[$i].window // \"\"" "$job")"
        reroots[i]="$(jq -r ".members[$i].reroot // false" "$job")"
        # The transcript as the target names it: the same path, unless it is re-rooted there.
        there[i]="${resumes[i]}"
    done
    mapfile -t MOVE_TO_MIRROR < <(jq -r '.mirror[]' "$job")
    mapfile -t MOVE_TO_MERGE < <(jq -r '.merge[]' "$job")
    # A job may list a SYMLINK and not its target, whatever built it: an offloaded transcript in
    # ~/.omp/agent/sessions points into /mnt/durable, rsync -a copies the link as a link, and the
    # session resumes on the target's older copy (29 of 99 sessions, 2026-11-03/04; the job
    # builder listed only the link). Every link in either list whose target is outside the paths
    # already listed is added beside it, so the bytes travel at the same path on both machines.
    move_to_add_link_targets
    mapfile -t MOVE_TO_EXCLUDE < <(jq -r '.exclude[]' "$job")
    mapfile -t MOVE_TO_MKDIR < <(jq -r '(.mkdir // [])[]' "$job")
    say() { echo "$(date -u +%FT%TZ) move-to $group: $*"; }
    # MOVE_SPEC_FLAGS: the omp's own launch flags (move_omp_flags), NUL-separated through jq since
    # a value may hold a newline; a job written before they were recorded has none.
    member_spec() {
        mapfile -t MOVE_SPEC < <(jq -r ".members[$1].spec[]" "$job")
        mapfile -t -d '' MOVE_SPEC_FLAGS < <(jq -j ".members[$1].flags // [] | map(. + \"\\u0000\") | add // \"\"" "$job")
    }
    member_tmux() {
        local rest
        mapfile -t MOVE_TMUX < <(jq -r ".members[$1].tmux[]" "$job")
        MOVE_TMUX_BIN="$(jq -r ".members[$1].tmux_bin" "$job")"
        # A box's job names no server: the relauncher runs under the host server's run-shell,
        # whose TMUX names it.
        if (( ! ${#MOVE_TMUX[@]} )) && [[ -n "${TMUX:-}" ]]; then
            MOVE_TMUX=(-S "${TMUX%%,*}")
            rest="${TMUX#*,}"
            move_tmux_bin "${rest%%,*}"
        fi
        [[ -n "$MOVE_TMUX_BIN" ]] || MOVE_TMUX_BIN=tmux
    }
    # A member that is DOWN: said in the log, and told at once to the session, to the lead that
    # asked for the move (MOVE_LEAD_SESSION in the job) and to the box-health role. R3A was down
    # 15 min with no alert on 2026-11-03, and its line read "rolled back … resume here".
    move_down() {
        local sid="$1" why="$2" text lead
        text="agentbox: the move of session $sid to $target FAILED and the session is DOWN on $me: $why (An automated notice from agentbox.)"
        say "$sid: DOWN: $why"
        envoy_send_text --source envoy "$sid" "$text" >/dev/null 2>&1 || true
        envoy notify --message-file - notifications.role.lead-box-health <<<"$text" >/dev/null 2>&1 || true
        lead="$(jq -r '.lead // empty' "$job" 2>/dev/null || true)"
        [[ -z "$lead" ]] || envoy_send_text --source envoy "$lead" "$text" >/dev/null 2>&1 || true
    }

    # A move that stops BEFORE the hang-up: every session goes on here, so none is DOWN, but the
    # move did not happen and nobody watches its log. The sessions, the lead that asked for the
    # move and the box-health role are told; before this only the sessions were (2026-11-03).
    move_refused() {
        local why="$1" text lead sid
        shift
        text="agentbox: the move to $target did NOT start and these sessions were not hung up ($*): $why (An automated notice from agentbox.)"
        for sid in "$@"; do envoy_send_text --source envoy "$sid" "$text" >/dev/null 2>&1 || true; done
        envoy notify --message-file - notifications.role.lead-box-health <<<"$text" >/dev/null 2>&1 || true
        lead="$(jq -r '.lead // empty' "$job" 2>/dev/null || true)"
        [[ -z "$lead" ]] || envoy_send_text --source envoy "$lead" "$text" >/dev/null 2>&1 || true
    }

    # Each member back in a box on this machine, in its own pane, or in a window of its own when
    # its pane is gone; none that runs on the target. MOVE_TO_RESUMED holds those that came back.
    MOVE_TO_RESUMED=()
    resume_here() {
        local j inner rc pane_file
        # What each member is told when it is up again here: the move FAILED and it is back on
        # this machine - never "the move is done" (S3, 03:57:58Z 2026-11-04).
        local rolled_back
        rolled_back="agentbox: your move to $target did NOT complete and was ROLLED BACK: this session was resumed in an agent box on $me, the machine it was on before. Go on with your work here; nothing moved. The move log on $target and \`agentbox move --plan --to $target\` say why. (An automated notice from agentbox, not a person.)"
        for j in "$@"; do
            member_spec "$j"
            member_tmux "$j"
            if ! "$MOVE_TMUX_BIN" "${MOVE_TMUX[@]}" display-message -p -t "${panes[j]}" '#{pane_id}' >/dev/null 2>&1; then
                # A pane that closed with its omp: a window of its own on the same tmux session.
                if [[ -n "${ats[j]}" ]] && inner="$(MOVE_PANE_WAKE_NOTICE="$rolled_back" move_pane_command "${sids[j]}" "${resumes[j]}" "${MOVE_SPEC[@]}" -- ${MOVE_SPEC_FLAGS[@]+"${MOVE_SPEC_FLAGS[@]}"})" \
                    && pane_file="$(move_pane_script "${sids[j]}" "$inner; echo; echo 'agentbox: the box has exited; this pane is a shell again'; exec bash -i")" \
                    && "$MOVE_TMUX_BIN" "${MOVE_TMUX[@]}" new-window -d -t "${ats[j]%%:*}:" -n "${sids[j]:0:8}" -c "${cwds[j]}" \
                        bash -i "$pane_file" 2>/dev/null; then
                    say "${sids[j]}: pane ${panes[j]} is gone; resumed here in a new window of tmux session ${ats[j]%%:*}"
                    MOVE_TO_RESUMED+=("${sids[j]}")
                else
                    move_down "${sids[j]}" "pane ${panes[j]} is gone and no window could be opened; resume it by hand: agentbox new ${MOVE_SPEC[*]} -- $(move_omp_line "${resumes[j]}" ${MOVE_SPEC_FLAGS[@]+"${MOVE_SPEC_FLAGS[@]}"})"
                fi
                continue
            fi
            inner="$(MOVE_PANE_WAKE_NOTICE="$rolled_back" move_pane_command "${sids[j]}" "${resumes[j]}" "${MOVE_SPEC[@]}" -- ${MOVE_SPEC_FLAGS[@]+"${MOVE_SPEC_FLAGS[@]}"})"
            move_respawn "${sids[j]}" "${panes[j]}" "${cwds[j]}" "$inner" "${MOVE_SPEC[*]}" && { MOVE_TO_RESUMED+=("${sids[j]}"); continue; }
            rc=$?
            if (( rc == 3 )); then
                move_down "${sids[j]}" "two omp processes hold this session here after the respawn; end the older one by its pid"
                continue
            fi
            # The pane went while the move ran: a window of its own on the same tmux session.
            if (( rc == 2 )) && [[ -n "${ats[j]}" ]] \
                && pane_file="$(move_pane_script "${sids[j]}" "$inner; echo; echo 'agentbox: the box has exited; this pane is a shell again'; exec bash -i")" \
                && "$MOVE_TMUX_BIN" "${MOVE_TMUX[@]}" new-window -d -t "${ats[j]%%:*}:" -n "${sids[j]:0:8}" -c "${cwds[j]}" \
                    bash -i "$pane_file" 2>/dev/null; then
                say "${sids[j]}: pane ${panes[j]} is gone; resumed here in a new window of tmux session ${ats[j]%%:*}"
                MOVE_TO_RESUMED+=("${sids[j]}")
                continue
            fi
            move_down "${sids[j]}" "pane ${panes[j]} would not respawn; resume it by hand: agentbox new ${MOVE_SPEC[*]} -- $(move_omp_line "${resumes[j]}" ${MOVE_SPEC_FLAGS[@]+"${MOVE_SPEC_FLAGS[@]}"})"
        done
    }
    log_all() {
        local result="$1" j lines=() now
        shift
        # One time for every line of the attempt: the halt rule counts an attempt by it.
        now="$(date -u +%FT%TZ)"
        for j in "$@"; do lines+=("$now	${sids[j]}	$group	$me	$target	$result	${there[j]}	${from_windows[j]}"); done
        move_to_log "$target" "${lines[@]}" || true
    }
    local all=()
    for ((i = 0; i < n; i++)); do all+=("$i"); done
    # One relauncher per session, before any check: two `move --to-run` for the librarian ran at
    # once at 17:32-17:34Z on 2026-11-03, because the first had not yet written its claim. The
    # lock is held for this relauncher's life (the fd stays open) and says who holds it.
    # Its own directory, not the claims': move_to_in_flight counts every claim with a live
    # relauncher, and a lock held while this one waits for a slot would count as a move in flight.
    mkdir -p "$MOVE_TO_LOCKS"
    local lock fd holder
    for ((i = 0; i < n; i++)); do
        lock="$MOVE_TO_LOCKS/${sids[i]}.lock"
        exec {fd}>>"$lock" || die "cannot open $lock, the one-relauncher-per-session lock; nothing was hung up"
        if ! flock -n "$fd"; then
            # A relauncher's children (rsync, ssh) inherit the open file and hold its lock after
            # it is killed, so a dead relauncher's lock can outlive it: six moves were refused by
            # locks whose pid was gone (00:37-00:40Z, 2026-11-03). The pid in the file decides.
            holder="$(sed -n 's/^pid=//p' "$lock" | tail -1)"
            if [[ -n "$holder" ]] && kill -0 "$holder" 2>/dev/null; then
                die "another move of ${sids[i]} runs (pid $holder); nothing was hung up"
            fi
            say "the lock of ${sids[i]} was left by pid ${holder:-unknown}, which is gone; taking it"
            exec {fd}>&-
            rm -f "$lock"
            exec {fd}>>"$lock" || die "cannot open $lock, the one-relauncher-per-session lock; nothing was hung up"
            flock -n "$fd" || die "another move of ${sids[i]} took its lock just now; nothing was hung up"
        fi
        : >"$lock"
        printf 'pid=%s\njob=%s\n' "$BASHPID" "$job" >&"$fd"
        MOVE_TO_LOCK_FDS+=("$fd")
    done
    say "job $job: ${sids[*]} to $target"
    # The active files, and the one exit path that removes them (the EXIT trap of cmd_move, which
    # also clears the transcript index, runs this too). A signal says where it stopped.
    # Globals, since the EXIT trap runs after this function's locals are gone.
    MOVE_TO_ACTIVE_SIDS=("${sids[@]}")
    # Only this relauncher's own claims: a claim another relauncher wrote stays (2026-11-03).
    move_to_active_clear() {
        local s who
        for s in ${MOVE_TO_ACTIVE_SIDS[@]+"${MOVE_TO_ACTIVE_SIDS[@]}"}; do
            who="$(sed -n 's/^pid=//p' "$MOVE_TO_ACTIVE/$s" 2>/dev/null | head -1)"
            [[ -z "$who" || "$who" == "$BASHPID" ]] && rm -f "$MOVE_TO_ACTIVE/$s"
            rm -f "$MOVE_TO_HOLD/$s"
        done
    }
    move_to_run_exit() {
        move_to_rsync_tick_stop
        [[ -z "$MOVE_TO_RSYNC_ERR" ]] || rm -f "$MOVE_TO_RSYNC_ERR"
        move_to_active_clear
        move_exit
    }
    move_to_run_signal() {
        if (( MOVE_TO_COMMITTED )); then
            say "signal $1 while the sessions are hung up (state: $MOVE_TO_STATE); NOT stopping: the move finishes or rolls the group back, or they stay down on both machines" >&2
            return 0
        fi
        [[ -z "$MOVE_TO_CHILD" ]] || kill -TERM "$MOVE_TO_CHILD" 2>/dev/null || true
        # Its progress subshell too, before the line below says the relauncher is gone: a
        # progress notice it is sending ends first, and none comes after that line.
        move_to_rsync_tick_stop
        # A hold this relauncher wrote is withdrawn, and each session told: the "ready, run --go"
        # notice is already with them, and a `--go` against a hold nobody holds hangs nothing up
        # while the session waits for a move that is gone (pivot, S4, KNOTCURVE, SPEEDCOACH and
        # FDBK, 2026-11-04).
        local held=0 s2
        for s2 in ${MOVE_TO_ACTIVE_SIDS[@]+"${MOVE_TO_ACTIVE_SIDS[@]}"}; do
            [[ -e "$MOVE_TO_HOLD/$s2" ]] || continue
            rm -f "$MOVE_TO_HOLD/$s2"
            held=1
            envoy_send_text --source envoy "$s2" "agentbox: the move to ${MOVE_TO_TARGET:-the target} was STOPPED while it waited for your \`agentbox move --go\`. The hold is withdrawn: do NOT run --go, nothing will hang you up, and this session stays here. Ask for the move again when you want it. (An automated notice from agentbox.)" >/dev/null 2>&1 || true
        done
        (( held == 0 )) || say "the hold was withdrawn and every member told (stopped by signal $1)"
        # To stderr: a signal can come while stdout is redirected (an rsync's --stats file).
        # ${MOVE_TO_TARGET:-} and not $target: a signal can arrive while this shell is outside
        # move_to_run's own scope (it waits in the flight queue, or the relauncher has returned),
        # where set -u makes the local `target` unbound and the handler dies with "target: unbound
        # variable" instead of saying where it stopped (R3A, 01:39Z 2026-11-04).
        say "stopped by signal $1; state: $MOVE_TO_STATE. The relauncher is gone: check each session (${MOVE_TO_ACTIVE_SIDS[*]-}) - it may be down here, or on ${MOVE_TO_TARGET:-the target} with its marker here" >&2
        exit "$2"
    }
    trap move_to_run_exit EXIT
    # After the hang-up the sessions are DOWN until this relauncher puts them somewhere, so from
    # that moment a signal must not end it where it stands: one stopped mid-start at 03:06:44Z on
    # 2026-11-04 and left its session down on both machines. The handler then only says so and
    # lets the phase finish (it ends by itself: every step after the hang-up is bounded).
    trap 'move_to_run_signal TERM 143' TERM
    trap 'move_to_run_signal INT 130' INT
    trap 'move_to_run_signal HUP 129' HUP
    # The ready files are spent: a member that comes back here starts its next move afresh.
    for ((i = 0; i < n; i++)); do rm -f "$MOVE_TO_JOBS/ready/${sids[i]}"; done
    move_to_wait_flight "$group"
    MOVE_TO_STATE="checking $target"
    if ! move_to_preflight "$target" "${sids[@]}" || ! move_to_cwds_present "$target" "${cwds[@]}" \
        || ! move_to_dests_writable "$target" || ! move_to_target_worktrees "$target"; then
        say "refused, nothing was hung up: $MOVE_TO_WHY"
        move_refused "$MOVE_TO_WHY" "${sids[@]}"
        return 2
    fi
    # From here the members' moves are in flight: a restarter that reads these leaves them alone.
    mkdir -p "$MOVE_TO_ACTIVE"
    for ((i = 0; i < n; i++)); do
        printf 'pid=%s\ntarget=%s\nstart=%s\njob=%s\n' "$BASHPID" "$target" "$(date +%s)" "$job" >"$MOVE_TO_ACTIVE/${sids[i]}"
    done
    # Clone a repository the target lacks BEFORE the hang-up: the object store is the big part of
    # a tree, and once the clone is there git sends only what the target misses. Then push every
    # native tree's other branches, also before: after the hang-up only HEAD goes.
    # Another session's transcript in this session's directory is never copied over or deleted.
    move_to_exclude_other_sessions "${sids[@]}"
    MOVE_TO_STATE="cloning on $target, before the hang-up"
    MOVE_TO_WHY=""
    if ! move_to_clone_missing "$target" say; then
        say "refused, nothing was hung up: $MOVE_TO_WHY"
        move_refused "$MOVE_TO_WHY" "${sids[@]}"
        return 2
    fi
    move_to_git_native_plan "$target"
    (( ${#MOVE_TO_NATIVE[@]} )) && say "through git: $(printf '%s ' "${MOVE_TO_NATIVE[@]%%$'\t'*}")"
    MOVE_TO_STATE="pushing branches to $target, before the hang-up"
    move_to_git_native_prepush "$target" say
    # Each native tree's HEAD and its registration, and a first pass of the copy, all BEFORE the
    # hang-up: after it only what changed goes (LINUX-1248's first copy was 3.69 GB in 178,633
    # files, 760 s of its downtime at load 279). A failure here refuses the move while the
    # sessions still run.
    MOVE_TO_STATE="copying to $target, before the hang-up"
    MOVE_TO_WHY=""
    if ! move_to_git_native_push "$target" || ! move_to_copy "$target" "$stamp-before" "before the hang-up"; then
        [[ -n "$MOVE_TO_WHY" ]] || MOVE_TO_WHY="the first copy to $target failed (above)"
        say "refused, nothing was hung up: $MOVE_TO_WHY"
        move_refused "$MOVE_TO_WHY" "${sids[@]}"
        return 2
    fi
    # One more pass right before the hold, and another the moment `--go` arrives, both while the
    # sessions still work: the first copy of a big tree is hours old by the hang-up (the
    # librarian's mirror ran 15:10-16:18Z and still had 9.3 GB to send at 18:4xZ, 2026-11-03).
    # Each is a delta of the one before it, so it costs a walk, not a copy.
    MOVE_TO_STATE="copying what changed, before the hold"
    if ! move_to_copy "$target" "$stamp-hold" "before the hold"; then
        MOVE_TO_WHY="the copy before the hold failed (above)"
        say "refused, nothing was hung up: $MOVE_TO_WHY"
        move_refused "$MOVE_TO_WHY" "${sids[@]}"
        return 2
    fi
    MOVE_TO_STATE="holding before the hang-up (agentbox move --go)"
    if ! move_to_hold "$target" "${sids[@]}"; then
        say "refused, nothing was hung up: $MOVE_TO_WHY"
        move_refused "$MOVE_TO_WHY" "${sids[@]}"
        return 2
    fi
    # A path the session removed while the move held for its `--go` is dropped here, not after the
    # hang-up: the librarian removed its worktree ~/src/legion-turnfix during the hold, and the
    # native push then failed AFTER the hang-up and rolled the group back (17:27:06Z, 2026-11-03).
    move_to_drop_gone
    MOVE_TO_STATE="copying what changed, after the go and before the hang-up"
    if ! move_to_copy "$target" "$stamp-go" "at the go"; then
        MOVE_TO_WHY="the copy after the go failed (above)"
        say "refused, nothing was hung up: $MOVE_TO_WHY"
        move_refused "$MOVE_TO_WHY" "${sids[@]}"
        return 2
    fi
    MOVE_TO_STATE="hanging up ${sids[*]}"
    MOVE_TO_COMMITTED=1
    # 1. The hang-up, of every member, before anything is copied.
    local down=() alive=() waited
    for ((i = 0; i < n; i++)); do
        waited=0
        if [[ -n "${boxes[i]}" ]]; then
            box_reclaim "${boxes[i]}"
            docker kill -s SIGHUP "${boxes[i]}" >/dev/null 2>&1 || true
            while (( waited < MOVE_TO_HANGUP_WAIT )) && docker inspect "${boxes[i]}" >/dev/null 2>&1; do sleep 1; waited=$((waited + 1)); done
            if docker inspect "${boxes[i]}" >/dev/null 2>&1; then alive+=("$i"); else down+=("$i"); fi
        else
            # The job's recorded pid is only a hint: R3A's job held 3161136 while the session had
            # been resumed as 3150562, so the hang-up killed nothing, the move went on, and two
            # copies of the session ran for four minutes (01:37-01:44Z, 2026-11-04). What is hung
            # up is the omp that runs THIS session now.
            local live_pid
            live_pid="$("$DOTFILES_DIR/scripts/omp-session-live" "${sids[i]}" 2>/dev/null | cut -f1 | head -1 || true)"
            if [[ -n "$live_pid" && "$live_pid" != "${pids[i]}" ]]; then
                say "${sids[i]}: the job named pid ${pids[i]}, which is not its omp; its live omp is $live_pid"
                pids[i]="$live_pid"
            fi
            if [[ -z "$live_pid" && "$(cat "$PROC/${pids[i]}/comm" 2>/dev/null || true)" != omp ]]; then
                reason="failed: ${sids[i]} has no live omp here (the job named pid ${pids[i]}); nothing was hung up"
                say "$reason"
                log_all "$reason" "${all[@]}"
                return 1
            fi
            if [[ "$(cat "$PROC/${pids[i]}/comm" 2>/dev/null || true)" == omp ]]; then kill -HUP "${pids[i]}" 2>/dev/null || true; fi
            while (( waited < MOVE_TO_HANGUP_WAIT )) && kill -0 "${pids[i]}" 2>/dev/null; do sleep 1; waited=$((waited + 1)); done
            if kill -0 "${pids[i]}" 2>/dev/null; then alive+=("$i"); else down+=("$i"); fi
        fi
        say "${sids[i]}: hung up after ${waited}s (${boxes[i]:-pid ${pids[i]}})"
    done
    if (( ${#alive[@]} )); then
        reason="failed: $(for i in "${alive[@]}"; do printf '%s ' "${sids[i]}"; done)did not exit within ${MOVE_TO_HANGUP_WAIT}s of the hang-up"
        say "$reason; the others resume here"
        resume_here ${down[@]+"${down[@]}"}
        log_all "$reason" "${all[@]}"
        return 1
    fi
    # 2. The copy (git trees the target has a clone of go through git, HEAD only now). 3. The
    # markers. 4. The windows. Any failure rolls the whole group back.
    MOVE_TO_STATE="copying to $target (the sessions are hung up)"
    say "copying ${#MOVE_TO_MIRROR[@]} mirrored and ${#MOVE_TO_MERGE[@]} merged path(s)"
    if ! move_to_git_native_push "$target"; then
        reason="failed: $MOVE_TO_WHY"
    elif ! move_to_copy "$target" "$stamp" "after the hang-up"; then
        reason="failed: the copy to $target"
    elif ! move_to_git_native_finish "$target"; then
        reason="failed: $MOVE_TO_WHY"
    else
        # --cwd: the transcript moves to that directory's bucket on the target (move_to_reroot).
        local moved_to
        for ((i = 0; i < n; i++)); do
            [[ "${reroots[i]}" == true ]] || continue
            if moved_to="$(move_to_reroot "$target" "${resumes[i]}" "${cwds[i]}")" && [[ "$moved_to" == /*.jsonl ]]; then
                there[i]="$moved_to"
                say "${sids[i]}: its transcript is re-rooted in ${cwds[i]} on $target: $moved_to"
            else
                reason="failed: the transcript of ${sids[i]} could not be re-rooted in ${cwds[i]} on $target: $moved_to"
                break
            fi
        done
    fi
    if [[ -z "$reason" ]]; then
        for ((i = 0; i < n; i++)); do
            move_to_mark "${sids[i]}" "${resumes[i]}" "$target" "${there[i]}" || { reason="failed: the marker of ${sids[i]} could not be written"; break; }
        done
    fi
    # The working directory must be on the target once the copy is done: a box cannot start
    # without its first --dir, and --drop-gone-dirs never drops that one. A working directory
    # the move does not copy (one every box has, or a root of many trees) must already be there.
    if [[ -z "$reason" ]]; then
        for ((i = 0; i < n; i++)); do
            if ! move_remote "$target" "test -d $(printf '%q' "${cwds[i]}")" </dev/null >/dev/null 2>&1; then
                reason="failed: the working directory ${cwds[i]} of ${sids[i]} is not on $target"
                break
            fi
        done
    fi
    # Nothing starts on the target until every member's transcript there is byte for byte this
    # machine's. The omp has exited (the hang-up waited for its pid), so the file is final here.
    if [[ -z "$reason" ]]; then
        MOVE_TO_STATE="checking each transcript on $target"
        if ! move_to_settle_transcripts "${there[@]}"; then
            reason="failed: $MOVE_TO_WHY"
            say "$reason; nothing was started on $target"
        fi
    fi
    if [[ -z "$reason" ]]; then
        MOVE_TO_STATE="starting the sessions on $target"
        for ((i = 0; i < n; i++)); do
            member_spec "$i"
            MOVE_TO_FROM_WINDOW="${from_windows[i]}"
            if ! windows[i]="$(move_to_start "$target" "${sids[i]}" "${cwds[i]}" "${there[i]}" "${MOVE_SPEC[@]}" -- ${MOVE_SPEC_FLAGS[@]+"${MOVE_SPEC_FLAGS[@]}"})" || [[ -z "${windows[i]}" ]]; then
                reason="failed: no tmux window for ${sids[i]} on $target"
                break
            fi
            say "${sids[i]}: started in window ${windows[i]} of tmux session $MOVE_TO_TMUX_SESSION on $target"
        done
    fi
    if [[ -z "$reason" ]] && ! move_to_settled "$target" "${there[@]}"; then
        # A box start that failed is tried ONCE more: the target's container runtime refuses a
        # start under load and the next one succeeds ("sysbox-fs: failed to pre-register container
        # ... DeadlineExceeded", PIPE at 01:1xZ 2026-11-04, which left the session down on both
        # machines). Its window and its launcher go first, so no session is ever started twice.
        local again=()
        for ((i = 0; i < n; i++)); do [[ -n "${MOVE_TO_OK[${there[i]}]:-}" ]] || again+=("$i"); done
        if (( ${#again[@]} )); then
            say "no session started on $target for: $(for i in "${again[@]}"; do printf '%s ' "${sids[i]}"; done); trying each once more in ${MOVE_TO_RETRY_WAIT}s"
            for i in "${again[@]}"; do
                [[ -z "${windows[i]}" ]] || move_remote "$target" "tmux kill-window -t $(printf '%q' "${windows[i]}") 2>/dev/null || true" </dev/null || true
                move_to_cancel_start "$target" "${sids[i]}" || say "${sids[i]}: $MOVE_TO_WHY"
            done
            sleep "$MOVE_TO_RETRY_WAIT"
            local retried=()
            for i in "${again[@]}"; do
                member_spec "$i"
                MOVE_TO_FROM_WINDOW="${from_windows[i]}"
                if windows[i]="$(move_to_start "$target" "${sids[i]}" "${cwds[i]}" "${there[i]}" "${MOVE_SPEC[@]}" -- ${MOVE_SPEC_FLAGS[@]+"${MOVE_SPEC_FLAGS[@]}"})" && [[ -n "${windows[i]}" ]]; then
                    say "${sids[i]}: started again in window ${windows[i]} on $target"
                    retried+=("${there[i]}")
                else
                    say "${sids[i]}: no second window on $target either"
                fi
            done
            (( ${#retried[@]} == 0 )) || move_to_settled "$target" "${retried[@]}" || true
        fi
        for ((i = 0; i < n; i++)); do
            [[ -n "${MOVE_TO_OK[${there[i]}]:-}" ]] && continue
            reason="failed: not resumed on $target within ${MOVE_TO_START_WAIT}s, twice:"
            break
        done
        if [[ -n "$reason" ]]; then
            for ((i = 0; i < n; i++)); do [[ -n "${MOVE_TO_OK[${there[i]}]:-}" ]] || reason+=" ${sids[i]}"; done
        fi
    fi
    if [[ -z "$reason" ]]; then
        # Exactly one omp per session on the TARGET too, not just none here.
        local twice=() t_running
        t_running="$(move_to_running "$target" "${sids[@]}")" || t_running=""
        for ((i = 0; i < n; i++)); do
            (( $(grep -c "^${sids[i]}	" <<<"$t_running") <= 1 )) || twice+=("${sids[i]}")
        done
        if (( ${#twice[@]} )); then
            say "more than one omp holds ${twice[*]} on $target; moves are halted"
            log_all "both-machines" "${all[@]}"
            return 1
        fi
        local both
        both="$(move_to_running "" "${sids[@]}")"
        if [[ -n "$both" ]]; then
            say "found running here too, after the move: $(tr '\t\n' ' ;' <<<"$both")moves are halted, and nothing more is done to the group"
            log_all "both-machines" "${all[@]}"
            return 1
        fi
        for ((i = 0; i < n; i++)); do move_to_stop_services "${sids[i]}"; done
        log_all moved "${all[@]}"
        for ((i = 0; i < n; i++)); do
            member_tmux "$i"
            "$MOVE_TMUX_BIN" "${MOVE_TMUX[@]}" respawn-pane -k -t "${panes[i]}" -c "${cwds[i]}" bash -i -c \
                "echo 'agentbox: session ${sids[i]} moved to $target at $(date -u +%FT%TZ); it runs there in tmux session $MOVE_TO_TMUX_SESSION, window ${sids[i]:0:8} (${windows[i]}). This pane is a shell.'; exec bash -i" \
                2>/dev/null || true
        done
        MOVE_TO_COMMITTED=0
        say "moved: ${sids[*]}"
        return 0
    fi
    # The rollback. The target's windows close, and nothing of the group may still run there
    # before a member resumes here.
    say "$reason; rolling the group back"
    MOVE_TO_RESUMED=()
    MOVE_TO_STATE="rolling back to this machine ($reason)"
    local w left
    for w in ${windows[@]+"${windows[@]}"}; do
        [[ -n "$w" ]] && move_remote "$target" "tmux kill-window -t $(printf '%q' "$w") 2>/dev/null || true" </dev/null || true
    done
    if ! move_to_cancel_start "$target" "${sids[@]}"; then
        say "$MOVE_TO_WHY; the group is NOT resumed here, since $target may still start it"
        log_all "both-machines" "${all[@]}"
        for ((i = 0; i < n; i++)); do move_down "${sids[i]}" "$MOVE_TO_WHY"; done
        return 1
    fi
    waited=0
    left="$(move_to_running "$target" "${sids[@]}")" || left="unknown"
    while [[ -n "$left" ]] && (( waited < MOVE_TO_HANGUP_WAIT )); do
        sleep "$MOVE_TO_POLL"
        waited=$((waited + MOVE_TO_POLL))
        left="$(move_to_running "$target" "${sids[@]}")" || left="unknown"
    done
    if [[ -n "$left" ]]; then
        say "still running on $target after ${waited}s, so not resumed here: $(tr '\t\n' ' ;' <<<"$left")"
        log_all "both-machines" "${all[@]}"
        return 1
    fi
    for ((i = 0; i < n; i++)); do move_to_unmark "${sids[i]}" "${resumes[i]}"; done
    resume_here "${all[@]}"
    local back=() down=() j
    for ((j = 0; j < n; j++)); do
        if [[ " ${MOVE_TO_RESUMED[*]-} " == *" ${sids[j]} "* ]]; then back+=("$j"); else down+=("$j"); fi
    done
    # The group is somewhere again (here, or named DOWN with its owner told), so a signal may
    # stop this relauncher once more.
    MOVE_TO_COMMITTED=0
    (( ${#back[@]} == 0 )) || { log_all "$reason" "${back[@]}"; say "rolled back: $(for j in "${back[@]}"; do printf '%s ' "${sids[j]}"; done)resume here"; }
    (( ${#down[@]} == 0 )) || { log_all "DOWN after $reason" "${down[@]}"; say "NOT rolled back, DOWN: $(for j in "${down[@]}"; do printf '%s ' "${sids[j]}"; done)"; }
    return 1
}

# `move --plan --to <machine> [--group <session> | --all]`: what a move to the machine would copy
# for one group and how big that is here - by default the caller's own group (the question a
# session asks before it moves), found as `move --to` finds it (move_to_find_group: 56 s for a
# group of 14 at load 300), else the group of the session --group names, or with --all every
# group of the host, which needs every session's paths (more than two minutes at load 600). It
# changes nothing: no plan file, no ready file, no notice, no call to the target. Only the
# MIRRORED paths are measured - the trees and transcripts a move sends whole - each at most
# MOVE_TO_SIZE_WAIT seconds, MOVE_RECORD_JOBS at once. The merged paths (git storage, caches,
# lane roots) are listed unmeasured: rsync sends only what is newer than the target's copy, so
# their size here says nothing about the move, and measuring them (frac-verify, gate-runs, whole
# object stores) kept the plan of 2026-11-02 running past 50 minutes.
MOVE_TO_SIZE_WAIT="${AGENTBOX_MOVE_SIZE_WAIT:-30}"
cmd_move_plan_to() {
    local target="$1" mode="$2" who="${3:-}"
    # In a box, the plan is this session's own: the box sees only its own processes, and its omp's
    # parent there is agentbox-run.ts, which the host census reads as "no pane" (GRADE, boxed with
    # `move --self`, 2026-11-03 13:30Z). move_to_in_box plans exactly what a move from the box
    # would carry, and changes nothing.
    if [[ -n "${AGENTBOX_BOX:-}" || -e "$AGENTBOX_IDENTITY_FILE" ]]; then
        [[ "$mode" != group ]] || die "in a box, \`move --plan --to\` plans this session only; --group is for a host session"
        [[ "$mode" != all ]] || die "in a box, \`move --plan --to\` plans this session only; --all is for a host session, where it reads every session"
        move_to_in_box "$target" true
        return $?
    fi
    local s g m err p x size total=0 refused=0 bytes i line order=() hits=()
    move_to_index_transcripts
    local -A done_=() sizes=()
    local g_name=() g_text=() g_mirror=() g_merge=() g_exclude=() paths=()
    if [[ "$mode" == all ]]; then
        echo "agentbox move --plan --to $target --all: reading every live session of this host; progress on stderr" >&2
        move_to_census_paths
        mapfile -t order < <(printf '%s\n' "${!MT_ROW[@]}" | sort)
    else
        [[ -n "$who" ]] || die "no session to plan: run it from a session's bash tool (its OMP_SESSION_ID), or name one with --group <session>, or plan every group with --all"
        echo "agentbox move --plan --to $target: reading this host's sessions' processes to find the group of $who" >&2
        move_to_scan_processes
        mapfile -t hits < <(printf '%s\n' "${!MT_ROW_OF[@]}" | awk -v t="$who" 'index($0, t) == 1')
        (( ${#hits[@]} == 1 )) || die "$(if (( ${#hits[@]} )); then echo "$who names ${#hits[@]} live sessions; give more of the id"; else echo "no live host session here matches $who (agentbox move --plan lists them)"; fi)"
        order=("${hits[0]}")
    fi
    for s in "${order[@]}"; do
        [[ -z "${done_[$s]:-}" ]] || continue
        move_to_find_group "$s"
        for m in "${MOVE_TO_GROUP[@]}"; do done_[$m]=1; done
        g="g-$(printf '%s\n' "${MOVE_TO_GROUP[@]}" | sort | head -1 | cut -c1-8)"
        echo "agentbox: $(date -u +%T) group $g, ${#MOVE_TO_GROUP[@]} session(s)" >&2
        local text="group $g: ${#MOVE_TO_GROUP[@]} session(s)" copy="" class pid sid pane at cwd detail
        for m in "${MOVE_TO_GROUP[@]}"; do
            IFS="$SEP" read -r class pid sid pane at cwd detail <<<"${MT_ROW[$m]}"
            err="$(mktemp)"
            if p="$(move_to_member "$m" "$target" 2>"$err")"; then
                text+=$'\n'"  $m  pane $pane ($at)  cwd $cwd"
                local orphans
                orphans="$(move_orphans "$pid")"
                [[ -z "$orphans" ]] || text+=$'\n'"    DIES WITH THE MOVE (not a unit; the move refuses without --accept-orphans): $(move_orphans_list "$orphans")"
                text+=$'\n'"    resume on $target: $(jq -r --arg t "$MOVE_TO_AGENTBOX" '"\($t) new \(.spec | join(" ")) -- omp \((.flags // []) | map(@sh + " ") | add // "")--resume \(.resume)"' <<<"$p")"
                copy+="$(move_to_transcript_paths "$(jq -r .resume <<<"$p")")"$'\n'
            else
                refused=$((refused + 1))
                text+=$'\n'"  $m  REFUSED: $(<"$err")"
            fi
            rm -f "$err"
            copy+="${MT_COPY[$m]}"$'\n'
        done
        move_to_copy_lists <<<"$copy"
        (( ${#MOVE_TO_MKDIR[@]} == 0 )) || text+=$'\n'"    made EMPTY on $target (it holds other trees; only the paths below are copied into it): ${MOVE_TO_MKDIR[*]}"
        g_name+=("$g")
        g_text+=("$text")
        g_mirror+=("$(printf '%s\n' ${MOVE_TO_MIRROR[@]+"${MOVE_TO_MIRROR[@]}"})")
        g_merge+=("$(printf '%s\n' ${MOVE_TO_MERGE[@]+"${MOVE_TO_MERGE[@]}"})")
        g_exclude+=("$(printf '%s\n' ${MOVE_TO_EXCLUDE[@]+"${MOVE_TO_EXCLUDE[@]}"})")
        paths+=(${MOVE_TO_MIRROR[@]+"${MOVE_TO_MIRROR[@]}"} ${MOVE_TO_EXCLUDE[@]+"${MOVE_TO_EXCLUDE[@]}"})
    done
    mapfile -t paths < <(printf '%s\n' ${paths[@]+"${paths[@]}"} | sort -u | sed '/^$/d')
    echo "agentbox: ${#g_name[@]} group(s); measuring the ${#paths[@]} mirrored path(s), $MOVE_RECORD_JOBS at a time, ${MOVE_TO_SIZE_WAIT}s each at most" >&2
    while IFS=$'\t' read -r size p; do
        [[ -n "$p" ]] && sizes[$p]="$size"
    done < <(printf '%s\0' ${paths[@]+"${paths[@]}"} \
        | xargs -0 -r -P "$MOVE_RECORD_JOBS" -n 1 timeout "$MOVE_TO_SIZE_WAIT" du -sB1 2>/dev/null || true)
    echo "agentbox move --plan --to $target: $(hostname -s), $(date -u +%FT%TZ); nothing is changed, copied or sent"
    for ((i = 0; i < ${#g_name[@]}; i++)); do
        echo
        printf '%s\n' "${g_text[i]}"
        bytes=0
        echo "    mirrored (deletions too):"
        while IFS= read -r p; do
            [[ -n "$p" ]] || continue
            if [[ -z "${sizes[$p]:-}" ]]; then
                printf '      %8s  %s\n' "?" "$p (not measured within ${MOVE_TO_SIZE_WAIT}s)"
                continue
            fi
            size="${sizes[$p]}"
            # A tree's own .git is merged instead.
            while IFS= read -r x; do
                [[ -n "$x" ]] && move_within "$x" "$p" && size=$((size - ${sizes[$x]:-0}))
            done <<<"${g_exclude[i]}"
            bytes=$((bytes + size))
            printf '      %8s  %s\n' "$(numfmt --to=iec "$size")" "$p"
        done <<<"${g_mirror[i]}"
        echo "    merged (only what is newer than on $target is sent; not measured):"
        while IFS= read -r p; do
            [[ -n "$p" ]] && printf '      %8s  %s\n' "-" "$p"
        done <<<"${g_merge[i]}"
        echo "    mirrored total: $(numfmt --to=iec "$bytes") (sizes here; rsync sends only what $target lacks)"
        total=$((total + bytes))
    done
    echo
    echo "${#g_name[@]} group(s), ${#MT_ROW[@]} session(s), $refused refused; $(numfmt --to=iec "$total") in all"
    echo "a session moves with its group: each runs \`agentbox move --to $target\` at its own safe point, and the last one moves them all"
    # Its own index goes with it: a plan changes nothing and leaves nothing.
    [[ -z "$MOVE_DEEP_INDEX_DIR" ]] || rm -rf "$MOVE_DEEP_INDEX_DIR"
    MOVE_DEEP_INDEX_DIR=""
}

# One usage text for every form of `move`, so no refusal prints a stale one (`move --help` and
# `move --plan --self` both printed a line naming neither --plan nor --self before this).
MOVE_USAGE='usage:
  agentbox move --plan [--json]                     every live host session, the box it would get,
                                                    each path that box gets and why, and the disk
  agentbox move --self [--dry-run] [--force-floor] [--accept-orphans] [--dir PATH]… [--only-dirs]
                                                    run by the session in its own pane: relaunch
                                                    this pane into a box, resuming this session;
                                                    each --dir adds a path the inference missed.
                                                    In a box the new box also gets the --dir
                                                    paths this box has; --only-dirs makes the named
                                                    paths the whole list, dropping an inherited
                                                    bind
  agentbox move <session-id>… | --all [--now] [--dry-run] [--force-floor] [--accept-orphans]
                                                    ask each session over Envoy to move itself
                                                    (--now relaunches its pane from outside)
  agentbox move <session-id> [--now] [--dry-run] [--dir PATH]…
                                                    the same for one session, each --dir adding a
                                                    path the inference missed
  agentbox move --plan --to <machine> [--group <session> | --all]
                                                    what a move to <machine> would copy for the
                                                    group of this session (the sessions that work
                                                    in its git trees) and the size; --group plans
                                                    the group of another session, --all every
                                                    group; changes nothing
  agentbox move --to <machine> [--dry-run] [--accept-orphans] [--dir PATH]… [--only-dirs]
                     [--cwd PATH] [--leave PATH]…  (--cwd: resume there; --leave: a tree this
                                                    session no longer works in, so it neither
                                                    copies it nor groups with its users)
                                                    run by the session in its own pane at its safe
                                                    point: its group moves to <machine> over
                                                    Tailscale SSH and resumes there in boxes, with
                                                    the same ids (the last of the group to run it
                                                    moves them all)
  agentbox move --run-queue                        start the moves a box queued for this host
  agentbox move --go                               run by a session whose move to another machine is
                                                    holding before the hang-up: hang up now
  agentbox move --to <machine> --clear-halt        the box-health lead lets moves to <machine> go
                                                    on after a halt (two failed moves in a row, or
                                                    a session found running on both machines)
Every move refuses before the hang-up while the session has a process that is not a systemd unit
and would die with it (a server, a watcher, a dashboard started from a tool call); the plans list
them. Make each a unit, stop it, or pass --accept-orphans.
More than one `move --plan` may run at once: it writes only this host'"'"'s plan files, one per
session, each renamed into place.'

cmd_move() {
    trap move_exit EXIT
    set_disk_bytes "the default disk limit"
    case "${1:-}" in
        --plan) shift; cmd_move_plan "$@" ;;
        --self) shift; cmd_move_self "$@" ;;
        # A `move --to` never ends without saying why: an exit that is not 0 and that no refusal
        # (die) explained says so (LINUX-1248's dry run, 2026-11-03, ended after 16 s with only its
        # first progress line, from a pipeline whose last loop test failed under `set -e`).
        --to) MOVE_FORM=--to; cmd_move_to "$@" ;;
        --to-run) shift; move_to_run "$@" ;;
        --run-queue) shift; move_to_run_queue "$@" ;;
        --go) shift; cmd_move_go "$@" ;;
        --relaunch) shift; move_relaunch "$@" ;;
        --wake) shift; move_wake "$@" ;;
        -h|--help|help) echo "$MOVE_USAGE" ;;
        "") die "$MOVE_USAGE" ;;
        *) cmd_move_notify "$@" ;;
    esac
}

FAILS=0
ok() { echo "ok   $*"; }
fail() { echo "FAIL $*"; FAILS=$((FAILS + 1)); }

# The checks whose answer is a property of THIS MACHINE's logins and not of the box: the
# agent-tier store, the Docker Hub helper that reads it, the instance role, Hawk and Google.
# One definition, run on both sides, because a box can only be as logged in as the host under
# it: doctor calls a difference a box defect and says so, and where neither side answers it
# names the missing host login instead of a FAIL a session would read as its own box being
# broken (sami-rocqperf, 2026-10-31: no GHCR_PULL_TOKEN or DOCKER_HUB_OAT in any agent-tier
# file, no EC2 instance role, and no route to the Hawk gateway - every one of them a fact
# about the machine). Each probe prints its own detail and exits non-zero when it cannot
# answer. The single quotes are the point: everything expands where it runs.
# shellcheck disable=SC2016
PROBE_FUNCS='
probe_secrets() {
    n="$(secrets GHCR_PULL_TOKEN -- sh -c "echo \${#GHCR_PULL_TOKEN}" 2>&1 | tail -1)"
    case "${n:-x}" in *[!0-9]*) echo "$n"; return 1;; esac
    [ "$n" -gt 0 ] || { echo "GHCR_PULL_TOKEN is empty"; return 1; }
    echo "GHCR_PULL_TOKEN, $n bytes"
}
probe_dockerhub() {
    local root="${DOTFILES_DIR:-$HOME/.dotfiles}"
    "$root/scripts/docker-registry-auth-check" https://index.docker.io/v1/ retrieve --timeout 20
}
probe_aws() {
    arn="$(timeout 20 aws sts get-caller-identity --query Arn --output text 2>&1)"
    case "$arn" in arn:aws:*) echo "default profile: ${arn##*/}"; return 0;; esac
    echo "$arn"; return 1
}
probe_hawk() {
    # The token is the only thing on stdout; the reason a mint failed is the last of what it
    # said on stderr, after any progress line, and one run has to answer both.
    f="$(mktemp)"; e="$(timeout 90 hawk-token 2>&1 >"$f")"; t="$(tr -d "[:space:]" <"$f")"; rm -f "$f"
    case "$t" in *.*.*) echo "mints (${#t} bytes)"; return 0;; esac
    printf "%s" "$e" | grep -v "^[[:space:]]*$" | tail -1
    return 1
}
probe_google() {
    g="$(timeout 40 google-user-token 2>&1 >/dev/null)" && { echo "mints"; return 0; }
    echo "$g"; return 1
}
probe_gcloud() {
    # The box identity the SDK is configured for (dev-<name>@theorem-agent-infra: a keyless
    # external_account bound to this machine on Azure, the account attached to the VM through
    # the metadata relay on a Google VM), not a user login.
    a="$(timeout 60 gcloud auth list --filter=status:ACTIVE --format="value(account)" 2>&1 | grep -v "^[[:space:]]*$" | tail -1)"
    case "$a" in *@*) echo "active account $a"; return 0;; esac
    echo "${a:-gcloud names no active account}"; return 1
}
probe_gke() {
    # The build pool the agents submit jobs to; the plugin that gets its credential
    # (gke-gcloud-auth-plugin) is a symlink into the SDK, so this fails wherever gcloud does.
    k="$(timeout 60 kubectl --context gke_theorem-agent-infra_us-west1_dispatch -n builds auth can-i create jobs 2>&1 | grep -v "^[[:space:]]*$" | tail -1)"
    [ "$k" = yes ] && { echo "can create jobs in the builds namespace"; return 0; }
    echo "$k"; return 1
}
probe_run() {
    for p in "$@"; do
        if d="$(probe_$p 2>&1)"; then s=ok; else s=fail; fi
        # The last line that holds something: a failing tool prints its reason after whatever
        # it said on the way there, and aws opens its report with an empty line.
        printf "@probe %s %s %s\n" "$p" "$s" "$(printf "%s" "$d" | grep -v "^[[:space:]]*$" | tail -1 | cut -c1-200)"
    done
}
'

# The box side of the durable-disk check: /mnt/durable/<user> in the box (AGENTBOX_DURABLE) must
# be the host's filesystem, which the launcher measured (AGENTBOX_DURABLE_FS, durable_fs): the
# same device and size, and about the same free space. A box that had only a stub there
# answered `df` with its own disk's figures and refused writes (2026-11-02), and nothing said so.
# `agentbox doctor` passes the host's figures of the moment; `doctor --here` has those of the
# box's launch, so free space is compared to within 2% of the disk's size. The single quotes are
# the point: everything expands where it runs.
# shellcheck disable=SC2016
DURABLE_CHECK='
# The compute ledger ossv-vm writes (COMPUTE_INVENTORY): bound rw in every box.
check_compute_inventory() {
case "${AGENTBOX_COMPUTE_INVENTORY:-}" in
        "") fail "compute ledger: this box predates its bind (no AGENTBOX_COMPUTE_INVENTORY), so ossv-vm cannot write its ledger; relaunch it at a safe point with: agentbox move --self" ;;
        none) echo "note box: no compute ledger (the host has no /mnt/nvme/<user>)" ;;
        *) if t="$(mktemp -p "$AGENTBOX_COMPUTE_INVENTORY" .doctor.XXXXXX 2>/dev/null)"; then rm -f "$t"; ok "compute ledger $AGENTBOX_COMPUTE_INVENTORY is writable"
           else fail "compute ledger $AGENTBOX_COMPUTE_INVENTORY is not writable here, so ossv-vm create fails its ledger write"; fi ;;
    esac
}
check_durable() {
    d="${AGENTBOX_DURABLE:-}"
    case "$d" in
        "") fail "durable disk: this box predates the durable-disk bind (no AGENTBOX_DURABLE), so /mnt/durable/<user> here is not the durable disk; relaunch it at a safe point with: agentbox move --self"; return 0;;
        none) echo "note box: no durable disk (the host has no /mnt/durable/<user>)"; return 0;;
    esac
    gib() { awk -v b="$1" "BEGIN { printf \"%.0f\", b / 1073741824 }"; }
    read -r hdev hblocks hbsize havail <<<"${AGENTBOX_DURABLE_FS:-}"
    if [ -z "${havail:-}" ]; then fail "durable disk $d: the launcher passed no host figures (AGENTBOX_DURABLE_FS) to compare with"; return 0; fi
    if ! bdev="$(stat -c %d "$d" 2>/dev/null)" || ! b="$(stat -f -c "%b %S %a" "$d" 2>/dev/null)"; then fail "durable disk $d is not in this box; relaunch it with: agentbox move --self"; return 0; fi
    read -r bblocks bbsize bavail <<<"$b"
    hfree=$((havail * hbsize)); bfree=$((bavail * bbsize)); size=$((hblocks * hbsize))
    delta=$((bfree - hfree)); [ "$delta" -lt 0 ] && delta=$((-delta))
    figures="$(gib "$bfree") GiB free of $(gib $((bblocks * bbsize))) here, $(gib "$hfree") of $(gib "$size") on the host"
    if [ "$bdev" != "$hdev" ] || [ "$bblocks" != "$hblocks" ]; then
        fail "durable disk $d is not the host'"'"'s filesystem ($figures): a write there fills this box'"'"'s own disk; relaunch it with: agentbox move --self"
    elif [ "$delta" -gt $((size / 50)) ]; then
        fail "durable disk $d: free space differs from the host'"'"'s by more than 2% ($figures)"
    elif ! { touch "$d/.doctor.$$" 2>/dev/null && rm -f "$d/.doctor.$$"; }; then
        fail "durable disk $d is the host'"'"'s filesystem but $(id -un) cannot write it (owner $(stat -c %U "$d"), mode $(stat -c %a "$d"))"
    else
        ok "durable disk $d is the host'"'"'s filesystem, writable ($figures)"
    fi
}
'

# A probe's name for a person, and the command that shows the same answer on the host.
probe_label() {
    case "$1" in
        secrets)     echo "secrets agent-tier" ;;
        dockerhub)   echo "Docker Hub effective credential route" ;;
        aws)         echo "aws" ;;
        hawk)        echo "hawk-token" ;;
        google)      echo "google-user-token" ;;
        gcloud)      echo "gcloud auth list" ;;
        gke)         echo "kubectl auth can-i create jobs (builds)" ;;
    esac
}
probe_command() {
    case "$1" in
        secrets)     echo "secrets GHCR_PULL_TOKEN -- sh -c 'echo \${#GHCR_PULL_TOKEN}'" ;;
        dockerhub)   echo "$DOTFILES_DIR/scripts/docker-registry-auth-check https://index.docker.io/v1/ retrieve --timeout 20" ;;
        aws)         echo "aws sts get-caller-identity" ;;
        hawk)        echo "hawk-token" ;;
        google)      echo "google-user-token" ;;
        gcloud)      echo "gcloud auth list" ;;
        gke)         echo "kubectl --context gke_theorem-agent-infra_us-west1_dispatch -n builds auth can-i create jobs" ;;
    esac
}
PROBE_NAMES=(secrets dockerhub aws hawk google gcloud gke)
# The box side of doctor, run under bash inside a throwaway box. The single
# quotes are the point: everything expands inside the box.
# shellcheck disable=SC2016
DOCTOR_BOX_SCRIPT='
set -u
fails=0
ok() { echo "ok   box: $*"; }
fail() { echo "FAIL box: $*"; fails=$((fails + 1)); }
for t in omp jj gh knives aws gws kubectl pulumi docker socat google-chrome pip psql sqlite3 wget forward secrets hawk-token agent-secrets; do
    command -v "$t" >/dev/null 2>&1 && ok "tool $t" || fail "tool $t does not resolve"
done
for d in .config/agent-secrets; do
    [ -e "$HOME/$d" ] && fail "$d is present in the box" || ok "$d absent"
done
# The Google SDK and complete config are shared writable with this host.
sdk="$HOME/.gcloud/google-cloud-sdk"
[ -x "$sdk/bin/gcloud" ] && ok "the Google Cloud SDK is mounted ($sdk)" || fail "no Google Cloud SDK at $sdk: gcloud and gke-gcloud-auth-plugin cannot run in this box"
mounted() { awk -v t="$1" "\$5 == t { f = 1 } END { exit !f }" /proc/self/mountinfo; }
writable() { if [ -d "$1" ]; then touch "$1/.doctor.$$" 2>/dev/null && rm -f "$1/.doctor.$$"; else (: >>"$1") 2>/dev/null; fi; }
while read -r m p; do
    case "$p" in .npmrc|.gitconfig) [ -e "$HOME/$p" ] || { echo "note box: optional config $p absent"; continue; } ;; esac
    case "$m" in
        rw) mounted "$HOME/$p" && writable "$HOME/$p" && ok "rw $p" || fail "rw $p: not a writable mount (mounts entry newer than this box: relaunch to pick it up)";;
        ro) [ -e "$HOME/$p" ] || { echo "note box: ro $p absent (not on the host)"; continue; }
            mounted "$HOME/$p" && ! writable "$HOME/$p" && ok "ro $p" || fail "ro $p: not a read-only mount (mounts entry newer than this box: relaunch to pick it up)";;
    esac
done < <(cat "$DOTFILES_DIR/agentbox/mounts"; [ -r "$DOTFILES_DIR/.secrets/dotfiles/agentbox/mounts" ] && cat "$DOTFILES_DIR/.secrets/dotfiles/agentbox/mounts")
r="$(python3 -c "import socket,os; s=socket.socket(socket.AF_UNIX); s.connect(os.environ[\"DBUS_SESSION_BUS_ADDRESS\"].split(\"=\",1)[1]); s.sendall(b\"\\0AUTH EXTERNAL 31303030\\r\\n\"); print(s.recv(64).split()[0].decode())" 2>&1)"; [ "$r" = OK ] && ok "session bus (keyring) reachable through the relay" || fail "session bus: $r"
# SSH state is shared with the host, without a key-name allow-list.
[ -d "$HOME/.ssh" ] && ok ".ssh is shared host state" || fail ".ssh is missing"
jq -e "type == \"object\"" "$HOME/.docker/config.json" >/dev/null 2>&1 && ok "Docker config loaded without filtering host logins" || fail "Docker config is missing or invalid"
[ "$(stat -c %U /run/user/$(id -u))" = ubuntu ] && ok "runtime dir owned by ubuntu" || fail "runtime dir owner $(stat -c %U /run/user/$(id -u))"
# The disk limit (AGENTBOX_DISK, set by the launcher): one filesystem of the box own, holding the
# workspace, HOME and /tmp, and not the container root overlay, which has no limit of any kind
# here. A box started with --disk 0 has none and says so.
if [ "${AGENTBOX_DISK:-0}" = 0 ]; then
    echo "note box: no disk limit (this box was started with --disk 0)"
else
    bd="$(stat -c %d .)"; hd="$(stat -c %d "$HOME")"; td="$(stat -c %d /tmp)"; rd="$(stat -c %d /)"
    if [ "$bd" = "$hd" ] && [ "$bd" = "$td" ] && [ "$bd" != "$rd" ]; then
        ok "disk limit $AGENTBOX_DISK on one filesystem of this box: workspace, HOME and /tmp ($(df -h --output=size . | tail -1 | tr -d " ") usable)"
    else
        fail "disk limit $AGENTBOX_DISK: workspace, HOME and /tmp are not one filesystem of this box ($(df -h --output=target . "$HOME" /tmp / | tail -4 | tr "\n" " "))"
    fi
fi
check_durable
check_compute_inventory
if top="$(git rev-parse --show-toplevel 2>/dev/null)" && [ ! -e "$top/.jj" ]; then ok "cwd is a git clone of its own"; else fail "cwd is not a git clone of its own (cwd-dependent: run doctor from your checkout, not /tmp)"; fi
out="$(gh api user 2>&1)"; case "$out" in *"Resource not accessible by integration"*) ok "gh runs as an App (never the user)";; *) fail "gh api user: $(echo "$out" | head -1) (cwd-dependent: the shim routes by repository, so run doctor from your workspace)";; esac
# `gh auth status` is answered by shims/gh, which reports the App routing instead of a user
# login; a bare gh with no login says "not logged into any GitHub hosts". Either answer is
# this check passing - what it refuses is a user login inside the box.
gs="$(gh auth status 2>&1)"; case "$gs" in *"own login is not used"*|*"not logged"*) ok "gh auth: no user login";; *) fail "gh auth status shows a login: $(head -1 <<<"$gs")";; esac
# The public-text leak check `shims/gh` demands before `gh pr edit|create|comment`. A box that
# cannot reach it refuses every public text write, which is a box no lead can work in; it needs
# BOTH the writable config pointer and the script it names, on shared host storage.
lp="$HOME/.config/public-leak-check/path"
if [ ! -r "$lp" ]; then
    fail "public-leak-check pointer $lp is not in the box (agentbox/mounts: rw .config/public-leak-check); gh pr edit/create/comment will be refused"
else
    ls="$(head -1 "$lp" 2>/dev/null)"
    if [ -x "$ls" ]; then ok "public-text leak check reachable ($ls)"
    else fail "public-leak-check names $ls, which this box does not have; add it to the box (agentbox move --self --dir $(dirname "$ls" 2>/dev/null)) or gh pr edit/create/comment is refused"; fi
fi
jq -e ".auths[\"https://index.docker.io/v1/\"] != null or .credHelpers[\"https://index.docker.io/v1/\"] != null or ((.credsStore // \"\") != \"\")" "$HOME/.docker/config.json" >/dev/null 2>&1 && ok "Docker Hub credential route configured" || fail "Docker config has no Docker Hub credential route"
[ -z "${AGENT_SECRETS_HELPER_SOCK:-}" ] && [ ! -S "/run/user/$(id -u)/agent-secrets/helper.sock" ] && ok "no helper socket in the box (a box is not a host session)" || fail "helper socket reachable from the box"
# A box with no broker identity is a supported state, not a defect: one started before the key
# dir existed, or while the host could not enroll boxes (no key, no enrollment.error). Its agents
# use secretsd.
kd="${AGENT_SECRETS_KEY_DIR:-}"
if [ -z "$kd" ]; then
    echo "note box: no broker identity (no AGENT_SECRETS_KEY_DIR: the box predates it); its agents use secretsd"
elif [ -z "${AGENT_SECRETS_URL:-}" ] || [ "$kd" != "/run/user/$(id -u)/agent-secrets" ]; then
    fail "agent-secrets env: URL=${AGENT_SECRETS_URL:-unset} KEY_DIR=$kd"
elif [ ! -e "$kd/key.pem" ] && [ ! -e "$kd/enrollment.error" ]; then
    ok "agent-secrets env (url, key dir)"
    echo "note box: no broker identity (the host could not enroll boxes when this box started); its agents use secretsd"
else
    ok "agent-secrets env (url, key dir)"
    [ "$(stat -c %a "$kd/key.pem" 2>/dev/null)" = 600 ] && [ "$(stat -c %U "$kd/key.pem" 2>/dev/null)" = ubuntu ] && ok "box key 0600 ubuntu" || fail "box key: $(ls -l "$kd" 2>&1 | tr "\n" " ")"
    [ -s "$kd/enrollment" ] && ok "box enrolled ($(cat "$kd/enrollment"))" || fail "box not enrolled: $(cat "$kd/enrollment.error" 2>/dev/null || echo no enrollment.error either)"
    w="$(timeout 20 agent-secrets whoami 2>&1)"; jq -e ".kind == \"session\"" <<<"$w" >/dev/null 2>&1 && ok "broker knows this box as kind $(jq -r .kind <<<"$w"), operator $(jq -r .operator <<<"$w")" || fail "agent-secrets whoami: $(head -1 <<<"$w")"
fi
# The host-dependent credentials: the box answers, the host answers the same probes, and
# cmd_doctor compares the two (PROBE_FUNCS). Nothing is judged here, where the answer of the
# host is not known.
probe_run secrets dockerhub aws hawk google gcloud gke
# Envoy and Dispatch as a box session reads them: the envoy.json `envoy config-path` names (for a
# session without a profile of its own, the neutral file of the host, agentbox/mounts), the switch
# of each section, the listener through `envoy` itself (the URL in the file or the default, through
# the entrypoint relay, with the bearer in the file), the NATS by name, the seed command.
if ! ej="$("$DOTFILES_DIR/scripts/envoy" config-path 2>&1)"; then
    fail "$ej: box sessions have no Dispatch or Envoy"
elif [ ! -r "$ej" ]; then
    fail "envoy.json $ej unreadable: box sessions have no Dispatch or Envoy"
else
    case "$(jq -r ".dispatch.enabled" "$ej" 2>/dev/null)" in
        true) ok "dispatch section enabled in $ej ($(jq -r ".dispatch.serverUrl // \"http://localhost:8766\"" "$ej"))";;
        false) echo "note box: $ej turns Dispatch off";;
        *) echo "note box: $ej has no dispatch section with enabled true: box sessions have no Dispatch";;
    esac
    case "$(jq -r ".envoy.enabled" "$ej" 2>/dev/null)" in
        true)
            out="$(ENVOY_MAX_TIME=3 "$DOTFILES_DIR/scripts/envoy" ps --json 2>&1)" && ok "envoy api answers ($(jq length <<<"$out") sessions)" || fail "envoy api: $(head -1 <<<"$out")"
            nu="$(jq -r ".envoy.natsUrls[0] // empty" "$ej" 2>/dev/null)"; hp="${nu#*://}"; hp="${hp##*@}"; hp="${hp%%/*}"; case "$hp" in *:*) ;; *) hp="$hp:4222";; esac
            timeout 5 python3 -c "import socket, sys; socket.create_connection((sys.argv[1], int(sys.argv[2])), 4).close()" "${hp%:*}" "${hp##*:}" 2>/dev/null && ok "envoy nats reachable ($hp)" || fail "envoy nats ${nu:-unset in $ej} unreachable"
            s="$(jq -r ".envoy.natsSeed // empty" "$ej" 2>/dev/null)"
            case "$s" in
                "") echo "note box: $ej names no natsSeed (envoy connects without a credential)";;
                "!"*) n="$(timeout 10 sh -c "${s#!}" 2>/dev/null | tr -d "[:space:]" | wc -c)"; [ "$n" -gt 0 ] && ok "natsSeed command prints a seed" || fail "natsSeed command ${s#!} printed nothing";;
                *) ok "natsSeed set in $ej";;
            esac
            ;;
        false) echo "note box: $ej turns Envoy off";;
        *) echo "note box: $ej has no envoy section with enabled true: box sessions have no Envoy";;
    esac
fi
c="$(curl -s -m 3 -o /dev/null -w %{http_code} "${MNEMOPI_EMBEDDING_API_URL:-http://none}/../health" 2>/dev/null)"; [ "$c" = 200 ] && ok "mnemopi embed" || echo "note box: mnemopi embed $c"
n="$(timeout 20 forward doctor 2>&1 | grep -cE "accepted|reachable|accepts")"; echo "@forward-ok $n"
timeout 30 docker --host=unix:///var/run/docker.sock info >/dev/null 2>&1 && ok "inner docker answers" || fail "inner docker"
exit $fails
'

# The doctor box and everything it made: the container, its enrollment, its filesystem and its
# directories.
remove_doctor_box() {
    local box="$1"
    docker rm -f "$box" >/dev/null 2>&1 || true
    unenroll_box "$box"
    close_box_cache "$box"
    stop_tmux_forwarder "$box"
    rm -rf "${RUN_BASE:?}/$box"
    if close_box_disk "$box"; then rm -rf "${BOXES:?}/$box"; fi
}

# The box's host-dependent answers against this host's own (PROBE_FUNCS, @probe lines). Only a
# box that cannot do what the host can is a defect; where neither can, the line names the host
# login that is missing and the command that shows it, so a session reading doctor is not sent
# hunting its box for a credential this machine never had.
report_probes() {
    local box_out="$1" host_out name box_line host_line box_state box_detail host_state host_detail label
    host_out="$(bash -c "$PROBE_FUNCS probe_run ${PROBE_NAMES[*]}" 2>/dev/null)"
    for name in "${PROBE_NAMES[@]}"; do
        box_line="$(sed -n "s/^@probe $name //p" <<<"$box_out" | head -1)"
        host_line="$(sed -n "s/^@probe $name //p" <<<"$host_out" | head -1)"
        label="$(probe_label "$name")"
        if [[ -z "$box_line" ]]; then fail "box: $label: the box reported no answer"; continue; fi
        box_state="${box_line%% *}"; box_detail="${box_line#* }"
        host_state="${host_line%% *}"; host_detail="${host_line#* }"
        if [[ "$box_state" == ok ]]; then
            ok "box: $label: $box_detail"
        elif [[ "$host_state" == ok ]]; then
            fail "box: $label: $box_detail (the host answers: $host_detail - a box defect)"
        elif [[ "$box_detail" == "$host_detail" ]]; then
            # The usual shape: both sides say the same thing, so say it once.
            echo "note box: $label: host state, not the box - this machine cannot either: $box_detail. Show it with: $(probe_command "$name")"
        else
            echo "note box: $label: $box_detail; host state, not the box: this machine cannot either (${host_detail:-no host answer}). Show it with: $(probe_command "$name")"
        fi
    done
}

cmd_doctor() {
    if docker info --format '{{json .Runtimes}}' 2>/dev/null | grep -q sysbox-runc; then ok "host: sysbox-runc runtime"; else fail "host: sysbox-runc runtime not registered"; fi
    local tag; tag="$(image_tag)"
    [[ -n "$(docker image ls -q "$tag")" ]] && ok "host: image $tag built" || echo "note host: image $tag not built (built on next launch)"
    if [[ -d "$SRC" ]]; then ok "host: $SRC ($(repos | tr '\n' ' '))"; else fail "host: $SRC missing"; fi
    if [[ -S "/run/user/$UID_/bus" ]]; then ok "host: session bus"; else fail "host: session bus missing"; fi
    ensure_network && ok "host: network $NETWORK gateway $NETWORK_GATEWAY"
    ensure_forwarders && ok "host: forwarders (imds, envoy, bus)"
    local host_forward; host_forward="$(timeout 20 forward doctor 2>&1 | grep -cE 'accepted|reachable|accepts' || true)"
    # The broker, host side. A host whose helper holds no live launcher credential gives boxes and
    # host sessions no broker identity, and their agents use secretsd: a supported state, so a
    # note. Both helper checks run as a child of the user manager: doctor itself may be running
    # inside an agent session, which would make its own pid a session member.
    local helper_out
    if command -v agent-secrets >/dev/null 2>&1; then ok "host: agent-secrets on PATH"; else fail "host: agent-secrets not installed (mise install agent-secrets)"; fi
    if [[ ! -e "$HOME/.config/systemd/user/agent-secrets-helper.service" ]]; then
        echo "note host: agent-secrets-helper is not installed here (bash installers/agent-secrets.sh); boxes and host sessions use secretsd"
    elif ! systemctl --user is-active --quiet agent-secrets-helper.service || [[ ! -S "/run/user/$UID_/agent-secrets/helper.sock" ]]; then
        fail "host: agent-secrets-helper not active (systemctl --user status agent-secrets-helper)"
    else
        ok "host: agent-secrets-helper active ($(agent-secrets-helper sessions 2>/dev/null | wc -l) sessions)"
        helper_out="$(fresh_process agent-secrets whoami 2>&1 || true)"
        case "$helper_out" in *NOT_A_SESSION*) ok "host: helper refuses an unregistered process";; *) fail "host: helper answered an unregistered process: $(head -1 <<<"$helper_out")";; esac
        if broker_ready; then
            ok "host: launcher credential issued for $(cat "$LAUNCHER_DIR/operator" 2>/dev/null || echo unknown)"
            helper_out="$(fresh_process agent-secrets register --exec --wait 30 -- agent-secrets whoami 2>&1 || true)"
            if jq -e '.kind == "session"' <<<"$helper_out" >/dev/null 2>&1; then ok "host: helper enrolls and signs for a fresh session (kind $(jq -r .kind <<<"$helper_out"), operator $(jq -r .operator <<<"$helper_out"))"; else fail "host: helper session: $(head -1 <<<"$helper_out")"; fi
        else
            echo "note host: $BROKER_UNREADY; boxes and host sessions start without a broker identity and use secretsd"
        fi
    fi
    build_image "$tag"
    # A throwaway box on a throwaway clone of a small checkout: AGENTBOX_DOCTOR_REPO (default knives,
    # 12 MB of git), else the first checkout in $SRC with an origin. The first checkout by name can
    # be a fork of a large repository, whose template clone lands in ~/.cache on the root disk.
    local repo="" r box ws
    for r in "${AGENTBOX_DOCTOR_REPO:-knives}" $(repos); do
        [[ -e "$SRC/$r/.git" ]] && git -C "$SRC/$r" remote get-url origin >/dev/null 2>&1 && { repo="$r"; break; }
    done
    [[ -n "$repo" ]] || die "no checkout with an origin remote under $SRC to test with"
    box="agentbox-doctor$(tr -d '-' </proc/sys/kernel/random/uuid | cut -c1-6)"
    ws="$BOXES/$box/$repo"
    # Whatever ends doctor from here (a failed step under set -e, ^C, a hangup), the box goes with
    # it. The trap fires only in doctor itself, never in a $(…) subshell (see cmd_new).
    local doctor_pid=$BASHPID
    # shellcheck disable=SC2064
    trap "[[ \$BASHPID == $doctor_pid ]] && remove_doctor_box '$box'" EXIT
    trap 'exit 130' INT TERM HUP
    # The doctor box carries the same limits a session's box does, disk included, so the loop
    # mount itself - the one step that needs root - is part of what doctor tests.
    set_disk_bytes
    open_box_disk "$box"
    clone_checkout "$repo" "$ws" >/dev/null 2>&1 || die "doctor: could not clone $repo into $box"
    # 300 s for the box to reach its sleep: the first container of a freshly built image pays for
    # the runtime unpacking it, and the entrypoint waits up to 60 s for the inner dockerd on top.
    # A doctor run right after a rebuild hit the old 90 s ceiling on 2026-10-31 and reported a box
    # that was simply still starting as one that failed to start.
    local mounts=() env=() box_out="" tries=300
    local mount_out
    mount_out="$(mount_args "$box")" || die "doctor: the box's mounts could not be built (above)"
    mapfile -t mounts <<<"$mount_out"
    local env_out
    env_out="$(session_env "$box")" || die "doctor: the box's environment could not be built (above)"
    mapfile -t env <<<"$env_out"
    # The doctor box runs detached so it can be enrolled like a real box (enroll_box needs the
    # container up) before the checks run inside it; `sleep` is its session command, and the
    # entrypoint has finished — inner dockerd up, ghcr login done — once that sleep exists. It
    # carries the same limits a session's box does, so doctor tests what `new` actually starts.
    set_resource_args
    if docker run -d --init --runtime "$RUNTIME" --name "$box" --network "$NETWORK" --dns 100.100.100.100 --dns 1.1.1.1 \
        "${RESOURCE_ARGS[@]}" \
        -w "$ws" "${mounts[@]}" "${env[@]}" "$tag" sleep 1800 >/dev/null; then
        until docker exec "$box" pgrep -x sleep >/dev/null 2>&1 || (( --tries == 0 )); do sleep 1; done
        if (( tries )); then
            # Enrolled like a box from `new` when the host can enroll one; the host rows above say
            # why not, and the box-side checks show the rest.
            if broker_ready; then
                enroll_box "$box" "" || fail "host: enroll $box: $(cat "$(box_keydir "$box")/enrollment.error" 2>/dev/null)"
            fi
            # The host's durable figures of this moment, not of the launch above.
            local durable_env=()
            [[ -z "$DURABLE_DIR" ]] || durable_env=(-e "AGENTBOX_DURABLE_FS=$(durable_fs)")
            box_out="$(docker exec --user ubuntu -w "$ws" ${durable_env[@]+"${durable_env[@]}"} "$box" bash -c "$PROBE_FUNCS$DURABLE_CHECK$DOCTOR_BOX_SCRIPT" 2>&1)" || true
        else
            fail "host: doctor box did not reach sleep-running state"
        fi
    else
        fail "host: doctor box failed to start"
    fi
    trap - EXIT INT TERM HUP
    remove_doctor_box "$box"
    grep -vE '^@' <<<"$box_out"
    FAILS=$((FAILS + $(grep -c '^FAIL ' <<<"$box_out" || true)))
    report_probes "$box_out"
    local box_forward; box_forward="$(sed -n 's/^@forward-ok //p' <<<"$box_out")"
    if [[ "$box_forward" == "$host_forward" ]]; then ok "forward: $box_forward channel rows ok in box, same as host"; else fail "forward: $box_forward rows ok in box vs $host_forward on host (the box relays every channel the launcher found; journalctl --user -u 'agentbox-fwd-*' and /var/log/forward-relay.log in the box)"; fi
    (( FAILS == 0 )) && { echo "agentbox doctor: all checks passed"; exit 0; }
    echo "agentbox doctor: $FAILS check(s) failed" >&2
    exit 1
}

# The box-side half, run against THIS box instead of a throwaway one. `agentbox doctor` is a host
# command: from inside a box it fails the host probes (sysbox runtime, session bus, the IMDS
# forwarder's bind) that describe the caller's vantage rather than the box, and exits before the
# block it execs into a box — so the one tool that detects a box's own defects could not be run by
# the sessions that have them. Four sessions read those FAILs as their own box's health on
# 2026-09-26 while hunting a docker-credential defect this block reports directly.
cmd_doctor_here() {
    [[ -n "${AGENTBOX_BOX:-}" ]] || die "doctor --here runs INSIDE a box; on the host run 'agentbox doctor'"
    local out fails name line
    out="$(bash -c "$PROBE_FUNCS$DURABLE_CHECK$DOCTOR_BOX_SCRIPT" 2>&1)" || true
    grep -vE '^@' <<<"$out"
    # Inside a box there is no host answer to compare with, so a credential the machine itself
    # may not hold is reported and never counted: `agentbox doctor` on the host is what tells a
    # box defect from a login this machine is missing.
    for name in "${PROBE_NAMES[@]}"; do
        line="$(sed -n "s/^@probe $name //p" <<<"$out" | head -1)"
        case "$line" in
            ok\ *) ok "box: $(probe_label "$name"): ${line#ok }" ;;
            *) echo "note box: $(probe_label "$name"): ${line#fail }; host-dependent - run 'agentbox doctor' on the host to tell a box defect from a login this machine is missing" ;;
        esac
    done
    fails="$(grep -c '^FAIL ' <<<"$out" || true)"
    (( fails == 0 )) && { echo "agentbox doctor ($AGENTBOX_BOX): all box checks passed"; exit 0; }
    echo "agentbox doctor ($AGENTBOX_BOX): $fails check(s) failed" >&2
    exit 1
}

# Sourced (scripts/tests/test_agentbox_enroll.py), it defines its functions and runs nothing.
[[ "${BASH_SOURCE[0]}" == "$0" ]] || return 0

# `agentbox new` RE-EXECS FROM A PRIVATE COPY OF THIS FILE.
#
# This script is bash, and bash reads a script incrementally by byte offset: a file replaced
# under a running one makes it read the new bytes from the old offset and die where it stands,
# with no error line, no exit line, and -- measured on 2026-11-05 -- EXIT STATUS 0, so no caller
# can detect it either. `~/.dotfiles` is production and every publish replaces this file while
# sessions are using it.
#
# `new` is the long-running subcommand: it builds or finds the image, creates the box, mounts
# its filesystem and waits for omp to register. Two things run it in exactly the wrong window.
# The move's relauncher did, and a publish at 08:30:17Z on 2026-11-05 killed two stream leads'
# relaunchers mid-wait (move_hand_off now copies this file for that reason). The restart
# registry does too, through every entry's `resume=` line -- and that path is worse: it runs
# unattended and in bulk straight after a reboot, which is exactly when publishes cluster,
# because that is when people are fixing whatever caused the reboot. 75 sessions came back
# through it at 04:09Z that morning; one publish mid-sweep would have left some at a shell while
# the watcher's log said they were restarted (LANE-C, 2026-11-05).
#
# So the protection lives HERE rather than in each caller: no entry, pane or watcher has to know
# about it, and there is no second mechanism to keep in step. AGENTBOX_SELF_COPY both carries
# the copy's path for the cleanup and stops a second re-exec. A copy that cannot be made is not
# fatal: the launch goes on from the live file, as before, since refusing to start a session is
# worse than the hazard.
if [[ "${1:-}" == new && -z "${AGENTBOX_SELF_COPY:-}" ]]; then
    _self_copy="$(mktemp "${TMPDIR:-/tmp}/agentbox-self-XXXXXX" 2>/dev/null || true)"
    if [[ -n "$_self_copy" ]] \
        && cat "$(readlink -f "${BASH_SOURCE[0]}")" >"$_self_copy" 2>/dev/null \
        && chmod +x "$_self_copy" 2>/dev/null; then
        AGENTBOX_SELF_COPY="$_self_copy" exec "$_self_copy" "$@"
    fi
    [[ -z "$_self_copy" ]] || rm -f "$_self_copy"
    echo "agentbox: could not copy itself to run from; continuing from $(readlink -f "${BASH_SOURCE[0]}"), which a dotfiles publish can kill mid-launch" >&2
fi
# Running FROM the copy: take it away when this launch ends, whichever way it ends.
[[ -z "${AGENTBOX_SELF_COPY:-}" ]] || trap 'rm -f "$AGENTBOX_SELF_COPY"' EXIT

case "${1:-}" in
    new)     shift; cmd_new "$@" ;;
    sh)      shift; cmd_sh "$@" ;;
    grow)    shift; cmd_grow "$@" ;;
    ls)      cmd_ls ;;
    doctor)  shift; case "${1:-}" in --here|--box) cmd_doctor_here ;; "") cmd_doctor ;; *) die "doctor takes --here (this box) or no argument (host)" ;; esac ;;
    rebuild) cmd_rebuild ;;
    restart) shift; cmd_restart "$@" ;;
    finish)  shift; cmd_finish "$@" ;;
    # Started by `new` itself, detached, once its box names a session (reap_start).
    reap-previous) shift; cmd_reap "$@" ;;
    # Asked by the unenroll waiter (unenroll_box) three minutes after a box closes.
    session-live-box) shift; session_live_box "$@" ;;
    move)    shift; cmd_move "$@" ;;
    # The usage block at the top of this file, which every command above is listed in: a
    # command missing from this case would otherwise print its own documentation as the usage.
    *) sed -n '2,37p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
esac
