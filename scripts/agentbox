#!/usr/bin/env bash
# agentbox: one disposable Sysbox container per agent session, working in a
# checkout made for it.
#
#   agentbox new [-e NAME[=VALUE]]… [--memory SIZE] [--cpus N] [--disk SIZE]
#                [--dir PATH]… [<repo>…] -- <cmd> [args…]
#                                       run a command in a fresh box holding a
#                                       checkout of each repo, working in the
#                                       first; each --dir gives the box one
#                                       existing host directory, read-write at
#                                       its own path, and the box works in the
#                                       first --dir when no repo is named; each
#                                       -e sets a variable in the box
#                                       (docker run -e: a bare NAME passes the
#                                       caller's value); --memory/--cpus/--disk
#                                       raise or lower this box's limits
#                                       (defaults below)
#   agentbox sh <box|session-id> [cmd…] exec into a running session's box
#   agentbox ls                         running boxes
#   agentbox doctor                     health checks, host side and box side
#   agentbox rebuild                    build the image now; list boxes on older tags
#   agentbox restart <box|session-id>… | --all [--now]
#                                       relaunch a box's omp in place on the current
#                                       pin/plugins: asks the agent over Envoy to run
#                                       `agentbox restart` (in-box form: this session,
#                                       now) when safe; --now hangs it up at once
#   agentbox move --plan [--json]       the live host sessions this machine runs outside a box,
#                                       with the box each one would get, every path that box
#                                       gets and why it gets it, and its disk cost
#   agentbox move --self [--dry-run] [--dir PATH]…
#                                       run by a session in its own pane at a safe point: it
#                                       relaunches that pane into its own box, resuming this
#                                       session in the same directory. The box's paths are
#                                       inferred from the session's own processes; each --dir
#                                       adds one the inference missed, after the inferred ones
#   agentbox move <session-id>… | --all [--now] [--dry-run]
#                                       ask each host session over Envoy to run
#                                       `agentbox move --self` when safe; --now relaunches
#                                       its pane at once
#
# Each <repo> is a canonical checkout under ~/src. The box holds a git clone of
# its own of each, from the canonical checkout's origin, at <boxes>/<box>/<repo>
# — /mnt/nvme/<user>/agentbox/boxes on a machine with that disk, else ~/boxes
# (BOXES below) — and works in the first. At exit a clone holding nothing its
# remote lacks is removed with the box; a clone with uncommitted changes or
# commits no remote has keeps <boxes>/<box> in place, named on the pane, for its
# owner to push or remove. omp flags pass straight through after `--`.
#
# A session whose work is NOT a checkout — a lane's scratch tree, a directory of
# worktrees, a coordination root — names it with --dir instead of a repo
# (dispatch://INFRA-702): 50 of this host's 82 live sessions on 2026-11-01 worked
# in a directory that is not a repository, so a box could not be started for them
# at all. A --dir is the HOST's directory, bind-mounted read-write at its own path
# and never cloned or copied: it is shared with the host and with every other box
# that names it, it outlives the box, and writes in it are outside the box's disk
# image and so outside its disk limit. The cpu, memory and pids limits apply as
# always. ~/src is already in every box, so a --dir under it adds only the working
# directory; a path anywhere else (a lane tree under /mnt/nvme, ~/Code/...) is
# reachable in a box only when it is named.
#
# The box mounts an allow-list of $HOME (below). Host services arrive two ways:
# the session bus, the metadata service and the Envoy API through socat relays
# (Sysbox maps the box onto a subordinate uid range and dbus-daemon refuses a
# peer whose uid is not the user's; the relayed bus is what makes the keyring -
# and every tool that keeps a login in it - work unchanged inside), and the
# secretsd socket by direct mount. secretsd pins the process that REGISTERs a
# session and serves only that process's descendants; a forking relay makes
# every connection a different, short-lived peer, so nothing through a relay is
# ever a descendant of anything. The daemon (>= 3.2.3) accepts the mapped uid.
# Image: agentbox/Dockerfile.
#
# Secrets (AGENTC-393): each box gets its own broker identity — a P-256 key generated inside
# it (docker exec … agent-secrets keygen) in its private runtime dir, and one enrollment made
# from the host with the operator's launcher credential (agent-secrets-login, once per host).
# The key dir is bind-mounted into that box only; the credential lives in the host helper's
# memory. close_box revokes the enrollment; a detached `agent-secrets renew` loop in the box
# (start_renew) keeps its lease, which lapses within 15 min if the launcher never gets there.
# A box started while the host's helper holds no live launcher credential gets no identity at
# all (no key, no enrollment.pending): its agents use secretsd, and `new` says so (broker_ready).
# So does a box whose enrollment fails: enroll_failed removes its key.
set -euo pipefail

DOTFILES_DIR="${DOTFILES_DIR:-$HOME/.dotfiles}"
SRC="${AGENTBOX_SRC:-$HOME/src}"
# A box's checkouts, and the template clone per repo every one of them is copied from
# (clone_checkout; outside every box mount, so no box can change it). Both go on the machine's big
# disk where it has one, /mnt/nvme/<user>, tested as `.bashrc` tests it for the language caches:
# a clone per box per repo does not fit on the root disk of sami-rocqperf, which held 11 GiB free
# of 495 GiB on 2026-10-31 against an 18 GiB floor, while /mnt/nvme had 94 GiB. They move
# together because a box's clone hardlinks its objects from the template (`cp -al`), which works
# only within one filesystem. A machine without that disk keeps the old paths under $HOME, so
# nothing else changes; AGENTBOX_BOXES and AGENTBOX_CLONE_TEMPLATES override either.
if [[ -d "/mnt/nvme/$(id -un)" ]]; then
    BOXES="${AGENTBOX_BOXES:-/mnt/nvme/$(id -un)/agentbox/boxes}"
    CLONE_TEMPLATES="${AGENTBOX_CLONE_TEMPLATES:-/mnt/nvme/$(id -un)/agentbox/clones}"
else
    BOXES="${AGENTBOX_BOXES:-$HOME/boxes}"
    CLONE_TEMPLATES="${AGENTBOX_CLONE_TEMPLATES:-${XDG_CACHE_HOME:-$HOME/.cache}/agentbox-clones}"
fi
# Every repo is a git clone of the box's own (AGENTC-1420, Sami, 2026-10-02: "Let's just switch to
# Git everywhere"). On the shared jj store of agent-c, 298 workspaces and 135,748 refs/jj/keep refs,
# every jj command took about 11 s against 0.1 s for git. A repo listed here also gets a sparse
# checkout with these patterns, set before the first checkout. agent-c leaves out tasks/ (3.8 GB of
# its 4.2 GB tree): a full clone takes 194 s and this one about 30 s. Every tasks/*/basic_info.json
# stays, because tl validate's deployment-catalog check reads all of them; an agent adds the task it
# works on with `git sparse-checkout add /tasks/<id>/`.
declare -A CLONE_SPARSE=([agent-c]='/* !/tasks/ /tasks/*/basic_info.json')
# git with the same GitHub App credential routing a box's own git has (session_env), so a clone made
# here acts as the repo owner's App whoever runs the launcher.
APP_GIT=(env GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=include.path "GIT_CONFIG_VALUE_0=$DOTFILES_DIR/gh-app-routes.gitconfig" git)
RUNTIME=sysbox-runc
NETWORK=agentbox
# Resource limits per box (dispatch://INFRA-702). A box that runs away is stopped by its own
# cgroup, and no other box is touched. Measured on sami-rocqperf 2026-10-31 over 44 live agent
# sessions (RSS+swap of each session's process tree; RSS overcounts shared pages): memory p50
# 2.3 GiB, p95 14.1 GiB, max 17.8 GiB; CPU over 10 s p50 0.15 cores, p95 1.74, max 3.09. So
# 24 GiB of memory with 8 GiB of swap beyond it, and 8 cores, hold every session measured with
# room to spare. `agentbox new --memory SIZE --cpus N` changes one box; AGENTBOX_MEMORY and
# AGENTBOX_CPUS do too, but a session's environment reaches every box it later starts, so prefer
# the flag.
# The per-box limit does not bound the sum: 44 boxes at 24 GiB may claim 1,056 GiB on a 251 GiB
# host. So every box runs under one parent slice, user-<uid>-agentbox.slice, which systemd nests in
# user-<uid>.slice by its name. Boxes and host sessions then share that slice's one ceiling
# (MemoryMax=92% from /etc/systemd/system/user-.slice.d/60-omp-memory-guard.conf), as host
# sessions alone did before; docker's default parent, system.slice, has no such ceiling.
BOX_MEMORY="${AGENTBOX_MEMORY:-24g}"
BOX_CPUS="${AGENTBOX_CPUS:-8}"
# Swap a box may use beyond its memory limit; docker takes the two added together (--memory-swap).
BOX_SWAP=8g
# A box above these starves the machine instead of its own session, so the launcher refuses it.
BOX_MEMORY_CAP=96g
BOX_CPUS_CAP=32
# Processes per box: a fork bomb inside one otherwise takes the host's pid space.
BOX_PIDS=8192
# Disk per box (dispatch://INFRA-702, the third limit its title asks for). docker's
# --storage-opt size= is not available here: it needs the overlay2 driver on xfs with project
# quotas, and this host's docker data root (/var/lib/docker, a bind of /dev/md127[/docker],
# measured 2026-11-01) is ext4 under the overlayfs snapshotter, where docker refuses the option.
# ext4 project quotas are not available either: /dev/md127 carries neither the `project` nor the
# `quota` feature (tune2fs -l, 2026-11-01), and adding them means tune2fs plus a remount of a
# 3.4 TiB filesystem holding every session's work.
# So a box gets a FILESYSTEM of its own instead: a sparse ext4 image under BOX_DISKS,
# loop-mounted at <boxes>/<box> before the clones are made (open_box_disk). Everything a session
# writes without being told where - its clones, its $HOME overlay and /tmp, all three inside that
# directory (mount_args) - is then bounded by one limit, a write past it is ENOSPC inside the box
# alone, and the space returns to the host when the image is removed at close. The image is
# sparse, so a limit reserves nothing: N boxes at 32 GiB do not claim 32N GiB, exactly as the
# memory limit above does not bound the sum.
# The default is 32 GiB: the largest of the 117 session worktrees on this host's /mnt/nvme held
# 4.1 GiB on 2026-11-01 (median well under 1 GiB), so 32 GiB is about eight times the largest
# session measured. `agentbox new --disk SIZE` changes one box, AGENTBOX_DISK does too, and
# `--disk 0` turns the limit off for a machine with no root for the loop mount.
BOX_DISK="${AGENTBOX_DISK:-32g}"
# A box above this takes the shared disk rather than its own session's share, so it is refused;
# below the floor ext4 has no room for its own metadata plus a clone.
BOX_DISK_CAP=512g
BOX_DISK_MIN=1g
# The box images, beside the box trees and the clone templates on the same disk.
BOX_DISKS="${AGENTBOX_DISKS:-$(dirname "$BOXES")/disks}"
EMBED_NAME=omp-embed
EMBED_PORT="${OMP_EMBED_PORT:-8087}"
IMDS_PORT="${AGENTBOX_IMDS_PORT:-8169}"
# The Envoy HTTP API listens on the host's loopback (envoy-listener, :9020);
# a box reaches it through the same kind of forwarder as the metadata service,
# and the box's entrypoint relays its own 127.0.0.1:$ENVOY_PORT to that
# forwarder, so the URL in the envoy.json a host session reads serves a box
# session too.
ENVOY_PORT="${AGENTBOX_ENVOY_PORT:-9020}"
UID_="$(id -u)"
RUN_BASE="/run/user/$UID_/agentbox"
# The relayed session bus, in its own dir so a box sees the socket socat
# recreates after a unit restart.
BUS_SOCK="$RUN_BASE/bus/bus"
# systemd's secretsd.socket unit holds this listener, so the node is stable
# across daemon restarts and a bare-file bind stays live.
SECRETSD_SOCK="/run/user/$UID_/secretsd.sock"
# The secrets broker (AGENTC-393): the URL the caller chose, else this machine's env.local, else
# broker.env's (agent-secrets/broker-url.sh).
# shellcheck source=SCRIPTDIR/../agent-secrets/broker-url.sh
. "$DOTFILES_DIR/agent-secrets/broker-url.sh"
# The operator agent-secrets-login recorded.
LAUNCHER_DIR="$HOME/.config/agent-secrets"
# Why broker_ready last said no, with the command that fixes it.
BROKER_UNREADY=""

# What a session relies on, and nothing more: agentbox/mounts, one "<rw|ro>
# <path>" per line. Read here (host) and by doctor (box); both see the file
# because the dotfiles are mounted.
MOUNTS_FILE="$DOTFILES_DIR/agentbox/mounts"
# The entries of one mode, one path per line.
mounts_of() { awk -v m="$1" '$1 == m { print $2 }' "$MOUNTS_FILE"; }

die() { echo "agentbox: $*" >&2; exit 1; }

# A limit the launcher will not set: exit 2, apart from every other refusal, so a caller can tell
# "your value is out of range" from "this host cannot start a box".
refuse() { echo "agentbox: $*" >&2; exit 2; }

# A docker size (b/k/m/g, 1024-based; no suffix means bytes) in bytes; non-zero on anything else.
size_bytes() {
    local value="${1,,}"
    [[ "$value" =~ ^([0-9]+(\.[0-9]+)?)([bkmg])?$ ]] || return 1
    awk -v n="${BASH_REMATCH[1]}" -v u="${BASH_REMATCH[3]:-b}" \
        'BEGIN { f = (u == "g" ? 1073741824 : (u == "m" ? 1048576 : (u == "k" ? 1024 : 1))); printf "%d", n * f }'
}

# Bytes as the shortest exact docker size, so a derived limit reads like the one it came from.
size_text() {
    local bytes="$1"
    if (( bytes % 1073741824 == 0 )); then echo "$((bytes / 1073741824))g"
    elif (( bytes % 1048576 == 0 )); then echo "$((bytes / 1048576))m"
    else echo "${bytes}b"; fi
}

# RESOURCE_ARGS: the docker run limits for one box, from BOX_MEMORY and BOX_CPUS. $1 and $2 name
# where each value came from, for the refusal message. It runs in the launcher itself and sets a
# global rather than printing, because a $(…) would swallow its exit.
RESOURCE_ARGS=()
set_resource_args() {
    local mem_from="${1:---memory}" cpu_from="${2:---cpus}" bytes cap swap
    bytes="$(size_bytes "$BOX_MEMORY")" || refuse "$mem_from '$BOX_MEMORY' is not a size (24g, 512m, or bytes)"
    cap="$(size_bytes "$BOX_MEMORY_CAP")"
    (( bytes > 0 )) || refuse "$mem_from '$BOX_MEMORY' is not a usable memory limit"
    (( bytes <= cap )) || refuse "$mem_from '$BOX_MEMORY' is above the $BOX_MEMORY_CAP limit per box"
    [[ "$BOX_CPUS" =~ ^[0-9]+(\.[0-9]+)?$ ]] || refuse "$cpu_from '$BOX_CPUS' is not a number of cores"
    awk -v c="$BOX_CPUS" -v cap="$BOX_CPUS_CAP" 'BEGIN { exit !(c > 0 && c <= cap) }' \
        || refuse "$cpu_from '$BOX_CPUS' is above the $BOX_CPUS_CAP cores limit per box"
    swap="$(size_bytes "$BOX_SWAP")"
    RESOURCE_ARGS=(
        --memory "$BOX_MEMORY" --memory-swap "$(size_text $((bytes + swap)))"
        --cpus "$BOX_CPUS" --pids-limit "$BOX_PIDS"
        --cgroup-parent "user-${UID_}-agentbox.slice"
    )
}

# BOX_DISK_BYTES: this box's disk limit in bytes, 0 when the caller turned it off. $1 names where
# the value came from, for the refusal. Set in the launcher itself, like set_resource_args.
BOX_DISK_BYTES=0
set_disk_bytes() {
    local from="${1:---disk}" cap min
    if [[ "$BOX_DISK" == 0 || "$BOX_DISK" == none ]]; then BOX_DISK_BYTES=0; return 0; fi
    BOX_DISK_BYTES="$(size_bytes "$BOX_DISK")" || refuse "$from '$BOX_DISK' is not a size (32g, 512m, or bytes)"
    cap="$(size_bytes "$BOX_DISK_CAP")"
    min="$(size_bytes "$BOX_DISK_MIN")"
    (( BOX_DISK_BYTES >= min )) || refuse "$from '$BOX_DISK' is below the $BOX_DISK_MIN minimum per box"
    (( BOX_DISK_BYTES <= cap )) || refuse "$from '$BOX_DISK' is above the $BOX_DISK_CAP limit per box"
}

# The box's own filesystem at $BOXES/<box>: a sparse ext4 image loop-mounted there, so every
# path the box writes through that directory - its clones, its $HOME overlay and its /tmp
# (mount_args) - shares one limit and nothing it writes can take the host's disk or another
# box's. Called before the clones, since they land inside it.
#
# ROOT: the loop mount is the only step that needs it, as `sudo mount -o loop,discard <image>
# <dir>` here and `sudo umount <dir>` in close_box_disk. Everything else (the sparse file, mkfs,
# the image's removal) runs as the user. mkfs gives the filesystem's root directory to the
# launching user (-E root_owner), so the box dir has the owner it had before, and -m 0 leaves no
# blocks reserved for root, so the session may use every byte of its limit. discard makes the
# loop device punch holes in the image, so space a box frees goes back to the host at once
# rather than at close.
open_box_disk() {
    local box="$1" img="$BOX_DISKS/$1.img"
    mkdir -p "$BOXES/$box"
    (( BOX_DISK_BYTES )) || return 0
    mkdir -p "$BOX_DISKS"
    rm -f "$img"
    truncate -s "$BOX_DISK_BYTES" "$img" || die "could not make the box disk image $img"
    # mkfs.ext4 lives in /usr/sbin, which a session's PATH carries and a systemd unit's or a
    # restore script's often does not; the launcher must work from either.
    PATH="$PATH:/usr/sbin:/sbin" mkfs.ext4 -q -F -m 0 -E "root_owner=$UID_:$(id -g)" "$img" \
        || die "mkfs.ext4 failed on the box disk image $img"
    sudo -n mount -o loop,noatime,discard "$img" "$BOXES/$box" || {
        rm -f "$img"
        die "could not mount the box disk ($BOX_DISK) at $BOXES/$box: 'sudo -n mount -o loop' failed; start the box with --disk 0 on a machine without that sudo rule"
    }
    # mke2fs puts a root-owned 0700 lost+found in every ext4 filesystem, and this one is the
    # directory a session works in: without this, `du`, `find` or a sweep run from the box tree
    # meets a permission denial in its own workspace. Nothing here is ever fscked - the image
    # dies with the box - so the session may have it.
    sudo -n chown "$UID_:$(id -g)" "$BOXES/$box/lost+found" 2>/dev/null || true
}

# BOX_DIRS: the host directories this box is given (--dir), each at its own path, read-write.
# mount_args binds them and cmd_new works in the first when no repo is named. A path is taken
# as the caller typed it after readlink -f, so a symlink reaches the box as the directory it
# names, the way $SRC's symlinked checkouts already do.
BOX_DIRS=()
# One --dir, validated and resolved. Refused: a path that is not a directory (a box cannot be
# given something that does not exist yet, and a typo would otherwise be a silent empty mount);
# `/`, which is the host's whole filesystem; and $HOME or the box tree, each of which would
# shadow a mount the box needs (the box's own $HOME holds the allow-list, and <boxes>/<box> is
# the box's filesystem).
add_box_dir() {
    local raw="$1" path
    [[ -d "$raw" ]] || die "--dir '$raw' is not an existing directory"
    path="$(readlink -f "$raw")" || die "--dir '$raw' cannot be resolved"
    case "$path" in
        /) die "--dir / would give the box the whole host filesystem" ;;
        "$HOME") die "--dir $HOME would shadow the box's own home and its allow-list ($MOUNTS_FILE); name the directory you work in" ;;
        "$BOXES"|"$BOXES"/*) die "--dir '$path' is inside the box tree $BOXES, which every box already has" ;;
    esac
    BOX_DIRS+=("$path")
}

# The box's filesystem and its image, given back. Everything the box wrote goes with the image,
# which is why close_box removes the image before it removes the (now empty) mountpoint. A box
# started with --disk 0 has neither and this is a no-op, as it is for a box whose launcher never
# got as far as the mount.
close_box_disk() {
    local box="$1" img="$BOX_DISKS/$1.img"
    if mountpoint -q "$BOXES/$box" 2>/dev/null; then
        sudo -n umount "$BOXES/$box" \
            || { echo "agentbox: could not unmount $BOXES/$box; its disk image $img is left in place (sudo umount '$BOXES/$box' && rm -f '$img')" >&2; return 1; }
    fi
    rm -f "$img"
}

# Whether a new box can get a broker identity: the client installed and the helper holding a live
# launcher credential (which also means the helper answers and an operator logged in). Until then
# (a host before its one `agent-secrets-login`, a helper restarted since) a box starts without
# one: no key, no enrollment.pending, so its agents use secretsd. Sets BROKER_UNREADY when it
# answers no, with login-status's own answer.
broker_ready() {
    local status
    BROKER_UNREADY=""
    if ! command -v agent-secrets >/dev/null 2>&1; then
        BROKER_UNREADY="agent-secrets is not installed (run: mise install agent-secrets)"
        return 1
    fi
    status="$(agent-secrets machine login-status 2>&1)" && return 0
    BROKER_UNREADY="the helper holds no live launcher credential (login-status: ${status%%$'\n'*}; run: agent-secrets-login <email>)"
    return 1
}

# The host side of a box's key dir: bind-mounted at /run/user/$UID_/agent-secrets in that box only.
box_keydir() { echo "$RUN_BASE/$1/run-user/agent-secrets"; }

# The box's key dir is the box's to write too (keygen writes key.pem there as the box's user), so
# the host keeps its own files beside it, in $RUN_BASE/<box>, which no box mounts: each enroll
# attempt's error (enroll.attempt-error) and the enrollment id close_box revokes (enrollment-id).
# What agentbox itself puts in the key dir is written to a temp file in $RUN_BASE/<box> and
# renamed into place, which replaces whatever the box left at that name (a symlink included)
# instead of following it. The `enrollment` file the host-side `agent-secrets enroll` writes gets
# the same treatment only from the legion #1589 release on; the pinned client writes it in place.
put_keyfile() {
    local box="$1" name="$2" content="$3" tmp
    tmp="$(mktemp "$RUN_BASE/$box/.keyfile.XXXXXX")" || return 1
    printf '%s' "$content" >"$tmp" && mv -fT "$tmp" "$(box_keydir "$box")/$name"
}

# How a box's enrollment ends when it does not end enrolled: the reason in enrollment.error
# (`agentbox doctor` reports it), then key.pem and the enrollment.pending marker removed, so the
# box has no broker identity and its agents use secretsd, as when the host could not enroll it.
enroll_failed() {
    local keydir; keydir="$(box_keydir "$1")"
    put_keyfile "$1" enrollment.error "$2"$'\n'
    rm -f "$keydir/key.pem" "$keydir/enrollment.pending"
    return 1
}

# Wait for the container to be Running (docker exec needs that) for as long as the launcher's
# docker run child lives: a box can take minutes to reach Running when several start at once, and
# the child's exit is the only sign that it never will. Each pass renews the enrollment.pending
# marker, so a client that starts with the box finds it fresh however long the start took.
wait_for_running() {
    local box="$1" child="$2"
    while :; do
        [[ "$(docker inspect -f '{{.State.Running}}' "$box" 2>/dev/null)" == true ]] && return 0
        kill -0 "$child" 2>/dev/null || return 1
        put_keyfile "$box" enrollment.pending ""
        sleep 0.5
    done
}

# Enroll a running box with the secrets broker. The key is generated INSIDE the box by a
# process in its namespaces, into its private runtime dir (tmpfs, this box only); only the
# public thumbprint comes back. The enrollment is made from the host with the launcher
# credential, which no box can read, and the client writes the enrollment id beside the key.
# sid is the box's omp session id when known (the broker wakes that session on a decision),
# else empty. Ten attempts 3 s apart. The enrollment.pending marker (cmd_new creates it before
# docker run) is renewed before keygen and before each attempt: from the legion #1589 release a
# client in the box waits on a marker younger than 160 s, so it stays fresh for exactly as long
# as the launcher is still working, however slow the broker. Success removes the marker and
# every error file; every other end is enroll_failed. The box runs on either way. Re-running is
# safe: the broker answers a repeat of the same key with the same enrollment.
enroll_box() {
    local box="$1" sid="$2" keydir errfile tp eid attempt
    keydir="$(box_keydir "$box")"
    errfile="$RUN_BASE/$box/enroll.attempt-error"
    broker_ready || { enroll_failed "$box" "not enrolled: $BROKER_UNREADY"; return 1; }
    put_keyfile "$box" enrollment.pending ""
    if ! tp="$(docker exec --user ubuntu "$box" agent-secrets keygen --out "/run/user/$UID_/agent-secrets" 2>"$errfile")"; then
        enroll_failed "$box" "agent-secrets keygen failed in $box: $(<"$errfile")"
        return 1
    fi
    tp="${tp//[[:space:]]/}"
    if [[ ! "$tp" =~ ^[A-Za-z0-9_-]{43}$ ]]; then
        enroll_failed "$box" "agent-secrets keygen printed no thumbprint: '$tp'"
        return 1
    fi
    local args=(enroll --helper --runtime-id "$box" --thumbprint "$tp")
    [[ -n "$sid" ]] && args+=(--session-id "$sid")
    for attempt in $(seq 1 10); do
        put_keyfile "$box" enrollment.pending ""
        # enroll prints the enrollment id alone, and writes it into the key dir for the box.
        if eid="$(AGENT_SECRETS_URL="$AGENT_SECRETS_URL" AGENT_SECRETS_KEY_DIR="$keydir" \
            agent-secrets "${args[@]}" 2>"$errfile")"; then
            [[ -n "$eid" && -s "$keydir/enrollment" ]] \
                || { enroll_failed "$box" "agent-secrets enroll printed '$eid' and left $keydir/enrollment empty"; return 1; }
            printf '%s\n' "$eid" >"$RUN_BASE/$box/enrollment-id"
            rm -f "$keydir/enrollment.pending" "$keydir/enrollment.error" "$errfile"
            return 0
        fi
        (( attempt < 10 )) && sleep 3
    done
    enroll_failed "$box" "agent-secrets enroll failed 10 times; last: $(<"$errfile")"
}

# The box's enrollment lease: `agent-secrets renew` inside it, for every box, restarted after it
# exits. renew retries a transient failure itself but exits on any refusal, and something in the
# box can kill it; without the restart the lease would lapse within 15 min while the box kept its
# key. The restart waits 10 s, doubling after each renew that exits quickly, up to 10 min, and
# back to 10 s after one that ran over a minute: a revoked or lapsed enrollment, which only meets
# the same refusal again, then costs the broker one call per 10 min. Each exit and the next delay
# go to renew.log beside renew's own output. The loop survives an omp relaunch
# (`agentbox restart`, same container) and dies with the box.
# shellcheck disable=SC2016  # expands in the box's sh
RENEW_LOOP='d=10
while :; do
    s=$(date +%s)
    agent-secrets renew
    rc=$?
    [ $(($(date +%s) - s)) -gt 60 ] && d=10
    echo "agentbox: agent-secrets renew exited $rc; restarting in ${d}s"
    sleep "$d"
    d=$((d * 2))
    [ "$d" -gt 600 ] && d=600
done >>"$AGENT_SECRETS_KEY_DIR/renew.log" 2>&1'
start_renew() {
    docker exec -d --user ubuntu "$1" sh -c "$RENEW_LOOP"
}

# Enroll a box from `new` once it is up, then start its renew: for omp once its session id is
# known (omp opens its session file 4–10 s after start, before any tool can run), so the
# enrollment carries the id the broker wakes on a decision; any other command at once; after
# 120 s of running without a session id (an omp --no-session run) without one. The deadline
# starts once the box is Running, so a box that was slow to start still enrolls with its id. The
# enrollment.pending marker is renewed on every pass of both waits, so it stays inside the
# client's 160 s trust window however long the box takes. A box that never runs, or ends first,
# ends in enroll_failed too.
enroll_when_up() {
    local box="$1" child="$2" cmd="$3" sid="" deadline
    wait_for_running "$box" "$child" || { enroll_failed "$box" "$box never reached Running; not enrolled"; return 1; }
    deadline=$(( SECONDS + 120 ))
    while kill -0 "$child" 2>/dev/null; do
        put_keyfile "$box" enrollment.pending ""
        [[ "$cmd" == omp ]] && sid="$(box_session_id "$box")"
        if [[ "$cmd" != omp || -n "$sid" ]] || (( SECONDS >= deadline )); then
            enroll_box "$box" "$sid" || return 1
            start_renew "$box" || echo "agentbox: renew start for $box failed; its enrollment lapses within 15 min" >&2
            return 0
        fi
        sleep 2
    done
    enroll_failed "$box" "$box ended before it was enrolled"
}

# Revoke a box's enrollment and every grant under it: the id the host recorded at enrollment,
# never the box-writable copy. Idempotent on the broker; a failure is noted, and the lease the
# box stopped renewing lapses within 15 minutes.
unenroll_box() {
    local box="$1" eid
    [[ -s "$RUN_BASE/$box/enrollment-id" ]] || return 0
    eid="$(<"$RUN_BASE/$box/enrollment-id")"
    AGENT_SECRETS_URL="$AGENT_SECRETS_URL" agent-secrets unenroll --helper --enrollment "$eid" \
        || echo "agentbox: unenroll $box ($eid) failed; the broker drops it when its lease lapses (15 min)" >&2
}

# Run a command as a fresh process under the user manager: a child of systemd --user, inside
# no registered host session. What a check of the helper's refusal, or of a brand-new
# registration, needs when the caller itself runs inside an agent session. The unit
# environment carries nothing of ours, so the broker, socket and a PATH holding the real
# binary (a mise shim cannot run there) are passed explicitly.
fresh_process() {
    local bin_dir
    bin_dir="$(mise where agent-secrets)/bin" || return 1
    systemd-run --user --pipe --wait --quiet --collect \
        --setenv="AGENT_SECRETS_URL=$AGENT_SECRETS_URL" \
        --setenv="AGENT_SECRETS_HELPER_SOCK=/run/user/$UID_/agent-secrets/helper.sock" \
        --setenv="PATH=$bin_dir:/usr/local/bin:/usr/bin:/bin" \
        -- "$@"
}

# The canonical checkouts, one name per line: each entry of $SRC that holds a .git. Hidden entries
# and plain directories there (~/src/.cloudflare, ~/src/.hawk-token) are not checkouts.
repos() {
    local d
    for d in "$SRC"/*; do
        [[ -d "$d" && -e "$d/.git" ]] && printf '%s\n' "${d##*/}"
    done | sort
}

# Image tag is the content hash of what builds it, so an edit to any image
# input yields a new tag built on the next launch; running boxes on the old
# tag are listed by `rebuild` and move when their sessions restart.
image_tag() {
    local h
    h="$(cat "$DOTFILES_DIR/agentbox/Dockerfile" "$DOTFILES_DIR/agentbox/entrypoint.sh" | sha256sum | cut -c1-12)"
    echo "agentbox:$h"
}

build_image() {
    local tag="$1"
    if [[ -z "$(docker image ls -q "$tag")" ]]; then
        echo "agentbox: building $tag" >&2
        # buildx with the default builder: ~/.docker/config.json may alias
        # `docker build` to depot, which needs a project this image has none of.
        docker buildx build --builder default --load -t "$tag" "$DOTFILES_DIR/agentbox" >&2
    fi
}

ensure_network() {
    docker network inspect "$NETWORK" >/dev/null 2>&1 || docker network create "$NETWORK" >/dev/null
    # omp-embed (installers/omp-embed.sh) serves mnemopi embeddings for every
    # session on the machine; boxes reach it by name on this network.
    if docker inspect "$EMBED_NAME" >/dev/null 2>&1 \
        && ! docker inspect -f '{{json .NetworkSettings.Networks}}' "$EMBED_NAME" | grep -q "\"$NETWORK\""; then
        docker network connect "$NETWORK" "$EMBED_NAME"
    fi
    NETWORK_GATEWAY="$(docker network inspect -f '{{(index .IPAM.Config 0).Gateway}}' "$NETWORK")"
    NETWORK_SUBNET="$(docker network inspect -f '{{(index .IPAM.Config 0).Subnet}}' "$NETWORK")"
    [[ -n "$NETWORK_GATEWAY" && -n "$NETWORK_SUBNET" ]] || die "network $NETWORK has no IPv4 gateway/subnet"
}

# Host forwarders as transient user units, restarted if socat dies. TCP ones
# bind the box network's gateway and admit only that network; unix ones are
# 0600 sockets under $RUN_BASE.
start_unit() {
    local unit="$1"; shift
    systemctl --user is-active --quiet "$unit" && return 0
    systemctl --user reset-failed "$unit" 2>/dev/null || true
    systemd-run --user --unit "$unit" --quiet --collect --property=Restart=always --property=RestartSec=1 "$@"
}

wait_for() {
    local _
    for _ in $(seq 1 20); do
        "$@" && return 0
        sleep 0.25
    done
    return 1
}

ensure_tcp_forwarder() {
    local unit="$1" port="$2" target="$3"
    # A forwarder already running toward another address is stopped first: forward's channels
    # move between this host's two loopback addresses when its config changes, and a unit
    # started before that would relay every box to an address nothing listens on.
    if systemctl --user is-active --quiet "$unit" \
        && ! systemctl --user show -p ExecStart --value "$unit" 2>/dev/null | grep -qF "TCP4:$target"; then
        systemctl --user stop "$unit" 2>/dev/null || true
    fi
    start_unit "$unit" socat "TCP4-LISTEN:$port,bind=$NETWORK_GATEWAY,range=$NETWORK_SUBNET,fork,reuseaddr" "TCP4:$target"
    wait_for bash -c "ss -ltn 'sport = :$port' | grep -q '$NETWORK_GATEWAY:$port'" \
        || die "forwarder $unit did not bind $NETWORK_GATEWAY:$port (journalctl --user -u $unit)"
}

ensure_unix_forwarder() {
    local unit="$1" sock="$2" target="$3"
    # A unit already relaying somewhere else is stopped first, as the TCP one is: the host's
    # tmux socket path follows TMUX_TMPDIR, and a stale unit would relay every box to a socket
    # nothing listens on.
    if systemctl --user is-active --quiet "$unit" \
        && ! systemctl --user show -p ExecStart --value "$unit" 2>/dev/null | grep -qF "UNIX-CONNECT:$target"; then
        systemctl --user stop "$unit" 2>/dev/null || true
    fi
    mkdir -p "$(dirname "$sock")"
    start_unit "$unit" socat "UNIX-LISTEN:$sock,fork,mode=600,unlink-early" "UNIX-CONNECT:$target"
    wait_for test -S "$sock" || die "forwarder $unit did not open $sock (journalctl --user -u $unit)"
}

# The host's tmux server, for a lead that drives other sessions' panes (`tmux new-window`,
# `send-keys`, `capture-pane`, `list-panes`). It needs a relay, exactly as the session bus does,
# and for the same reason: Sysbox maps the box onto a subordinate uid range, and the tmux server
# refuses a client whose SO_PEERCRED uid is not its own. Measured 2026-11-01 in a throwaway box
# with the host's socket bind-mounted directly: connect(2) succeeded (Sysbox id-maps the bind,
# so the node is the box user's) and every tmux command answered `access not allowed`, exit 1.
# Through this relay, which connects onward as the user, the server sees the user. tmux's
# non-attaching commands survive a relay - measured on the host, `display-message -p
# '#{version}'` through a socat UNIX-LISTEN/UNIX-CONNECT pair answered 3.8 - which is what a
# lead uses; attaching inside a box is not a thing anyone does, since the box has no terminal of
# the host's.
#
# WHAT THIS GIVES A BOX, stated plainly: control of the host's tmux server. A box can read any
# pane (`capture-pane`), type into any pane (`send-keys`, which in a pane at a shell is a
# command as the host user, outside the box's cgroup and disk limit), respawn or kill any pane,
# and `kill-server`, which would end every agent pane on the machine. It is given because the
# relayed session bus already reaches the host's systemd user manager, so a box can already
# `systemctl --user restart` the host's services (agentbox/AGENTS.md), and because a lead that
# cannot drive panes cannot be boxed at all - which would leave the coordination sessions, the
# heaviest on the host, outside every limit this work exists to apply.
#
# The socket the host session itself uses ($TMUX's first field) is the source, so a machine
# whose TMUX_TMPDIR is not /tmp (this one keeps its sockets in ~/.tmux/sockets) is followed
# rather than guessed; AGENTBOX_TMUX_SOCK overrides, and a host with no tmux gets no relay and
# no mount. Inside, it is TMUX_TMPDIR/tmux-<box uid>/default, which is where a bare `tmux`
# looks: the box user is uid 1000 by the image (agentbox/Dockerfile), whatever the host's uid.
BOX_UID=1000
HOST_TMUX_SOCK=""
host_tmux_sock() {
    HOST_TMUX_SOCK="${AGENTBOX_TMUX_SOCK:-${TMUX%%,*}}"
    [[ -n "$HOST_TMUX_SOCK" ]] || HOST_TMUX_SOCK="${TMUX_TMPDIR:-/tmp}/tmux-$UID_/default"
    [[ -S "$HOST_TMUX_SOCK" ]] || HOST_TMUX_SOCK=""
}
BOX_TMUX_DIR="$RUN_BASE/tmux"
ensure_tmux_forwarder() {
    host_tmux_sock
    [[ -n "$HOST_TMUX_SOCK" ]] || return 0
    ensure_unix_forwarder agentbox-tmux "$BOX_TMUX_DIR/tmux-$BOX_UID/default" "$HOST_TMUX_SOCK"
}

# forward's channels are TCP listeners on this host's loopback (forward/AGENTS.md gives each
# machine a listen/peer pair; here 127.0.0.2 and 127.0.0.1), and a box has a loopback of its
# own, so inside one every channel refused the connection while forward's mounted unix
# sockets (arm.sock, pcscd.comm) worked: a box could hold a port for the laptop but could
# not open a URL on it or ask for a browser grant. Each listener gets what the Envoy API
# gets - a forwarder on the box network's gateway here, and a relay in the box that puts it
# back on its own address and port (agentbox/entrypoint.sh). The ports are read from the
# host, never listed, because they come from forward's per-machine config: its reserved
# 128xx range, which the using-forward skill says forward refuses to forward for anything
# else. FORWARD_CHANNELS is what the box is told about (session_env).
FORWARD_CHANNELS=()
forward_channels() {
    mapfile -t FORWARD_CHANNELS < <(
        ss -Hltn | awk '{ print $4 }' | grep -E '^127\.0\.0\.[0-9]+:128[0-9][0-9]$' | sort -u
    )
}

ensure_forward_channels() {
    local channel
    forward_channels
    for channel in "${FORWARD_CHANNELS[@]}"; do
        ensure_tcp_forwarder "agentbox-fwd-${channel##*:}" "${channel##*:}" "$channel"
    done
}

ensure_forwarders() {
    ensure_tcp_forwarder agentbox-imds "$IMDS_PORT" 169.254.169.254:80
    ensure_tcp_forwarder agentbox-envoy "$ENVOY_PORT" "127.0.0.1:$ENVOY_PORT"
    ensure_unix_forwarder agentbox-bus "$BUS_SOCK" "/run/user/$UID_/bus"
    ensure_tmux_forwarder
    ensure_forward_channels
}

# The allow-list, as docker -v arguments. rw dirs are created on the host
# first so docker never creates them root-owned; symlinked entries (the
# dotfiles' config files) are bound by target so the box sees content, not a
# link into an unmounted path.
mount_args() {
    local box="$1" a=() p src
    a+=(-v "$SRC:$SRC")
    # $SRC may hold symlinks to checkouts elsewhere (~/src/dotfiles → ~/.dotfiles);
    # each target is mounted at its own path so the link resolves inside.
    for p in "$SRC"/*; do
        [[ -L "$p" ]] || continue
        src="$(readlink -f "$p")"
        a+=(-v "$src:$src")
    done
    # The host directories this box was given (--dir), each at its own path. Docker nests binds
    # by destination, so one under $SRC or under a listed home path simply re-binds the same
    # host directory at the same place and changes nothing; one anywhere else is the only way
    # that path reaches the box.
    for p in "${BOX_DIRS[@]}"; do
        a+=(-v "$p:$p")
    done
    a+=(-v "$BOXES/$box:$BOXES/$box")
    # $HOME and /tmp inside the box's own directory, so the box's disk limit covers the two
    # places a session writes without being told where. Without them both land in the
    # container's writable layer, which is docker's data root on the shared disk and has no
    # limit of any kind here: a home path outside the allow-list is silently writable
    # (agentbox/AGENTS.md) and /tmp is where every tool puts its scratch. Docker nests binds by
    # destination, so every allow-listed path below still mounts on top of this $HOME, and the
    # entrypoint's chown walks the bind rather than the overlay (it follows $HOME's own device).
    mkdir -p "$BOXES/$box/home" "$BOXES/$box/tmp"
    chmod 1777 "$BOXES/$box/tmp"
    a+=(-v "$BOXES/$box/home:$HOME")
    a+=(-v "$BOXES/$box/tmp:/tmp")
    [[ "$DOTFILES_DIR" == "$SRC"/* || "$(readlink -f "$DOTFILES_DIR")" == "$(readlink -f "$HOME/.dotfiles")" ]] \
        || a+=(-v "$DOTFILES_DIR:$DOTFILES_DIR")
    a+=(-v "$HOME/.dotfiles:$HOME/.dotfiles")
    while read -r p; do
        mkdir -p "$HOME/$p"
        a+=(-v "$HOME/$p:$HOME/$p")
    done < <(mounts_of rw)
    while read -r p; do
        [[ -e "$HOME/$p" ]] || continue
        a+=(-v "$(readlink -f "$HOME/$p"):$HOME/$p:ro")
    done < <(mounts_of ro)
    # jj creates a per-repo metadata dir under ~/.config/jj/repos/<id> the
    # first time it touches a repository. The ro bind of .config/jj above
    # (agentbox/mounts) is deliberate — a box must not rewrite jj metadata the
    # host and other boxes trust — but it also made that first contact fail
    # with EROFS for any repository the host had not seen (a fresh clone,
    # `jj workspace add`). Overlay a box-private writable repos dir on top:
    # docker nests binds by destination, the parent stays ro, and the dirs are
    # cheap re-creatable metadata that lives under the box dir and dies with
    # it. The host-side mkdirs keep docker from creating a mountpoint inside
    # the ro parent.
    mkdir -p "$HOME/.config/jj/repos" "$BOXES/$box/jj-user-repos"
    a+=(-v "$BOXES/$box/jj-user-repos:$HOME/.config/jj/repos")
    # omp's runtime state under ~/.omp/run (daemon brokers, their sockets,
    # tokens and leases) holds for one PID and network namespace only: a
    # broker that starts deletes every sibling scope older than 5 minutes whose
    # pids it cannot see, and from another box it sees none. So each box gets
    # a private ~/.omp/run under its box dir, dying with it, while the rest of
    # ~/.omp stays shared. collab-hosts is bound back on top from the host so
    # `omp collab` discovery still spans the host and every box: its entries
    # and sockets live in that directory, and it prunes an entry only when its
    # socket is gone or refuses. Docker mounts by destination depth (~/.omp, then
    # ~/.omp/run, then collab-hosts); the host-side mkdirs make each
    # mountpoint the user's, 0700 like omp's own.
    mkdir -p -m 700 "$HOME/.omp/run" "$BOXES/$box/omp-run"
    mkdir -p -m 700 "$HOME/.omp/run/collab-hosts" "$BOXES/$box/omp-run/collab-hosts"
    a+=(-v "$BOXES/$box/omp-run:$HOME/.omp/run")
    a+=(-v "$HOME/.omp/run/collab-hosts:$HOME/.omp/run/collab-hosts")
    # A per-box runtime dir owned by ubuntu (omp refuses a root-owned one), with
    # the host sockets bound at their usual paths. Never the host's whole
    # /run/user/$UID_. secretsd/ is the token dir the omp extension writes to;
    # created here so it is the user's, 0700, not a root-owned mountpoint.
    # agent-secrets/ holds the box's broker key (written by keygen inside the box) and its
    # enrollment id (written by the launcher, enroll_box): tmpfs, this box only, gone with it.
    local run_user="$RUN_BASE/$box/run-user"
    mkdir -p "$run_user/bus" "$run_user/forward" "$run_user/secretsd" "$run_user/envoy" "$run_user/agent-secrets"
    chmod 700 "$run_user/secretsd" "$run_user/agent-secrets"
    a+=(-v "$run_user:/run/user/$UID_")
    a+=(-v "$(dirname "$BUS_SOCK"):/run/user/$UID_/bus")
    [[ -S "$SECRETSD_SOCK" ]] || die "secretsd socket $SECRETSD_SOCK missing (systemctl --user status secretsd.socket)"
    a+=(-v "$SECRETSD_SOCK:$SECRETSD_SOCK")
    # forward's sockets (arming, browser grant, pulse) all live in forward/,
    # mounted as a directory: a restarted `forward serve` rebinds them, which
    # a directory mount shows at once and a mount of a socket file would not.
    # Created here so a box started before the serve still sees it later.
    mkdir -p -m 700 "/run/user/$UID_/forward"
    a+=(-v "/run/user/$UID_/forward:/run/user/$UID_/forward")
    # The host's cached NATS nkey seed (scripts/envoy-nats-seed), which an envoy.json
    # `natsSeed: "!$HOME/.dotfiles/scripts/envoy-nats-seed --value"` command run in a box
    # reads. A directory, so the rename a refresh does reaches a running box,
    # and so an in-box fetch, when the host had none, lands in the host's cache.
    mkdir -p -m 700 "/run/user/$UID_/envoy"
    a+=(-v "/run/user/$UID_/envoy:/run/user/$UID_/envoy")
    # The relayed host tmux server (ensure_tmux_forwarder), as a directory holding
    # tmux-<box uid>/default, so a bare `tmux` in the box under TMUX_TMPDIR (session_env) finds
    # it and a relay restarted since the box started is seen at once. A host with no tmux has
    # no relay and the directory is empty, where `tmux` starts a server of the box's own.
    mkdir -p -m 700 "$BOX_TMUX_DIR/tmux-$BOX_UID"
    a+=(-v "$BOX_TMUX_DIR:/run/user/$UID_/tmux")
    # The inner dockerd's image store: anonymous, dies with the box.
    a+=(-v /var/lib/docker)
    printf '%s\n' "${a[@]}"
}

session_env() {
    local box="$1" e=()
    e+=(-e "XDG_RUNTIME_DIR=/run/user/$UID_")
    e+=(-e "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$UID_/bus/bus")
    # The host's tmux server through its relay, so `tmux new-window`, `send-keys` and
    # `capture-pane` in a box act on the host's panes, which is what a lead does. TMUX itself is
    # NOT set: a box is not inside a pane, and a tool that reads TMUX would address the wrong
    # terminal.
    e+=(-e "TMUX_TMPDIR=/run/user/$UID_/tmux")
    e+=(-e "HOME=$HOME" -e USER=ubuntu -e "TERM=${TERM:-xterm-256color}" -e "DOTFILES_DIR=$DOTFILES_DIR")
    e+=(-e "MISE_DATA_DIR=$HOME/.mise")
    # $HOME/.dotfiles/bin holds gitignored binaries (mise, a local jj) a
    # checkout under test does not have.
    e+=(-e "PATH=$DOTFILES_DIR/shims:$DOTFILES_DIR/bin:$HOME/.dotfiles/bin:$DOTFILES_DIR/scripts:$HOME/.mise/shims:$HOME/.local/bin:$HOME/.pulumi/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin")
    e+=(-e "JJ_CONFIG=$HOME/.config/jj/config.toml:$DOTFILES_DIR/.jjconfig.toml")
    # ~/.cache/ms-playwright is mounted rw from the host; without this, a box's `playwright
    # install` deletes the browser builds of every checkout it cannot see (agentbox/AGENTS.md).
    e+=(-e PLAYWRIGHT_SKIP_BROWSER_GC=1)
    # The team memory graph's server, which `ctx` (mise.toml) sends every command to, as host
    # shells get it from .bashrc. A box reaches the tailnet through the host, so the server names
    # a box's caller by the host's Tailscale login. The launcher's own value wins.
    e+=(-e "CTX_SERVER=${CTX_SERVER:-http://ctx-memory.tail12ec1c.ts.net}")
    # ECR: the box's instance role is already allowed, but docker only asks for it when the
    # config names a helper for that registry host — without the entry it sends nothing at all
    # ("no basic auth credentials", measured 2026-09-26). Pass the host's OWN ecr-login hosts so a
    # box mirrors the machine and no second list can drift; empty when the host has none.
    e+=(-e "AGENTBOX_ECR_HELPERS=$(jq -c '(.credHelpers // {}) | with_entries(select(.value == "ecr-login"))' "$HOME/.docker/config.json" 2>/dev/null || echo '{}')")
    # Also the inner dockerd's firewall rule (agentbox/entrypoint.sh).
    e+=(-e "AWS_EC2_METADATA_SERVICE_ENDPOINT=http://$NETWORK_GATEWAY:$IMDS_PORT")
    e+=(-e "AGENTBOX_IMDS_FORWARDER=$NETWORK_GATEWAY:$IMDS_PORT")
    # The host's Envoy forwarder, which the entrypoint relays the box's own
    # 127.0.0.1:$ENVOY_PORT to. No Envoy or Dispatch variable: a box session reads
    # its profile's envoy.json as a host session does (agentbox/mounts has the
    # neutral file's directory), and a variable here would override that file.
    e+=(-e "AGENTBOX_ENVOY_FORWARDER=$NETWORK_GATEWAY:$ENVOY_PORT")
    # Each forward channel this host serves, "addr:port,…", for the box's own relays
    # (entrypoint.sh). Read here rather than in the box, which cannot see the host's
    # loopback; a host with no forward running passes none and the box starts without them.
    forward_channels
    e+=(-e "AGENTBOX_FORWARD_CHANNELS=$(IFS=,; echo "${FORWARD_CHANNELS[*]}")")
    e+=(-e GIT_CONFIG_COUNT=1 -e GIT_CONFIG_KEY_0=include.path -e "GIT_CONFIG_VALUE_0=$DOTFILES_DIR/gh-app-routes.gitconfig")
    e+=(-e "AGENTBOX_BOX=$box" -e AGENTBOX_USER=ubuntu)
    # The box's disk limit, so a session and `agentbox doctor --here` can name the ceiling their
    # ENOSPC came from; 0 for a box started with --disk 0, which has no filesystem of its own.
    e+=(-e "AGENTBOX_DISK=$(if (( BOX_DISK_BYTES )); then size_text "$BOX_DISK_BYTES"; else echo 0; fi)")
    # The box's broker identity: its key dir (mount_args) and the broker. The launcher enrolls
    # the key once the box is up (enroll_box). No helper socket: a box is not a host session.
    e+=(-e "AGENT_SECRETS_URL=$AGENT_SECRETS_URL" -e "AGENT_SECRETS_KEY_DIR=/run/user/$UID_/agent-secrets")
    if curl -fsS -m 1 "http://127.0.0.1:${EMBED_PORT}/health" >/dev/null 2>&1; then
        e+=(-e "MNEMOPI_EMBEDDING_API_URL=http://$EMBED_NAME/v1")
    fi
    # The pane's tmux identity, as a host omp in the same pane sees it. TMUX_PANE
    # is how tmux-resurrect-omp finds the omp inside the box; TMUX is how omp
    # knows to wrap graphics and notification sequences in tmux's DCS
    # passthrough - without it the bare kitty APC it emits on every reflow
    # reaches tmux, which takes any APC string as the pane title
    # ("Ga=d,d=A,q=2"); TERM_PROGRAM(_VERSION) is what its hyperlink policy
    # reads.
    #
    # TMUX is `<socket>,<server pid>,<session index>`, and tmux itself reads that socket before
    # it ever looks at TMUX_TMPDIR. The host's socket path is not mounted, so a box that got the
    # host's value verbatim had a `tmux` that answered `error connecting to
    # /home/sami/.tmux/sockets/tmux-1000/default (No such file or directory)` while the relay
    # sat unused beside it (measured 2026-11-01 in agentbox-9edcc822bf2b). So the socket field
    # is replaced with the relay's path inside the box and the rest is kept: omp still knows it
    # is under tmux, and tmux reaches the host's server.
    local v
    for v in TMUX_PANE TERM_PROGRAM TERM_PROGRAM_VERSION; do
        [[ -n "${!v:-}" ]] && e+=(-e "$v=${!v}")
    done
    if [[ -n "${TMUX:-}" ]]; then
        host_tmux_sock
        if [[ -n "$HOST_TMUX_SOCK" ]]; then
            e+=(-e "TMUX=/run/user/$UID_/tmux/tmux-$BOX_UID/default,${TMUX#*,}")
        else
            e+=(-e "TMUX=$TMUX")
        fi
    fi
    printf '%s\n' "${e[@]}"
}

# The session id of the omp running in a box: the file it holds open,
# ~/.omp/agent/sessions/<dir>/<ts>_<id>.jsonl, read from its fd table (omp
# exports OMP_SESSION_ID to its children, not itself) - or, when none is open
# (idle after a resume or a full-file rewrite), the newest session file of the
# box's own directory under <boxes>, which omp keys by cwd and whose box name is
# never reused. A box working in a host directory (--dir) has no such fallback,
# on purpose: omp keys that directory by the path, which the host and every
# other box naming it share, so its newest file is very often another session's
# - measured 2026-11-01, where a glob by working directory answered with a live
# HOST session's id for both test boxes. Acting on that id would notify the
# wrong session on `agentbox restart` and release ANOTHER session's knives
# claims at close, so an empty answer is the right one. Empty also until a
# session has materialized, and for a --no-session run.
box_session_id() {
    local sid
    sid="$(docker exec "$1" sh -c '
        for p in $(pgrep -x omp); do
            for fd in /proc/$p/fd/*; do
                readlink "$fd" 2>/dev/null
            done
        done | sed -n "s#.*/\\.omp/agent/sessions/[^/]*/[0-9T:-]*Z_\\([0-9a-f-]\\{36\\}\\)\\.jsonl\$#\\1#p" | head -1' 2>/dev/null || true)"
    [[ -n "$sid" ]] && { echo "$sid"; return 0; }
    # Callers run under set -e: this must succeed, empty, while no file exists.
    local files
    files="$(ls -t "$HOME/.omp/agent/sessions/-boxes-$1-"*/*.jsonl 2>/dev/null || true)"
    sed -n '1s#.*Z_\([0-9a-f-]\{36\}\)\.jsonl$#\1#p' <<<"$files"
}

# A clone and the close-phase knives run in their own session (`setsid`): the
# pane's hangup reaches only the terminal's session, and jj, which knives runs,
# cannot be made to ignore it - it installs its own SIGHUP handler (ctrlc,
# "termination") that exits 1, replacing whatever disposition it inherited.
# `-w` returns the child's status.
detached() { setsid -w "$@"; }

# Release every knives claim the session holds. Claims are keyed by the omp
# session id (kind harness-session), so acting as that session releases them
# without --force; knives forgets and removes the workspace itself and keeps
# the commits. A claim's `repo` is its fork's lowercase upstream name
# (`metr/hawk`), which `knives repos --json` reports as `upstream_name`
# beside the checkout path.
finish_knives_claims() {
    local sid="$1" state="$HOME/.config/knives/state.json" repo branch path
    [[ -n "$sid" && -s "$state" ]] || return 0
    while IFS=$'\t' read -r repo branch; do
        [[ -n "$repo" && -n "$branch" ]] || continue
        # `knives repos` exits 3 whenever its scan has a problem (an ambiguous
        # checkout, a fork not on this machine) and still prints every row, so
        # judge the JSON, not the exit status: under set -euo pipefail the
        # status would abort close_box before it released anything.
        path="$( { detached knives repos --json 2>/dev/null || true; } | jq -r --arg r "$repo" '.repos[] | select(.upstream_name == $r) | .path')"
        if [[ -z "$path" || ! -d "$path" ]]; then
            echo "agentbox: knives claim $repo/$branch: checkout not found; left as is" >&2
            continue
        fi
        if ! (cd "$path" && OMP_SESSION_ID="$sid" detached knives finish "$branch"); then
            echo "agentbox: knives finish $repo/$branch failed; left as is" >&2
        fi
    done < <(jq -r --arg s "$sid" '.. | objects | select(.owner? == $s) | "\(.repo)\t\(.branch)"' "$state")
}

# The template of one repo, at the remote's current default branch: made on first use as a clone
# without old file contents (git fetches a file's contents from GitHub the first time something
# reads them), with the repo's sparse patterns (CLONE_SPARSE) set before the first checkout so the
# files it keeps arrive in one fetch, then brought up to date by a fetch on every launch. Automatic
# maintenance is off: with it on, every on-demand fetch starts a background repack, and adding 1,040
# small files to a test clone took over 900 s, a repack notice after each file's fetch; with it off,
# adding a 94-file task took 1.4 s. Callers hold the repo's template lock and run this under `||`,
# where set -e does not apply, so every step checks its own status.
refresh_template() {
    local repo="$1" tpl="$CLONE_TEMPLATES/$1" url upstream pats=()
    if [[ ! -d "$tpl/.git" ]]; then
        url="$(git -C "$SRC/$repo" remote get-url origin)" || return 1
        rm -rf "$tpl.partial"
        detached "${APP_GIT[@]}" clone --quiet --filter=blob:none --no-checkout "$url" "$tpl.partial" >&2 || return 1
        git -C "$tpl.partial" config gc.auto 0 && git -C "$tpl.partial" config maintenance.auto false || return 1
        if [[ -n "${CLONE_SPARSE[$repo]:-}" ]]; then
            read -ra pats <<<"${CLONE_SPARSE[$repo]}"
            "${APP_GIT[@]}" -C "$tpl.partial" sparse-checkout set --no-cone "${pats[@]}" || return 1
        fi
        mv "$tpl.partial" "$tpl" || return 1
    fi
    detached "${APP_GIT[@]}" -C "$tpl" fetch --quiet --prune origin >&2 || return 1
    upstream="$(git -C "$tpl" symbolic-ref --short refs/remotes/origin/HEAD)" || return 1
    detached "${APP_GIT[@]}" -C "$tpl" checkout --quiet -f -B "${upstream#origin/}" "$upstream" >&2
}

# A template's object store into a box's clone: hard-linked on one filesystem, copied across two.
# `cp -al` fails with EXDEV the moment the box has a filesystem of its own, and the device of the
# destination's parent is what decides, since the destination does not exist yet.
copy_objects() {
    local src="$1" dest="$2"
    if [[ "$(stat -c %d "$src")" == "$(stat -c %d "$(dirname "$dest")")" ]]; then
        cp -al "$src" "$dest"
    else
        cp -a "$src" "$dest"
    fi
}

# The box's git clone of one repo at $ws: a copy of the repo's template, refreshed first. Its .git is
# copied, all but the objects and the index; the objects are hard-linked where the template and the
# box tree are on one filesystem, which is what a local `git clone` does and is safe because git
# never changes an object file in place. A box with a disk limit has a filesystem of its own
# (open_box_disk), where a hard link cannot reach the template, and the objects are copied instead:
# a quota that bounds a box has to own the bytes it bounds, so there is nothing to share. A checkout
# from those local objects then writes the working tree and a fresh index, needing no network. Each
# box's clone is its own repository - refs, config and index - and stays whole if the template is
# rebuilt or deleted. A fresh clone of agent-c took 64-78 s at load 200 (2026-10-02), almost all of
# it the checkout fetching the kept files' contents; the copy took 1.4 s and its checkout 17.6 s. (A
# local `git clone` of a clone without old file contents fails: `pack has 1 unresolved delta`.) The
# lock keeps a launch from copying a template another launch is refreshing.
clone_checkout() {
    local repo="$1" ws="$2" tpl
    tpl="$CLONE_TEMPLATES/$repo"
    mkdir -p "$CLONE_TEMPLATES" || return 1
    if ! {
        flock 9 \
            && refresh_template "$repo" \
            && mkdir -p "$ws/.git" \
            && tar -C "$tpl/.git" --exclude=./objects --exclude=./index -cf - . | tar -C "$ws/.git" -xf - \
            && copy_objects "$tpl/.git/objects" "$ws/.git/objects"
    } 9>"$CLONE_TEMPLATES/$repo.lock"; then
        echo "agentbox: could not copy $repo from its template $tpl; remove that directory to have the next launch rebuild it" >&2
        return 1
    fi
    detached git -C "$ws" checkout --quiet -f HEAD >&2
}

# What a box's clone holds that its remote does not, as one line, empty when nothing: uncommitted
# changes, tracked or untracked, and each branch, stash or detached HEAD with commits no
# remote-tracking ref reaches. A clone the launcher never finished checking out holds nothing; one git
# cannot read says so, and close_box keeps it like any other.
unpushed_work() {
    local ws="$1" status ref found=()
    git -C "$ws" rev-parse --verify --quiet HEAD >/dev/null || return 0
    if ! status="$(git -C "$ws" status --porcelain 2>&1)"; then
        echo "a checkout git cannot read: ${status%%$'\n'*}"
        return 0
    fi
    if [[ -n "$status" ]]; then found+=("$(wc -l <<<"$status") uncommitted paths"); fi
    if ! git -C "$ws" symbolic-ref --quiet HEAD >/dev/null && [[ -n "$(git -C "$ws" rev-list -1 HEAD --not --remotes)" ]]; then
        found+=("a detached HEAD")
    fi
    while read -r ref; do
        if [[ -n "$(git -C "$ws" rev-list -1 "$ref" --not --remotes)" ]]; then found+=("${ref#refs/heads/}"); fi
    done < <(git -C "$ws" for-each-ref --format='%(refname)' refs/heads refs/stash)
    if (( ${#found[@]} )); then echo "${found[*]}"; fi
    return 0
}

# Everything the box made goes: the knives claims its session holds, then the directory. The
# container must be gone first — it holds the mounts, and docker recreates a removed mountpoint
# root-owned. The work in a clone is its agent's to push or remove (Sami, AGENTC-1420, 2026-10-02:
# "Just tell the agents to migrate off of the JJ workspaces, and then they can handle it"), and
# nothing is saved for it; a clone holding work its remote does not have keeps the whole box
# directory in place, named on the pane, so nothing is discarded unseen.
close_box() {
    local box="$1" sid="$2" repo ws work kept=0 _
    shift 2
    for _ in $(seq 1 60); do
        docker inspect "$box" >/dev/null 2>&1 || break
        sleep 1
    done
    if docker inspect "$box" >/dev/null 2>&1; then
        echo "agentbox: $box is still running after 60s; removing it" >&2
        docker rm -f "$box" >/dev/null 2>&1 || true
    fi
    # An omp in the box may have queued this pane for the attention cockpit, and
    # its own shutdown drop died with the container. The launcher runs in the same
    # host pane, so it drops that pane here, stamped after everything the box sent.
    if [[ -n "${TMUX_PANE:-}" ]]; then
        "$DOTFILES_DIR/scripts/tmux-attention" drop "$TMUX_PANE" >/dev/null || true
    fi
    # The container is gone: nothing inside can use the key any more, and the broker must not
    # accept it either. Before the rm -rf below, which takes the key dir with it.
    unenroll_box "$box"
    finish_knives_claims "$sid"
    for repo in "$@"; do
        ws="$BOXES/$box/$repo"
        [[ -d "$ws/.git" ]] || continue
        work="$(unpushed_work "$ws")"
        if [[ -n "$work" ]]; then
            echo "agentbox: $ws holds work its remote does not have ($work); $BOXES/$box is left in place for its owner to push or remove" >&2
            if mountpoint -q "$BOXES/$box" 2>/dev/null; then
                echo "agentbox: that directory is the box's own filesystem; release it with: sudo umount '$BOXES/$box' && rm -f '$BOX_DISKS/$box.img'" >&2
            fi
            kept=1
        fi
    done
    rm -rf "${RUN_BASE:?}/$box"
    # The box's own filesystem takes everything in it (close_box_disk), leaving the mountpoint
    # for the rm below; a box with no disk limit has no image and the rm does all of it. A
    # filesystem that will not unmount keeps its directory, with the command that frees it.
    if (( ! kept )) && close_box_disk "$box"; then
        rm -rf "${BOXES:?}/$box"
    fi
}

cmd_new() {
    local usage="usage: agentbox new [-e NAME[=VALUE]]… [--memory SIZE] [--cpus N] [--disk SIZE] [--dir PATH]… [<repo>…] -- <cmd> [args…]"
    local user_env=() box_repos=() repo
    # Where each limit came from, so a refusal names what the caller actually set.
    local mem_from="AGENTBOX_MEMORY" cpu_from="AGENTBOX_CPUS" disk_from="AGENTBOX_DISK"
    [[ -n "${AGENTBOX_MEMORY:-}" ]] || mem_from="the default memory limit"
    [[ -n "${AGENTBOX_CPUS:-}" ]] || cpu_from="the default cpu limit"
    [[ -n "${AGENTBOX_DISK:-}" ]] || disk_from="the default disk limit"
    while (( $# )) && [[ "$1" != -- ]]; do
        case "$1" in
            -e)
                [[ "${2:-}" =~ ^[A-Za-z_][A-Za-z0-9_]*(=.*)?$ ]] || die "-e takes NAME or NAME=VALUE, got '${2:-}'  ($usage)"
                user_env+=(-e "$2")
                shift 2
                ;;
            --memory)
                [[ -n "${2:-}" ]] || die "--memory takes a size, e.g. --memory 32g  ($usage)"
                BOX_MEMORY="$2" mem_from="--memory"
                shift 2
                ;;
            --cpus)
                [[ -n "${2:-}" ]] || die "--cpus takes a number of cores, e.g. --cpus 4  ($usage)"
                BOX_CPUS="$2" cpu_from="--cpus"
                shift 2
                ;;
            --disk)
                [[ -n "${2:-}" ]] || die "--disk takes a size, e.g. --disk 64g, or 0 for no limit  ($usage)"
                BOX_DISK="$2" disk_from="--disk"
                shift 2
                ;;
            --dir)
                [[ -n "${2:-}" ]] || die "--dir takes an existing directory, e.g. --dir ~/src/bet-grade  ($usage)"
                add_box_dir "$2"
                shift 2
                ;;
            -*) die "unknown option '$1'; the command goes after \`--\`  ($usage)" ;;
            *) box_repos+=("$1"); shift ;;
        esac
    done
    set_resource_args "$mem_from" "$cpu_from"
    set_disk_bytes "$disk_from"
    [[ "${1:-}" == -- ]] && (( ${#box_repos[@]} + ${#BOX_DIRS[@]} )) \
        || die "$usage  (a box needs a repo or a --dir; repos: $(repos | tr '\n' ' '))"
    shift
    (( $# )) || die "$usage"
    for repo in "${box_repos[@]}"; do
        [[ -d "$SRC/$repo" ]] || die "no checkout $SRC/$repo (repos: $(repos | tr '\n' ' '))"
        git -C "$SRC/$repo" remote get-url origin >/dev/null 2>&1 || die "$SRC/$repo has no origin remote to clone from"
    done
    local dup
    if (( ${#box_repos[@]} )); then
        dup="$(printf '%s\n' "${box_repos[@]}" | sort | uniq -d)"
        [[ -z "$dup" ]] || die "repo listed twice: $dup"
    fi
    local use_broker=1
    broker_ready || use_broker=0
    local box tag
    box="agentbox-$(tr -d '-' </proc/sys/kernel/random/uuid | cut -c1-12)"
    echo "agentbox: box $box" >&2
    if (( ! use_broker )); then
        echo "agentbox: $box starts without a secrets-broker identity, so its agents use secretsd: $BROKER_UNREADY" >&2
    fi
    tag="$(image_tag)"
    build_image "$tag"
    ensure_network
    ensure_forwarders

    # From here the box has state on disk: whatever fails before or during the
    # session, its directory never outlives the launcher (close_box).
    # Values are expanded now (the trap outlives this function's locals) and
    # the trap runs only in the launcher itself, never in a $(…) subshell,
    # which inherits EXIT traps in bash.
    local launcher_pid=$BASHPID
    # shellcheck disable=SC2064
    trap "[[ \$BASHPID == $launcher_pid ]] && close_box '$box' '' $(printf '%q ' "${box_repos[@]}")" EXIT
    # A pane kill or TERM lands here; the trap forwards a hangup into the box
    # (--init delivers it to the command), --rm fires, close runs. Before the
    # box exists it is remembered instead and honoured once the clone returns.
    # After a hangup the terminal is gone: a write to it fails with EIO, and
    # under set -e the first chatty step of close_box (an echo) would end the
    # launcher before the rm -rf - which is how ~/boxes/<box> trees outlived
    # their boxes. Nothing printed from here on has a reader.
    local interrupted=0
    trap 'interrupted=1; docker kill -s SIGHUP "$box" >/dev/null 2>&1 || true; exec >/dev/null 2>&1' HUP
    trap 'interrupted=1; docker kill -s SIGHUP "$box" >/dev/null 2>&1 || true' TERM INT
    open_box_disk "$box"
    # Every repo is cloned at once, each in a subshell that ignores the hangup and TERM/INT: the
    # launcher acts on those itself, once every clone has returned, and the clones' git runs detached
    # (see `detached`). A trapped signal ends `wait` early with 128+n while the clone still runs, so a
    # clone that is still alive is waited for again.
    local pids=() pid rc failed=0
    for repo in "${box_repos[@]}"; do
        ( trap '' HUP TERM INT; clone_checkout "$repo" "$BOXES/$box/$repo" ) &
        pids+=("$!")
    done
    for pid in "${pids[@]}"; do
        while :; do
            rc=0; wait "$pid" || rc=$?
            (( rc > 128 )) && kill -0 "$pid" 2>/dev/null && continue
            break
        done
        (( rc == 0 )) || failed=1
    done
    (( failed )) && exit 1
    (( interrupted )) && exit 130

    local mounts=() env=()
    mapfile -t mounts < <(mount_args "$box")
    # mount_args made the key dir. From the legion #1589 release, enrollment.pending tells the
    # box's agent-secrets that an enrollment is on its way; enroll_box renews it and ends it
    # either way. A box with no broker identity gets no marker and no key.
    if (( use_broker )); then : >"$(box_keydir "$box")/enrollment.pending"; fi
    mapfile -t env < <(session_env "$box")
    # omp runs under the in-box runner so `restart` can relaunch it in the same
    # container (scripts/agentbox-run.ts); any other command runs bare.
    local cmd=("$@")
    if [[ "$1" == omp ]]; then cmd=(bun "$DOTFILES_DIR/scripts/agentbox-run.ts" "$@"); fi
    # Where the box works: its first clone, as always, or - for a box given directories instead
    # of repositories - the first of those.
    local workdir="${BOX_DIRS[0]:-}"
    if (( ${#box_repos[@]} )); then workdir="$BOXES/$box/${box_repos[0]}"; fi
    local tty=(-i)
    [[ -t 0 && -t 1 ]] && tty=(-it)
    # Not exec'd: close_box must run after the container exits, whatever the
    # exit reason.
    local rc=0 child sid="" stdin_fd
    # The explicit stdin dup matters: a job-control-less background child gets
    # /dev/null for stdin, which -it refuses ("stdin is not a terminal").
    exec {stdin_fd}<&0
    # --log-driver none: stdout is the omp TUI's redraw stream, gigabytes a day
    # per box that nothing reads (the transcript is in ~/.omp; attach is live).
    docker run --rm --init --runtime "$RUNTIME" --name "$box" --hostname "$box" --log-driver none \
        --network "$NETWORK" --dns 100.100.100.100 --dns 1.1.1.1 \
        "${RESOURCE_ARGS[@]}" \
        -w "$workdir" "${tty[@]}" \
        "${mounts[@]}" "${env[@]}" "${user_env[@]}" "$tag" "${cmd[@]}" <&"$stdin_fd" &
    child=$!
    # The broker identity first (enroll_when_up), when the host can give one.
    if (( use_broker )); then enroll_when_up "$box" "$child" "$1" || true; fi
    # An omp inside reveals its session id once up; close releases that
    # session's knives claims. Other commands have none.
    while kill -0 "$child" 2>/dev/null; do
        sid="$(box_session_id "$box")"
        [[ -n "$sid" ]] && break
        sleep 2
    done
    # An interrupted wait re-waits: the first return after a signal carries
    # 128+sig, the child's real status arrives once it is reaped.
    while :; do
        if wait "$child"; then rc=0; else rc=$?; fi
        kill -0 "$child" 2>/dev/null || break
    done
    # The pane can go away while close is still running (a pane kill, a server
    # exit). That must not stop the box's removal: the launcher ignores the
    # hangup from here on (knives runs in its own session, see `detached`), and
    # its output goes through a reader that writes to the terminal while it
    # exists and drops the rest - a direct write to a hung-up pty fails with
    # EIO, which set -e would turn into an exit before the rm -rf.
    trap - TERM INT EXIT
    trap '' HUP
    exec > >(while IFS= read -r line; do printf '%s\n' "$line" 2>/dev/null || :; done) 2>&1
    close_box "$box" "$sid" "${box_repos[@]}"
    exit "$rc"
}

# The box a target names: a running box (exact name or unique prefix), or the
# omp session id (or prefix) of the omp running in one.
resolve_box() {
    local target="$1" b matches=()
    mapfile -t matches < <(docker ps --filter name='^agentbox-' --format '{{.Names}}' | grep -E "^(agentbox-)?${target}" || true)
    if (( ${#matches[@]} == 1 )); then printf '%s\n' "${matches[0]}"; return 0; fi
    for b in $(docker ps --filter name='^agentbox-' --format '{{.Names}}'); do
        if [[ "$(box_session_id "$b")" == "$target"* ]]; then printf '%s\n' "$b"; return 0; fi
    done
    return 1
}

cmd_sh() {
    local target="${1:-}"
    [[ -n "$target" ]] || die "box name or session id required"
    shift
    local box wdir
    box="$(resolve_box "$target")" || die "no running box matches $target"
    wdir="$(docker inspect -f '{{.Config.WorkingDir}}' "$box")"
    local tty=(-i)
    [[ -t 0 && -t 1 ]] && tty=(-it)
    local cmd=("$@")
    (( ${#cmd[@]} )) || cmd=(bash)
    # docker exec carries the container's launch env (PATH, routing, sockets);
    # only the caller's terminal needs passing through.
    exec docker exec "${tty[@]}" --user ubuntu -e "TERM=${TERM:-xterm-256color}" -w "$wdir" "$box" "${cmd[@]}"
}

cmd_rebuild() {
    local tag
    tag="$(image_tag)"
    build_image "$tag"
    local stale
    stale="$(docker ps --filter name='^agentbox-' --format '{{.Names}} {{.Image}}' | awk -v t="$tag" '$2 != t {print $1}')"
    if [[ -n "$stale" ]]; then
        echo "agentbox: boxes on an older image (they move to it in a new box, not via agentbox restart):" >&2
        echo "$stale" >&2
    fi
    echo "agentbox: image $tag"
}

# What a path uses, for a listing: never a failure, since `set -o pipefail` would otherwise make
# one unreadable directory inside a box tree end the whole command (it did, on the ext4 image's
# root-owned lost+found, before open_box_disk gave that one to the user).
dir_size() { du -sh --one-file-system "$1" 2>/dev/null | cut -f1 || true; }

# Running boxes, then anything a box left on disk and nothing is using: a tree kept at close for
# unpushed work, or one whose launcher was killed before it could close (the trap cannot run on a
# SIGKILL, and a reboot drops the loop mount while the image keeps its contents). Nothing is
# removed here - the tree may hold an agent's only copy of its work - so each one is named with
# the command that frees it.
cmd_ls() {
    docker ps --filter name='^agentbox-' --format 'table {{.Names}}\t{{.Image}}\t{{.Status}}'
    local running box dir img left=()
    running="$(docker ps -a --filter name='^agentbox-' --format '{{.Names}}')"
    for dir in "$BOXES"/agentbox-*; do
        [[ -d "$dir" ]] || continue
        box="${dir##*/}"
        if grep -qxF "$box" <<<"$running"; then continue; fi
        img="$BOX_DISKS/$box.img"
        if mountpoint -q "$dir" 2>/dev/null; then
            left+=("$box  $(dir_size "$dir") on its own filesystem; release: sudo umount '$dir' && rm -f '$img' && rmdir '$dir'")
        elif [[ -s "$img" ]]; then
            left+=("$box  an unmounted filesystem image ($(dir_size "$img") used); read it: sudo mount -o loop '$img' '$dir'")
        else
            left+=("$box  $(dir_size "$dir"); release: rm -rf '$dir'")
        fi
    done
    (( ${#left[@]} )) || return 0
    echo
    echo "box trees with no box running:"
    printf '  %s\n' "${left[@]}"
}

# The runner's pid in a box (agentbox-run.ts is pid 1's only child), empty for
# a box running something else - a bare omp would take SIGUSR1 itself.
box_runner_pid() {
    docker exec "$1" sh -c 'p=$(pgrep -P 1 | head -1); [ -n "$p" ] && tr "\0" " " </proc/$p/cmdline | grep -q agentbox-run && echo "$p"' 2>/dev/null || true
}

RESTART_NOTICE='agentbox: a restart of your omp is pending (new omp/plugins on the host). Finish the current step and start no new subagents or long jobs. When `read proc://` lists none of your jobs or services still running, run `agentbox restart` from your bash tool: omp quits gracefully and relaunches in this same box with --resume of this session; the box, its workspace and /tmp stay, supervised processes only if started with persist. If you are idle, do it now.'

cmd_restart() {
    # Inside a box this is the agent's own trigger. omp's bash tool has a
    # builtin kill that refuses the shell's ancestors - the runner is one - so
    # the signal is sent from here, a real process.
    if [[ -n "${AGENTBOX_RUNNER_PID:-}" ]]; then
        (( $# == 0 )) || die "inside a box, agentbox restart takes no arguments: it restarts this session"
        exec kill -USR1 "$AGENTBOX_RUNNER_PID"
    fi
    local now=false all=false t targets=() boxes=() box sid
    for t in "$@"; do
        case "$t" in
            --now) now=true ;;
            --all) all=true ;;
            -*) die "unknown option $t" ;;
            *) targets+=("$t") ;;
        esac
    done
    if $all; then
        mapfile -t boxes < <(docker ps --filter name='^agentbox-' --format '{{.Names}}')
    else
        (( ${#targets[@]} )) || die "usage: agentbox restart <box|session-id>… | --all [--now]"
        for t in "${targets[@]}"; do
            box="$(resolve_box "$t")" || die "no running box matches $t"
            boxes+=("$box")
        done
    fi
    for box in "${boxes[@]}"; do
        if [[ -z "$(box_runner_pid "$box")" ]]; then
            echo "agentbox: $box does not run omp under the runner; quit it and relaunch with --resume instead" >&2
            continue
        fi
        if $now; then
            # pid 1 (docker-init) forwards the signal to the runner.
            docker kill -s USR1 "$box" >/dev/null
            echo "agentbox: $box restarting now"
            continue
        fi
        sid="$(box_session_id "$box")"
        [[ -n "$sid" ]] || { echo "agentbox: $box: omp holds no session file open right now; retry, or use --now" >&2; continue; }
        envoy send "$sid" "$RESTART_NOTICE" >/dev/null || die "envoy send to $sid failed"
        echo "agentbox: $box (session $sid) notified; it restarts when it reaches a safe point"
    done
}

# ── move: the sessions already running on this host (dispatch://INFRA-702) ───────────────────
#
# `agentbox new` starts a box for a NEW session. `move` is for the ones already running on the
# host: it reads every live top-level omp outside a box, works out the box each one would get,
# and relaunches its pane into that box with `omp --resume <id>`, so the session comes back with
# its id, its transcript and the tree it works in.
#
# WHY A MOVE NEVER NAMES A REPO. `agentbox new <repo>` gives the box a clone of its own and
# works in it (cmd_new: a repo wins the working directory). For a NEW session that is right. For
# a LIVE one it is not: the session would come back in a tree that is not the one it had - no
# uncommitted changes, no index, no branch, and, for the 17 sessions sharing
# ~/src/example-task-repo on 2026-11-01, none of each other's work either. $SRC is
# bind-mounted read-write into every box already (mount_args), so `--dir <cwd>` of a checkout or
# of a worktree under it adds no mount and no clone at all, and the session resumes in exactly
# the directory it was in. So a move's spec is --dir only, and the only new disk it claims is
# the box's own sparse filesystem image. A session that wants a clone of its own asks for one
# the ordinary way, after the move: `agentbox new <repo> -- omp --resume <id>`.
#
# A move hangs omp up (SIGHUP: the ordinary graceful teardown agentbox-run.ts uses for a
# restart), waits for it to go, and only then respawns its pane into the launcher - from a
# DETACHED process, because `move --self` runs in the session's own bash tool and dies with the
# omp it hangs up.

# /proc, so the census can be run against a fixture tree (scripts/tests/test_agentbox_move.py).
# Nothing else reads it.
PROC="${AGENTBOX_PROC:-/proc}"

# The field separator of a census row. NOT a tab: a tab is an IFS whitespace character, so
# `IFS=$'\t' read` folds two of them into one and every field after an empty one shifts left -
# which read a session's pane id as its session id while this was being written. A unit
# separator is not whitespace, so empty fields survive.
SEP=$'\x1f'

# What free space a move must leave on the disk the boxes are on: a hard reserve, 20 GiB on
# /mnt/nvme and 10 GiB on the root disk. Not disk-fill-watch's alert floors (84 GB, 18 GiB): those
# tell a person early, and a move refused at them stopped all 70 ready sessions at 17:32Z on
# 2026-11-01 while a box claims about 0.3 GiB at launch (its sparse image). This bounds what the
# moves claim at launch, not what the sessions can later grow into.
move_floor_bytes() {
    local target
    target="$(df --output=target "$1" 2>/dev/null | tail -1 || true)"
    case "$target" in
        /mnt/nvme) echo 21474836480 ;;
        *) echo 10737418240 ;;
    esac
}

move_free_bytes() { df -B1 --output=avail "$1" 2>/dev/null | tail -1 || echo 0; }

# Bytes as GiB, for a line a person reads.
move_gib() { awk -v b="$1" 'BEGIN { printf "%.1f", b / 1073741824 }'; }

# What ONE box claims on the host's disk the moment it starts: its own filesystem image
# (open_box_disk) and, since a move clones nothing, nothing else. The image is sparse, so only
# ext4's metadata is written and the rest of the limit is claimed as the session writes. The
# number is measured, not guessed: one mkfs of the size this move would use, in the directory
# the real images go in, read with du and removed (32 GiB → 261 MiB, 2 GiB → 66 MiB on this
# host, 2026-11-01). Measured once per run.
MOVE_IMAGE_BYTES=""
move_image_bytes() {
    local bytes="$1" probe used=""
    if [[ -n "$MOVE_IMAGE_BYTES" ]]; then echo "$MOVE_IMAGE_BYTES"; return 0; fi
    if (( ! bytes )); then MOVE_IMAGE_BYTES=0; echo 0; return 0; fi
    mkdir -p "$BOX_DISKS" 2>/dev/null || { echo 0; return 0; }
    probe="$BOX_DISKS/.move-probe.$$.img"
    rm -f "$probe"
    if truncate -s "$bytes" "$probe" 2>/dev/null \
        && PATH="$PATH:/usr/sbin:/sbin" mkfs.ext4 -q -F -m 0 "$probe" 2>/dev/null; then
        used="$(du -s --block-size=1 "$probe" 2>/dev/null | cut -f1 || true)"
    fi
    rm -f "$probe"
    MOVE_IMAGE_BYTES="${used:-0}"
    echo "$MOVE_IMAGE_BYTES"
}

# Refuse a move that would take the disk under that reserve. One box at a time: the check is made
# again by every session that moves, so a window that runs out of room stops itself.
#
# MOVE_FORCE_FLOOR (the `--force-floor` flag) says the person running the window has decided
# otherwise and prints what it is overriding.
MOVE_FORCE_FLOOR=false
move_check_floor() {
    local image="$1" dir free floor
    dir="$(dirname "$BOXES")"
    free="$(move_free_bytes "$dir")"
    floor="$(move_floor_bytes "$dir")"
    if (( free - image < floor )); then
        if $MOVE_FORCE_FLOOR; then
            echo "agentbox: --force-floor: a box leaves $(move_gib $((free - image))) GiB free on $dir, under its $(move_gib "$floor") GiB reserve; moving anyway" >&2
            return 0
        fi
        echo "a box would leave $(move_gib $((free - image))) GiB free on $dir, under its $(move_gib "$floor") GiB reserve; free space first, then move, or --force-floor to decide otherwise" >&2
        return 1
    fi
    return 0
}

move_within() { [[ "$1" == "$2" || "$1" == "$2"/* ]]; }

# ── the paths a box must be given ────────────────────────────────────────────────────────────
#
# A move's spec was the session's working directory and its git tree, and nothing else. That is
# not the tree a lane works in. Measured over the sessions notified on 2026-11-01: a session
# whose cwd is ~/src/oss-verifier writes in /mnt/nvme/sami/oss-verifier/..., /mnt/nvme/sami/tmp/...
# and ~/.worktrees/...; session 01a16640's cwd is ~/Code/legion, a real checkout of legion, while
# the worktrees it has open are ~/src/legion/.worktrees/infra-140-s5 and
# /mnt/nvme/sami/worktrees/legion/stopped-tree - so the cwd alone would have given it a box whose
# `git status` answers about ANOTHER checkout. A path a box is not given is not absent inside it:
# a home path is silently writable into the box's own filesystem and lost with the box
# (agentbox/AGENTS.md), which is the dangerous failure. So the spec is inferred from what the
# session's own processes actually use, and `--plan` and the notice print every path with why it
# was chosen, so a lane sees its box before it moves and adds what is missing with
# `agentbox move --self --dir PATH`.

# The roots that hold MANY sessions' trees. A path below one of these is never mounted at the
# root: the box gets the first directory under it, which is the session's own tree. The deepest
# matching root wins, so /mnt/nvme/<user>/tmp/<name> keeps <name> rather than tmp. A git working
# tree is resolved by git instead (move_resolve_dir), which is the exact boundary where there is
# one; this is the bound for everything else. AGENTBOX_MOVE_ROOTS (colon-separated) replaces the
# list, as AGENTBOX_PROC replaces /proc: the test fixture's own temporary tree lives under one of
# these roots on this host, which would otherwise make the suite's answers depend on TMPDIR.
MOVE_SHARED_ROOTS=()
move_shared_roots() {
    if (( ${#MOVE_SHARED_ROOTS[@]} )); then return 0; fi
    if [[ -n "${AGENTBOX_MOVE_ROOTS:-}" ]]; then
        IFS=: read -r -a MOVE_SHARED_ROOTS <<<"$AGENTBOX_MOVE_ROOTS"
        return 0
    fi
    local nvme="/mnt/nvme/$(id -un)"
    MOVE_SHARED_ROOTS=("$HOME/Code" "$HOME/Code/personal" "$HOME/.worktrees" "$HOME/tmp")
    # session-tmp holds one directory per session (devbox/session-scratch-reap) and tmp one per
    # `work-dir NAME`, so both are roots and neither is ever a path a box is given.
    MOVE_SHARED_ROOTS+=("$nvme" "$nvme/tmp" "$nvme/session-tmp" "$nvme/worktrees" "$nvme/scratch")
}

# The paths every box already has at their own path: $SRC and the targets of its symlinks, the
# dotfiles, and every entry of the home allow-list (agentbox/mounts). An inferred path under one
# of them is left out of the spec - naming it would change nothing. A worktree under
# ~/src/<repo>/.worktrees/... is in this class: $SRC is bind-mounted read-write into every box,
# so such a tree IS in the box, with no --dir at all.
MOVE_IN_BOX=()
move_in_box_paths() {
    if (( ${#MOVE_IN_BOX[@]} )); then return 0; fi
    local p
    MOVE_IN_BOX=("$SRC" "$HOME/.dotfiles" "$DOTFILES_DIR")
    for p in "$SRC"/*; do
        [[ -L "$p" ]] || continue
        MOVE_IN_BOX+=("$(readlink -f "$p")")
    done
    while read -r p; do [[ -n "$p" ]] && MOVE_IN_BOX+=("$HOME/$p"); done < <(mounts_of rw; mounts_of ro)
}

move_within() { [[ "$1" == "$2" || "$1" == "$2"/* ]]; }

# A path no box should be given: the host's system directories (a box has its own), /tmp (the
# box's own, inside its disk limit), anything at or above $HOME, $SRC, the box tree or one of the
# shared roots above. The session's own working directory is exempt - it is where the session
# works, and a box without it is no move at all - but nothing inferred is.
move_dir_too_broad() {
    local path="$1" root
    case "$path" in
        /|/proc/*|/proc|/sys/*|/sys|/dev/*|/dev|/run/*|/run|/tmp|/tmp/*|/var|/var/*|/usr|/usr/*) return 0 ;;
        /etc|/etc/*|/opt|/opt/*|/boot|/boot/*|/snap|/snap/*|/bin|/bin/*|/sbin|/sbin/*|/lib*) return 0 ;;
    esac
    move_shared_roots
    for root in "$HOME" "$SRC" "$BOXES" "${MOVE_SHARED_ROOTS[@]}"; do
        # at or above one of these: /, /home, /mnt, /mnt/nvme, $HOME, ~/Code, /mnt/<user>/tmp …
        if move_within "$root" "$path"; then return 0; fi
    done
    return 1
}

move_dir_in_box() {
    local path="$1" p
    move_in_box_paths
    for p in "${MOVE_IN_BOX[@]}"; do
        if move_within "$path" "$p"; then return 0; fi
    done
    return 1
}

# One candidate directory as the box should get it: the root of its git working tree when it is
# in one (the exact boundary, and what makes a worktree of a session's open file arrive whole),
# else the first directory below the deepest shared root above it. Prints the path, empty when
# there is none to keep.
move_resolve_dir() {
    local path="$1" top root best="" rest
    top="$(git -C "$path" rev-parse --show-toplevel 2>/dev/null || true)"
    if [[ -n "$top" && -d "$top" ]]; then printf '%s\n' "$top"; return 0; fi
    move_shared_roots
    for root in "${MOVE_SHARED_ROOTS[@]}"; do
        if [[ "$path" == "$root"/* ]] && (( ${#root} > ${#best} )); then best="$root"; fi
    done
    if [[ -n "$best" ]]; then
        rest="${path#"$best"/}"
        path="$best/${rest%%/*}"
    fi
    printf '%s\n' "$path"
}

# pid -> its children, for every process on this host, read once: the plan asks this of 80+
# sessions and one pass costs a builtin read per process. Built in the caller's shell, so the
# subshell each move_dirs runs in inherits it (cmd_move_plan, cmd_move_self and cmd_move_notify
# call it before their loop).
declare -A MOVE_KIDS=()
MOVE_KIDS_READ=false
move_read_kids() {
    if $MOVE_KIDS_READ; then return 0; fi
    MOVE_KIDS_READ=true
    local d pid line rest parent
    for d in "$PROC"/[0-9]*; do
        pid="${d##*/}"
        # 2>/dev/null BEFORE the input redirection: bash applies them left to right, and a
        # process that exits between the glob and the open otherwise prints its own error.
        read -r line 2>/dev/null <"$d/stat" || continue
        rest="${line#*\(}"
        rest="${rest##*\) }"
        read -r _ parent _ <<<"$rest"
        [[ -n "$parent" ]] || continue
        MOVE_KIDS[$parent]="${MOVE_KIDS[$parent]:-} $pid"
    done
}

# A process and every live descendant of it: a session is its omp plus the tools it runs, and a
# lane's real paths are in the children (a `git -C <tree>`, an editor, a build) far more often
# than in omp's own cwd.
move_descendants() {
    local queue=("$1") pid kid guard=0
    local -A seen=([$1]=1)
    while (( ${#queue[@]} && guard < 4096 )); do
        guard=$((guard + 1))
        pid="${queue[0]}"
        queue=("${queue[@]:1}")
        printf '%s\n' "$pid"
        for kid in ${MOVE_KIDS[$pid]:-}; do
            [[ -z "${seen[$kid]:-}" ]] || continue
            seen[$kid]=1
            queue+=("$kid")
        done
    done
}

# Every directory one of a session's processes works in or writes into, as "<dir>\t<why>": the
# cwd of each, and the directory of every file one of them holds OPEN FOR WRITING (O_WRONLY or
# O_RDWR in /proc/<pid>/fdinfo/<fd> flags). The fd targets are read with one `find` over the
# whole subtree - `find` skips a path that goes away instead of stopping.
#
# Everything after that find is a shell builtin, and each directory is answered once. The plan
# asks this of every session on the host at once, so a fork per open file is not affordable: a
# first version read the flags with `awk` per fd and the plan took 3 m 26 s over 66 movable
# sessions on 2026-11-01. A directory the box has already (the home allow-list, $SRC, the
# dotfiles) is dropped here rather than by the caller, because those are most of a session's
# open files - the mise store, the language caches, ~/.omp - and dropping them first is what
# makes the flags read rare.
move_proc_dirs() {
    local root="$1" pids=() pid args=() src target comm fd flags dir key value
    local -A said=()
    move_read_kids
    mapfile -t pids < <(move_descendants "$root")
    (( ${#pids[@]} )) || return 0
    for pid in "${pids[@]}"; do args+=("$PROC/$pid/cwd" "$PROC/$pid/fd"); done
    while IFS=$'\t' read -r src target; do
        [[ "$target" == /* && "$target" != *" (deleted)" ]] || continue
        if [[ "$src" == */cwd ]]; then dir="$target"; else dir="${target%/*}"; fi
        # A target directly under / leaves an empty dirname, and no box is given / anyway.
        [[ -n "$dir" && "$dir" != / ]] || continue
        [[ -n "${said[$dir]:-}" ]] && continue
        case "$target" in /proc/*|/sys/*|/dev/*|/run/*) continue ;; esac
        move_dir_in_box "$dir" && continue
        pid="${src#"$PROC"/}"
        pid="${pid%%/*}"
        read -r comm 2>/dev/null <"$PROC/$pid/comm" || comm="?"
        if [[ "$src" == */cwd ]]; then
            [[ -d "$target" ]] || continue
            said[$dir]=1
            printf '%s\t%s\n' "$dir" "the working directory of $comm (pid $pid)"
            continue
        fi
        [[ -f "$target" ]] || continue
        fd="${src##*/}"
        flags=""
        while read -r key value; do
            [[ "$key" == flags: ]] || continue
            flags="$value"
            break
        done 2>/dev/null <"$PROC/$pid/fdinfo/$fd"
        [[ -n "$flags" ]] || continue
        # O_WRONLY (1) or O_RDWR (2) in the low two bits of the octal open flags.
        (( (8#$flags & 3) )) || continue
        said[$dir]=1
        printf '%s\t%s\n' "$dir" "$comm (pid $pid) holds ${target##*/} open for writing"
    done < <(find "${args[@]}" -maxdepth 1 -type l -printf '%p\t%l\n' 2>/dev/null)
}

# The spec being built: the paths and, beside each, why it is there.
MOVE_D=()
MOVE_W=()
# Keep one path, shallowest ancestor wins: a path inside one the spec already has adds nothing,
# and one that CONTAINS others replaces them - except the first, the session's own working
# directory, which stays first because `agentbox new` works in the first --dir.
move_keep() {
    local path="$1" why="$2" i out=() outw=()
    for ((i = 0; i < ${#MOVE_D[@]}; i++)); do
        if move_within "$path" "${MOVE_D[i]}"; then return 0; fi
    done
    for ((i = 0; i < ${#MOVE_D[@]}; i++)); do
        if (( i > 0 )) && move_within "${MOVE_D[i]}" "$path"; then continue; fi
        out+=("${MOVE_D[i]}")
        outw+=("${MOVE_W[i]}")
    done
    MOVE_D=("${out[@]}" "$path")
    MOVE_W=("${outw[@]}" "$why")
}

# The directories a box must be given so a session keeps the tree it works in, as
# "<path>\t<why>", the session's own working directory FIRST (cmd_new works in the first --dir):
#
#   1. the working directory itself, and - when it is in a git working tree outside $SRC - that
#      tree's root and the checkout that owns it (a worktree's .git is a file naming a common dir
#      in another tree; without it the box has the working files and no repository);
#   2. every directory the session's own processes use (move_proc_dirs), each resolved to its git
#      tree root or bounded at the first directory below a shared root, and left out when a box
#      has it already ($SRC, the dotfiles, the home allow-list) or when it is too broad;
#   3. each path the caller named with --dir, after the inferred ones, in the order given.
#
# $2 is the session's omp pid (no inference without it); every argument after it is an explicit
# --dir. A working directory no box can be given fails here, with the reason on stderr.
move_dirs_why() {
    local cwd="$1" pid="${2:-}" top="" common="" owner="" cand path why
    shift $(( $# > 2 ? 2 : $# ))
    [[ -n "$cwd" ]] || { echo "its working directory cannot be read" >&2; return 1; }
    [[ -d "$cwd" ]] || { echo "its working directory $cwd is gone" >&2; return 1; }
    case "$cwd" in
        /) echo "it works in /, which a box cannot be given (that is the whole host filesystem)" >&2; return 1 ;;
        "$HOME") echo "it works in \$HOME, which would shadow the box's own home and its allow-list" >&2; return 1 ;;
        "$BOXES"|"$BOXES"/*) echo "it already works inside the box tree $BOXES" >&2; return 1 ;;
    esac
    MOVE_D=("$cwd")
    MOVE_W=("its own working directory")
    top="$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null || true)"
    if [[ -n "$top" ]]; then
        common="$(git -C "$cwd" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
        owner="$common"
        if [[ "$(basename -- "${common:-/}")" == .git ]]; then owner="$(dirname -- "$common")"; fi
        for cand in "$top" "$owner"; do
            [[ -n "$cand" && -d "$cand" ]] || continue
            [[ "$cand" != / && "$cand" != "$HOME" ]] || continue
            if move_within "$cand" "$SRC"; then continue; fi
            if [[ "$cand" == "$top" ]]; then
                move_keep "$cand" "the git tree its working directory is in"
            else
                move_keep "$cand" "the checkout that owns that worktree"
            fi
        done
    fi
    if [[ -n "$pid" ]]; then
        # Many processes of one session share a cwd, and a build opens dozens of files in one
        # directory, so each distinct raw path is resolved once: move_resolve_dir forks git, and
        # the plan asks this of every session on the host.
        local -A raw_seen=() resolved=()
        while IFS=$'\t' read -r path why; do
            [[ -n "$path" ]] || continue
            [[ -z "${raw_seen[$path]:-}" ]] || continue
            raw_seen[$path]=1
            if move_dir_in_box "$path"; then continue; fi
            if [[ -z "${resolved[$path]:-}" ]]; then resolved[$path]="$(move_resolve_dir "$path")"; fi
            path="${resolved[$path]}"
            [[ -n "$path" && -d "$path" ]] || continue
            if move_dir_in_box "$path" || move_dir_too_broad "$path"; then continue; fi
            move_keep "$path" "$why"
        done < <(move_proc_dirs "$pid")
    fi
    for cand in "$@"; do
        move_keep "$cand" "you named it with --dir"
    done
    for ((cand = 0; cand < ${#MOVE_D[@]}; cand++)); do
        printf '%s\t%s\n' "${MOVE_D[cand]}" "${MOVE_W[cand]}"
    done
}

# The same, paths alone, one per line.
move_dirs() { move_dirs_why "$@" | cut -f1; }

# The `agentbox new` arguments for a working directory, one token per line.
move_spec() {
    local d
    while read -r d; do printf -- '--dir\n%s\n' "$d"; done < <(move_dirs "$@")
}

# Every live top-level omp process on this machine, one TSV row each:
#
#   class  pid  session-id  pane-id  tmux-pane  cwd  detail
#
# class is one of: host (a session a move takes), no-pane (a top-level omp with no tmux pane - a
# headless `omp -p`, a systemd unit, a scheduler step agent - which only a person can decide),
# boxed (already in an agentbox), sandbox (an omp inside a grading sandbox: a /work working
# directory, a bwrap ancestor, or a container that is not a box), subagent (an omp under another
# omp, which is not a session at all). omp's own helper processes (`__omp_worker_*`) run the
# same binary and are not listed.
#
# A process's command name and parent, cached: /proc/<pid>/stat read by the shell itself, since
# one `awk` over /proc/[0-9]*/stat dies the first time a process exits between the glob and the
# open — mawk makes an unopenable file fatal and stops, which silently cut this host's 100 omp
# processes to the 40 awk had reached before the first vanished pid. The comm is parenthesised
# and may hold spaces and parentheses, so it is taken up to the LAST ")".
move_stat() {
    local line rest
    MOVE_COMM="" MOVE_PPID=""
    line="$(cat "$PROC/$1/stat" 2>/dev/null)" || return 1
    [[ -n "$line" ]] || return 1
    rest="${line#*\(}"
    MOVE_COMM="${rest%)*}"
    rest="${rest##*\) }"
    read -r _ MOVE_PPID _ <<<"$rest"
    [[ -n "$MOVE_PPID" ]] || return 1
    return 0
}

move_census() {
    local -A pane_id=() pane_at=() cname=() comm=() ppid=() ctr=() unit=() cwd=() sid=()
    local pids=() files=() pid parent key name value id class detail chain found guard line leaf
    mapfile -t pids < <(pgrep -x omp 2>/dev/null || true)
    (( ${#pids[@]} )) || return 0
    # 1. the tmux panes, by the pid of each pane's own process (a login shell, normally).
    while IFS=$'\t' read -r key id name; do
        pane_id[$key]="$id"
        pane_at[$key]="$name"
    done < <(tmux list-panes -a -F "#{pane_pid}"$'\t'"#{pane_id}"$'\t'"#{session_name}:#{window_index}.#{pane_index}" 2>/dev/null || true)
    # 2. the container each omp sits in, and the systemd unit of one that sits in no container.
    # A box is a container whose name starts with agentbox-; any other container is a sandbox.
    while read -r id name; do cname[${id:0:12}]="$name"; done < <(docker ps --no-trunc --format '{{.ID}} {{.Names}}' 2>/dev/null || true)
    for pid in "${pids[@]}"; do
        while IFS= read -r line; do
            if [[ -z "${ctr[$pid]:-}" && "$line" =~ docker-([0-9a-f]{12}) ]]; then
                ctr[$pid]="${BASH_REMATCH[1]}"
            fi
            # The DEEPEST unit of the path, not the first: every process of a user manager sits
            # under user@1000.service, which says nothing about what runs it.
            if [[ -z "${unit[$pid]:-}" ]]; then
                leaf="${line%/}"
                while [[ "$leaf" == */* ]]; do
                    case "${leaf##*/}" in
                        *.service|*.scope) unit[$pid]="${leaf##*/}"; break ;;
                    esac
                    leaf="${leaf%/*}"
                done
            fi
        done < <(cat "$PROC/$pid/cgroup" 2>/dev/null || true)
    done
    # 3. each omp's working directory and the session file it holds open, from one `find` over
    # the cwd links and the file-descriptor directories — `find` skips a path that goes away
    # instead of stopping. The session file names its session in FULL; a prefix would resume
    # another session.
    files=()
    for pid in "${pids[@]}"; do files+=("$PROC/$pid/cwd" "$PROC/$pid/fd"); done
    while IFS=$'\t' read -r key name value; do
        case "$name" in
            cwd) cwd[$key]="$value" ;;
            *) [[ -n "${sid[$key]:-}" ]] || sid[$key]="$value" ;;
        esac
    done < <(find "${files[@]}" -maxdepth 1 -type l -printf '%p\t%l\n' 2>/dev/null \
        | sed -n -e "s#^$PROC/\([0-9]\+\)/cwd\t#\1\tcwd\t#p" \
                 -e "s#^$PROC/\([0-9]\+\)/fd/[0-9]\+\t.*/\.omp/agent/sessions/[^/]*/[0-9T:-]*Z_\([0-9a-f-]\{36\}\)\.jsonl\$#\1\tsid\t\2#p")
    # 4. the session id of an omp that holds no writer on its transcript, from its own `--resume`
    # argument. A session idle after a resume is in that state (the same reason agentbox-run.ts
    # has a second source): 10 of this host's 83 host sessions were, at 16:30Z on 2026-11-01.
    # The argument is the id itself, or the session file, whose name carries the id in full. It
    # is this process's OWN argument, never inherited, unlike an OMP_SESSION_ID read from a
    # descendant (scripts/disk-fill-watch's SOURCE_PHRASE: the environment is the weakest
    # source, and it named 39 unrelated processes as one session on 2026-10-30). Where both a
    # held transcript and a --resume argument existed, all 83 agreed.
    #
    # The id must come from the FILE NAME and from nowhere else in that path, and an id two
    # processes claim is no id at all. Two live omp processes here on 2026-11-01 were resumed
    # from a SUBAGENT transcript, `…/<stamp>_<parent id>/<stamp>_<session id>/ArityLane.jsonl`
    # and `…/GuardLane.jsonl`: a pattern that took the last uuid anywhere in the path would have
    # given both the id of a THIRD, live session, and a move would then have resumed one session
    # in three boxes, each overwriting the others' transcript. So the name must end in
    # `_<id>.jsonl`, and an id claimed more than once goes to the process HOLDING it and to
    # nobody else. The rest are left with no id, which every path here refuses to act on.
    local -A claims=() claimed=()
    for pid in "${pids[@]}"; do
        if [[ -n "${sid[$pid]:-}" ]]; then
            claimed[${sid[$pid]}]=held
            continue
        fi
        # `cat`, not a `<` redirection: a process that exits between pgrep and here makes the
        # shell's own redirection fail, which `set -e` turns into the end of the census (it did,
        # at pid 780324). `|| true` keeps the pipeline's own failure from doing the same.
        claims[$pid]="$(cat "$PROC/$pid/cmdline" 2>/dev/null | tr '\0' '\n' \
            | sed -n -e 's#^.*/[0-9T:-]*Z_\([0-9a-f-]\{36\}\)\.jsonl$#\1#p' \
                     -e 's#^\([0-9a-f]\{8\}-[0-9a-f]\{4\}-[0-9a-f]\{4\}-[0-9a-f]\{4\}-[0-9a-f]\{12\}\)$#\1#p' \
            | head -1 || true)"
        [[ -n "${claims[$pid]}" ]] || continue
        case "${claimed[${claims[$pid]}]:-}" in
            "") claimed[${claims[$pid]}]="$pid" ;;
            *) claimed[${claims[$pid]}]=many ;;
        esac
    done
    for pid in "${pids[@]}"; do
        [[ -n "${claims[$pid]:-}" ]] || continue
        if [[ "${claimed[${claims[$pid]}]}" == "$pid" ]]; then sid[$pid]="${claims[$pid]}"; fi
    done
    for pid in "${pids[@]}"; do
        # omp's own helper processes (`__omp_worker_*`) run the same binary and are not sessions.
        if grep -qa '__omp_worker' "$PROC/$pid/cmdline" 2>/dev/null; then continue; fi
        if [[ -z "${comm[$pid]:-}" ]]; then
            move_stat "$pid" || continue
            comm[$pid]="$MOVE_COMM"
            ppid[$pid]="$MOVE_PPID"
        fi
        class=host
        detail=""
        if [[ -z "${sid[$pid]:-}" && -n "${claims[$pid]:-}" ]]; then
            detail="its --resume names session ${claims[$pid]}, which another live omp holds open or claims too; a move must never resume one session twice"
        fi
        chain=""
        found=0
        name="${ctr[$pid]:-}"
        if [[ -n "$name" ]]; then
            detail="${cname[$name]:-container $name}"
            if [[ "$detail" == agentbox-* ]]; then class=boxed; else class=sandbox; fi
        fi
        parent="${ppid[$pid]}"
        guard=0
        while (( guard < 64 )); do
            guard=$((guard + 1))
            [[ -n "$parent" && "$parent" != 0 && "$parent" != 1 ]] || break
            if [[ -n "${pane_id[$parent]:-}" ]]; then found="$parent"; break; fi
            if [[ -z "${comm[$parent]:-}" ]]; then
                move_stat "$parent" || break
                comm[$parent]="$MOVE_COMM"
                ppid[$parent]="$MOVE_PPID"
            fi
            case "${comm[$parent]}" in
                omp)
                    if [[ "$class" == host ]]; then class=subagent; detail="under omp $parent"; fi
                    break
                    ;;
                bwrap)
                    if [[ "$class" == host ]]; then class=sandbox; detail="a bwrap sandbox (pid $parent)"; fi
                    break
                    ;;
            esac
            chain="$chain ${parent}:${comm[$parent]}"
            parent="${ppid[$parent]}"
        done
        case "${cwd[$pid]:-}" in
            /work|/work/*)
                class=sandbox
                detail="${detail:-a grading sandbox (/work)}"
                ;;
        esac
        if [[ "$class" == host && "$found" == 0 ]]; then
            class=no-pane
            detail="parent ${ppid[$pid]}:${comm[${ppid[$pid]}]:-?}${chain:+, above${chain}}${unit[$pid]:+, unit ${unit[$pid]}}"
        fi
        printf "%s$SEP%s$SEP%s$SEP%s$SEP%s$SEP%s$SEP%s\n" "$class" "$pid" "${sid[$pid]:-}" \
            "${pane_id[$found]:-}" "${pane_at[$found]:-}" "${cwd[$pid]:-}" "$detail"
    done
}

# One session's row from the census, by full session id or by a unique prefix of it.
move_find() {
    local target="$1" rows=()
    mapfile -t rows < <(move_census | awk -F"$SEP" -v t="$target" '$3 != "" && index($3, t) == 1')
    (( ${#rows[@]} == 1 )) || return 1
    printf '%s\n' "${rows[0]}"
}

cmd_move_plan() {
    local json=false a
    for a in "$@"; do
        case "$a" in
            --json) json=true ;;
            *) die "usage: agentbox move --plan [--json]" ;;
        esac
    done
    local image dir free floor
    image="$(move_image_bytes "$BOX_DISK_BYTES")"
    dir="$(dirname "$BOXES")"
    free="$(move_free_bytes "$dir")"
    floor="$(move_floor_bytes "$dir")"
    local class pid sid pane at cwd detail spec reason line path why
    local dirs=() whys=() rows=() why_rows=() blocked=0 movable=0
    local -A counts=([host]=0 [no-pane]=0 [boxed]=0 [sandbox]=0 [subagent]=0)
    # One pass over /proc for every session's process tree (move_read_kids), in the plan's own
    # shell: each move_dirs_why below runs in a subshell, which inherits what this built.
    move_read_kids
    while IFS="$SEP" read -r class pid sid pane at cwd detail; do
        counts[$class]=$(( ${counts[$class]:-0} + 1 ))
        [[ "$class" == host || "$class" == no-pane ]] || continue
        spec=""
        reason=""
        dirs=()
        whys=()
        while IFS=$'\t' read -r path why; do
            [[ -n "$path" ]] || continue
            dirs+=("$path")
            whys+=("$path"$'\x1f'"$why")
        done < <(move_dirs_why "$cwd" "$pid" 2>/dev/null)
        if (( ${#dirs[@]} )); then
            spec="$(printf -- '--dir %s ' "${dirs[@]}")"
            spec="${spec% }"
            for why in "${whys[@]}"; do
                why_rows+=("${sid:-pid $pid}	${why%%$'\x1f'*}	${why#*$'\x1f'}")
            done
        else
            reason="$(move_dirs_why "$cwd" "$pid" 2>&1 >/dev/null || true)"
        fi
        if [[ -z "$sid" ]]; then
            reason="${reason:-${detail:-its omp holds no session file open, so a move cannot name it in full}}"
        fi
        if [[ "$class" == host && -z "$reason" ]]; then
            movable=$((movable + 1))
        elif [[ "$class" == host ]]; then
            blocked=$((blocked + 1))
        fi
        line="$(printf '%s\x1e' "${whys[@]+"${whys[@]}"}")"
        rows+=("$class	$sid	$pid	$pane	$at	$cwd	${spec:--}	$(move_gib "$image")	${reason:-$detail}	${line%$'\x1e'}")
    done < <(move_census)
    local total=$((movable * image))
    if $json; then
        jq -Rn --argjson summary "$(jq -n \
                --argjson movable "$movable" --argjson blocked "$blocked" \
                --argjson nopane "${counts[no-pane]:-0}" --argjson boxed "${counts[boxed]:-0}" \
                --argjson sandbox "${counts[sandbox]:-0}" --argjson subagent "${counts[subagent]:-0}" \
                --argjson image "$image" --argjson total "$total" --argjson free "$free" --argjson floor "$floor" \
                '{movable: $movable, blocked: $blocked, not_a_pane: $nopane, already_boxed: $boxed,
                  sandboxes: $sandbox, subagents: $subagent, new_disk_per_box_bytes: $image,
                  new_disk_total_bytes: $total, free_bytes: $free, floor_bytes: $floor,
                  headroom_bytes: ($free - $floor - $total)}')" \
            '{summary: $summary, sessions: [inputs | split("\t") |
                {class: .[0], session: .[1], pid: (.[2] | tonumber), pane: .[3], tmux: .[4],
                 cwd: .[5], spec: .[6], new_disk_gib: (.[7] | tonumber), note: .[8],
                 dirs: (if (.[9] // "") == "" then []
                        else (.[9] | split("\u001e") | map(split("\u001f") | {path: .[0], why: .[1]})) end)}]}' \
            < <(printf '%s\n' "${rows[@]}")
        return 0
    fi
    echo "agentbox move --plan: $(hostname -s), $(date -u +%FT%TZ)"
    echo
    { echo "CLASS	SESSION	PID	PANE	TMUX	CWD	SPEC	NEW-GiB	NOTE"
      printf '%s\n' "${rows[@]}" | sort -t$'\t' -k1,1 -k6,6
    } | column -t -s $'\t'
    echo
    if (( ${#why_rows[@]} )); then
        echo "each path and why the box gets it (a path under $SRC, the dotfiles or the home allow-list is"
        echo "in every box already and is never listed - a worktree under $SRC/<repo>/.worktrees/... included):"
        { echo "SESSION	PATH	WHY"
          printf '%s\n' "${why_rows[@]}"
        } | column -t -s $'\t'
        echo
    fi
    echo "host sessions outside a box: $((movable + blocked)) ($movable with a spec, $blocked that need a decision)"
    echo "not a pane (headless or unit-run, yours to decide): ${counts[no-pane]:-0}"
    echo "excluded: ${counts[boxed]:-0} already in a box, ${counts[sandbox]:-0} in a grading sandbox, ${counts[subagent]:-0} subagents of another omp"
    echo "new disk: $(move_gib "$image") GiB per box (its sparse ext4 image; a move clones nothing), $(move_gib "$total") GiB for $movable boxes"
    echo "$dir: $(move_gib "$free") GiB free − $(move_gib "$floor") GiB reserve − $(move_gib "$total") GiB = $(move_gib $((free - floor - total))) GiB left over"
    echo "a path the inference missed is added by the session itself: agentbox move --self --dir PATH"
}

# The omp process a command runs under: the nearest ancestor whose command is omp.
move_own_omp() {
    local p="${1:-$$}" guard=0
    while (( guard < 64 )); do
        guard=$((guard + 1))
        [[ -r "$PROC/$p/stat" ]] || return 1
        if [[ "$(cat "$PROC/$p/comm" 2>/dev/null || true)" == omp ]]; then echo "$p"; return 0; fi
        p="$(awk '{ i = index($0, ") "); split(substr($0, i + 2), g, " "); print g[2] }' "$PROC/$p/stat" 2>/dev/null || true)"
        [[ -n "$p" && "$p" != 0 && "$p" != 1 ]] || return 1
    done
    return 1
}

# The detached step, and the only one that touches a session: hang omp up, wait for its teardown,
# respawn its pane into the launcher. `move --self` runs in the session's own bash tool, which
# dies with the omp it hangs up, and `--now` must not hold the caller's terminal for a minute per
# session, so both hand this to a process of their own.
move_hand_off() {
    local sid="$2" log="${XDG_CACHE_HOME:-$HOME/.cache}/omp/agentbox/move-$2.log"
    mkdir -p "$(dirname "$log")"
    # This file by its absolute path, not $0: the relauncher outlives a caller that was started
    # by a relative path from a directory the pane is about to leave.
    setsid "$(readlink -f "${BASH_SOURCE[0]}")" move --relaunch "$@" </dev/null >>"$log" 2>&1 &
    echo "agentbox: session $sid handed to a detached relauncher; log: $log"
}

move_relaunch() {
    local pid="$1" sid="$2" pane="$3" cwd="$4" waited=0 inner
    shift 4
    local spec=("$@")
    echo "$(date -u +%FT%TZ) move $sid: pid $pid, pane $pane, cwd $cwd, spec ${spec[*]}"
    # Pids are reused: never signal one that is no longer this session's omp.
    if [[ "$(cat "$PROC/$pid/comm" 2>/dev/null || true)" == omp ]]; then
        kill -HUP "$pid" 2>/dev/null || true
        echo "$(date -u +%FT%TZ) move $sid: omp $pid hung up; waiting for its teardown"
        while (( waited < 180 )) && kill -0 "$pid" 2>/dev/null; do
            sleep 1
            waited=$((waited + 1))
        done
    fi
    if kill -0 "$pid" 2>/dev/null; then
        echo "$(date -u +%FT%TZ) move $sid: omp $pid is still up after ${waited}s; the respawn ends it"
    else
        echo "$(date -u +%FT%TZ) move $sid: omp $pid exited after ${waited}s"
    fi
    if ! tmux display-message -p -t "$pane" '#{pane_id}' >/dev/null 2>&1; then
        echo "$(date -u +%FT%TZ) move $sid: pane $pane is gone; nothing respawned. Resume it by hand: agentbox new ${spec[*]} -- omp --resume $sid ."
        return 1
    fi
    inner="$(printf '%q ' agentbox new "${spec[@]}" -- omp --resume "$sid" .)"
    # An interactive bash, as scripts/agent-new starts a pane: the box launcher needs the
    # session environment .bashrc sets up (shims first on PATH). The shell that stays behind is
    # what makes a box that ends leave a usable pane instead of a dead one.
    tmux respawn-pane -k -t "$pane" -c "$cwd" \
        bash -i -c "$inner; echo; echo 'agentbox: the box has exited; this pane is a shell again'; exec bash -i"
    echo "$(date -u +%FT%TZ) move $sid: pane $pane respawned into agentbox new ${spec[*]}"
}

cmd_move_self() {
    local dry=false a usage="usage: agentbox move --self [--dry-run] [--force-floor] [--dir PATH]…"
    # --dir is the session's own answer to an inference that missed something: a path it works in
    # that no process of it had open when the plan ran. Each is checked exactly as
    # `agentbox new --dir` checks it (add_box_dir), and each lands in the spec after the
    # inferred paths, in the order given.
    while (( $# )); do
        a="$1"
        case "$a" in
            --dry-run) dry=true ;;
            --force-floor) MOVE_FORCE_FLOOR=true ;;
            --dir)
                [[ -n "${2:-}" ]] || die "--dir takes an existing directory, e.g. --dir /mnt/nvme/$(id -un)/my-lane  ($usage)"
                add_box_dir "$2"
                shift
                ;;
            *) die "$usage" ;;
        esac
        shift
    done
    [[ -z "${AGENTBOX_BOX:-}" ]] || die "this session already runs in box $AGENTBOX_BOX; a move has nothing to do (agentbox restart relaunches it in place)"
    [[ ! -e /etc/agentbox-identity ]] || die "this session already runs in a box; a move has nothing to do (agentbox restart relaunches it in place)"
    # A SUBAGENT's bash tool reaches the same omp process as its parent's, so `--self` run there
    # would hang up the session that started it, in the middle of the subagent's own work.
    # omp gives a subagent its own transcript, `…/<session dir>/<name>.jsonl`, while a session's
    # own file ends in `_<id>.jsonl`; that is what tells the two apart (measured in this
    # session: PI_SESSION_FILE named AgentBoxMove.jsonl while OMP_SESSION_ID was the parent's).
    if [[ -n "${PI_SESSION_FILE:-}" ]]; then
        case "$(basename -- "$PI_SESSION_FILE")" in
            *_[0-9a-f]*-*-*-*-*.jsonl) ;;
            *) die "a subagent cannot move its session: $PI_SESSION_FILE is a subagent transcript, and the move would hang up the session that started you. Tell the session to run it when the subagent is done." ;;
        esac
    fi
    local pid row class _pid sid pane at cwd detail
    pid="$(move_own_omp)" || die "no omp process above this command: run 'agentbox move --self' from the session's own bash tool"
    row="$(move_census | awk -F"$SEP" -v p="$pid" '$2 == p')"
    [[ -n "$row" ]] || die "omp $pid is not in this host's session census; run 'agentbox move --plan' and look for it"
    IFS="$SEP" read -r class _pid sid pane at cwd detail <<<"$row"
    [[ "$class" == host ]] || die "this session is $class ($detail), not a host session a move can take"
    [[ -n "$sid" ]] || die "this omp holds no session file open, so a move cannot name its session in full and --resume would take the wrong one; try again in a moment"
    # The caller's own OMP_SESSION_ID, which omp sets for its tools, must be the session the
    # census read from the process. A disagreement means the walk up the process tree reached
    # another session's omp, and resuming that one in this pane would take a session nobody
    # asked to move.
    if [[ -n "${OMP_SESSION_ID:-}" && "$OMP_SESSION_ID" != "$sid" ]]; then
        die "the omp above this command runs session $sid, while this tool's OMP_SESSION_ID is $OMP_SESSION_ID; a move must not resume a session it has not identified. Run 'agentbox move --plan' and move it by id."
    fi
    [[ -n "$pane" ]] || die "this session has no tmux pane to relaunch ($detail); it is one of the plan's not-a-pane rows and needs a person"
    local dirs=() whys=() spec=() d path why
    move_read_kids
    while IFS=$'\t' read -r path why; do
        [[ -n "$path" ]] || continue
        dirs+=("$path")
        whys+=("  $path — $why")
    done < <(move_dirs_why "$cwd" "$pid" "${BOX_DIRS[@]+"${BOX_DIRS[@]}"}" 2>/dev/null)
    (( ${#dirs[@]} )) || die "$(move_dirs_why "$cwd" "$pid" 2>&1 >/dev/null || true)"
    for d in "${dirs[@]}"; do spec+=(--dir "$d"); done
    move_check_floor "$(move_image_bytes "$BOX_DISK_BYTES")" || exit 2
    if $dry; then
        echo "agentbox: would hang omp $pid up and respawn pane $pane ($at) as:"
        echo "  agentbox new ${spec[*]} -- omp --resume $sid ."
        echo "each path and why:"
        printf '%s\n' "${whys[@]}"
        echo "anything else you work in is NOT in that box and is lost with it: add it with --dir."
        return 0
    fi
    printf '%s\n' "agentbox: the box gets these paths:" "${whys[@]}"
    move_hand_off "$pid" "$sid" "$pane" "$cwd" "${spec[@]}"
}

MOVE_NOTICE_HEAD='agentbox: this session moves into an agent box (dispatch://INFRA-702). Do not stop, delay or shorten any work for it. The next time `read proc://` lists none of your jobs or services running, write your handover into the transcript and run `agentbox move --self` from your bash tool. It hangs this omp up gracefully and respawns this pane as'
MOVE_NOTICE_TAIL='so you come back with the same session id, the same transcript and the same working directory, in a box with a cpu, memory, pids and disk limit of its own. Your tree is the host'"'"'s own directory, bind-mounted at its own path: uncommitted work included, nothing cloned, nothing copied.'
# What the box gets, and the one thing the session must check before it runs the command. The
# paths come from the session's own processes, so a path it has not touched is not in the list;
# an unnamed path is not absent in the box, it is writable there and lost with the box.
MOVE_NOTICE_DIRS='The box gets these paths of yours, and nothing else outside ~/src, the dotfiles and the home allow-list (a worktree under ~/src/<repo>/.worktrees/... is in ~/src, so it IS in the box):'
MOVE_NOTICE_ADD='Read that list. If you work in a path it does not name, add it yourself: `agentbox move --self --dir PATH --dir PATH`. A path no box is given is still writable inside the box and is lost when the box ends. If you are idle, do it now.'

cmd_move_notify() {
    local now=false dry=false all=false t targets=() rows=() row
    for t in "$@"; do
        case "$t" in
            --now) now=true ;;
            --dry-run) dry=true ;;
            --all) all=true ;;
            --force-floor) MOVE_FORCE_FLOOR=true ;;
            -*) die "unknown option $t  (usage: agentbox move <session-id>… | --all [--now] [--dry-run] [--force-floor])" ;;
            *) targets+=("$t") ;;
        esac
    done
    if $all; then
        mapfile -t rows < <(move_census | awk -F"$SEP" '$1 == "host" && $3 != "" && $4 != ""')
    else
        (( ${#targets[@]} )) || die "usage: agentbox move --plan [--json] | --self [--dry-run] | <session-id>… | --all [--now] [--dry-run]"
        for t in "${targets[@]}"; do
            row="$(move_find "$t")" || die "no live host session matches $t (agentbox move --plan lists them)"
            rows+=("$row")
        done
    fi
    (( ${#rows[@]} )) || { echo "agentbox: no host session to move"; return 0; }
    local class pid sid pane at cwd detail dir why dirs=() whys=() spec=() d image
    image="$(move_image_bytes "$BOX_DISK_BYTES")"
    move_read_kids
    for row in "${rows[@]}"; do
        IFS="$SEP" read -r class pid sid pane at cwd detail <<<"$row"
        if [[ "$class" != host ]]; then
            echo "agentbox: $sid is $class ($detail); not moved" >&2
            continue
        fi
        dirs=()
        whys=()
        while IFS=$'\t' read -r dir why; do
            [[ -n "$dir" ]] || continue
            dirs+=("$dir")
            whys+=("$dir ($why)")
        done < <(move_dirs_why "$cwd" "$pid" 2>/dev/null)
        if (( ! ${#dirs[@]} )); then
            echo "agentbox: $sid cannot be moved: $(move_dirs_why "$cwd" "$pid" 2>&1 >/dev/null || true)" >&2
            continue
        fi
        spec=()
        for d in "${dirs[@]}"; do spec+=(--dir "$d"); done
        if ! move_check_floor "$image"; then return 2; fi
        if $now; then
            if $dry; then
                echo "agentbox: would relaunch pane $pane ($at) now: agentbox new ${spec[*]} -- omp --resume $sid ."
                continue
            fi
            move_hand_off "$pid" "$sid" "$pane" "$cwd" "${spec[@]}"
            continue
        fi
        local notice="$MOVE_NOTICE_HEAD \`agentbox new ${spec[*]} -- omp --resume $sid .\`, $MOVE_NOTICE_TAIL $MOVE_NOTICE_DIRS $(printf '%s; ' "${whys[@]}" | sed 's/; $//'). $MOVE_NOTICE_ADD"
        if $dry; then
            echo "agentbox: would notify $sid (pane $pane, $at): $notice"
            continue
        fi
        envoy send "$sid" "$notice" >/dev/null || die "envoy send to $sid failed"
        echo "agentbox: $sid (pane $pane, $at) notified; it moves when it reaches a safe point"
    done
}

cmd_move() {
    set_disk_bytes "the default disk limit"
    case "${1:-}" in
        --plan) shift; cmd_move_plan "$@" ;;
        --self) shift; cmd_move_self "$@" ;;
        --relaunch) shift; move_relaunch "$@" ;;
        "") die "usage: agentbox move --plan [--json] | --self [--dry-run] | <session-id>… | --all [--now] [--dry-run]" ;;
        *) cmd_move_notify "$@" ;;
    esac
}

FAILS=0
ok() { echo "ok   $*"; }
fail() { echo "FAIL $*"; FAILS=$((FAILS + 1)); }

# The checks whose answer is a property of THIS MACHINE's logins and not of the box: the
# agent-tier store, the Docker Hub helper that reads it, the instance role, Hawk and Google.
# One definition, run on both sides, because a box can only be as logged in as the host under
# it: doctor calls a difference a box defect and says so, and where neither side answers it
# names the missing host login instead of a FAIL a session would read as its own box being
# broken (sami-rocqperf, 2026-10-31: no GHCR_PULL_TOKEN or DOCKER_HUB_OAT in any agent-tier
# file, no EC2 instance role, and no route to the Hawk gateway - every one of them a fact
# about the machine). Each probe prints its own detail and exits non-zero when it cannot
# answer. The single quotes are the point: everything expands where it runs.
# shellcheck disable=SC2016
PROBE_FUNCS='
probe_secrets() {
    n="$(secrets GHCR_PULL_TOKEN -- sh -c "echo \${#GHCR_PULL_TOKEN}" 2>&1 | tail -1)"
    case "${n:-x}" in *[!0-9]*) echo "$n"; return 1;; esac
    [ "$n" -gt 0 ] || { echo "GHCR_PULL_TOKEN is empty"; return 1; }
    echo "GHCR_PULL_TOKEN, $n bytes"
}
probe_dockerhub() {
    d="$(printf "%s" https://index.docker.io/v1/ | timeout 20 docker-credential-secretsd get 2>&1)"
    jq -e ".Secret | length > 0" >/dev/null 2>&1 <<<"$d" || { echo "$d"; return 1; }
    echo "the helper answers with the org pull token"
}
probe_aws() {
    arn="$(timeout 20 aws sts get-caller-identity --query Arn --output text 2>&1)"
    case "$arn" in arn:aws:*) echo "default profile: ${arn##*/}"; return 0;; esac
    echo "$arn"; return 1
}
probe_hawk() {
    # The token is the only thing on stdout; the reason a mint failed is the last of what it
    # said on stderr, after any progress line, and one run has to answer both.
    f="$(mktemp)"; e="$(timeout 90 hawk-token 2>&1 >"$f")"; t="$(tr -d "[:space:]" <"$f")"; rm -f "$f"
    case "$t" in *.*.*) echo "mints (${#t} bytes)"; return 0;; esac
    printf "%s" "$e" | grep -v "^[[:space:]]*$" | tail -1
    return 1
}
probe_google() {
    g="$(timeout 40 google-user-token 2>&1 >/dev/null)" && { echo "mints"; return 0; }
    echo "$g"; return 1
}
probe_gcloud() {
    # The box identity the SDK is configured for (dev-<name>@theorem-agent-infra, a keyless
    # external_account bound to this machine), not a user login.
    a="$(timeout 60 gcloud auth list --filter=status:ACTIVE --format="value(account)" 2>&1 | grep -v "^[[:space:]]*$" | tail -1)"
    case "$a" in *@*) echo "active account $a"; return 0;; esac
    echo "${a:-gcloud names no active account}"; return 1
}
probe_gke() {
    # The build pool the agents submit jobs to; the plugin that gets its credential
    # (gke-gcloud-auth-plugin) is a symlink into the SDK, so this fails wherever gcloud does.
    k="$(timeout 60 kubectl --context gke_theorem-agent-infra_us-west1_dispatch -n builds auth can-i create jobs 2>&1 | grep -v "^[[:space:]]*$" | tail -1)"
    [ "$k" = yes ] && { echo "can create jobs in the builds namespace"; return 0; }
    echo "$k"; return 1
}
probe_run() {
    for p in "$@"; do
        if d="$(probe_$p 2>&1)"; then s=ok; else s=fail; fi
        # The last line that holds something: a failing tool prints its reason after whatever
        # it said on the way there, and aws opens its report with an empty line.
        printf "@probe %s %s %s\n" "$p" "$s" "$(printf "%s" "$d" | grep -v "^[[:space:]]*$" | tail -1 | cut -c1-200)"
    done
}
'

# A probe's name for a person, and the command that shows the same answer on the host.
probe_label() {
    case "$1" in
        secrets)     echo "secrets agent-tier" ;;
        dockerhub)   echo "docker-credential-secretsd for Docker Hub" ;;
        aws)         echo "aws" ;;
        hawk)        echo "hawk-token" ;;
        google)      echo "google-user-token" ;;
        gcloud)      echo "gcloud auth list" ;;
        gke)         echo "kubectl auth can-i create jobs (builds)" ;;
        dockerauths) echo ".docker holds the box ghcr login" ;;
    esac
}
probe_command() {
    case "$1" in
        secrets)     echo "secrets GHCR_PULL_TOKEN -- sh -c 'echo \${#GHCR_PULL_TOKEN}'" ;;
        dockerhub)   echo "printf %s https://index.docker.io/v1/ | docker-credential-secretsd get" ;;
        aws)         echo "aws sts get-caller-identity" ;;
        hawk)        echo "hawk-token" ;;
        google)      echo "google-user-token" ;;
        gcloud)      echo "gcloud auth list" ;;
        gke)         echo "kubectl --context gke_theorem-agent-infra_us-west1_dispatch -n builds auth can-i create jobs" ;;
        dockerauths) echo "secrets GHCR_PULL_TOKEN -- sh -c 'echo \${#GHCR_PULL_TOKEN}'" ;;
    esac
}
PROBE_NAMES=(secrets dockerhub aws hawk google gcloud gke)
# The box side of doctor, run under bash inside a throwaway box. The single
# quotes are the point: everything expands inside the box.
# shellcheck disable=SC2016
DOCTOR_BOX_SCRIPT='
set -u
fails=0
ok() { echo "ok   box: $*"; }
fail() { echo "FAIL box: $*"; fails=$((fails + 1)); }
for t in omp jj gh knives aws gws kubectl pulumi docker socat google-chrome pip psql sqlite3 wget forward secrets hawk-token agent-secrets; do
    command -v "$t" >/dev/null 2>&1 && ok "tool $t" || fail "tool $t does not resolve"
done
for d in .config/gh .ssh/id_ed25519 .gnupg .config/agent-secrets; do
    [ -e "$HOME/$d" ] && fail "$d is present in the box" || ok "$d absent"
done
# .config/gcloud is a mount now (agentbox/mounts), checked entry by entry with the rest of the
# allow-list below, and the identity it carries is the box one - a keyless external_account
# bound to this machine, which gcloud exchanges for a dev-<name>@theorem-agent-infra token
# through the metadata relay - answered by probe_gcloud/probe_gke against the host. What that
# directory must hold for agent-c is the devbox WIF ADC file, which deploy.py (_DEVBOX_WIF_ADC)
# requires for any devN up/destroy and agent-c meta/infra/pulumi/scripts/provision_devbox_wif_adc.py
# writes; a box that writes it now writes the copy on the host, so the next slot apply keeps it.
# The SDK itself is read-only in the box: gcloud writes only under its config dir.
sdk="$HOME/.gcloud/google-cloud-sdk"
[ -x "$sdk/bin/gcloud" ] && ok "the Google Cloud SDK is mounted ($sdk)" || fail "no Google Cloud SDK at $sdk: gcloud and gke-gcloud-auth-plugin cannot run in this box"
mounted() { awk -v t="$1" "\$5 == t { f = 1 } END { exit !f }" /proc/self/mountinfo; }
writable() { if [ -d "$1" ]; then touch "$1/.doctor.$$" 2>/dev/null && rm -f "$1/.doctor.$$"; else (: >>"$1") 2>/dev/null; fi; }
while read -r m p; do
    case "$m" in
        rw) mounted "$HOME/$p" && writable "$HOME/$p" && ok "rw $p" || fail "rw $p: not a writable mount (mounts entry newer than this box: relaunch to pick it up)";;
        ro) [ -e "$HOME/$p" ] || { echo "note box: ro $p absent (not on the host)"; continue; }
            mounted "$HOME/$p" && ! writable "$HOME/$p" && ok "ro $p" || fail "ro $p: not a read-only mount (mounts entry newer than this box: relaunch to pick it up)";;
    esac
done <"$DOTFILES_DIR/agentbox/mounts"
r="$(python3 -c "import socket,os; s=socket.socket(socket.AF_UNIX); s.connect(os.environ[\"DBUS_SESSION_BUS_ADDRESS\"].split(\"=\",1)[1]); s.sendall(b\"\\0AUTH EXTERNAL 31303030\\r\\n\"); print(s.recv(64).split()[0].decode())" 2>&1)"; [ "$r" = OK ] && ok "session bus (keyring) reachable through the relay" || fail "session bus: $r"
[ "$(ls -A "$HOME/.ssh" | sort | tr "\n" " ")" = "jj-signing jj-signing.pub " ] && ok ".ssh holds exactly the jj-signing pair" || fail ".ssh contents: $(ls -A "$HOME/.ssh" | tr "\n" " ")"
# The ghcr login the entrypoint makes needs the machine to hold GHCR_PULL_TOKEN, so the host
# decides whether its absence is a defect or this machine (see PROBE_FUNCS).
auths="$(jq -r ".auths | keys | join(\",\")" "$HOME/.docker/config.json" 2>/dev/null)"; [ "$auths" = ghcr.io ] && echo "@probe dockerauths ok only the box ghcr login" || echo "@probe dockerauths fail auths: ${auths:-none}"
[ "$(stat -c %U /run/user/$(id -u))" = ubuntu ] && ok "runtime dir owned by ubuntu" || fail "runtime dir owner $(stat -c %U /run/user/$(id -u))"
# The disk limit (AGENTBOX_DISK, set by the launcher): one filesystem of the box own, holding the
# workspace, HOME and /tmp, and not the container root overlay, which has no limit of any kind
# here. A box started with --disk 0 has none and says so.
if [ "${AGENTBOX_DISK:-0}" = 0 ]; then
    echo "note box: no disk limit (this box was started with --disk 0)"
else
    bd="$(stat -c %d .)"; hd="$(stat -c %d "$HOME")"; td="$(stat -c %d /tmp)"; rd="$(stat -c %d /)"
    if [ "$bd" = "$hd" ] && [ "$bd" = "$td" ] && [ "$bd" != "$rd" ]; then
        ok "disk limit $AGENTBOX_DISK on one filesystem of this box: workspace, HOME and /tmp ($(df -h --output=size . | tail -1 | tr -d " ") usable)"
    else
        fail "disk limit $AGENTBOX_DISK: workspace, HOME and /tmp are not one filesystem of this box ($(df -h --output=target . "$HOME" /tmp / | tail -4 | tr "\n" " "))"
    fi
fi
if top="$(git rev-parse --show-toplevel 2>/dev/null)" && [ ! -e "$top/.jj" ]; then ok "cwd is a git clone of its own"; else fail "cwd is not a git clone of its own (cwd-dependent: run doctor from your checkout, not /tmp)"; fi
out="$(gh api user 2>&1)"; case "$out" in *"Resource not accessible by integration"*) ok "gh runs as an App (never the user)";; *) fail "gh api user: $(echo "$out" | head -1) (cwd-dependent: the shim routes by repository, so run doctor from your workspace)";; esac
# `gh auth status` is answered by shims/gh, which reports the App routing instead of a user
# login; a bare gh with no login says "not logged into any GitHub hosts". Either answer is
# this check passing - what it refuses is a user login inside the box.
gs="$(gh auth status 2>&1)"; case "$gs" in *"own login is not used"*|*"not logged"*) ok "gh auth: no user login";; *) fail "gh auth status shows a login: $(head -1 <<<"$gs")";; esac
jq -e ".credHelpers[\"https://index.docker.io/v1/\"] == \"secretsd\"" "$HOME/.docker/config.json" >/dev/null 2>&1 && ok "docker config names the secretsd helper for Docker Hub" || fail "docker config: no secretsd credHelper for Docker Hub"
[ -z "${AGENT_SECRETS_HELPER_SOCK:-}" ] && [ ! -S "/run/user/$(id -u)/agent-secrets/helper.sock" ] && ok "no helper socket in the box (a box is not a host session)" || fail "helper socket reachable from the box"
# A box with no broker identity is a supported state, not a defect: one started before the key
# dir existed, or while the host could not enroll boxes (no key, no enrollment.error). Its agents
# use secretsd.
kd="${AGENT_SECRETS_KEY_DIR:-}"
if [ -z "$kd" ]; then
    echo "note box: no broker identity (no AGENT_SECRETS_KEY_DIR: the box predates it); its agents use secretsd"
elif [ -z "${AGENT_SECRETS_URL:-}" ] || [ "$kd" != "/run/user/$(id -u)/agent-secrets" ]; then
    fail "agent-secrets env: URL=${AGENT_SECRETS_URL:-unset} KEY_DIR=$kd"
elif [ ! -e "$kd/key.pem" ] && [ ! -e "$kd/enrollment.error" ]; then
    ok "agent-secrets env (url, key dir)"
    echo "note box: no broker identity (the host could not enroll boxes when this box started); its agents use secretsd"
else
    ok "agent-secrets env (url, key dir)"
    [ "$(stat -c %a "$kd/key.pem" 2>/dev/null)" = 600 ] && [ "$(stat -c %U "$kd/key.pem" 2>/dev/null)" = ubuntu ] && ok "box key 0600 ubuntu" || fail "box key: $(ls -l "$kd" 2>&1 | tr "\n" " ")"
    [ -s "$kd/enrollment" ] && ok "box enrolled ($(cat "$kd/enrollment"))" || fail "box not enrolled: $(cat "$kd/enrollment.error" 2>/dev/null || echo no enrollment.error either)"
    w="$(timeout 20 agent-secrets whoami 2>&1)"; jq -e ".kind == \"session\"" <<<"$w" >/dev/null 2>&1 && ok "broker knows this box as kind $(jq -r .kind <<<"$w"), operator $(jq -r .operator <<<"$w")" || fail "agent-secrets whoami: $(head -1 <<<"$w")"
fi
# The host-dependent credentials: the box answers, the host answers the same probes, and
# cmd_doctor compares the two (PROBE_FUNCS). Nothing is judged here, where the answer of the
# host is not known.
probe_run secrets dockerhub aws hawk google gcloud gke
# Envoy and Dispatch as a box session reads them: the envoy.json `envoy config-path` names (for a
# session without a profile of its own, the neutral file of the host, agentbox/mounts), the switch
# of each section, the listener through `envoy` itself (the URL in the file or the default, through
# the entrypoint relay, with the bearer in the file), the NATS by name, the seed command.
if ! ej="$("$DOTFILES_DIR/scripts/envoy" config-path 2>&1)"; then
    fail "$ej: box sessions have no Dispatch or Envoy"
elif [ ! -r "$ej" ]; then
    fail "envoy.json $ej unreadable: box sessions have no Dispatch or Envoy"
else
    case "$(jq -r ".dispatch.enabled" "$ej" 2>/dev/null)" in
        true) ok "dispatch section enabled in $ej ($(jq -r ".dispatch.serverUrl // \"http://localhost:8766\"" "$ej"))";;
        false) echo "note box: $ej turns Dispatch off";;
        *) echo "note box: $ej has no dispatch section with enabled true: box sessions have no Dispatch";;
    esac
    case "$(jq -r ".envoy.enabled" "$ej" 2>/dev/null)" in
        true)
            out="$(ENVOY_MAX_TIME=3 "$DOTFILES_DIR/scripts/envoy" ps --json 2>&1)" && ok "envoy api answers ($(jq length <<<"$out") sessions)" || fail "envoy api: $(head -1 <<<"$out")"
            nu="$(jq -r ".envoy.natsUrls[0] // empty" "$ej" 2>/dev/null)"; hp="${nu#*://}"; hp="${hp##*@}"; hp="${hp%%/*}"; case "$hp" in *:*) ;; *) hp="$hp:4222";; esac
            timeout 5 python3 -c "import socket, sys; socket.create_connection((sys.argv[1], int(sys.argv[2])), 4).close()" "${hp%:*}" "${hp##*:}" 2>/dev/null && ok "envoy nats reachable ($hp)" || fail "envoy nats ${nu:-unset in $ej} unreachable"
            s="$(jq -r ".envoy.natsSeed // empty" "$ej" 2>/dev/null)"
            case "$s" in
                "") echo "note box: $ej names no natsSeed (envoy connects without a credential)";;
                "!"*) n="$(timeout 10 sh -c "${s#!}" 2>/dev/null | tr -d "[:space:]" | wc -c)"; [ "$n" -gt 0 ] && ok "natsSeed command prints a seed" || fail "natsSeed command ${s#!} printed nothing";;
                *) ok "natsSeed set in $ej";;
            esac
            ;;
        false) echo "note box: $ej turns Envoy off";;
        *) echo "note box: $ej has no envoy section with enabled true: box sessions have no Envoy";;
    esac
fi
c="$(curl -s -m 3 -o /dev/null -w %{http_code} "${MNEMOPI_EMBEDDING_API_URL:-http://none}/../health" 2>/dev/null)"; [ "$c" = 200 ] && ok "mnemopi embed" || echo "note box: mnemopi embed $c"
n="$(timeout 20 forward doctor 2>&1 | grep -cE "accepted|reachable|accepts")"; echo "@forward-ok $n"
timeout 30 docker info >/dev/null 2>&1 && ok "inner docker answers" || fail "inner docker"
exit $fails
'

# The doctor box and everything it made: the container, its enrollment, its filesystem and its
# directories.
remove_doctor_box() {
    local box="$1"
    docker rm -f "$box" >/dev/null 2>&1 || true
    unenroll_box "$box"
    rm -rf "${RUN_BASE:?}/$box"
    if close_box_disk "$box"; then rm -rf "${BOXES:?}/$box"; fi
}

# The box's host-dependent answers against this host's own (PROBE_FUNCS, @probe lines). Only a
# box that cannot do what the host can is a defect; where neither can, the line names the host
# login that is missing and the command that shows it, so a session reading doctor is not sent
# hunting its box for a credential this machine never had.
report_probes() {
    local box_out="$1" host_out name box_line host_line box_state box_detail host_state host_detail label
    host_out="$(bash -c "$PROBE_FUNCS probe_run ${PROBE_NAMES[*]}" 2>/dev/null)"
    for name in "${PROBE_NAMES[@]}" dockerauths; do
        box_line="$(sed -n "s/^@probe $name //p" <<<"$box_out" | head -1)"
        # The box's ghcr login is made from GHCR_PULL_TOKEN, so the secrets probe is its host side.
        host_line="$(sed -n "s/^@probe ${name/dockerauths/secrets} //p" <<<"$host_out" | head -1)"
        label="$(probe_label "$name")"
        if [[ -z "$box_line" ]]; then fail "box: $label: the box reported no answer"; continue; fi
        box_state="${box_line%% *}"; box_detail="${box_line#* }"
        host_state="${host_line%% *}"; host_detail="${host_line#* }"
        if [[ "$box_state" == ok ]]; then
            ok "box: $label: $box_detail"
        elif [[ "$host_state" == ok ]]; then
            fail "box: $label: $box_detail (the host answers: $host_detail - a box defect)"
        elif [[ "$box_detail" == "$host_detail" ]]; then
            # The usual shape: both sides say the same thing, so say it once.
            echo "note box: $label: host state, not the box - this machine cannot either: $box_detail. Show it with: $(probe_command "$name")"
        else
            echo "note box: $label: $box_detail; host state, not the box: this machine cannot either (${host_detail:-no host answer}). Show it with: $(probe_command "$name")"
        fi
    done
}

cmd_doctor() {
    if docker info --format '{{json .Runtimes}}' 2>/dev/null | grep -q sysbox-runc; then ok "host: sysbox-runc runtime"; else fail "host: sysbox-runc runtime not registered"; fi
    local tag; tag="$(image_tag)"
    [[ -n "$(docker image ls -q "$tag")" ]] && ok "host: image $tag built" || echo "note host: image $tag not built (built on next launch)"
    if [[ -d "$SRC" ]]; then ok "host: $SRC ($(repos | tr '\n' ' '))"; else fail "host: $SRC missing"; fi
    if [[ -S "/run/user/$UID_/bus" ]]; then ok "host: session bus"; else fail "host: session bus missing"; fi
    ensure_network && ok "host: network $NETWORK gateway $NETWORK_GATEWAY"
    ensure_forwarders && ok "host: forwarders (imds, envoy, bus)"
    local host_forward; host_forward="$(timeout 20 forward doctor 2>&1 | grep -cE 'accepted|reachable|accepts' || true)"
    # The broker, host side. A host whose helper holds no live launcher credential gives boxes and
    # host sessions no broker identity, and their agents use secretsd: a supported state, so a
    # note. Both helper checks run as a child of the user manager: doctor itself may be running
    # inside an agent session, which would make its own pid a session member.
    local helper_out
    if command -v agent-secrets >/dev/null 2>&1; then ok "host: agent-secrets on PATH"; else fail "host: agent-secrets not installed (mise install agent-secrets)"; fi
    if [[ ! -e "$HOME/.config/systemd/user/agent-secrets-helper.service" ]]; then
        echo "note host: agent-secrets-helper is not installed here (bash installers/agent-secrets.sh); boxes and host sessions use secretsd"
    elif ! systemctl --user is-active --quiet agent-secrets-helper.service || [[ ! -S "/run/user/$UID_/agent-secrets/helper.sock" ]]; then
        fail "host: agent-secrets-helper not active (systemctl --user status agent-secrets-helper)"
    else
        ok "host: agent-secrets-helper active ($(agent-secrets-helper sessions 2>/dev/null | wc -l) sessions)"
        helper_out="$(fresh_process agent-secrets whoami 2>&1 || true)"
        case "$helper_out" in *NOT_A_SESSION*) ok "host: helper refuses an unregistered process";; *) fail "host: helper answered an unregistered process: $(head -1 <<<"$helper_out")";; esac
        if broker_ready; then
            ok "host: launcher credential issued for $(cat "$LAUNCHER_DIR/operator" 2>/dev/null || echo unknown)"
            helper_out="$(fresh_process agent-secrets register --exec --wait 30 -- agent-secrets whoami 2>&1 || true)"
            if jq -e '.kind == "session"' <<<"$helper_out" >/dev/null 2>&1; then ok "host: helper enrolls and signs for a fresh session (kind $(jq -r .kind <<<"$helper_out"), operator $(jq -r .operator <<<"$helper_out"))"; else fail "host: helper session: $(head -1 <<<"$helper_out")"; fi
        else
            echo "note host: $BROKER_UNREADY; boxes and host sessions start without a broker identity and use secretsd"
        fi
    fi
    build_image "$tag"
    # A throwaway box on a throwaway clone of a small checkout: AGENTBOX_DOCTOR_REPO (default knives,
    # 12 MB of git), else the first checkout in $SRC with an origin. The first checkout by name can
    # be a fork of a large repository, whose template clone lands in ~/.cache on the root disk.
    local repo="" r box ws
    for r in "${AGENTBOX_DOCTOR_REPO:-knives}" $(repos); do
        [[ -e "$SRC/$r/.git" ]] && git -C "$SRC/$r" remote get-url origin >/dev/null 2>&1 && { repo="$r"; break; }
    done
    [[ -n "$repo" ]] || die "no checkout with an origin remote under $SRC to test with"
    box="agentbox-doctor$(tr -d '-' </proc/sys/kernel/random/uuid | cut -c1-6)"
    ws="$BOXES/$box/$repo"
    # Whatever ends doctor from here (a failed step under set -e, ^C, a hangup), the box goes with
    # it. The trap fires only in doctor itself, never in a $(…) subshell (see cmd_new).
    local doctor_pid=$BASHPID
    # shellcheck disable=SC2064
    trap "[[ \$BASHPID == $doctor_pid ]] && remove_doctor_box '$box'" EXIT
    trap 'exit 130' INT TERM HUP
    # The doctor box carries the same limits a session's box does, disk included, so the loop
    # mount itself - the one step that needs root - is part of what doctor tests.
    set_disk_bytes
    open_box_disk "$box"
    clone_checkout "$repo" "$ws" >/dev/null 2>&1 || die "doctor: could not clone $repo into $box"
    # 300 s for the box to reach its sleep: the first container of a freshly built image pays for
    # the runtime unpacking it, and the entrypoint waits up to 60 s for the inner dockerd on top.
    # A doctor run right after a rebuild hit the old 90 s ceiling on 2026-10-31 and reported a box
    # that was simply still starting as one that failed to start.
    local mounts=() env=() box_out="" tries=300
    mapfile -t mounts < <(mount_args "$box")
    mapfile -t env < <(session_env "$box")
    # The doctor box runs detached so it can be enrolled like a real box (enroll_box needs the
    # container up) before the checks run inside it; `sleep` is its session command, and the
    # entrypoint has finished — inner dockerd up, ghcr login done — once that sleep exists. It
    # carries the same limits a session's box does, so doctor tests what `new` actually starts.
    set_resource_args
    if docker run -d --init --runtime "$RUNTIME" --name "$box" --network "$NETWORK" --dns 100.100.100.100 --dns 1.1.1.1 \
        "${RESOURCE_ARGS[@]}" \
        -w "$ws" "${mounts[@]}" "${env[@]}" "$tag" sleep 1800 >/dev/null; then
        until docker exec "$box" pgrep -x sleep >/dev/null 2>&1 || (( --tries == 0 )); do sleep 1; done
        if (( tries )); then
            # Enrolled like a box from `new` when the host can enroll one; the host rows above say
            # why not, and the box-side checks show the rest.
            if broker_ready; then
                enroll_box "$box" "" || fail "host: enroll $box: $(cat "$(box_keydir "$box")/enrollment.error" 2>/dev/null)"
            fi
            box_out="$(docker exec --user ubuntu -w "$ws" "$box" bash -c "$PROBE_FUNCS$DOCTOR_BOX_SCRIPT" 2>&1)" || true
        else
            fail "host: doctor box did not reach sleep-running state"
        fi
    else
        fail "host: doctor box failed to start"
    fi
    trap - EXIT INT TERM HUP
    remove_doctor_box "$box"
    grep -vE '^@' <<<"$box_out"
    FAILS=$((FAILS + $(grep -c '^FAIL ' <<<"$box_out" || true)))
    report_probes "$box_out"
    local box_forward; box_forward="$(sed -n 's/^@forward-ok //p' <<<"$box_out")"
    if [[ "$box_forward" == "$host_forward" ]]; then ok "forward: $box_forward channel rows ok in box, same as host"; else fail "forward: $box_forward rows ok in box vs $host_forward on host (the box relays every channel the launcher found; journalctl --user -u 'agentbox-fwd-*' and /var/log/forward-relay.log in the box)"; fi
    (( FAILS == 0 )) && { echo "agentbox doctor: all checks passed"; exit 0; }
    echo "agentbox doctor: $FAILS check(s) failed" >&2
    exit 1
}

# The box-side half, run against THIS box instead of a throwaway one. `agentbox doctor` is a host
# command: from inside a box it fails the host probes (sysbox runtime, session bus, the IMDS
# forwarder's bind) that describe the caller's vantage rather than the box, and exits before the
# block it execs into a box — so the one tool that detects a box's own defects could not be run by
# the sessions that have them. Four sessions read those FAILs as their own box's health on
# 2026-09-26 while hunting a docker-credential defect this block reports directly.
cmd_doctor_here() {
    [[ -n "${AGENTBOX_BOX:-}" ]] || die "doctor --here runs INSIDE a box; on the host run 'agentbox doctor'"
    local out fails name line
    out="$(bash -c "$PROBE_FUNCS$DOCTOR_BOX_SCRIPT" 2>&1)" || true
    grep -vE '^@' <<<"$out"
    # Inside a box there is no host answer to compare with, so a credential the machine itself
    # may not hold is reported and never counted: `agentbox doctor` on the host is what tells a
    # box defect from a login this machine is missing.
    for name in "${PROBE_NAMES[@]}" dockerauths; do
        line="$(sed -n "s/^@probe $name //p" <<<"$out" | head -1)"
        case "$line" in
            ok\ *) ok "box: $(probe_label "$name"): ${line#ok }" ;;
            *) echo "note box: $(probe_label "$name"): ${line#fail }; host-dependent - run 'agentbox doctor' on the host to tell a box defect from a login this machine is missing" ;;
        esac
    done
    fails="$(grep -c '^FAIL ' <<<"$out" || true)"
    (( fails == 0 )) && { echo "agentbox doctor ($AGENTBOX_BOX): all box checks passed"; exit 0; }
    echo "agentbox doctor ($AGENTBOX_BOX): $fails check(s) failed" >&2
    exit 1
}

# Sourced (scripts/tests/test_agentbox_enroll.py), it defines its functions and runs nothing.
[[ "${BASH_SOURCE[0]}" == "$0" ]] || return 0

case "${1:-}" in
    new)     shift; cmd_new "$@" ;;
    sh)      shift; cmd_sh "$@" ;;
    ls)      cmd_ls ;;
    doctor)  shift; case "${1:-}" in --here|--box) cmd_doctor_here ;; "") cmd_doctor ;; *) die "doctor takes --here (this box) or no argument (host)" ;; esac ;;
    rebuild) cmd_rebuild ;;
    restart) shift; cmd_restart "$@" ;;
    move)    shift; cmd_move "$@" ;;
    # The usage block at the top of this file, which every command above is listed in: a
    # command missing from this case would otherwise print its own documentation as the usage.
    *) sed -n '2,35p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
esac
