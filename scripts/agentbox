#!/usr/bin/env bash
# agentbox: one disposable Sysbox container per agent session, working in a
# jj workspace made for it.
#
#   agentbox omp <repo> [omp args…]     one omp session in its own box
#   agentbox sh <box|session-id> [cmd…] exec into a running session's box
#   agentbox ls                         running boxes
#   agentbox doctor                     health checks, host side and box side
#   agentbox rebuild                    build the image now; list boxes on older tags
#
# <repo> names a canonical checkout under $AGENTBOX_SRC (default ~/src). The
# launcher adds a jj workspace of it at ~/boxes/<box>/<repo>, runs omp there
# as the container's main process (`docker run --rm`), and when omp exits —
# however it exits — snapshots the working copy, forgets the workspace,
# releases every knives claim the session holds, and removes ~/boxes/<box>.
# Work survives as commits in the canonical repo; the directory does not.
# `--resume`, `-c` and every other flag go straight to omp: a resumed
# conversation gets a fresh workspace on trunk, as on any new morning.
#
# The box sees an explicit allow-list of the home directory and nothing else:
# the canonical checkouts, its own box dir, omp state (sessions, memory,
# config), the dotfiles, the mise tool store and language caches, ~/.aws,
# ~/.kube, ~/.pulumi, the tool configs a session relies on, the jj-signing
# pair, and the host sockets (secretsd, forward, hawk-token). The user's
# GitHub login, ssh keys, keyrings and docker login are not mounted, so an
# agent inside pushes only as the GitHub App its repo routes to
# (gh-app-routes.gitconfig). AWS is the exception by design: every profile
# works as on the host through a metadata-service forwarder on the box
# network, while the containers a box starts are firewalled off it inside the
# box (devpod/entrypoint.sh). Root inside is Sysbox fake-root: `sudo apt` and
# the inner dockerd work without host privileges and die with the box.
# Image: devpod/Dockerfile.
set -euo pipefail

DOTFILES_DIR="${DOTFILES_DIR:-$HOME/.dotfiles}"
SRC="${AGENTBOX_SRC:-$HOME/src}"
BOXES="$HOME/boxes"
RUNTIME=sysbox-runc
NETWORK=agentbox
EMBED_NAME=omp-embed
EMBED_PORT="${OMP_EMBED_PORT:-8087}"
IMDS_PORT="${AGENTBOX_IMDS_PORT:-8169}"
IMDS_UNIT=agentbox-imds
# The Envoy HTTP API listens on the host's loopback (envoy-listener, :9020);
# a box reaches it through the same kind of forwarder as the metadata service.
ENVOY_PORT="${AGENTBOX_ENVOY_PORT:-9020}"
ENVOY_UNIT=agentbox-envoy
HAWK_UNIT=agentbox-hawk-token
UID_="$(id -u)"
RUN_BASE="/run/user/$UID_/agentbox"
# A directory rather than the bare socket so a box sees the socket socat
# recreates after a restart of the unit; a bind of the file would pin the
# dead inode. scripts/hawk-token reads the same path inside the box.
HAWK_SOCK_DIR="$RUN_BASE/hawk-token"
HAWK_SOCK="$HAWK_SOCK_DIR/hawk-token.sock"

# What a session relies on, and nothing more. rw: state the session writes.
# ro: configuration. A missing entry is skipped (ro) or created (rw) so the
# list is the same on every machine.
MOUNT_RW=(
    .omp .config/omp .cache/omp                 # sessions, memory, settings
    .mise .cache/mise .config/mise               # the pinned tool store
    .bun .npm .cache/uv .local/share/uv .cargo .rustup .cache/ms-playwright
    .aws .kube .pulumi                            # cloud access (AWS by design)
    .config/trajectory-labs .config/taiga        # work identities agents use
    .config/gws .config/knives .cache/knives
    .config/opencode .claude .local/bin .mcp-auth .pcscd
)
MOUNT_RO=(
    .config/forward .config/jj .config/secretsd .config/sops .npmrc .gitconfig
    .ssh/jj-signing .ssh/jj-signing.pub
)

die() { echo "agentbox: $*" >&2; exit 1; }

# The canonical checkouts, one name per line.
repos() { find "$SRC" -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -printf '%f\n' 2>/dev/null | sort; }

# Image tag is the content hash of what builds it, so an edit to any image
# input yields a new tag built on the next launch; running boxes on the old
# tag are listed by `rebuild` and move when their sessions restart.
image_tag() {
    local h
    h="$(cat "$DOTFILES_DIR/devpod/Dockerfile" "$DOTFILES_DIR/devpod/entrypoint.sh" | sha256sum | cut -c1-12)"
    echo "agentbox:$h"
}

build_image() {
    local tag="$1"
    if [[ -z "$(docker image ls -q "$tag")" ]]; then
        echo "agentbox: building $tag" >&2
        # buildx with the default builder: ~/.docker/config.json may alias
        # `docker build` to depot, which needs a project this image has none of.
        docker buildx build --builder default --load -t "$tag" "$DOTFILES_DIR/devpod" >&2
    fi
}

ensure_network() {
    docker network inspect "$NETWORK" >/dev/null 2>&1 || docker network create "$NETWORK" >/dev/null
    # omp-embed (installers/omp-embed.sh) serves mnemopi embeddings for every
    # session on the machine; boxes reach it by name on this network.
    if docker inspect "$EMBED_NAME" >/dev/null 2>&1 \
        && ! docker inspect -f '{{json .NetworkSettings.Networks}}' "$EMBED_NAME" | grep -q "\"$NETWORK\""; then
        docker network connect "$NETWORK" "$EMBED_NAME"
    fi
    NETWORK_GATEWAY="$(docker network inspect -f '{{(index .IPAM.Config 0).Gateway}}' "$NETWORK")"
    NETWORK_SUBNET="$(docker network inspect -f '{{(index .IPAM.Config 0).Subnet}}' "$NETWORK")"
    [[ -n "$NETWORK_GATEWAY" && -n "$NETWORK_SUBNET" ]] || die "network $NETWORK has no IPv4 gateway/subnet"
}

# A host TCP forwarder as a transient user unit: listens only on the box
# network's gateway address and only for sources inside that network, relays
# to a host-side address. Nothing to install, restarted if socat dies,
# recreated here after a reboot. Used for the EC2 metadata service (its
# one-hop reply reaches a host process, not a container) and the Envoy API
# (host loopback).
ensure_tcp_forwarder() {
    local unit="$1" port="$2" target="$3"
    systemctl --user is-active --quiet "$unit" && return 0
    if systemctl --user is-failed --quiet "$unit"; then
        systemctl --user reset-failed "$unit"
    fi
    systemd-run --user --unit "$unit" --quiet --collect --property=Restart=always --property=RestartSec=1 \
        socat "TCP4-LISTEN:$port,bind=$NETWORK_GATEWAY,range=$NETWORK_SUBNET,fork,reuseaddr" "TCP4:$target"
    local _
    for _ in $(seq 1 20); do
        ss -ltn "sport = :$port" 2>/dev/null | grep -q "$NETWORK_GATEWAY:$port" && return 0
        sleep 0.25
    done
    die "forwarder $unit did not bind $NETWORK_GATEWAY:$port (journalctl --user -u $unit)"
}

# Hawk token forwarder: hawk keeps the user's Cognito session in the GNOME
# keyring, which stays out of the box (it also holds the gh login), so the
# host mints instead. socat runs scripts/hawk-token once per connection and
# streams the one JWT back; the box side of hawk-token connects here. The
# user manager's environment carries the session bus, so the keyring answers
# from the unit exactly as from a shell.
ensure_hawk_forwarder() {
    mkdir -p "$HAWK_SOCK_DIR"
    if ! systemctl --user is-active --quiet "$HAWK_UNIT"; then
        if systemctl --user is-failed --quiet "$HAWK_UNIT"; then
            systemctl --user reset-failed "$HAWK_UNIT"
        fi
        systemd-run --user --unit "$HAWK_UNIT" --quiet --collect --property=Restart=always --property=RestartSec=1 \
            socat "UNIX-LISTEN:$HAWK_SOCK,fork,mode=600,unlink-early" \
            EXEC:"$DOTFILES_DIR/scripts/hawk-token"
    fi
    local _
    for _ in $(seq 1 20); do
        [[ -S "$HAWK_SOCK" ]] && return 0
        sleep 0.25
    done
    die "hawk-token forwarder $HAWK_UNIT did not open $HAWK_SOCK (journalctl --user -u $HAWK_UNIT)"
}

# The allow-list, as docker -v arguments. rw dirs are created on the host
# first so docker never creates them root-owned; symlinked entries (the
# dotfiles' config files) are bound by target so the box sees content, not a
# link into an unmounted path.
mount_args() {
    local box="$1" a=() p src
    a+=(-v "$SRC:$SRC")
    # $SRC may hold symlinks to checkouts elsewhere (~/src/dotfiles → ~/.dotfiles);
    # each target is mounted at its own path so the link resolves inside.
    for p in "$SRC"/*; do
        [[ -L "$p" ]] || continue
        src="$(readlink -f "$p")"
        a+=(-v "$src:$src")
    done
    a+=(-v "$BOXES/$box:$BOXES/$box")
    [[ "$DOTFILES_DIR" == "$SRC"/* || "$(readlink -f "$DOTFILES_DIR")" == "$(readlink -f "$HOME/.dotfiles")" ]] \
        || a+=(-v "$DOTFILES_DIR:$DOTFILES_DIR")
    a+=(-v "$HOME/.dotfiles:$HOME/.dotfiles")
    for p in "${MOUNT_RW[@]}"; do
        mkdir -p "$HOME/$p"
        a+=(-v "$HOME/$p:$HOME/$p")
    done
    for p in "${MOUNT_RO[@]}"; do
        [[ -e "$HOME/$p" ]] || continue
        a+=(-v "$(readlink -f "$HOME/$p"):$HOME/$p:ro")
    done
    # The session's runtime dir is an empty per-box dir owned by ubuntu (omp
    # refuses a root-owned one when registering with secretsd); the host
    # sockets are bound inside it, their mountpoints pre-created as ubuntu so
    # the dir can be removed at close. Never the whole /run/user/$UID_: the
    # gnupg and keyring sockets there are identity.
    local run_user="$RUN_BASE/$box/run-user"
    mkdir -p "$run_user/secretsd" "$run_user/forward" "$run_user/agentbox/hawk-token"
    touch "$run_user/secretsd.sock" "$run_user/forward-arm.sock" "$run_user/forward-browser-grant.sock"
    a+=(-v "$run_user:/run/user/$UID_")
    [[ -S "/run/user/$UID_/secretsd.sock" ]] || die "secretsd is not running (no /run/user/$UID_/secretsd.sock)"
    a+=(-v "/run/user/$UID_/secretsd.sock:/run/user/$UID_/secretsd.sock")
    a+=(-v "/run/user/$UID_/secretsd:/run/user/$UID_/secretsd")
    local s
    for s in forward forward-arm.sock forward-browser-grant.sock; do
        [[ -e "/run/user/$UID_/$s" ]] && a+=(-v "/run/user/$UID_/$s:/run/user/$UID_/$s")
    done
    [[ -S "$HAWK_SOCK" ]] || die "hawk-token forwarder socket missing ($HAWK_SOCK); run \`agentbox doctor\`"
    a+=(-v "$HAWK_SOCK_DIR:$HAWK_SOCK_DIR")
    # The inner dockerd's image store: anonymous, dies with the box.
    a+=(-v /var/lib/docker)
    printf '%s\n' "${a[@]}"
}

session_env() {
    local box="$1" e=()
    e+=(-e "XDG_RUNTIME_DIR=/run/user/$UID_")
    e+=(-e "HOME=$HOME" -e USER=ubuntu -e "TERM=${TERM:-xterm-256color}" -e "DOTFILES_DIR=$DOTFILES_DIR")
    # mise: the host's tool store, activated the way .bashrc does (shims mode).
    e+=(-e "MISE_DATA_DIR=$HOME/.mise")
    e+=(-e "PATH=$DOTFILES_DIR/shims:$DOTFILES_DIR/bin:$DOTFILES_DIR/scripts:$HOME/.mise/shims:$HOME/.local/bin:$HOME/.pulumi/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin")
    e+=(-e "JJ_CONFIG=$HOME/.config/jj/config.toml:$DOTFILES_DIR/.jjconfig.toml")
    e+=(-e "ENVOY_NATS_URL=${ENVOY_NATS_URL:-nats://envoy-nats:4222}")
    # The Envoy HTTP API (subscriptions, inbox) lives on the host loopback;
    # boxes reach it through the forwarder on the gateway.
    e+=(-e "ENVOY_URL=http://$NETWORK_GATEWAY:$ENVOY_PORT")
    # $DOTFILES_DIR/bin holds gitignored binaries (mise, a local jj) that only
    # the installed ~/.dotfiles has; a checkout under test (DOTFILES_DIR set
    # elsewhere) still needs them, so the installed bin follows its own.
    e+=(-e "PATH=$DOTFILES_DIR/shims:$DOTFILES_DIR/bin:$HOME/.dotfiles/bin:$DOTFILES_DIR/scripts:$HOME/.mise/shims:$HOME/.local/bin:$HOME/.pulumi/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin")
    # Every AWS profile works as on the host: the SSO ones from the mounted
    # ~/.aws, the instance-role ones through the metadata forwarder. The
    # forwarder address also feeds the inner dockerd's firewall rule.
    e+=(-e "AWS_EC2_METADATA_SERVICE_ENDPOINT=http://$NETWORK_GATEWAY:$IMDS_PORT")
    e+=(-e "AGENTBOX_IMDS_FORWARDER=$NETWORK_GATEWAY:$IMDS_PORT")
    # Same gh-app routing include shims/omp and scripts/oc export on the host.
    e+=(-e GIT_CONFIG_COUNT=1 -e GIT_CONFIG_KEY_0=include.path -e "GIT_CONFIG_VALUE_0=$DOTFILES_DIR/gh-app-routes.gitconfig")
    e+=(-e "AGENTBOX_BOX=$box" -e AGENTBOX_USER=ubuntu)
    # The shared embedding server, only while it answers on the host; a dead
    # server would otherwise put every box session on keyword-only recall.
    if curl -fsS -m 1 "http://127.0.0.1:${EMBED_PORT}/health" >/dev/null 2>&1; then
        e+=(-e "MNEMOPI_EMBEDDING_API_URL=http://$EMBED_NAME/v1")
    fi
    # The pane this session lives in, so tmux-resurrect-omp can find the omp
    # process inside the box (its environ) and save `agentbox omp --resume`.
    [[ -n "${TMUX_PANE:-}" ]] && e+=(-e "TMUX_PANE=$TMUX_PANE")
    printf '%s\n' "${e[@]}"
}

# The session id of the omp running in a box: the TUI holds its session file
# open, ~/.omp/agent/sessions/<dir>/<ts>_<id>.jsonl, so it is read from the
# process's fd table (omp exports OMP_SESSION_ID to its children, not itself).
# Empty while omp is not up yet, after it exited, or for a --no-session run.
box_session_id() {
    docker exec "$1" sh -c '
        for p in $(pgrep -x omp); do
            for fd in /proc/$p/fd/*; do
                readlink "$fd" 2>/dev/null
            done
        done | sed -n "s#.*/\\.omp/agent/sessions/[^/]*/[0-9T:-]*Z_\\([0-9a-f-]\\{36\\}\\)\\.jsonl\$#\\1#p" | head -1' 2>/dev/null || true
}

# Release every knives claim the session holds. Claims are keyed by the omp
# session id (kind harness-session), so acting as that session releases them
# without --force; knives forgets and removes the workspace itself and keeps
# the commits. The registry (repos.toml) names each checkout.
finish_knives_claims() {
    local sid="$1" state="$HOME/.config/knives/state.json" repo branch path
    [[ -n "$sid" && -s "$state" ]] || return 0
    while IFS=$'\t' read -r repo branch; do
        [[ -n "$repo" && -n "$branch" ]] || continue
        path="$(knives repos --json 2>/dev/null | jq -r --arg r "$repo" '.repos[] | select(.name == $r) | .path')"
        if [[ -z "$path" || ! -d "$path" ]]; then
            echo "agentbox: knives claim $repo/$branch: checkout not found; left as is" >&2
            continue
        fi
        if ! (cd "$path" && OMP_SESSION_ID="$sid" knives finish "$branch"); then
            echo "agentbox: knives finish $repo/$branch failed; left as is" >&2
        fi
    done < <(jq -r --arg s "$sid" '.. | objects | select(.owner? == $s) | "\(.repo)\t\(.branch)"' "$state")
}

# Everything the box made goes: the knives claims its session holds, then its
# own workspace (snapshotted first, so uncommitted edits are a commit in the
# canonical repo), then the directory. The container must be gone first — it
# holds the mounts, and docker recreates a removed mountpoint root-owned.
close_box() {
    local box="$1" repo="$2" sid="$3" _
    local ws="$BOXES/$box/$repo"
    for _ in $(seq 1 60); do
        docker inspect "$box" >/dev/null 2>&1 || break
        sleep 1
    done
    if docker inspect "$box" >/dev/null 2>&1; then
        echo "agentbox: $box is still running after 60s; removing it" >&2
        docker rm -f "$box" >/dev/null 2>&1 || true
    fi
    finish_knives_claims "$sid"
    if [[ -d "$ws/.jj" ]]; then
        # `jj st` snapshots the working copy into @.
        if jj -R "$ws" st >/dev/null 2>&1; then
            jj -R "$SRC/$repo" workspace forget "$box" \
                || echo "agentbox: workspace forget $box failed; $ws left in place" >&2
        else
            echo "agentbox: could not snapshot $ws; left in place" >&2
            return 0
        fi
    fi
    rm -rf "${BOXES:?}/$box" "${RUN_BASE:?}/$box"
}

# The directory a session was started in, from its own record (the `cwd` the
# session file carries). Accepts an id or an id prefix; empty unless exactly
# one session matches.
session_cwd() {
    local m=()
    mapfile -t m < <(compgen -G "$HOME/.omp/agent/sessions/*/*_$1*.jsonl" || true)
    (( ${#m[@]} == 1 )) || return 0
    grep -m1 -oE '"cwd":"[^"]+"' "${m[0]}" | cut -d'"' -f4
}

cmd_omp() {
    local repo="${1:-}"
    [[ -n "$repo" && "$repo" != -* ]] || die "usage: agentbox omp <repo> [omp args…]  (repos: $(repos | tr '\n' ' '))"
    shift
    [[ -d "$SRC/$repo" ]] || die "no checkout $SRC/$repo (repos: $(repos | tr '\n' ' '))"
    [[ -e "$SRC/$repo/.jj" ]] || die "$SRC/$repo is not a jj repository"

    # omp ties a session to the directory it started in and refuses to resume
    # one whose directory is gone — and a box's directory goes at close. So a
    # resumed boxed session gets its workspace back at the same path: the box
    # takes the old name. A session from anywhere else (the host, another
    # repo) is omp's to judge, as on the host.
    local box="" a i cwd
    local in=("$@")
    for ((i = 0; i < ${#in[@]}; i++)); do
        a="${in[i]}"
        case "$a" in
            --resume=*) cwd="$(session_cwd "${a#--resume=}")" ;;
            --resume|-r) [[ -n "${in[i+1]:-}" && "${in[i+1]}" != -* ]] && cwd="$(session_cwd "${in[i+1]}")" ;;
            *) continue ;;
        esac
        if [[ "${cwd:-}" =~ ^"$BOXES"/(agentbox-[0-9a-f]{12})/"$repo"$ ]]; then
            box="${BASH_REMATCH[1]}"
        fi
    done
    [[ -n "$box" ]] || box="agentbox-$(tr -d '-' </proc/sys/kernel/random/uuid | cut -c1-12)"
    docker inspect "$box" >/dev/null 2>&1 && die "$box is already running (that session is open in another box)"
    local tag
    tag="$(image_tag)"
    build_image "$tag"
    ensure_network
    ensure_tcp_forwarder "$IMDS_UNIT" "$IMDS_PORT" 169.254.169.254:80
    ensure_tcp_forwarder "$ENVOY_UNIT" "$ENVOY_PORT" "127.0.0.1:$ENVOY_PORT"
    ensure_hawk_forwarder

    local ws="$BOXES/$box/$repo"
    mkdir -p "$BOXES/$box"
    jj -R "$SRC/$repo" workspace add --name "$box" "$ws" >&2
    # From here the workspace exists: whatever fails before or during the
    # session, the box's directory and workspace never outlive the launcher.
    # Values are expanded now (the trap outlives this function's locals) and
    # the trap runs only in the launcher itself, never in a $(…) subshell,
    # which inherits EXIT traps in bash.
    local launcher_pid=$BASHPID
    # shellcheck disable=SC2064
    trap "[[ \$BASHPID == $launcher_pid ]] && close_box '$box' '$repo' ''" EXIT

    local mounts=() env=()
    mapfile -t mounts < <(mount_args "$box")
    mapfile -t env < <(session_env "$box")
    local tty=(-i)
    [[ -t 0 && -t 1 ]] && tty=(-it)
    # Not exec'd: close_box must run after the container exits, whatever the
    # exit reason. docker run runs as a background child (same process group,
    # so it keeps the terminal); a tmux pane kill or TERM lands here too, and
    # the trap forwards a hangup into the box, because the in-box omp does not
    # die with its docker client. --init delivers it to omp, the session ends,
    # --rm fires, and close still runs.
    trap 'docker kill -s SIGHUP "$box" >/dev/null 2>&1 || true' HUP TERM INT
    local rc=0 child sid="" stdin_fd
    # The explicit stdin dup matters: a job-control-less background child gets
    # /dev/null for stdin, which -it refuses ("stdin is not a terminal").
    exec {stdin_fd}<&0
    docker run --rm --init --runtime "$RUNTIME" --name "$box" --hostname "$box" \
        --network "$NETWORK" --dns 100.100.100.100 --dns 1.1.1.1 \
        -w "$ws" "${tty[@]}" \
        "${mounts[@]}" "${env[@]}" "$tag" "$DOTFILES_DIR/shims/omp" "$@" <&"$stdin_fd" &
    child=$!
    # The session id is only knowable from the running omp; poll for it until
    # the container is gone so close can release the session's knives claims.
    while kill -0 "$child" 2>/dev/null; do
        sid="$(box_session_id "$box")"
        [[ -n "$sid" ]] && break
        sleep 2
    done
    # An interrupted wait re-waits: the first return after a signal carries
    # 128+sig, the child's real status arrives once it is reaped.
    while :; do
        if wait "$child"; then rc=0; else rc=$?; fi
        kill -0 "$child" 2>/dev/null || break
    done
    trap - HUP TERM INT EXIT
    close_box "$box" "$repo" "$sid"
    exit "$rc"
}

# The box a target names: a running box (exact name or unique prefix), or the
# omp session id (or prefix) of the omp running in one.
resolve_box() {
    local target="$1" b matches=()
    mapfile -t matches < <(docker ps --filter name='^agentbox-' --format '{{.Names}}' | grep -E "^(agentbox-)?${target}" || true)
    if (( ${#matches[@]} == 1 )); then printf '%s\n' "${matches[0]}"; return 0; fi
    for b in $(docker ps --filter name='^agentbox-' --format '{{.Names}}'); do
        if [[ "$(box_session_id "$b")" == "$target"* ]]; then printf '%s\n' "$b"; return 0; fi
    done
    return 1
}

cmd_sh() {
    local target="${1:-}"
    [[ -n "$target" ]] || die "box name or session id required"
    shift
    local box wdir
    box="$(resolve_box "$target")" || die "no running box matches $target"
    wdir="$(docker inspect -f '{{.Config.WorkingDir}}' "$box")"
    local tty=(-i)
    [[ -t 0 && -t 1 ]] && tty=(-it)
    local cmd=("$@")
    (( ${#cmd[@]} )) || cmd=(bash)
    # docker exec carries the container's launch env (PATH, routing, sockets);
    # only the caller's terminal needs passing through.
    exec docker exec "${tty[@]}" --user ubuntu -e "TERM=${TERM:-xterm-256color}" -w "$wdir" "$box" "${cmd[@]}"
}

cmd_rebuild() {
    local tag
    tag="$(image_tag)"
    build_image "$tag"
    local stale
    stale="$(docker ps --filter name='^agentbox-' --format '{{.Names}} {{.Image}}' | awk -v t="$tag" '$2 != t {print $1}')"
    if [[ -n "$stale" ]]; then
        echo "agentbox: boxes on an older image (they move when their sessions restart):" >&2
        echo "$stale" >&2
    fi
    echo "agentbox: image $tag"
}

cmd_ls() { docker ps --filter name='^agentbox-' --format 'table {{.Names}}\t{{.Image}}\t{{.Status}}'; }

FAILS=0
ok() { echo "ok   $*"; }
fail() { echo "FAIL $*"; FAILS=$((FAILS + 1)); }

# The box side of doctor, run under bash inside a throwaway box. The single
# quotes are the point: everything expands inside the box.
# shellcheck disable=SC2016
DOCTOR_BOX_SCRIPT='
set -u
fails=0
ok() { echo "ok   box: $*"; }
fail() { echo "FAIL box: $*"; fails=$((fails + 1)); }
for t in omp jj gh knives aws gws kubectl pulumi docker socat google-chrome pip psql sqlite3 wget forward secrets hawk-token; do
    command -v "$t" >/dev/null 2>&1 && ok "tool $t" || fail "tool $t does not resolve"
done
for d in .config/gh .ssh/id_ed25519 .gnupg .local/share/keyrings .config/gcloud .codex; do
    [ -e "$HOME/$d" ] && fail "$d is present in the box" || ok "$d absent"
done
[ "$(ls -A "$HOME/.ssh" | sort | tr "\n" " ")" = "jj-signing jj-signing.pub " ] && ok ".ssh holds exactly the jj-signing pair" || fail ".ssh contents: $(ls -A "$HOME/.ssh" | tr "\n" " ")"
auths="$(jq -r ".auths | keys | join(\",\")" "$HOME/.docker/config.json" 2>/dev/null)"; [ "$auths" = ghcr.io ] && ok ".docker holds only the box ghcr login" || fail ".docker auths: ${auths:-none}"
[ "$(stat -c %U /run/user/$(id -u))" = ubuntu ] && ok "runtime dir owned by ubuntu" || fail "runtime dir owner $(stat -c %U /run/user/$(id -u))"
touch "$HOME/.omp/.doctor.$$" 2>/dev/null && { ok "~/.omp writable"; rm -f "$HOME/.omp/.doctor.$$"; } || fail "~/.omp not writable"
[ -n "$(jj log -r @ --no-graph -T change_id 2>/dev/null)" ] && ok "cwd is a jj workspace" || fail "cwd is not a jj workspace"
out="$(gh api user 2>&1)"; case "$out" in *"Resource not accessible by integration"*) ok "gh runs as an App (never the user)";; *) fail "gh api user: $(echo "$out" | head -1)";; esac
gh auth status 2>&1 | grep -q "not logged" && ok "gh auth: no user login" || fail "gh auth status shows a login"
n="$(secrets GHCR_PULL_TOKEN -- sh -c "echo \${#GHCR_PULL_TOKEN}" 2>/dev/null)"; [ "${n:-0}" -gt 0 ] && ok "secrets agent-tier" || fail "secrets agent-tier"
# The broker serves a box as of forward v3.2.2 (a same-uid peer arrives as the
# overflow uid through the private userns the daemon runs in). A reset here is
# the regression, not the expectation. No grant is requested: `grants` is an
# unscoped control op, so it answers without making the human key blink.
out="$(timeout 20 secrets grants 2>&1)"; case "$out" in *"Connection reset"*|*"foreign uid"*) fail "secrets human-tier: broker refused a box peer: ${out##*: }";; *"no active grants"*|*"KEY"*|*grant*) ok "secrets human-tier: broker answered";; *) fail "secrets human-tier: $(echo "$out" | tail -1)";; esac
arn="$(timeout 20 aws sts get-caller-identity --query Arn --output text 2>&1)"; case "$arn" in arn:aws:*) ok "aws default profile: ${arn##*/}";; *) fail "aws: $arn";; esac
t="$(timeout 60 hawk-token 2>&1 | head -1)"; case "$t" in *.*.*) ok "hawk-token mints (${#t} bytes)";; *) fail "hawk-token: $t";; esac
timeout 40 google-user-token >/dev/null 2>&1 && ok "google-user-token mints" || fail "google-user-token"
timeout 5 bash -c "exec 3<>/dev/tcp/envoy-nats/4222" 2>/dev/null && ok "envoy nats reachable" || fail "envoy nats unreachable"
c="$(curl -s -m 3 -o /dev/null -w %{http_code} "$ENVOY_URL/" 2>/dev/null)"; [ "$c" != 000 ] && ok "envoy api reachable ($ENVOY_URL → $c)" || fail "envoy api $ENVOY_URL unreachable"
c="$(curl -s -m 3 -o /dev/null -w %{http_code} "${MNEMOPI_EMBEDDING_API_URL:-http://none}/../health" 2>/dev/null)"; [ "$c" = 200 ] && ok "mnemopi embed" || echo "note box: mnemopi embed $c"
n="$(timeout 20 forward doctor 2>&1 | grep -cE "accepted|reachable|accepts")"; echo "@forward-ok $n"
timeout 30 docker info >/dev/null 2>&1 && ok "inner docker answers" || fail "inner docker"
exit $fails
'

cmd_doctor() {
    if docker info --format '{{json .Runtimes}}' 2>/dev/null | grep -q sysbox-runc; then ok "host: sysbox-runc runtime"; else fail "host: sysbox-runc runtime not registered"; fi
    local tag; tag="$(image_tag)"
    [[ -n "$(docker image ls -q "$tag")" ]] && ok "host: image $tag built" || echo "note host: image $tag not built (built on next launch)"
    if [[ -d "$SRC" ]]; then ok "host: $SRC ($(repos | tr '\n' ' '))"; else fail "host: $SRC missing"; fi
    if [[ -S "/run/user/$UID_/secretsd.sock" ]]; then ok "host: secretsd socket"; else fail "host: secretsd socket missing"; fi
    ensure_network && ok "host: network $NETWORK gateway $NETWORK_GATEWAY"
    ensure_tcp_forwarder "$IMDS_UNIT" "$IMDS_PORT" 169.254.169.254:80 && ok "host: imds forwarder"
    ensure_tcp_forwarder "$ENVOY_UNIT" "$ENVOY_PORT" "127.0.0.1:$ENVOY_PORT" && ok "host: envoy forwarder"
    ensure_hawk_forwarder && ok "host: hawk-token forwarder"
    local host_forward; host_forward="$(timeout 20 forward doctor 2>&1 | grep -cE 'accepted|reachable|accepts' || true)"
    build_image "$tag"
    # A throwaway box on a throwaway workspace of the first repo in $SRC.
    local repo box ws
    repo="$(repos | head -1)"
    [[ -n "$repo" ]] || die "no repo under $SRC to test with"
    box="agentbox-doctor$(tr -d '-' </proc/sys/kernel/random/uuid | cut -c1-6)"
    ws="$BOXES/$box/$repo"
    mkdir -p "$BOXES/$box"
    jj -R "$SRC/$repo" workspace add --name "$box" "$ws" >/dev/null 2>&1
    local mounts=() env=() out
    mapfile -t mounts < <(mount_args "$box")
    mapfile -t env < <(session_env "$box")
    out="$(docker run --rm --init --runtime "$RUNTIME" --name "$box" --network "$NETWORK" --dns 100.100.100.100 --dns 1.1.1.1 \
        -w "$ws" "${mounts[@]}" "${env[@]}" "$tag" bash -c "$DOCTOR_BOX_SCRIPT" 2>&1)" || true
    jj -R "$SRC/$repo" workspace forget "$box" >/dev/null 2>&1 || true
    rm -rf "${BOXES:?}/$box" "${RUN_BASE:?}/$box"
    grep -vE '^@' <<<"$out"
    FAILS=$((FAILS + $(grep -c '^FAIL ' <<<"$out" || true)))
    local box_forward; box_forward="$(sed -n 's/^@forward-ok //p' <<<"$out")"
    if [[ "$box_forward" == "$host_forward" ]]; then ok "forward: $box_forward channel rows ok in box, same as host"; else fail "forward: $box_forward rows ok in box vs $host_forward on host"; fi
    (( FAILS == 0 )) && { echo "agentbox doctor: all checks passed"; exit 0; }
    echo "agentbox doctor: $FAILS check(s) failed" >&2
    exit 1
}

case "${1:-}" in
    omp)     shift; cmd_omp "$@" ;;
    sh)      shift; cmd_sh "$@" ;;
    ls)      cmd_ls ;;
    doctor)  cmd_doctor ;;
    rebuild) cmd_rebuild ;;
    *) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
esac
