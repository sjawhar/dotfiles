#!/usr/bin/env python3
"""tmux-resurrect post-save-layout hook: save omp panes as resumable commands.

resurrect records each pane's command as the shell's child argv, which for omp
is the resolved mise binary path plus whatever flags it was started with —
usually nothing, since a session started fresh has no id on its command line.
Restoring that would start a new session, not the one that was running.

A running session is read from the omp process's fd table, where its session
file ~/.omp/agent/sessions/<dir>/<ts>_<id>.jsonl is open: omp's session writer
keeps that fd for its lifetime. The writer is created by the first write, so a
session that has not been written to since this process started it has no fd —
an agent idle at its prompt, which is the state an autosave usually finds. Its
own argv still names the session (`--resume`/`--restore`/`-r`, as an id or a
session file path), so that is read next, and the pane's saved command last.
A session entered fresh, with `-c`, or through the in-app picker leaves nothing
on the command line, and is resolvable only while its fd is open.

Each omp pane line is rewritten to a command that resumes that session where it
was running:

- a pane running omp on the host becomes `omp --resume <id>`;
- a pane running `agentbox new … -- …` (scripts/agentbox) shows the launcher
  as its command; the omp process lives in the box under another uid, so it is
  found by asking each box for omp processes whose TMUX_PANE names this pane,
  and the line becomes `agentbox new <spec> -- omp --resume <id>`, where
  <spec> is everything the launcher was given before `--` (its repos and -e
  variables). A pane whose command carries no such launcher line (the exec
  client naming the box, or a box launched before the `--` form) falls back to
  the repo in the session file's own directory bucket (a box works in
  ~/boxes/<box>/<repo>, so the bucket is `-boxes-<box>-<repo>`); the launcher
  makes a fresh box and workspaces on resume, and omp relocates the session
  file into its bucket.

`@resurrect-processes` in .tmux.conf lists both shapes. Invoked by resurrect
with the save file path; panes whose session cannot be determined (omp still
starting, process gone) are left as written and come back as a shell in the
same directory.
"""

from __future__ import annotations

import os
import re
import subprocess
import sys
from pathlib import Path

SESSION_FILE = re.compile(
    r"/\.omp/agent/sessions/(?P<bucket>[^/]+)/"
    r"\d{4}-\d{2}-\d{2}T[0-9-]+Z_(?P<sid>[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})\.jsonl$"
)
# How a session was named on the command line that started this omp: a session
# file path, a full id, or the id prefix omp also accepts. Each is already a
# value `omp --resume` takes, so whatever was matched is passed through as-is
# unless it is a path, whose id is read out of it.
RESUME_ARG = re.compile(r"(?:^|\s)(?:--resume|--restore|-r)[=\s]+(?P<value>\S+)")
SESSION_ID = re.compile(r"[0-9a-f]{8}(?:[0-9a-f-]*[0-9a-f])?$")
# A pane whose foreground process is a box session. resurrect records the pane
# leader's argv: the launcher itself (`bash /…/scripts/agentbox new …`, since
# it waits on `docker run` to run the close phase rather than exec-ing it), a
# `agentbox new <spec> -- omp --resume <id>` line, or the exec client naming the box.
BOX_PANE = re.compile(r"(?:^|[\s/])agentbox(?:\s+new(?:\s|$)|-[^\s]+)")
# What a launcher line was given before its `--`: repos and -e variables.
LAUNCH_SPEC = re.compile(r"(?:^|[\s/])agentbox\s+new\s+(?P<spec>.+?)\s+--(?:\s|$)")
MAX_DEPTH = 4
MAX_PROCESSES = 32
FIELD_SEP = "\t"

# Run inside a box: every omp process's pane id, open session files and argv.
BOX_SESSIONS_SCRIPT = r"""
for p in $(pgrep -x omp); do
  pane="$(tr '\0' '\n' < /proc/$p/environ 2>/dev/null | sed -n 's/^TMUX_PANE=//p')"
  [ -n "$pane" ] || continue
  printf 'arg\t%s\t0\t%s\n' "$pane" "$(tr '\0' ' ' < /proc/$p/cmdline 2>/dev/null)"
  for fd in /proc/$p/fd/*; do
    t="$(readlink "$fd" 2>/dev/null)" || continue
    case "$t" in
      */.omp/agent/sessions/*.jsonl)
        printf 'fd\t%s\t%s\t%s\n' "$pane" "$(stat -c %Y "$t" 2>/dev/null || echo 0)" "$t" ;;
    esac
  done
done
"""


def panes() -> dict[tuple[str, str, str], tuple[int, str]]:
    """(session, window, pane_index) -> (pane pid, pane id)."""
    out = subprocess.run(
        ["tmux", "list-panes", "-a", "-F",
         "#{session_name}\t#{window_index}\t#{pane_index}\t#{pane_pid}\t#{pane_id}"],
        check=True, capture_output=True, text=True,
    ).stdout
    result: dict[tuple[str, str, str], tuple[int, str]] = {}
    for line in out.splitlines():
        session, window, pane, pid, pane_id = line.split(FIELD_SEP)
        result[(session, window, pane)] = (int(pid), pane_id)
    return result


def children(pid: int) -> list[int]:
    kids: list[int] = []
    try:
        for tid in os.listdir(f"/proc/{pid}/task"):
            try:
                kids += [int(c) for c in Path(f"/proc/{pid}/task/{tid}/children").read_text().split()]
            except OSError:
                continue
    except OSError:
        pass
    return kids


def comm(pid: int) -> str:
    try:
        return Path(f"/proc/{pid}/comm").read_text().strip()
    except OSError:
        return ""


def find_omp(pane_pid: int) -> int | None:
    """Breadth-first search below the pane's shell for the omp process."""
    frontier = [pane_pid]
    seen = 0
    for _ in range(MAX_DEPTH):
        next_frontier: list[int] = []
        for pid in frontier:
            for kid in children(pid):
                seen += 1
                if seen > MAX_PROCESSES:
                    return None
                if comm(kid) == "omp":
                    return kid
                next_frontier.append(kid)
        frontier = next_frontier
    return None


def open_session(pid: int) -> str | None:
    """Session id of the newest ~/.omp session file the process holds open."""
    best: tuple[float, str] | None = None
    try:
        fds = os.listdir(f"/proc/{pid}/fd")
    except OSError:
        return None
    for fd in fds:
        try:
            target = os.readlink(f"/proc/{pid}/fd/{fd}")
        except OSError:
            continue
        m = SESSION_FILE.search(target)
        if not m:
            continue
        try:
            mtime = os.stat(target).st_mtime
        except OSError:
            mtime = 0.0
        if best is None or mtime > best[0]:
            best = (mtime, m.group("sid"))
    return best[1] if best else None


def named_session(command: str) -> str | None:
    """The session a command line names, from `--resume`/`--restore`/`-r`.

    omp opens a session file only to write to it (the writer holds the fd for
    its lifetime, `packages/coding-agent/src/session/session-storage.ts`), so a
    session resumed into a pane that has not written since — an agent idle at
    its prompt, which is exactly the state autosave finds — has no fd to read.
    Its own argv still names the session.
    """
    for m in RESUME_ARG.finditer(command):
        value = m.group("value")
        in_path = SESSION_FILE.search(value)
        if in_path:
            return in_path.group("sid")
        if SESSION_ID.fullmatch(value):
            return value
    return None


def cmdline(pid: int) -> str:
    try:
        return Path(f"/proc/{pid}/cmdline").read_bytes().decode("utf-8", "replace").replace("\0", " ")
    except OSError:
        return ""


def host_session_for(pane_pid: int, full_command: str) -> str | None:
    omp = find_omp(pane_pid)
    if omp is not None:
        sid = open_session(omp)
        if sid:
            return sid
        sid = named_session(cmdline(omp))
        if sid:
            return sid
    return named_session(full_command)


# The bucket a boxed session lives in: `-boxes-agentbox-<12 hex>-<repo>`.
BOX_BUCKET = re.compile(r"^-boxes-agentbox-[0-9a-f]{12}-(?P<repo>.+)$")


def box_sessions() -> dict[str, tuple[str | None, str]]:
    """pane id -> (repo or None, session id) for every omp running in any agentbox.

    An open session file names both; an idle session's argv names only the id,
    and that pane is restorable only when its own launcher line carries the
    repo (`rewrite`).
    """
    boxes = subprocess.run(
        ["docker", "ps", "--filter", "name=^agentbox-", "--format", "{{.Names}}"],
        capture_output=True, text=True, timeout=10,
    ).stdout.split()
    best: dict[str, tuple[float, str | None, str]] = {}
    for box in boxes:
        # A wedged box must not stall every autosave (resurrect runs this hook inline).
        try:
            out = subprocess.run(
                ["docker", "exec", box, "sh", "-c", BOX_SESSIONS_SCRIPT],
                capture_output=True, text=True, timeout=10,
            ).stdout
        except subprocess.TimeoutExpired:
            print(f"tmux-resurrect-omp: {box} did not answer within 10s; its panes are left as saved",
                  file=sys.stderr)
            continue
        for line in out.splitlines():
            parts = line.split(FIELD_SEP, 3)
            if len(parts) != 4:
                continue
            kind, pane_id, mtime, target = parts
            repo: str | None = None
            if kind == "fd":
                m = SESSION_FILE.search(target)
                if not m:
                    continue
                sid = m.group("sid")
                bucket = BOX_BUCKET.match(m.group("bucket"))
                # A session started outside a box (resumed into one from a
                # mounted directory) has no repo in its bucket.
                repo = bucket.group("repo") if bucket else None
            else:
                sid = named_session(target)
                if sid is None:
                    continue
            current = best.get(pane_id)
            # An open session file is the live answer and outranks the argv the
            # process started with, which is why `arg` lines carry mtime 0.
            if current is None or float(mtime) > current[0]:
                best[pane_id] = (float(mtime), repo, sid)
    return {pane: (repo, sid) for pane, (_, repo, sid) in best.items()}


def resume_command(spec: str | None, sid: str) -> str:
    return f"agentbox new {spec} -- omp --resume {sid}" if spec else f"omp --resume {sid}"


def rewrite(save_file: Path) -> tuple[int, int]:
    pane_map = panes()
    boxed: dict[str, tuple[str | None, str]] | None = None
    lines = save_file.read_text().split("\n")
    rewritten = 0
    omp_panes = 0
    for i, line in enumerate(lines):
        # pane \t session \t window \t window_active \t flags \t pane_index
        #      \t title \t dir \t pane_active \t command \t :full_command
        fields = line.split(FIELD_SEP, 10)
        if len(fields) != 11 or fields[0] != "pane":
            continue
        command, full_command = fields[9], fields[10][1:]
        is_box = BOX_PANE.search(full_command) is not None
        if command != "omp" and not is_box:
            continue
        omp_panes += 1
        located = pane_map.get((fields[1], fields[2], fields[5]))
        if located is None:
            continue
        pane_pid, pane_id = located
        spec: str | None = None
        if is_box:
            if boxed is None:
                boxed = box_sessions()
            found = boxed.get(pane_id)
            if found is None:
                continue
            repo, sid = found
            launch = LAUNCH_SPEC.search(full_command)
            spec = launch.group("spec") if launch else repo
            if spec is None:
                # Neither the launcher line nor the session's bucket names the
                # box's repo; a host `omp --resume` would resume a boxed session
                # outside its box, so the pane is left as saved.
                continue
        else:
            sid = host_session_for(pane_pid, full_command)
            if sid is None:
                continue
        fields[10] = ":" + resume_command(spec, sid)
        lines[i] = FIELD_SEP.join(fields)
        rewritten += 1
    tmp = save_file.with_suffix(save_file.suffix + ".tmp")
    tmp.write_text("\n".join(lines))
    os.replace(tmp, save_file)
    return omp_panes, rewritten


def main(argv: list[str]) -> int:
    if len(argv) != 2:
        print(f"usage: {argv[0]} <resurrect-save-file>", file=sys.stderr)
        return 2
    save_file = Path(argv[1])
    omp_panes, rewritten = rewrite(save_file)
    if omp_panes != rewritten:
        print(f"tmux-resurrect-omp: {rewritten}/{omp_panes} omp panes resolved to a session",
              file=sys.stderr)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
