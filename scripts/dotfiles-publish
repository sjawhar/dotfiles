#!/usr/bin/env bash
# dotfiles-publish <commit>: put one of your commits of the ~/.dotfiles jj checkout on origin's
# main. It fetches, rebases <commit> and its descendants (the working copy among them) onto
# main@origin, and pushes <commit> to main as a fast-forward. A push that loses a race to another
# session's push fetches and tries again.
#
# The checkout is production: every session and user unit reads its files. A rebase that
# conflicts writes jj's conflict markers into the working copy, and on 2026-11-02 at
# 11:59:11-11:59:31Z the publish steps run by hand did exactly that to shims/gh, so about 22 gh
# calls from 7 sessions read a file of markers. So the rebase is tried first on a DUPLICATE of
# <commit> and its descendants, which no working copy holds:
#   - <commit> itself conflicts: refused, and nothing moves.
#   - <commit> is clean but something above it conflicts (the working copy, holding other
#     sessions' uncommitted edits next to a change main already has): the clean duplicate of
#     <commit> is pushed, and the originals and the working copy stay where they are, since
#     moving them would write markers. The first real run met exactly this, on 2026-11-02:
#     another session's uncommitted line in scripts/AGENTS.md sat beside one main already had.
#   - <commit>, or a commit above it, is one this session's jj may not rewrite (omp makes every
#     session's jj treat another session's described commit near a head as immutable): the
#     duplicate of <commit> alone is pushed, and nothing local moves.
#   - nothing conflicts: the real commits are rebased, and <commit> is pushed.
#   - <commit> sits on commits main does not have (another session's, committed and not yet
#     published): the duplicate of <commit> alone is pushed, and nothing local moves. Pushing
#     <commit> itself would publish those commits under your push, and rebasing it onto main
#     would drop them from the working copy, so from the files on disk. On 2026-11-02 at 15:46Z
#     two such commits sat under an earlyoom-kill-watch commit and went into its push, which
#     the leak check refused.
#   - <commit>'s change is divergent (more than one commit holds it): a copy is dropped only when a
#     copy on main@origin has its tree byte for byte, it has no children, and the working copy is
#     not built on it; when every copy off main is such a copy, main already has the change and
#     nothing is pushed. Any other case is refused, abandons nothing and pushes nothing: on
#     2026-11-03 two `jj commit` runs raced and gave two sessions' different work one change id.
# A refused or partial run leaves every file on disk as it was, and leaves no duplicate behind:
# every copy this run makes and does not push is abandoned on any exit, with --ignore-immutable,
# since a copy carries its original's description and so its session's trailer. On 2026-11-02 at
# 19:41-19:42Z three runs of one session copied another session's two commits above its own, were
# refused the plain abandon of those copies, stopped there, and left 14 commits behind.
#
# <commit> is any jj revision naming one commit (a change id, a commit id). Commit only your own
# paths first (`jj commit <paths>`), then name that commit here. The script follows <commit>'s
# change id, not its commit id: a rebase gives the change a new commit id, and the old one still
# names the commit from before it. On 2026-11-02 at 16:19Z a run given a commit id pushed that old
# commit after its rebase, was refused 3 times, and left a duplicate of the change.
set -euo pipefail

TRIES="${DOTFILES_PUBLISH_TRIES:-3}"

die() { echo "dotfiles-publish: $*" >&2; exit 1; }

[[ $# -eq 1 && "$1" != -* ]] || die "usage: dotfiles-publish <commit>"
rev="$1"
cd "${DOTFILES_DIR:-$HOME/.dotfiles}"
[[ -d .jj ]] || die "$PWD is not a jj checkout"
# A divergent change id is no single revision to jj, so it is asked again as change_id(<id>), which
# names each of its commits; they share the change, which settle_divergence below judges.
change="$( { jj log -r "$rev" --no-graph -T 'change_id ++ "\n"' 2>/dev/null \
    || jj log -r "change_id($rev)" --no-graph -T 'change_id ++ "\n"' 2>/dev/null; } | sort -u)" \
    || die "no single commit is named $rev"
[[ "$change" =~ ^[k-z]{32}$ ]] || die "$rev names more than one commit"

# The copies this run made and has not pushed, as full commit ids joined by `|`.
copies=""
drop_copies() {
    [[ -n "$copies" ]] || return 0
    jj abandon --quiet --ignore-immutable "$copies" \
        || echo "dotfiles-publish: could not abandon this run's copies ($copies); abandon them by hand" >&2
    copies=""
}
trap drop_copies EXIT

# The one visible commit of <commit>'s change now.
current() {
    local id
    id="$(jj log -r "change_id($change)" --no-graph -T 'commit_id ++ "\n"' 2>/dev/null)" \
        || die "change $change of $rev has no visible commit"
    [[ "$id" =~ ^[0-9a-f]{40}$ ]] || die "change $change of $rev is divergent (more than one commit); abandon the extra copies"
    echo "$id"
}

# A change held by more than one commit (two `jj commit` runs that raced, or a copy jj fetched)
# is settled here, before anything moves. A copy is dropped ONLY when nothing unique is lost: its
# tree is byte-identical to the tree of a copy already on main@origin, it has no children, and it
# is not an ancestor of the working copy. When every copy off main is such a copy, they are
# abandoned and the copy on main is what remains. Any other case is refused and drops nothing:
# on 2026-11-03 two copies of one change held two sessions' different work, and abandoning either
# would have lost it.
settle_divergence() {
    local ids on_main c m tree match why drop="" report="" n=0 keep=0
    ids="$(jj log -r "change_id($change)" --no-graph -T 'commit_id ++ " "' 2>/dev/null)" || return 0
    for c in $ids; do n=$((n + 1)); done
    (( n > 1 )) || return 0
    on_main="$(jj log -r "change_id($change) & ::main@origin" --no-graph -T 'commit_id ++ " "')"
    for c in $ids; do
        why=""
        if [[ " $on_main " == *" $c "* ]]; then
            why="on main@origin"
        else
            tree="$(git rev-parse "$c^{tree}")" match=""
            for m in $on_main; do [[ "$(git rev-parse "$m^{tree}")" == "$tree" ]] && match="$m"; done
            if [[ -z "$match" ]]; then why="its tree is not that of a copy on main@origin"
            elif [[ -n "$(jj log -r "children($c)" --no-graph -T 'commit_id')" ]]; then why="it has children"
            elif [[ -n "$(jj log -r "$c & ::@" --no-graph -T 'commit_id')" ]]; then why="the working copy is built on it"
            else why="the same tree as ${match:0:12} on main@origin, no children: dropped" drop+="${drop:+|}$c"
            fi
            [[ "$why" == *dropped ]] || keep=$((keep + 1))
        fi
        report+="${report:+; }$(owned "$c") \"$(jj log -r "$c" --no-graph -T 'description.first_line()')\": $why"
    done
    if (( keep )) || [[ -z "$on_main" ]]; then
        die "change $change of $rev is divergent: $n commits hold it ($report). They may hold different work, so this run abandons none of them and publishes nothing. Publish each: give all but one a change id of its own (\`jj metaedit --update-change-id <commit id>\`) and run dotfiles-publish on each, or cherry-pick each onto origin/main in a scratch clone and push it."
    fi
    jj abandon --quiet --ignore-immutable "$drop"
    echo "dotfiles-publish: change $change of $rev was divergent ($report); dropped the copies main@origin already holds byte for byte" >&2
}

# hunks: a -U0 patch on stdin, written as one line per hunk (its path, then its - and + lines, no
# line numbers) and one per mode change, sorted. A binary change prints `binary`, which no hunk on
# main matches. The same as in scripts/dotfiles-sync.
hunks() {
    awk '
        function flush() { if (rec != "") print rec; rec = "" }
        /^diff --git / { flush(); hdr = 1; path = substr($0, index($0, " b/") + 3); next }
        hdr && /^(old|new|deleted file|new file) mode / { print path "\037" $0; next }
        hdr && /^(Binary files|GIT binary patch)/ { print "binary"; next }
        /^@@/ { flush(); hdr = 0; rec = path; next }
        !hdr && /^[-+\\]/ { rec = rec "\037" $0 }
        END { flush() }' | LC_ALL=C sort -u
}

# on_main <commit>: true when main@origin already has <commit>'s change, as when it was published
# as a copy and the original stayed: applying it to main changes nothing, or a commit on main
# since the fork point carries the same patch, or every hunk of <commit>, read without context
# lines or line numbers, is one that a commit on main since the fork point made (a copy whose lines
# main changed again after the push). scripts/dotfiles-sync decides the same way.
on_main() {
    local tree own
    tree="$(git merge-tree --write-tree --merge-base="$1^" "$main" "$1" 2>/dev/null)" \
        && [[ "$tree" == "$(git rev-parse "$main^{tree}")" ]] && return 0
    [[ -n "$main_patches" ]] && grep -qx "$(git diff-tree -p "$1" | git patch-id --stable | cut -d' ' -f1)" <<<"$main_patches" && return 0
    own="$(git diff-tree -p -U0 --no-renames "$1" | hunks)"
    [[ -n "$own" && -n "$main_hunks" ]] && ! grep -qx binary <<<"$own" \
        && [[ -z "$(LC_ALL=C comm -23 <(printf '%s\n' "$own") <(printf '%s\n' "$main_hunks"))" ]]
}

# owned <revset>: each commit as `<short id> (<its Omp-Session>)`, space-separated.
owned() {
    jj log -r "$1" --no-graph \
        -T 'commit_id.short() ++ " (" ++ trailers.filter(|t| t.key() == "Omp-Session").map(|t| t.value()).join(",") ++ ") "' \
        | sed 's/ ()//g; s/ $//'
}

attempt=0
while :; do
    attempt=$((attempt + 1))
    jj git fetch --quiet
    settle_divergence
    commit="$(current)"
    [[ "$(jj log -r "$commit" --no-graph -T 'empty')" != true ]] || die "$rev is empty: nothing to publish"
    if [[ -n "$(jj log -r "$commit & ::main@origin" --no-graph -T 'commit_id')" ]]; then
        echo "dotfiles-publish: main@origin already has $rev ($commit); nothing to publish"
        exit 0
    fi
    push="$commit"
    # Commits under <commit> that main does not have are someone else's unpublished work.
    below="$(jj log -r "::$commit- ~ ::main@origin" --no-graph -T 'commit_id ++ " "')"
    if [[ -n "$below" || -z "$(jj log -r "main@origin & ::$commit-" --no-graph -T 'commit_id')" ]]; then
        # Trial first. jj reports "Duplicated <old commit> as <change> <new commit>"; awk reads
        # all of it, since jj exits 3 when its output pipe closes early.
        olds=() news=() own=""
        while read -r old new; do
            olds+=("$old") news+=("$new")
            [[ "$commit" != "$old"* ]] || own="$new"
        done < <(jj duplicate --color never "$commit::" --onto main@origin 2>&1 \
            | awk '/^Duplicated / {print $2, $5}')
        if (( ${#news[@]} )); then
            copies="$(jj log -r "$(IFS='|'; echo "${news[*]}")" --no-graph -T 'commit_id ++ "|"')"
            copies="${copies%|}"
        fi
        [[ -n "$own" ]] || die "could not trial-rebase $rev onto main; nothing moved"
        own="$(jj log -r "$own" --no-graph -T 'commit_id')"
        if [[ "$(jj log -r "$own" --no-graph -T 'conflict')" == true ]]; then
            die "CONFLICT: $rev conflicts with main@origin; nothing moved and no file on disk changed. Merge main's change into your commit by hand, then run this again."
        fi
        above="" files=""
        wc="$(jj log -r @ --no-graph -T 'commit_id')"
        for c in $(jj log -r "($copies) ~ $own & conflicts()" --no-graph -T 'commit_id ++ " "'); do
            for i in "${!news[@]}"; do [[ "$c" == "${news[$i]}"* ]] && break; done
            if [[ "$wc" == "${olds[$i]}"* ]]; then name="the working copy"; else name="commit ${olds[$i]}"; fi
            above+="${above:+, }$name"
            files+=" $(jj resolve --list -r "$c" 2>/dev/null | awk '{print $1}' | paste -sd' ' -)"
        done
        [[ -z "$files" ]] || above+=", which would conflict with main@origin in:$files"
        fixed="$(owned "$commit:: & immutable()")"
        [[ -z "$fixed" ]] || above+="${above:+; }commits this session's jj may not move ($fixed)"
        # Anything named so far, or an unpublished commit below, keeps `dotfiles-sync` from moving
        # the working copy; commits below whose changes main already has do not.
        blocked="$above"
        if [[ -n "$below" ]]; then
            main="$(jj log -r main@origin --no-graph -T 'commit_id')"
            fork="$(git merge-base "$main" "$commit")"
            main_patches="$(git log -p --no-merges "$fork..$main" | git patch-id --stable | cut -d' ' -f1)"
            main_hunks="$(git rev-list --no-merges "$fork..$main" | git diff-tree --stdin -p -U0 --no-renames | hunks)"
            unpublished="" published=""
            for c in $below; do
                if on_main "$c"; then published+="${published:+|}$c"; else unpublished+="${unpublished:+|}$c"; fi
            done
            [[ -z "$unpublished" ]] || above+="${above:+; }the unpublished commits below it ($(owned "$unpublished"))" blocked=1
            [[ -z "$published" ]] || above+="${above:+; }commits below it whose changes main already has ($(owned "$published"))"
        fi
        if [[ -n "$above" ]]; then
            [[ "$(jj log -r "$own" --no-graph -T 'empty')" != true ]] || die "$rev's change is already on main; nothing to publish"
            # Only the copy of <commit> goes on; the copies above it go now.
            if [[ "$copies" != "$own" ]]; then
                jj abandon --quiet --ignore-immutable "($copies) ~ $own"
                copies="$own"
            fi
            push="$own"
            if [[ -n "$blocked" ]]; then
                next="Whoever owns those lines or commits publishes or resolves them before \`dotfiles-sync local\` can move the working copy."
            else
                next="\`dotfiles-sync local\` moves the working copy onto main and drops them."
            fi
            echo "dotfiles-publish: $above. Publishing $rev alone, as a copy on main; $rev and the working copy stay on their old base, and no file on disk changes. $next" >&2
        else
            drop_copies
            jj rebase --quiet -s "$commit" -d main@origin
            push="$(current)"
            if [[ -n "$(jj log -r "$push:: & conflicts()" --no-graph -T 'commit_id')" ]]; then
                die "CONFLICT after the rebase although the trial had none; resolve it in $PWD now"
            fi
        fi
    fi
    if err="$(git push --quiet origin "$push:refs/heads/main" 2>&1)"; then
        copies=""
        echo "dotfiles-publish: main is $push"
        exit 0
    fi
    # A copy that lost the race is made again from the new main. A rebased <commit> stays: the
    # next try rebases it again.
    drop_copies
    (( attempt < TRIES )) || die "push refused $attempt times; the last answer: $err"
    echo "dotfiles-publish: push refused (another session pushed first?); fetching and trying again" >&2
done
