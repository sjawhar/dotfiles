#!/usr/bin/env bash
# gcloud-broker: run one gcloud command as the admin Google login the secrets broker mints
# (GCLOUD_SAMI, human tier: Sami approves each grant on the broker page, for at most an hour;
# dispatch://INFRA-1031). Day-to-day work stays on the box identity; this is for admin actions.
#
#   gcloud-broker [--reason R] [--] <command...>        (gcloud-broker gcloud compute instances list …)
#
# The broker releases a one-hour Google access token, never the refresh token. The command runs in
# a throwaway CLOUDSDK_CONFIG, removed on exit, so no person's login and no box configuration is
# read or written. The token reaches gcloud through a 0600 file (CLOUDSDK_AUTH_ACCESS_TOKEN_FILE),
# never through argv. Exit 75 means the grant is pending approval, 77 that it was denied.
set -euo pipefail

reason="gcloud-broker admin command"
if [ "${1:-}" = --reason ]; then
  reason=$2
  shift 2
fi
[ "${1:-}" = -- ] && shift
[ $# -gt 0 ] || { echo "usage: gcloud-broker [--reason R] [--] <command...>" >&2; exit 2; }

if [ "${GCLOUD_BROKER_INNER:-}" != 1 ]; then
  GCLOUD_BROKER_INNER=1 exec secret-run --reason "$reason" --ttl 1h --wait "${GCLOUD_BROKER_WAIT:-15m}" GCLOUD_SAMI -- "$0" -- "$@"
fi

[ -n "${GCLOUD_SAMI:-}" ] || { echo "gcloud-broker: the broker released no GCLOUD_SAMI token" >&2; exit 1; }
dir=$(mktemp -d "${TMPDIR:-/tmp}/gcloud-broker.XXXXXX")
trap 'rm -rf "$dir"' EXIT
umask 077
printf '%s' "$GCLOUD_SAMI" >"$dir/token"
unset GCLOUD_SAMI GCLOUD_BROKER_INNER GCLOUD_ACCOUNT CLOUDSDK_ACTIVE_CONFIG_NAME CLOUDSDK_CORE_ACCOUNT \
  CLOUDSDK_AUTH_IMPERSONATE_SERVICE_ACCOUNT GOOGLE_APPLICATION_CREDENTIALS
mkdir "$dir/config"
CLOUDSDK_CONFIG="$dir/config" CLOUDSDK_AUTH_ACCESS_TOKEN_FILE="$dir/token" CLOUDSDK_CORE_DISABLE_PROMPTS=1 \
  "$@"
