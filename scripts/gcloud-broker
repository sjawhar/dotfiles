#!/usr/bin/env bash
# gcloud-broker: run one gcloud command as the admin Google login the secrets broker mints
# (GCLOUD_SAMI, human tier: Sami approves each grant on the broker page, for at most an hour;
# dispatch://INFRA-1031). Day-to-day work stays on the box identity; this is for an admin write
# Sami asked for, never for a read: a Google read goes through gcloud-reader (metadata-reader@ or,
# with --as legion, legion-reader@), with no person's approval (dispatch://INFRA-4748).
#
#   gcloud-broker --reason R [--] <command...>        (gcloud-broker --reason 'INFRA-1234: …' gcloud compute instances stop …)
#
# The broker releases a one-hour Google access token, never the refresh token. The command runs in
# a throwaway CLOUDSDK_CONFIG, removed on exit, so no person's login and no box configuration is
# read or written. The token reaches gcloud through a 0600 file (CLOUDSDK_AUTH_ACCESS_TOKEN_FILE),
# never through argv, and with file logging off whatever the caller set: gcloud copies a command's
# output into a log file under CLOUDSDK_CONFIG/logs, so a printed token would land on disk
# (dispatch://INFRA-4824). Exit 75 means the grant is pending approval, 77 that it was denied.
set -euo pipefail

usage="usage: gcloud-broker --reason R [--] <command...>"
# Answered BEFORE anything reaches the broker. Everything below asks a PERSON to approve a
# human-tier grant, and on 2026-11-05 at 09:35Z a bare `gcloud-broker --help` put a real approval
# card in Sami's inbox for a question the script could answer itself.
case "${1:-}" in
  -h|--help) echo "$usage"; exit 0 ;;
esac

reason=""
case "${1:-}" in
  --reason) [ $# -ge 2 ] || { echo "$usage" >&2; exit 2; }; reason=$2; shift 2 ;;
  --reason=*) reason=${1#--reason=}; shift ;;
esac
[ "${1:-}" = -- ] && shift
[ $# -gt 0 ] || { echo "$usage" >&2; exit 2; }

if [ "${GCLOUD_BROKER_INNER:-}" != 1 ]; then
  # The card shows R to the person who decides, so it is the caller's own: a reason made up here
  # would name no act (dispatch://INFRA-1481, R5).
  [ -n "${reason//[[:space:]]/}" ] || {
    echo "gcloud-broker: refused, nothing requested: pass --reason with the issue key and what the command does ('INFRA-1234: stop instance x')" >&2
    exit 2
  }
  GCLOUD_BROKER_INNER=1 exec secret-run --reason "$reason" --ttl 1h --wait "${GCLOUD_BROKER_WAIT:-15m}" GCLOUD_SAMI -- "$0" -- "$@"
fi

[ -n "${GCLOUD_SAMI:-}" ] || { echo "gcloud-broker: the broker released no GCLOUD_SAMI token" >&2; exit 1; }
dir=$(mktemp -d "${TMPDIR:-/tmp}/gcloud-broker.XXXXXX")
trap 'rm -rf "$dir"' EXIT
umask 077
printf '%s' "$GCLOUD_SAMI" >"$dir/token"
unset GCLOUD_SAMI GCLOUD_BROKER_INNER GCLOUD_ACCOUNT CLOUDSDK_ACTIVE_CONFIG_NAME CLOUDSDK_CORE_ACCOUNT \
  CLOUDSDK_AUTH_IMPERSONATE_SERVICE_ACCOUNT GOOGLE_APPLICATION_CREDENTIALS
mkdir "$dir/config"
CLOUDSDK_CONFIG="$dir/config" CLOUDSDK_AUTH_ACCESS_TOKEN_FILE="$dir/token" CLOUDSDK_CORE_DISABLE_PROMPTS=1 \
  CLOUDSDK_CORE_DISABLE_FILE_LOGGING=true "$@"
