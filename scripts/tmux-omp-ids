#!/usr/bin/env bash
# Extract oh-my-pi session IDs (UUIDs) from the current pane, then copy one to
# the local clipboard — either bare, or wrapped as `omp --resume <id>`.
#
# Sibling of tmux-urls, built for the moment omp exits and prints its resume
# hint: the pane is back on the normal screen, the hint is the most recent
# UUID in scrollback, so it lands on menu key 1. IDs are matched generically
# (any UUID in the pane), so envoy session IDs and history:// IDs work too.
#
# The pane must be passed in explicitly, same as tmux-urls: `capture-pane`
# with no -t resolves to whatever pane the server last considered current,
# which is wrong once more than one client is attached.
#
# Usage:
#   tmux-omp-ids menu <copy|resume> <pane>  Show a display-menu of UUIDs in <pane>
#   tmux-omp-ids copy <n>                   Copy UUID number <n> (bare)
#   tmux-omp-ids resume <n> [<pane>]        Copy the resume command for UUID number <n>
#                                           (`agentbox omp <repo> --resume …` for a pane in a
#                                           repository under $HOME, else a host bypass)
set -euo pipefail

cache="${TMUX_TMPDIR:-/tmp}/tmux-omp-ids-$(id -u)"
copy_cmd="$(cd "$(dirname "$0")" && pwd)/tmux-osc52-copy"

case "${1:-menu}" in
menu)
    action="${2:-resume}"
    pane="${3:-}"
    [ -n "$pane" ] || pane="$(tmux display-message -p '#{pane_id}')"

    # Visible pane + recent scrollback, wrapped lines joined, most recent
    # first, deduplicated.
    tmux capture-pane -p -J -S -200 -t "$pane" \
        | grep -oE '[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}' \
        | tac \
        | awk '!seen[$0]++' \
        | head -30 >"$cache" || true

    if [ ! -s "$cache" ]; then
        if [ "$(tmux display-message -p -t "$pane" '#{alternate_on}')" = 1 ]; then
            tmux display-message "tmux-omp-ids: no session IDs on screen (full-screen app: only visible rows are searchable)"
        else
            tmux display-message "tmux-omp-ids: no session IDs in pane"
        fi
        exit 0
    fi

    keys=(1 2 3 4 5 6 7 8 9 0 a b c d e f g h i j k l m n o p q r s t)
    args=()
    i=0
    while IFS= read -r id; do
        i=$((i + 1))
        [ "$i" -le "${#keys[@]}" ] || break
        args+=("$id" "${keys[$((i - 1))]}" "run-shell '$0 $action $i $pane'")
    done <"$cache"

    title="Copy session ID"
    [ "$action" = resume ] && title="Copy resume command"
    tmux display-menu -T "$title" "${args[@]}"
    ;;
copy)
    id=$(sed -n "${2}p" "$cache")
    [ -n "$id" ] || exit 1
    printf %s "$id" | "$copy_cmd"
    tmux display-message "Copied: $id"
    ;;
resume)
    id=$(sed -n "${2}p" "$cache")
    [ -n "$id" ] || exit 1
    # Sessions run in boxes (scripts/agentbox): resume inside the repo's box when
    # the pane sits in a repository under $HOME (or one of its ~/.worktrees
    # workspaces); a pane outside any repo gets the host bypass.
    dir=$(tmux display-message -p ${3:+-t "$3"} '#{pane_current_path}')
    rel=${dir#"$HOME"/}
    repo=${rel%%/*}
    [ "$repo" = .worktrees ] && { rel=${rel#.worktrees/}; repo=${rel%%/*}; }
    if [ ! -e "${XDG_CONFIG_HOME:-$HOME/.config}/agentbox/host" ]; then
        cmd="omp --resume $id"
    elif [ "$rel" != "$dir" ] && [ -n "$repo" ] && { [ -e "$HOME/$repo/.jj" ] || [ -e "$HOME/$repo/.git" ]; }; then
        cmd="agentbox omp $repo --resume $id"
    else
        cmd="AGENTBOX_BYPASS=1 omp --resume $id"
    fi
    printf %s "$cmd" | "$copy_cmd"
    tmux display-message "Copied: $cmd"
    ;;
*)
    echo "usage: tmux-omp-ids [menu <copy|resume> <pane>|copy <n>|resume <n> [<pane>]]" >&2
    exit 64
    ;;
esac
