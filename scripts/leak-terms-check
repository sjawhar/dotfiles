#!/usr/bin/env python3
"""Check diffs, commit messages, and outgoing commits against the encrypted leak-term list."""
from __future__ import annotations

import argparse
import json
import os
import pwd
import re
import shutil
import subprocess
import threading
import sys
from dataclasses import dataclass
from pathlib import Path
from typing import Iterator, Mapping, Sequence


LIST_EXIT = 2
FOUND_EXIT = 3
TEXT_EXIT = 4
EDITOR_GUARD = "DOTFILES_JJ_EDITOR_WRAPPER_ACTIVE"
SCISSORS = "------------------------ >8 ------------------------"


class ListError(Exception):
    """The encrypted term list could not be read."""


class TextError(Exception):
    """The caller's diff or message could not be read."""

def newline_lines(text: str) -> list[str]:
    """Split only on the newline byte used by git and jj diff formats."""
    lines = text.split("\n")
    if lines and not lines[-1]:
        lines.pop()
    return lines


def passwd_home() -> Path:
    """Return the home directory from passwd, independent of a caller's HOME."""
    return Path(pwd.getpwuid(os.getuid()).pw_dir)


def term_file(environment: Mapping[str, str]) -> Path:
    configured = environment.get("DOTFILES_LEAK_TERMS_FILE")
    if configured:
        return Path(configured)
    return Path(__file__).resolve().parent.parent / "leak-terms.sops.yaml"


def sops_environment(environment: Mapping[str, str]) -> dict[str, str]:
    """Prepare sops's environment without changing the caller's process environment."""
    result = dict(environment)
    sops_home = result.get("DOTFILES_LEAK_TERMS_SOPS_HOME")
    if sops_home:
        result["HOME"] = sops_home
        result["XDG_CONFIG_HOME"] = sops_home
        return result

    key_variables = ("SOPS_AGE_KEY", "SOPS_AGE_KEY_FILE", "SOPS_AGE_KEY_CMD")
    if any(result.get(name) for name in key_variables):
        return result

    home = Path(result.get("HOME", str(passwd_home())))
    config_home = Path(result.get("XDG_CONFIG_HOME", str(home / ".config")))
    configured_key = config_home / "sops" / "age" / "keys.txt"
    fallback_key = passwd_home() / ".config" / "sops" / "age" / "keys.txt"
    if not configured_key.exists() and fallback_key.exists():
        result["SOPS_AGE_KEY_FILE"] = str(fallback_key)
    return result


def list_error(message: str) -> ListError:
    return ListError(f"leak terms: {message}")


def load_terms(environment: Mapping[str, str] | None = None) -> "TermMatcher":
    """Decrypt and parse the list, retaining every term only in process memory."""
    environment = dict(os.environ if environment is None else environment)
    source = term_file(environment)
    if not source.is_file():
        raise list_error("the term list is missing; run scripts/dotfiles-sync local")

    try:
        completed = subprocess.run(
            ["sops", "--decrypt", "--output-type", "json", str(source)],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            env=sops_environment(environment),
            timeout=30,
            check=False,
        )
    except FileNotFoundError as error:
        raise list_error("sops is not on PATH; install sops with mise") from error
    except subprocess.TimeoutExpired as error:
        raise list_error("sops timed out while reading the term list; fix it with sops edit leak-terms.sops.yaml") from error
    except OSError as error:
        raise list_error("sops could not read the term list; fix it with sops edit leak-terms.sops.yaml") from error

    if completed.returncode == 128:
        raise list_error(
            "no age key can decrypt the term list; add this machine's age key to .sops.yaml "
            "above the YubiKey line and run sops updatekeys leak-terms.sops.yaml"
        )
    if completed.returncode != 0:
        raise list_error("the term list is not valid sops; fix it with sops edit leak-terms.sops.yaml")

    try:
        decoded = json.loads(completed.stdout.decode("utf-8", errors="surrogateescape"))
        terms_value = decoded["terms"] if isinstance(decoded, dict) else None
    except (KeyError, UnicodeDecodeError, json.JSONDecodeError) as error:
        raise list_error("the term list is not a block of lines; fix it with sops edit leak-terms.sops.yaml") from error
    if not isinstance(terms_value, str):
        raise list_error("the term list is not a block of lines; fix it with sops edit leak-terms.sops.yaml")
    terms = [line.strip() for line in terms_value.splitlines()]
    terms = [line for line in terms if line and not line.startswith("#")]
    if not terms:
        raise list_error("the term list holds no term; add a term with sops edit leak-terms.sops.yaml")
    return TermMatcher(terms)


@dataclass(frozen=True)
class Span:
    start: int
    end: int


class TermMatcher:
    """Case-folded, whitespace-flexible matching while keeping source-string positions."""

    def __init__(self, terms: Sequence[str]):
        patterns: list[re.Pattern[str]] = []
        seen: set[str] = set()
        for term in terms:
            pieces = re.split(r"[ \t]+", term.casefold())
            pattern = r"[ \t]+".join(re.escape(piece) for piece in pieces)
            if pattern and pattern not in seen:
                patterns.append(re.compile(pattern))
                seen.add(pattern)
        self._patterns = patterns

    @staticmethod
    def _folded_with_origins(text: str) -> tuple[str, list[int]]:
        folded: list[str] = []
        origins: list[int] = []
        for index, character in enumerate(text):
            value = character.casefold()
            folded.append(value)
            origins.extend([index] * len(value))
        return "".join(folded), origins

    def spans(self, text: str) -> list[Span]:
        folded, origins = self._folded_with_origins(text)
        found: list[Span] = []
        for pattern in self._patterns:
            for match in pattern.finditer(folded):
                if match.start() == match.end():
                    continue
                found.append(Span(origins[match.start()], origins[match.end() - 1] + 1))
        return sorted(found, key=lambda span: (span.start, span.end))


def c_escape(text: str) -> str:
    escaped: list[str] = []
    for character in text:
        if character == "\\":
            escaped.append("\\\\")
        elif character == "\n":
            escaped.append("\\n")
        elif character == "\r":
            escaped.append("\\r")
        elif character == "\t":
            escaped.append("\\t")
        elif ord(character) < 32 or ord(character) == 127:
            escaped.append(f"\\x{ord(character):02x}")
        else:
            escaped.append(character)
    return "".join(escaped)


def mask_path(path: str, spans: Sequence[Span]) -> str:
    pieces: list[str] = []
    cursor = 0
    for span in spans:
        if span.start < cursor:
            continue
        pieces.append(path[cursor:span.start])
        pieces.append("<listed term>")
        cursor = span.end
    pieces.append(path[cursor:])
    return c_escape("".join(pieces))


def decode_c_quoted(value: str, start: int = 0) -> tuple[str, int] | None:
    """Decode Git's C-style quoted filename and return the next character index."""
    if start >= len(value) or value[start] != '"':
        return None
    raw = bytearray()
    index = start + 1
    while index < len(value):
        character = value[index]
        if character == '"':
            return raw.decode("utf-8", errors="surrogateescape"), index + 1
        if character != "\\":
            raw.extend(character.encode("utf-8", errors="surrogateescape"))
            index += 1
            continue
        index += 1
        if index >= len(value):
            return None
        escaped = value[index]
        simple = {"a": "\a", "b": "\b", "f": "\f", "n": "\n", "r": "\r", "t": "\t", "v": "\v"}
        if escaped in simple:
            raw.extend(simple[escaped].encode())
            index += 1
        elif escaped in {'"', "\\"}:
            raw.extend(escaped.encode())
            index += 1
        elif escaped in "01234567":
            digits = escaped
            index += 1
            for _ in range(2):
                if index < len(value) and value[index] in "01234567":
                    digits += value[index]
                    index += 1
                else:
                    break
            raw.append(int(digits, 8))
        else:
            raw.extend(escaped.encode("utf-8", errors="surrogateescape"))
            index += 1
    return None


def git_header_candidates(header: str) -> list[tuple[str, str]]:
    """Return every syntactically possible old/new path pair in a Git diff header."""
    value = header.removeprefix("diff --git ")
    first = decode_c_quoted(value)
    if first:
        old_path, index = first
        if index >= len(value) or value[index] != " ":
            return []
        second = decode_c_quoted(value, index + 1)
        if not second or second[1] != len(value):
            return []
        new_path, _ = second
        if old_path.startswith("a/") and new_path.startswith("b/"):
            return [(old_path[2:], new_path[2:])]
        return []

    if not value.startswith("a/"):
        return []
    candidates: list[tuple[str, str]] = []
    for delimiter in range(2, len(value)):
        if value.startswith(" b/", delimiter):
            candidates.append((value[2:delimiter], value[delimiter + 3:]))
    return candidates


def parse_git_header(header: str) -> tuple[str, str] | None:
    """Extract the unchanged path pair only when the raw header proves it."""
    equal = [(old_path, new_path) for old_path, new_path in git_header_candidates(header) if old_path == new_path]
    if len(equal) == 1:
        return equal[0]
    return None


def parse_diff_path(value: str, prefix: str) -> str | None:
    """Read one side of a --- or +++ line without accepting a timestamp."""
    if value == "/dev/null":
        return None
    quoted = decode_c_quoted(value)
    if quoted:
        path, index = quoted
        if index != len(value) and not value[index:].startswith("\t"):
            return None
    else:
        path = value.split("\t", 1)[0]
    if not path.startswith(prefix):
        return None
    return path[len(prefix):]


def parse_result_path(value: str) -> str | None:
    """Read a result-side path from a +++ line without accepting its timestamp."""
    return parse_diff_path(value, "b/")


def parse_source_path(value: str) -> str | None:
    """Read a source-side path from a --- line without accepting its timestamp."""
    return parse_diff_path(value, "a/")


def parse_extended_path(value: str) -> str | None:
    """Read a path in a rename or copy extended header."""
    quoted = decode_c_quoted(value)
    if quoted:
        path, index = quoted
        return path if index == len(value) else None
    return value or None


def parse_combined_header(header: str) -> str | None:
    """Extract the sole path reported by diff --cc and diff --combined."""
    if header.startswith("diff --cc "):
        value = header.removeprefix("diff --cc ")
    elif header.startswith("diff --combined "):
        value = header.removeprefix("diff --combined ")
    else:
        return None
    quoted = decode_c_quoted(value)
    if quoted:
        path, index = quoted
        return path if index == len(value) else None
    return value or None


def parse_range(value: str) -> tuple[int, int] | None:
    matched = re.fullmatch(r"(\d+)(?:,(\d+))?", value)
    if not matched:
        return None
    return int(matched.group(1)), int(matched.group(2) or "1")


def parse_unified_hunk(line: str) -> tuple[tuple[int, int], tuple[int, int]] | None:
    matched = re.fullmatch(r"@@ -([^ ]+) \+([^ ]+) @@(?:.*)", line)
    if not matched:
        return None
    old_range = parse_range(matched.group(1))
    new_range = parse_range(matched.group(2))
    if old_range is None or new_range is None:
        return None
    return old_range, new_range


def parse_combined_hunk(line: str) -> tuple[list[tuple[int, int]], tuple[int, int]] | None:
    matched = re.fullmatch(r"(@{3,}) (.+) \1(?:.*)", line)
    if not matched:
        return None
    prefix = matched.group(1)
    values = matched.group(2).split()
    parent_values = [value[1:] for value in values if value.startswith("-")]
    result_values = [value[1:] for value in values if value.startswith("+")]
    if len(prefix) - 1 != len(parent_values) or len(result_values) != 1:
        return None
    parents = [parse_range(value) for value in parent_values]
    result = parse_range(result_values[0])
    if result is None or any(value is None for value in parents):
        return None
    return [value for value in parents if value is not None], result


def header_end(lines: Sequence[str], start: int) -> int:
    """Find the next metadata line after a raw jj diff header.

    jj leaves filenames raw in ``diff --git`` headers, including literal newlines.
    """
    markers = ("diff --git ", "diff --cc ", "diff --combined ", "index ", "new file mode ", "deleted file mode ",
               "similarity index ", "rename from ", "rename to ", "copy from ", "copy to ", "--- ", "+++ ",
               "Binary files ", "GIT binary patch", "@@ ", "@@@ ")
    index = start + 1
    while index < len(lines) and not lines[index].startswith(markers):
        index += 1
    return index


def scan_diff(text: str, matcher: TermMatcher, place_prefix: str) -> list[str]:
    lines = newline_lines(text)
    findings: list[str] = []
    current: dict[str, object] | None = None

    def display_path(record: dict[str, object]) -> str:
        path = record["path"]
        assert isinstance(path, str)
        return mask_path(path, matcher.spans(path))

    def finish(record: dict[str, object] | None) -> None:
        if record is None:
            return
        if not record["resolved"]:
            raise TextError("cannot resolve a result path from the diff header")
        if record["deleted"]:
            return
        place = place_prefix + display_path(record)
        path = record["path"]
        assert isinstance(path, str)
        findings.extend(place for _ in matcher.spans(path))

    def begin(header: str, kind: str) -> dict[str, object]:
        if kind == "combined":
            path = parse_combined_header(header)
            return {
                "path": path,
                "old_path": path,
                "header": header,
                "candidates": [],
                "resolved": path is not None,
                "deleted": False,
                "new_file": False,
                "rename_from": None,
                "rename_to": None,
            }
        pair = parse_git_header(header)
        return {
            "path": pair[1] if pair else None,
            "old_path": pair[0] if pair else None,
            "header": header,
            "candidates": git_header_candidates(header),
            "resolved": pair is not None,
            "deleted": False,
            "new_file": False,
            "rename_from": None,
            "rename_to": None,
        }

    def resolve_rename(record: dict[str, object]) -> None:
        old_path = record["rename_from"]
        new_path = record["rename_to"]
        if not isinstance(old_path, str) or not isinstance(new_path, str):
            return
        candidates = [
            (old_candidate, new_candidate)
            for old_candidate, new_candidate in record["candidates"]
            if old_candidate == old_path and new_candidate == new_path
        ]
        if len(candidates) == 1:
            record["old_path"] = old_path
            record["path"] = new_path
            record["resolved"] = True

    def add_content(record: dict[str, object], line_number: int, content: str) -> None:
        if not record["resolved"]:
            raise TextError("cannot resolve a result path from the diff header")
        place = f"{place_prefix}{display_path(record)}:{line_number}"
        findings.extend(place for _ in matcher.spans(content))

    def consume_unified(start: int, record: dict[str, object]) -> int:
        parsed = parse_unified_hunk(lines[start])
        if parsed is None:
            raise TextError("malformed unified hunk")
        (old_line, old_count), (new_line, new_count) = parsed
        old_seen = new_seen = 0
        index = start + 1
        while index < len(lines):
            line = lines[index]
            if line.startswith(("diff --git ", "diff --cc ", "diff --combined ", "@@ ", "@@@ ")):
                break
            if line.startswith("\\ No newline at end of file"):
                index += 1
                continue
            if not line or line[0] not in "+- ":
                break
            marker, content = line[0], line[1:]
            if marker in "- ":
                old_seen += 1
            if marker in "+ ":
                new_seen += 1
                if marker == "+":
                    add_content(record, new_line, content)
                new_line += 1
            if old_seen > old_count or new_seen > new_count:
                raise TextError("malformed unified hunk count")
            index += 1
        if old_seen != old_count or new_seen != new_count:
            raise TextError("malformed unified hunk count")
        return index

    def consume_combined(start: int, record: dict[str, object]) -> int:
        parsed = parse_combined_hunk(lines[start])
        if parsed is None:
            raise TextError("malformed combined hunk")
        parents, (new_line, new_count) = parsed
        seen = [0] * len(parents)
        new_seen = 0
        index = start + 1
        while index < len(lines):
            line = lines[index]
            if line.startswith(("diff --git ", "diff --cc ", "diff --combined ", "@@ ", "@@@ ")):
                break
            if line.startswith("\\ No newline at end of file"):
                index += 1
                continue
            if len(line) < len(parents) or any(marker not in "+- " for marker in line[:len(parents)]):
                break
            marks, content = line[:len(parents)], line[len(parents):]
            for parent, marker in enumerate(marks):
                if marker == "-" or ("-" not in marks and marker == " "):
                    seen[parent] += 1
            result_present = "-" not in marks
            if result_present:
                new_seen += 1
                if all(marker == "+" for marker in marks):
                    add_content(record, new_line, content)
                new_line += 1
            if any(seen[index] > parents[index][1] for index in range(len(parents))) or new_seen > new_count:
                raise TextError("malformed combined hunk count")
            index += 1
        if any(seen[index] != parents[index][1] for index in range(len(parents))) or new_seen != new_count:
            raise TextError("malformed combined hunk count")
        return index

    def path_line_end(start: int, marker: str, prefix: str, expected_path: object) -> int | None:
        if expected_path is None:
            return start + 1 if lines[start] == f"{marker}/dev/null" else None
        assert isinstance(expected_path, str)
        if "\n" not in expected_path:
            parsed = parse_diff_path(lines[start].removeprefix(marker), prefix)
            return start + 1 if parsed == expected_path else None
        expected = f"{prefix}{expected_path}"
        pieces = expected.split("\n")
        if lines[start] != f"{marker}{pieces[0]}":
            return None
        if any(start + offset >= len(lines) or lines[start + offset] != piece for offset, piece in enumerate(pieces[1:], 1)):
            return None
        return start + len(pieces)


    index = 0
    while index < len(lines):
        line = lines[index]
        if line.startswith("diff --git "):
            finish(current)
            end = header_end(lines, index)
            current = begin("\n".join(lines[index:end]), "git")
            index = end
            continue
        if line.startswith(("diff --cc ", "diff --combined ")):
            finish(current)
            end = header_end(lines, index)
            current = begin("\n".join(lines[index:end]), "combined")
            index = end
            continue
        if current is None:
            if line.startswith("@@"):
                raise TextError("hunk has no file header")
            index += 1
            continue
        if line.startswith("new file mode "):
            current["new_file"] = True
        elif line.startswith("deleted file mode "):
            if not current["resolved"]:
                raise TextError("cannot resolve a result path from the diff header")
            current["deleted"] = True
        elif line.startswith(("rename from ", "copy from ")):
            current["rename_from"] = parse_extended_path(line.split(" ", 2)[2])
            resolve_rename(current)
        elif line.startswith(("rename to ", "copy to ")):
            current["rename_to"] = parse_extended_path(line.split(" ", 2)[2])
            resolve_rename(current)
        elif line.startswith("--- "):
            end = path_line_end(index, "--- ", "a/", current["old_path"])
            if not current["resolved"] or (
                end is None and not current["new_file"]
            ) or (end is None and current["new_file"] and line != "--- /dev/null"):
                raise TextError("a source path does not match the diff header")
            if end is not None:
                index = end
                continue
        elif line.startswith("+++ "):
            end = path_line_end(index, "+++ ", "b/", current["path"])
            if not current["resolved"] or (
                end is None and not current["deleted"]
            ) or (end is None and current["deleted"] and line != "+++ /dev/null"):
                raise TextError("a result path does not match the diff header")
            if end is not None:
                index = end
                continue
        elif line.startswith("@@@"):
            index = consume_combined(index, current)
            continue
        elif line.startswith("@@"):
            index = consume_unified(index, current)
            continue
        index += 1
    finish(current)
    return findings


def cleaned_message(text: str, cleanup: str, comment_char: str | None, cut_at_scissors: bool) -> list[str]:
    lines = newline_lines(text)
    needs_cut = bool(comment_char) and (cut_at_scissors or cleanup == "scissors")
    if needs_cut:
        cut_line = f"{comment_char} {SCISSORS}"
        for index, line in enumerate(lines):
            if line == cut_line:
                lines = lines[:index]
                break
    if cleanup == "verbatim":
        return lines

    stripped: list[str] = []
    for line in lines:
        value = line.rstrip(" \t\v\f\r")
        if cleanup == "strip" and comment_char and value.startswith(comment_char):
            continue
        stripped.append(value)

    while stripped and not stripped[0]:
        stripped.pop(0)
    while stripped and not stripped[-1]:
        stripped.pop()

    collapsed: list[str] = []
    previous_blank = False
    for line in stripped:
        blank = not line
        if blank and previous_blank:
            continue
        collapsed.append(line)
        previous_blank = blank
    return collapsed


def scan_message(text: str, matcher: TermMatcher, cleanup: str, comment_char: str | None, cut_at_scissors: bool, place: str) -> list[str]:
    lines = cleaned_message(text, cleanup, comment_char, cut_at_scissors)
    findings: list[str] = []
    for line_number, line in enumerate(lines, start=1):
        findings.extend(f"{place} line {line_number}" for _ in matcher.spans(line))
    return findings


def print_findings(findings: Sequence[str]) -> None:
    for place in findings:
        print(f"leak terms: {place}: listed leak term", file=sys.stderr)
    print(
        "leak terms: remove the term from the text, or if it is not private remove it from the list with "
        "sops edit leak-terms.sops.yaml",
        file=sys.stderr,
    )


def rust_lines(text: str) -> list[str]:
    """Split text as Rust's str::lines(), including its CRLF normalization."""
    lines = text.split("\n")
    if lines and not lines[-1]:
        lines.pop()
    return [line.removesuffix("\r") for line in lines]


def clean_jj_description(lines: Sequence[str]) -> str:
    """Apply jj 0.46's cleanup_description_lines rules."""
    kept: list[str] = []
    for line in lines:
        if line.startswith("JJ: ignore-rest"):
            break
        if not line.startswith("JJ:"):
            kept.append(line)
    description = "\n".join(kept).strip("\n")
    return f"{description}\n" if description else ""


def jj_sections(text: str, mode: str, expected_ids: Sequence[str]) -> list[tuple[str | None, str]]:
    """Apply jj's single- or multi-description cleanup with validated bulk headers."""
    lines = rust_lines(text)
    if mode == "single":
        return [(None, clean_jj_description(lines))]
    if mode != "bulk" or not expected_ids or any(re.fullmatch(r"[0-9a-f]{12}", value) is None for value in expected_ids):
        raise ValueError("cannot read jj editor descriptions")

    expected = set(expected_ids)
    sections: list[tuple[str, list[str]]] = []
    current: list[str] | None = None
    current_id: str | None = None
    seen: set[str] = set()
    header = re.compile(r"JJ: describe ([0-9a-f]{12}) -------\Z")
    for line in lines:
        if line.startswith("JJ: describe "):
            matched = header.fullmatch(line)
            if matched is None or matched.group(1) not in expected or matched.group(1) in seen:
                raise ValueError("cannot read jj editor descriptions")
            if current is not None and current_id is not None:
                sections.append((current_id, current))
            current_id = matched.group(1)
            current = []
            seen.add(current_id)
        elif current is None:
            if line and not line.startswith("JJ:"):
                raise ValueError("cannot read jj editor descriptions")
        else:
            current.append(line)
    if current is not None and current_id is not None:
        sections.append((current_id, current))
    if seen != expected:
        raise ValueError("cannot read jj editor descriptions")
    return [(commit_id, clean_jj_description(section_lines)) for commit_id, section_lines in sections]


def rust_shlex_split(value: str) -> list[str] | None:
    """Copy shlex 2.0.1 token, comment, quote, and backslash handling."""
    words: list[str] = []
    index = 0
    length = len(value)
    while index < length:
        while index < length and value[index] in " \t\n":
            index += 1
        if index == length:
            break
        if value[index] == "#":
            newline = value.find("\n", index)
            index = length if newline < 0 else newline + 1
            continue
        word: list[str] = []
        while index < length:
            character = value[index]
            if character in " \t\n":
                break
            if character == "\\":
                index += 1
                if index == length:
                    return None
                if value[index] != "\n":
                    word.append(value[index])
                index += 1
                continue
            if character == "'":
                index += 1
                end = value.find("'", index)
                if end < 0:
                    return None
                word.append(value[index:end])
                index = end + 1
                continue
            if character == '"':
                index += 1
                while index < length and value[index] != '"':
                    if value[index] != "\\":
                        word.append(value[index])
                        index += 1
                        continue
                    index += 1
                    if index == length:
                        return None
                    escaped = value[index]
                    if escaped in '$`"\\':
                        word.append(escaped)
                    elif escaped != "\n":
                        word.extend(("\\", escaped))
                    index += 1
                if index == length:
                    return None
                index += 1
                continue
            word.append(character)
            index += 1
        words.append("".join(word))
    return words


def split_jj_command(value: str) -> list[str]:
    """Copy jj 0.46's CommandNameAndArgs string splitting without a shell."""
    if '"' in value or "'" in value:
        parsed = rust_shlex_split(value)
        if parsed is not None:
            return parsed
    return value.split(" ")


def jj_editor_configuration(value: str) -> tuple[list[str], dict[str, str] | None]:
    """Decode the JSON value jj config list emits for ui.editor."""
    try:
        configured = json.loads(value)
    except json.JSONDecodeError as error:
        raise ValueError("could not read jj's configured editor") from error
    environment: dict[str, str] | None = None
    if isinstance(configured, str):
        command = split_jj_command(configured)
    elif isinstance(configured, list) and configured and all(isinstance(item, str) for item in configured):
        command = list(configured)
    elif (
        isinstance(configured, dict)
        and isinstance(configured.get("env"), dict)
        and isinstance(configured.get("command"), list)
        and configured["command"]
        and all(isinstance(item, str) for item in configured["command"])
        and all(isinstance(key, str) and isinstance(item, str) for key, item in configured["env"].items())
    ):
        command = list(configured["command"])
        environment = dict(configured["env"])
    else:
        raise ValueError("could not read jj's configured editor")
    return command, environment


def jj_editor_command(value: str, path: str, line_number: int) -> tuple[list[str], dict[str, str] | None]:
    """Build the same command jj 0.46's TextEditor builds for the selected editor."""
    command, environment = jj_editor_configuration(value)
    variables = {"path": path, "line": str(line_number)}
    pattern = re.compile(r"\$([a-z0-9_]+)\b")
    path_in_arguments = any("path" in pattern.findall(argument) for argument in command[1:])

    def substitute(argument: str) -> str:
        return pattern.sub(lambda match: variables.get(match.group(1), match.group(0)), argument)

    command = [substitute(argument) for argument in command]
    if not path_in_arguments:
        command.append(path)
    return command, environment


def editor_is_wrapper(command: Sequence[str]) -> bool:
    """Return whether the resolved editor executable is this wrapper."""
    if not command:
        return True
    executable = command[0]
    candidate = Path(executable) if os.path.sep in executable else shutil.which(executable)
    if candidate is None:
        return False
    try:
        return Path(candidate).resolve() == Path(__file__).resolve()
    except OSError:
        return False


def jj_editor_preflight(value: str) -> int:
    """Reject a configured editor that would recurse into this scanner."""
    try:
        command, _ = jj_editor_configuration(value)
    except ValueError:
        return 1
    return int(editor_is_wrapper(command))


def jj_editor(path: str) -> int:
    """Run jj's selected editor, then inspect its cleaned descriptions."""
    if os.environ.get(EDITOR_GUARD):
        print("leak terms: recursive jj editor wrapper refused", file=sys.stderr)
        return LIST_EXIT
    try:
        text = Path(path).read_text(encoding="utf-8")
    except OSError as error:
        print(f"leak terms: cannot read jj editor file: {error}", file=sys.stderr)
        return 1
    line_number = 1
    for line in rust_lines(text):
        if not line.startswith("JJ:"):
            break
        line_number += 1
    configured = os.environ.get("DOTFILES_JJ_EDITOR")
    if configured is None:
        print("leak terms: cannot read jj's configured editor", file=sys.stderr)
        return 1
    try:
        command, configured_environment = jj_editor_command(configured, path, line_number)
    except ValueError as error:
        print(f"leak terms: {error}", file=sys.stderr)
        return 1
    if editor_is_wrapper(command):
        print("leak terms: recursive jj editor wrapper refused", file=sys.stderr)
        return LIST_EXIT
    try:
        matcher = load_terms()
    except ListError as error:
        print(error, file=sys.stderr)
        return 1

    environment = {**os.environ, **(configured_environment or {}), EDITOR_GUARD: "1"}
    try:
        completed = subprocess.run(command, env=environment, check=False)
    except OSError as error:
        print(f"leak terms: could not run jj editor: {error}", file=sys.stderr)
        return 1
    if completed.returncode < 0:
        os.kill(os.getpid(), -completed.returncode)
    if completed.returncode:
        return completed.returncode

    try:
        edited = Path(path).read_text(encoding="utf-8")
    except (OSError, UnicodeError) as error:
        print(f"leak terms: cannot read jj editor file: {error}", file=sys.stderr)
        return 1
    mode = os.environ.get("DOTFILES_JJ_EDITOR_MODE", "single")
    expected_ids = [value for value in os.environ.get("DOTFILES_JJ_EDITOR_IDS", "").split(",") if value]
    try:
        sections = jj_sections(edited, mode, expected_ids)
    except ValueError:
        print("leak terms: cannot read jj editor descriptions", file=sys.stderr)
        return 1
    findings: list[str] = []
    for commit_id, description in sections:
        place = "commit message" if commit_id is None else f"description of {commit_id}"
        findings.extend(scan_message(description, matcher, "verbatim", None, False, place))
    if not findings:
        return 0
    print_findings(findings)
    return 1

# git 2.43's candidate order for core.commentChar=auto (builtin/commit.c).
COMMENT_CANDIDATES = "#;@!$%^&|:"
TRAILER_LINE = re.compile(r"[A-Za-z0-9][A-Za-z0-9-]*[ \t]*:")


def adjust_comment_line_char(text: str) -> str | None:
    """Copy git 2.43's adjust_comment_line_char: a line starts after \\n or \\r."""
    if "#" not in text:
        return "#"
    blocked = set()
    if text and text[0] in COMMENT_CANDIDATES:
        blocked.add(text[0])
    for index, character in enumerate(text[:-1]):
        if character in "\n\r" and text[index + 1] in COMMENT_CANDIDATES:
            blocked.add(text[index + 1])
    return next((candidate for candidate in COMMENT_CANDIDATES if candidate not in blocked), None)


def git_block_character(lines: Sequence[str], candidate: str) -> bool:
    """Whether lines end with a block git wrote in candidate, as git writes its status.

    git writes a blank line, then lines that each start with its character; only blank lines
    and trailers (`Token: value`, which interpret-trailers may append) follow. A character
    that starts a line of the message fails, because git's own lines follow that line.
    """
    first = next((index for index, line in enumerate(lines) if line.startswith(candidate)), None)
    if first is None or first == 0 or lines[first - 1] != "":
        return False
    return all(
        line.startswith(candidate) or line == "" or TRAILER_LINE.match(line) is not None
        for line in lines[first:]
    )


def git_comment_char(text: str, editor_ran: bool, status_shown: bool, cut_line_written: bool) -> str | None:
    """Return the character git 2.43 chose for core.commentChar=auto, or None when unsure.

    Without the editor or the status, git wrote nothing into the file, so the file is the
    text git chose from. Otherwise git's comment block follows the message: its cut line
    names the character when git wrote one (scissors or verbose) and the file holds no other;
    else exactly one candidate must end the file as git's block. None reads every line.
    """
    if not (editor_ran and status_shown):
        return adjust_comment_line_char(text)
    lines = newline_lines(text)
    if cut_line_written:
        cut = [line[0] for line in lines if line[:1] in tuple(COMMENT_CANDIDATES) and line[1:] == f" {SCISSORS}"]
        return cut[0] if len(cut) == 1 else None
    found = [candidate for candidate in COMMENT_CANDIDATES if git_block_character(lines, candidate)]
    return found[0] if len(found) == 1 else None


def read_stdin() -> str:
    try:
        return sys.stdin.buffer.read().decode("utf-8", errors="surrogateescape")
    except OSError as error:
        raise TextError("could not read standard input") from error




OBJECT_ID = re.compile(r"[0-9A-Fa-f]{40,64}\Z")
TRANSPORT_URL = re.compile(r"[A-Za-z][A-Za-z0-9+.-]*::")


def git_environment() -> dict[str, str]:
    """Disable replacement objects so scanned objects are the ones Git publishes."""
    return {**os.environ, "GIT_NO_REPLACE_OBJECTS": "1"}


def git_output(arguments: Sequence[str], standard_input: bytes) -> bytes:
    """Run one Git producer and fail closed when it cannot provide complete output."""
    try:
        completed = subprocess.run(
            ["git", *arguments],
            input=standard_input,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            env=git_environment(),
            check=False,
        )
    except OSError as error:
        raise TextError("could not run git while reading outgoing commits") from error
    if completed.returncode:
        raise TextError("git could not read outgoing commits")
    return completed.stdout

def git_chunks(arguments: Sequence[str], standard_input: bytes) -> Iterator[bytes]:
    """Yield one Git producer's output without collecting every outgoing diff."""
    try:
        process = subprocess.Popen(
            ["git", *arguments],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            env=git_environment(),
        )
    except OSError as error:
        raise TextError("could not run git while reading outgoing commits") from error
    assert process.stdin is not None
    assert process.stdout is not None
    write_errors: list[OSError] = []

    def write_input() -> None:
        try:
            process.stdin.write(standard_input)
        except BrokenPipeError:
            pass
        except OSError as error:
            write_errors.append(error)
        finally:
            try:
                process.stdin.close()
            except OSError as error:
                write_errors.append(error)

    writer = threading.Thread(target=write_input)
    writer.start()
    try:
        while chunk := process.stdout.read1(65536):
            yield chunk
    finally:
        process.stdout.close()
        writer.join()
        status = process.wait()
    if write_errors or status:
        raise TextError("git could not read outgoing commits")


def push_updates(text: str) -> tuple[list[str], list[str]]:
    """Read Git's pre-push updates, keeping only commits that can send content."""
    local: list[str] = []
    remote: list[str] = []
    for line in newline_lines(text):
        fields = line.split()
        if len(fields) != 4 or not OBJECT_ID.fullmatch(fields[1]) or not OBJECT_ID.fullmatch(fields[3]):
            raise TextError("malformed pre-push update")
        if set(fields[1]) != {"0"}:
            local.append(fields[1])
        if set(fields[3]) != {"0"}:
            remote.append(fields[3])
    return local, remote


def push_destination(remote: str, url: str) -> str:
    """Use the same transport for advertisement reads that Git uses for the push."""
    if TRANSPORT_URL.match(url):
        return url
    try:
        configured = subprocess.run(
            ["git", "config", "--get", f"remote.{remote}.vcs"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            env=git_environment(),
            check=False,
        )
    except OSError as error:
        raise TextError("could not read the push transport") from error
    if configured.returncode == 0:
        helper = configured.stdout.decode("utf-8", errors="surrogateescape").strip()
        if helper:
            return f"{helper}::{url}"
    elif configured.returncode != 1:
        raise TextError("could not read the push transport")
    return url


def local_object_ids(candidates: Sequence[str]) -> set[str]:
    """Return the advertised IDs that this repository actually has, in one Git call."""
    if not candidates:
        return set()
    output = git_output(
        ["cat-file", "--batch-check=%(objectname) %(objecttype)"],
        ("\n".join(candidates) + "\n").encode(),
    )
    lines = output.decode("utf-8", errors="surrogateescape").splitlines()
    if len(lines) != len(candidates):
        raise TextError("git gave an incomplete object advertisement")
    result: set[str] = set()
    for candidate, line in zip(candidates, lines, strict=True):
        fields = line.split()
        if len(fields) < 2 or not OBJECT_ID.fullmatch(fields[0]):
            raise TextError("git gave a malformed object advertisement")
        if fields[1] != "missing":
            result.add(candidate)
    return result


def remote_advertisement(destination: str) -> list[str]:
    """Read all refs advertised by the exact transport Git will use to push."""
    output = git_output(["ls-remote", "--", destination], b"")
    object_ids: list[str] = []
    for line in output.decode("utf-8", errors="surrogateescape").splitlines():
        fields = line.split("\t", 1)
        if len(fields) != 2 or not OBJECT_ID.fullmatch(fields[0]):
            raise TextError("git gave a malformed remote advertisement")
        object_ids.append(fields[0])
    return object_ids


def outgoing_commit_ids(local: Sequence[str], held: Sequence[str]) -> list[str]:
    """List exactly the commits sent to this destination, preserving Git's topo order."""
    revisions = [*local]
    if held:
        revisions.extend(("--not", *held))
    output = git_output(["rev-list", "--topo-order", "--stdin"], ("\n".join(revisions) + "\n").encode())
    commits = output.decode("ascii", errors="strict").splitlines()
    if any(OBJECT_ID.fullmatch(commit) is None for commit in commits):
        raise TextError("git gave a malformed outgoing commit list")
    return commits


def nul_records(chunks: Iterator[bytes]) -> Iterator[bytes]:
    """Yield NUL-delimited records while joining each growing record only once."""
    pieces: list[bytes] = []
    for chunk in chunks:
        start = 0
        while True:
            boundary = chunk.find(b"\0", start)
            if boundary < 0:
                if start < len(chunk):
                    pieces.append(chunk[start:])
                break
            pieces.append(chunk[start:boundary])
            yield b"".join(pieces)
            pieces.clear()
            start = boundary + 1
    if pieces:
        yield b"".join(pieces)


def scan_outgoing_commits(commits: Sequence[str], matcher: TermMatcher) -> list[str]:
    """Read all outgoing messages and combined diffs from one Git producer."""
    if not commits:
        return []
    # Do not let local log.* or diff.* configuration omit a root diff, a
    # signature, notes, decorations, or a submodule change from this scan.
    arguments = [
        "-c",
        "core.quotePath=false",
        "log",
        "--encoding=UTF-8",
        "--no-walk=unsorted",
        "--stdin",
        "--format=%x00%H%x00%B%x00",
        "--root",
        "--no-show-signature",
        "--no-notes",
        "--no-decorate",
        "--cc",
        "-U0",
        "--no-ext-diff",
        "--no-textconv",
        "--no-color",
        "--no-renames",
        "--no-relative",
        "--src-prefix=a/",
        "--dst-prefix=b/",
        "--submodule=short",
        "--ignore-submodules=none",
        "--diff-algorithm=myers",
    ]
    findings: list[str] = []
    expected = set(commits)
    seen: set[str] = set()
    records: list[bytes] = []

    def scan_record(raw_commit: bytes, raw_message: bytes, raw_diff: bytes) -> None:
        try:
            commit = raw_commit.decode("ascii")
        except UnicodeDecodeError as error:
            raise TextError("git gave malformed commit boundaries") from error
        if OBJECT_ID.fullmatch(commit) is None or commit not in expected or commit in seen:
            raise TextError("git gave malformed commit boundaries")
        seen.add(commit)
        short = commit[:12]
        message = raw_message.decode("utf-8", errors="surrogateescape")
        diff = raw_diff.decode("utf-8", errors="surrogateescape")
        findings.extend(scan_message(message, matcher, "verbatim", None, False, f"commit {short} message"))
        findings.extend(scan_diff(diff, matcher, f"commit {short} "))

    first = True
    for raw in nul_records(git_chunks(arguments, ("\n".join(commits) + "\n").encode())):
        if first:
            if raw:
                raise TextError("git gave malformed commit boundaries")
            first = False
            continue
        records.append(raw)
        if len(records) == 3:
            scan_record(*records)
            records.clear()
    if records:
        raise TextError("git gave malformed commit boundaries")
    if first or seen != expected:
        raise TextError("git gave malformed commit boundaries")
    return findings


def scan_push(text: str, remote: str, url: str) -> list[str]:
    """Scan only commits this pre-push invocation sends and its destination lacks."""
    local, prior_remote = push_updates(text)
    if not local:
        return []
    destination = push_destination(remote, url)
    advertised = remote_advertisement(destination)
    held = local_object_ids([*advertised, *prior_remote])
    commits = outgoing_commit_ids(local, sorted(held))
    matcher = load_terms()
    return scan_outgoing_commits(commits, matcher)

def parser() -> argparse.ArgumentParser:
    argument_parser = argparse.ArgumentParser(prog="leak-terms-check")
    modes = argument_parser.add_subparsers(dest="mode", required=True)
    diff = modes.add_parser("diff")
    diff.add_argument("--place-prefix", default="")
    message = modes.add_parser("message")
    message.add_argument("--cleanup", choices=("verbatim", "whitespace", "strip", "scissors"), default="verbatim")
    message.add_argument("--comment-char")
    message.add_argument("--cut-at-scissors", action="store_true")
    message.add_argument("--place", default="commit message")
    comment_char = modes.add_parser("git-comment-char")
    comment_char.add_argument("--editor-ran", choices=("0", "1"), required=True)
    comment_char.add_argument("--status-shown", choices=("0", "1"), required=True)
    comment_char.add_argument("--cut-line-written", choices=("0", "1"), required=True)
    jj_editor_parser = modes.add_parser("jj-editor")
    jj_editor_parser.add_argument("file")
    jj_preflight = modes.add_parser("jj-editor-preflight")
    jj_preflight.add_argument("configuration")
    push = modes.add_parser("push")
    push.add_argument("--remote", required=True)
    push.add_argument("--url", required=True)
    return argument_parser


def main(arguments: Sequence[str] | None = None) -> int:
    args = parser().parse_args(arguments)
    if args.mode == "jj-editor":
        return jj_editor(args.file)
    if args.mode == "jj-editor-preflight":
        return jj_editor_preflight(args.configuration)
    try:
        text = read_stdin()
    except TextError as error:
        print(f"leak terms: cannot read text to check: {error}", file=sys.stderr)
        return TEXT_EXIT

    if args.mode == "git-comment-char":
        character = git_comment_char(
            text, args.editor_ran == "1", args.status_shown == "1", args.cut_line_written == "1"
        )
        if character is not None:
            print(character)
        return 0

    try:
        if args.mode == "push":
            findings = scan_push(text, args.remote, args.url)
        else:
            matcher = load_terms()
            if args.mode == "diff":
                findings = scan_diff(text, matcher, args.place_prefix)
            else:
                findings = scan_message(text, matcher, args.cleanup, args.comment_char, args.cut_at_scissors, args.place)
    except ListError as error:
        print(error, file=sys.stderr)
        return LIST_EXIT
    except TextError as error:
        print(f"leak terms: cannot read text to check: {error}", file=sys.stderr)
        return TEXT_EXIT

    if not findings:
        return 0
    print_findings(findings)
    return FOUND_EXIT


if __name__ == "__main__":
    raise SystemExit(main())
