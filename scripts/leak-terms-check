#!/usr/bin/env python3
"""Check diffs, commit messages, outgoing commits and the text a gh call sends against the encrypted leak-term list."""
from __future__ import annotations

import argparse
import codecs
import fnmatch
import glob
import html
import json
import os
import pwd
import re
import shlex
import shutil
import stat
import subprocess
import threading
import sys
import tomllib
import urllib.parse
from functools import lru_cache
from dataclasses import dataclass, field, replace
from pathlib import Path
from typing import Callable, Iterator, Mapping, Sequence


LIST_EXIT = 2
FOUND_EXIT = 3
TEXT_EXIT = 4
# jj-editor-preflight: jj's editor configuration cannot be read, or it names this wrapper.
EDITOR_UNREADABLE_EXIT = 5
EDITOR_WRAPPER_EXIT = 6
EDITOR_GUARD = "DOTFILES_JJ_EDITOR_WRAPPER_ACTIVE"
SCISSORS = "------------------------ >8 ------------------------"
# Git's combined diff (`--cc`) is wrong for wide octopus merges (combine-diff.c, git 2.43 to master): from 33 parents a
# removed line's `-` lands in the column of parent n-32, so the body disagrees with its own hunk counts, and from 64
# parents its parent bit masks overflow (with 64, a line only the merge adds is left out of the output). A merge is
# read from its files instead (scan_outgoing_merges), and combined diff text is refused.
COMBINED_REFUSAL = "combined diff text (diff --cc), which this check does not read: it reads a merge from its files"


class ListError(Exception):
    """The encrypted term list could not be read."""


class TextError(Exception):
    """The caller's diff or message could not be read."""

def newline_lines(text: str) -> list[str]:
    """Split only on the newline byte used by git and jj diff formats."""
    lines = text.split("\n")
    if lines and not lines[-1]:
        lines.pop()
    return lines


def passwd_home() -> Path:
    """Return the home directory from passwd, independent of a caller's HOME."""
    return Path(pwd.getpwuid(os.getuid()).pw_dir)


def term_file(environment: Mapping[str, str]) -> Path:
    configured = environment.get("DOTFILES_LEAK_TERMS_FILE")
    if configured:
        return Path(configured)
    return Path(__file__).resolve().parent.parent / "leak-terms.sops.yaml"


SOPS_PIN = re.compile(r'^[ \t]*"?sops"?[ \t]*=[ \t]*"([0-9][0-9A-Za-z.+-]*)"')
TOML_SECTION = re.compile(r"^[ \t]*\[([^]]*)\]")


def pinned_sops() -> str | None:
    """The sops version this checkout's mise.toml pins exactly under [tools], else None."""
    try:
        lines = (Path(__file__).resolve().parent.parent / "mise.toml").read_text(encoding="utf-8").splitlines()
    except (OSError, UnicodeDecodeError):
        return None
    section = ""
    for line in lines:
        header = TOML_SECTION.match(line)
        if header:
            section = header.group(1).strip()
        elif section == "tools":
            pin = SOPS_PIN.match(line)
            if pin:
                return pin.group(1)
    return None


def mise_data_dirs(environment: Mapping[str, str]) -> list[Path]:
    """The mise data dirs a pinned tool may be installed in, as shims/ reads them (shims/AGENTS.md, "A moved HOME"):
    MISE_DATA_DIR and mise's default ~/.local/share/mise under HOME; with no MISE_DATA_DIR, ~/.mise (.bashrc's) and
    that default under HOME, then the same two under the uid's passwd home, which a caller's HOME does not move."""
    home = environment.get("HOME")
    share = Path(environment.get("XDG_DATA_HOME") or Path(home or "/nonexistent") / ".local" / "share") / "mise"
    if environment.get("MISE_DATA_DIR"):
        dirs = [Path(environment["MISE_DATA_DIR"]), share]
    else:
        dirs = [Path(home) / ".mise", share] if home else []
        dirs += [passwd_home() / ".mise", passwd_home() / ".local" / "share" / "mise"]
    return list(dict.fromkeys(d for d in dirs if d.is_absolute()))


def pinned_install(data: Path, pin: str) -> str | None:
    install = data / "installs" / "sops" / pin
    for candidate in (install / "sops", install / "bin" / "sops"):
        if candidate.is_file() and os.access(candidate, os.X_OK):
            return str(candidate)
    return None


def sops_command(environment: Mapping[str, str]) -> str | None:
    """The sops to run: the first on PATH, except that mise's shim gives way to the pinned sops it would run; with no
    sops on PATH, the pinned sops in mise's data dirs.

    mise's shim takes its version from the caller's HOME (mise's global config) or from a mise.toml in the caller's
    directory, so a commit made with a test's HOME outside this checkout found no version and the shim exited 1
    (2026-11-16, every Legion fixture repository on sami-devbox). The pinned install sits in the same mise data
    directory as the shims directory, so finding it reads no HOME. With no exact pin in this checkout's mise.toml, or
    no install of it there, the shim runs as found. A Legion test pane's PATH holds no sops at all
    (`<bin>:/usr/local/bin:/usr/bin:/bin`), so every commit through shims/jj there was refused until 2026-11-17."""
    pin = pinned_sops()
    found = shutil.which("sops", path=environment.get("PATH", os.defpath))
    if found is None:
        if not pin:
            return None
        for data in mise_data_dirs(environment):
            install = pinned_install(data, pin)
            if install:
                return install
        return None
    shims = Path(found).parent
    if shims.name == "shims" and pin:
        install = pinned_install(shims.parent, pin)
        if install:
            return install
    return found


def missing_sops(environment: Mapping[str, str]) -> str:
    """The refusal for no sops: what was searched, and the correction."""
    pin = pinned_sops()
    if not pin:
        return "sops is not on PATH, and this checkout's mise.toml pins no exact sops; install sops with mise"
    searched = ", ".join(str(data / "installs" / "sops" / pin) for data in mise_data_dirs(environment))
    return f"sops is not on PATH, and the pinned sops {pin} is installed in none of {searched}; install sops with mise"


def sops_environment(environment: Mapping[str, str]) -> dict[str, str]:
    """Prepare sops's environment without changing the caller's process environment."""
    result = dict(environment)
    sops_home = result.get("DOTFILES_LEAK_TERMS_SOPS_HOME")
    if sops_home:
        result["HOME"] = sops_home
        result["XDG_CONFIG_HOME"] = sops_home
        return result

    key_variables = ("SOPS_AGE_KEY", "SOPS_AGE_KEY_FILE", "SOPS_AGE_KEY_CMD")
    if any(result.get(name) for name in key_variables):
        return result

    home = Path(result.get("HOME", str(passwd_home())))
    config_home = Path(result.get("XDG_CONFIG_HOME", str(home / ".config")))
    configured_key = config_home / "sops" / "age" / "keys.txt"
    fallback_key = passwd_home() / ".config" / "sops" / "age" / "keys.txt"
    if not configured_key.exists() and fallback_key.exists():
        result["SOPS_AGE_KEY_FILE"] = str(fallback_key)
    return result


def list_error(message: str) -> ListError:
    return ListError(f"leak terms: {message}")


@dataclass(frozen=True)
class Scope:
    """The repositories a scoped term list is for. LABEL names the list in a refusal (`cybermonklabs/*`, `knives
    oh-my-pi`); PATTERNS are `owner/name` patterns with shell wildcards, letter case ignored."""

    label: str
    patterns: tuple[str, ...]

    def reaches(self, repositories: Sequence[str]) -> bool:
        """Whether one of REPOSITORIES (`owner/name`) is the scope's; an empty string, a repository nobody could
        name, may be any repository, so it is every scope's."""
        return any(
            not repository or any(fnmatch.fnmatchcase(repository.lower(), pattern.lower()) for pattern in self.patterns)
            for repository in repositories
        )


# Every scope: a repository nobody could name.
EVERY_REPOSITORY = ("",)


def term_lines(block: str) -> list[str]:
    """The terms of a block of lines: each line stripped, without blank lines and `#` lines."""
    terms = [line.strip() for line in block.splitlines()]
    return [line for line in terms if line and not line.startswith("#")]


def knives_registry_directory(environment: Mapping[str, str]) -> Path | None:
    """The directory of knives's fork registry (repos.toml and the private repos.local.toml beside it):
    DOTFILES_LEAK_TERMS_KNIVES_DIR, else knives's own ~/.config/knives under XDG_CONFIG_HOME or HOME, else under the
    uid's passwd home, which a caller's HOME does not move. None on a machine with no registry."""
    if environment.get("DOTFILES_LEAK_TERMS_KNIVES_DIR"):
        return Path(environment["DOTFILES_LEAK_TERMS_KNIVES_DIR"])
    candidates = []
    if environment.get("XDG_CONFIG_HOME"):
        candidates.append(Path(environment["XDG_CONFIG_HOME"]) / "knives")
    if environment.get("HOME"):
        candidates.append(Path(environment["HOME"]) / ".config" / "knives")
    candidates.append(passwd_home() / ".config" / "knives")
    return next((directory for directory in candidates if (directory / "repos.toml").is_file()), None)


def repository_name(url: str) -> str:
    """The repository name a URL ends in: `oh-my-pi` of https://github.com/can1357/oh-my-pi.git."""
    return url.rstrip("/").rsplit("/", 1)[-1].rsplit(":", 1)[-1].removesuffix(".git").lower()


def knives_forbidden(environment: Mapping[str, str]) -> list[tuple[Scope, list[str]]]:
    """The `forbidden` list of each entry of knives's fork registry, repos.toml's then repos.local.toml's (knives adds
    the private file's values to the entries it names), each for every repository named as the entry's upstream,
    origin or release, whatever its owner: a fork keeps its upstream's name, and oh-my-pi's fork moved from sjawhar to
    cybermonklabs while the registry still names sjawhar. A machine with no registry has no such list; a registry that
    cannot be read refuses, as the encrypted list does."""
    directory = knives_registry_directory(environment)
    if directory is None:
        return []
    entries: dict[str, tuple[list[str], list[str]]] = {}
    for name in ("repos.toml", "repos.local.toml"):
        path = directory / name
        if not path.exists():
            continue
        problem = f"the knives registry {path} is not a [repos.<name>] table whose forbidden values are strings"
        try:
            repos = tomllib.loads(path.read_text(encoding="utf-8")).get("repos", {})
        except (OSError, UnicodeDecodeError, tomllib.TOMLDecodeError) as error:
            raise list_error(f"the knives registry {path} cannot be read; fix it or run installers/knives.sh") from error
        if not isinstance(repos, dict) or not all(isinstance(entry, dict) for entry in repos.values()):
            raise list_error(problem)
        for key, entry in repos.items():
            forbidden = entry.get("forbidden", [])
            if not isinstance(forbidden, list) or not all(isinstance(term, str) for term in forbidden):
                raise list_error(problem)
            terms, urls = entries.setdefault(key, ([], []))
            terms += [term.strip() for term in forbidden if term.strip()]
            urls += [entry[role] for role in ("upstream", "origin", "release") if isinstance(entry.get(role), str)]
    return [
        (Scope(f"knives {key}", tuple(sorted({f"*/{repository_name(url)}" for url in urls}))), terms)
        for key, (terms, urls) in entries.items()
        if terms and urls
    ]


def load_terms(environment: Mapping[str, str] | None = None, repositories: Sequence[str] = (),
               registry: bool = False) -> "TermMatcher":
    """Decrypt and parse the list, retaining every term only in process memory. The `terms` block is for every
    repository. The list's `scoped` map, of repository patterns (`cybermonklabs/*`) to blocks of lines, holds terms for
    the repositories a pattern matches only; with REGISTRY, so do the `forbidden` lists of knives's fork registry
    (knives_forbidden). A scoped list is read when its scope reaches one of REPOSITORIES (Scope.reaches): a commit has
    no repository, so it reads `terms` alone, and a push or gh text names where it goes."""
    environment = dict(os.environ if environment is None else environment)
    source = term_file(environment)
    if not source.is_file():
        raise list_error("the term list is missing; run scripts/dotfiles-sync local")

    sops = sops_command(environment)
    if sops is None:
        raise list_error(missing_sops(environment))
    try:
        completed = subprocess.run(
            [sops, "--decrypt", "--output-type", "json", str(source)],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            env=sops_environment(environment),
            timeout=30,
            check=False,
        )
    except FileNotFoundError as error:
        raise list_error(missing_sops(environment)) from error
    except subprocess.TimeoutExpired as error:
        raise list_error("sops timed out while reading the term list; fix it with sops edit leak-terms.sops.yaml") from error
    except OSError as error:
        raise list_error("sops could not read the term list; fix it with sops edit leak-terms.sops.yaml") from error

    if completed.returncode == 128:
        raise list_error(
            "no age key can decrypt the term list; add this machine's age key to .sops.yaml "
            "above the YubiKey line and run sops updatekeys leak-terms.sops.yaml on a machine that can decrypt the list"
        )
    if completed.returncode != 0:
        raise list_error(
            f"the term list is not valid sops ({sops} exited {completed.returncode}); "
            "fix it with sops edit leak-terms.sops.yaml"
        )

    try:
        decoded = json.loads(completed.stdout.decode("utf-8", errors="surrogateescape"))
        terms_value = decoded["terms"] if isinstance(decoded, dict) else None
    except (KeyError, UnicodeDecodeError, json.JSONDecodeError) as error:
        raise list_error("the term list is not a block of lines; fix it with sops edit leak-terms.sops.yaml") from error
    if not isinstance(terms_value, str):
        raise list_error("the term list is not a block of lines; fix it with sops edit leak-terms.sops.yaml")
    terms = term_lines(terms_value)
    if not terms:
        raise list_error("the term list holds no term; add a term with sops edit leak-terms.sops.yaml")
    scoped_value = decoded.get("scoped", {})
    if not isinstance(scoped_value, dict) or not all(isinstance(block, str) for block in scoped_value.values()):
        raise list_error(
            "the scoped term lists are not a map of repository patterns to blocks of lines; "
            "fix it with sops edit leak-terms.sops.yaml"
        )
    scoped: list[tuple[Scope, list[str]]] = []
    for pattern, block in scoped_value.items():
        if not term_lines(block):
            raise list_error(f"the scoped term list {pattern} holds no term; fix it with sops edit leak-terms.sops.yaml")
        scoped.append((Scope(pattern, (pattern,)), term_lines(block)))
    if registry:
        scoped += knives_forbidden(environment)
    allowed_value = decoded.get("allowed", {})
    if not isinstance(allowed_value, dict) or not all(isinstance(block, str) for block in allowed_value.values()):
        raise list_error(
            "the allowed tokens are not a map of repository patterns to blocks of lines; "
            "fix it with sops edit leak-terms.sops.yaml"
        )
    allowed = [(pattern, term_lines(block)) for pattern, block in allowed_value.items()]
    return TermMatcher(
        terms,
        [(scope, listed) for scope, listed in scoped if scope.reaches(repositories)],
        allowed,
        # Where the text goes, when it is known: a push names one destination, so a token allowed there is no
        # match. gh text reaches every scope until its targets are read (gh_check), so it keeps the matches.
        None if tuple(repositories) == EVERY_REPOSITORY else repositories,
    )


@dataclass(frozen=True)
class Span:
    start: int
    end: int
    # The matched term's place in its list (1 for its first term, counting neither blank lines nor `#` lines), which
    # tells two terms of one list apart, and the label of a scoped list's Scope ("" for the list every repository has),
    # which a refusal names.
    term: int = field(default=0, compare=False)
    scope: str = field(default="", compare=False)
    # The repository patterns of the `allowed` tokens this match lies inside.
    allowed_in: tuple[str, ...] = field(default=(), compare=False)

    def allowed_for(self, repository: str) -> bool:
        """Whether an allowed token of REPOSITORY (`owner/name`) holds the match; a repository nobody could name has
        no allowed token."""
        return bool(repository) and any(fnmatch.fnmatchcase(repository.lower(), pattern.lower())
                                        for pattern in self.allowed_in)


def allowed_token(token: str) -> re.Pattern[str]:
    """An allowed token as it must stand in a text: exactly, letter case included, and whole, with no character of a
    name (a letter, a digit, `.`, `_`, `-`, `/`, or `@` before it) on either side, so `@scope/package` allows neither
    `@scope/other` nor `@scope/package-more`."""
    return re.compile(r"(?<![A-Za-z0-9._@/-])" + re.escape(token) + r"(?![A-Za-z0-9._/-])")


class TermMatcher:
    """Case-folded, whitespace-flexible matching while keeping source-string positions. SCOPED holds (Scope, terms) for
    each scoped list read, and `scopes` maps each label to its Scope. A term two lists hold matches once for each,
    since each list says where its terms may not go. ALLOWED holds (repository pattern, tokens): a match inside such
    a token is not a term in that repository (a third-party name that holds one), and with REPOSITORIES, the places a
    text goes, a match every one of them allows is dropped; otherwise each match says where it is allowed."""

    def __init__(self, terms: Sequence[str], scoped: Sequence[tuple[Scope, Sequence[str]]] = (),
                 allowed: Sequence[tuple[str, Sequence[str]]] = (), repositories: Sequence[str] | None = None):
        patterns: list[tuple[re.Pattern[str], int, str]] = []
        seen: set[tuple[str, str]] = set()
        self.scopes = {scope.label: scope for scope, _ in scoped}
        for label, listed in (("", terms), *((scope.label, listed) for scope, listed in scoped)):
            for number, term in enumerate(listed, start=1):
                pieces = re.split(r"[ \t]+", term.casefold())
                pattern = r"[ \t]+".join(re.escape(piece) for piece in pieces)
                if pattern and (label, pattern) not in seen:
                    patterns.append((re.compile(pattern), number, label))
                    seen.add((label, pattern))
        self._patterns = patterns
        self._allowed = [(pattern, allowed_token(token)) for pattern, tokens in allowed for token in tokens]
        self._repositories = tuple(repositories) if repositories else ()

    @staticmethod
    def _origins(text: str) -> list[int]:
        """The index in TEXT of each character of text.casefold(): str.casefold folds each character on its own."""
        origins: list[int] = []
        for index, character in enumerate(text):
            origins.extend([index] * len(character.casefold()))
        return origins

    def spans(self, text: str) -> list[Span]:
        folded = text.casefold()
        matches = [
            (match, number, scope)
            for pattern, number, scope in self._patterns
            for match in pattern.finditer(folded)
            if match.start() != match.end()
        ]
        if not matches:
            return []
        # Only a text that holds a term pays for the per-character offset map and the allowed tokens.
        origins = self._origins(text)
        tokens = [(pattern, token.start(), token.end()) for pattern, regex in self._allowed
                  for token in regex.finditer(text)]
        found = []
        for match, number, scope in matches:
            start, end = origins[match.start()], origins[match.end() - 1] + 1
            allowed_in = tuple(sorted({pattern for pattern, first, last in tokens if first <= start and end <= last}))
            span = Span(start, end, number, scope, allowed_in)
            if self._repositories and all(span.allowed_for(repository) for repository in self._repositories):
                continue
            found.append(span)
        return sorted(found, key=lambda span: (span.start, span.end))


# The files whose lines are prose, which GitHub renders as paragraphs. Every other file is code, read a line at a time:
# code is not reflowed, and joining its lines would refuse words that no reader sees side by side.
PROSE_SUFFIXES = (".md", ".mdx", ".txt", ".rst")


def is_prose(path: str) -> bool:
    """Whether PATH names a prose file (PROSE_SUFFIXES, letter case ignored)."""
    return path.lower().endswith(PROSE_SUFFIXES)


def paragraph_view(text: str) -> str:
    """TEXT as GitHub renders prose, in a string of the same length: each whitespace character inside a paragraph is a
    space, so a term of several words that a soft line break, a CRLF or a no-break space splits matches, and each line
    break that begins or ends a blank line stays, so a term split over two paragraphs does not."""
    lines = re.sub(r"[^\S\n]", " ", text).split("\n")
    pieces = [lines[0]]
    for previous, line in zip(lines, lines[1:]):
        pieces += [" " if previous.strip() and line.strip() else "\n", line]
    return "".join(pieces)


def c_escape(text: str) -> str:
    escaped: list[str] = []
    for character in text:
        if character == "\\":
            escaped.append("\\\\")
        elif character == "\n":
            escaped.append("\\n")
        elif character == "\r":
            escaped.append("\\r")
        elif character == "\t":
            escaped.append("\\t")
        elif ord(character) < 32 or ord(character) == 127:
            escaped.append(f"\\x{ord(character):02x}")
        else:
            escaped.append(character)
    return "".join(escaped)


# A refusal shows at most this many characters of the line on each side of a match, and at most MATCH_LIMIT of the match
# itself, so that one line of a minified file, of a one-line JSON body, or of a term whose words a long run of spaces
# parts stays readable.
EXCERPT_CONTEXT = 80
MATCH_LIMIT = 160
# How to clear a refusal, in every mode. The global list and each repository pattern's list are in leak-terms.sops.yaml;
# a `knives <entry>` list is that entry's forbidden list in knives's fork registry (knives_forbidden).
REMOVE_ADVICE = (
    "remove the term from the text, or if it is not private remove it from the list that holds it: sops edit "
    "leak-terms.sops.yaml for the global list (its terms block) or a repository pattern's list (its scoped block), and "
    "for a knives list the forbidden list of that entry in knives's repos.toml or repos.local.toml"
)


def list_name(scope: str) -> str:
    """The list a refusal names: the global list, which every repository has, or a scoped list by its Scope's label
    (`the cybermonklabs/* list`, `the knives oh-my-pi list`)."""
    return f"the {scope} list" if scope else "the global list"


def bounded(text: str, limit: int) -> str:
    """TEXT C-escaped, or when it is longer than LIMIT characters, its first and last LIMIT/2 around a `…`."""
    if len(text) <= limit:
        return c_escape(text)
    return c_escape(text[:limit // 2]) + "…" + c_escape(text[-(limit // 2):])


def excerpt(text: str, start: int, end: int) -> tuple[str, str]:
    """TEXT[START:END] as written, cut to MATCH_LIMIT characters (bounded), and the line it is on (the lines, for a match
    a line break splits), cut to EXCERPT_CONTEXT characters on each side of the match with `…` where it is cut; both
    C-escaped, so each is one line."""
    first = text.rfind("\n", 0, start) + 1
    last = text.find("\n", end)
    last = len(text) if last < 0 else last
    left, right = max(first, start - EXCERPT_CONTEXT), min(last, end + EXCERPT_CONTEXT)
    matched = bounded(text[start:end], MATCH_LIMIT)
    line = (("…" if left > first else "") + c_escape(text[left:start]) + matched + c_escape(text[end:right])
            + ("…" if right < last else ""))
    return matched, line


@dataclass(frozen=True)
class Finding:
    """One listed term a refusal names (dispatch://INFRA-4383, R2): PLACE names the file or field and the line, MATCHED
    is the text that matched as written, LINE the line it is on (excerpt), or None where PLACE is the matched name
    itself (a path, a ref, a tag's name), and SCOPE the list that holds the term (Span.scope). The caller wrote the
    text, so showing it copies nothing to a new place; every place a refusal reaches is the caller's own
    (shims/AGENTS.md, "Leak-term list")."""

    place: str
    matched: str
    line: str | None
    scope: str

    def __str__(self) -> str:
        shown = f'{self.place}: "{self.matched}" ({list_name(self.scope)})'
        return shown if self.line is None else f"{shown}, in: {self.line}"


def name_findings(place: str, name: str, spans: Sequence[Span]) -> list[Finding]:
    """A Finding at PLACE, which shows NAME (a path, a ref, a tag's name) whole, for each of SPANS, the matches in it."""
    return [Finding(place, c_escape(name[span.start:span.end]), None, span.scope) for span in spans]


def line_findings(lines: Sequence[tuple[int, str]], matcher: TermMatcher, prose: bool,
                  place: Callable[[int], str]) -> list[Finding]:
    """A Finding for each listed term in LINES, (number, text) pairs in order, at the place PLACE gives the number of the
    line the match starts on: each line read alone, or for PROSE each run of lines with consecutive numbers read as
    paragraphs (paragraph_view). Until 2026-11-17 every line was read alone, so a term a wrapped line split went into a
    commit message or a Markdown file unread."""
    if not prose:
        return [Finding(place(number), *excerpt(line, span.start, span.end), span.scope)
                for number, line in lines for span in matcher.spans(line)]
    found: list[Finding] = []
    run: list[tuple[int, str]] = []

    def flush() -> None:
        if run:
            text = "\n".join(line for _, line in run)
            found.extend(Finding(place(run[0][0] + text.count("\n", 0, span.start)), *excerpt(text, span.start, span.end),
                                 span.scope)
                         for span in matcher.spans(paragraph_view(text)))
            run.clear()

    for number, line in lines:
        if run and number != run[-1][0] + 1:
            flush()
        run.append((number, line))
    flush()
    return found


def decode_c_quoted(value: str, start: int = 0) -> tuple[str, int] | None:
    """Decode Git's C-style quoted filename and return the next character index."""
    if start >= len(value) or value[start] != '"':
        return None
    raw = bytearray()
    index = start + 1
    while index < len(value):
        character = value[index]
        if character == '"':
            return raw.decode("utf-8", errors="surrogateescape"), index + 1
        if character != "\\":
            raw.extend(character.encode("utf-8", errors="surrogateescape"))
            index += 1
            continue
        index += 1
        if index >= len(value):
            return None
        escaped = value[index]
        simple = {"a": "\a", "b": "\b", "f": "\f", "n": "\n", "r": "\r", "t": "\t", "v": "\v"}
        if escaped in simple:
            raw.extend(simple[escaped].encode())
            index += 1
        elif escaped in {'"', "\\"}:
            raw.extend(escaped.encode())
            index += 1
        elif escaped in "01234567":
            digits = escaped
            index += 1
            for _ in range(2):
                if index < len(value) and value[index] in "01234567":
                    digits += value[index]
                    index += 1
                else:
                    break
            raw.append(int(digits, 8))
        else:
            raw.extend(escaped.encode("utf-8", errors="surrogateescape"))
            index += 1
    return None


def git_header_candidates(header: str) -> list[tuple[str, str]]:
    """Return every syntactically possible old/new path pair in a Git diff header."""
    value = header.removeprefix("diff --git ")
    first = decode_c_quoted(value)
    if first:
        old_path, index = first
        if index >= len(value) or value[index] != " ":
            return []
        second = decode_c_quoted(value, index + 1)
        if not second or second[1] != len(value):
            return []
        new_path, _ = second
        if old_path.startswith("a/") and new_path.startswith("b/"):
            return [(old_path[2:], new_path[2:])]
        return []

    if not value.startswith("a/"):
        return []
    candidates: list[tuple[str, str]] = []
    for delimiter in range(2, len(value)):
        if value.startswith(" b/", delimiter):
            candidates.append((value[2:delimiter], value[delimiter + 3:]))
    return candidates


def parse_git_header(candidates: Sequence[tuple[str, str]]) -> tuple[str, str] | None:
    """Extract the unchanged path pair only when the raw header's candidates prove it."""
    equal = [(old_path, new_path) for old_path, new_path in candidates if old_path == new_path]
    if len(equal) == 1:
        return equal[0]
    return None


def parse_diff_path(value: str, prefix: str) -> str | None:
    """Read one side of a --- or +++ line without accepting a timestamp."""
    if value == "/dev/null":
        return None
    quoted = decode_c_quoted(value)
    if quoted:
        path, index = quoted
        if index != len(value) and not value[index:].startswith("\t"):
            return None
    else:
        path = value.split("\t", 1)[0]
    if not path.startswith(prefix):
        return None
    return path[len(prefix):]


def parse_extended_path(value: str) -> str | None:
    """Read a path that fills the rest of its line: a rename or copy extended header."""
    quoted = decode_c_quoted(value)
    if quoted:
        path, index = quoted
        return path if index == len(value) else None
    return value or None


def parse_range(value: str) -> tuple[int, int] | None:
    matched = re.fullmatch(r"(\d+)(?:,(\d+))?", value)
    if not matched:
        return None
    return int(matched.group(1)), int(matched.group(2) or "1")


def parse_unified_hunk(line: str) -> tuple[tuple[int, int], tuple[int, int]] | None:
    matched = re.fullmatch(r"@@ -([^ ]+) \+([^ ]+) @@(?:.*)", line)
    if not matched:
        return None
    old_range = parse_range(matched.group(1))
    new_range = parse_range(matched.group(2))
    if old_range is None or new_range is None:
        return None
    return old_range, new_range


def header_end(lines: Sequence[str], start: int) -> int:
    """Find the next metadata line after a raw jj diff header.

    jj leaves filenames raw in ``diff --git`` headers, including literal newlines. Each extended header line git and
    jj print after ``diff --git`` is a marker. A combined diff's ``diff --cc`` and ``@@@`` lines are markers too, so
    the scan stops there and refuses them.
    """
    markers = ("diff --git ", "diff --cc ", "diff --combined ", "old mode ", "new mode ", "deleted file mode ",
               "new file mode ", "similarity index ", "dissimilarity index ", "rename from ", "rename to ",
               "copy from ", "copy to ", "index ", "--- ", "+++ ", "Binary files ", "GIT binary patch", "@@ ", "@@@ ")
    index = start + 1
    while index < len(lines) and not lines[index].startswith(markers):
        index += 1
    return index


@dataclass
class FileRecord:
    """One file of a diff: the paths its header proves, what its extended headers say, and its shown path."""

    path: str | None
    old_path: str | None
    candidates: list[tuple[str, str]]
    resolved: bool
    deleted: bool = False
    new_file: bool = False
    rename_from: str | None = None
    rename_to: str | None = None
    shown: str | None = None


def scan_diff(text: str, matcher: TermMatcher, place_prefix: str) -> list[Finding]:
    lines = newline_lines(text)
    findings: list[Finding] = []
    current: FileRecord | None = None

    def display_path(record: FileRecord) -> str:
        """The result path as a finding shows it, as written, built once per path."""
        if record.shown is None:
            assert record.path is not None
            record.shown = c_escape(record.path)
        return record.shown

    def finish(record: FileRecord | None) -> None:
        if record is None:
            return
        if not record.resolved:
            raise TextError("cannot resolve a result path from the diff header")
        if record.deleted:
            return
        assert record.path is not None
        path_spans = matcher.spans(record.path)
        if path_spans:
            findings.extend(name_findings(place_prefix + display_path(record), record.path, path_spans))

    def begin(header: str) -> FileRecord:
        candidates = git_header_candidates(header)
        pair = parse_git_header(candidates)
        return FileRecord(pair[1] if pair else None, pair[0] if pair else None, candidates, pair is not None)

    def resolve_rename(record: FileRecord) -> None:
        if record.rename_from is None or record.rename_to is None:
            return
        pair = (record.rename_from, record.rename_to)
        if record.candidates.count(pair) == 1:
            record.old_path, record.path = pair
            record.resolved = True
            record.shown = None

    def add_contents(record: FileRecord, added: Sequence[tuple[int, str]]) -> None:
        """A hunk's added lines, (new line number, text): a prose file's read as paragraphs, any other a line at a
        time (line_findings)."""
        if not added:
            return
        if not record.resolved:
            raise TextError("cannot resolve a result path from the diff header")
        assert record.path is not None
        findings.extend(line_findings(added, matcher, is_prose(record.path),
                                      lambda number: f"{place_prefix}{display_path(record)}:{number}"))

    def consume_unified(start: int, record: FileRecord) -> int:
        parsed = parse_unified_hunk(lines[start])
        if parsed is None:
            raise TextError("malformed unified hunk")
        (old_line, old_count), (new_line, new_count) = parsed
        old_seen = new_seen = 0
        added: list[tuple[int, str]] = []
        index = start + 1
        while index < len(lines):
            line = lines[index]
            if line.startswith(("diff --git ", "diff --cc ", "diff --combined ", "@@ ", "@@@ ")):
                break
            if line.startswith("\\ No newline at end of file"):
                index += 1
                continue
            if not line or line[0] not in "+- ":
                break
            marker, content = line[0], line[1:]
            if marker in "- ":
                old_seen += 1
            if marker in "+ ":
                new_seen += 1
                if marker == "+":
                    added.append((new_line, content))
                new_line += 1
            if old_seen > old_count or new_seen > new_count:
                raise TextError("malformed unified hunk count")
            index += 1
        if old_seen != old_count or new_seen != new_count:
            raise TextError("malformed unified hunk count")
        add_contents(record, added)
        return index

    def path_line_end(start: int, marker: str, prefix: str, expected_path: str | None) -> int | None:
        """The index after the --- or +++ line at START that names EXPECTED_PATH, else None. git C-quotes a path that
        holds a line feed (or a tab, a quote or a backslash) on one line, whatever core.quotePath says; jj writes it
        raw, over as many lines as it has line feeds. Until 2026-11-17 a path with a line feed was read only in jj's
        form, so every git commit of such a file was refused as "a result path does not match the diff header"."""
        if expected_path is None:
            return start + 1 if lines[start] == f"{marker}/dev/null" else None
        if parse_diff_path(lines[start].removeprefix(marker), prefix) == expected_path:
            return start + 1
        if "\n" not in expected_path:
            return None
        expected = f"{prefix}{expected_path}"
        pieces = expected.split("\n")
        if lines[start] != f"{marker}{pieces[0]}":
            return None
        if any(start + offset >= len(lines) or lines[start + offset] != piece for offset, piece in enumerate(pieces[1:], 1)):
            return None
        return start + len(pieces)


    index = 0
    while index < len(lines):
        line = lines[index]
        if line.startswith("diff --git "):
            finish(current)
            end = header_end(lines, index)
            current = begin("\n".join(lines[index:end]))
            index = end
            continue
        if line.startswith(("diff --cc ", "diff --combined ")):
            raise TextError(COMBINED_REFUSAL)
        if current is None:
            if line.startswith("@@"):
                raise TextError("hunk has no file header")
            index += 1
            continue
        if line.startswith("new file mode "):
            current.new_file = True
        elif line.startswith("deleted file mode "):
            if not current.resolved:
                raise TextError("cannot resolve a result path from the diff header")
            current.deleted = True
        elif line.startswith(("rename from ", "copy from ")):
            current.rename_from = parse_extended_path(line.split(" ", 2)[2])
            resolve_rename(current)
        elif line.startswith(("rename to ", "copy to ")):
            current.rename_to = parse_extended_path(line.split(" ", 2)[2])
            resolve_rename(current)
        elif line.startswith("--- "):
            end = path_line_end(index, "--- ", "a/", current.old_path)
            if not current.resolved or (end is None and not (current.new_file and line == "--- /dev/null")):
                raise TextError("a source path does not match the diff header")
            if end is not None:
                index = end
                continue
        elif line.startswith("+++ "):
            end = path_line_end(index, "+++ ", "b/", current.path)
            if not current.resolved or (end is None and not (current.deleted and line == "+++ /dev/null")):
                raise TextError("a result path does not match the diff header")
            if end is not None:
                index = end
                continue
        elif line.startswith("@@@"):
            raise TextError(COMBINED_REFUSAL)
        elif line.startswith("@@"):
            index = consume_unified(index, current)
            continue
        index += 1
    finish(current)
    return findings


def cleaned_message(text: str, cleanup: str, comment_char: str | None, cut_at_scissors: bool) -> list[str]:
    lines = newline_lines(text)
    needs_cut = bool(comment_char) and (cut_at_scissors or cleanup == "scissors")
    if needs_cut:
        cut_line = f"{comment_char} {SCISSORS}"
        for index, line in enumerate(lines):
            if line == cut_line:
                lines = lines[:index]
                break
    if cleanup == "verbatim":
        return lines

    stripped: list[str] = []
    for line in lines:
        value = line.rstrip(" \t\v\f\r")
        if cleanup == "strip" and comment_char and value.startswith(comment_char):
            continue
        stripped.append(value)

    while stripped and not stripped[0]:
        stripped.pop(0)
    while stripped and not stripped[-1]:
        stripped.pop()

    collapsed: list[str] = []
    previous_blank = False
    for line in stripped:
        blank = not line
        if blank and previous_blank:
            continue
        collapsed.append(line)
        previous_blank = blank
    return collapsed


def scan_message(text: str, matcher: TermMatcher, cleanup: str, comment_char: str | None, cut_at_scissors: bool,
                 place: str) -> list[Finding]:
    """A commit, tag or jj message, cleaned as git or jj cleans it, read as prose (line_findings)."""
    lines = cleaned_message(text, cleanup, comment_char, cut_at_scissors)
    return line_findings(list(enumerate(lines, start=1)), matcher, True, lambda number: f"{place} line {number}")


def print_findings(findings: Sequence[Finding]) -> None:
    for finding in findings:
        print(f"leak terms: {finding}", file=sys.stderr)
    print(f"leak terms: {REMOVE_ADVICE}", file=sys.stderr)


def rust_lines(text: str) -> list[str]:
    """Split text as Rust's str::lines(), including its CRLF normalization."""
    return [line.removesuffix("\r") for line in newline_lines(text)]


def clean_jj_description(lines: Sequence[str]) -> str:
    """Apply jj 0.46's cleanup_description_lines rules."""
    kept: list[str] = []
    for line in lines:
        if line.startswith("JJ: ignore-rest"):
            break
        if not line.startswith("JJ:"):
            kept.append(line)
    description = "\n".join(kept).strip("\n")
    return f"{description}\n" if description else ""


def jj_sections(text: str, mode: str, expected_ids: Sequence[str]) -> list[tuple[str | None, str]]:
    """Apply jj's single- or multi-description cleanup with validated bulk headers."""
    lines = rust_lines(text)
    if mode == "single":
        return [(None, clean_jj_description(lines))]
    if mode != "bulk" or not expected_ids or any(re.fullmatch(r"[0-9a-f]{12}", value) is None for value in expected_ids):
        raise ValueError("cannot read jj editor descriptions")

    expected = set(expected_ids)
    sections: list[tuple[str, list[str]]] = []
    current: list[str] | None = None
    current_id: str | None = None
    seen: set[str] = set()
    header = re.compile(r"JJ: describe ([0-9a-f]{12}) -------\Z")
    for line in lines:
        if line.startswith("JJ: describe "):
            matched = header.fullmatch(line)
            if matched is None or matched.group(1) not in expected or matched.group(1) in seen:
                raise ValueError("cannot read jj editor descriptions")
            if current is not None and current_id is not None:
                sections.append((current_id, current))
            current_id = matched.group(1)
            current = []
            seen.add(current_id)
        elif current is None:
            if line and not line.startswith("JJ:"):
                raise ValueError("cannot read jj editor descriptions")
        else:
            current.append(line)
    if current is not None and current_id is not None:
        sections.append((current_id, current))
    if seen != expected:
        raise ValueError("cannot read jj editor descriptions")
    return [(commit_id, clean_jj_description(section_lines)) for commit_id, section_lines in sections]


def rust_shlex_split(value: str) -> list[str] | None:
    """Copy shlex 2.0.1 token, comment, quote, and backslash handling."""
    words: list[str] = []
    index = 0
    length = len(value)
    while index < length:
        while index < length and value[index] in " \t\n":
            index += 1
        if index == length:
            break
        if value[index] == "#":
            newline = value.find("\n", index)
            index = length if newline < 0 else newline + 1
            continue
        word: list[str] = []
        while index < length:
            character = value[index]
            if character in " \t\n":
                break
            if character == "\\":
                index += 1
                if index == length:
                    return None
                if value[index] != "\n":
                    word.append(value[index])
                index += 1
                continue
            if character == "'":
                index += 1
                end = value.find("'", index)
                if end < 0:
                    return None
                word.append(value[index:end])
                index = end + 1
                continue
            if character == '"':
                index += 1
                while index < length and value[index] != '"':
                    if value[index] != "\\":
                        word.append(value[index])
                        index += 1
                        continue
                    index += 1
                    if index == length:
                        return None
                    escaped = value[index]
                    if escaped in '$`"\\':
                        word.append(escaped)
                    elif escaped != "\n":
                        word.extend(("\\", escaped))
                    index += 1
                if index == length:
                    return None
                index += 1
                continue
            word.append(character)
            index += 1
        words.append("".join(word))
    return words


def split_jj_command(value: str) -> list[str]:
    """Copy jj 0.46's CommandNameAndArgs string splitting without a shell."""
    if '"' in value or "'" in value:
        parsed = rust_shlex_split(value)
        if parsed is not None:
            return parsed
    return value.split(" ")


def jj_editor_listing(listing: str) -> str:
    """Return ui.editor's JSON value from `jj config list` NAME<TAB>JSON lines: a `ui.editor` line as jj gives it, or a
    table's `ui.editor.command` and `ui.editor.env.<NAME>` lines as {"env": …, "command": …}."""
    values: dict[str, str] = {}
    for line in newline_lines(listing):
        name, separator, value = line.partition("\t")
        if not separator:
            raise ValueError("could not read jj's configured editor")
        values[name] = value
    if list(values) == ["ui.editor"]:
        return values["ui.editor"]
    try:
        command = json.loads(values.pop("ui.editor.command"))
        environment = {}
        for name, value in values.items():
            if not name.startswith("ui.editor.env."):
                raise ValueError("could not read jj's configured editor")
            environment[name.removeprefix("ui.editor.env.")] = json.loads(value)
    except (KeyError, json.JSONDecodeError) as error:
        raise ValueError("could not read jj's configured editor") from error
    return json.dumps({"env": environment, "command": command}, separators=(",", ":"))


def jj_editor_configuration(value: str) -> tuple[list[str], dict[str, str] | None]:
    """Decode the JSON value of ui.editor (jj_editor_listing)."""
    try:
        configured = json.loads(value)
    except json.JSONDecodeError as error:
        raise ValueError("could not read jj's configured editor") from error
    environment: dict[str, str] | None = None
    if isinstance(configured, str):
        command = split_jj_command(configured)
    elif isinstance(configured, list) and configured and all(isinstance(item, str) for item in configured):
        command = list(configured)
    elif (
        isinstance(configured, dict)
        and isinstance(configured.get("env"), dict)
        and isinstance(configured.get("command"), list)
        and configured["command"]
        and all(isinstance(item, str) for item in configured["command"])
        and all(isinstance(key, str) and isinstance(item, str) for key, item in configured["env"].items())
    ):
        command = list(configured["command"])
        environment = dict(configured["env"])
    else:
        raise ValueError("could not read jj's configured editor")
    return command, environment


def jj_editor_command(value: str, path: str, line_number: int) -> tuple[list[str], dict[str, str] | None]:
    """Build the same command jj 0.46's TextEditor builds for the selected editor."""
    command, environment = jj_editor_configuration(value)
    variables = {"path": path, "line": str(line_number)}
    pattern = re.compile(r"\$([a-z0-9_]+)\b")
    path_in_arguments = any("path" in pattern.findall(argument) for argument in command[1:])

    def substitute(argument: str) -> str:
        return pattern.sub(lambda match: variables.get(match.group(1), match.group(0)), argument)

    command = [substitute(argument) for argument in command]
    if not path_in_arguments:
        command.append(path)
    return command, environment


def editor_is_wrapper(command: Sequence[str]) -> bool:
    """Return whether the resolved editor executable is this wrapper."""
    if not command:
        return True
    executable = command[0]
    candidate = Path(executable) if os.path.sep in executable else shutil.which(executable)
    if candidate is None:
        return False
    try:
        return Path(candidate).resolve() == Path(__file__).resolve()
    except OSError:
        return False


def jj_editor_preflight(listing: str) -> int:
    """Print the ui.editor setting that runs this wrapper, then the configured editor's JSON value for
    DOTFILES_JJ_EDITOR. A configuration that cannot be read, or an editor that is this wrapper, prints nothing."""
    try:
        value = jj_editor_listing(listing)
        command, _ = jj_editor_configuration(value)
    except ValueError:
        return EDITOR_UNREADABLE_EXIT
    if editor_is_wrapper(command):
        return EDITOR_WRAPPER_EXIT
    print("ui.editor=" + json.dumps([str(Path(__file__).resolve()), "jj-editor"]))
    print(value)
    return 0


def jj_editor(path: str) -> int:
    """Run jj's selected editor, then inspect its cleaned descriptions."""
    if os.environ.get(EDITOR_GUARD):
        print("leak terms: recursive jj editor wrapper refused", file=sys.stderr)
        return LIST_EXIT
    try:
        text = Path(path).read_text(encoding="utf-8")
    except OSError as error:
        print(f"leak terms: cannot read jj editor file: {error}", file=sys.stderr)
        return 1
    line_number = 1
    for line in rust_lines(text):
        if not line.startswith("JJ:"):
            break
        line_number += 1
    configured = os.environ.get("DOTFILES_JJ_EDITOR")
    if configured is None:
        print("leak terms: cannot read jj's configured editor", file=sys.stderr)
        return 1
    try:
        command, configured_environment = jj_editor_command(configured, path, line_number)
    except ValueError as error:
        print(f"leak terms: {error}", file=sys.stderr)
        return 1
    if editor_is_wrapper(command):
        print("leak terms: recursive jj editor wrapper refused", file=sys.stderr)
        return LIST_EXIT
    try:
        matcher = load_terms()
    except ListError as error:
        print(error, file=sys.stderr)
        return 1

    environment = {**os.environ, **(configured_environment or {}), EDITOR_GUARD: "1"}
    try:
        completed = subprocess.run(command, env=environment, check=False)
    except OSError as error:
        print(f"leak terms: could not run jj editor: {error}", file=sys.stderr)
        return 1
    if completed.returncode < 0:
        os.kill(os.getpid(), -completed.returncode)
    if completed.returncode:
        return completed.returncode

    try:
        edited = Path(path).read_text(encoding="utf-8")
    except (OSError, UnicodeError) as error:
        print(f"leak terms: cannot read jj editor file: {error}", file=sys.stderr)
        return 1
    mode = os.environ.get("DOTFILES_JJ_EDITOR_MODE", "single")
    expected_ids = [value for value in os.environ.get("DOTFILES_JJ_EDITOR_IDS", "").split(",") if value]
    try:
        sections = jj_sections(edited, mode, expected_ids)
    except ValueError:
        print("leak terms: cannot read jj editor descriptions", file=sys.stderr)
        return 1
    findings: list[Finding] = []
    for commit_id, description in sections:
        place = "commit message" if commit_id is None else f"description of {commit_id}"
        findings.extend(scan_message(description, matcher, "verbatim", None, False, place))
    if not findings:
        return 0
    print_findings(findings)
    return 1

# git 2.43's candidate order for core.commentChar=auto (builtin/commit.c).
COMMENT_CANDIDATES = "#;@!$%^&|:"
TRAILER_LINE = re.compile(r"[A-Za-z0-9][A-Za-z0-9-]*[ \t]*:")


def adjust_comment_line_char(text: str) -> str | None:
    """Copy git 2.43's adjust_comment_line_char: a line starts after \\n or \\r."""
    if "#" not in text:
        return "#"
    blocked = set()
    if text and text[0] in COMMENT_CANDIDATES:
        blocked.add(text[0])
    for index, character in enumerate(text[:-1]):
        if character in "\n\r" and text[index + 1] in COMMENT_CANDIDATES:
            blocked.add(text[index + 1])
    return next((candidate for candidate in COMMENT_CANDIDATES if candidate not in blocked), None)


def git_block_character(lines: Sequence[str], candidate: str) -> bool:
    """Whether lines end with a block git wrote in candidate, as git writes its status.

    git writes a blank line, then lines that each start with its character; only blank lines
    and trailers (`Token: value`, which interpret-trailers may append) follow. A character
    that starts a line of the message fails, because git's own lines follow that line.
    """
    first = next((index for index, line in enumerate(lines) if line.startswith(candidate)), None)
    if first is None or first == 0 or lines[first - 1] != "":
        return False
    return all(
        line.startswith(candidate) or line == "" or TRAILER_LINE.match(line) is not None
        for line in lines[first:]
    )


def git_comment_char(text: str, editor_ran: bool, status_shown: bool, cut_line_written: bool) -> str | None:
    """Return the character git 2.43 chose for core.commentChar=auto, or None when unsure.

    Without the editor or the status, git wrote nothing into the file, so the file is the
    text git chose from. Otherwise git's comment block follows the message: when git wrote
    its cut line (scissors or verbose, two lines with both), every cut line in the file must
    have one character, which is git's; else exactly one candidate must end the file as git's
    block. None reads every line.
    """
    if not (editor_ran and status_shown):
        return adjust_comment_line_char(text)
    lines = newline_lines(text)
    if cut_line_written:
        cut = {line[0] for line in lines if line[:1] in tuple(COMMENT_CANDIDATES) and line[1:] == f" {SCISSORS}"}
        return cut.pop() if len(cut) == 1 else None
    found = [candidate for candidate in COMMENT_CANDIDATES if git_block_character(lines, candidate)]
    return found[0] if len(found) == 1 else None


def read_stdin(encoding: str = "utf-8") -> str:
    try:
        return sys.stdin.buffer.read().decode(encoding, errors="surrogateescape")
    except (LookupError, UnicodeDecodeError) as error:
        raise TextError(f"cannot decode standard input as {encoding}") from error
    except OSError as error:
        raise TextError("could not read standard input") from error


OBJECT_ID = re.compile(r"[0-9A-Fa-f]{40,64}\Z")
TRANSPORT_URL = re.compile(r"[A-Za-z][A-Za-z0-9+.-]*::")


def git_environment() -> dict[str, str]:
    """Disable replacement and system attributes so Git scans the objects it publishes."""
    return {**os.environ, "GIT_NO_REPLACE_OBJECTS": "1", "GIT_ATTR_NOSYSTEM": "1"}

@lru_cache(maxsize=1)
def pushing_repository_commit_encoding() -> str | None:
    """The configured fallback for an outgoing message that Git left in its original bytes."""
    try:
        completed = subprocess.run(
            ["git", "config", "--get", "i18n.commitEncoding"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            env=git_environment(),
            check=False,
        )
    except OSError as error:
        raise TextError("could not read Git's commit message encoding") from error
    if completed.returncode == 1:
        return None
    if completed.returncode != 0:
        raise TextError("could not read Git's commit message encoding")
    try:
        return completed.stdout.removesuffix(b"\n").decode("utf-8")
    except UnicodeDecodeError as error:
        raise TextError("Git configured an unknown commit message encoding") from error


def decode_git_message(message: bytes, declared_encoding: bytes | None = None) -> str:
    """Decode a Git message from its header, UTF-8 bytes, or the pushing repository's configured encoding."""
    if declared_encoding is not None:
        try:
            encoding = declared_encoding.decode("ascii")
        except UnicodeDecodeError as error:
            raise TextError("Git declared an unknown commit message encoding") from error
    else:
        try:
            return message.decode("utf-8")
        except UnicodeDecodeError:
            encoding = pushing_repository_commit_encoding()
            if encoding is None:
                raise TextError("a Git message is not valid UTF-8")
    try:
        codec = codecs.lookup(encoding)
        return message.decode(codec.name)
    except (LookupError, UnicodeDecodeError) as error:
        raise TextError("could not decode a Git message") from error


def git_output(arguments: Sequence[str], standard_input: bytes, failure: str) -> bytes:
    """Run one Git producer and fail closed, naming it with FAILURE, when it cannot provide complete output."""
    try:
        completed = subprocess.run(
            ["git", *arguments],
            input=standard_input,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            env=git_environment(),
            check=False,
        )
    except OSError as error:
        raise TextError(failure) from error
    if completed.returncode:
        raise TextError(failure)
    return completed.stdout


def git_chunks(arguments: Sequence[str], standard_input: bytes) -> Iterator[bytes]:
    """Yield one Git producer's output without collecting every outgoing diff."""
    try:
        process = subprocess.Popen(
            ["git", *arguments],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            env=git_environment(),
        )
    except OSError as error:
        raise TextError("could not run git while reading outgoing commits") from error
    assert process.stdin is not None
    assert process.stdout is not None
    write_errors: list[OSError] = []

    def write_input() -> None:
        try:
            process.stdin.write(standard_input)
        except BrokenPipeError:
            pass
        except OSError as error:
            write_errors.append(error)
        finally:
            try:
                process.stdin.close()
            except OSError as error:
                write_errors.append(error)

    writer = threading.Thread(target=write_input)
    writer.start()
    try:
        while chunk := process.stdout.read1(65536):
            yield chunk
    finally:
        process.stdout.close()
        writer.join()
        status = process.wait()
    if write_errors or status:
        raise TextError("git could not read outgoing commits")


def push_updates(text: str) -> tuple[list[tuple[str, str]], list[str]]:
    """Read Git's pre-push updates: each sent object with the remote ref it goes to, and the remote's prior objects."""
    local: list[tuple[str, str]] = []
    remote: list[str] = []
    for line in newline_lines(text):
        fields = line.split()
        if len(fields) != 4 or not OBJECT_ID.fullmatch(fields[1]) or not OBJECT_ID.fullmatch(fields[3]):
            raise TextError("malformed pre-push update")
        if set(fields[1]) != {"0"}:
            local.append((fields[2], fields[1]))
        if set(fields[3]) != {"0"}:
            remote.append(fields[3])
    return local, remote


def push_destination(remote: str, url: str) -> str:
    """Use the same transport for advertisement reads that Git uses for the push."""
    if TRANSPORT_URL.match(url):
        return url
    try:
        configured = subprocess.run(
            ["git", "config", "--get", f"remote.{remote}.vcs"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            env=git_environment(),
            check=False,
        )
    except OSError as error:
        raise TextError("could not read the push transport") from error
    if configured.returncode == 0:
        helper = configured.stdout.decode("utf-8", errors="surrogateescape").strip()
        if helper:
            return f"{helper}::{url}"
    elif configured.returncode != 1:
        raise TextError("could not read the push transport")
    return url


def local_object_ids(candidates: Sequence[str]) -> set[str]:
    """Return the advertised IDs that this repository actually has, in one Git call."""
    if not candidates:
        return set()
    output = git_output(
        ["cat-file", "--batch-check=%(objectname) %(objecttype)"],
        ("\n".join(candidates) + "\n").encode(),
        "git could not check which advertised objects this repository holds",
    )
    lines = output.decode("utf-8", errors="surrogateescape").splitlines()
    if len(lines) != len(candidates):
        raise TextError("git gave an incomplete object advertisement")
    result: set[str] = set()
    for candidate, line in zip(candidates, lines, strict=True):
        fields = line.split()
        if len(fields) < 2 or not OBJECT_ID.fullmatch(fields[0]):
            raise TextError("git gave a malformed object advertisement")
        if fields[1] != "missing":
            result.add(candidate)
    return result


def remote_advertisement(destination: str) -> list[str]:
    """Read all refs advertised by the exact transport Git will use to push."""
    output = git_output(["ls-remote", "--", destination], b"", "git could not read the destination's advertised refs")
    object_ids: list[str] = []
    for line in output.decode("utf-8", errors="surrogateescape").splitlines():
        fields = line.split("\t", 1)
        if len(fields) != 2 or not OBJECT_ID.fullmatch(fields[0]):
            raise TextError("git gave a malformed remote advertisement")
        object_ids.append(fields[0])
    return object_ids


def outgoing_commit_ids(local: Sequence[str], held: Sequence[str]) -> list[str]:
    """List exactly the commits sent to this destination, preserving Git's topo order."""
    revisions = [*local]
    if held:
        revisions.extend(("--not", *held))
    output = git_output(
        ["rev-list", "--topo-order", "--stdin"], ("\n".join(revisions) + "\n").encode(), "git could not list the outgoing commits"
    )
    commits = output.decode("ascii", errors="strict").splitlines()
    if any(OBJECT_ID.fullmatch(commit) is None for commit in commits):
        raise TextError("git gave a malformed outgoing commit list")
    return commits


def outgoing_commit_object_ids(commits: Sequence[str], held: Sequence[str]) -> set[str]:
    """The objects reachable from sent commits, but only after a direct file or folder object needs this distinction."""
    if not commits:
        return set()
    revisions = [*commits]
    if held:
        revisions.extend(("--not", *held))
    output = git_output(
        ["rev-list", "--objects", "--no-object-names", "--stdin"],
        ("\n".join(revisions) + "\n").encode(),
        "git could not list the outgoing commit objects",
    )
    try:
        objects = output.decode("ascii").splitlines()
    except UnicodeDecodeError as error:
        raise TextError("git gave a malformed outgoing commit object list") from error
    if any(OBJECT_ID.fullmatch(object_id) is None for object_id in objects):
        raise TextError("git gave a malformed outgoing commit object list")
    return set(objects)


def destination_object_ids(held: Sequence[str]) -> set[str]:
    """Every object reachable from a destination ref that this repository can read."""
    if not held:
        return set()
    output = git_output(
        ["rev-list", "--objects", "--no-object-names", "--stdin"],
        ("\n".join(held) + "\n").encode(),
        "git could not list the destination's objects",
    )
    try:
        objects = output.decode("ascii").splitlines()
    except UnicodeDecodeError as error:
        raise TextError("git gave a malformed destination object list") from error
    if any(OBJECT_ID.fullmatch(object_id) is None for object_id in objects):
        raise TextError("git gave a malformed destination object list")
    return set(objects)


def nul_records(chunks: Iterator[bytes]) -> Iterator[bytes]:
    """Yield NUL-delimited records while joining each growing record only once."""
    pieces: list[bytes] = []
    for chunk in chunks:
        start = 0
        while True:
            boundary = chunk.find(b"\0", start)
            if boundary < 0:
                if start < len(chunk):
                    pieces.append(chunk[start:])
                break
            pieces.append(chunk[start:boundary])
            yield b"".join(pieces)
            pieces.clear()
            start = boundary + 1
    if pieces:
        yield b"".join(pieces)


def newline_records(chunks: Iterator[bytes]) -> Iterator[bytes]:
    """Yield newline-delimited byte records while joining each growing record only once."""
    pieces: list[bytes] = []
    for chunk in chunks:
        start = 0
        while True:
            boundary = chunk.find(b"\n", start)
            if boundary < 0:
                if start < len(chunk):
                    pieces.append(chunk[start:])
                break
            pieces.append(chunk[start:boundary])
            yield b"".join(pieces)
            pieces.clear()
            start = boundary + 1
    if pieces:
        yield b"".join(pieces)


@dataclass
class DiffHunk:
    """The remaining old and new lines that make a streamed diff hunk unambiguous."""

    old: int
    new: int


def hunk_start(line: bytes) -> DiffHunk | None:
    """Return the hunk counts for LINE, refusing a malformed hunk header and a combined one."""
    if line.startswith(b"@@@"):
        raise TextError(f"git gave {COMBINED_REFUSAL}")
    if line.startswith(b"@@ "):
        parsed = parse_unified_hunk(line.decode("utf-8", errors="surrogateescape"))
        if parsed is None:
            raise TextError("git gave a malformed unified hunk")
        (_, old), (_, new) = parsed
        return DiffHunk(old, new) if old or new else None
    return None


def consume_hunk_line(line: bytes, hunk: DiffHunk) -> DiffHunk | None:
    """Consume one physical diff line, returning None only after its declared counts end."""
    if line.startswith(b"\\ No newline at end of file"):
        return hunk
    if not line or line[0] not in b"+- ":
        raise TextError("git gave a malformed unified hunk")
    marker = line[0]
    if marker in b"- ":
        hunk.old -= 1
    if marker in b"+ ":
        hunk.new -= 1
    if hunk.old < 0 or hunk.new < 0:
        raise TextError("git gave a malformed unified hunk count")
    return None if hunk.old == 0 and hunk.new == 0 else hunk


def outgoing_diff_records(chunks: Iterator[bytes]) -> Iterator[tuple[str, bytes]]:
    """Frame `git log --format=commit %H` output without trusting bytes inside a diff hunk."""
    current: str | None = None
    diff = bytearray()
    hunk: DiffHunk | None = None
    for line in newline_records(chunks):
        if hunk is None:
            boundary = re.fullmatch(rb"commit ([0-9A-Fa-f]{40,64})", line)
            if boundary:
                if current is not None:
                    yield current, bytes(diff)
                current = boundary.group(1).decode("ascii")
                diff.clear()
                continue
        if current is None:
            if line:
                raise TextError("git gave malformed commit boundaries")
            continue
        diff.extend(line)
        diff.append(ord("\n"))
        if hunk is None:
            hunk = hunk_start(line)
        else:
            hunk = consume_hunk_line(line, hunk)
    if hunk is not None:
        raise TextError("git gave a malformed diff hunk count")
    if current is not None:
        yield current, bytes(diff)


def empty_attribute_tree() -> str:
    """Create the empty tree Git uses as an attribute source without changing refs or the index."""
    output = git_output(["mktree"], b"", "git could not create an empty attribute tree")
    try:
        value = output.decode("ascii")
    except UnicodeDecodeError as error:
        raise TextError("git gave an invalid empty attribute tree") from error
    tree = value.removesuffix("\n")
    if value != f"{tree}\n" or OBJECT_ID.fullmatch(tree) is None:
        raise TextError("git gave an invalid empty attribute tree")
    return tree


def info_attributes_present() -> bool:
    """Report whether this repository has the one higher-precedence attribute source Git cannot disable."""
    output = git_output(["rev-parse", "--git-path", "info/attributes"], b"", "git could not read info attributes")
    path = Path(output.decode("utf-8", errors="surrogateescape").removesuffix("\n"))
    try:
        return path.exists() and path.stat().st_size > 0
    except OSError as error:
        raise TextError("git could not read info attributes") from error


def scan_outgoing_messages(commits: Sequence[str], matcher: TermMatcher, findings: list[Finding]) -> None:
    """Scan commit messages from a NUL-framed producer, where Git messages cannot contain NUL."""
    arguments = [
        "log",
        "--encoding=UTF-8",
        "--no-walk=unsorted",
        "--stdin",
        "-z",
        "--format=tformat:%H%x00%B",
        "--no-show-signature",
        "--no-notes",
        "--no-decorate",
    ]
    expected = set(commits)
    seen: set[str] = set()
    records: list[bytes] = []
    for raw in nul_records(git_chunks(arguments, ("\n".join(commits) + "\n").encode())):
        records.append(raw)
        if len(records) != 2:
            continue
        raw_commit, raw_message = records
        records.clear()
        try:
            commit = raw_commit.decode("ascii")
        except UnicodeDecodeError as error:
            raise TextError("git gave malformed commit boundaries") from error
        if OBJECT_ID.fullmatch(commit) is None or commit not in expected or commit in seen:
            raise TextError("git gave malformed commit boundaries")
        seen.add(commit)
        findings.extend(scan_message(decode_git_message(raw_message), matcher, "verbatim", None, False,
                                     f"commit {commit[:12]} message"))
    if records or seen != expected:
        raise TextError("git gave malformed commit boundaries")


DIFF_OPTIONS = (
    "-U0",
    "--no-ext-diff",
    "--no-textconv",
    "--no-color",
    "--no-renames",
    "--no-relative",
    "--src-prefix=a/",
    "--dst-prefix=b/",
    "--submodule=short",
    "--ignore-submodules=none",
    "--diff-algorithm=myers",
)


def scan_diff_arguments(command: str, command_arguments: Sequence[str]) -> list[str]:
    """Return one text-only diff producer with the shared outgoing and staged attribute policy."""
    arguments = [
        "-c",
        "core.attributesFile=/dev/null",
        "--attr-source",
        empty_attribute_tree(),
        "-c",
        "core.quotePath=false",
        command,
        *command_arguments,
        *DIFF_OPTIONS,
    ]
    if info_attributes_present():
        arguments.append("--text")
    return arguments


def scan_outgoing_diffs(commits: Sequence[str], matcher: TermMatcher, findings: list[Finding]) -> None:
    """Scan a byte-streamed diff producer of commits that are not merges, framing commits only outside hunk content."""
    if not commits:
        return
    arguments = scan_diff_arguments(
        "log",
        [
            "--no-walk=unsorted",
            "--stdin",
            "--format=commit %H",
            "--root",
            "--no-show-signature",
            "--no-notes",
            "--no-decorate",
        ],
    )
    expected = set(commits)
    seen: set[str] = set()
    for commit, raw_diff in outgoing_diff_records(git_chunks(arguments, ("\n".join(commits) + "\n").encode())):
        if OBJECT_ID.fullmatch(commit) is None or commit not in expected or commit in seen:
            raise TextError("git gave malformed commit boundaries")
        seen.add(commit)
        findings.extend(scan_diff(raw_diff.decode("utf-8", errors="surrogateescape"), matcher, f"commit {commit[:12]} "))
    if seen != expected:
        raise TextError("git gave malformed commit boundaries")


def scan_staged_diff() -> list[Finding]:
    """Scan the staged diff under the same attribute policy and Git environment as an outgoing diff."""
    raw_diff = git_output(
        scan_diff_arguments("diff", ["--cached"]),
        b"",
        "git could not read staged diff",
    )
    if not raw_diff:
        return []
    return scan_diff(raw_diff.decode("utf-8", errors="surrogateescape"), load_terms(), "")


def commit_parents(commits: Sequence[str]) -> dict[str, list[str]]:
    """Each commit's parents as every other Git read sees them (a graft or a shallow boundary included), in one call."""
    output = git_output(
        ["rev-list", "--no-walk=unsorted", "--stdin", "--parents"],
        ("\n".join(commits) + "\n").encode(),
        "git could not read the outgoing commits' parents",
    )
    try:
        lines = output.decode("ascii").splitlines()
    except UnicodeDecodeError as error:
        raise TextError("git gave a malformed list of parents") from error
    parents: dict[str, list[str]] = {}
    for line in lines:
        fields = line.split(" ")
        if any(OBJECT_ID.fullmatch(field) is None for field in fields) or fields[0] in parents:
            raise TextError("git gave a malformed list of parents")
        parents[fields[0]] = fields[1:]
    if set(parents) != set(commits):
        raise TextError("git gave a malformed list of parents")
    return parents


RAW_MODE = re.compile(r"[0-7]{6}\Z")


@dataclass(frozen=True)
class RawChange:
    """One file of a raw tree diff: the parent's mode and object, then the merge's."""

    source_mode: str
    source: str
    result_mode: str
    result: str


def merge_changes(merges: Mapping[str, Sequence[str]]) -> dict[str, list[dict[str, RawChange]]]:
    """For each merge, in its parents' order, every file whose object or mode differs from that parent's.

    One `git diff-tree --stdin` reads every merge against each parent in turn. `--always` prints the merge's id before
    each pair, an empty one included, so each file is attributed to its parent by position, never by counting.
    """
    pairs = [(merge, parent) for merge, parents in merges.items() for parent in parents]
    output = git_output(
        ["diff-tree", "--stdin", "--always", "-r", "--raw", "-z", "--no-abbrev", "--no-renames", "--no-relative",
         "--ignore-submodules=none"],
        "".join(f"{merge} {parent}\n" for merge, parent in pairs).encode(),
        "git could not read the files of the outgoing merges",
    )
    records = output.split(b"\0")
    if records.pop() != b"":
        raise TextError("git gave a malformed raw diff of the outgoing merges")
    changes: dict[str, list[dict[str, RawChange]]] = {merge: [] for merge in merges}
    position = 0
    for merge, _ in pairs:
        if position >= len(records) or records[position] != merge.encode():
            raise TextError(f"git gave a malformed raw diff of merge commit {merge[:12]}")
        position += 1
        files: dict[str, RawChange] = {}
        while position < len(records) and records[position].startswith(b":"):
            try:
                fields = records[position].decode("ascii")[1:].split(" ")
            except UnicodeDecodeError as error:
                raise TextError(f"git gave a malformed raw diff of merge commit {merge[:12]}") from error
            path = records[position + 1].decode("utf-8", errors="surrogateescape") if position + 1 < len(records) else ""
            if (
                len(fields) != 5
                or not all(RAW_MODE.fullmatch(mode) for mode in fields[:2])
                or not all(OBJECT_ID.fullmatch(object_id) for object_id in fields[2:4])
                or fields[4] not in {"A", "D", "M", "T"}
                or not path
                or path in files
            ):
                raise TextError(f"git gave a malformed raw diff of merge commit {merge[:12]}")
            files[path] = RawChange(fields[0], fields[2], fields[1], fields[3])
            position += 2
        changes[merge].append(files)
    if position != len(records):
        raise TextError("git gave a malformed raw diff of the outgoing merges")
    return changes


def scan_outgoing_merges(merges: Mapping[str, Sequence[str]], matcher: TermMatcher, findings: list[Finding]) -> None:
    """Scan what each merge adds itself: the path of each file that differs from every parent's, and each line of the
    merge's file that no parent's file at that path holds.

    A line the merge took from a parent is that parent's: it is scanned in the parent's own commit when the push sends
    that commit, and the destination holds it otherwise. The files are read as objects, so no attribute applies; a
    file is text as the diff producer would read it: always under `--text` (a non-empty `info/attributes`), else when
    its object has no NUL byte in its first 8,000 bytes, Git's own test. Only a parent's text file holds a line: a
    binary one was never scanned, so a line of it that the merge writes into a text file is the merge's to scan.
    """
    if not merges:
        return
    every_file_text = info_attributes_present()
    for merge, parent_files in merge_changes(merges).items():
        prefix = f"commit {merge[:12]} "
        for path in sorted(set(parent_files[0]).intersection(*parent_files[1:])):
            path_spans = matcher.spans(path)
            shown = c_escape(path)
            changes = [files[path] for files in parent_files]
            results = {(change.result_mode, change.result) for change in changes}
            if len(results) != 1:
                raise TextError(f"git gave two versions of file {shown} of merge commit {merge[:12]}")
            result_mode, result = results.pop()
            if result_mode == "000000":
                continue
            findings.extend(name_findings(prefix + shown, path, path_spans))
            if result_mode == "160000":
                continue
            sources = {change.source for change in changes if change.source_mode not in {"000000", "160000"}}
            try:
                contents = blob_objects(sorted({result, *sources}))
            except TextError as error:
                raise TextError(f"cannot read file {shown} of merge commit {merge[:12]}") from error
            if not every_file_text and b"\0" in contents[result][:8000]:
                continue
            held: set[str] = set()
            for source in sources:
                if every_file_text or b"\0" not in contents[source][:8000]:
                    held.update(newline_lines(contents[source].decode("utf-8", errors="surrogateescape")))
            content = contents[result].decode("utf-8", errors="surrogateescape")
            own = [(number, line) for number, line in enumerate(newline_lines(content), start=1) if line not in held]
            findings.extend(line_findings(own, matcher, is_prose(path), lambda number: f"{prefix}{shown}:{number}"))


def scan_outgoing_commits(commits: Sequence[str], matcher: TermMatcher) -> list[Finding]:
    """Scan outgoing messages, the diffs of commits that are not merges, and what each merge adds, with separate
    producers and verified boundaries."""
    if not commits:
        return []
    parents = commit_parents(commits)
    findings: list[Finding] = []
    scan_outgoing_messages(commits, matcher, findings)
    scan_outgoing_diffs([commit for commit in commits if len(parents[commit]) < 2], matcher, findings)
    scan_outgoing_merges({commit: parents[commit] for commit in commits if len(parents[commit]) >= 2}, matcher, findings)
    return findings


def object_types(object_ids: Sequence[str]) -> dict[str, str]:
    """The type of each object, in one Git call; an object this repository lacks cannot be read, so it refuses."""
    if not object_ids:
        return {}
    output = git_output(
        ["cat-file", "--batch-check=%(objectname) %(objecttype)"],
        ("\n".join(object_ids) + "\n").encode(),
        "git could not read the outgoing objects",
    )
    lines = output.decode("utf-8", errors="surrogateescape").splitlines()
    if len(lines) != len(object_ids):
        raise TextError("git gave an incomplete list of outgoing objects")
    types: dict[str, str] = {}
    for object_id, line in zip(object_ids, lines, strict=True):
        fields = line.split()
        if len(fields) != 2 or fields[1] == "missing" or fields[0].lower() != object_id.lower():
            raise TextError("git could not read an outgoing object")
        types[object_id] = fields[1]
    return types


def batch_objects(
    object_ids: Sequence[str], expected_type: str, read_error: str, malformed_error: str
) -> dict[str, bytes]:
    """The exact content of each expected object type, with every batch record checked."""
    if not object_ids:
        return {}
    output = git_output(["cat-file", "--batch"], ("\n".join(object_ids) + "\n").encode(), read_error)
    contents: dict[str, bytes] = {}
    position = 0
    for object_id in object_ids:
        end = output.find(b"\n", position)
        fields = output[position:end].decode("utf-8", errors="surrogateescape").split() if end >= 0 else []
        if (
            len(fields) != 3
            or fields[0].lower() != object_id.lower()
            or fields[1] != expected_type
            or not fields[2].isdigit()
        ):
            raise TextError(malformed_error)
        size = int(fields[2])
        content = output[end + 1 : end + 1 + size]
        if len(content) != size or output[end + 1 + size : end + 2 + size] != b"\n":
            raise TextError(malformed_error)
        contents[object_id] = content
        position = end + 2 + size
    if position != len(output):
        raise TextError(malformed_error)
    return contents


def tag_objects(object_ids: Sequence[str]) -> dict[str, bytes]:
    """The raw content of each tag object, in one Git call, with each record's size checked."""
    return batch_objects(
        object_ids,
        "tag",
        "git could not read the outgoing tags",
        "git gave a malformed tag object",
    )


def parse_tag(content: bytes) -> tuple[str, str, str, bytes, bytes | None]:
    """A tag object's target, target type, name, raw message and encoding header."""
    header, separator, message = content.partition(b"\n\n")
    fields = dict(line.split(b" ", 1) for line in header.split(b"\n") if b" " in line)
    target, kind, name = fields.get(b"object"), fields.get(b"type"), fields.get(b"tag")
    if target is None or kind is None or name is None or OBJECT_ID.fullmatch(target.decode("ascii", "replace")) is None:
        raise TextError("git gave a malformed tag object")
    return (
        target.decode("ascii"),
        kind.decode("ascii", "replace"),
        name.decode("utf-8", errors="surrogateescape"),
        message if separator else b"",
        fields.get(b"encoding"),
    )


@dataclass
class TagWalk:
    """The tag messages and every reached object type from one set of update objects."""

    tags: list[tuple[str, str, bytes, bytes | None]]
    objects: dict[str, str]


def tag_chains(starts: Sequence[tuple[str, str]], known: set[str]) -> TagWalk:
    """Walk the tag objects reached from STARTS, skipping every object in KNOWN."""
    found: list[tuple[str, str, bytes, bytes | None]] = []
    objects: dict[str, str] = {}
    seen = set(known)
    pending: list[tuple[str | None, str]] = list(starts)
    while pending:
        unique: dict[str, str | None] = {}
        for name, object_id in pending:
            if object_id not in seen:
                unique.setdefault(object_id, name)
        seen.update(unique)
        types = object_types(sorted(unique))
        objects.update(types)
        contents = tag_objects(sorted(object_id for object_id in unique if types[object_id] == "tag"))
        pending = []
        for object_id, name in unique.items():
            if types[object_id] != "tag":
                continue
            target, kind, own_name, message, encoding = parse_tag(contents[object_id])
            found.append((own_name if name is None else name, object_id, message, encoding))
            if kind == "tag":
                pending.append((None, target))
            elif kind in {"blob", "commit", "tree"}:
                objects.setdefault(target, kind)
            else:
                raise TextError("git gave a malformed tag object")
    return TagWalk(found, objects)


def outgoing_tag_messages(
    updates: Sequence[tuple[str, str]], advertised: Sequence[str], held: set[str]
) -> tuple[list[tuple[str, str]], dict[str, str]]:
    """The outgoing tag messages and direct file or folder objects from one object walk over UPDATES."""
    starts = [(ref.removeprefix("refs/tags/"), object_id) for ref, object_id in updates]
    known = set(advertised) | held
    outgoing = tag_chains(starts, known)
    objects = {object_id: kind for object_id, kind in outgoing.objects.items() if kind in {"blob", "tree"}}
    if not outgoing.tags and not objects:
        return [], {}
    held_chains = tag_chains([("", object_id) for object_id in sorted(held)], set())
    known.update(held_chains.objects)
    return (
        [
            (name, decode_git_message(message, encoding))
            for name, object_id, message, encoding in outgoing.tags
            if object_id not in known
        ],
        {object_id: kind for object_id, kind in objects.items() if object_id not in known},
    )


def tree_paths(object_id: str) -> list[tuple[str, str, str]]:
    """Every kind, object and path in a folder object, with Git's raw path bytes decoded once."""
    output = git_output(["ls-tree", "-r", "-t", "-z", object_id], b"", "git could not read an outgoing folder")
    records = output.split(b"\0")
    if records.pop() != b"":
        raise TextError("git gave a malformed outgoing folder")
    paths: list[tuple[str, str, str]] = []
    for record in records:
        header, separator, raw_path = record.partition(b"\t")
        fields = header.split(b" ")
        if (
            not separator
            or len(fields) != 3
            or not fields[0].isdigit()
            or fields[1] not in {b"blob", b"commit", b"tree"}
        ):
            raise TextError("git gave a malformed outgoing folder")
        try:
            path_object = fields[2].decode("ascii")
        except UnicodeDecodeError as error:
            raise TextError("git gave a malformed outgoing folder") from error
        if OBJECT_ID.fullmatch(path_object) is None:
            raise TextError("git gave a malformed outgoing folder")
        paths.append(
            (fields[1].decode("ascii"), path_object, raw_path.decode("utf-8", errors="surrogateescape"))
        )
    return paths


def blob_objects(object_ids: Sequence[str]) -> dict[str, bytes]:
    """The exact content of each file object, verified as one batch."""
    return batch_objects(
        object_ids,
        "blob",
        "git could not read the outgoing files",
        "git gave a malformed outgoing file",
    )


def scan_outgoing_objects(
    objects: Mapping[str, str], commits: Sequence[str], held: set[str], matcher: TermMatcher
) -> list[Finding]:
    """Scan file objects and folder paths the destination lacks and no sent commit already includes."""
    if not objects:
        return []
    held_ids = sorted(held)
    commit_objects = outgoing_commit_object_ids(commits, held_ids)
    destination_objects = destination_object_ids(held_ids)
    files = {
        object_id
        for object_id, kind in objects.items()
        if kind == "blob" and object_id not in destination_objects and object_id not in commit_objects
    }
    folders = sorted(
        object_id
        for object_id, kind in objects.items()
        if kind == "tree" and object_id not in destination_objects and object_id not in commit_objects
    )
    folder_files: list[tuple[str, str, str]] = []
    findings: list[Finding] = []
    for folder in folders:
        # The places are the ones the commit check names for a commit that adds the same files: each file's whole
        # path, decided by the same matcher, one finding per match. A folder that holds anything is not read on its
        # own, since its path starts the path of everything in it and the term is read there. An empty folder, which no
        # commit diff can show, is read as one place of its own. Every path is shown as written.
        entries = tree_paths(folder)
        nonempty = {path.rpartition("/")[0] for _, _, path in entries if "/" in path}
        for kind, path_object, path in entries:
            if kind == "tree" and path in nonempty:
                continue
            spans = matcher.spans(path)
            shown = c_escape(path)
            findings.extend(name_findings(shown, path, spans))
            if kind == "blob" and path_object not in destination_objects and path_object not in commit_objects:
                folder_files.append((path_object, shown, path))

    content_ids = sorted(files | {object_id for object_id, _, _ in folder_files})
    contents = blob_objects(content_ids)
    # A file object pushed with no path has no kind, so it is read as code, a line at a time.
    for object_id in sorted(files):
        content = contents[object_id]
        if b"\0" not in content[:8000]:
            lines = list(enumerate(newline_lines(content.decode("utf-8", errors="surrogateescape")), start=1))
            findings.extend(line_findings(lines, matcher, False, lambda number: f"object {object_id[:12]} line {number}"))
    for object_id, shown, path in folder_files:
        content = contents[object_id]
        if b"\0" in content[:8000]:
            continue
        lines = list(enumerate(newline_lines(content.decode("utf-8", errors="surrogateescape")), start=1))
        findings.extend(line_findings(lines, matcher, is_prose(path), lambda number: f"{shown}:{number}"))
    return findings


def repository_of(url: str) -> list[str]:
    """The repositories a URL can be, for the scoped lists: [`owner/name`] as scripts/github-repo-visibility --slug
    reads it, nothing for a URL that is not GitHub's, and every repository (EVERY_REPOSITORY) for one it cannot read."""
    helper = Path(__file__).resolve().parent / "github-repo-visibility"
    try:
        completed = subprocess.run([str(helper), "--slug", url], stdin=subprocess.DEVNULL, capture_output=True,
                                   text=True, timeout=30, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return list(EVERY_REPOSITORY)
    value = completed.stdout.strip()
    if completed.returncode != 0 or value in ("", "unknown") or "/" not in value and value != "not-github":
        return list(EVERY_REPOSITORY)
    return [] if value == "not-github" else [value]


def scan_push(text: str, remote: str, url: str) -> list[Finding]:
    """Scan outgoing commits, tags, direct file and folder objects, and created or updated ref names, against the list
    every repository has and each scoped list whose scope reaches the destination URL."""
    local, prior_remote = push_updates(text)
    if not local:
        return []
    destination = push_destination(remote, url)
    advertised = remote_advertisement(destination)
    held = local_object_ids([*advertised, *prior_remote])
    commits = outgoing_commit_ids([object_id for _, object_id in local], sorted(held))
    tags, objects = outgoing_tag_messages(local, [*advertised, *prior_remote], held)
    matcher = load_terms(repositories=repository_of(url))
    findings = scan_outgoing_commits(commits, matcher)
    for name, message in tags:
        place = f"tag {c_escape(name)} message"
        findings.extend(scan_message(message, matcher, "verbatim", None, False, place))
    findings.extend(scan_outgoing_objects(objects, commits, held, matcher))
    for remote_ref, _ in local:
        name = remote_ref.removeprefix("refs/heads/").removeprefix("refs/tags/")
        findings.extend(name_findings(f"ref {c_escape(name)}", name, matcher.spans(name)))
    return findings


# The text a gh call sends to GitHub, read before gh runs. shims/gh hands this check every call that can carry text, as
# `gh -- ARGV…`, on the pass that runs gh (shims/gh). Until 2026-11-17 nothing read that text, and an agent's
# `gh pr edit` put a listed term into a public pull request's body, where GitHub keeps it in the body's edit history,
# which only an admin can delete (dispatch://INFRA-4102).
#
# The threat is an agent's accidental leak of a listed term through gh. The check does not try to stop a deliberate
# evasion: anyone set on leaking can use curl. So it reads where a call goes only in the plain case, where every host
# gh knows is github.com (gh_plain_case), and copies no more of how gh resolves a host: outside the plain case a call
# that holds a listed term is refused, read as public, with the condition that made it so. Until review round 10 of
# dispatch://INFRA-3365 the check copied gh's YAML config, default host, remote filters and aliases in every form, and
# each review found one more place where the copy differed from gh. A protection grown against an attack nobody has
# seen needs the owner's yes.

# A call that reads text from standard input exits so when GH_STDIN is not set. shims/gh then reads its stdin into a
# private unlinked file, runs the check again with GH_STDIN naming that open file (/dev/fd/N), and gives gh the same
# bytes when the check passes.
GH_STDIN_EXIT = 7
GH_STDIN = "DOTFILES_LEAK_TERMS_GH_STDIN"
# Every gh command that sends text, with its options as `gh <command> <subcommand> --help` lists them at gh 2.98.0, the
# version mise.toml pins: (the options that take a value, the options that take none), a short and a long spelling
# joined by `/`. shims/tests/test_gh_leak_terms.py compares the tables with the gh on PATH, so an upgrade that adds an
# option fails that test until the table has it. `gh api` is ("api", ""). `issue transfer` is not here: GitHub moves
# an issue only within one owner and never from a private to a public repository ("You can only transfer issues between
