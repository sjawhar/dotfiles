# gh's own aliases of those commands, and its top-level commands with theirs: a first word that is none of them can be
# a gh alias of the user's (config.yml's `aliases`), which is read as the command it expands to.
GH_GROUP_ALIASES = {"agent": "agent-task", "agent-tasks": "agent-task", "agents": "agent-task"}
GH_SUBCOMMAND_ALIASES = {
    ("gist", "new"): "create", ("issue", "new"): "create", ("pr", "new"): "create", ("release", "new"): "create",
    ("repo", "new"): "create",
}
GH_COMMANDS = frozenset((
    "agent", "agent-task", "agent-tasks", "agents", "alias", "api", "at", "attestation", "auth", "browse", "cache",
    "codespace", "completion", "config", "copilot", "cs", "discussion", "ext", "extension", "extensions", "gist",
    "gpg-key", "help", "issue", "label", "licenses", "org", "pr", "preview", "project", "release", "repo", "rs",
    "ruleset", "run", "search", "secret", "skill", "skills", "ssh-key", "status", "variable", "version", "workflow",
))
# The options whose value names a file whose text gh sends, `-` naming standard input.
GH_FILE_OPTIONS = frozenset(("--body-file", "--notes-file", "--from-file", "--recover", "--input"))
# A repository's URL as gh reads it: the host is the URL's host, a user and a port left out (gh's URL.Hostname()), so
# https://x@github.com:443/o/r/pull/1 is o/r's.
GH_REPOSITORY_URL = re.compile(r"^https?://(?:[^/@\s]*@)?(?:www\.)?github\.com(?::\d*)?/([^/\s]+)/([^/\s#?]+)",
                               re.IGNORECASE)
# Options whose value gh keeps to itself: a jq filter, a Go template or a format for its own output, a cache time.
GH_LOCAL_OPTIONS = frozenset((("api", "--jq"), ("api", "--template"), ("api", "--cache"), ("project", "--jq"),
                              ("project", "--template"), ("project", "--format")))
GH_API_REPOSITORY = re.compile(r"^/?repos/([^/?#{}]+)/([^/?#{}]+)")
GH_GRAPHQL_MUTATION = re.compile(r"\bmutation\b")
JSON_ESCAPE = re.compile(r'\\(?:u([0-9A-Fa-f]{4})|(["\\/bfnrt]))')
JSON_SIMPLE_ESCAPES = {'"': '"', "\\": "\\", "/": "/", "b": "\b", "f": "\f", "n": "\n", "r": "\r", "t": "\t"}
# One whitespace character, which gh_findings reads as a space; each is one character, so a match keeps its place.
GH_WHITESPACE = re.compile(r"\s")


@dataclass(frozen=True)
class GhText:
    """One text a gh call sends. OPTION says where it is (an option's long name, or `argument N`) and never holds the
    caller's text; DETAIL is the caller's own name for it (a path, a field's key), shown with each term masked. The text
    is TEXT, or what the file PATH holds (`-`: standard input); an OPTIONAL file is read only when it can be."""

    option: str
    detail: str = ""
    text: str | None = None
    path: str | None = None
    optional: bool = False

    def shown(self, matcher: TermMatcher | None) -> str:
        detail = ""
        if self.detail:
            detail = " " + (mask_path(self.detail, matcher.spans(self.detail)) if matcher else "<not shown>")
        return f"{self.option}{detail}{' (standard input)' if self.path == '-' else ''}"


def gh_options(table: tuple[str, str]) -> dict[str, bool]:
    """Every spelling of each option of a GH_TEXT_COMMANDS entry: True for one that takes a value."""
    return {name: takes for takes, names in ((True, table[0]), (False, table[1])) for item in names.split()
            for name in item.split("/")}


def gh_long_names(table: tuple[str, str]) -> dict[str, str]:
    """The long spelling of each spelling of each option of a GH_TEXT_COMMANDS entry."""
    return {name: item.split("/")[-1] for item in f"{table[0]} {table[1]}".split() for name in item.split("/")}


def gh_config_directory(environment: Mapping[str, str]) -> Path:
    """gh's configuration directory, found as gh 2.98.0 finds it (config.ConfigDir)."""
    if environment.get("GH_CONFIG_DIR"):
        return Path(environment["GH_CONFIG_DIR"])
    if environment.get("XDG_CONFIG_HOME"):
        return Path(environment["XDG_CONFIG_HOME"]) / "gh"
    return Path(environment.get("HOME") or passwd_home()) / ".config" / "gh"


def yaml_scalar(value: str) -> str:
    """A one-line YAML scalar, as gh writes an alias: plain, 'single-quoted' or "double-quoted"."""
    value = value.strip()
    if len(value) >= 2 and value[0] == value[-1] == "'":
        return value[1:-1].replace("''", "'")
    if len(value) >= 2 and value[0] == value[-1] == '"':
        try:
            return json.loads(value)
        except json.JSONDecodeError:
            return value[1:-1]
    return re.sub(r"\s+#.*$", "", value)


def gh_alias(word: str, environment: Mapping[str, str]) -> str | None:
    """The expansion of the gh alias WORD in gh's config.yml, or None."""
    try:
        lines = (gh_config_directory(environment) / "config.yml").read_text(encoding="utf-8").splitlines()
    except (OSError, UnicodeDecodeError):
        return None
    inside = False
    for line in lines:
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        if not line[0].isspace():
            inside = line.rstrip() == "aliases:"
            continue
        entry = re.match(r"""^\s+("(?:[^"\\]|\\.)*"|'(?:[^']|'')*'|[^\s:][^:]*?)\s*:(?:\s+(.*))?$""", line)
        if inside and entry and yaml_scalar(entry.group(1)) == word:
            return yaml_scalar(entry.group(2) or "")
    return None


def gh_expand_alias(expansion: str, arguments: Sequence[str]) -> list[str] | None:
    """gh 2.98.0's expansion of an alias (`$1`… take the arguments, the rest follow), or None where gh refuses it."""
    extra: list[str] = []
    for number, argument in enumerate(arguments, start=1):
        if "$" not in expansion:
            extra.append(argument)
        else:
            expansion = expansion.replace(f"${number}", argument)
    if re.search(r"\$\d", expansion):
        return None
    try:
        return [*shlex.split(expansion), *extra]
    except ValueError:
        return None


def gh_next_command(arguments: Sequence[str]) -> tuple[str, list[str]] | None:
    """cobra's reading of a command word in ARGUMENTS: the first word that is neither an option nor an option's value
    (`gh -R o/r pr comment 1` and `gh pr -R o/r comment 1` are both `gh pr comment`), and the other words, which go on
    to the command. As cobra's stripFlags does, an option written apart from any value, but --help and --version, is
    taken to have its value in the next word."""
    index = 0
    while index < len(arguments):
        word = arguments[index]
        if word == "--":
            return None
        if (word.startswith("-") and "=" not in word and word not in ("--help", "--version")
                and (word.startswith("--") or len(word) == 2)):
            index += 2
        elif word.startswith("-"):
            index += 1
        else:
            return word, [*arguments[:index], *arguments[index + 1:]]
    return None


def gh_command(arguments: Sequence[str], environment: Mapping[str, str],
               depth: int = 0) -> tuple[str, str, list[str]] | None:
    """(group, subcommand, the arguments the subcommand reads) of a gh call that can send text, after a gh alias;
    None for any other call."""
    found = gh_next_command(arguments)
    if found is None:
        return None
    first, rest = found
    if first not in GH_COMMANDS:
        return gh_alias_command(first, rest, environment, depth)
    group = GH_GROUP_ALIASES.get(first, first)
    if group == "api":
        return group, "", rest
    found = gh_next_command(rest)
    if found is None:
        return None
    word, rest = found
    sub = GH_SUBCOMMAND_ALIASES.get((group, word), word)
    if (group, sub) in GH_TEXT_COMMANDS:
        return group, sub, rest
    # An alias under a command (`gh alias set 'pr say' 'pr comment'`), which gh runs as what it expands to. Until
    # 2026-11-17 only an alias of the first word was read, so `gh pr say 11 --body …` went out unchecked.
    return gh_alias_command(f"{first} {word}", rest, environment, depth)


def gh_alias_command(name: str, rest: Sequence[str], environment: Mapping[str, str],
                     depth: int) -> tuple[str, str, list[str]] | None:
    """gh_command of what the gh alias NAME runs with REST; None for no such alias, for a shell alias (`!…`), which
    runs a shell whose own gh calls come back through shims/gh, and past three aliases in a row."""
    expansion = gh_alias(name, environment) if depth < 3 else None
    expanded = None if expansion is None or expansion.startswith("!") else gh_expand_alias(expansion, rest)
    return gh_command(expanded, environment, depth + 1) if expanded else None


def gh_walk(arguments: Sequence[str], options: Mapping[str, bool]) -> list[tuple[str | None, str | None]]:
    """Read ARGUMENTS as gh's flag parser (spf13/pflag) does: one (option, value) for each option given, its value None
    when it has none, and one (None, word) for each positional argument. An option gh does not know makes gh refuse
    the call, and is read here as one that takes no value."""
    read: list[tuple[str | None, str | None]] = []
    index = 0
    while index < len(arguments):
        word = arguments[index]
        index += 1
        if word == "--":
            read.extend((None, rest) for rest in arguments[index:])
            break
        if word.startswith("--") and len(word) > 2:
            name, attached, value = word.partition("=")
            if attached:
                read.append((name, value))
            elif options.get(name) and index < len(arguments):
                read.append((name, arguments[index]))
                index += 1
            else:
                read.append((name, None))
            continue
        if word.startswith("-") and len(word) > 1:
            letters = word[1:]
            while letters:
                name, rest = "-" + letters[0], letters[1:]
                if len(rest) > 1 and rest[0] == "=":
                    read.append((name, rest[1:]))
                    break
                if options.get(name):
                    if not rest and index < len(arguments):
                        rest = arguments[index]
                        index += 1
                    read.append((name, rest or None))
                    break
                read.append((name, None))
                if name not in options:
                    break
                letters = rest
            continue
        read.append((None, word))
    return read


def gh_argument_texts(group: str, sub: str, number: int, value: str) -> list[GhText]:
    """The text gh sends for its positional argument NUMBER: the word itself, or for a file, its name and what it holds."""
    option = f"argument {number}"
    if (group, sub) == ("gist", "create"):
        if value == "-":
            return [GhText(option, value, path=value)]
        texts: list[GhText] = []
        for path in sorted(glob.glob(value)) or [value]:
            texts += [GhText(option, path, path=path), GhText(f"{option} name", text=os.path.basename(path))]
        return texts
    if (group, sub) == ("gist", "edit") and number == 2:
        return [GhText(option, value, path=value)]
    if (group, sub) in (("release", "create"), ("release", "upload")) and number >= 2:
        # An asset: gh sends its file name and the label after a `#`. Its content is a build output, not text.
        path, _, label = value.partition("#")
        return [GhText(f"{option} name", text=os.path.basename(path)), GhText(f"{option} label", text=label)]
    return [GhText(option, text=value)]


def gh_texts(group: str, sub: str, read: Sequence[tuple[str | None, str | None]]) -> list[GhText]:
    """Every text the call sends: each argument and option value, but for a file gh reads, what the file holds."""
    long = gh_long_names(GH_TEXT_COMMANDS[(group, sub)])
    texts: list[GhText] = []
    number = 0
    for option, value in read:
        if option is None:
            number += 1
            texts += gh_argument_texts(group, sub, number, value or "")
            continue
        name = long.get(option, option)
        if (group, name) in GH_LOCAL_OPTIONS:
            continue
        if value is None:
            if (group, sub, name) == ("workflow", "run", "--json"):
                texts.append(GhText(name, path="-"))
            continue
        if name in GH_FILE_OPTIONS:
            texts.append(GhText(name, value, path=value))
        elif (group, sub, name) == ("gist", "edit", "--add"):
            texts += [GhText(name, value, path=value), GhText(f"{name} name", text=os.path.basename(value))]
        elif (group, sub, name) == ("pr", "create", "--template"):
            # A template's name, which gh also reads as a file's path when there is such a file.
            texts += [GhText(name, text=value), GhText(name, value, path=value, optional=True)]
        elif group in ("api", "workflow") and name in ("--field", "--raw-field"):
            key, _, field_value = value.partition("=")
            if name == "--field" and field_value.startswith("@"):
                texts += [GhText(name, key, text=key), GhText(name, value, path=field_value[1:])]
            else:
                texts.append(GhText(name, key, text=value))
        else:
            texts.append(GhText(name, text=value))
    if (group, sub) == ("gist", "create") and number == 0:
        texts.append(GhText("gist", path="-"))
    return texts


def gh_api_sends(read: Sequence[tuple[str | None, str | None]]) -> bool:
    """Whether a `gh api` call sends a body: a method other than GET or HEAD, else (gh's default POST) a field or an
    --input file."""
    long = gh_long_names(GH_TEXT_COMMANDS[("api", "")])
    method: str | None = None
    body = False
    for option, value in read:
        name = long.get(option, option) if option else None
        if name == "--method" and value is not None:
            method = value
        elif name in ("--field", "--raw-field", "--input") and value is not None:
            body = True
    return method.upper() not in ("GET", "HEAD") if method is not None else body


def gh_is_stdin(path: str) -> bool:
    """Whether PATH (/dev/stdin, /dev/fd/0, …) is this call's standard input while that is a pipe or a terminal, which
    gh reads after the check: the check then reads the shim's buffer of it, as for `-`."""
    try:
        named, standard = os.stat(path), os.fstat(0)
    except OSError:
        return False
    return not stat.S_ISREG(standard.st_mode) and os.path.samestat(named, standard)


def gh_contents(texts: Sequence[GhText], stdin: str | None) -> tuple[list[tuple[GhText, str]], list[tuple[GhText, str]]]:
    """Each text with what gh sends for it, and each file that cannot be read with why. A pipe, a socket or a device
    other than /dev/null is not read: reading a pipe takes the text gh reads after the check (until 2026-11-17 a
    `--body-file <(…)` went out empty, and a `gh pr edit --body-file /dev/stdin` emptied the body), and a device may
    never end. Such a file cannot be read, so its text is refused for a target not confirmed private (gh_check)."""
    contents: list[tuple[GhText, str]] = []
    unreadable: list[tuple[GhText, str]] = []
    for piece in texts:
        if piece.path is None:
            contents.append((piece, piece.text or ""))
        elif piece.path == "-":
            if stdin is None:
                unreadable.append((piece, "standard input could not be read"))
            else:
                contents.append((piece, stdin))
        else:
            try:
                mode = os.stat(piece.path).st_mode
                if (stat.S_ISFIFO(mode) or stat.S_ISSOCK(mode) or stat.S_ISCHR(mode) or stat.S_ISBLK(mode)) and \
                        not os.path.samestat(os.stat(piece.path), os.stat(os.devnull)):
                    if not piece.optional:
                        unreadable.append((piece, "a pipe or a device, which the check cannot read without taking its "
                                                  "text from gh: pass the text in a file, or on standard input as -"))
                    continue
                data = Path(piece.path).read_bytes()
            except OSError as error:
                if not piece.optional:
                    unreadable.append((piece, error.strerror or type(error).__name__))
                continue
            contents.append((piece, data.decode("utf-8", errors="surrogateescape")))
    return contents, unreadable


def escapes_decoded(text: str) -> str:
    """TEXT with JSON's string escapes decoded, which GraphQL shares: an `--input` payload written with Python's
    json.dump spells each letter outside ASCII as a \\u escape, and GitHub stores the letter."""
    decoded = JSON_ESCAPE.sub(lambda m: chr(int(m.group(1), 16)) if m.group(1) else JSON_SIMPLE_ESCAPES[m.group(2)], text)
    try:
        return decoded.encode("utf-16", "surrogatepass").decode("utf-16")
    except UnicodeError:
        return decoded


def gh_findings(contents: Sequence[tuple[GhText, str]], matcher: TermMatcher) -> list[tuple[GhText, str, int, Span]]:
    """(text, how it was read, line, match) for each listed term in each text: as written, and for a text that holds a
    backslash, with its escapes decoded too.

    A text is read whole, each whitespace character read as a space: GitHub renders a line break inside a paragraph as
    a space, so a term of several words that a wrapped line (or a no-break space) splits is the term on the page. Until
    2026-11-17 each line was read alone, and a body wrapped inside such a term went to a public repository. Both views
    are read whatever the first finds: a match counts only for a target its list reaches and no allowed token of that
    target holds (gh_check), so the first view's matches can all be dropped there while the second's count. A match of
    the decoded view is left out only when one of the first view has its term, list and allowed tokens, since gh_check
    judges the two alike."""
    found: list[tuple[GhText, str, int, Span]] = []
    for piece, text in contents:
        views = [("", text)]
        if "\\" in text:
            views.append((" (escapes decoded)", escapes_decoded(text)))
        seen: set[tuple[int, str, tuple[str, ...]]] = set()
        for how, view in views:
            for span in matcher.spans(GH_WHITESPACE.sub(" ", view)):
                key = (span.term, span.scope, span.allowed_in)
                if how and key in seen:
                    continue
                seen.add(key)
                found.append((piece, how, view.count("\n", 0, span.start) + 1, span))
    return found


def gh_visibility(url: str) -> str:
    """What scripts/github-repo-visibility says of URL (the leak check's cache, else gh): public, private, internal,
    not-github or unknown."""
    helper = Path(__file__).resolve().parent / "github-repo-visibility"
    try:
        completed = subprocess.run([str(helper), url], stdin=subprocess.DEVNULL, capture_output=True, text=True,
                                   timeout=30, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return "unknown"
    value = completed.stdout.strip()
    if completed.returncode == 0 and value in ("public", "private", "internal", "not-github"):
        return value
    return "unknown"


def gh_repository_url(value: str) -> str:
    """The URL of a repository gh names as `[HOST/]OWNER/REPO` or by its URL."""
    if "://" in value or value.startswith("git@"):
        return value
    parts = value.split("/")
    return f"https://github.com/{value}" if len(parts) == 2 else f"https://{value}"


def gh_remotes() -> list[tuple[str, str]]:
    """(name, URL) of each remote of this directory gh can take for the repository: the one `gh repo set-default`
    named (a remote's `gh-resolved`), else every one, since which one gh takes then depends on its version."""
    def git(*arguments: str) -> list[str]:
        try:
            completed = subprocess.run(["git", *arguments], stdin=subprocess.DEVNULL, capture_output=True, text=True,
                                       timeout=30, check=False)
        except (OSError, subprocess.TimeoutExpired):
            return []
        return completed.stdout.splitlines() if completed.returncode == 0 else []

    remotes: list[tuple[str, str]] = []
    for line in git("remote", "-v"):
        name, _, rest = line.partition("\t")
        # A fetch line ends at its first ` (fetch)`, since a partial clone's filter follows it.
        url = rest.split(" (fetch)", 1)[0] if " (fetch)" in rest else rest.removesuffix(" (push)")
        if name and url and (name, url) not in remotes:
            remotes.append((name, url))
    resolved: dict[str, str] = {}
    for line in git("config", "--get-regexp", r"^remote\..*\.gh-resolved$"):
        key, _, value = line.partition(" ")
        resolved[key.removeprefix("remote.").removesuffix(".gh-resolved")] = value.strip()
    if not resolved:
        return remotes
    chosen = [(name, url) for name, url in remotes if resolved.get(name) == "base"]
    return chosen + [(value, gh_repository_url(value)) for value in resolved.values() if value and value != "base"]


@dataclass(frozen=True)
class GhTarget:
    """Where a gh call's text can go: SHOWN names it in a refusal, REPOSITORY is its `owner/name` ("" for a target with
    no repository, or one nobody could name), and OPEN says it is not confirmed private or internal."""

    shown: str
    repository: str
    open: bool


GH_NODE_ID = re.compile(r"\b(?:[A-Z][A-Za-z]{0,7}_[A-Za-z0-9_-]{6,}|MD[A-Za-z0-9+/]{8,}={0,2})(?![A-Za-z0-9_-])")
# A mutation that names its repository by name, not by node id: createCommitOnBranch's `repositoryNameWithOwner`, as a
# GraphQL argument, a JSON variable or a gh field (`-F branch[repositoryNameWithOwner]=o/r`); and one that makes a
# repository.
GH_GRAPHQL_NAMED = re.compile(r"\brepositoryNameWithOwner\b")
GH_GRAPHQL_NAMED_VALUE = re.compile(
    r'\brepositoryNameWithOwner\]?"?\s*[:=]\s*"?([A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9._-]+)')
GH_GRAPHQL_NEW_REPOSITORY = re.compile(r"\b(?:createRepository|cloneTemplateRepository)\b")
GH_NODES_QUERY = (
    "query($ids: [ID!]!) { nodes(ids: $ids) { ... on RepositoryNode { repository { nameWithOwner } } "
    "... on PullRequestReviewThread { repository { nameWithOwner } } ... on Repository { nameWithOwner } } }"
)


def gh_node_repositories(texts: Sequence[str]) -> list[str] | None:
    """The repository (`owner/name`) of each GitHub node id in TEXTS, read with one GraphQL query through this
    checkout's shims/gh; None when there is no id, when the read fails, or when any id has no repository it can read."""
    ids = sorted({match.group(0) for text in texts for match in GH_NODE_ID.finditer(text)})
    if not ids:
        return None
    gh = Path(__file__).resolve().parent.parent / "shims" / "gh"
    fields = [argument for node in ids for argument in ("-f", f"ids[]={node}")]
    try:
        completed = subprocess.run(
            [str(gh), "api", "graphql", "-f", f"query={GH_NODES_QUERY}", *fields, "--jq",
             '.data.nodes[] | (.repository.nameWithOwner // .nameWithOwner // "")'],
            stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=30, check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    repositories = completed.stdout.split()
    if completed.returncode != 0 or len(completed.stdout.splitlines()) != len(ids) or len(repositories) != len(ids):
        return None
    return sorted({repository.lower() for repository in repositories})


def gh_reach(group: str, sub: str, read: Sequence[tuple[str | None, str | None]],
             environment: Mapping[str, str], texts: Sequence[str] = ()) -> list[GhTarget]:
    """Every target the call can reach: the repositories it names, else GH_REPO, else this directory's remotes; for a
    GraphQL mutation, the repositories of the nodes it names. A visibility that cannot be read is open, and so is a
    target with no repository: a gist (anyone with its address reads it), a project, another host, a GraphQL mutation
    whose nodes cannot all be read."""
    long = gh_long_names(GH_TEXT_COMMANDS[(group, sub)])
    host = (environment.get("GH_HOST") or "github.com").lower()
    if host != "github.com":
        return [GhTarget(f"a repository on {host}, read as public", "", True)]
    if group == "gist":
        return [GhTarget("a gist, which anyone with its address can read", "", True)]
    if group == "project":
        return [GhTarget("a project, read as public", "", True)]
    values: dict[str, list[str | None]] = {}
    positionals: list[str] = []
    for option, value in read:
        if option is None:
            positionals.append(value or "")
        else:
            values.setdefault(long.get(option, option), []).append(value)
    if (group, sub) == ("repo", "create"):
        private = any(values.get(name) and (values[name][-1] is None or values[name][-1].lower() in ("1", "t", "true"))
                      for name in ("--private", "--internal"))
        name = positionals[0] if positionals else "a new repository"
        shown = f"{name} ({'private' if private else 'not made private, so read as public'})"
        return [GhTarget(shown, name.lower() if name.count("/") == 1 else "", not private)]
    targets: list[tuple[str, str, bool]] = []
    for value in [*values.get("--repo", []), *values.get("--branch-repo", [])]:
        if value:
            targets.append((value, gh_repository_url(value), True))
    for value in positionals:
        named = GH_REPOSITORY_URL.match(value)
        if named:
            targets.append((f"{named[1]}/{named[2]}", f"https://github.com/{named[1]}/{named[2]}", True))
    # A fork is as visible as the repository it forks, so its new name (--fork-name) goes where that one is.
    if (group, sub) in (("repo", "edit"), ("repo", "fork")) and positionals and not GH_REPOSITORY_URL.match(positionals[0]):
        targets.append((positionals[0], gh_repository_url(positionals[0]), True))
    base = True
    if group == "api":
        endpoint = positionals[0] if positionals else ""
        named = GH_API_REPOSITORY.match(endpoint)
        if named:
            targets.append((f"{named[1]}/{named[2]}", f"https://github.com/{named[1]}/{named[2]}", True))
        if endpoint == "graphql" and not targets:
            # A mutation names what it changes by node id, and each id gh can read gives its repository; it can also
            # name a repository by name (createCommitOnBranch), or make one. Every such repository is a target: until
            # 2026-11-17 only the node ids were, so a commit to a public repository by name went out when the text
            # also held an id of a private one. An id gh cannot read, a name given only through a variable the check
            # cannot see, a new repository, or no repository at all leaves the target unknown. Each text is read as
            # written and with its JSON escapes decoded, as gh_findings reads it.
            views = [view for text in texts for view in dict.fromkeys((text, escapes_decoded(text)))]
            if any(GH_GRAPHQL_NEW_REPOSITORY.search(view) for view in views):
                return [GhTarget("a GraphQL mutation that makes a repository, read as public", "", True)]
            named = [match[1].lower() for view in views for match in GH_GRAPHQL_NAMED_VALUE.finditer(view)]
            resolved = gh_node_repositories(views) if any(GH_NODE_ID.search(view) for view in views) else []
            if (resolved is None or sum(len(GH_GRAPHQL_NAMED.findall(view)) for view in views) != len(named)
                    or not (resolved or named)):
                return [GhTarget("a GraphQL mutation whose repository could not be read, read as public", "", True)]
            targets += [(repository, f"https://github.com/{repository}", True)
                        for repository in dict.fromkeys([*named, *resolved])]
        base = "{owner}" in endpoint or "{repo}" in endpoint
        if not targets and not base:
            return [GhTarget("no repository, read as public", "", True)]
    if not targets and base:
        if environment.get("GH_REPO"):
            targets.append((environment["GH_REPO"], gh_repository_url(environment["GH_REPO"]), True))
        else:
            targets = [(f"remote {name}", url, False) for name, url in gh_remotes()]
    made_public = (group, sub) == ("repo", "edit") and any(
        (v or "").lower() == "public" for v in values.get("--visibility", []))
    reached: list[GhTarget] = []
    for name, url, named_by_call in targets:
        visibility = gh_visibility(url)
        if visibility == "not-github" and not named_by_call:
            continue
        repository = next(iter(repository_of(url)), "")
        if made_public:
            reached.append(GhTarget(f"{name} (made public by the call)", repository, True))
        elif visibility in ("private", "internal"):
            reached.append(GhTarget(f"{name} ({visibility})", repository, False))
        else:
            shown = "public" if visibility == "public" else "visibility unread, so read as public"
            reached.append(GhTarget(f"{name} ({shown})", repository, True))
    return reached or [GhTarget("no GitHub repository found for the call, read as public", "", True)]


def gh_check(arguments: Sequence[str]) -> int:
    """`gh -- ARGV…`: refuse a gh call that sends a listed term to anything not confirmed private (exit 3), whose text
    cannot be checked because the list cannot be read (exit 2), or that names a file nobody can read (exit 4); exit
    GH_STDIN_EXIT to ask for standard input. Any other call exits 0 untouched, and the text of a call that reaches only
    private or internal repositories is not checked, nor are their visibilities read before a term is found."""
    environment = os.environ
    command = gh_command(arguments, environment)
    if command is None:
        return 0
    group, sub, rest = command
    read = gh_walk(rest, gh_options(GH_TEXT_COMMANDS[(group, sub)]))
    if group == "api" and not gh_api_sends(read):
        return 0
    # `pr create --dry-run` prints the pull request it would create and sends none of its text.
    dry_run = [value for option, value in read if option == "--dry-run"]
    if (group, sub) == ("pr", "create") and dry_run and (dry_run[-1] or "true").lower() in ("1", "t", "true"):
        return 0
    texts = [GhText(piece.option, piece.detail, path="-", optional=piece.optional)
             if piece.path not in (None, "-") and gh_is_stdin(piece.path) else piece
             for piece in gh_texts(group, sub, read)]
    stdin: str | None = None
    if any(piece.path == "-" for piece in texts):
        pointer = environment.get(GH_STDIN)
        if not pointer:
            return GH_STDIN_EXIT
        try:
            stdin = Path(pointer).read_bytes().decode("utf-8", errors="surrogateescape")
        except OSError:
            stdin = None
    contents, unreadable = gh_contents(texts, stdin)
    if group == "api" and read and not unreadable:
        endpoint = next((value for option, value in read if option is None), "")
        # GitHub reads an --input payload as JSON, so `\u006dutation` there is the keyword too: the decoded view counts.
        if endpoint == "graphql" and not any(GH_GRAPHQL_MUTATION.search(view) for _, text in contents
                                             for view in (text, escapes_decoded(text))):
            return 0
    matcher: TermMatcher | None = None
    list_problem: str | None = None
    findings: list[tuple[GhText, str, int, Span]] = []
    if any(text for _, text in contents):
        try:
            # Every scoped list, the knives registry's included: which ones apply depends on where the text goes,
            # which is read only when a term is found.
            matcher = load_terms(repositories=EVERY_REPOSITORY, registry=True)
        except ListError as error:
            list_problem = str(error)
        else:
            findings = gh_findings(contents, matcher)
    if not findings and list_problem is None and not unreadable:
        return 0
    reached = gh_reach(group, sub, read, environment, [text for _, text in contents])
    open_targets = [target.repository for target in reached if target.open]
    if not open_targets:
        return 0
    if matcher is not None:
        # A match counts for an open target its list's scope reaches and no allowed token of that target holds.
        def counts(span: Span) -> bool:
            return any((not span.scope or matcher.scopes[span.scope].reaches([target]))
                       and not span.allowed_for(target) for target in open_targets)

        findings = [finding for finding in findings if counts(finding[3])]
        if not findings and list_problem is None and not unreadable:
            return 0
    name = f"gh {group} {sub}".rstrip()
    # Without the list nothing can be masked, so no name the caller gave is shown.
    target = "a repository not confirmed private"
    if matcher:
        target = ", ".join(mask_path(item.shown, matcher.spans(item.shown)) for item in reached)
    for piece, how, line, span in findings:
        print(f"leak terms: {name} to {target}: {piece.shown(matcher)}{how} line {line}: listed leak term "
              f"{span.label()}", file=sys.stderr)
    for piece, reason in unreadable:
        print(f"leak terms: {name} to {target}: cannot read {piece.shown(matcher)}: {reason}", file=sys.stderr)
    if list_problem:
        print(list_problem, file=sys.stderr)
        print(f"leak terms: {name} to {target}: its text cannot be checked without the list", file=sys.stderr)
    print(
        f"leak terms: {name}: refused before gh ran, so nothing was sent. Remove the term from the text, or if it is "
        "not private remove it from its list: sops edit leak-terms.sops.yaml, or for `of knives <name>` the "
        "registry's forbidden list (listed leak term N is the Nth term of its list, counting neither blank lines nor "
        "# lines)",
        file=sys.stderr,
    )
    return FOUND_EXIT if findings else LIST_EXIT if list_problem else TEXT_EXIT


def parser() -> argparse.ArgumentParser:
    argument_parser = argparse.ArgumentParser(prog="leak-terms-check")
    modes = argument_parser.add_subparsers(dest="mode", required=True)
    diff = modes.add_parser("diff")
    diff.add_argument("--place-prefix", default="")
    staged = modes.add_parser("staged")
    message = modes.add_parser("message")
    message.add_argument("--cleanup", choices=("verbatim", "whitespace", "strip", "scissors"), default="verbatim")
    message.add_argument("--comment-char")
    message.add_argument("--cut-at-scissors", action="store_true")
    message.add_argument("--place", default="commit message")
    message.add_argument("--encoding", default="utf-8")
    comment_char = modes.add_parser("git-comment-char")
    comment_char.add_argument("--editor-ran", choices=("0", "1"), required=True)
    comment_char.add_argument("--status-shown", choices=("0", "1"), required=True)
    comment_char.add_argument("--cut-line-written", choices=("0", "1"), required=True)
    jj_editor_parser = modes.add_parser("jj-editor")
    jj_editor_parser.add_argument("file")
    jj_preflight = modes.add_parser("jj-editor-preflight")
    jj_preflight.add_argument("listing")
    push = modes.add_parser("push")
    push.add_argument("--remote", required=True)
    push.add_argument("--url", required=True)
    # `gh -- ARGV…` takes a gh call's own arguments, which main hands to gh_check without parsing them.
    modes.add_parser("gh", help="check the text a gh call sends: gh -- ARGV...")
    return argument_parser


def main(arguments: Sequence[str] | None = None) -> int:
    arguments = sys.argv[1:] if arguments is None else list(arguments)
    if arguments[:1] == ["gh"]:
        rest = arguments[1:]
        return gh_check(rest[1:] if rest[:1] == ["--"] else rest)
    args = parser().parse_args(arguments)
    if args.mode == "jj-editor":
        return jj_editor(args.file)
    if args.mode == "jj-editor-preflight":
        return jj_editor_preflight(args.listing)
    try:
        text = "" if args.mode == "staged" else read_stdin(args.encoding if args.mode == "message" else "utf-8")
    except TextError as error:
        print(f"leak terms: cannot read text to check: {error}", file=sys.stderr)
        return TEXT_EXIT

    if args.mode == "git-comment-char":
        character = git_comment_char(
            text, args.editor_ran == "1", args.status_shown == "1", args.cut_line_written == "1"
        )
        if character is not None:
            print(character)
        return 0

    try:
        if args.mode == "push":
            findings = scan_push(text, args.remote, args.url)
        elif args.mode == "staged":
            findings = scan_staged_diff()
        elif not text:
            findings = []
        else:
            matcher = load_terms()
            if args.mode == "diff":
                findings = scan_diff(text, matcher, args.place_prefix)
            else:
                findings = scan_message(text, matcher, args.cleanup, args.comment_char, args.cut_at_scissors, args.place)
    except ListError as error:
        print(error, file=sys.stderr)
        return LIST_EXIT
    except TextError as error:
        print(f"leak terms: cannot read text to check: {error}", file=sys.stderr)
        return TEXT_EXIT

    if not findings:
        return 0
    print_findings(findings)
    return FOUND_EXIT


if __name__ == "__main__":
    raise SystemExit(main())
