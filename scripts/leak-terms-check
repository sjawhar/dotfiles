#!/usr/bin/env python3
"""Check diffs, commit messages, outgoing commits and the text a gh call sends against the encrypted leak-term list, and
record the file versions that hold no listed term, so a push need not read them again (`record`, RECORD_REF).

This is the one matcher: a caller (shims/git's hooks, shims/jj, jj-push-hooks, shims/gh) runs it and matches no term
itself, and takes any nonzero exit for a refusal, except GH_STDIN_EXIT in `gh` mode, which asks for a second pass with
the call's stdin. A refusal shows the text that matched (Finding)."""
from __future__ import annotations

import argparse
import codecs
import ctypes
import errno
import fnmatch
import glob
import hashlib
import html
import io
import json
import os
import pwd
import re
import shlex
import shutil
import stat
import subprocess
import threading
import sys
import tomllib
import unicodedata
import urllib.parse
from functools import lru_cache
from dataclasses import dataclass, field, replace
from pathlib import Path
from typing import Callable, Iterable, Iterator, Mapping, Sequence, TypeVar, cast


LIST_EXIT = 2
FOUND_EXIT = 3
TEXT_EXIT = 4
# jj-editor-preflight: jj's editor configuration cannot be read, or it names this wrapper.
EDITOR_UNREADABLE_EXIT = 5
EDITOR_WRAPPER_EXIT = 6
EDITOR_GUARD = "DOTFILES_JJ_EDITOR_WRAPPER_ACTIVE"
SCISSORS = "------------------------ >8 ------------------------"
# Git's combined diff (`--cc`) is wrong for wide octopus merges (combine-diff.c, git 2.43 to master): from 33 parents a
# removed line's `-` lands in the column of parent n-32, so the body disagrees with its own hunk counts, and from 64
# parents its parent bit masks overflow (with 64, a line only the merge adds is left out of the output). A merge is
# read from its files instead (scan_outgoing_merges), and combined diff text is refused.
COMBINED_REFUSAL = "combined diff text (diff --cc), which this check does not read: it reads a merge from its files"


class ListError(Exception):
    """The encrypted term list could not be read."""


class TextError(Exception):
    """The caller's diff or message could not be read."""

def newline_lines(text: str) -> list[str]:
    """Split only on the newline byte used by git and jj diff formats."""
    lines = text.split("\n")
    if lines and not lines[-1]:
        lines.pop()
    return lines


def passwd_home() -> Path:
    """Return the home directory from passwd, independent of a caller's HOME."""
    return Path(pwd.getpwuid(os.getuid()).pw_dir)


def term_file(environment: Mapping[str, str]) -> Path:
    configured = environment.get("DOTFILES_LEAK_TERMS_FILE")
    if configured:
        return Path(configured)
    return Path(__file__).resolve().parent.parent / "leak-terms.sops.yaml"


SOPS_PIN = re.compile(r'^[ \t]*"?sops"?[ \t]*=[ \t]*"([0-9][0-9A-Za-z.+-]*)"')
TOML_SECTION = re.compile(r"^[ \t]*\[([^]]*)\]")


def pinned_sops() -> str | None:
    """The sops version this checkout's mise.toml pins exactly under [tools], else None."""
    try:
        lines = (Path(__file__).resolve().parent.parent / "mise.toml").read_text(encoding="utf-8").splitlines()
    except (OSError, UnicodeDecodeError):
        return None
    section = ""
    for line in lines:
        header = TOML_SECTION.match(line)
        if header:
            section = header.group(1).strip()
        elif section == "tools":
            pin = SOPS_PIN.match(line)
            if pin:
                return pin.group(1)
    return None


def mise_data_dirs(environment: Mapping[str, str]) -> list[Path]:
    """The mise data dirs a pinned tool may be installed in, as each shim's copy of mise_paths reads them:
    MISE_DATA_DIR and mise's default ~/.local/share/mise under HOME; with no MISE_DATA_DIR, ~/.mise (.bashrc's) and
    that default under HOME, then the same two under the uid's passwd home, which a caller's HOME does not move."""
    home = environment.get("HOME")
    share = Path(environment.get("XDG_DATA_HOME") or Path(home or "/nonexistent") / ".local" / "share") / "mise"
    if environment.get("MISE_DATA_DIR"):
        dirs = [Path(environment["MISE_DATA_DIR"]), share]
    else:
        dirs = [Path(home) / ".mise", share] if home else []
        dirs += [passwd_home() / ".mise", passwd_home() / ".local" / "share" / "mise"]
    return list(dict.fromkeys(d for d in dirs if d.is_absolute()))


def pinned_install(data: Path, pin: str) -> str | None:
    install = data / "installs" / "sops" / pin
    for candidate in (install / "sops", install / "bin" / "sops"):
        if candidate.is_file() and os.access(candidate, os.X_OK):
            return str(candidate)
    return None


def sops_command(environment: Mapping[str, str]) -> str | None:
    """The sops to run: the first on PATH, except that mise's shim gives way to the pinned sops it would run; with no
    sops on PATH, the pinned sops in mise's data dirs.

    mise's shim takes its version from the caller's HOME (mise's global config) or from a mise.toml in the caller's
    directory, so a commit made with a test's HOME outside this checkout found no version and the shim exited 1
    (2026-11-16, every Legion fixture repository on sami-devbox). The pinned install sits in the same mise data
    directory as the shims directory, so finding it reads no HOME. With no exact pin in this checkout's mise.toml, or
    no install of it there, the shim runs as found. A Legion test pane's PATH holds no sops at all
    (`<bin>:/usr/local/bin:/usr/bin:/bin`), so every commit through shims/jj there was refused until 2026-11-17."""
    pin = pinned_sops()
    found = shutil.which("sops", path=environment.get("PATH", os.defpath))
    if found is None:
        if not pin:
            return None
        for data in mise_data_dirs(environment):
            install = pinned_install(data, pin)
            if install:
                return install
        return None
    shims = Path(found).parent
    if shims.name == "shims" and pin:
        install = pinned_install(shims.parent, pin)
        if install:
            return install
    return found


def missing_sops(environment: Mapping[str, str]) -> str:
    """The refusal for no sops: what was searched, and the correction."""
    pin = pinned_sops()
    if not pin:
        return "sops is not on PATH, and this checkout's mise.toml pins no exact sops; install sops with mise"
    searched = ", ".join(str(data / "installs" / "sops" / pin) for data in mise_data_dirs(environment))
    return f"sops is not on PATH, and the pinned sops {pin} is installed in none of {searched}; install sops with mise"


def sops_environment(environment: Mapping[str, str]) -> dict[str, str]:
    """Prepare sops's environment without changing the caller's process environment."""
    result = dict(environment)
    sops_home = result.get("DOTFILES_LEAK_TERMS_SOPS_HOME")
    if sops_home:
        result["HOME"] = sops_home
        result["XDG_CONFIG_HOME"] = sops_home
        return result

    key_variables = ("SOPS_AGE_KEY", "SOPS_AGE_KEY_FILE", "SOPS_AGE_KEY_CMD")
    if any(result.get(name) for name in key_variables):
        return result

    home = Path(result.get("HOME", str(passwd_home())))
    config_home = Path(result.get("XDG_CONFIG_HOME", str(home / ".config")))
    configured_key = config_home / "sops" / "age" / "keys.txt"
    fallback_key = passwd_home() / ".config" / "sops" / "age" / "keys.txt"
    if not configured_key.exists() and fallback_key.exists():
        result["SOPS_AGE_KEY_FILE"] = str(fallback_key)
    return result


def list_error(message: str) -> ListError:
    return ListError(f"leak terms: {message}")


@dataclass(frozen=True)
class Scope:
    """The repositories a scoped term list is for. LABEL names the list in a refusal (`cybermonklabs/*`, `knives
    oh-my-pi`); PATTERNS are `owner/name` patterns with shell wildcards, letter case ignored."""

    label: str
    patterns: tuple[str, ...]

    def reaches(self, repositories: Sequence[str]) -> bool:
        """Whether one of REPOSITORIES (`owner/name`) is the scope's; an empty string, a repository nobody could
        name, may be any repository, so it is every scope's."""
        return any(
            not repository or any(fnmatch.fnmatchcase(repository.lower(), pattern.lower()) for pattern in self.patterns)
            for repository in repositories
        )


# Every scope: a repository nobody could name.
EVERY_REPOSITORY = ("",)


def term_lines(block: str) -> list[str]:
    """The terms of a block of lines: each line stripped, without blank lines and `#` lines."""
    terms = [line.strip() for line in block.splitlines()]
    return [line for line in terms if line and not line.startswith("#")]


def knives_registry_directory(environment: Mapping[str, str]) -> Path | None:
    """The directory of knives's fork registry (repos.toml and the private repos.local.toml beside it):
    DOTFILES_LEAK_TERMS_KNIVES_DIR, else knives's own ~/.config/knives under XDG_CONFIG_HOME or HOME, else under the
    uid's passwd home, which a caller's HOME does not move. None on a machine with no registry."""
    if environment.get("DOTFILES_LEAK_TERMS_KNIVES_DIR"):
        return Path(environment["DOTFILES_LEAK_TERMS_KNIVES_DIR"])
    candidates = []
    if environment.get("XDG_CONFIG_HOME"):
        candidates.append(Path(environment["XDG_CONFIG_HOME"]) / "knives")
    if environment.get("HOME"):
        candidates.append(Path(environment["HOME"]) / ".config" / "knives")
    candidates.append(passwd_home() / ".config" / "knives")
    return next((directory for directory in candidates if (directory / "repos.toml").is_file()), None)


def repository_name(url: str) -> str:
    """The repository name a URL ends in: `oh-my-pi` of https://github.com/can1357/oh-my-pi.git."""
    return url.rstrip("/").rsplit("/", 1)[-1].rsplit(":", 1)[-1].removesuffix(".git").lower()


def knives_forbidden(environment: Mapping[str, str]) -> list[tuple[Scope, list[str]]]:
    """The `forbidden` list of each entry of knives's fork registry, repos.toml's then repos.local.toml's (knives adds
    the private file's values to the entries it names), each for every repository named as the entry's upstream,
    origin or release, whatever its owner: a fork keeps its upstream's name, and oh-my-pi's fork moved from sjawhar to
    cybermonklabs while the registry still names sjawhar. A machine with no registry has no such list; a registry that
    cannot be read refuses, as the encrypted list does."""
    directory = knives_registry_directory(environment)
    if directory is None:
        return []
    entries: dict[str, tuple[list[str], list[str]]] = {}
    for name in ("repos.toml", "repos.local.toml"):
        path = directory / name
        if not path.exists():
            continue
        problem = f"the knives registry {path} is not a [repos.<name>] table whose forbidden values are strings"
        try:
            repos = tomllib.loads(path.read_text(encoding="utf-8")).get("repos", {})
        except (OSError, UnicodeDecodeError, tomllib.TOMLDecodeError) as error:
            raise list_error(f"the knives registry {path} cannot be read; fix it or run installers/knives.sh") from error
        if not isinstance(repos, dict) or not all(isinstance(entry, dict) for entry in repos.values()):
            raise list_error(problem)
        for key, entry in repos.items():
            forbidden = entry.get("forbidden", [])
            if not isinstance(forbidden, list) or not all(isinstance(term, str) for term in forbidden):
                raise list_error(problem)
            terms, urls = entries.setdefault(key, ([], []))
            terms += [term.strip() for term in forbidden if term.strip()]
            urls += [entry[role] for role in ("upstream", "origin", "release") if isinstance(entry.get(role), str)]
    return [
        (Scope(f"knives {key}", tuple(sorted({f"*/{repository_name(url)}" for url in urls}))), terms)
        for key, (terms, urls) in entries.items()
        if terms and urls
    ]


def load_terms(environment: Mapping[str, str] | None = None, repositories: Sequence[str] = (),
               registry: bool = False, drop_allowed: bool = True) -> "TermMatcher":
    """Decrypt and parse the list, retaining every term only in process memory. The `terms` block is for every
    repository. The list's `scoped` map, of repository patterns (`cybermonklabs/*`) to blocks of lines, holds terms for
    the repositories a pattern matches only; with REGISTRY, so do the `forbidden` lists of knives's fork registry
    (knives_forbidden). A scoped list is read when its scope reaches one of REPOSITORIES (Scope.reaches): a commit has
    no repository, so it reads `terms` alone, and a push, gh text, or a `diff` or `message` given --repository names
    where it goes. With DROP_ALLOWED off, a match inside a token the destination allows is kept too (record's test)."""
    environment = dict(os.environ if environment is None else environment)
    source = term_file(environment)
    if not source.is_file():
        raise list_error("the term list is missing; run scripts/dotfiles-sync local")

    sops = sops_command(environment)
    if sops is None:
        raise list_error(missing_sops(environment))
    try:
        completed = subprocess.run(
            [sops, "--decrypt", "--output-type", "json", str(source)],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            env=sops_environment(environment),
            timeout=30,
            check=False,
        )
    except FileNotFoundError as error:
        raise list_error(missing_sops(environment)) from error
    except subprocess.TimeoutExpired as error:
        raise list_error("sops timed out while reading the term list; fix it with sops edit leak-terms.sops.yaml") from error
    except OSError as error:
        raise list_error("sops could not read the term list; fix it with sops edit leak-terms.sops.yaml") from error

    if completed.returncode == 128:
        raise list_error(
            "no age key can decrypt the term list; add this machine's age key to .sops.yaml "
            "above the YubiKey line and run sops updatekeys leak-terms.sops.yaml on a machine that can decrypt the list"
        )
    if completed.returncode != 0:
        raise list_error(
            f"the term list is not valid sops ({sops} exited {completed.returncode}); "
            "fix it with sops edit leak-terms.sops.yaml"
        )

    try:
        decoded = json.loads(completed.stdout.decode("utf-8", errors="surrogateescape"))
        terms_value = decoded["terms"] if isinstance(decoded, dict) else None
    except (KeyError, UnicodeDecodeError, json.JSONDecodeError) as error:
        raise list_error("the term list is not a block of lines; fix it with sops edit leak-terms.sops.yaml") from error
    if not isinstance(terms_value, str):
        raise list_error("the term list is not a block of lines; fix it with sops edit leak-terms.sops.yaml")
    terms = term_lines(terms_value)
    if not terms:
        raise list_error("the term list holds no term; add a term with sops edit leak-terms.sops.yaml")
    scoped_value = decoded.get("scoped", {})
    if not isinstance(scoped_value, dict) or not all(isinstance(block, str) for block in scoped_value.values()):
        raise list_error(
            "the scoped term lists are not a map of repository patterns to blocks of lines; "
            "fix it with sops edit leak-terms.sops.yaml"
        )
    scoped: list[tuple[Scope, list[str]]] = []
    for pattern, block in scoped_value.items():
        if not term_lines(block):
            raise list_error(f"the scoped term list {pattern} holds no term; fix it with sops edit leak-terms.sops.yaml")
        scoped.append((Scope(pattern, (pattern,)), term_lines(block)))
    if registry:
        scoped += knives_forbidden(environment)
    allowed_value = decoded.get("allowed", {})
    if not isinstance(allowed_value, dict) or not all(isinstance(block, str) for block in allowed_value.values()):
        raise list_error(
            "the allowed tokens are not a map of repository patterns to blocks of lines; "
            "fix it with sops edit leak-terms.sops.yaml"
        )
    allowed = [(pattern, term_lines(block)) for pattern, block in allowed_value.items()]
    return TermMatcher(
        terms,
        [(scope, listed) for scope, listed in scoped if scope.reaches(repositories)],
        allowed,
        # Where the text goes, when it is known: a push names one destination, so a token allowed there is no
        # match. gh text reaches every scope until its targets are read (gh_check), so it keeps the matches.
        None if not drop_allowed or tuple(repositories) == EVERY_REPOSITORY else repositories,
    )


@dataclass(frozen=True)
class Span:
    start: int
    end: int
    # The matched term's place in its list (1 for its first term, counting neither blank lines nor `#` lines), which
    # tells two terms of one list apart, and the label of a scoped list's Scope ("" for the list every repository has),
    # which a refusal names.
    term: int = field(default=0, compare=False)
    scope: str = field(default="", compare=False)
    # The repository patterns of the `allowed` tokens this match lies inside.
    allowed_in: tuple[str, ...] = field(default=(), compare=False)

    def allowed_for(self, repository: str) -> bool:
        """Whether an allowed token of REPOSITORY (`owner/name`) holds the match; a repository nobody could name has
        no allowed token."""
        return bool(repository) and any(fnmatch.fnmatchcase(repository.lower(), pattern.lower())
                                        for pattern in self.allowed_in)


def allowed_token(token: str) -> re.Pattern[str]:
    """An allowed token as it must stand in a text: exactly, letter case included, and whole, with no character of a
    name (a letter, a digit, `.`, `_`, `-`, `/`, or `@` before it) on either side, so `@scope/package` allows neither
    `@scope/other` nor `@scope/package-more`."""
    return re.compile(r"(?<![A-Za-z0-9._@/-])" + re.escape(token) + r"(?![A-Za-z0-9._/-])")


# What parts the words of a term: a run of any whitespace but a line feed, so a term whose words a no-break space,
# an en space (U+2002), a narrow no-break space (U+202F), an ideographic space (U+3000) or a line separator (U+2028)
# parts is still the term, in a ref name, a path or a code line. Until 2026-11-22 only spaces and tabs parted them, and
# a ref name holds no space, so a branch or tag named with such a term was pushed. A line feed never parts them: each
# line of a code file is read alone, and a prose run's line breaks are spaces in its paragraph view.
TERM_SEPARATOR = r"[^\S\n]+"


class TermMatcher:
    """Case-folded, whitespace-flexible matching while keeping source-string positions: a term's words match when any
    run of whitespace but a line feed (TERM_SEPARATOR) parts them. SCOPED holds (Scope, terms) for each scoped list
    read, and `scopes` maps each label to its Scope. A term two lists hold matches once for each, since each list says
    where its terms may not go. ALLOWED holds (repository pattern, tokens): a match inside such a token is not a term in
    that repository (a third-party name that holds one), and with REPOSITORIES, the places a text goes, a match every
    one of them allows is dropped; otherwise each match says where it is allowed."""

    def __init__(self, terms: Sequence[str], scoped: Sequence[tuple[Scope, Sequence[str]]] = (),
                 allowed: Sequence[tuple[str, Sequence[str]]] = (), repositories: Sequence[str] | None = None):
        patterns: list[tuple[re.Pattern[str], int, str]] = []
        seen: set[tuple[str, str]] = set()
        self.scopes = {scope.label: scope for scope, _ in scoped}
        for label, listed in (("", terms), *((scope.label, listed) for scope, listed in scoped)):
            for number, term in enumerate(listed, start=1):
                pieces = re.split(TERM_SEPARATOR, term.casefold())
                pattern = TERM_SEPARATOR.join(re.escape(piece) for piece in pieces)
                if pattern and (label, pattern) not in seen:
                    patterns.append((re.compile(pattern), number, label))
                    seen.add((label, pattern))
        self._patterns = patterns
        self._allowed = [(pattern, allowed_token(token)) for pattern, tokens in allowed for token in tokens]
        self._repositories = tuple(repositories) if repositories else ()

    @staticmethod
    def _origins(text: str) -> list[int]:
        """The index in TEXT of each character of text.casefold(): str.casefold folds each character on its own."""
        origins: list[int] = []
        for index, character in enumerate(text):
            origins.extend([index] * len(character.casefold()))
        return origins

    def spans(self, text: str) -> list[Span]:
        folded = text.casefold()
        matches = [
            (match, number, scope)
            for pattern, number, scope in self._patterns
            for match in pattern.finditer(folded)
            if match.start() != match.end()
        ]
        if not matches:
            return []
        # Only a text that holds a term pays for the per-character offset map and the allowed tokens.
        origins = self._origins(text)
        tokens = [(pattern, token.start(), token.end()) for pattern, regex in self._allowed
                  for token in regex.finditer(text)]
        found = []
        for match, number, scope in matches:
            start, end = origins[match.start()], origins[match.end() - 1] + 1
            allowed_in = tuple(sorted({pattern for pattern, first, last in tokens if first <= start and end <= last}))
            span = Span(start, end, number, scope, allowed_in)
            if self._repositories and all(span.allowed_for(repository) for repository in self._repositories):
                continue
            found.append(span)
        return sorted(found, key=lambda span: (span.start, span.end))


# The files whose lines are prose, which GitHub renders as paragraphs. Every other file is code, read a line at a time:
# code is not reflowed, and joining its lines would refuse words that no reader sees side by side.
PROSE_SUFFIXES = (".md", ".mdx", ".txt", ".rst")


def is_prose(path: str) -> bool:
    """Whether PATH names a prose file (PROSE_SUFFIXES, letter case ignored)."""
    return path.lower().endswith(PROSE_SUFFIXES)


def paragraph_view(text: str) -> str:
    """TEXT as GitHub renders prose, in a string of the same length: each whitespace character inside a paragraph is a
    space, so a term of several words that a soft line break, a CRLF or a no-break space splits matches, and each line
    break that begins or ends a blank line stays, so a term split over two paragraphs does not."""
    lines = re.sub(r"[^\S\n]", " ", text).split("\n")
    pieces = [lines[0]]
    for previous, line in zip(lines, lines[1:]):
        pieces += [" " if previous.strip() and line.strip() else "\n", line]
    return "".join(pieces)


def c_escape(text: str) -> str:
    """TEXT as one line a terminal shows as written: a backslash doubled, a line feed, a carriage return and a tab as
    `\\n`, `\\r` and `\\t`, any other ASCII control as `\\xNN`, and every other character str.isprintable refuses as
    `\\uNNNN` (`\\UNNNNNNNN` past U+FFFF): the C1 controls U+0080 to U+009F, which a terminal can take as a command
    (U+009B starts one), format characters such as U+202E, which reverses the text after it, separators other than the
    space (a no-break space, U+2028), and the bytes surrogateescape keeps (U+DC80 to U+DCFF)."""
    escaped: list[str] = []
    for character in text:
        if character == "\\":
            escaped.append("\\\\")
        elif character == "\n":
            escaped.append("\\n")
        elif character == "\r":
            escaped.append("\\r")
        elif character == "\t":
            escaped.append("\\t")
        elif ord(character) < 32 or ord(character) == 127:
            escaped.append(f"\\x{ord(character):02x}")
        elif character.isprintable():
            escaped.append(character)
        elif ord(character) <= 0xFFFF:
            escaped.append(f"\\u{ord(character):04x}")
        else:
            escaped.append(f"\\U{ord(character):08x}")
    return "".join(escaped)


# A refusal shows at most this many characters of the line on each side of a match, and at most MATCH_LIMIT of the match
# itself, so that one line of a minified file, of a one-line JSON body, or of a term whose words a long run of spaces
# parts stays readable.
EXCERPT_CONTEXT = 80
MATCH_LIMIT = 160
# How to clear a refusal, in every mode. The global list and each repository pattern's list are in leak-terms.sops.yaml;
# a `knives <entry>` list is that entry's forbidden list in knives's fork registry (knives_forbidden).
REMOVE_ADVICE = (
    "remove the term from the text, or if it is not private remove it from the list that holds it: sops edit "
    "leak-terms.sops.yaml for the global list (its terms block) or a repository pattern's list (its scoped block), and "
    "for a knives list the forbidden list of that entry in knives's repos.toml or repos.local.toml"
)


def list_name(scope: str) -> str:
    """The list a refusal names: the global list, which every repository has, or a scoped list by its Scope's label
    (`the cybermonklabs/* list`, `the knives oh-my-pi list`)."""
    return f"the {scope} list" if scope else "the global list"


def bounded(text: str, limit: int) -> str:
    """TEXT C-escaped, or when it is longer than LIMIT characters, its first and last LIMIT/2 around a `…`."""
    if len(text) <= limit:
        return c_escape(text)
    return c_escape(text[:limit // 2]) + "…" + c_escape(text[-(limit // 2):])


def excerpt(text: str, start: int, end: int) -> tuple[str, str]:
    """TEXT[START:END] as written, cut to MATCH_LIMIT characters (bounded), and the line it is on (the lines, for a match
    a line break splits), cut to EXCERPT_CONTEXT characters on each side of the match with `…` where it is cut; both
    C-escaped, so each is one line."""
    first = text.rfind("\n", 0, start) + 1
    last = text.find("\n", end)
    last = len(text) if last < 0 else last
    left, right = max(first, start - EXCERPT_CONTEXT), min(last, end + EXCERPT_CONTEXT)
    matched = bounded(text[start:end], MATCH_LIMIT)
    line = (("…" if left > first else "") + c_escape(text[left:start]) + matched + c_escape(text[end:right])
            + ("…" if right < last else ""))
    return matched, line


@dataclass(frozen=True)
class Finding:
    """One listed term a refusal names (dispatch://INFRA-4383, R2): PLACE names the file or field and the line, MATCHED
    is the text that matched as written, LINE the line it is on (excerpt), or None where PLACE is the matched name
    itself (a path, a ref, a tag's name), and SCOPE the list that holds the term (Span.scope). The caller wrote the
    text, so showing it copies nothing to a new place while every place a refusal reaches is the caller's own: no
    refusal may go to a public place (a post, a public CI job's log) while it shows the matched text."""

    place: str
    matched: str
    line: str | None
    scope: str

    def __str__(self) -> str:
        shown = f'{self.place}: "{self.matched}" ({list_name(self.scope)})'
        return shown if self.line is None else f"{shown}, in: {self.line}"


def name_findings(place: str, name: str, spans: Sequence[Span]) -> list[Finding]:
    """A Finding at PLACE, which shows NAME (a path, a ref, a tag's name) whole, for each of SPANS, the matches in it."""
    return [Finding(place, c_escape(name[span.start:span.end]), None, span.scope) for span in spans]


def line_findings(lines: Sequence[tuple[int, str]], matcher: TermMatcher, prose: bool,
                  place: Callable[[int], str]) -> list[Finding]:
    """A Finding for each listed term in LINES, (number, text) pairs in order, at the place PLACE gives the number of the
    line the match starts on: each line read alone, or for PROSE each run of lines with consecutive numbers read as
    paragraphs (paragraph_view). Until 2026-11-17 every line was read alone, so a term a wrapped line split went into a
    commit message or a Markdown file unread."""
    if not prose:
        return [Finding(place(number), *excerpt(line, span.start, span.end), span.scope)
                for number, line in lines for span in matcher.spans(line)]
    found: list[Finding] = []
    run: list[tuple[int, str]] = []

    def flush() -> None:
        if run:
            text = "\n".join(line for _, line in run)
            found.extend(Finding(place(run[0][0] + text.count("\n", 0, span.start)), *excerpt(text, span.start, span.end),
                                 span.scope)
                         for span in matcher.spans(paragraph_view(text)))
            run.clear()

    for number, line in lines:
        if run and number != run[-1][0] + 1:
            flush()
        run.append((number, line))
    flush()
    return found


def decode_c_quoted(value: str, start: int = 0) -> tuple[str, int] | None:
    """Decode Git's C-style quoted filename and return the next character index."""
    if start >= len(value) or value[start] != '"':
        return None
    raw = bytearray()
    index = start + 1
    while index < len(value):
        character = value[index]
        if character == '"':
            return raw.decode("utf-8", errors="surrogateescape"), index + 1
        if character != "\\":
            raw.extend(character.encode("utf-8", errors="surrogateescape"))
            index += 1
            continue
        index += 1
        if index >= len(value):
            return None
        escaped = value[index]
        simple = {"a": "\a", "b": "\b", "f": "\f", "n": "\n", "r": "\r", "t": "\t", "v": "\v"}
        if escaped in simple:
            raw.extend(simple[escaped].encode())
            index += 1
        elif escaped in {'"', "\\"}:
            raw.extend(escaped.encode())
            index += 1
        elif escaped in "01234567":
            digits = escaped
            index += 1
            for _ in range(2):
                if index < len(value) and value[index] in "01234567":
                    digits += value[index]
                    index += 1
                else:
                    break
            raw.append(int(digits, 8))
        else:
            raw.extend(escaped.encode("utf-8", errors="surrogateescape"))
            index += 1
    return None


def git_header_candidates(header: str) -> list[tuple[str, str]]:
    """Return every syntactically possible old/new path pair in a Git diff header."""
    value = header.removeprefix("diff --git ")
    first = decode_c_quoted(value)
    if first:
        old_path, index = first
        if index >= len(value) or value[index] != " ":
            return []
        second = decode_c_quoted(value, index + 1)
        if not second or second[1] != len(value):
            return []
        new_path, _ = second
        if old_path.startswith("a/") and new_path.startswith("b/"):
            return [(old_path[2:], new_path[2:])]
        return []

    if not value.startswith("a/"):
        return []
    candidates: list[tuple[str, str]] = []
    for delimiter in range(2, len(value)):
        if value.startswith(" b/", delimiter):
            candidates.append((value[2:delimiter], value[delimiter + 3:]))
    return candidates


def parse_git_header(candidates: Sequence[tuple[str, str]]) -> tuple[str, str] | None:
    """Extract the unchanged path pair only when the raw header's candidates prove it."""
    equal = [(old_path, new_path) for old_path, new_path in candidates if old_path == new_path]
    if len(equal) == 1:
        return equal[0]
    return None


def parse_diff_path(value: str, prefix: str) -> str | None:
    """Read one side of a --- or +++ line without accepting a timestamp."""
    if value == "/dev/null":
        return None
    quoted = decode_c_quoted(value)
    if quoted:
        path, index = quoted
        if index != len(value) and not value[index:].startswith("\t"):
            return None
    else:
        path = value.split("\t", 1)[0]
    if not path.startswith(prefix):
        return None
    return path[len(prefix):]


def parse_extended_path(value: str) -> str | None:
    """Read a path that fills the rest of its line: a rename or copy extended header."""
    quoted = decode_c_quoted(value)
    if quoted:
        path, index = quoted
        return path if index == len(value) else None
    return value or None


def parse_range(value: str) -> tuple[int, int] | None:
    matched = re.fullmatch(r"(\d+)(?:,(\d+))?", value)
    if not matched:
        return None
    return int(matched.group(1)), int(matched.group(2) or "1")


def parse_unified_hunk(line: str) -> tuple[tuple[int, int], tuple[int, int]] | None:
    matched = re.fullmatch(r"@@ -([^ ]+) \+([^ ]+) @@(?:.*)", line)
    if not matched:
        return None
    old_range = parse_range(matched.group(1))
    new_range = parse_range(matched.group(2))
    if old_range is None or new_range is None:
        return None
    return old_range, new_range


def header_end(lines: Sequence[str], start: int) -> int:
    """Find the next metadata line after a raw jj diff header.

    jj leaves filenames raw in ``diff --git`` headers, including literal newlines. Each extended header line git and
    jj print after ``diff --git`` is a marker. A combined diff's ``diff --cc`` and ``@@@`` lines are markers too, so
    the scan stops there and refuses them.
    """
    markers = ("diff --git ", "diff --cc ", "diff --combined ", "old mode ", "new mode ", "deleted file mode ",
               "new file mode ", "similarity index ", "dissimilarity index ", "rename from ", "rename to ",
               "copy from ", "copy to ", "index ", "--- ", "+++ ", "Binary files ", "GIT binary patch", "@@ ", "@@@ ")
    index = start + 1
    while index < len(lines) and not lines[index].startswith(markers):
        index += 1
    return index


@dataclass
class FileRecord:
    """One file of a diff: the paths its header proves, what its extended headers say, and its shown path."""

    path: str | None
    old_path: str | None
    candidates: list[tuple[str, str]]
    resolved: bool
    deleted: bool = False
    new_file: bool = False
    rename_from: str | None = None
    rename_to: str | None = None
    shown: str | None = None


def scan_diff(text: str, matcher: TermMatcher, place_prefix: str) -> list[Finding]:
    lines = newline_lines(text)
    findings: list[Finding] = []
    current: FileRecord | None = None

    def display_path(record: FileRecord) -> str:
        """The result path as a finding shows it, as written, built once per path."""
        if record.shown is None:
            assert record.path is not None
            record.shown = c_escape(record.path)
        return record.shown

    def finish(record: FileRecord | None) -> None:
        if record is None:
            return
        if not record.resolved:
            raise TextError("cannot resolve a result path from the diff header")
        if record.deleted:
            return
        assert record.path is not None
        path_spans = matcher.spans(record.path)
        if path_spans:
            findings.extend(name_findings(place_prefix + display_path(record), record.path, path_spans))

    def begin(header: str) -> FileRecord:
        candidates = git_header_candidates(header)
        pair = parse_git_header(candidates)
        return FileRecord(pair[1] if pair else None, pair[0] if pair else None, candidates, pair is not None)

    def resolve_rename(record: FileRecord) -> None:
        if record.rename_from is None or record.rename_to is None:
            return
        pair = (record.rename_from, record.rename_to)
        if record.candidates.count(pair) == 1:
            record.old_path, record.path = pair
            record.resolved = True
            record.shown = None

    def add_contents(record: FileRecord, added: Sequence[tuple[int, str]]) -> None:
        """A hunk's added lines, (new line number, text): a prose file's read as paragraphs, any other a line at a
        time (line_findings)."""
        if not added:
            return
        if not record.resolved:
            raise TextError("cannot resolve a result path from the diff header")
        assert record.path is not None
        findings.extend(line_findings(added, matcher, is_prose(record.path),
                                      lambda number: f"{place_prefix}{display_path(record)}:{number}"))

    def consume_unified(start: int, record: FileRecord) -> int:
        parsed = parse_unified_hunk(lines[start])
        if parsed is None:
            raise TextError("malformed unified hunk")
        (old_line, old_count), (new_line, new_count) = parsed
        old_seen = new_seen = 0
        added: list[tuple[int, str]] = []
        index = start + 1
        while index < len(lines):
            line = lines[index]
            if line.startswith(("diff --git ", "diff --cc ", "diff --combined ", "@@ ", "@@@ ")):
                break
            if line.startswith("\\ No newline at end of file"):
                index += 1
                continue
            if not line or line[0] not in "+- ":
                break
            marker, content = line[0], line[1:]
            if marker in "- ":
                old_seen += 1
            if marker in "+ ":
                new_seen += 1
                if marker == "+":
                    added.append((new_line, content))
                new_line += 1
            if old_seen > old_count or new_seen > new_count:
                raise TextError("malformed unified hunk count")
            index += 1
        if old_seen != old_count or new_seen != new_count:
            raise TextError("malformed unified hunk count")
        add_contents(record, added)
        return index

    def path_line_end(start: int, marker: str, prefix: str, expected_path: str | None) -> int | None:
        """The index after the --- or +++ line at START that names EXPECTED_PATH, else None. git C-quotes a path that
        holds a line feed (or a tab, a quote or a backslash) on one line, whatever core.quotePath says; jj writes it
        raw, over as many lines as it has line feeds. Until 2026-11-17 a path with a line feed was read only in jj's
        form, so every git commit of such a file was refused as "a result path does not match the diff header"."""
        if expected_path is None:
            return start + 1 if lines[start] == f"{marker}/dev/null" else None
        if parse_diff_path(lines[start].removeprefix(marker), prefix) == expected_path:
            return start + 1
        if "\n" not in expected_path:
            return None
        expected = f"{prefix}{expected_path}"
        pieces = expected.split("\n")
        if lines[start] != f"{marker}{pieces[0]}":
            return None
        if any(start + offset >= len(lines) or lines[start + offset] != piece for offset, piece in enumerate(pieces[1:], 1)):
            return None
        return start + len(pieces)


    index = 0
    while index < len(lines):
        line = lines[index]
        if line.startswith("diff --git "):
            finish(current)
            end = header_end(lines, index)
            current = begin("\n".join(lines[index:end]))
            index = end
            continue
        if line.startswith(("diff --cc ", "diff --combined ")):
            raise TextError(COMBINED_REFUSAL)
        if current is None:
            if line.startswith("@@"):
                raise TextError("hunk has no file header")
            index += 1
            continue
        if line.startswith("new file mode "):
            current.new_file = True
        elif line.startswith("deleted file mode "):
            if not current.resolved:
                raise TextError("cannot resolve a result path from the diff header")
            current.deleted = True
        elif line.startswith(("rename from ", "copy from ")):
            current.rename_from = parse_extended_path(line.split(" ", 2)[2])
            resolve_rename(current)
        elif line.startswith(("rename to ", "copy to ")):
            current.rename_to = parse_extended_path(line.split(" ", 2)[2])
            resolve_rename(current)
        elif line.startswith("--- "):
            end = path_line_end(index, "--- ", "a/", current.old_path)
            if not current.resolved or (end is None and not (current.new_file and line == "--- /dev/null")):
                raise TextError("a source path does not match the diff header")
            if end is not None:
                index = end
                continue
        elif line.startswith("+++ "):
            end = path_line_end(index, "+++ ", "b/", current.path)
            if not current.resolved or (end is None and not (current.deleted and line == "+++ /dev/null")):
                raise TextError("a result path does not match the diff header")
            if end is not None:
                index = end
                continue
        elif line.startswith("@@@"):
            raise TextError(COMBINED_REFUSAL)
        elif line.startswith("@@"):
            index = consume_unified(index, current)
            continue
        index += 1
    finish(current)
    return findings


def cleaned_message(text: str, cleanup: str, comment_char: str | None, cut_at_scissors: bool) -> list[str]:
    lines = newline_lines(text)
    needs_cut = bool(comment_char) and (cut_at_scissors or cleanup == "scissors")
    if needs_cut:
        cut_line = f"{comment_char} {SCISSORS}"
        for index, line in enumerate(lines):
            if line == cut_line:
                lines = lines[:index]
                break
    if cleanup == "verbatim":
        return lines

    stripped: list[str] = []
    for line in lines:
        value = line.rstrip(" \t\v\f\r")
        if cleanup == "strip" and comment_char and value.startswith(comment_char):
            continue
        stripped.append(value)

    while stripped and not stripped[0]:
        stripped.pop(0)
    while stripped and not stripped[-1]:
        stripped.pop()

    collapsed: list[str] = []
    previous_blank = False
    for line in stripped:
        blank = not line
        if blank and previous_blank:
            continue
        collapsed.append(line)
        previous_blank = blank
    return collapsed


def scan_message(text: str, matcher: TermMatcher, cleanup: str, comment_char: str | None, cut_at_scissors: bool,
                 place: str) -> list[Finding]:
    """A commit, tag or jj message, cleaned as git or jj cleans it, read as prose (line_findings)."""
    lines = cleaned_message(text, cleanup, comment_char, cut_at_scissors)
    return line_findings(list(enumerate(lines, start=1)), matcher, True, lambda number: f"{place} line {number}")


def print_findings(findings: Sequence[Finding]) -> None:
    for finding in findings:
        print(f"leak terms: {finding}", file=sys.stderr)
    print(f"leak terms: {REMOVE_ADVICE}", file=sys.stderr)


def rust_lines(text: str) -> list[str]:
    """Split text as Rust's str::lines(), including its CRLF normalization."""
    return [line.removesuffix("\r") for line in newline_lines(text)]


def clean_jj_description(lines: Sequence[str]) -> str:
    """Apply jj 0.46's cleanup_description_lines rules."""
    kept: list[str] = []
    for line in lines:
        if line.startswith("JJ: ignore-rest"):
            break
        if not line.startswith("JJ:"):
            kept.append(line)
    description = "\n".join(kept).strip("\n")
    return f"{description}\n" if description else ""


def jj_sections(text: str, mode: str, expected_ids: Sequence[str]) -> list[tuple[str | None, str]]:
    """Apply jj's single- or multi-description cleanup with validated bulk headers."""
    lines = rust_lines(text)
    if mode == "single":
        return [(None, clean_jj_description(lines))]
    if mode != "bulk" or not expected_ids or any(re.fullmatch(r"[0-9a-f]{12}", value) is None for value in expected_ids):
        raise ValueError("cannot read jj editor descriptions")

    expected = set(expected_ids)
    sections: list[tuple[str, list[str]]] = []
    current: list[str] | None = None
    current_id: str | None = None
    seen: set[str] = set()
    header = re.compile(r"JJ: describe ([0-9a-f]{12}) -------\Z")
    for line in lines:
        if line.startswith("JJ: describe "):
            matched = header.fullmatch(line)
            if matched is None or matched.group(1) not in expected or matched.group(1) in seen:
                raise ValueError("cannot read jj editor descriptions")
            if current is not None and current_id is not None:
                sections.append((current_id, current))
            commit_id: str = matched.group(1)
            current_id = commit_id
            current = []
            seen.add(commit_id)
        elif current is None:
            if line and not line.startswith("JJ:"):
                raise ValueError("cannot read jj editor descriptions")
        else:
            current.append(line)
    if current is not None and current_id is not None:
        sections.append((current_id, current))
    if seen != expected:
        raise ValueError("cannot read jj editor descriptions")
    return [(commit_id, clean_jj_description(section_lines)) for commit_id, section_lines in sections]


def rust_shlex_split(value: str) -> list[str] | None:
    """Copy shlex 2.0.1 token, comment, quote, and backslash handling."""
    words: list[str] = []
    index = 0
    length = len(value)
    while index < length:
        while index < length and value[index] in " \t\n":
            index += 1
        if index == length:
            break
        if value[index] == "#":
            newline = value.find("\n", index)
            index = length if newline < 0 else newline + 1
            continue
        word: list[str] = []
        while index < length:
            character = value[index]
            if character in " \t\n":
                break
            if character == "\\":
                index += 1
                if index == length:
                    return None
                if value[index] != "\n":
                    word.append(value[index])
                index += 1
                continue
            if character == "'":
                index += 1
                end = value.find("'", index)
                if end < 0:
                    return None
                word.append(value[index:end])
                index = end + 1
                continue
            if character == '"':
                index += 1
                while index < length and value[index] != '"':
                    if value[index] != "\\":
                        word.append(value[index])
                        index += 1
                        continue
                    index += 1
                    if index == length:
                        return None
                    escaped = value[index]
                    if escaped in '$`"\\':
                        word.append(escaped)
                    elif escaped != "\n":
                        word.extend(("\\", escaped))
                    index += 1
                if index == length:
                    return None
                index += 1
                continue
            word.append(character)
            index += 1
        words.append("".join(word))
    return words


def split_jj_command(value: str) -> list[str]:
    """Copy jj 0.46's CommandNameAndArgs string splitting without a shell."""
    if '"' in value or "'" in value:
        parsed = rust_shlex_split(value)
        if parsed is not None:
            return parsed
    return value.split(" ")


def jj_editor_listing(listing: str) -> str:
    """Return ui.editor's JSON value from `jj config list` NAME<TAB>JSON lines: a `ui.editor` line as jj gives it, or a
    table's `ui.editor.command` and `ui.editor.env.<NAME>` lines as {"env": …, "command": …}."""
    values: dict[str, str] = {}
    for line in newline_lines(listing):
        name, separator, value = line.partition("\t")
        if not separator:
            raise ValueError("could not read jj's configured editor")
        values[name] = value
    if list(values) == ["ui.editor"]:
        return values["ui.editor"]
    try:
        command = json.loads(values.pop("ui.editor.command"))
        environment = {}
        for name, value in values.items():
            if not name.startswith("ui.editor.env."):
                raise ValueError("could not read jj's configured editor")
            environment[name.removeprefix("ui.editor.env.")] = json.loads(value)
    except (KeyError, json.JSONDecodeError) as error:
        raise ValueError("could not read jj's configured editor") from error
    return json.dumps({"env": environment, "command": command}, separators=(",", ":"))


def jj_editor_configuration(value: str) -> tuple[list[str], dict[str, str] | None]:
    """Decode the JSON value of ui.editor (jj_editor_listing)."""
    try:
        configured = json.loads(value)
    except json.JSONDecodeError as error:
        raise ValueError("could not read jj's configured editor") from error
    environment: dict[str, str] | None = None
    if isinstance(configured, str):
        command = split_jj_command(configured)
    elif isinstance(configured, list) and configured and all(isinstance(item, str) for item in configured):
        command = list(configured)
    elif (
        isinstance(configured, dict)
        and isinstance(configured.get("env"), dict)
        and isinstance(configured.get("command"), list)
        and configured["command"]
        and all(isinstance(item, str) for item in configured["command"])
        and all(isinstance(key, str) and isinstance(item, str) for key, item in configured["env"].items())
    ):
        command = list(configured["command"])
        environment = dict(configured["env"])
    else:
        raise ValueError("could not read jj's configured editor")
    return command, environment


def jj_editor_command(value: str, path: str, line_number: int) -> tuple[list[str], dict[str, str] | None]:
    """Build the same command jj 0.46's TextEditor builds for the selected editor."""
    command, environment = jj_editor_configuration(value)
    variables = {"path": path, "line": str(line_number)}
    pattern = re.compile(r"\$([a-z0-9_]+)\b")
    path_in_arguments = any("path" in pattern.findall(argument) for argument in command[1:])

    def substitute(argument: str) -> str:
        return pattern.sub(lambda match: variables.get(match.group(1), match.group(0)), argument)

    command = [substitute(argument) for argument in command]
    if not path_in_arguments:
        command.append(path)
    return command, environment


def editor_is_wrapper(command: Sequence[str]) -> bool:
    """Return whether the resolved editor executable is this wrapper."""
    if not command:
        return True
    executable = command[0]
    candidate = Path(executable) if os.path.sep in executable else shutil.which(executable)
    if candidate is None:
        return False
    try:
        return Path(candidate).resolve() == Path(__file__).resolve()
    except OSError:
        return False


def jj_editor_preflight(listing: str) -> int:
    """Print the ui.editor setting that runs this wrapper, then the configured editor's JSON value for
    DOTFILES_JJ_EDITOR. A configuration that cannot be read, or an editor that is this wrapper, prints nothing."""
    try:
        value = jj_editor_listing(listing)
        command, _ = jj_editor_configuration(value)
    except ValueError:
        return EDITOR_UNREADABLE_EXIT
    if editor_is_wrapper(command):
        return EDITOR_WRAPPER_EXIT
    print("ui.editor=" + json.dumps([str(Path(__file__).resolve()), "jj-editor"]))
    print(value)
    return 0


def jj_editor(path: str) -> int:
    """Run jj's selected editor, then inspect its cleaned descriptions."""
    if os.environ.get(EDITOR_GUARD):
        print("leak terms: recursive jj editor wrapper refused", file=sys.stderr)
        return LIST_EXIT
    try:
        text = Path(path).read_text(encoding="utf-8")
    except OSError as error:
        print(f"leak terms: cannot read jj editor file: {error}", file=sys.stderr)
        return 1
    line_number = 1
    for line in rust_lines(text):
        if not line.startswith("JJ:"):
            break
        line_number += 1
    configured = os.environ.get("DOTFILES_JJ_EDITOR")
    if configured is None:
        print("leak terms: cannot read jj's configured editor", file=sys.stderr)
        return 1
    try:
        command, configured_environment = jj_editor_command(configured, path, line_number)
    except ValueError as error:
        print(f"leak terms: {error}", file=sys.stderr)
        return 1
    if editor_is_wrapper(command):
        print("leak terms: recursive jj editor wrapper refused", file=sys.stderr)
        return LIST_EXIT
    try:
        matcher = load_terms()
    except ListError as error:
        print(error, file=sys.stderr)
        return 1

    environment = {**os.environ, **(configured_environment or {}), EDITOR_GUARD: "1"}
    try:
        completed = subprocess.run(command, env=environment, check=False)
    except OSError as error:
        print(f"leak terms: could not run jj editor: {error}", file=sys.stderr)
        return 1
    if completed.returncode < 0:
        os.kill(os.getpid(), -completed.returncode)
    if completed.returncode:
        return completed.returncode

    try:
        edited = Path(path).read_text(encoding="utf-8")
    except (OSError, UnicodeError) as error:
        print(f"leak terms: cannot read jj editor file: {error}", file=sys.stderr)
        return 1
    mode = os.environ.get("DOTFILES_JJ_EDITOR_MODE", "single")
    expected_ids = [value for value in os.environ.get("DOTFILES_JJ_EDITOR_IDS", "").split(",") if value]
    try:
        sections = jj_sections(edited, mode, expected_ids)
    except ValueError:
        print("leak terms: cannot read jj editor descriptions", file=sys.stderr)
        return 1
    findings: list[Finding] = []
    for commit_id, description in sections:
        place = "commit message" if commit_id is None else f"description of {commit_id}"
        findings.extend(scan_message(description, matcher, "verbatim", None, False, place))
    if not findings:
        return 0
    print_findings(findings)
    return 1

# git 2.43's candidate order for core.commentChar=auto (builtin/commit.c).
COMMENT_CANDIDATES = "#;@!$%^&|:"
TRAILER_LINE = re.compile(r"[A-Za-z0-9][A-Za-z0-9-]*[ \t]*:")


def adjust_comment_line_char(text: str) -> str | None:
    """Copy git 2.43's adjust_comment_line_char: a line starts after \\n or \\r."""
    if "#" not in text:
        return "#"
    blocked = set()
    if text and text[0] in COMMENT_CANDIDATES:
        blocked.add(text[0])
    for index, character in enumerate(text[:-1]):
        if character in "\n\r" and text[index + 1] in COMMENT_CANDIDATES:
            blocked.add(text[index + 1])
    return next((candidate for candidate in COMMENT_CANDIDATES if candidate not in blocked), None)


def git_block_character(lines: Sequence[str], candidate: str) -> bool:
    """Whether lines end with a block git wrote in candidate, as git writes its status.

    git writes a blank line, then lines that each start with its character; only blank lines
    and trailers (`Token: value`, which interpret-trailers may append) follow. A character
    that starts a line of the message fails, because git's own lines follow that line.
    """
    first = next((index for index, line in enumerate(lines) if line.startswith(candidate)), None)
    if first is None or first == 0 or lines[first - 1] != "":
        return False
    return all(
        line.startswith(candidate) or line == "" or TRAILER_LINE.match(line) is not None
        for line in lines[first:]
    )


def git_comment_char(text: str, editor_ran: bool, status_shown: bool, cut_line_written: bool) -> str | None:
    """Return the character git 2.43 chose for core.commentChar=auto, or None when unsure.

    Without the editor or the status, git wrote nothing into the file, so the file is the
    text git chose from. Otherwise git's comment block follows the message: when git wrote
    its cut line (scissors or verbose, two lines with both), every cut line in the file must
    have one character, which is git's; else exactly one candidate must end the file as git's
    block. None reads every line.
    """
    if not (editor_ran and status_shown):
        return adjust_comment_line_char(text)
    lines = newline_lines(text)
    if cut_line_written:
        cut = {line[0] for line in lines if line[:1] in tuple(COMMENT_CANDIDATES) and line[1:] == f" {SCISSORS}"}
        return cut.pop() if len(cut) == 1 else None
    found = [candidate for candidate in COMMENT_CANDIDATES if git_block_character(lines, candidate)]
    return found[0] if len(found) == 1 else None


def read_stdin(encoding: str = "utf-8") -> str:
    try:
        return sys.stdin.buffer.read().decode(encoding, errors="surrogateescape")
    except (LookupError, UnicodeDecodeError) as error:
        raise TextError(f"cannot decode standard input as {encoding}") from error
    except OSError as error:
        raise TextError("could not read standard input") from error


OBJECT_ID = re.compile(r"[0-9A-Fa-f]{40,64}\Z")
TRANSPORT_URL = re.compile(r"[A-Za-z][A-Za-z0-9+.-]*::")


# The variables that change how git reads a pathspec, which `git --literal-pathspecs` and its siblings export to every
# git a command runs, the pre-push hook's included (Magit passes --literal-pathspecs by default). The check names files
# by `:(literal)` pathspecs (pathspec_chunks); under GIT_LITERAL_PATHSPECS git reads that magic as part of the name, so
# no file matches, and a push the record covers in part was refused as "malformed commit boundaries".
PATHSPEC_VARIABLES = ("GIT_LITERAL_PATHSPECS", "GIT_GLOB_PATHSPECS", "GIT_NOGLOB_PATHSPECS", "GIT_ICASE_PATHSPECS")


def git_environment() -> dict[str, str]:
    """Disable replacement and system attributes so Git scans the objects it publishes, and leave out the caller's
    pathspec settings (PATHSPEC_VARIABLES).

    Lazy fetch stays on for the reads of what a push sends: they need each object's bytes, so with it off an object a
    partial clone lacks would stop the check and refuse a clean push (git's diff fetches a commit's missing files in one
    request). Only the reads that ask what the clone holds turn it off (local_object_ids, listed_objects)."""
    environment = {name: value for name, value in os.environ.items() if name not in PATHSPEC_VARIABLES}
    return {**environment, "GIT_NO_REPLACE_OBJECTS": "1", "GIT_ATTR_NOSYSTEM": "1"}

@lru_cache(maxsize=1)
def pushing_repository_commit_encoding() -> bytes | None:
    """The configured fallback for an outgoing message that Git left in its original bytes; None when none is
    configured or git's configuration cannot be read, since a message is then read in Latin-1 too (git_texts)."""
    try:
        completed = subprocess.run(
            ["git", "config", "--get", "i18n.commitEncoding"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            env=git_environment(),
            check=False,
        )
    except OSError:
        return None
    if completed.returncode != 0:
        return None
    return completed.stdout.removesuffix(b"\n")


# What iconv_open and iconv return on failure: (iconv_t) -1 and (size_t) -1.
ICONV_FAILED = ctypes.c_void_p(-1).value
ICONV_ERROR = ctypes.c_size_t(-1).value
# The most UTF-8 bytes iconv_reencode lets one input byte become, so no encoding value can grow memory without bound.
# Of glibc 2.39's 1,180 charset names, the most any single byte becomes is 12 (TSCII 0x82, four Tamil characters);
# a conversion that needs more is dropped, and the bytes are read as they are (git_texts).
ICONV_GROWTH = 16
# The input bytes iconv_reencode gives iconv per call, and the most bytes of an unfinished sequence (EINVAL) carried
# into the next call. Its one output buffer holds ICONV_GROWTH bytes for each, so a call never stops for lack of
# room: no buffer is sized from the whole input.
ICONV_PIECE = 1 << 16
ICONV_CARRY = 16


@lru_cache(maxsize=1)
def c_iconv() -> ctypes.CDLL:
    """The C library's iconv_open, iconv and iconv_close, typed: glibc's, the converter git calls (utf8.c
    reencode_string_len), found in this process as git finds it. Every machine this check runs on uses glibc, whose
    libc holds iconv (agentbox/Dockerfile is FROM ubuntu:24.04, sami-devbox runs glibc 2.39, and laptop/install.sh
    sets up Ubuntu or Pop!_OS), so no other library is looked for. A TextError when it is missing: the check cannot
    read what git shows."""
    library = ctypes.CDLL(None, use_errno=True)
    try:
        library.iconv_open.restype = ctypes.c_void_p
    except AttributeError as error:
        raise TextError("the C library has no iconv to read an encoded commit or tag") from error
    library.iconv_open.argtypes = [ctypes.c_char_p, ctypes.c_char_p]
    pointer = ctypes.POINTER(ctypes.c_char_p)
    size = ctypes.POINTER(ctypes.c_size_t)
    library.iconv.restype = ctypes.c_size_t
    library.iconv.argtypes = [ctypes.c_void_p, pointer, size, pointer, size]
    library.iconv_close.argtypes = [ctypes.c_void_p]
    return library


def git_same_utf_encoding(one: bytes, other: bytes) -> bool:
    """git's same_utf_encoding (utf8.c): both names start with `utf`, in any case, and are the same past it and one
    optional `-`."""
    one, other = one.lower(), other.lower()
    return (one.startswith(b"utf") and other.startswith(b"utf")
            and one[3:].removeprefix(b"-") == other[3:].removeprefix(b"-"))


def iconv_reencode(data: bytes, encoding: bytes) -> str | None:
    """DATA converted to UTF-8 from ENCODING: the text one iconv conversion over all of it gives, with git's name
    handling (utf8.c reencode_string_len, git 2.43): iconv_open is given the encoding exactly as written, up to a NUL
    as C reads it, `UTF-16LE-BOM` is read as `UTF-16`, and when iconv_open refuses, a UTF-8 spelling is retried as
    `UTF-8` and `latin-1` as `ISO-8859-1`. None where git shows the bytes as they are: iconv_open refuses the name, or
    the bytes hold a sequence the charset cannot convert, or the text would pass ICONV_GROWTH UTF-8 bytes per input
    byte. git's own text differs for TSCII, as glibc resumes a TSCII byte wrongly after git's conversion stops for lack
    of room (the comment in the body below); this returns one call's text.

    This replaces a regular expression that guessed glibc's name parser and missed forms git converts (`UTF-7
    //TRANSLIT`, `UTF-7/ /x`, the review of INFRA-4943), and the iconv program, which reads a name that holds `/` as
    the path of a charmap file: `encoding /dev/zero` read until a 30 s timeout. iconv_open reads no file: it refuses
    `/dev/zero` at once. On sami-devbox (glibc 2.39, git 2.43) iconv_open opened exactly the forms git converted, of 20
    spellings of UTF-7 (18; `UTF-7/x` and `/UTF-7` neither converts) and 2 paths (neither); Python's codecs, which this
    no longer uses, read names git does not convert, such as `utf_16_le` and `latin_1`."""
    name = encoding.split(b"\0", 1)[0]
    if git_same_utf_encoding(b"UTF-16LE-BOM", name):
        name = b"UTF-16"
    library = c_iconv()
    handle = library.iconv_open(b"UTF-8", name)
    if handle in (None, ICONV_FAILED):
        fallback = b"UTF-8" if git_same_utf_encoding(b"utf-8", name) else \
            b"ISO-8859-1" if name.lower() == b"latin-1" else name
        handle = library.iconv_open(b"UTF-8", fallback)
    if handle in (None, ICONV_FAILED):
        return None
    try:
        # glibc's TSCII converter resumes a byte that becomes several characters wrongly after it stops with E2BIG
        # (8 MiB of byte 0x82 through 1 MiB output pieces gave 792 of 33,554,432 characters unlike one call's text, the
        # reviews of INFRA-4943), so a call is given only as much input as the buffer holds the output of. A piece that
        # ends inside a multibyte sequence stops before it with EINVAL, and the next piece starts with it; iconv keeps
        # any shift state between calls. Fed so, 9,000 random inputs in TSCII, UTF-7, ISO-2022-JP, UTF-16LE, UTF-8 and
        # IBM1047 through 1-to-64-byte pieces, and the 8 MiB sample, gave one call's text. git itself goes on after
        # E2BIG, and so shows TSCII text like that damage (`git log --format=%B` of ten 0x82 bytes is not one call's
        # text); no ASCII character changed in any measured case. Each piece is decoded as it comes: memory is the
        # decoded pieces and their join, each the size of the text.
        limit = ICONV_GROWTH * len(data) + 64
        out = ctypes.create_string_buffer(ICONV_GROWTH * (min(ICONV_PIECE, len(data)) + ICONV_CARRY) + 64)
        decoder = codecs.getincrementaldecoder("utf-8")()
        pieces: list[str] = []
        produced = carried = 0
        left = len(data)
        source = ctypes.c_char_p(data)
        while True:
            take = min(left, ICONV_PIECE + carried)
            source_left = ctypes.c_size_t(take)
            target, target_left = ctypes.cast(out, ctypes.c_char_p), ctypes.c_size_t(len(out))
            failed = library.iconv(handle, ctypes.byref(source), ctypes.byref(source_left), ctypes.byref(target),
                                   ctypes.byref(target_left)) == ICONV_ERROR
            unfinished = failed and ctypes.get_errno() == errno.EINVAL
            left -= take - source_left.value
            carried = source_left.value
            used = len(out) - target_left.value
            produced += used
            # EILSEQ, E2BIG past the growth cap, or a sequence still unfinished at the end of the input (git shows the
            # bytes then), or one longer than ICONV_CARRY.
            more_follows = left > carried
            carry_fits = carried <= ICONV_CARRY
            if failed and not (unfinished and more_follows and carry_fits) or produced > limit:
                return None
            pieces.append(decoder.decode(ctypes.string_at(out, used), final=left == 0))
            if left == 0:
                return "".join(pieces)
    except UnicodeDecodeError:
        return None
    finally:
        library.iconv_close(handle)


def decode_git_message(message: bytes, declared_encoding: bytes | None = None) -> str | None:
    """A Git message or header as git converts it: from its declared encoding (iconv_reencode, whose docstring says
    where git's own text differs), else UTF-8 as it is, else converted from the pushing repository's configured
    encoding. None when none of these gives text."""
    if declared_encoding is not None:
        return iconv_reencode(message, declared_encoding)
    try:
        return message.decode("utf-8")
    except UnicodeDecodeError:
        configured = pushing_repository_commit_encoding()
        return None if configured is None else iconv_reencode(message, configured)


def git_output(arguments: Sequence[str], standard_input: bytes, failure: str) -> bytes:
    """Run one Git producer and fail closed, naming it with FAILURE, when it cannot provide complete output."""
    try:
        completed = subprocess.run(
            ["git", *arguments],
            input=standard_input,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            env=git_environment(),
            check=False,
        )
    except OSError as error:
        raise TextError(failure) from error
    if completed.returncode:
        raise TextError(failure)
    return completed.stdout


def git_chunks(arguments: Sequence[str], standard_input: bytes) -> Iterator[bytes]:
    """Yield one Git producer's output without collecting every outgoing diff."""
    try:
        process = subprocess.Popen(
            ["git", *arguments],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            env=git_environment(),
        )
    except OSError as error:
        raise TextError("could not run git while reading outgoing commits") from error
    assert process.stdin is not None
    assert process.stdout is not None
    stdin, stdout = process.stdin, cast(io.BufferedReader, process.stdout)
    write_errors: list[OSError] = []

    def write_input() -> None:
        try:
            stdin.write(standard_input)
        except BrokenPipeError:
            pass
        except OSError as error:
            write_errors.append(error)
        finally:
            try:
                stdin.close()
            except OSError as error:
                write_errors.append(error)

    writer = threading.Thread(target=write_input)
    writer.start()
    try:
        while chunk := stdout.read1(65536):
            yield chunk
    finally:
        stdout.close()
        writer.join()
        status = process.wait()
    if write_errors or status:
        raise TextError("git could not read outgoing commits")


def push_updates(text: str) -> tuple[list[tuple[str, str]], list[str]]:
    """Read Git's pre-push updates: each sent object with the remote ref it goes to, and the remote's prior objects.
    git writes each update as four fields joined by one space. A ref name holds no ASCII space, but it can hold a
    no-break space or a line separator, which str.split() also splits at, so a push of such a ref was refused as
    "malformed pre-push update" (exit 4); the line is split at spaces alone."""
    local: list[tuple[str, str]] = []
    remote: list[str] = []
    for line in newline_lines(text):
        fields = line.split(" ")
        if len(fields) != 4 or not OBJECT_ID.fullmatch(fields[1]) or not OBJECT_ID.fullmatch(fields[3]):
            raise TextError("malformed pre-push update")
        if set(fields[1]) != {"0"}:
            local.append((fields[2], fields[1]))
        if set(fields[3]) != {"0"}:
            remote.append(fields[3])
    return local, remote


def push_destination(remote: str, url: str) -> str:
    """Use the same transport for advertisement reads that Git uses for the push."""
    if TRANSPORT_URL.match(url):
        return url
    try:
        configured = subprocess.run(
            ["git", "config", "--get", f"remote.{remote}.vcs"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            env=git_environment(),
            check=False,
        )
    except OSError as error:
        raise TextError("could not read the push transport") from error
    if configured.returncode == 0:
        helper = configured.stdout.decode("utf-8", errors="surrogateescape").strip()
        if helper:
            return f"{helper}::{url}"
    elif configured.returncode != 1:
        raise TextError("could not read the push transport")
    return url


# git's message, untranslated under LC_ALL=C, when a read with lazy fetch off needs an object the clone lacks and an
# object the clone received from its promisor names it (local_object_ids).
PROMISOR_NAMED_MISSING = re.compile(
    r"^fatal: could not fetch ([0-9a-f]{40}(?:[0-9a-f]{24})?) from promisor remote$", re.M
)


def local_object_ids(candidates: Sequence[str]) -> set[str]:
    """Return the advertised IDs that this repository actually has, as a full clone with the same refs has them.

    git is asked with lazy fetch off (GIT_NO_LAZY_FETCH=1). With it on, in a partial clone, each advertised ID the clone
    lacks started its own fetch from the promisor, each carrying the whole history that ID reaches: on 2026-11-21 a push
    through the shims from a blobless clone stalled for many minutes that way, as the shared leak check did before
    dispatch://INFRA-4682. A fetched ID also counted as held where a full clone holds nothing. An ID the clone lacks
    excludes nothing, so more is scanned, never less.

    A git that carries the variable only with its CVE-2024-32465 fix (Ubuntu 24.04's 1:2.43.0-1ubuntu7.4) reads such an
    ID as missing too, unless an object the clone received from its promisor names it (an older commit's file, a
    submodule's commit): then git stops with exit 128 and `fatal: could not fetch <id> from promisor remote` after the
    answers for the IDs before it (dispatch://INFRA-4891, dispatch://INFRA-4945). The clone lacks that ID, so it is not
    held, and the read goes on from the next one. Any other failure refuses."""
    pending = list(dict.fromkeys(candidates))
    held: set[str] = set()
    environment = {**git_environment(), "GIT_NO_LAZY_FETCH": "1", "LC_ALL": "C"}
    failure = "git could not check which advertised objects this repository holds"
    while pending:
        try:
            completed = subprocess.run(
                ["git", "cat-file", "--batch-check=%(objectname) %(objecttype)"],
                input=("\n".join(pending) + "\n").encode(),
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                env=environment,
                check=False,
            )
        except OSError as error:
            raise TextError(failure) from error
        lines = completed.stdout.decode("utf-8", errors="surrogateescape").split("\n")
        # Each answer ends with a newline, so the last piece is empty unless an answer was cut off.
        if lines.pop() != "" or len(lines) > len(pending):
            raise TextError("git gave an incomplete object advertisement")
        for candidate, line in zip(pending, lines):
            fields = line.split()
            if len(fields) < 2 or not OBJECT_ID.fullmatch(fields[0]):
                raise TextError("git gave a malformed object advertisement")
            if fields[1] != "missing":
                held.add(candidate)
        if completed.returncode == 0:
            if len(lines) != len(pending):
                raise TextError("git gave an incomplete object advertisement")
            return held
        named = PROMISOR_NAMED_MISSING.findall(completed.stderr.decode("utf-8", errors="surrogateescape"))
        if completed.returncode != 128 or len(lines) == len(pending) or named != [pending[len(lines)].lower()]:
            raise TextError(failure)
        pending = pending[len(lines) + 1 :]
    return held


def remote_advertisement(destination: str) -> list[str]:
    """Read all refs advertised by the exact transport Git will use to push."""
    output = git_output(["ls-remote", "--", destination], b"", "git could not read the destination's advertised refs")
    object_ids: list[str] = []
    for line in output.decode("utf-8", errors="surrogateescape").splitlines():
        fields = line.split("\t", 1)
        if len(fields) != 2 or not OBJECT_ID.fullmatch(fields[0]):
            raise TextError("git gave a malformed remote advertisement")
        object_ids.append(fields[0])
    return object_ids


def outgoing_commit_ids(local: Sequence[str], held: Sequence[str]) -> list[str]:
    """List exactly the commits sent to this destination, preserving Git's topo order."""
    revisions = [*local]
    if held:
        revisions.extend(("--not", *held))
    output = git_output(
        ["rev-list", "--topo-order", "--stdin"], ("\n".join(revisions) + "\n").encode(), "git could not list the outgoing commits"
    )
    commits = output.decode("ascii", errors="strict").splitlines()
    if any(OBJECT_ID.fullmatch(commit) is None for commit in commits):
        raise TextError("git gave a malformed outgoing commit list")
    return commits


def listed_objects(revisions: Sequence[str], failure: str, malformed: str) -> set[str]:
    """Every object REVISIONS reach, as the folders this repository holds name them, in one Git call.

    `--missing=print` turns lazy fetch off and lists an object the clone lacks (a partial clone's file) as `?<id>`, so
    its ID counts as it does in a full clone. Without it, rev-list fetched each such object from the promisor, one at a
    time, and with GIT_NO_LAZY_FETCH=1 alone it stops at the first one."""
    output = git_output(
        ["rev-list", "--objects", "--no-object-names", "--missing=print", "--stdin"],
        ("\n".join(revisions) + "\n").encode(),
        failure,
    )
    try:
        objects = [line.removeprefix("?") for line in output.decode("ascii").splitlines()]
    except UnicodeDecodeError as error:
        raise TextError(malformed) from error
    if any(OBJECT_ID.fullmatch(object_id) is None for object_id in objects):
        raise TextError(malformed)
    return set(objects)


def outgoing_commit_object_ids(commits: Sequence[str], held: Sequence[str]) -> set[str]:
    """The objects reachable from sent commits, but only after a direct file or folder object needs this distinction."""
    if not commits:
        return set()
    revisions = [*commits]
    if held:
        revisions.extend(("--not", *held))
    return listed_objects(
        revisions, "git could not list the outgoing commit objects", "git gave a malformed outgoing commit object list"
    )


def destination_object_ids(held: Sequence[str]) -> set[str]:
    """Every object reachable from a destination ref, as the folders this repository holds name them."""
    if not held:
        return set()
    return listed_objects(
        held, "git could not list the destination's objects", "git gave a malformed destination object list"
    )


def newline_records(chunks: Iterator[bytes]) -> Iterator[bytes]:
    """Yield newline-delimited byte records while joining each growing record only once."""
    pieces: list[bytes] = []
    for chunk in chunks:
        start = 0
        while True:
            boundary = chunk.find(b"\n", start)
            if boundary < 0:
                if start < len(chunk):
                    pieces.append(chunk[start:])
                break
            pieces.append(chunk[start:boundary])
            yield b"".join(pieces)
            pieces.clear()
            start = boundary + 1
    if pieces:
        yield b"".join(pieces)


@dataclass
class DiffHunk:
    """The remaining old and new lines that make a streamed diff hunk unambiguous."""

    old: int
    new: int


def hunk_start(line: bytes) -> DiffHunk | None:
    """Return the hunk counts for LINE, refusing a malformed hunk header and a combined one."""
    if line.startswith(b"@@@"):
        raise TextError(f"git gave {COMBINED_REFUSAL}")
    if line.startswith(b"@@ "):
        parsed = parse_unified_hunk(line.decode("utf-8", errors="surrogateescape"))
        if parsed is None:
            raise TextError("git gave a malformed unified hunk")
        (_, old), (_, new) = parsed
        return DiffHunk(old, new) if old or new else None
    return None


def consume_hunk_line(line: bytes, hunk: DiffHunk) -> DiffHunk | None:
    """Consume one physical diff line, returning None only after its declared counts end."""
    if line.startswith(b"\\ No newline at end of file"):
        return hunk
    if not line or line[0] not in b"+- ":
        raise TextError("git gave a malformed unified hunk")
    marker = line[0]
    if marker in b"- ":
        hunk.old -= 1
    if marker in b"+ ":
        hunk.new -= 1
    if hunk.old < 0 or hunk.new < 0:
        raise TextError("git gave a malformed unified hunk count")
    return None if hunk.old == 0 and hunk.new == 0 else hunk


def outgoing_diff_records(chunks: Iterator[bytes]) -> Iterator[tuple[str, bytes]]:
    """Frame `git log --format=commit %H` output without trusting bytes inside a diff hunk."""
    current: str | None = None
    diff = bytearray()
    hunk: DiffHunk | None = None
    for line in newline_records(chunks):
        if hunk is None:
            boundary = re.fullmatch(rb"commit ([0-9A-Fa-f]{40,64})", line)
            if boundary:
                if current is not None:
                    yield current, bytes(diff)
                current = boundary.group(1).decode("ascii")
                diff.clear()
                continue
        if current is None:
            if line:
                raise TextError("git gave malformed commit boundaries")
            continue
        diff.extend(line)
        diff.append(ord("\n"))
        if hunk is None:
            hunk = hunk_start(line)
        else:
            hunk = consume_hunk_line(line, hunk)
    if hunk is not None:
        raise TextError("git gave a malformed diff hunk count")
    if current is not None:
        yield current, bytes(diff)


def empty_attribute_tree() -> str:
    """Create the empty tree Git uses as an attribute source without changing refs or the index."""
    output = git_output(["mktree"], b"", "git could not create an empty attribute tree")
    try:
        value = output.decode("ascii")
    except UnicodeDecodeError as error:
        raise TextError("git gave an invalid empty attribute tree") from error
    tree = value.removesuffix("\n")
    if value != f"{tree}\n" or OBJECT_ID.fullmatch(tree) is None:
        raise TextError("git gave an invalid empty attribute tree")
    return tree


def info_attributes_present() -> bool:
    """Report whether this repository has the one higher-precedence attribute source Git cannot disable."""
    output = git_output(["rev-parse", "--git-path", "info/attributes"], b"", "git could not read info attributes")
    path = Path(output.decode("utf-8", errors="surrogateescape").removesuffix("\n"))
    try:
        return path.exists() and path.stat().st_size > 0
    except OSError as error:
        raise TextError("git could not read info attributes") from error


# A commit's or tag's header goes to the destination with its message (dispatch://INFRA-4943): `git log`, the
# repository's web page and every clone show a commit's author and committer and a tag's tagger, by name and e-mail
# address. Until 2026-11-21 a push read the messages alone, so a listed term in an author's or committer's name or
# e-mail went to a public repository. An identity is `<name> <<e-mail>> <seconds> <zone>`; the seconds and the zone
# are not read, and an identity that does not end in them is read whole.
IDENTITY_HEADERS = frozenset((b"author", b"committer", b"tagger"))
IDENTITY_DATE = re.compile(rb" [0-9]+ [+-][0-9]{4}\Z")
# A header whose value is one object id holds nothing anyone wrote; with any other value it is read.
OBJECT_ID_HEADERS = frozenset((b"tree", b"parent", b"object"))
# A commit's or tag's signature header, `gpgsig` or `gpgsig-sha256` with its continuation lines, is not read: git signs
# with gpg or ssh-keygen, which write base64, and sami-devbox's git config signs every commit (commit.gpgsign=true,
# gpg.format=ssh). A hand-made object can carry other words there; those are not read either.
SIGNATURE_HEADERS = frozenset((b"gpgsig", b"gpgsig-sha256"))
# The outgoing commit objects one `cat-file --batch` call reads.
COMMIT_BATCH = 1000


def git_texts(raw: bytes, encoding: bytes | None) -> list[str]:
    """A commit's or tag's message or header bytes as every text a reader may be shown: the bytes read as UTF-8, each
    byte that does not decode kept (surrogateescape), and, when it gives other text, the text as git converts it
    (decode_git_message: converted by the C library's iconv from the declared ENCODING, else from the repository's
    configured encoding; iconv_reencode says where git's own text differs), else, when git shows the bytes as they
    are, the bytes read as Latin-1, which decodes every byte. The declared decode alone hid a term: UTF-8 bytes under
    `encoding UTF-16LE` or `encoding cp500` decode with no error to other characters, though `git log --format=%an`
    showed the term (the review of INFRA-4943). No encoding, known or not, refuses the push: a message that is not
    UTF-8 and names no encoding git can convert, which once refused the push unread, is read in Latin-1, so a term
    with a non-ASCII letter in it is still found. Each header line and the message are converted apart, where git
    converts the object whole: a sequence that fails in one piece leaves git showing every piece as bytes and here only
    that one, and a stateful charset (ISO-2022-JP) whose shift a hand-made object carries over a line end reads
    differently in the next piece here."""
    texts = [raw.decode("utf-8", errors="surrogateescape")]
    declared = decode_git_message(raw, encoding)
    if declared is None:
        declared = raw.decode("latin-1")
    return texts if declared == texts[0] else [*texts, declared]


def texts_findings(texts: Sequence[str], read: Callable[[str], list[Finding]]) -> list[Finding]:
    """READ's findings in each of TEXTS (git_texts), a match an earlier text gave at the same place named once."""
    found: list[Finding] = []
    for text in texts:
        known = {(finding.place, finding.matched, finding.scope) for finding in found}
        found.extend(finding for finding in read(text) if (finding.place, finding.matched, finding.scope) not in known)
    return found


def header_line_findings(number: int, raw: bytes, encoding: bytes | None, place: Callable[[int], str],
                         matcher: TermMatcher) -> list[Finding]:
    """The listed terms in one header line, RAW, line NUMBER, in each text git_texts gives, at PLACE(NUMBER)."""
    return texts_findings(git_texts(raw, encoding), lambda text: line_findings([(number, text)], matcher, False, place))


def header_fields(header: bytes) -> list[list[tuple[int, bytes]]]:
    """A raw header's fields in order, each its lines as (line number, line): the line that names the field, then its
    continuation lines, which start with a space."""
    fields: list[list[tuple[int, bytes]]] = []
    for number, line in enumerate(header.split(b"\n"), start=1):
        if fields and line.startswith(b" "):
            fields[-1].append((number, line))
        else:
            fields.append([(number, line)])
    return fields


def field_value(fields: Sequence[Sequence[tuple[int, bytes]]], name: bytes) -> bytes | None:
    """The value on the first line of the first field named NAME. Git reads the first of two `encoding` headers
    (measured with git 2.43 for INFRA-4943), and parse_tag reads `object`, `type` and `tag` the same way."""
    for field in fields:
        word, _, value = field[0][1].partition(b" ")
        if word == name:
            return value
    return None


def header_findings(fields: Sequence[Sequence[tuple[int, bytes]]], encoding: bytes | None, place: str,
                    matcher: TermMatcher) -> list[Finding]:
    """The listed terms in a raw header's FIELDS (header_fields), each line read in every text git_texts gives with
    ENCODING: an author, committer or tagger at `PLACE author` (`committer`, `tagger`), without its seconds and zone; a
    `mergetag`, the signed tag `git merge` writes into a merge commit, read whole as a pushed tag is (object_findings),
    at `PLACE merged tag NAME` (`PLACE merged tag` when it names none); a signature header (SIGNATURE_HEADERS) and its
    continuation lines not at all; a `tree`, `parent` or `object` line that holds one object id not at all; and every
    other line, the continuation lines of an identity or of an id header included, at `PLACE header line N`."""
    findings: list[Finding] = []
    for field in fields:
        number, first = field[0]
        word, _, value = first.partition(b" ")
        if word in SIGNATURE_HEADERS:
            continue
        if word == b"mergetag":
            # Read as an object, not through parse_tag, which refuses a tag with no `type` or `tag` line: a commit's
            # mergetag need not hold them (the review of INFRA-4943 found one in Linux's history, 162e3480246e, that
            # holds `object <id>` alone). Whatever it holds is read.
            tag = b"\n".join([value, *(line[1:] for _, line in field[1:])])
            name = field_value(header_fields(tag.partition(b"\n\n")[0]), b"tag")
            shown = "" if name is None else f" {c_escape(name.decode('utf-8', errors='surrogateescape'))}"
            findings.extend(object_findings(tag, f"{place} merged tag{shown}", matcher))
            continue
        lines = field
        if word in IDENTITY_HEADERS:
            findings.extend(header_line_findings(number, IDENTITY_DATE.sub(b"", value), encoding,
                                                 lambda _, kind=word.decode(): f"{place} {kind}", matcher))
            lines = field[1:]
        elif word in OBJECT_ID_HEADERS and OBJECT_ID.fullmatch(value.decode("ascii", "replace")) is not None:
            lines = field[1:]
        for line_number, line in lines:
            findings.extend(header_line_findings(line_number, line, encoding, lambda n: f"{place} header line {n}",
                                                 matcher))
    return findings


def object_findings(content: bytes, place: str, matcher: TermMatcher) -> list[Finding]:
    """The listed terms in a raw commit or tag object: its header (header_findings) and its message, a tag's signature
    included, at `PLACE message line N`, each read in every text git_texts gives under the object's first `encoding`
    header. Outgoing commits, the tags a commit carries as `mergetag` and pushed tags are all read here."""
    header, _, message = content.partition(b"\n\n")
    fields = header_fields(header)
    encoding = field_value(fields, b"encoding")
    findings = header_findings(fields, encoding, place, matcher)
    findings.extend(texts_findings(git_texts(message, encoding), lambda text: scan_message(
        text, matcher, "verbatim", None, False, f"{place} message")))
    return findings


def scan_outgoing_commit_objects(commits: Sequence[str], matcher: TermMatcher, findings: list[Finding]) -> None:
    """Scan each outgoing commit object (object_findings), read whole with `cat-file --batch`, whose every record's id,
    type and size batch_objects checks. Until 2026-11-21 the message was read through `git log --encoding=UTF-8`,
    which decodes it as the commit declares, so UTF-8 bytes under `encoding UTF-16LE` or `encoding cp500` were read
    as other characters and a term in them was missed (the review of INFRA-4943)."""
    for start in range(0, len(commits), COMMIT_BATCH):
        chunk = commits[start:start + COMMIT_BATCH]
        contents = batch_objects(chunk, "commit", "git could not read the outgoing commits",
                                 "git gave a malformed commit object")
        for commit in chunk:
            findings.extend(object_findings(contents[commit], f"commit {commit[:12]}", matcher))


DIFF_OPTIONS = (
    "-U0",
    "--no-ext-diff",
    "--no-textconv",
    "--no-color",
    "--no-renames",
    "--no-relative",
    "--src-prefix=a/",
    "--dst-prefix=b/",
    "--submodule=short",
    "--ignore-submodules=none",
    "--diff-algorithm=myers",
)


@dataclass(frozen=True)
class DiffPolicy:
    """The attribute policy every diff producer of one check shares (scan_diff_arguments), read once (diff_policy):
    ATTRIBUTE_TREE, the empty tree Git takes attributes from, and EVERY_FILE_TEXT, whether a non-empty info/attributes,
    the one attribute source Git cannot turn off, makes the check read every file as text."""

    attribute_tree: str
    every_file_text: bool


def diff_policy() -> DiffPolicy:
    return DiffPolicy(empty_attribute_tree(), info_attributes_present())


def scan_diff_arguments(command: str, command_arguments: Sequence[str], policy: DiffPolicy) -> list[str]:
    """Return one text-only diff producer with the shared outgoing and staged attribute policy. `log.follow` is off:
    with it, git follows a rename when one pathspec is given (scan_covered_diffs), even under --no-renames, and the
    file's diff then holds only what the rename changed."""
    arguments = [
        "-c",
        "core.attributesFile=/dev/null",
        "--attr-source",
        policy.attribute_tree,
        "-c",
        "core.quotePath=false",
        "-c",
        "log.follow=false",
        command,
        *command_arguments,
        *DIFF_OPTIONS,
    ]
    if policy.every_file_text:
        arguments.append("--text")
    return arguments


def scan_outgoing_diffs(commits: Sequence[str], matcher: TermMatcher, findings: list[Finding], policy: DiffPolicy,
                        pathspecs: Sequence[str] = ()) -> None:
    """Scan a byte-streamed diff producer of commits that are not merges, framing commits only outside hunk content;
    with PATHSPECS, only the files they name, which each of COMMITS changes one of (scan_covered_diffs)."""
    if not commits:
        return
    arguments = scan_diff_arguments(
        "log",
        [
            "--no-walk=unsorted",
            "--stdin",
            "--format=commit %H",
            "--root",
            "--no-show-signature",
            "--no-notes",
            "--no-decorate",
        ],
        policy,
    )
    if pathspecs:
        arguments += ["--", *pathspecs]
    expected = set(commits)
    seen: set[str] = set()
    for commit, raw_diff in outgoing_diff_records(git_chunks(arguments, ("\n".join(commits) + "\n").encode())):
        if OBJECT_ID.fullmatch(commit) is None or commit not in expected or commit in seen:
            raise TextError("git gave malformed commit boundaries")
        seen.add(commit)
        findings.extend(scan_diff(raw_diff.decode("utf-8", errors="surrogateescape"), matcher, f"commit {commit[:12]} "))
    if seen != expected:
        raise TextError("git gave malformed commit boundaries")


def scan_staged_diff() -> list[Finding]:
    """Scan the staged diff under the same attribute policy and Git environment as an outgoing diff."""
    raw_diff = git_output(
        scan_diff_arguments("diff", ["--cached"], diff_policy()),
        b"",
        "git could not read staged diff",
    )
    if not raw_diff:
        return []
    return scan_diff(raw_diff.decode("utf-8", errors="surrogateescape"), load_terms(), "")


def commit_parents(commits: Sequence[str]) -> dict[str, list[str]]:
    """Each commit's parents as every other Git read sees them (a graft or a shallow boundary included), in one call."""
    output = git_output(
        ["rev-list", "--no-walk=unsorted", "--stdin", "--parents"],
        ("\n".join(commits) + "\n").encode(),
        "git could not read the outgoing commits' parents",
    )
    try:
        lines = output.decode("ascii").splitlines()
    except UnicodeDecodeError as error:
        raise TextError("git gave a malformed list of parents") from error
    parents: dict[str, list[str]] = {}
    for line in lines:
        fields = line.split(" ")
        if any(OBJECT_ID.fullmatch(field) is None for field in fields) or fields[0] in parents:
            raise TextError("git gave a malformed list of parents")
        parents[fields[0]] = fields[1:]
    if set(parents) != set(commits):
        raise TextError("git gave a malformed list of parents")
    return parents


RAW_MODE = re.compile(r"[0-7]{6}\Z")


@dataclass(frozen=True)
class RawChange:
    """One file of a raw tree diff: the parent's mode and object, then the commit's."""

    source_mode: str
    source: str
    result_mode: str
    result: str

    @property
    def deleted(self) -> bool:
        """Whether the commit deletes the file: its mode is 000000, and it has no version."""
        return self.result_mode == "000000"

    @property
    def file_version(self) -> bool:
        """Whether the commit's version is a file's content (a blob): neither a deletion nor a gitlink, whose object
        is a commit and whose `Subproject commit` line is always read."""
        return file_version_mode(self.result_mode)

    @property
    def source_file_version(self) -> bool:
        """Whether the parent's version is a file's content (file_version, of the parent's mode)."""
        return file_version_mode(self.source_mode)


def file_version_mode(mode: str) -> bool:
    """Whether MODE, a raw tree diff's, is a file's: neither 000000 (no file) nor 160000 (a gitlink)."""
    return mode not in ("000000", "160000")


def raw_tree_diffs(pairs: Sequence[tuple[str, str | None]]) -> list[dict[str, RawChange]]:
    """For each of PAIRS, (a commit, the parent to read it against, or None for its own parent, or for a root commit
    its whole tree), every file whose object or mode differs.

    One `git diff-tree --stdin` reads every pair. `--always` prints the commit's id before each diff, an empty one
    included, so each file is attributed to its pair by position, never by counting.
    """
    output = git_output(
        ["diff-tree", "--stdin", "--always", "--root", "-r", "--raw", "-z", "--no-abbrev", "--no-renames",
         "--no-relative", "--ignore-submodules=none"],
        "".join(f"{commit}\n" if parent is None else f"{commit} {parent}\n" for commit, parent in pairs).encode(),
        "git could not read the files of the outgoing commits",
    )
    records = output.split(b"\0")
    if records.pop() != b"":
        raise TextError("git gave a malformed raw diff of the outgoing commits")
    diffs: list[dict[str, RawChange]] = []
    position = 0
    for commit, _ in pairs:
        malformed = f"git gave a malformed raw diff of commit {commit[:12]}"
        if position >= len(records) or records[position] != commit.encode():
            raise TextError(malformed)
        position += 1
        files: dict[str, RawChange] = {}
        while position < len(records) and records[position].startswith(b":"):
            try:
                fields = records[position].decode("ascii")[1:].split(" ")
            except UnicodeDecodeError as error:
                raise TextError(malformed) from error
            path = records[position + 1].decode("utf-8", errors="surrogateescape") if position + 1 < len(records) else ""
            if (
                len(fields) != 5
                or not all(RAW_MODE.fullmatch(mode) for mode in fields[:2])
                or not all(OBJECT_ID.fullmatch(object_id) for object_id in fields[2:4])
                or fields[4] not in {"A", "D", "M", "T"}
                or not path
                or path in files
            ):
                raise TextError(malformed)
            files[path] = RawChange(fields[0], fields[2], fields[1], fields[3])
            position += 2
        diffs.append(files)
    if position != len(records):
        raise TextError("git gave a malformed raw diff of the outgoing commits")
    return diffs


def merge_changes(merges: Mapping[str, Sequence[str]]) -> dict[str, list[dict[str, RawChange]]]:
    """For each merge, in its parents' order, every file whose object or mode differs from that parent's
    (raw_tree_diffs, one pair for each merge and parent)."""
    pairs = [(merge, parent) for merge, parents in merges.items() for parent in parents]
    diffs = raw_tree_diffs(pairs)
    changes: dict[str, list[dict[str, RawChange]]] = {merge: [] for merge in merges}
    for (merge, _), files in zip(pairs, diffs, strict=True):
        changes[merge].append(files)
    return changes


def scan_outgoing_merges(merges: Mapping[str, Sequence[str]], matcher: TermMatcher, findings: list[Finding],
                         policy: DiffPolicy, coverage: Coverage | None = None) -> None:
    """Scan what each merge adds itself: the path of each file that differs from every parent's, and each line of the
    merge's file that no parent's file at that path holds.

    A line the merge took from a parent is that parent's: it is scanned in the parent's own commit when the push sends
    that commit, and the destination holds it otherwise. The files are read as objects, so no attribute applies; a
    file is text as the diff producer would read it: always under `--text` (POLICY's every_file_text), else when
    its object has no NUL byte in its first 8,000 bytes, Git's own test. Only a parent's text file holds a line: a
    binary one was never scanned, so a line of it that the merge writes into a text file is the merge's to scan.

    A file whose merge version COVERAGE covers has its path read and no line: record found no term in the whole file.
    """
    if not merges:
        return
    every_file_text = policy.every_file_text
    for merge, parent_files in merge_changes(merges).items():
        prefix = f"commit {merge[:12]} "
        for path in sorted(set(parent_files[0]).intersection(*parent_files[1:])):
            path_spans = matcher.spans(path)
            shown = c_escape(path)
            changes = [files[path] for files in parent_files]
            if len({(change.result_mode, change.result) for change in changes}) != 1:
                raise TextError(f"git gave two versions of file {shown} of merge commit {merge[:12]}")
            merged = changes[0]
            result = merged.result
            if merged.deleted:
                continue
            findings.extend(name_findings(prefix + shown, path, path_spans))
            if not merged.file_version:
                continue
            if coverage is not None:
                if coverage.covers(merged):
                    continue
                coverage.reads([merged])
            sources = {change.source for change in changes if change.source_file_version}
            try:
                contents = blob_objects(sorted({result, *sources}))
            except TextError as error:
                raise TextError(f"cannot read file {shown} of merge commit {merge[:12]}") from error
            if not every_file_text and b"\0" in contents[result][:8000]:
                continue
            held: set[str] = set()
            for source in sources:
                if every_file_text or b"\0" not in contents[source][:8000]:
                    held.update(newline_lines(contents[source].decode("utf-8", errors="surrogateescape")))
            content = contents[result].decode("utf-8", errors="surrogateescape")
            own = [(number, line) for number, line in enumerate(newline_lines(content), start=1) if line not in held]
            findings.extend(line_findings(own, matcher, is_prose(path), lambda number: f"{prefix}{shown}:{number}"))


# The record (dispatch://INFRA-5140): a git note on each file version (blob) that `record` read whole and found to hold
# no listed term, under a key (record_key) that names this program, its interpreter and the lists a push to one
# destination reads. A push then reads no content of a recorded blob (scan_covered_diffs, scan_outgoing_merges), so a
# release whose files the internal main already holds reads only the files its cut rewrote. It still reads every commit
# and tag object (message and header), ref name and path, and every file or folder object pushed by itself
# (scan_outgoing_objects).
#
# Threat model: whoever can write RECORD_REF in the pushing clone, or in the repository it fetches the ref from, can
# make a push skip a blob's content. A note is trusted as written; nothing here protects it.
RECORD_REF = "refs/notes/leak-terms-check"


@dataclass
class Coverage:
    """COVERED, the file versions (blobs) the record covers for this push's key (record_key); SEEN, those the outgoing
    commits add or change, which `covers` tallies; and READ, those of SEEN whose content the push reads, which `reads`
    tallies. The push's summary counts them."""

    covered: set[str]
    seen: set[str] = field(default_factory=set)
    read: set[str] = field(default_factory=set)

    def covers(self, change: RawChange) -> bool:
        """Whether a push may leave unread the content of CHANGE, a file a commit adds or changes: never for a deletion
        or a gitlink (RawChange.file_version); else when the record covers its version."""
        if not change.file_version:
            return False
        self.seen.add(change.result)
        return change.result in self.covered

    def reads(self, changes: Iterable[RawChange]) -> None:
        """Tally the content of CHANGES as read: each that is a file version (RawChange.file_version)."""
        self.read.update(change.result for change in changes if change.file_version)

    def summary(self) -> str:
        return (f"leak terms: the record {RECORD_REF} covered {len(self.seen & self.covered)} of the {len(self.seen)} "
                f"file versions the outgoing commits add or change; the push read {len(self.read)} of them")


Item = TypeVar("Item")


def bounded_chunks(items: Sequence[Item], size_of: Callable[[Item], int], max_bytes: int,
                   max_items: int | None = None) -> Iterator[list[Item]]:
    """ITEMS in order, in lists of at most MAX_ITEMS items whose SIZE_OF adds up to at most MAX_BYTES; an item larger
    than MAX_BYTES in a list of its own."""
    chunk: list[Item] = []
    size = 0
    for item in items:
        length = size_of(item)
        if chunk and (len(chunk) == max_items or size + length > max_bytes):
            yield chunk
            chunk, size = [], 0
        chunk.append(item)
        size += length
    if chunk:
        yield chunk


# A push names the files it reads of the commits some of whose files are covered on git's command line, in calls of at
# most this many bytes of pathspecs, far under the kernel's argument limit.
PATHSPEC_BYTES = 128 << 10


def literal_pathspec(path: str) -> str:
    """PATH, a path from the top of the working tree as a raw tree diff gives it, as a literal pathspec, which no
    wildcard or magic in a path can widen. It names the file PATH, and every file in a folder PATH (pathspec_reaches).
    `top` makes git read it from the top of the working tree, not from the directory the check runs in: shims/jj runs
    the check from its caller's directory with GIT_WORK_TREE passed on, and there `:(literal)a.txt` named `sub/a.txt`,
    so the push read the wrong file or refused a clean one."""
    return f":(top,literal){path}"


def pathspec_reaches(named: set[str], path: str) -> bool:
    """Whether a literal pathspec of one of NAMED names PATH: PATH itself, or a folder that holds it."""
    if path in named:
        return True
    end = path.find("/")
    while end >= 0:
        if path[:end] in named:
            return True
        end = path.find("/", end + 1)
    return False


def pathspec_chunks(paths: Sequence[str]) -> Iterator[list[str]]:
    """PATHS in lists whose literal pathspecs (literal_pathspec) take at most PATHSPEC_BYTES of a command line, far
    under the kernel's argument limit."""
    return bounded_chunks(paths, lambda path: len(os.fsencode(literal_pathspec(path))) + 1, PATHSPEC_BYTES)


def scan_covered_diffs(commits: Sequence[str], matcher: TermMatcher, findings: list[Finding], policy: DiffPolicy,
                       coverage: Coverage) -> None:
    """scan_outgoing_diffs of COMMITS, none a merge, without the content of each file whose version COVERAGE covers.

    One raw tree diff of every commit (raw_tree_diffs, read as the diff producer reads it: no rename, every submodule)
    names each file's version. A commit with fewer covered files than other files it adds or changes is read whole, as
    with no record: reading its few covered files only makes the check stricter.

    The others are read together, by the same producer and attribute policy, limited to the paths that one of them
    adds or changes and does not cover (pathspec_chunks): a file's diff is the same with or without the other files,
    since no rename is detected and log.follow is off (scan_diff_arguments). Each call is given every commit that
    changes a file its paths name, as git matches a literal pathspec (pathspec_reaches): the file itself, or the files
    of a folder of that name. git reads in each of them every file those paths name, a covered one too where another
    commit names its path, which is only stricter. The path of each covered file no call reads is read alone
    (name_findings, as scan_diff reads the path of every file it keeps). A deleted file is not read, since scan_diff
    finds nothing in one, so a commit whose every file is covered or deleted reads no diff, unless another commit names
    one of its paths.
    """
    if not commits:
        return
    whole: list[str] = []
    mixed: list[tuple[str, dict[str, RawChange], set[str]]] = []
    for commit, files in zip(commits, raw_tree_diffs([(commit, None) for commit in commits]), strict=True):
        covered = {path for path, change in files.items() if coverage.covers(change)}
        unread = [path for path, change in files.items() if not change.deleted and path not in covered]
        if len(covered) < len(unread):
            whole.append(commit)
            coverage.reads(files.values())
        else:
            mixed.append((commit, files, covered))
    paths = list(dict.fromkeys(path for _, files, covered in mixed for path, change in files.items()
                               if not change.deleted and path not in covered))
    named = set(paths)
    for commit, _, covered in mixed:
        for path in sorted(covered):
            if not pathspec_reaches(named, path):
                findings.extend(name_findings(f"commit {commit[:12]} {c_escape(path)}", path, matcher.spans(path)))
    for chunk in pathspec_chunks(paths):
        chunk_named = set(chunk)
        group: list[str] = []
        for commit, files, _ in mixed:
            reached = [change for path, change in files.items() if pathspec_reaches(chunk_named, path)]
            if reached:
                group.append(commit)
                coverage.reads(reached)
        scan_outgoing_diffs(group, matcher, findings, policy, [literal_pathspec(path) for path in chunk])
    scan_outgoing_diffs(whole, matcher, findings, policy)


def scan_outgoing_commits(commits: Sequence[str], matcher: TermMatcher, coverage: Coverage | None = None
                          ) -> list[Finding]:
    """Scan outgoing messages and headers, the diffs of commits that are not merges, and what each merge adds, with
    separate producers and verified boundaries; with COVERAGE, no content of a file version the record covers. The
    attribute policy is read once for every producer (diff_policy)."""
    if not commits:
        return []
    parents = commit_parents(commits)
    findings: list[Finding] = []
    scan_outgoing_commit_objects(commits, matcher, findings)
    policy = diff_policy()
    singles = [commit for commit in commits if len(parents[commit]) < 2]
    if coverage is None:
        scan_outgoing_diffs(singles, matcher, findings, policy)
    else:
        scan_covered_diffs(singles, matcher, findings, policy, coverage)
    scan_outgoing_merges({commit: parents[commit] for commit in commits if len(parents[commit]) >= 2}, matcher, findings,
                         policy, coverage)
    return findings


def object_info(object_ids: Sequence[str], failure: str) -> dict[str, tuple[str, int]]:
    """The type and size of each object, in one Git call; an object this repository lacks cannot be read, so it is
    FAILURE, as is any answer git cannot have given."""
    if not object_ids:
        return {}
    output = git_output(
        ["cat-file", "--batch-check=%(objectname) %(objecttype) %(objectsize)"],
        ("\n".join(object_ids) + "\n").encode(),
        failure,
    )
    lines = output.decode("utf-8", errors="surrogateescape").splitlines()
    if len(lines) != len(object_ids):
        raise TextError(failure)
    info: dict[str, tuple[str, int]] = {}
    for object_id, line in zip(object_ids, lines, strict=True):
        fields = line.split()
        if len(fields) != 3 or fields[0].lower() != object_id.lower() or not fields[2].isdigit():
            raise TextError(failure)
        info[object_id] = (fields[1], int(fields[2]))
    return info


def batch_objects(
    object_ids: Sequence[str], expected_type: str, read_error: str, malformed_error: str
) -> dict[str, bytes]:
    """The exact content of each expected object type, with every batch record checked."""
    if not object_ids:
        return {}
    output = git_output(["cat-file", "--batch"], ("\n".join(object_ids) + "\n").encode(), read_error)
    contents: dict[str, bytes] = {}
    position = 0
    for object_id in object_ids:
        end = output.find(b"\n", position)
        fields = output[position:end].decode("utf-8", errors="surrogateescape").split() if end >= 0 else []
        if (
            len(fields) != 3
            or fields[0].lower() != object_id.lower()
            or fields[1] != expected_type
            or not fields[2].isdigit()
        ):
            raise TextError(malformed_error)
        size = int(fields[2])
        content = output[end + 1 : end + 1 + size]
        if len(content) != size or output[end + 1 + size : end + 2 + size] != b"\n":
            raise TextError(malformed_error)
        contents[object_id] = content
        position = end + 2 + size
    if position != len(output):
        raise TextError(malformed_error)
    return contents


def tag_objects(object_ids: Sequence[str]) -> dict[str, bytes]:
    """The raw content of each tag object, in one Git call, with each record's size checked."""
    return batch_objects(
        object_ids,
        "tag",
        "git could not read the outgoing tags",
        "git gave a malformed tag object",
    )


def parse_tag(content: bytes) -> tuple[str, str, str]:
    """A tag object's target, target type and name, each the first of its header (field_value)."""
    fields = header_fields(content.partition(b"\n\n")[0])
    target, kind, name = (field_value(fields, word) for word in (b"object", b"type", b"tag"))
    if target is None or kind is None or name is None or OBJECT_ID.fullmatch(target.decode("ascii", "replace")) is None:
        raise TextError("git gave a malformed tag object")
    return target.decode("ascii"), kind.decode("ascii", "replace"), name.decode("utf-8", errors="surrogateescape")


@dataclass
class TagWalk:
    """The tags (name, id, raw content) and every reached object type from one set of update objects."""

    tags: list[tuple[str, str, bytes]]
    objects: dict[str, str]


def tag_chains(starts: Sequence[tuple[str, str]], known: set[str]) -> TagWalk:
    """Walk the tag objects reached from STARTS, skipping every object in KNOWN."""
    found: list[tuple[str, str, bytes]] = []
    objects: dict[str, str] = {}
    seen = set(known)
    pending: list[tuple[str | None, str]] = list(starts)
    while pending:
        unique: dict[str, str | None] = {}
        for name, object_id in pending:
            if object_id not in seen:
                unique.setdefault(object_id, name)
        seen.update(unique)
        types = {object_id: kind for object_id, (kind, _) in
                 object_info(sorted(unique), "git could not read the outgoing objects").items()}
        objects.update(types)
        contents = tag_objects(sorted(object_id for object_id in unique if types[object_id] == "tag"))
        pending = []
        for object_id, name in unique.items():
            if types[object_id] != "tag":
                continue
            target, kind, own_name = parse_tag(contents[object_id])
            found.append((own_name if name is None else name, object_id, contents[object_id]))
            if kind == "tag":
                pending.append((None, target))
            elif kind in {"blob", "commit", "tree"}:
                objects.setdefault(target, kind)
            else:
                raise TextError("git gave a malformed tag object")
    return TagWalk(found, objects)


def outgoing_tags(
    updates: Sequence[tuple[str, str]], advertised: Sequence[str], held: set[str]
) -> tuple[list[tuple[str, bytes]], dict[str, str]]:
    """The outgoing tags (name, raw content) and direct file or folder objects from one object walk over UPDATES."""
    starts = [(ref.removeprefix("refs/tags/"), object_id) for ref, object_id in updates]
    known = set(advertised) | held
    outgoing = tag_chains(starts, known)
    objects = {object_id: kind for object_id, kind in outgoing.objects.items() if kind in {"blob", "tree"}}
    if not outgoing.tags and not objects:
        return [], {}
    held_chains = tag_chains([("", object_id) for object_id in sorted(held)], set())
    known.update(held_chains.objects)
    return (
        [
            (name, content)
            for name, object_id, content in outgoing.tags
            if object_id not in known
        ],
        {object_id: kind for object_id, kind in objects.items() if object_id not in known},
    )


def tree_paths(object_id: str) -> list[tuple[str, str, str]]:
    """Every kind, object and path in a folder object, with Git's raw path bytes decoded once. `--full-tree` lists the
    whole folder whatever directory the check runs in: without it, git lists only the part under that directory."""
    return tree_listing(["-r", "-t", "--full-tree", object_id], "git could not read an outgoing folder",
                        "git gave a malformed outgoing folder")


def tree_listing(arguments: Sequence[str], failure: str, malformed: str) -> list[tuple[str, str, str]]:
    """Every kind, object and path `git ls-tree -z ARGUMENTS` lists, with Git's raw path bytes decoded once; FAILURE
    and MALFORMED are the errors for a git that fails and for output it cannot have given."""
    output = git_output(["ls-tree", "-z", *arguments], b"", failure)
    records = output.split(b"\0")
    if records.pop() != b"":
        raise TextError(malformed)
    paths: list[tuple[str, str, str]] = []
    for record in records:
        header, separator, raw_path = record.partition(b"\t")
        fields = header.split(b" ")
        if (
            not separator
            or len(fields) != 3
            or not fields[0].isdigit()
            or fields[1] not in {b"blob", b"commit", b"tree"}
        ):
            raise TextError(malformed)
        try:
            path_object = fields[2].decode("ascii")
        except UnicodeDecodeError as error:
            raise TextError(malformed) from error
        if OBJECT_ID.fullmatch(path_object) is None:
            raise TextError(malformed)
        paths.append(
            (fields[1].decode("ascii"), path_object, raw_path.decode("utf-8", errors="surrogateescape"))
        )
    return paths


def blob_objects(object_ids: Sequence[str]) -> dict[str, bytes]:
    """The exact content of each file object, verified as one batch."""
    return batch_objects(
        object_ids,
        "blob",
        "git could not read the outgoing files",
        "git gave a malformed outgoing file",
    )


def scan_outgoing_objects(
    objects: Mapping[str, str], commits: Sequence[str], held: set[str], matcher: TermMatcher
) -> list[Finding]:
    """Scan file objects and folder paths the destination lacks and no sent commit already includes."""
    if not objects:
        return []
    held_ids = sorted(held)
    commit_objects = outgoing_commit_object_ids(commits, held_ids)
    destination_objects = destination_object_ids(held_ids)
    files = {
        object_id
        for object_id, kind in objects.items()
        if kind == "blob" and object_id not in destination_objects and object_id not in commit_objects
    }
    folders = sorted(
        object_id
        for object_id, kind in objects.items()
        if kind == "tree" and object_id not in destination_objects and object_id not in commit_objects
    )
    folder_files: list[tuple[str, str, str]] = []
    findings: list[Finding] = []
    for folder in folders:
        # The places are the ones the commit check names for a commit that adds the same files: each file's whole
        # path, decided by the same matcher, one finding per match. A folder that holds anything is not read on its
        # own, since its path starts the path of everything in it and the term is read there. An empty folder, which no
        # commit diff can show, is read as one place of its own. Every path is shown as written.
        entries = tree_paths(folder)
        nonempty = {path.rpartition("/")[0] for _, _, path in entries if "/" in path}
        for kind, path_object, path in entries:
            if kind == "tree" and path in nonempty:
                continue
            spans = matcher.spans(path)
            shown = c_escape(path)
            findings.extend(name_findings(shown, path, spans))
            if kind == "blob" and path_object not in destination_objects and path_object not in commit_objects:
                folder_files.append((path_object, shown, path))

    content_ids = sorted(files | {object_id for object_id, _, _ in folder_files})
    contents = blob_objects(content_ids)
    # A file object pushed with no path has no kind, so it is read as code, a line at a time.
    for object_id in sorted(files):
        content = contents[object_id]
        if b"\0" not in content[:8000]:
            lines = list(enumerate(newline_lines(content.decode("utf-8", errors="surrogateescape")), start=1))
            findings.extend(line_findings(lines, matcher, False, lambda number: f"object {object_id[:12]} line {number}"))
    for object_id, shown, path in folder_files:
        content = contents[object_id]
        if b"\0" in content[:8000]:
            continue
        lines = list(enumerate(newline_lines(content.decode("utf-8", errors="surrogateescape")), start=1))
        findings.extend(line_findings(lines, matcher, is_prose(path), lambda number: f"{shown}:{number}"))
    return findings


def repository_of(url: str) -> list[str]:
    """The repositories a URL can be, for the scoped lists: [`owner/name`] as scripts/github-repo-visibility --slug
    reads it, nothing for a URL that is not GitHub's, and every repository (EVERY_REPOSITORY) for one it cannot read."""
    helper = Path(__file__).resolve().parent / "github-repo-visibility"
    try:
        completed = subprocess.run([str(helper), "--slug", url], stdin=subprocess.DEVNULL, capture_output=True,
                                   text=True, timeout=30, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return list(EVERY_REPOSITORY)
    value = completed.stdout.strip()
    if completed.returncode != 0 or value in ("", "unknown") or "/" not in value and value != "not-github":
        return list(EVERY_REPOSITORY)
    return [] if value == "not-github" else [value]


class RecordError(Exception):
    """The record could not be read, or record could not write it."""


def file_digest(path: Path) -> str | None:
    """The sha256 of the bytes of the file at PATH, in lower-case hex; None when they cannot be read."""
    try:
        return hashlib.sha256(path.read_bytes()).hexdigest()
    except OSError:
        return None


# The sha256 of this program's bytes, read once at import, so that a record's key names the program this process runs,
# not one written over it during the run. None when it cannot be read: then there is no key, and no record is used.
SCRIPT_DIGEST = file_digest(Path(__file__).resolve())


def record_terms(repositories: Sequence[str], drop_allowed: bool) -> tuple[TermMatcher, str | None]:
    """load_terms for REPOSITORIES, and the digest of the encrypted list it decrypted (file_digest). The list's bytes
    are read before and after sops decrypts it, and a list that changed meanwhile gives None, so that no key names a
    list other than the one the matcher holds."""
    before = file_digest(term_file(os.environ))
    matcher = load_terms(repositories=repositories, drop_allowed=drop_allowed)
    return matcher, before if before is not None and before == file_digest(term_file(os.environ)) else None


RECORD_TAG = b"leak-terms-check record 1\0"


def record_key(matcher: TermMatcher, list_digest: str | None) -> str:
    """The key a note's line `pass <key>` names, in lower-case hex: the sha256 of RECORD_TAG and of these, each ended by
    a NUL: the sha256 of this program's bytes (SCRIPT_DIGEST), the interpreter's major.minor and its Unicode version
    (str.casefold and the `\\s` of paragraph_view follow it), the sha256 of the encrypted term list's bytes
    (LIST_DIGEST, from record_terms), and the labels of the scoped lists MATCHER reads (those that reach the
    destination), sorted. A change of any of them gives a new key, so every blob is read again; two destinations that
    read the same lists share one key.

    The push reads no knives list (load_terms(registry=False) in scan_push), so knives's fork registry is not part of
    the key: a push that reads one must add it here. RecordError where a part cannot be read."""
    if SCRIPT_DIGEST is None:
        raise RecordError("this program cannot read its own file")
    if list_digest is None:
        raise RecordError("the term list changed while it was read")
    digest = hashlib.sha256(RECORD_TAG)
    for part in (SCRIPT_DIGEST, f"{sys.version_info.major}.{sys.version_info.minor}", unicodedata.unidata_version,
                 list_digest, *sorted(matcher.scopes)):
        digest.update(part.encode("utf-8", errors="surrogateescape") + b"\0")
    return digest.hexdigest()


@dataclass(frozen=True)
class Record:
    """RECORD_REF as one read found it: COMMIT, the commit it names, and NOTES, (the blob it annotates, its path in the
    notes tree, its text) for each note."""

    commit: str
    notes: list[tuple[str, str, str]]

    def covered(self, key: str) -> set[str]:
        """The blobs whose note holds the exact line `pass KEY`."""
        line = f"pass {key}"
        passing = {text for text in {text for _, _, text in self.notes} if line in text.split("\n")}
        return {blob for blob, _, text in self.notes if text in passing}


def record_ref_absent() -> None:
    """Return when this repository has no ref RECORD_REF; RecordError when it has one that for-each-ref did not list, or
    git cannot tell. `git show-ref --exists` (git 2.43) exits 0 for a ref that is there, a symbolic ref to no ref
    included, 2 for none, and 1 when it cannot read the name: a ref file that names no object ("Invalid argument"), one
    the user may not read ("Permission denied"), a folder of that name that holds other refs, such as
    refs/notes/leak-terms-check/inner ("Is a directory"), or a file where a folder of the name should be ("Not a
    directory"). The error is git's, shown as it gave it (c_escape, in the refusal), read with every trace off so that
    no trace line is taken for it: no GIT_TRACE* variable of the caller's, and GIT_TRACE2, GIT_TRACE2_PERF and
    GIT_TRACE2_EVENT set to 0, which overrides a trace2.*Target in git's global or system config. An older git knows no
    --exists (exit 129): there such a name goes unreported, as it did before, and every file version is read all the
    same."""
    environment = {name: value for name, value in git_environment().items() if not name.startswith("GIT_TRACE")}
    environment.update(GIT_TRACE2="0", GIT_TRACE2_PERF="0", GIT_TRACE2_EVENT="0")
    try:
        completed = subprocess.run(["git", "show-ref", "--exists", RECORD_REF], stdin=subprocess.DEVNULL,
                                   stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, env=environment, check=False)
    except OSError as error:
        raise RecordError("git could not read the ref") from error
    if completed.returncode == 0:
        raise RecordError("git finds the ref but lists no object for it: it is a symbolic ref to no ref")
    if completed.returncode == 1:
        said = "; ".join(line.strip() for line in completed.stderr.decode("utf-8", errors="replace").splitlines()
                         if line.strip())
        raise RecordError(f"git cannot read the ref (git show-ref --exists exit 1: {bounded(said, 200) or 'no message'})")


def read_record() -> Record | None:
    """RECORD_REF, read whole: None when this repository has no ref of exactly that name; RecordError when it is a
    symbolic ref, names no commit, cannot be read as a ref (record_ref_absent), or a note cannot be read. for-each-ref
    lists the ref by its full name, so a branch or tag whose name ends in it (refs/heads/refs/notes/…), which rev-parse
    would read in its place, is never the record. for-each-ref lists neither a ref it cannot read nor a symbolic ref to
    no ref, so when it lists nothing, `show-ref --exists` says whether the name is free.
    The notes tree is listed once and each distinct note read once. A note's path joins into the blob it annotates
    (`ab/cdef…`, or any other fanout); an entry whose path joins into no object id is no note."""
    try:
        listed = git_output(["for-each-ref", "--format=%(refname)%00%(symref)%00%(objectname)%00%(objecttype)",
                             RECORD_REF], b"", "git could not read the ref")
        found = [fields for fields in (line.split(b"\0") for line in listed.split(b"\n") if line)
                 if fields[0] == RECORD_REF.encode()]
        if not found:
            record_ref_absent()
            return None
        if len(found) != 1 or len(found[0]) != 4:
            raise RecordError("git gave a malformed list of refs")
        _, symref, named, kind = (field.decode("utf-8", errors="replace") for field in found[0])
        if symref:
            raise RecordError(f"it is a symbolic ref to {c_escape(symref)}, not a ref of its own")
        if kind != "commit":
            raise RecordError(f"it names a {kind}, not a commit")
        if OBJECT_ID.fullmatch(named) is None:
            raise RecordError("git gave a malformed list of refs")
        notes = [(path.replace("/", ""), path, note)
                 for entry, note, path in tree_listing(["-r", "--full-tree", named], "git could not list the notes",
                                                       "git gave a malformed notes tree")
                 if entry == "blob" and OBJECT_ID.fullmatch(path.replace("/", ""))]
        contents = batch_objects(sorted({note for _, _, note in notes}), "blob", "git could not read a note",
                                 "git gave a malformed note")
    except TextError as error:
        raise RecordError(str(error)) from error
    texts = {note: content.decode("utf-8", errors="surrogateescape") for note, content in contents.items()}
    return Record(named, [(blob, path, texts[note]) for blob, path, note in notes])


def push_coverage(matcher: TermMatcher, list_digest: str | None) -> Coverage | None:
    """What the record covers for this push (Coverage), or None, and the push reads every file version: silently where
    this repository has no record, else with one line that says why. A record never refuses a push or stops it."""
    try:
        record = read_record()
        if record is None:
            return None
        return Coverage(record.covered(record_key(matcher, list_digest)))
    except RecordError as error:
        print(f"leak terms: cannot use the record {RECORD_REF}, so every file version is read: {error}",
              file=sys.stderr)
        return None


def holds_no_term(content: bytes, matcher: TermMatcher) -> bool:
    """Whether CONTENT, a blob's bytes, holds no term, read so that it covers every read a push makes of any part of it.

    The push decodes a diff as UTF-8 with surrogateescape, and a line feed is one byte that is part of no other
    character, so each line it reads is a line of TEXT, decoded alike (no attribute or conversion applies to a diff's
    lines: scan_diff_arguments). It reads a code file's added lines one at a time (matcher.spans of the line), and a
    prose file's runs of consecutive added lines as the paragraph view of the run (line_findings); a merge's own lines
    the same way (scan_outgoing_merges). Each term's pattern is its words, escaped, joined by TERM_SEPARATOR (a run of
    any whitespace but a line feed), with no anchor, and no term holds a line break (term_lines); str.casefold folds
    each character alone. So a match in a line, which a line feed ends, is a match in TEXT. paragraph_view turns each
    character the same way wherever it stands, and each line break between two lines by those two lines alone, so the
    paragraph view of a run of lines is a part of the paragraph view of TEXT, and
    a match in it is a match there. Both views are read whatever the blob's path, so it is covered as code and as prose.

    MATCHER drops no match inside an allowed token (load_terms, drop_allowed off): a blob holding a token the
    destination allows is never recorded, and the push reads it as before. Stricter than the push, never looser."""
    text = content.decode("utf-8", errors="surrogateescape")
    return not matcher.spans(text) and not matcher.spans(paragraph_view(text))


def record_commit(revision: str) -> str:
    """The commit REVISION names."""
    output = git_output(["rev-parse", "--verify", "--quiet", "--end-of-options", f"{revision}^{{commit}}"], b"",
                        f"git cannot read {revision} as a commit")
    commit = output.decode("ascii", errors="replace").strip()
    if OBJECT_ID.fullmatch(commit) is None:
        raise TextError(f"git cannot read {revision} as a commit")
    return commit


def clean_blobs(batch: Sequence[str], matcher: TermMatcher) -> list[str]:
    """The blobs of BATCH that hold no term (holds_no_term), read in one Git call; nothing of them is kept after."""
    contents = batch_objects(batch, "blob", "git could not read the files to record", "git gave a malformed file")
    return [blob for blob in batch if holds_no_term(contents[blob], matcher)]


# A note keeps the lines of this many keys, oldest first: a writer drops the oldest and adds its own line last.
RECORD_KEYS = 8


def note_text(old: str | None, line: str) -> str:
    """A note's text once LINE is written into OLD, its text before: the last RECORD_KEYS - 1 other lines, then LINE."""
    kept = [entry for entry in (old or "").split("\n") if entry and entry != line]
    return "".join(f"{entry}\n" for entry in [*kept[max(0, len(kept) - RECORD_KEYS + 1):], line])


def write_record(record: Record | None, blobs: Sequence[str], line: str) -> None:
    """Write LINE into the note of each of BLOBS, in one notes commit that `git fast-import` makes on RECORD's commit,
    or as the first when there was no ref. fast-import moves the ref only to a commit that holds the ref's commit, so a
    writer that another overtook since it read the ref records nothing: RecordError. A new note's path is the blob's
    fanout path (`ab/cdef…`); an old note keeps its own."""
    old = {blob: (path, text) for blob, path, text in record.notes} if record else {}
    marks: dict[str, int] = {}
    stream = bytearray(b"feature done\n")
    entries: list[str] = []
    for blob in blobs:
        path, text = old.get(blob, (f"{blob[:2]}/{blob[2:]}", None))
        new = note_text(text, line)
        mark = marks.get(new)
        if mark is None:
            mark = marks[new] = len(marks) + 1
            data = new.encode("utf-8", errors="surrogateescape")
            stream += b"blob\nmark :%d\ndata %d\n%s\n" % (mark, len(data), data)
        entries.append(f"M 100644 :{mark} {path}\n")
    ident = git_output(["var", "GIT_COMMITTER_IDENT"], b"", "git has no committer identity for the notes commit")
    message = f"leak-terms-check record: {len(blobs)} file versions\n".encode()
    stream += b"commit %s\ncommitter %s\ndata %d\n%s" % (RECORD_REF.encode(), ident.strip(), len(message), message)
    if record:
        stream += f"from {record.commit}\n".encode()
    stream += "".join(entries).encode() + b"\ndone\n"
    try:
        # git's own refusal (`Not updating refs/notes/…`) reaches the caller's standard error.
        completed = subprocess.run(["git", "fast-import", "--quiet"], input=bytes(stream), stdout=subprocess.DEVNULL,
                                   env=git_environment(), check=False)
    except OSError as error:
        raise RecordError("git fast-import could not run") from error
    if completed.returncode:
        raise RecordError(f"git fast-import did not move {RECORD_REF}: another writer moved it since this run read it, "
                          "or git failed; run record again")


# record: a run that did not read every blob it was given, or did not write the notes of those it found clean.
RECORD_EXIT = 2
# record reads at most this many blobs, or this many bytes of them, in one git call; a larger blob alone.
RECORD_BATCH_BLOBS = 256
RECORD_BATCH_BYTES = 64 << 20


def record_command(url: str, revisions: Sequence[str]) -> int:
    """`record --url URL REV...`: write the record a push to URL reads. Read every blob in the trees of REVISIONS' commits
    (gitlinks name commits and are left out), but those whose note already holds this run's key; read the others in
    batches (RECORD_BATCH_BLOBS, RECORD_BATCH_BYTES), and write `pass <key>` into the note of each that holds no term
    (holds_no_term), all in one notes commit (write_record). Print how many blobs it found covered, read, recorded and
    did not record.

    The matcher is the one scan_push builds for URL (the list every repository has, and the scoped lists URL reaches),
    with no allowed token dropped. Exit 0 when it read every blob and wrote every note; RECORD_EXIT, with nothing
    recorded, when the list, a blob or the record cannot be read, or another writer moved the ref meanwhile."""
    try:
        matcher, list_digest = record_terms(repository_of(url), drop_allowed=False)
        key = record_key(matcher, list_digest)
        record = read_record()
        commits = [record_commit(revision) for revision in revisions]
        blobs = list(dict.fromkeys(
            blob for commit in commits
            for kind, blob, _ in tree_listing(["-r", "--full-tree", commit], f"git could not read the files of {commit}",
                                              f"git gave a malformed tree of {commit}")
            if kind == "blob"
        ))
        covered = record.covered(key) if record else set[str]()
        unread = [blob for blob in blobs if blob not in covered]
        sizes = {blob: size for blob, (_, size) in object_info(unread, "git could not read the files to record").items()}
        batches = bounded_chunks(unread, sizes.__getitem__, RECORD_BATCH_BYTES, RECORD_BATCH_BLOBS)
        clean = [blob for batch in batches for blob in clean_blobs(batch, matcher)]
        if clean:
            write_record(record, clean, f"pass {key}")
    except ListError as error:
        print(error, file=sys.stderr)
        return LIST_EXIT
    except (TextError, RecordError) as error:
        print(f"leak terms: record: {error}; nothing was recorded", file=sys.stderr)
        return RECORD_EXIT
    print(f"leak terms: record {RECORD_REF}: {len(blobs)} file versions in the trees of {len(commits)} commits: found "
          f"{len(blobs) - len(unread)} covered, read {len(unread)}, recorded {len(clean)}, did not record "
          f"{len(unread) - len(clean)}")
    return 0


def scan_push(text: str, remote: str, url: str) -> list[Finding]:
    """Scan outgoing commits, tags (their headers and messages), direct file and folder objects, and created or updated
    ref names, against the list every repository has and each scoped list whose scope reaches the destination URL."""
    local, prior_remote = push_updates(text)
    if not local:
        return []
    destination = push_destination(remote, url)
    advertised = remote_advertisement(destination)
    held = local_object_ids([*advertised, *prior_remote])
    commits = outgoing_commit_ids([object_id for _, object_id in local], sorted(held))
    tags, objects = outgoing_tags(local, [*advertised, *prior_remote], held)
    matcher, list_digest = record_terms(repository_of(url), drop_allowed=True)
    coverage = push_coverage(matcher, list_digest) if commits else None
    findings = scan_outgoing_commits(commits, matcher, coverage)
    if coverage is not None:
        print(coverage.summary(), file=sys.stderr)
    for name, content in tags:
        findings.extend(object_findings(content, f"tag {c_escape(name)}", matcher))
    findings.extend(scan_outgoing_objects(objects, commits, held, matcher))
    for remote_ref, _ in local:
        name = remote_ref.removeprefix("refs/heads/").removeprefix("refs/tags/")
        findings.extend(name_findings(f"ref {c_escape(name)}", name, matcher.spans(name)))
    return findings


# The text a gh call sends to GitHub, read before gh runs. shims/gh hands this check every call that can carry text, as
# `gh -- ARGV…`, on the pass that runs gh. Until 2026-11-17 nothing read that text, and an agent's
# `gh pr edit` put a listed term into a public pull request's body, where GitHub keeps it in the body's edit history,
# which only an admin can delete (dispatch://INFRA-4102).
#
# The threat is an agent's accidental leak of a listed term through gh. The check does not try to stop a deliberate
# evasion: anyone set on leaking can use curl. So it reads where a call goes only in the plain case, where every host
# gh knows is github.com (gh_plain_case), and copies no more of how gh resolves a host: outside the plain case a call
# that holds a listed term is refused, read as public, with the condition that made it so. A protection grown against
# an attack nobody has seen needs the owner's yes.

# A call that reads text from standard input exits so when GH_STDIN is not set. shims/gh then reads its stdin into a
# private unlinked file, runs the check again with GH_STDIN naming that open file (/dev/fd/N), and gives gh the same
# bytes when the check passes.
GH_STDIN_EXIT = 7
GH_STDIN = "DOTFILES_LEAK_TERMS_GH_STDIN"
# Every gh command that sends text, with its options as `gh <command> <subcommand> --help` lists them at gh 2.98.0, the
# version mise.toml pins: (the options that take a value, the options that take none), a short and a long spelling
# joined by `/`. shims/tests/test_gh_leak_terms.py compares the tables with the gh on PATH, so an upgrade that adds an
# option fails that test until the table has it. `gh api` is ("api", ""). `issue transfer` is not here: GitHub moves
