# The options whose value names a file whose text gh sends, `-` naming standard input.
GH_FILE_OPTIONS = frozenset(("--body-file", "--notes-file", "--from-file", "--recover", "--input"))
# Options whose value gh keeps to itself: a jq filter, a Go template or a format for its own output, a cache time.
GH_LOCAL_OPTIONS = frozenset((("api", "--jq"), ("api", "--template"), ("api", "--cache"), ("project", "--jq"),
                              ("project", "--template"), ("project", "--format")))
# The commands whose first argument is the repository the call goes to, as the usage of gh 2.98.0 names it
# (`gh repo edit [<repository>]`, `gh repo fork [<repository>]`), by OWNER/REPO or by its URL; read so by
# gh_argument_repository for gh_reach. Not `repo create [<name>]`, whose name a public create
# publishes, nor `repo rename [<new-name>]`; and `repo edit --visibility public` publishes the name of the repository
# it edits, which gh_check then reads (gh_made_public). shims/tests/test_gh_leak_terms.py compares it with the usage
# the gh on PATH prints.
GH_REPOSITORY_ARGUMENT = frozenset((("repo", "edit"), ("repo", "fork")))
# The commands whose arguments the usage of gh 2.98.0 names by URL (`<url>`, `<urls>`, `<discussion-url>`,
# `<comment-url>`, as in `gh pr comment [<number> | <url> | <branch>]` and `gh issue edit {<numbers> | <urls>}`): an
# http or https URL argument of one names the repository the call goes to (gh_argument_repository). A URL
# in an argument of any other command is text, such as the description `agent-task create` sends; until 2026-11-19 it
# too was read as where the call goes, so such a description that began with a private repository's URL went from a
# public checkout unread. A gist's URL names a gist, which has no repository. shims/tests/test_gh_leak_terms.py
# compares it with the usage the gh on PATH prints.
GH_URL_ARGUMENT = frozenset((
    ("pr", "edit"), ("pr", "comment"), ("pr", "review"), ("pr", "merge"), ("pr", "close"), ("pr", "reopen"),
    ("pr", "revert"), ("issue", "edit"), ("issue", "comment"), ("issue", "close"), ("issue", "reopen"),
    ("issue", "develop"), ("discussion", "edit"), ("discussion", "comment"), ("gist", "edit"), ("gist", "rename"),
))
# The placeholders gh 2.98.0 fills in a `gh api` endpoint and in each -F value but a file's (`@path`), each with where
# gh takes its value from: `base`, the base repository (`{owner}` its owner, `{repo}` its name: the base placeholders),
# GH_REPO's when that is set, else this directory's (gh_bases); `branch`, the current branch (gh_current_branch), which
# no base repository gives. The list is gh's own, from `gh api --help`: "Placeholder values `{owner}`, `{repo}`, and
# `{branch}` in the endpoint argument will get replaced with values from the repository of the current directory or
# the repository specified in the `GH_REPO` environment variable", and of -F, "placeholder values `{owner}`, `{repo}`,
# and `{branch}` get populated with values from the repository of the current directory".
# shims/tests/test_gh_leak_terms.py compares it with the help the gh on PATH prints. gh's pattern (pkg/cmd/api/api.go,
# placeholderRE) takes each as `:name` too, and leaves any other `{name}` as written; Go's `\b` is ASCII's. Until
# 2026-11-19 `{branch}` was left as written, so a branch whose name holds a listed term, as Legion's `legion/<KEY>`
# can, went to a public repository unread (dispatch://INFRA-3365, tester round 4).
GH_PLACEHOLDERS = {"owner": "base", "repo": "base", "branch": "branch"}
GH_PLACEHOLDER = re.compile(rf":({'|'.join(GH_PLACEHOLDERS)})\b|\{{([a-z]+)\}}", re.ASCII)
# The repository a `gh api` endpoint names by the `repos/O/R` that starts it, once gh has filled its placeholders.
GH_API_REPOSITORY = re.compile(r"^/?repos/([^/?#{}]+)/([^/?#{}]+)")
# What may follow the `repos/O/R` of an endpoint that is the repository's own, which a PATCH edits: a `/`, a query.
GH_API_REPOSITORY_END = re.compile(r"/?(?:[?#].*)?", re.DOTALL)
# The endpoints of GitHub's REST API that make a repository, public unless the call says private: the user's
# (`user/repos`), an organization's (`orgs/O/repos`), and a template's (`repos/O/R/generate`), whose new repository has
# the visibility the call gives it, whatever the template's.
GH_API_NEW_REPOSITORY = re.compile(
    r"/?(?:user/repos|orgs/[^/?#{}]+/repos|repos/[^/?#{}]+/[^/?#{}]+/generate)/?(?:[?#].*)?", re.DOTALL)
# A field or JSON member of a repository's own endpoint that makes the repository public, its value in lower case and
# without the whitespace around it, as gh sends it from -f or -F (JSON's `false` read as `false`; `-F visibility=@file`
# sends the file's line break too).
GH_PUBLISHING_FIELDS = frozenset((("visibility", "public"), ("private", "false")))
GH_GRAPHQL_MUTATION = re.compile(r"\bmutation\b")
JSON_ESCAPE = re.compile(r'\\(?:u([0-9A-Fa-f]{4})|(["\\/bfnrt]))')
JSON_SIMPLE_ESCAPES = {'"': '"', "\\": "\\", "/": "/", "b": "\b", "f": "\f", "n": "\n", "r": "\r", "t": "\t"}


@dataclass(frozen=True)
class GhText:
    """One text a gh call sends. OPTION says where it is (an option's long name, or `argument N`); DETAIL is the
    caller's own name for it (a path, a field's key) and PART which part of it this is (`key`, a field's key). The text
    is TEXT, or what the file PATH holds (`-`: standard input); an OPTIONAL file is read only when it can be. KEY is a
    field's key, which a GraphQL call's `query` field makes a document (gh_values); JSON_BODY says GitHub reads the text
    as JSON (an --input body, `workflow run --json`). BASES, for a text gh fills from the base repository (gh_filled),
    names the base repositories (GhBase.source) whose filling it is: gh sends that filling only when it takes one of
    them, so it goes only to a target the call reaches with one of them, or with none (gh_goes_to)."""

    option: str
    detail: str = ""
    text: str | None = None
    path: str | None = None
    optional: bool = False
    key: str | None = None
    part: str = ""
    json_body: bool = False
    bases: tuple[str, ...] = ()

    def shown(self) -> str:
        detail = f" {c_escape(self.detail)}" if self.detail else ""
        return (f"{self.option}{detail}{' (standard input)' if self.path == '-' else ''}"
                f"{f' ({self.part})' if self.part else ''}")


def gh_options(table: tuple[str, str]) -> dict[str, bool]:
    """Every spelling of each option of a GH_TEXT_COMMANDS entry: True for one that takes a value."""
    return {name: takes for takes, names in ((True, table[0]), (False, table[1])) for item in names.split()
            for name in item.split("/")}


def gh_long_names(table: tuple[str, str]) -> dict[str, str]:
    """The long spelling of each spelling of each option of a GH_TEXT_COMMANDS entry."""
    return {name: item.split("/")[-1] for item in f"{table[0]} {table[1]}".split() for name in item.split("/")}


def gh_config_directory(environment: Mapping[str, str]) -> Path:
    """gh's configuration directory, found as gh 2.98.0 finds it (config.ConfigDir)."""
    if environment.get("GH_CONFIG_DIR"):
        return Path(environment["GH_CONFIG_DIR"])
    if environment.get("XDG_CONFIG_HOME"):
        return Path(environment["XDG_CONFIG_HOME"]) / "gh"
    return Path(environment.get("HOME") or passwd_home()) / ".config" / "gh"


def yaml_scalar(value: str) -> str:
    """A one-line YAML scalar, as gh writes an alias: plain, 'single-quoted' or "double-quoted"."""
    value = value.strip()
    if len(value) >= 2 and value[0] == value[-1] == "'":
        return value[1:-1].replace("''", "'")
    if len(value) >= 2 and value[0] == value[-1] == '"':
        try:
            return json.loads(value)
        except json.JSONDecodeError:
            return value[1:-1]
    return re.sub(r"\s+#.*$", "", value)


def gh_alias(word: str, environment: Mapping[str, str]) -> str | None:
    """The expansion of the gh alias WORD in gh's config.yml, or None."""
    try:
        lines = (gh_config_directory(environment) / "config.yml").read_text(encoding="utf-8").splitlines()
    except (OSError, UnicodeDecodeError):
        return None
    inside = False
    for line in lines:
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        if not line[0].isspace():
            inside = line.rstrip() == "aliases:"
            continue
        entry = re.match(r"""^\s+("(?:[^"\\]|\\.)*"|'(?:[^']|'')*'|[^\s:][^:]*?)\s*:(?:\s+(.*))?$""", line)
        if inside and entry and yaml_scalar(entry.group(1)) == word:
            return yaml_scalar(entry.group(2) or "")
    return None


def gh_expand_alias(expansion: str, arguments: Sequence[str]) -> list[str] | None:
    """gh 2.98.0's expansion of an alias (`$1`… take the arguments, the rest follow), or None where gh refuses it."""
    extra: list[str] = []
    for number, argument in enumerate(arguments, start=1):
        if "$" not in expansion:
            extra.append(argument)
        else:
            expansion = expansion.replace(f"${number}", argument)
    if re.search(r"\$\d", expansion):
        return None
    try:
        return [*shlex.split(expansion), *extra]
    except ValueError:
        return None


def gh_next_command(arguments: Sequence[str]) -> tuple[str, list[str]] | None:
    """cobra's reading of a command word in ARGUMENTS: the first word that is neither an option nor an option's value
    (`gh -R o/r pr comment 1` and `gh pr -R o/r comment 1` are both `gh pr comment`), and the other words, which go on
    to the command. As cobra's stripFlags does, an option written apart from any value, but --help and --version, is
    taken to have its value in the next word."""
    index = 0
    while index < len(arguments):
        word = arguments[index]
        if word == "--":
            return None
        if (word.startswith("-") and "=" not in word and word not in ("--help", "--version")
                and (word.startswith("--") or len(word) == 2)):
            index += 2
        elif word.startswith("-"):
            index += 1
        else:
            return word, [*arguments[:index], *arguments[index + 1:]]
    return None


def gh_command(arguments: Sequence[str], environment: Mapping[str, str],
               depth: int = 0) -> tuple[str, str, list[str]] | None:
    """(group, subcommand, the arguments the subcommand reads) of a gh call that can send text, after a gh alias;
    None for any other call."""
    found = gh_next_command(arguments)
    if found is None:
        return None
    first, rest = found
    if first not in GH_COMMANDS:
        return gh_alias_command(first, rest, environment, depth)
    group = GH_GROUP_ALIASES.get(first, first)
    if group == "api":
        return group, "", rest
    found = gh_next_command(rest)
    if found is None:
        return None
    word, rest = found
    sub = GH_SUBCOMMAND_ALIASES.get((group, word), word)
    if (group, sub) in GH_TEXT_COMMANDS:
        return group, sub, rest
    # An alias under a command (`gh alias set 'pr say' 'pr comment'`), which gh runs as what it expands to. Until
    # 2026-11-17 only an alias of the first word was read, so `gh pr say 11 --body …` went out unchecked.
    return gh_alias_command(f"{first} {word}", rest, environment, depth)


def gh_alias_command(name: str, rest: Sequence[str], environment: Mapping[str, str],
                     depth: int) -> tuple[str, str, list[str]] | None:
    """gh_command of what the gh alias NAME runs with REST; None for no such alias, for a shell alias (`!…`), which
    runs a shell whose own gh calls come back through shims/gh, and past three aliases in a row."""
    expansion = gh_alias(name, environment) if depth < 3 else None
    expanded = None if expansion is None or expansion.startswith("!") else gh_expand_alias(expansion, rest)
    return gh_command(expanded, environment, depth + 1) if expanded else None


def gh_walk(arguments: Sequence[str], options: Mapping[str, bool]) -> list[tuple[str | None, str | None]]:
    """Read ARGUMENTS as gh's flag parser (spf13/pflag) does: one (option, value) for each option given, its value None
    when it has none, and one (None, word) for each positional argument. An option gh does not know makes gh refuse
    the call, and is read here as one that takes no value."""
    read: list[tuple[str | None, str | None]] = []
    index = 0
    while index < len(arguments):
        word = arguments[index]
        index += 1
        if word == "--":
            read.extend((None, rest) for rest in arguments[index:])
            break
        if word.startswith("--") and len(word) > 2:
            name, attached, value = word.partition("=")
            if attached:
                read.append((name, value))
            elif options.get(name) and index < len(arguments):
                read.append((name, arguments[index]))
                index += 1
            else:
                read.append((name, None))
            continue
        if word.startswith("-") and len(word) > 1:
            letters = word[1:]
            while letters:
                name, rest = "-" + letters[0], letters[1:]
                if len(rest) > 1 and rest[0] == "=":
                    read.append((name, rest[1:]))
                    break
                if options.get(name):
                    if not rest and index < len(arguments):
                        rest = arguments[index]
                        index += 1
                    read.append((name, rest or None))
                    break
                read.append((name, None))
                if name not in options:
                    break
                letters = rest
            continue
        read.append((None, word))
    return read


def gh_fill(text: str, repository: str, branch: str | None) -> str:
    """TEXT as gh sends it once it has filled each placeholder `gh api --help` lists (GH_PLACEHOLDERS, GH_PLACEHOLDER),
    in one pass, so that a value it fills in is never filled again: the base placeholders from the base REPOSITORY
    (`owner/name`), left as written when that is "" (no base repository, or one the check cannot read); `{branch}` and
    `:branch` with BRANCH, the current branch (gh_current_branch), left as written when that is None (no branch to
    fill, or one git does not name, for which gh sends nothing: gh_check, gh_api_endpoint); and every other placeholder
    as written."""
    owner, _, name = repository.partition("/")

    def fill(found: re.Match[str]) -> str:
        word = found[1] or found[2]
        if word == "branch":
            return found[0] if branch is None else branch
        if not repository:
            return found[0]
        return owner if word == "owner" else name if word == "repo" else found[0]

    return GH_PLACEHOLDER.sub(fill, text)


def gh_placeholders(text: str) -> set[str]:
    """Where gh takes the value of each placeholder TEXT holds that gh fills (GH_PLACEHOLDERS): `base`, `branch`."""
    return {GH_PLACEHOLDERS[word] for found in GH_PLACEHOLDER.finditer(text)
            if (word := found[1] or found[2]) in GH_PLACEHOLDERS}


def gh_is_filled(piece: GhText) -> bool:
    """Whether gh fills the placeholders of PIECE, a text of a `gh api` call: its endpoint (`argument 1`), and each -F
    value but a file's (pkg/cmd/api/fields.go, magicFieldValue)."""
    return piece.option == "argument 1" or (piece.option == "--field" and piece.path is None and piece.part != "key")


def gh_source_name(path: str) -> str:
    """The name `gh repo create --source PATH` gives the repository it makes when it is given no name: the last part of
    PATH made absolute as gh 2.98.0 makes it (pkg/cmd/repo/create, filepath.Abs), from the working directory as Go's
    os.Getwd gives it, which is PWD when that names the same directory."""
    if not os.path.isabs(path):
        directory = os.getcwd()
        logical = os.environ.get("PWD", "")
        try:
            if logical.startswith("/") and os.path.samefile(logical, directory):
                directory = logical
        except OSError:
            pass
        path = os.path.join(directory, path)
    return os.path.basename(os.path.normpath(path))


# The hosts go-gh v2.13.0's auth package and gh 2.98.0's internal/ghinstance name apart: the local development host, the
# domain of a tenancy (GHE.com) host, and garage.github.com, which ghinstance serves as it serves an Enterprise host.
GH_LOCALHOST = "github.localhost"
GH_TENANCY = "ghe.com"
GH_GARAGE = "garage.github.com"


def gh_normalized_host(host: str) -> str:
    """HOST as go-gh v2.13.0's auth.NormalizeHostname reads it (pkg/auth/auth.go), by which gh 2.98.0 tells a host's
    kind: in lower case; github.com for a host ending in `.github.com`, github.localhost for one ending in
    `.github.localhost`, and for one ending in `.ghe.com` its last label before `.ghe.com`, with `.ghe.com`."""
    host = host.lower()
    if host.endswith(".github.com"):
        return "github.com"
    if host.endswith(f".{GH_LOCALHOST}"):
        return GH_LOCALHOST
    if host.endswith(f".{GH_TENANCY}"):
        return f"{host.removesuffix(f'.{GH_TENANCY}').rpartition('.')[2]}.{GH_TENANCY}"
    return host


def gh_is_tenancy(host: str) -> bool:
    """go-gh's auth.IsTenancy: whether HOST is a tenancy (GHE.com) host once normalized (gh_normalized_host)."""
    return gh_normalized_host(host).endswith(f".{GH_TENANCY}")


def gh_is_enterprise(host: str) -> bool:
    """go-gh's auth.IsEnterprise: whether HOST is a GitHub Enterprise Server host, which is any host that is not
    github.com, github.localhost or a tenancy host once normalized (gh_normalized_host), so `example.com` is, and so is
    `github.com.`."""
    normalized = gh_normalized_host(host)
    return normalized not in ("github.com", GH_LOCALHOST) and not gh_is_tenancy(normalized)


def gh_host(host: str) -> str:
    """The host gh 2.98.0 sends a call for HOST to: github.com for each host go-gh v2.13.0's auth.NormalizeHostname
    makes github.com (gh_normalized_host), which its API clients apply before they build the request's URL
    (pkg/api/rest_client.go restPrefix, graphql_client.go graphQLEndpoint), but garage.github.com, which they send to
    itself (`if isGarage(host)` comes first); any other host, in lower case, is its own. The reviewer of
    dispatch://INFRA-3365 measured `gh pr view https://foo.github.com/sjawhar/dotfiles/pull/90 --json url` printing the
    github.com URL; until 2026-11-19 only github.com and www.github.com were github.com, so a comment on such a URL
    of a public repository was judged by the checkout's private remote and went out unread."""
    host = host.lower()
    return "github.com" if host != GH_GARAGE and gh_normalized_host(host) == "github.com" else host


def gh_url_repository(value: str) -> tuple[str, str] | None:
    """(the host gh sends the call to, gh_host; the `owner/name`) of VALUE when it is an http or https URL whose path
    starts with an owner and a name, as gh 2.98.0 reads a URL argument (pkg/cmd/pr/shared/finder.go ParseURL, and the
    issue and discussion lookups: url.Parse, then ghrepo.NewWithHost of the path's first two parts and u.Hostname(),
    the host without a user or a port, so https://x@github.com:443/o/r/pull/1 is github.com's o/r); else None."""
    try:
        address = urllib.parse.urlsplit(value)
        host = address.hostname
    except ValueError:
        return None
    parts = address.path.split("/")
    if address.scheme not in ("http", "https") or not host or len(parts) < 3 or not (parts[1] and parts[2]):
        return None
    return gh_host(host), f"{parts[1]}/{parts[2]}"


def gh_argument_repository(group: str, sub: str, number: int, value: str) -> tuple[str, str, str] | None:
    """(the repository; the host gh sends the call to and the repository's URL, as gh_repository_address gives them)
    when positional argument NUMBER, VALUE, names the repository the call goes to: as an http or https URL
    (gh_url_repository) in an argument of a GH_URL_ARGUMENT command or in the repository argument of a
    GH_REPOSITORY_ARGUMENT one, or as that repository argument in any other form gh reads (`[HOST/]OWNER/REPO`, a git
    URL). gh_reach reads that repository as a target, on that host. None for any other argument, a
    URL in one included, for each argument of a gist, which has no repository (the later arguments of `gist rename` are
    the file names it sends), and for the endpoint of `gh api`, which gh_reach reads once gh has filled its
    placeholders. Until review round 2 of dispatch://INFRA-3365 a repository argument that is not a URL was given
    github.com as its host, so `ghe.example.com/o/r` was a github.com repository whose visibility could not be read."""
    if group in ("gist", "api"):
        return None
    repository_argument = (group, sub) in GH_REPOSITORY_ARGUMENT and number == 1
    named = gh_url_repository(value) if repository_argument or (group, sub) in GH_URL_ARGUMENT else None
    if named:
        return named[1], *gh_repository_address(value)
    if repository_argument:
        return value, *gh_repository_address(value)
    return None


def gh_argument_texts(group: str, sub: str, number: int, value: str) -> list[GhText]:
    """The text gh sends for its positional argument NUMBER: the word itself, or for a file, its name and what it holds."""
    option = f"argument {number}"
    if (group, sub) == ("gist", "create"):
        if value == "-":
            return [GhText(option, value, path=value)]
        texts: list[GhText] = []
        for path in sorted(glob.glob(value)) or [value]:
            texts += [GhText(option, path, path=path), GhText(f"{option} name", text=os.path.basename(path))]
        return texts
    if (group, sub) == ("gist", "edit") and number == 2:
        return [GhText(option, value, path=value)]
    if (group, sub) in (("release", "create"), ("release", "upload")) and number >= 2:
        # An asset: gh sends its file name and the label after a `#`. Its content is a build output, not text.
        path, _, label = value.partition("#")
        return [GhText(f"{option} name", text=os.path.basename(path)), GhText(f"{option} label", text=label)]
    return [GhText(option, text=value)]


def gh_texts(group: str, sub: str, read: Sequence[tuple[str | None, str | None]]) -> list[GhText]:
    """Every text the call sends: each argument and option value, each whole, but those gh keeps to itself
    (GH_LOCAL_OPTIONS), and for a file gh reads, what the file holds; a field's key and its value are two texts, as
    GitHub stores them. The repository the call goes to (`-R`, a URL, an endpoint) is text too: a term inside the own
    name of a public destination counts for nothing there (gh_own_name). A `repo create --source DIR` given no name
    names the new repository after DIR (gh_source_name), which is read as `--source name`."""
    long = gh_long_names(GH_TEXT_COMMANDS[(group, sub)])
    texts: list[GhText] = []
    number = 0
    for option, value in read:
        if option is None:
            number += 1
            texts += gh_argument_texts(group, sub, number, value or "")
            continue
        name = long.get(option, option)
        if (group, name) in GH_LOCAL_OPTIONS:
            continue
        if value is None:
            if (group, sub, name) == ("workflow", "run", "--json"):
                texts.append(GhText(name, path="-", json_body=True))
            continue
        if name in GH_FILE_OPTIONS:
            texts.append(GhText(name, value, path=value, json_body=name == "--input"))
        elif (group, sub, name) == ("gist", "edit", "--add"):
            texts += [GhText(name, value, path=value), GhText(f"{name} name", text=os.path.basename(value))]
        elif (group, sub, name) == ("pr", "create", "--template"):
            # A template's name, which gh also reads as a file's path when there is such a file.
            texts += [GhText(name, text=value), GhText(name, value, path=value, optional=True)]
        elif group in ("api", "workflow") and name in ("--field", "--raw-field"):
            key, _, field_value = value.partition("=")
            texts.append(GhText(name, key, text=key, part="key"))
            if name == "--field" and field_value.startswith("@"):
                texts.append(GhText(name, value, path=field_value[1:], key=key))
            else:
                texts.append(GhText(name, key, text=field_value, key=key))
        else:
            texts.append(GhText(name, text=value))
    if (group, sub) == ("gist", "create") and number == 0:
        texts.append(GhText("gist", path="-"))
    sources = [value for option, value in read if option and long.get(option, option) == "--source"]
    if (group, sub) == ("repo", "create") and number == 0 and sources and sources[-1]:
        texts.append(GhText("--source name", text=gh_source_name(sources[-1])))
    return texts


def gh_flag(read: Sequence[tuple[str | None, str | None]], long: Mapping[str, str], name: str) -> bool:
    """Whether the bool option whose long spelling is NAME is on: the last one given wins, and one with no value is on."""
    values = [value for option, value in read if option and long.get(option, option) == name]
    return bool(values) and (values[-1] or "true").lower() in ("1", "t", "true")


def gh_git(arguments: Sequence[str]) -> str | None:
    """What `git ARGUMENTS` prints in this directory, as gh's own git calls run there; None when it fails."""
    try:
        completed = subprocess.run(["git", *arguments], stdin=subprocess.DEVNULL, capture_output=True, timeout=60,
                                   check=False)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return completed.stdout.decode("utf-8", errors="surrogateescape") if completed.returncode == 0 else None


def gh_current_branch() -> str | None:
    """The current branch, with which gh 2.98.0 fills `{branch}` and `:branch` (git.Client.CurrentBranch): the first
    line `git symbolic-ref --quiet HEAD` prints in this directory, without `refs/heads/`, an unborn branch's too; None
    when git fails, as it does on a detached HEAD and outside a git repository. gh_check reads it once, for a call that
    has a branch to fill."""
    printed = gh_git(["symbolic-ref", "--quiet", "HEAD"])
    return None if printed is None else printed.partition("\n")[0].removeprefix("refs/heads/")


def gh_fill_bases(read: Sequence[tuple[str | None, str | None]], long: Mapping[str, str], head: str) -> list[str]:
    """Every ref `pr create --fill` may list the head's commits against, as gh 2.98.0 picks it (pkg/cmd/pr/create):
    the branch `--base` names, else the head's `branch.<head>.gh-merge-base`, else the base repository's default
    branch, which gh asks GitHub for, read here as each remote's HEAD (else `main` and `master`); gh takes it on the
    base repository's remote, else as a local name, so each name counts on every remote and locally. Only the refs
    that exist are given."""
    bases = [value for option, value in read if option and long.get(option, option) == "--base" and value]
    names = bases[-1:]
    if not names:
        merge_base = (gh_git(["config", "--get", f"branch.{head}.gh-merge-base"]) or "").strip()
        names = [merge_base] if merge_base else []
    if not names:
        heads = gh_git(["for-each-ref", "--format=%(symref)", "refs/remotes/*/HEAD"]) or ""
        names = sorted({line.split("/", 3)[3] for line in heads.split() if line.count("/") >= 3}) or ["main", "master"]
    refs = set((gh_git(["for-each-ref", "--format=%(refname)", "refs/remotes", "refs/heads"]) or "").split())
    return [ref for ref in sorted(refs) if any(ref == f"refs/heads/{name}" or
                                               (ref.startswith("refs/remotes/") and ref.split("/", 3)[3:] == [name])
                                               for name in names)]


def gh_local_texts(group: str, sub: str, read: Sequence[tuple[str | None, str | None]]
                   ) -> tuple[list[tuple[GhText, str]], list[tuple[GhText, str]]]:
    """The text gh reads from this directory's git and sends, each with what it holds, and each it cannot read with
    why: for `release create --notes-from-tag` the tag's message (`git tag --list TAG --format=%(contents)`); for
    `pr create --fill`, `--fill-first` or `--fill-verbose` the message of each commit of the head branch that a base
    gh may list it against does not hold (gh_fill_bases), and the head branch's name, which gh makes the title of a
    pull request of more than one commit, with `-` and `_` read as spaces as gh writes them. Until 2026-11-17 neither
    was read, on the ground that it was pushed already; but the tag may be local, and a push reads no knives registry
    list."""
    long = gh_long_names(GH_TEXT_COMMANDS[(group, sub)])
    contents: list[tuple[GhText, str]] = []
    unreadable: list[tuple[GhText, str]] = []
    positionals = [value or "" for option, value in read if option is None]
    if (group, sub) == ("release", "create") and gh_flag(read, long, "--notes-from-tag") and positionals:
        piece = GhText("--notes-from-tag", f"tag {positionals[0]}")
        message = gh_git(["tag", "--list", positionals[0], "--format=%(contents)"])
        if message is None:
            unreadable.append((piece, "git could not read the tag's message"))
        else:
            contents.append((piece, message))
    fill = next((name for name in ("--fill", "--fill-first", "--fill-verbose") if gh_flag(read, long, name)), None)
    if (group, sub) != ("pr", "create") or fill is None:
        return contents, unreadable
    heads = [value for option, value in read if option and long.get(option, option) == "--head" and value]
    head = heads[-1].rpartition(":")[2] if heads else (gh_git(["symbolic-ref", "--quiet", "--short", "HEAD"]) or "").strip()
    bases = gh_fill_bases(read, long, head) if head else []
    if not bases:
        unreadable.append((GhText(fill, "commits"), "git names no head branch, or no base branch to list it against"))
        return contents, unreadable
    seen: set[str] = set()
    for base in bases:
        listed = gh_git(["log", "--no-show-signature", "--format=%H%x00%B%x00", head, "--not", base, "--"])
        if listed is None:
            unreadable.append((GhText(fill, "commits"), f"git could not list the commits of {head}"))
            return contents, unreadable
        fields = listed.split("\0")
        for commit, message in zip(fields[0::2], fields[1::2]):
            commit = commit.strip()
            if commit not in seen:
                seen.add(commit)
                contents.append((GhText(fill, f"commit {commit[:12]}"), message))
    contents.append((GhText(fill, "head branch name"), re.sub(r"[-_]", " ", head)))
    return contents, unreadable


# The hosts of github.com's REST and GraphQL API, and of its release-asset uploads.
GH_API_HOSTS = frozenset(("api.github.com", "uploads.github.com"))
# A host of gh's hosts.yml: a key at the start of a line, plain, 'single-quoted' or "double-quoted", as gh writes it.
GH_HOSTS_KEY = re.compile(r"""^("(?:[^"\\]|\\.)*"|'(?:[^']|'')*'|[^\s#:'"][^:]*?)[ \t]*:(?:\s|$)""")


def gh_default_host(environment: Mapping[str, str]) -> str:
    """The host gh 2.98.0 sends a `gh api` call to when no --hostname names one (pkg/cmd/api/api.go apiRun:
    cfg.Authentication().DefaultHost(), go-gh v2.13.0's pkg/auth/auth.go defaultHost): GH_HOST, else the one host gh's
    hosts.yml lists when it lists exactly one, else github.com, which is also the host when hosts.yml cannot be read."""
    if environment.get("GH_HOST"):
        return environment["GH_HOST"]
    try:
        lines = (gh_config_directory(environment) / "hosts.yml").read_text(encoding="utf-8").splitlines()
    except (OSError, UnicodeDecodeError):
        return "github.com"
    hosts = [yaml_scalar(found[1]) for line in lines if (found := GH_HOSTS_KEY.match(line))]
    return hosts[0] if len(hosts) == 1 else "github.com"


def gh_api_address(host: str, endpoint: str) -> str:
    """The address gh 2.98.0 sends a `gh api` ENDPOINT that holds no `://`, its placeholders filled, to on HOST, the
    host as gh takes it (pkg/cmd/api/http.go httpRequest; internal/ghinstance GraphQLEndpoint and RESTPrefix):
    `graphql`, exactly, to the host's GraphQL API, and any other endpoint to its REST API with one leading `/` dropped.
    Both are under `https://HOST/api/` for garage.github.com and an Enterprise host (gh_is_enterprise), the REST API
    under its `v3/`; under `http://api.github.localhost/` for github.localhost; and under `https://api.HOST/` for any
    other host, github.com and a tenancy host among them."""
    enterprise = host.lower() == GH_GARAGE or gh_is_enterprise(host)
    if enterprise:
        root = f"https://{host}/api/"
    elif host.lower() == GH_LOCALHOST:
        root = f"http://api.{host}/"
    else:
        root = f"https://api.{host}/"
    if endpoint == "graphql":
        return f"{root}graphql"
    return root + ("v3/" if enterprise else "") + endpoint.removeprefix("/")


def dot_segments_removed(path: str) -> str:
    """PATH with its `.` and `..` segments removed as RFC 3986 removes them (section 5.2.4, remove_dot_segments), so
    `/api/v3/../graphql` is `/api/graphql`; an empty segment stays, so `//graphql` is itself."""
    output: list[str] = []
    while path:
        if path.startswith(("../", "./")):
            path = path.partition("/")[2]
        elif path.startswith("/./") or path == "/.":
            path = "/" + path[3:]
        elif path.startswith("/../") or path == "/..":
            path = "/" + path[4:]
            if output:
                output.pop()
        elif path in (".", ".."):
            path = ""
        else:
            end = path.find("/", 1)
            output.append(path if end < 0 else path[:end])
            path = "" if end < 0 else path[end:]
    return "".join(output)


# The path of GitHub's GraphQL API on api.github.com (gh_graphql_api). Measured 2026-11-19 through gh 2.98.0, each call
# sending `-f query='query { viewer { login } }'` (dispatch://INFRA-3365, review round 6): GitHub answered with the
# query's `data` for the endpoints `graphql`, `/graphql`, `graphql?`, `graphql?x=1`, `graphql#x`, `/graphql?x=1#y`,
# `https://api.github.com/graphql?x=1`, `https://api.github.com/graphql#x`, `https://API.GITHUB.COM/graphql` and
# `HTTPS://api.github.com/graphql`, and for `--hostname github.com graphql`: gh sends each to the path `/graphql`, with
# its query string, and keeps a fragment to itself. It answered 404 for `graphql/`, `//graphql`, `./graphql`,
# `x/../graphql`, `api/graphql`, `graphql.json`, `graphql;x=1`, `graphql%3Fx`, `graphql%20`, `graphql%2F`,
# `%67raphql`, `/%67raphql`, `graphq%6c`, `https://api.github.com//graphql`, `https://api.github.com/./graphql`,
# `https://api.github.com/graphql/` and `https://api.github.com/%67raphql`; 502 for `GRAPHQL` and `Graphql`, which
# are read as GraphQL all the same (the path in any letter case), since a 502 does not say GitHub ran nothing; and 400,
# "Multipart form data required", for `https://uploads.github.com/graphql`. `-X GET graphql`, and
# `http://api.github.com/graphql`, which GitHub redirects to https and gh follows as a GET, were answered with the
# schema, not the query; a GET sends no body (gh_api_sends), and http is read as GraphQL all the same.
# `https://api.github.com:443/graphql` went out with no token, since gh sends none to a host written with a port, and
# GitHub refused it for the rate limit of a call with no token; it is read as GraphQL too. `./graphql`, `x/../graphql`
# and `https://api.github.com/./graphql` are read with their dot segments removed, as GraphQL, erring toward it.
# Measured the same way in review round 7: `https://github.com/api/graphql` and `https://github.com/graphql` answered
# 422 with a web page, `https://api.github.com./graphql` 400, and `--hostname github.com. graphql`, which gh sends to
# `https://github.com./api/graphql` since go-gh reads `github.com.` as an Enterprise host, 404. None is GitHub's
# GraphQL API; the last is GraphQL all the same by gh's own test (gh_api_endpoint).
GH_GRAPHQL_PATH = "/graphql"
# The path of the GraphQL API of garage.github.com and of an Enterprise host, under its `api/` (gh_api_address).
GH_ENTERPRISE_GRAPHQL_PATH = "/api/graphql"


def gh_graphql_api(address: str) -> bool | None:
    """Whether ADDRESS is a GraphQL API's, as gh_api_address builds one for any host: http or https, with the path
    GH_GRAPHQL_PATH on api.github.com, api.github.localhost or the `api.` host of a tenancy host (gh_is_tenancy), or
    GH_ENTERPRISE_GRAPHQL_PATH on garage.github.com or an Enterprise host (gh_is_enterprise). The path is read without
    its query string and fragment, in any letter case and with its dot segments removed (dot_segments_removed), the
    last two erring toward GraphQL; None for an address the check cannot read."""
    try:
        parts = urllib.parse.urlsplit(address)
        host = parts.hostname or ""
    except ValueError:
        return None
    if parts.scheme.lower() not in ("http", "https"):
        return False
    path = dot_segments_removed(parts.path).lower()
    if path == GH_GRAPHQL_PATH:
        return (host in ("api.github.com", f"api.{GH_LOCALHOST}")
                or host.startswith("api.") and gh_is_tenancy(host.removeprefix("api.")))
    return path == GH_ENTERPRISE_GRAPHQL_PATH and (host == GH_GARAGE or gh_is_enterprise(host))


@dataclass(frozen=True)
class GhAddress:
    """Where a gh call goes, resolved once for every reader in gh_check (gh_api_endpoint, for a `gh api` call): HOST,
    the host gh sends it to as gh_host reads it, which gh_reach reads for its targets; and for a `gh api` call
    ENDPOINT, its endpoint as a path on that host's API with its placeholders as written; SHAPE, that path filled in
    with any base name (gh_made_public); FILLINGS, that path as gh fills it from each base repository it may take, when
    it holds a base placeholder (gh_fill); URLS, each address gh may send it to, every placeholder filled, one for each
    filling the check can make (gh_api_address); GRAPHQL, whether the call is read as a GraphQL request; and REST,
    whether gh may send it to an address that is no GraphQL API."""

    host: str
    endpoint: str = ""
    shape: str = ""
    fillings: tuple[tuple[GhBase, str], ...] = ()
    urls: tuple[str, ...] = ()
    graphql: bool = False
    rest: bool = False


def gh_api_endpoint(read: Sequence[tuple[str | None, str | None]], environment: Mapping[str, str], branch: str | None,
                    bases: Callable[[], Sequence[GhBase]]) -> GhAddress:
    """Where a `gh api` call goes (GhAddress), resolved once, in gh 2.98.0's order: gh fills the endpoint's
    placeholders first (pkg/cmd/api/api.go apiRun, fillPlaceholders), from the base repository (BASES, gh_bases, read
    only for an endpoint with a base placeholder) and the current BRANCH (gh_fill), then builds the address from the
    filled endpoint (pkg/cmd/api/http.go httpRequest): one holding `://` is the address itself, whatever --hostname and
    GH_HOST say, and any other an address on the host the last --hostname names, else on gh's default host
    (gh_default_host), any host at all (gh_api_address).

    The call is GraphQL (GhAddress.graphql) when, for a filling of its endpoint, gh sends it to a GraphQL API: the
    filled endpoint is `graphql`, gh's own test, or the address it reaches is a GraphQL API's (gh_graphql_api). It is
    GraphQL too, failing closed, when the check cannot fill the endpoint for certain: from a base repository it cannot
    read, or with no base repository it can take, since gh may take one the check does not read; with a branch git does
    not name (BRANCH None: GH_REPO set, a detached HEAD, no git repository), for which gh refuses the call; and when the
    address cannot be read. gh may send the call to an address that is no GraphQL API (GhAddress.rest) for a filling
    that is not GraphQL and for a base repository the check cannot read, but never for a branch git does not name.

    The host gh_reach reads (GhAddress.host) is the one gh sends to, read as gh_host reads it: for a host
    NormalizeHostname makes github.com, gh_api_address builds `https://api.<host>/`, a name under github.com
    (api.foo.github.com has no address, so gh sends nothing at all). An http or https address on api.github.com or
    uploads.github.com is github.com's, with its path (and query) as the endpoint, so
    `https://uploads.github.com/repos/O/R/releases/1/assets?name=x` is O/R's as `repos/O/R/…` is, and
    `https://api.github.com/graphql` is `graphql`. An address on any other host is that host's.

    Until 2026-11-17 neither host was read: an address named no repository, so a private repository's own release
    upload with a scoped term in its address was refused, and a call with --hostname was judged as github.com's although
    gh sent it to the other host. Until review round 7 of dispatch://INFRA-3365 a call was GraphQL only on github.com,
    decided before gh fills the placeholders, and two more readers read the endpoint apart: so a mutation to
    `--hostname ghe.example.com graphql`, or to `{branch}` on a branch named `graphql`, was read as a REST body, as
    written, and a term spelled with a GraphQL `\\u` escape went out."""
    long = gh_long_names(GH_TEXT_COMMANDS[("api", "")])
    written = next((value or "" for option, value in read if option is None), "")
    hostnames = [value for option, value in read if option and long.get(option, option) == "--hostname" and value]
    named = hostnames[-1] if hostnames else gh_default_host(environment)
    host, endpoint = gh_host(named), written
    if "://" in written:
        try:
            given = urllib.parse.urlsplit(written)
            hostname = given.hostname or ""
        except ValueError:
            host = "an address gh was given that the check cannot read"
        else:
            if given.scheme.lower() in ("http", "https") and hostname in GH_API_HOSTS:
                host, endpoint = "github.com", given.path.lstrip("/") + (f"?{given.query}" if given.query else "")
            else:
                host = hostname or "an address gh was given that names no host"
    shape = gh_fill(endpoint, "owner/repo", branch)
    placeholders = gh_placeholders(written)
    if "branch" in placeholders and branch is None:
        return GhAddress(host, endpoint, shape, graphql=True)
    fillings: tuple[tuple[GhBase, str], ...] = ()
    filled: list[str | None] = [gh_fill(written, "", branch)]
    if "base" in placeholders:
        known = bases()
        fillings = tuple((base, gh_fill(endpoint, base.repository, branch)) for base in known)
        filled = [gh_fill(written, base.repository, branch) if base.repository else None for base in known] or [None]
    urls: list[str] = []
    graphql = rest = False
    for value in filled:
        if value is None:
            graphql = rest = True
            continue
        urls.append(value if "://" in value else gh_api_address(named, value))
        api = value == "graphql" or gh_graphql_api(urls[-1])
        graphql = graphql or api is not False
        rest = rest or api is not True
    return GhAddress(host, endpoint, shape, fillings, tuple(urls), graphql, rest)


# The path of a release's assets, where GitHub stores the request's body as an asset's bytes.
GH_UPLOAD_PATH = re.compile(r"^/?repos/[^/]+/[^/]+/releases/[0-9]+/assets(?:[/?#]|$)")


def gh_is_upload(group: str, sub: str, address: GhAddress) -> bool:
    """Whether the call uploads a release asset, whose body GitHub stores as the bytes gh sends and never decodes:
    `gh release upload`, or a `gh api` call to a release's assets path (GH_UPLOAD_PATH, GhAddress.endpoint) or to an
    address on uploads.github.com (GhAddress.urls). Such a body is read as written, never as JSON (gh_values): until
    the review of dispatch://INFRA-4383 every --input was read as JSON, and an asset's `\\u002f`, decoded into the `/`
    of a token the repository allows, sent the scoped term the token held although the uploaded bytes hold no such
    token."""
    if (group, sub) == ("release", "upload") or GH_UPLOAD_PATH.match(address.endpoint):
        return True
    for url in address.urls:
        try:
            if urllib.parse.urlsplit(url).hostname == "uploads.github.com":
                return True
        except ValueError:
            pass
    return False


def gh_api_sends(read: Sequence[tuple[str | None, str | None]]) -> bool:
    """Whether a `gh api` call sends a body: a method other than GET or HEAD, else (gh's default POST) a field or an
    --input file."""
    long = gh_long_names(GH_TEXT_COMMANDS[("api", "")])
    method: str | None = None
    body = False
    for option, value in read:
        name = long.get(option, option) if option else None
        if name == "--method" and value is not None:
            method = value
        elif name in ("--field", "--raw-field", "--input") and value is not None:
            body = True
    return method.upper() not in ("GET", "HEAD") if method is not None else body


def gh_is_stdin(path: str) -> bool:
    """Whether PATH (/dev/stdin, /dev/fd/0, …) is this call's standard input while that is a pipe or a terminal, which
    gh reads after the check: the check then reads the shim's buffer of it, as for `-`."""
    try:
        named, standard = os.stat(path), os.fstat(0)
    except OSError:
        return False
    return not stat.S_ISREG(standard.st_mode) and os.path.samestat(named, standard)


def gh_contents(texts: Sequence[GhText], stdin: str | None) -> tuple[list[tuple[GhText, str]], list[tuple[GhText, str]]]:
    """Each text with what gh sends for it, and each file that cannot be read with why. A pipe, a socket or a device
    other than /dev/null is not read: reading a pipe takes the text gh reads after the check (until 2026-11-17 a
    `--body-file <(…)` went out empty, and a `gh pr edit --body-file /dev/stdin` emptied the body), and a device may
    never end. Such a file cannot be read, so its text is refused for a target not confirmed private (gh_check)."""
    contents: list[tuple[GhText, str]] = []
    unreadable: list[tuple[GhText, str]] = []
    for piece in texts:
        if piece.path is None:
            contents.append((piece, piece.text or ""))
        elif piece.path == "-":
            if stdin is None:
                unreadable.append((piece, "standard input could not be read"))
            else:
                contents.append((piece, stdin))
        else:
            try:
                mode = os.stat(piece.path).st_mode
                if (stat.S_ISFIFO(mode) or stat.S_ISSOCK(mode) or stat.S_ISCHR(mode) or stat.S_ISBLK(mode)) and \
                        not os.path.samestat(os.stat(piece.path), os.stat(os.devnull)):
                    if not piece.optional:
                        unreadable.append((piece, "a pipe or a device, which the check cannot read without taking its "
                                                  "text from gh: pass the text in a file, or on standard input as -"))
                    continue
                data = Path(piece.path).read_bytes()
            except OSError as error:
                if not piece.optional:
                    unreadable.append((piece, error.strerror or type(error).__name__))
                continue
            contents.append((piece, data.decode("utf-8", errors="surrogateescape")))
    return contents, unreadable


def surrogates_joined(text: str) -> str:
    """TEXT with each pair of UTF-16 surrogates, which a \\u escape spells one at a time, joined into its letter."""
    try:
        return text.encode("utf-16", "surrogatepass").decode("utf-16")
    except UnicodeError:
        return text


def escapes_decoded(text: str) -> str:
    """TEXT with JSON's string escapes decoded, which GraphQL shares: an `--input` payload written with Python's
    json.dump spells each letter outside ASCII as a \\u escape, and GitHub stores the letter."""
    return surrogates_joined(
        JSON_ESCAPE.sub(lambda m: chr(int(m.group(1), 16)) if m.group(1) else JSON_SIMPLE_ESCAPES[m.group(2)], text))


class JsonObject(list):
    """A JSON object's members in order, as (name, value) pairs: a name given twice keeps both values, since a reader
    may store either."""


def json_member(name: str) -> str:
    """The JSON path step to the member NAME: `.name`, or `["name"]` for a name that is not a plain word."""
    return f".{name}" if re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", name) else f"[{json.dumps(name, ensure_ascii=False)}]"


def json_strings(value: object, path: str = "") -> Iterator[tuple[str, str]]:
    """(JSON path, string) for each string of the decoded JSON VALUE and each member name, in order: GitHub stores a
    body's strings as they decode, and some member names too (a gist's file names). A member name's path is the
    member's followed by ` (key)`; the path of a VALUE that is itself a string is `.`."""
    if isinstance(value, str):
        yield path or ".", value
    elif isinstance(value, JsonObject):
        for name, member in value:
            yield f"{path}{json_member(name)} (key)", name
            yield from json_strings(member, path + json_member(name))
    elif isinstance(value, list):
        for index, item in enumerate(value):
            yield from json_strings(item, f"{path}[{index}]")


# An escape in a GraphQL string: `\u{…}` (any code point), `\uXXXX`, or one of JSON's simple escapes.
GRAPHQL_ESCAPE = re.compile(r'\\(?:u\{([0-9A-Fa-f]{1,8})\}|u([0-9A-Fa-f]{4})|(["\\/bfnrt]))')


def block_string_value(raw: str) -> str:
    """A GraphQL block string's value (the spec's BlockStringValue): its lines without the common indentation of all but
    the first, and without blank lines at either end."""
    lines = re.split(r"\r\n|\n|\r", raw)
    common = min((len(line) - len(line.lstrip(" \t")) for line in lines[1:] if line.strip(" \t")), default=0)
    lines = [lines[0], *(line[common:] for line in lines[1:])]
    while lines and not lines[0].strip(" \t"):
        lines.pop(0)
    while lines and not lines[-1].strip(" \t"):
        lines.pop()
    return "\n".join(lines)


# The punctuators, names and numbers of GraphQL's lexical grammar.
GRAPHQL_PUNCTUATORS = frozenset("!$&():=@[]{|}")
GRAPHQL_NAME = re.compile(r"[_A-Za-z][_0-9A-Za-z]*")
GRAPHQL_NUMBER = re.compile(r"-?(?:0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?")


def graphql_tokens(document: str) -> list[tuple[str, str]] | None:
    """The tokens of the GraphQL DOCUMENT as (kind, text): `punct`, `name`, `int`, `float`, and `string` with its value
    decoded as GraphQL decodes it (its escapes, and a block string's common indentation). None when one cannot be read:
    a string never ends, or a plain one holds a line break, a control character or an escape GraphQL does not define; a
    number runs into a name or a `.`; or a character is none GraphQL defines (a control character among them). White
    space, line terminators, commas, a byte order mark and comments are skipped."""
    tokens: list[tuple[str, str]] = []
    index, length = 0, len(document)
    while index < length:
        character = document[index]
        if character in " \t\r\n,\ufeff":
            index += 1
        elif character == "#":
            while index < length and document[index] not in "\r\n":
                index += 1
        elif document.startswith('"""', index):
            index += 3
            raw: list[str] = []
            while not document.startswith('"""', index):
                if index >= length or (ord(document[index]) < 32 and document[index] not in "\t\r\n"):
                    return None
                escaped = document.startswith('\\"""', index)
                raw.append('"""' if escaped else document[index])
                index += 4 if escaped else 1
            tokens.append(("string", block_string_value("".join(raw))))
            index += 3
        elif character == '"':
            index += 1
            value: list[str] = []
            while index < length and document[index] != '"':
                if ord(document[index]) < 32 and document[index] != "\t":
                    return None
                if document[index] != "\\":
                    value.append(document[index])
                    index += 1
                    continue
                escape = GRAPHQL_ESCAPE.match(document, index)
                if escape is None:
                    return None
                index = escape.end()
                if escape.group(3):
                    value.append(JSON_SIMPLE_ESCAPES[escape.group(3)])
                    continue
                point = int(escape.group(1) or escape.group(2), 16)
                # A `\uXXXX` high surrogate is a letter only with the low surrogate escape after it; any other
                # surrogate, and a code point past Unicode's, GraphQL rejects.
                if escape.group(2) and 0xD800 <= point <= 0xDBFF:
                    low = GRAPHQL_ESCAPE.match(document, index)
                    low_point = int(low.group(2), 16) if low and low.group(2) else 0
                    if not 0xDC00 <= low_point <= 0xDFFF:
                        return None
                    point = 0x10000 + ((point - 0xD800) << 10) + (low_point - 0xDC00)
                    index = low.end()
                elif 0xD800 <= point <= 0xDFFF or point > 0x10FFFF:
                    return None
                value.append(chr(point))
            if index >= length:
                return None
            tokens.append(("string", "".join(value)))
            index += 1
        elif document.startswith("...", index):
            tokens.append(("punct", "..."))
            index += 3
        elif character in GRAPHQL_PUNCTUATORS:
            tokens.append(("punct", character))
            index += 1
        elif name := GRAPHQL_NAME.match(document, index):
            tokens.append(("name", name.group()))
            index = name.end()
        elif number := GRAPHQL_NUMBER.match(document, index):
            index = number.end()
            if index < length and (document[index] in "._" or document[index].isascii() and document[index].isalnum()):
                return None
            tokens.append(("float" if number.group(1) or number.group(2) else "int", number.group()))
        else:
            return None
    return tokens


class GraphQLSyntaxError(Exception):
    """Tokens that do not make an executable GraphQL document."""


def graphql_parses(tokens: Sequence[tuple[str, str]]) -> bool:
    """Whether TOKENS (graphql_tokens) make an executable GraphQL document, as the spec's grammar reads one: one or more
    operations (a bare selection set, or `query`, `mutation` or `subscription` with an optional name, variable
    definitions and directives) and fragment definitions, their selections (fields with an alias, arguments, directives
    and a selection set; fragment spreads; inline fragments), arguments, values and directives."""
    position = 0

    def peek(kind: str | None = None, text: str | None = None) -> bool:
        return position < len(tokens) and kind in (None, tokens[position][0]) and text in (None, tokens[position][1])

    def take(kind: str | None = None, text: str | None = None) -> None:
        nonlocal position
        if not peek(kind, text):
            raise GraphQLSyntaxError
        position += 1

    def optional(kind: str, text: str | None = None) -> bool:
        found = peek(kind, text)
        if found:
            take(kind, text)
        return found

    def value(const: bool) -> None:
        if optional("punct", "$"):
            if const:
                raise GraphQLSyntaxError
            take("name")
        elif optional("punct", "["):
            while not optional("punct", "]"):
                value(const)
        elif optional("punct", "{"):
            while not optional("punct", "}"):
                take("name")
                take("punct", ":")
                value(const)
        elif peek("int") or peek("float") or peek("string") or peek("name"):
            take()
        else:
            raise GraphQLSyntaxError

    def arguments(const: bool) -> None:
        if optional("punct", "("):
            while True:
                take("name")
                take("punct", ":")
                value(const)
                if optional("punct", ")"):
                    break

    def directives(const: bool) -> None:
        while optional("punct", "@"):
            take("name")
            arguments(const)

    def type_reference() -> None:
        if optional("punct", "["):
            type_reference()
            take("punct", "]")
        else:
            take("name")
        optional("punct", "!")

    def selection_set() -> None:
        take("punct", "{")
        while True:
            selection()
            if optional("punct", "}"):
                break

    def selection() -> None:
        if optional("punct", "..."):
            if peek("name") and not peek("name", "on"):
                take("name")
                directives(False)
                return
            if optional("name", "on"):
                take("name")
            directives(False)
            selection_set()
            return
        take("name")
        if optional("punct", ":"):
            take("name")
        arguments(False)
        directives(False)
        if peek("punct", "{"):
            selection_set()

    def definition() -> None:
        if peek("punct", "{"):
            selection_set()
        elif optional("name", "fragment"):
            if peek("name", "on"):
                raise GraphQLSyntaxError
            take("name")
            take("name", "on")
            take("name")
            directives(False)
            selection_set()
        else:
            if not any(peek("name", kind) for kind in ("query", "mutation", "subscription")):
                raise GraphQLSyntaxError
            take()
            optional("name")
            if optional("punct", "("):
                while True:
                    take("punct", "$")
                    take("name")
                    take("punct", ":")
                    type_reference()
                    if optional("punct", "="):
                        value(True)
                    directives(True)
                    if optional("punct", ")"):
                        break
            directives(False)
            selection_set()

    try:
        definition()
        while position < len(tokens):
            definition()
    except GraphQLSyntaxError:
        return False
    return True


def graphql_strings(document: str) -> list[str] | None:
    """The value of each string of the GraphQL DOCUMENT, in order, decoded as GraphQL decodes it; None when the document
    does not parse (graphql_tokens, graphql_parses). A comment, and every token but a string, is nothing GitHub stores.
    Until the review of dispatch://INFRA-4383 the strings alone were read, so `mutation { # <term>`, which never closes,
    read as a document with no strings and went out unread."""
    tokens = graphql_tokens(document)
    if tokens is None or not graphql_parses(tokens):
        return None
    return [text for kind, text in tokens if kind == "string"]


def graphql_values(path: str, document: str) -> list[tuple[str, str, bool]]:
    """gh_values of the GraphQL DOCUMENT at PATH: each string by its number (`.query string 2`), or, when the document
    does not parse (graphql_strings), the document read both ways."""
    strings = graphql_strings(document)
    if strings is None:
        return [(path, document, True)]
    return [(f"{path} string {number}".lstrip(), value, False) for number, value in enumerate(strings, start=1)]


def gh_stored_values(piece: GhText, text: str, graphql: bool) -> list[tuple[str, str, bool]] | None:
    """Each value TEXT holds as its endpoint stores it, before a GraphQL document is read by its grammar: (its path in
    TEXT, "" for TEXT itself; the value; whether it is a GraphQL document). A body GitHub stores as JSON fields
    (GhText.json_body: an --input or `workflow run --json` body, never a release asset's, gh_is_upload) is each string
    and member name, decoded, by its JSON path, its `.query` a document when GRAPHQL says the text carries one; None
    for such a body that does not parse as JSON. Any other text is itself, a document when GRAPHQL says it is one.
    gh_values and gh_graphql_documents both take a text's documents from here."""
    if not piece.json_body:
        return [("", text, graphql)]
    try:
        decoded = json.loads(text, object_pairs_hook=JsonObject)
    except (ValueError, RecursionError):
        return None
    return [(path, value, graphql and path == ".query") for path, value in json_strings(decoded)]


def gh_values(piece: GhText, text: str, graphql: bool) -> list[tuple[str, str, bool]]:
    """Each value TEXT holds as its endpoint stores it, each read on its own, so that two values never make one match
    (dispatch://INFRA-4383, R1): (its path in TEXT, "" for TEXT itself; the value; whether it is read both ways, as
    written and with its JSON escapes decoded), for each value gh_stored_values gives, GRAPHQL saying whether the text
    is a GraphQL document or carries one. A document that parses is each of its strings, decoded, and its comments,
    which nobody stores, are not read. A body that does not parse as JSON, and a document that does not parse, are
    read both ways: there the check cannot tell what is stored, and a refusal across two values beats a miss. Any
    other text, a release asset's bytes and a field's value among them, is read as written: GitHub stores a body's
    `\\u0041` as those six characters."""
    stored = gh_stored_values(piece, text, graphql)
    if stored is None:
        return [("", text, True)]
    return [item for path, value, document in stored
            for item in (graphql_values(path, value) if document else [(path, value, False)])]


# CommonMark's escapes, which GitHub undoes when it renders a text: a backslash before an ASCII punctuation character
# (the spec's 2.4, backslash escapes) and an entity or numeric character reference (2.5).
MARKDOWN_ESCAPE = re.compile(r"\\([!-/:-@\[-`{-~])|&(?:#[0-9]{1,7}|#[Xx][0-9A-Fa-f]{1,6}|[A-Za-z][A-Za-z0-9]{0,31});")


def markdown_unescaped(text: str) -> str:
    """TEXT as GitHub renders it once CommonMark's escapes are undone (MARKDOWN_ESCAPE), in one pass: `INFRA\\-1`,
    `INFRA&#45;1` and `INFRA&#x2D;1` show as INFRA-1. A reference is read as HTML5 reads it (html.unescape: an unknown
    name stays as written, and a code point that is 0 or past Unicode is U+FFFD), so `&hyphen;` is U+2010, which is not
    `-`. Inline markup that splits a term (`IN*FRA*-1`) is not undone."""
    return MARKDOWN_ESCAPE.sub(lambda found: found[1] or html.unescape(found[0]), text)


@dataclass(frozen=True)
class GhMatch:
    """A listed term gh_findings finds in a value of a gh call's text: FINDING, what a refusal shows; SPAN, the match in
    VIEW, the view of the value it is in, where gh_check reads the destination's own name (gh_own_name); TWINS, for a
    match of a later view, the as-written view's matches of its term, list and allowed tokens, as (match, view); and
    PIECE, the text, which says where it goes (gh_goes_to)."""

    finding: Finding
    span: Span
    view: str
    twins: tuple[tuple[Span, str], ...]
    piece: GhText


def gh_findings(contents: Sequence[tuple[GhText, str]], graphql: Callable[[GhText], bool],
                matcher: TermMatcher) -> list[GhMatch]:
    """A GhMatch for each listed term in each value of each text (gh_values, GRAPHQL saying which text is a GraphQL
    document or carries one), its Finding at the text's field or file, the value's path in it and the line in the
    value.

    A value is read as GitHub renders it, a paragraph at a time (paragraph_view): a line break inside a paragraph shows
    as a space, so a term of several words that a wrapped line (or a no-break space) splits is the term on the page.
    Until 2026-11-17 each line was read alone, and a body wrapped inside such a term went to a public repository. A
    value read both ways is read with its escapes decoded too, whatever the first view finds: a match counts only for a
    target its list reaches, no allowed token of that target holds and whose own name does not hold it (gh_check), so
    the first view's matches can all be dropped there while the second's count. Each of those views is read once more
    with CommonMark's escapes undone (markdown_unescaped), where that changes it, since GitHub shows `INFRA\\-1` as
    INFRA-1: until review round 2 of dispatch://INFRA-3365 such a body went to a public repository unread. The twins of
    a match of a later view are the matches of the first view that have its term, list and allowed tokens: gh_check
    shows it only when no twin counts, since a twin that counts shows the same term."""
    found: list[GhMatch] = []
    for piece, text in contents:
        for path, value, both in gh_values(piece, text, graphql(piece)):
            label = piece.shown() + (f" {path}" if path else "")
            views = [("", value)]
            if both and "\\" in value:
                views.append(("escapes decoded", escapes_decoded(value)))
            for how, view in list(views):
                rendered = markdown_unescaped(view)
                if all(rendered != seen for _, seen in views):
                    views.append((", ".join(filter(None, (how, "Markdown escapes undone"))), rendered))
            written: dict[tuple[int, str, tuple[str, ...]], list[tuple[Span, str]]] = {}
            for how, view in views:
                for span in matcher.spans(paragraph_view(view)):
                    key = (span.term, span.scope, span.allowed_in)
                    twins = tuple(written.get(key, [])) if how else ()
                    if not how:
                        written.setdefault(key, []).append((span, view))
                    line = view.count("\n", 0, span.start) + 1
                    place = f"{label}{f' ({how})' if how else ''} line {line}"
                    found.append(GhMatch(Finding(place, *excerpt(view, span.start, span.end), span.scope), span, view,
                                         twins, piece))
    return found


def gh_visibility(url: str) -> str:
    """What scripts/github-repo-visibility says of URL (the leak check's cache, else gh): public, private, internal,
    not-github or unknown."""
    helper = Path(__file__).resolve().parent / "github-repo-visibility"
    try:
        completed = subprocess.run([str(helper), url], stdin=subprocess.DEVNULL, capture_output=True, text=True,
                                   timeout=30, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return "unknown"
    value = completed.stdout.strip()
    if completed.returncode == 0 and value in ("public", "private", "internal", "not-github"):
        return value
    return "unknown"


def gh_repository_address(value: str) -> tuple[str, str]:
    """(the host gh 2.98.0 sends a call for the repository to, the repository's URL as scripts/github-repo-visibility
    reads it) of a repository gh names as `[HOST/]OWNER/REPO` or by its URL (ghrepo.FromFullName): for an http or https
    URL its host (gh_url_repository), for `HOST/OWNER/REPO` HOST (gh_host), each read as gh reads it, so a host gh
    sends to github.com gives github.com's URL; github.com for `OWNER/REPO`, and for any other URL (`git@host:o/r`,
    `ssh://…`), whose host the helper reads as git's ssh does, so that one it does not read as GitHub's has a
    visibility nobody reads, and is read as public. Until review round 3 of dispatch://INFRA-3365 a second parser read
    the host of every target's URL, a remote's too, so a remote `git@gh-work:o/r.git`, gh-work an ssh alias of
    github.com, was a repository on gh-work, read as public, while `gh-work:o/r.git` was o/r."""
    named = gh_url_repository(value)
    if named:
        return named[0], f"https://{named[0]}/{named[1]}"
    if "://" in value or value.startswith("git@"):
        return "github.com", value
    parts = value.split("/")
    if len(parts) == 3:
        host = gh_host(parts[0])
        return host, f"https://{host}/{parts[1]}/{parts[2]}"
    return "github.com", f"https://github.com/{value}" if len(parts) == 2 else f"https://{value}"


def gh_remotes() -> tuple[tuple[str, str], ...]:
    """(name, URL) of each remote of this directory gh can take for the repository: the one `gh repo set-default`
    named (a remote's `gh-resolved`), else every one, since which one gh takes then depends on its version."""
    def git(*arguments: str) -> list[str]:
        try:
            completed = subprocess.run(["git", *arguments], stdin=subprocess.DEVNULL, capture_output=True, text=True,
                                       timeout=30, check=False)
        except (OSError, subprocess.TimeoutExpired):
            return []
        return completed.stdout.splitlines() if completed.returncode == 0 else []

    remotes: list[tuple[str, str]] = []
    for line in git("remote", "-v"):
        name, _, rest = line.partition("\t")
        # A fetch line ends at its first ` (fetch)`, since a partial clone's filter follows it.
        url = rest.split(" (fetch)", 1)[0] if " (fetch)" in rest else rest.removesuffix(" (push)")
        if name and url and (name, url) not in remotes:
            remotes.append((name, url))
    resolved: dict[str, str] = {}
    for line in git("config", "--get-regexp", r"^remote\..*\.gh-resolved$"):
        key, _, value = line.partition(" ")
        resolved[key.removeprefix("remote.").removesuffix(".gh-resolved")] = value.strip()
    if not resolved:
        return tuple(remotes)
    chosen = [(name, url) for name, url in remotes if resolved.get(name) == "base"]
    for value in resolved.values():
        if value and value != "base":
            _, url = gh_repository_address(value)
            chosen.append((value, url))
    return tuple(chosen)


def gh_repository(url: str) -> str | None:
    """The `owner/name` of the repository at URL, as repository_of reads it: "" for one it cannot read, None for a URL
    that is not GitHub's."""
    found = repository_of(url)
    return found[0] if found else None


def gh_repository_on(host: str, url: str) -> str:
    """The `owner/name` of the repository at URL (gh_repository) when HOST, where gh sends the call for it, is
    github.com; "" for one the check cannot read, and for any repository on another host, which it reads nothing of."""
    if host != "github.com":
        return ""
    return gh_repository(url) or ""


@dataclass(frozen=True)
class GhBase:
    """A repository gh 2.98.0 may take as the base repository of a call (gh_bases): SOURCE says where it comes from
    (`GH_REPO`, `remote origin`), SHOWN names it as a target, URL is its address, REPOSITORY its `owner/name`, ""
    when the check cannot read it, and HOST the host gh sends the call to (gh_repository_address): github.com for a
    remote, which gh_bases keeps only when scripts/github-repo-visibility reads it as GitHub's."""

    source: str
    shown: str
    url: str
    repository: str
    host: str = "github.com"


def gh_bases(environment: Mapping[str, str], reads_gh_repo: bool) -> list[GhBase]:
    """Each repository gh 2.98.0 may take as the base repository of a call that names none: GH_REPO's when that is set
    and the call reads it (READS_GH_REPO: a command with -R/--repo, whose cmdutil.EnableRepoOverride reads GH_REPO, and
    the placeholders of `gh api`, whose PreRun does), else each remote of this directory gh can take (gh_remotes) whose
    URL is GitHub's, since gh takes no other. GH_REPO is `[HOST/]OWNER/REPO` or a URL (ghrepo.FromFullName), and one
    on another host names a repository the check cannot read. `repo edit` and `repo fork` have no -R, so with no
    repository argument they edit or fork the checkout's repository whatever GH_REPO says: until 2026-11-19 they were
    read as GH_REPO's, so a `repo edit` description went to a public checkout's repository unread while GH_REPO named a
    private one (dispatch://INFRA-3365). gh_check reads them at most once, and only for a reading that takes them."""
    value = environment.get("GH_REPO", "") if reads_gh_repo else ""
    if value:
        host, url = gh_repository_address(value)
        return [GhBase("GH_REPO", value, url, gh_repository_on(host, url), host)]
    return [GhBase(f"remote {name}", f"remote {name}", url, repository)
            for name, url in gh_remotes() if (repository := gh_repository(url)) is not None]


def gh_fills_branch(texts: Sequence[GhText]) -> bool:
    """Whether a text of a `gh api` call that gh fills (TEXTS, gh_is_filled) holds a `{branch}` or `:branch`, which gh
    2.98.0 fills with the current branch (gh_current_branch) and cannot fill when GH_REPO is set, whatever it names, or
    there is no current branch: gh then refuses the call before it sends anything (pkg/cmd/api/api.go,
    fillPlaceholders)."""
    return any(gh_is_filled(piece) and "branch" in gh_placeholders(piece.text or "") for piece in texts)


def gh_filled(contents: Sequence[tuple[GhText, str]], bases: Callable[[], Sequence[GhBase]],
              branch: str | None) -> list[tuple[GhText, str]]:
    """The CONTENTS of a `gh api` call as gh sends them once it has filled the placeholders (gh_fill) of its endpoint
    and of each -F value but a file's (gh_is_filled): one text for each distinct filling from a base repository gh may
    take, tied to the base repositories whose filling it is (GhText.bases), the base placeholders left as written for a
    base the check cannot read, and the branch filled with BRANCH. A text with no base placeholder, or with no base
    repository to fill it from (gh then sends nothing), is one text, tied to no base. BASES are read only for a text
    that holds a base placeholder. Until 2026-11-19 each was read as written, so `-F name={repo}` gave a
    new public repository the name of the checkout's private one unread; and until that day's fourth test round
    `{branch}` was, so `-F ref=refs/heads/{branch}` sent the branch's name unread (dispatch://INFRA-3365). Until its
    review round 2 each filling was judged against the targets of every base, so a checkout whose remotes are
    sjawhar/ygo and theorem-labs/ygo had a reply to `repos/{owner}/{repo}/…` refused for the theorem-labs/ygo filling,
    judged against sjawhar/ygo."""
    def filled(piece: GhText, text: str) -> list[tuple[GhText, str]]:
        if not gh_is_filled(piece):
            return [(piece, text)]
        if "base" not in gh_placeholders(text):
            return [(piece, gh_fill(text, "", branch))]
        sources: dict[str, list[str]] = {}
        for base in bases():
            sources.setdefault(gh_fill(text, base.repository, branch), []).append(base.source)
        return ([(replace(piece, bases=tuple(names)), value) for value, names in sources.items()]
                or [(piece, gh_fill(text, "", branch))])

    return [item for piece, text in contents for item in filled(piece, text)]


# The field a refusal names for the name of a repository the call makes public that no text of the call gives whole.
GH_PUBLISHED_NAME = "the name of the repository the call makes public"


def gh_published_names(group: str, sub: str, read: Sequence[tuple[str | None, str | None]], endpoint: str,
                       bases: Callable[[], Sequence[GhBase]]
                       ) -> tuple[list[tuple[GhText, str]], list[tuple[GhText, str]]]:
    """The `owner/name` of each repository that a call that makes one public (gh_made_public) publishes and that no text
    of the call gives whole, each a text of its own (GH_PUBLISHED_NAME, with where gh takes it from: `remote origin`,
    `GH_REPO`), and each the check cannot read with why: for a `repo edit` that names no repository, each base
    repository it may edit (BASES, which GH_REPO is not); for a `gh api` call whose endpoint (ENDPOINT) holds a base
    placeholder, each base repository gh fills it in from whose name the check cannot read, since the endpoint filled
    from any other gives the name whole (gh_filled: `repos/{owner}/R` is the base owner's R). A name an argument gives
    (`repo edit o/name`, `repos/O/R`, `repo create NAME`), or the directory `repo create --source` takes it from
    (gh_texts), is read there. Until 2026-11-19 neither was read, so `repo edit --visibility public` and a PATCH of
    `repos/{owner}/{repo}` published a private name holding a listed term (dispatch://INFRA-3365, tester round 3)."""
    if (group, sub) == ("repo", "edit") and not any(option is None for option, _ in read):
        published = list(bases())
    elif group == "api" and "base" in gh_placeholders(endpoint):
        published = [base for base in bases() if not base.repository]
    else:
        return [], []
    names: list[tuple[GhText, str]] = []
    unreadable: list[tuple[GhText, str]] = []
    for base in published:
        piece = GhText(GH_PUBLISHED_NAME, part=base.source)
        if base.repository:
            names.append((piece, base.repository))
        else:
            unreadable.append((piece, f"the URL of {base.source} names no repository the check can read"))
    return names, unreadable


@dataclass(frozen=True)
class GhTie:
    """Which texts of a gh call go to a target (gh_goes_to). EVERY: every text, for each target gh_reach returns alone,
    since it is the only place the call goes (GH_EVERY_TEXT). Any other target is tied by BASE, the base repository
    (GhBase.source) the call reaches it with, "" for a target that depends on no base, since a text gh fills from a
    base repository goes out only when gh takes that one; OPTION, for a repository that -R or --branch-repo names,
    that option and its value (`("--repo", "o/r")`), since gh sends that value as that repository's address (and a
    --branch-repo value to the issue's repository too), and None for any other target."""

    every: bool = False
    base: str = ""
    option: tuple[str, str] | None = None


# The tie of a target gh_reach returns alone, which every text of the call goes to.
GH_EVERY_TEXT = GhTie(every=True)


@dataclass(frozen=True)
class GhTarget:
    """Where a gh call's text can go: SHOWN names it in a refusal, REPOSITORY is its `owner/name` ("" for a target with
    no repository, or one nobody could name), OPEN says it is not confirmed private or internal, PUBLIC that its
    visibility was read as public: not made public by the call, nor read as public for want of an answer; and TIE which
    texts go to it (GhTie): every text, GH_EVERY_TEXT, unless the target says otherwise, so that a target that forgets
    its tie takes every text, the safe direction. Until review round 4 of dispatch://INFRA-3365 the default was
    GhTie(), which takes no value of -R."""

    shown: str
    repository: str
    open: bool
    public: bool = False
    tie: GhTie = GH_EVERY_TEXT


def gh_goes_to(piece: GhText, tie: GhTie) -> bool:
    """Whether a value of PIECE goes to a target tied so (TIE): every value to a target gh_reach returns alone; else the
    value of -R only to the repository it names, as that repository's address; the value of --branch-repo to the
    repository it names and to the issue's, every target that no other --branch-repo value names, since `issue develop`
    links the branch to the issue, whose page shows the branch by its repository's name; a text gh fills from a base
    repository (GhText.bases) only to a target the call reaches with one of those bases, or with none; and any other
    value to every target. gh_check judges each match against the open targets its value goes to; until review round 2
    of dispatch://INFRA-3365 each was judged against every target, so `issue develop -R theorem-labs/ygo --branch-repo
    sjawhar/ygo` was refused for the -R value judged against sjawhar/ygo; until its review round 3 the value of
    --branch-repo went only to the repository it names, so a private repository's name went out unread on a public
    issue's page, and a target returned alone took a value only by a fallback outside this rule."""
    if tie.every:
        return True
    if piece.option == "--repo":
        return tie.option == (piece.option, piece.text)
    if piece.option == "--branch-repo":
        return tie.option is None or tie.option[0] != piece.option or tie.option[1] == piece.text
    return not piece.bases or not tie.base or tie.base in piece.bases


def gh_own_name(target: GhTarget, view: str, span: Span) -> bool:
    """Whether SPAN, a match in VIEW, lies wholly inside the own name of TARGET, when TARGET is public already
    (GhTarget.public): an occurrence in VIEW of its `owner/name`, or of its owner alone, in any ASCII letter case and as
    a whole word by GitHub's login characters, with none of `[A-Za-z0-9_-]` on either side, and after `owner/name` none
    of `[A-Za-z0-9_.-]` either, but a `.git` that ends there. The destination's own name is public already, so a
    listed term inside it sends nothing new, and such a match counts for nothing there (gh_check); a term anywhere else
    (`INFRA-1`, `dispatch://`) is still refused, and so is one in a word the owner only begins
    (`theorem-labs-internal`). A repository the call makes public is not public yet, so its name counts as any text
    (gh_made_public). Until 2026-11-19 every write to a public repository whose own name holds a listed term was
    refused, theorem-labs/ygo's under the knives ygo-fork list; that day's exemptions of the name in each spelling the
    check knew missed one more spelling in each of five test rounds and a review (dispatch://INFRA-3365)."""
    owner, _, name = target.repository.partition("/")
    if not (target.public and owner and name):
        return False
    whole = re.escape(target.repository) + r"(?=\.git(?![A-Za-z0-9_.-])|(?![A-Za-z0-9_.-]))"
    own = re.compile(rf"(?<![A-Za-z0-9_-])(?:{whole}|{re.escape(owner)}(?![A-Za-z0-9_-]))", re.ASCII | re.IGNORECASE)
    return any(found.start() <= span.start and span.end <= found.end() for found in own.finditer(view))


# The one target of a raw GraphQL mutation, a call read as GraphQL on any host (gh_api_endpoint, GhAddress.graphql)
# whose text holds `mutation` (GH_GRAPHQL_MUTATION; gh_reach). The check does not read where a mutation goes: each one
# is read whole, as public, whatever repository or node it names, so one whose text holds a listed term is refused even
# to a private repository, and its text is judged with no own-name exemption (gh_own_name). Like every target with no
# repository it counts as any repository, so every scoped and knives list counts for it: on a machine with the knives
# registry copy, a mutation that names any theorem-labs repository is refused for `theorem-labs`. A query, a call
# none of whose texts holds `mutation`, is a read: gh_check passes it once it has read every text, before it looks
# for a listed term, unless gh may send it to a REST API too (GhAddress.rest), where it is judged as that REST call.
# A call one of whose texts cannot be read (`-F query=@missing`) is not known to be a query or a mutation, so it is
# not passed and its one target is GH_GRAPHQL_UNREAD_TARGET, which earns no mutation's advice. Until review round 5
# of dispatch://INFRA-3365 the check read a mutation's fields, node ids and named repositories to find its targets,
# and each round of tests found one more way that reading and GitHub's differed.
GH_GRAPHQL_TARGET = "a raw GraphQL mutation, which is read as public"
GH_GRAPHQL_UNREAD_TARGET = "a GraphQL call whose text could not be read, read as public"
# The gh subcommand or REST route that does what a GraphQL mutation does, judged by its repository: the refusal of a
# mutation names the one for each of these its document names (gh_graphql_advice). gh fills in only the placeholders of
# GH_PLACEHOLDERS; the caller writes every other `{…}`. A new review comment takes `line`, which GitHub's REST API
# says is "Required unless using subject_type:file" (docs.github.com, "Create a review comment for a pull request").
GH_THREAD_REPLY = "gh api repos/{owner}/{repo}/pulls/{number}/comments/{comment_id}/replies -f body=…"
GH_GRAPHQL_ROUTES = {
    "addPullRequestReviewThreadReply": GH_THREAD_REPLY,
    "addPullRequestReviewComment": GH_THREAD_REPLY + " to reply to a comment, or for a new review comment gh api "
                                   "repos/{owner}/{repo}/pulls/{number}/comments -f body=… -f commit_id=… "
                                   "-f path=… -F line=…, or -f subject_type=file for the whole file",
    "addComment": "gh issue comment or gh pr comment",
    "createIssue": "gh issue create",
    "updateIssue": "gh issue edit",
    "createPullRequest": "gh pr create",
    "updatePullRequest": "gh pr edit",
    "addPullRequestReview": "gh pr review, or for inline comments gh api repos/{owner}/{repo}/pulls/{number}/reviews",
    "submitPullRequestReview": "gh api repos/{owner}/{repo}/pulls/{number}/reviews/{review_id}/events -f event=…",
    "updatePullRequestReviewComment": "gh api -X PATCH repos/{owner}/{repo}/pulls/comments/{id}",
    "updateIssueComment": "gh api -X PATCH repos/{owner}/{repo}/issues/comments/{id}",
    "createCommitOnBranch": "gh api -X PUT repos/{owner}/{repo}/contents/{path}, or git push",
}


def gh_graphql_documents(contents: Sequence[tuple[GhText, str]], graphql: Callable[[GhText], bool]) -> list[str]:
    """Each GraphQL document of CONTENTS (GRAPHQL saying which text is one or carries one, as gh_findings reads them;
    gh_stored_values): the text of a `query` field, and each `.query` string of a JSON body that parses, decoded."""
    return [value for piece, text in contents
            for _, value, document in gh_stored_values(piece, text, graphql(piece)) or () if document]


def gh_graphql_advice(documents: Sequence[str]) -> str:
    """What the refusal of a raw GraphQL mutation advises: for each mutation of GH_GRAPHQL_ROUTES that a name token of
    DOCUMENTS names (graphql_tokens), the gh subcommand or REST route to use instead, which is judged by its
    repository, and, for a route with a placeholder, that gh fills in only the placeholders of GH_PLACEHOLDERS; when a
    document does not tokenize, or none names such a mutation, that a gh subcommand or the REST API is judged by its
    repository. A name inside a string or a comment is no name token, so it gives no advice: until review round 6 of
    dispatch://INFRA-3365 a name anywhere in the text did."""
    tokenized = [graphql_tokens(document) for document in documents]
    named: dict[str, None] = {}
    if all(tokens is not None for tokens in tokenized):
        named = dict.fromkeys(text for tokens in tokenized for kind, text in tokens or ()
                              if kind == "name" and text in GH_GRAPHQL_ROUTES)
    read = "A raw GraphQL mutation is read as public, whatever it names"
    if not named:
        return f"{read}; a gh subcommand or the REST API is judged by its repository"
    routes = "; ".join(f"for {name} use {GH_GRAPHQL_ROUTES[name]}" for name in named)
    placeholders = [f"{{{word}}}" for word in GH_PLACEHOLDERS]
    filled = (f", and gh fills in only {', '.join(placeholders[:-1])} and {placeholders[-1]}: "
              "write every other {…} by hand" if any("{" in GH_GRAPHQL_ROUTES[name] for name in named) else "")
    return f"{read}. Instead, {routes}. Each of these is judged by its repository{filled}"


def gh_made_public(group: str, sub: str, read: Sequence[tuple[str | None, str | None]], shape: str,
                   contents: Sequence[tuple[GhText, str]]) -> bool:
    """Whether the call makes the repository it goes to public, or may: `repo create` but with --private or
    --internal; `repo edit` with `--visibility public`; and a `gh api` call to a repository's own endpoint
    (`repos/O/R`, where GitHub's REST API edits it; SHAPE, the endpoint filled as gh_check fills it with any base name,
    so that `repos/{owner}/{repo}` and `repos/:owner/R` are one) whose field or --input body member (CONTENTS, filled
    as gh fills them, gh_filled) sets `visibility` to public or `private` to false (GH_PUBLISHING_FIELDS, in any case
    and with the whitespace around it, which `-F visibility=@file` sends, left out), or whose --input body cannot be
    read. gh_reach reads such a repository as public, and its name as text with no exception for a destination's own
    name (gh_own_name): the name an argument gives it (gh_argument_repository), or the endpoint filled from the base
    repository (gh_filled), else the name gh takes from the base repository (gh_published_names). The repository is not
    public yet, so the call publishes its name. The one reading serves both, so the two cannot differ. Until 2026-11-19
    an endpoint with a placeholder was never a repository's own, and a value's line break hid `public`, so such calls
    published a private name unread (dispatch://INFRA-3365, tester round 3)."""
    long = gh_long_names(GH_TEXT_COMMANDS[(group, sub)])
    if (group, sub) == ("repo", "create"):
        return not (gh_flag(read, long, "--private") or gh_flag(read, long, "--internal"))
    if (group, sub) == ("repo", "edit"):
        # gh takes the last --visibility; any one that says public counts, which errs toward reading the name.
        return any(option and long.get(option, option) == "--visibility" and (value or "").lower() == "public"
                   for option, value in read)
    if group != "api":
        return False
    named = GH_API_REPOSITORY.match(shape)
    if named is None or not GH_API_REPOSITORY_END.fullmatch(shape, named.end()):
        return False
    bodies = [text for piece, text in contents if piece.json_body]
    if not bodies and any(option and long.get(option, option) == "--input" for option, _ in read):
        return True
    if any(piece.key is not None and piece.part != "key" and (piece.key, text.strip().lower()) in GH_PUBLISHING_FIELDS
           for piece, text in contents):
        return True
    for text in bodies:
        try:
            decoded = json.loads(text, object_pairs_hook=JsonObject)
        except (ValueError, RecursionError):
            continue
        for name, value in decoded if isinstance(decoded, JsonObject) else ():
            spelled = "false" if value is False else value.strip().lower() if isinstance(value, str) else ""
            if (name, spelled) in GH_PUBLISHING_FIELDS:
                return True
    return False


@dataclass(frozen=True)
class GhCall:
    """gh_check's reading of a gh call, from which gh_reach reads where it goes: GROUP and SUB, its command; READ, its
    arguments as gh reads them (gh_walk); ADDRESS, where gh sends it (GhAddress, resolved once by gh_api_endpoint for a
    `gh api` call); MADE_PUBLIC, whether the call makes the repository it goes to public (gh_made_public); GRAPHQL,
    whether it is judged as a GraphQL call (GhAddress.graphql, when it is a mutation, a text cannot be read or gh sends
    it to no REST API); and MUTATION, whether a text of such a call holds `mutation` (GH_GRAPHQL_MUTATION)."""

    group: str
    sub: str
    read: tuple[tuple[str | None, str | None], ...]
    address: GhAddress
    made_public: bool
    graphql: bool
    mutation: bool


@dataclass(frozen=True)
class GhRepository:
    """A repository a gh call can reach, before gh_reach reads its visibility: SHOWN names it in a refusal, HOST is
    where gh sends the call for it (decided where its name is read: gh_repository_address for -R, --branch-repo,
    GH_REPO and a repository argument, gh_url_repository for a URL argument; github.com for a remote and an
    endpoint's repository), URL is its address, REPOSITORY its `owner/name` ("" for one the check cannot
    read), NAMED says the call names it (a base repository the call takes from a remote does not count, and is no
    target when its URL is not GitHub's), and TIE says which texts go to it (GhTie)."""

    shown: str
    host: str
    url: str
    repository: str
    named: bool = True
    tie: GhTie = GhTie()


def gh_reach(call: GhCall, bases: Callable[[], Sequence[GhBase]]) -> list[GhTarget]:
    """Every target the call (CALL, gh_check's reading of it) can reach: its host, where gh sends it (GhAddress.host),
    and on github.com the repositories it names, else its base repository (BASES, gh_bases: GH_REPO's for a command
    with -R/--repo, else this directory's remotes, which gh_check reads at most once for every reading that takes them),
    and the repository `issue develop --branch-repo` names; for a `gh api` call, the repository the `repos/O/R` of its
    endpoint names once gh has filled its placeholders from each base repository (GhAddress.fillings), or a new
    repository (GH_API_NEW_REPOSITORY; GhAddress.shape says which endpoint it is). A call judged as GraphQL
    (GhCall.graphql), on any host, which gh_check passes before here unless a text holds `mutation` or cannot be read,
    is one target read as public: GH_GRAPHQL_TARGET for a mutation (GhCall.mutation), else GH_GRAPHQL_UNREAD_TARGET,
    since the text that cannot be read may be the mutation. A repository the call makes public (GhCall.made_public) is
    open, and so is one whose visibility cannot be read, and a target with no repository: a gist (anyone with its
    address reads it), a project, a repository on another host, a new repository, a base repository the check cannot
    read, a GraphQL call. A repository whose visibility is read as public is public (GhTarget.public). Each target says
    which texts go to it (GhTie, gh_goes_to); every text goes to a target returned alone (GH_EVERY_TEXT, GhTarget's
    default tie). Until review round 7 of dispatch://INFRA-3365 a call to another host was read as REST before it was
    read as GraphQL."""
    group, sub, address = call.group, call.sub, call.address
    long = gh_long_names(GH_TEXT_COMMANDS[(group, sub)])
    if group == "api" and call.graphql:
        return [GhTarget(GH_GRAPHQL_TARGET if call.mutation else GH_GRAPHQL_UNREAD_TARGET, "", True)]
    if address.host != "github.com":
        return [GhTarget(f"a repository on {address.host}, read as public", "", True)]
    if group == "gist":
        return [GhTarget("a gist, which anyone with its address can read", "", True)]
    if group == "project":
        return [GhTarget("a project, read as public", "", True)]
    values: dict[str, list[str | None]] = {}
    positionals: list[str] = []
    for option, value in call.read:
        if option is None:
            positionals.append(value or "")
        else:
            values.setdefault(long.get(option, option), []).append(value)
    if (group, sub) == ("repo", "create"):
        name = positionals[0] if positionals else "a new repository"
        shown = f"{name} ({'not made private, so read as public' if call.made_public else 'private'})"
        return [GhTarget(shown, name.lower() if name.count("/") == 1 else "", call.made_public)]
    repositories: list[GhRepository] = []

    def add(shown: str, host: str, url: str, tie: GhTie = GhTie()) -> None:
        repositories.append(GhRepository(shown, host, url, gh_repository_on(host, url), tie=tie))

    # The call's repository by -R, then each argument that names one (gh_argument_repository). A fork is as visible as
    # the repository it forks, so its new name (--fork-name) goes where that one is.
    for value in values.get("--repo", []):
        if value:
            add(value, *gh_repository_address(value), GhTie(option=("--repo", value)))
    reached: list[GhTarget] = []
    for number, value in enumerate(positionals, 1):
        argument = gh_argument_repository(group, sub, number, value)
        if argument is not None:
            shown, host, url = argument
            add(shown, host, url)
    if group == "api":
        # The endpoint as gh sends it, its placeholders filled from each base repository gh may take and with the
        # current branch (gh_fill). Until 2026-11-19 an endpoint with `{owner}` or `{repo}` was read as the base
        # repository itself and one with `:owner` as no repository, so `orgs/{owner}/repos` and `repos/{owner}/R` were
        # judged by the checkout's private repository (dispatch://INFRA-3365, tester round 3). Each repository filled
        # in from a base is tied to that base (GhTie.base).
        if GH_API_NEW_REPOSITORY.fullmatch(address.shape):
            # A new repository is public unless the call says otherwise, and a template's is not as visible as the
            # template: until 2026-11-19 `repos/O/R/generate` was judged by the template O/R.
            return [GhTarget("a new repository the call makes, read as public", "", True)]
        given = GH_API_REPOSITORY.match(address.shape)
        if given is None:
            return [GhTarget("no repository, read as public", "", True)]
        if "base" not in gh_placeholders(address.endpoint):
            # With no base name to fill in, the shape is the endpoint as gh sends it.
            add(f"{given[1]}/{given[2]}", "github.com", f"https://github.com/{given[1]}/{given[2]}")
        for base, filled in address.fillings:
            found = GH_API_REPOSITORY.match(filled) if base.repository else None
            if found is None:
                reached.append(GhTarget(f"a repository filled in from {base.source}, which could not be read, "
                                        "read as public", "", True, tie=GhTie(base=base.source)))
            else:
                add(f"{found[1]}/{found[2]}, filled in from {base.source}", "github.com",
                    f"https://github.com/{found[1]}/{found[2]}", GhTie(base=base.source))
    elif not repositories:
        repositories += [GhRepository(base.shown, base.host, base.url, base.repository, base.source == "GH_REPO",
                                      GhTie(base=base.source)) for base in bases()]
    # `issue develop --branch-repo R` makes the branch in R, one more target and never the call's repository: the
    # issue is in the call's repository (-R, else the issue's URL, else the base repository), which is always a target.
    # Until review round 3 of dispatch://INFRA-3365 R was read as the call's repository, so with no -R the issue's
    # repository was no target, and `--name`, `--base` and R's name went to a public issue judged by R alone.
    for value in values.get("--branch-repo", []):
        if value:
            add(value, *gh_repository_address(value), GhTie(option=("--branch-repo", value)))
    # One loop reads each repository: on another host, which the check reads nothing of, as public; else by its
    # visibility. Each host is decided where the repository's name is read (GhRepository.host): until review round 2 of
    # dispatch://INFRA-3365 an argument's host was read apart, and `repo edit ghe.example.com/o/r` was a github.com
    # repository whose visibility could not be read.
    for candidate in repositories:
        if candidate.host != "github.com":
            reached.append(GhTarget(f"a repository on {candidate.host}, read as public", "", True, tie=candidate.tie))
            continue
        visibility = gh_visibility(candidate.url)
        if visibility == "not-github" and not candidate.named:
            continue
        if call.made_public:
            state, open_, public = "made public by the call", True, False
        elif visibility in ("private", "internal"):
            state, open_, public = visibility, False, False
        elif visibility == "public":
            state, open_, public = "public", True, True
        else:
            state, open_, public = "visibility unread, so read as public", True, False
        reached.append(GhTarget(f"{candidate.shown} ({state})", candidate.repository, open_, public, candidate.tie))
    return reached or [GhTarget("no GitHub repository found for the call, read as public", "", True)]


def gh_check(arguments: Sequence[str]) -> int:
    """`gh -- ARGV…`: refuse a gh call that sends a listed term to anything not confirmed private (exit 3), whose text
    cannot be checked because the list cannot be read (exit 2), or that names a file nobody can read (exit 4); exit
    GH_STDIN_EXIT to ask for standard input. Any other call exits 0 untouched, and the text of a call that reaches only
    private or internal repositories is not checked, nor are their visibilities read before a term is found."""
    environment = os.environ
    command = gh_command(arguments, environment)
    if command is None:
        return 0
    group, sub, rest = command
    long = gh_long_names(GH_TEXT_COMMANDS[(group, sub)])
    read = gh_walk(rest, gh_options(GH_TEXT_COMMANDS[(group, sub)]))
    if group == "api" and not gh_api_sends(read):
        return 0
    # `pr create --dry-run` prints the pull request it would create and sends none of its text.
    if (group, sub) == ("pr", "create") and gh_flag(read, long, "--dry-run"):
        return 0
    pieces = [replace(piece, path="-" if piece.path not in (None, "-") and gh_is_stdin(piece.path) else piece.path)
              for piece in gh_texts(group, sub, read)]
    # The current branch, read once, for a `gh api` call that has one to fill; with GH_REPO set gh fills none. None for
    # a call with none to fill, and where git names none (gh_fill leaves the branch as written then).
    branch: str | None = None
    if group == "api" and gh_fills_branch(pieces):
        branch = None if environment.get("GH_REPO") else gh_current_branch()
        if branch is None and gh_fills_branch([piece for piece in pieces if piece.option != "argument 1"]):
            # gh refuses a call whose `{branch}` or `:branch` it cannot fill before it sends anything. Measured on gh
            # 2.98.0, each exits 1 with no request sent: with GH_REPO set, "unable to determine an appropriate value for
            # the 'branch' placeholder"; on a detached HEAD, as a jj checkout that shares its git directory usually
            # has, "unable to expand placeholder in path: could not determine current branch: failed to run git: not
            # on any branch" (for an -F value, `error parsing "sha" value: could not determine current branch: …`);
            # outside a git repository, "could not determine current branch: failed to run git: fatal: not a git
            # repository". gh fills the -F values before the endpoint (pkg/cmd/api/api.go apiRun: parseFields, then
            # fillPlaceholders), so a call with such a value passes, whatever else it holds. One whose endpoint alone
            # holds the branch is read as GraphQL instead, failing closed (gh_api_endpoint).
            return 0
    stdin: str | None = None
    if any(piece.path == "-" for piece in pieces):
        pointer = environment.get(GH_STDIN)
        if not pointer:
            return GH_STDIN_EXIT
        try:
            stdin = Path(pointer).read_bytes().decode("utf-8", errors="surrogateescape")
        except OSError:
            stdin = None
    # Each repository gh may take as the base repository (gh_bases), read at most once, and only for a reading that
    # takes one: an endpoint that holds a base placeholder (gh_api_endpoint), a text gh fills that holds one
    # (gh_filled), the repository a `repo edit` that names none makes public (gh_published_names), and, once a term is
    # found, where a call that names no repository goes (gh_reach). Until review round 2 of dispatch://INFRA-3365 every
    # checked call read them first (git twice, and scripts/github-repo-visibility for each remote), which made a clean
    # `pr comment` 43 to 72 ms slower.
    known: tuple[GhBase, ...] | None = None

    def bases() -> tuple[GhBase, ...]:
        nonlocal known
        if known is None:
            known = tuple(gh_bases(environment, group == "api" or "--repo" in long.values()))
        return known

    # Where gh sends the call, resolved once (gh_api_endpoint): every reader below takes it from here, the target
    # (gh_reach), the pass for a query, the reading of a document (graphql, below), the advice and gh_is_upload.
    address = (gh_api_endpoint(read, environment, branch, bases) if group == "api"
               else GhAddress(gh_host(environment.get("GH_HOST") or "github.com")))
    # A release asset's body is its bytes: never read as JSON (gh_is_upload).
    upload = gh_is_upload(group, sub, address)
    texts = [replace(piece, json_body=piece.json_body and not upload) for piece in pieces]
    contents, unreadable = gh_contents(texts, stdin)
    if group == "api":
        # What gh sends once it has filled the placeholders of the endpoint and of its -F values (gh_filled).
        contents = gh_filled(contents, bases, branch)
    local_contents, local_unreadable = gh_local_texts(group, sub, read)
    contents += local_contents
    unreadable += local_unreadable
    # A call read as GraphQL is a mutation when a text holds `mutation`. GitHub reads an --input payload as JSON, so
    # `\u006dutation` there is the keyword too: the decoded view counts.
    mutation = address.graphql and any(GH_GRAPHQL_MUTATION.search(view) for _, text in contents
                                       for view in (text, escapes_decoded(text)))
    # It is judged as GraphQL (gh_reach) when it is a mutation, when a text that cannot be read may be one, or when gh
    # sends it to no REST API; else it is judged as the REST call gh may send it as (GhAddress.rest).
    graphql_call = address.graphql and (mutation or bool(unreadable) or not address.rest)
    if graphql_call and not mutation and not unreadable:
        # A query, every text read and none holding `mutation`, is a read (GH_GRAPHQL_TARGET).
        return 0
    made_public = gh_made_public(group, sub, read, address.shape, contents)
    if made_public:
        # The name of a repository the call makes public that no text of the call gives whole (gh_published_names).
        published, unread_names = gh_published_names(group, sub, read, address.endpoint, bases)
        contents += published
        unreadable += unread_names

    def graphql(piece: GhText) -> bool:
        """Whether PIECE is a GraphQL call's document (its `query` field) or carries one (its JSON body's `.query`)."""
        return graphql_call and (piece.json_body or piece.key == "query")

    matcher: TermMatcher | None = None
    list_problem: str | None = None
    findings: list[GhMatch] = []
    if any(text for _, text in contents):
        try:
            # Every scoped list, the knives registry's included: which ones apply depends on where the text goes,
            # which is read only when a term is found.
            matcher = load_terms(repositories=EVERY_REPOSITORY, registry=True)
        except ListError as error:
            list_problem = str(error)
        else:
            findings = gh_findings(contents, graphql, matcher)
    if not findings and list_problem is None and not unreadable:
        return 0
    reached = gh_reach(GhCall(group, sub, tuple(read), address, made_public, graphql_call, mutation), bases)
    open_targets = [target for target in reached if target.open]
    if not open_targets:
        return 0
    if matcher is not None:
        # A match counts for an open target its value goes to (gh_goes_to), that its list's scope reaches, that no
        # allowed token of that target holds, and whose own name, public already, does not hold it (gh_own_name); a
        # match of a later view counts only when none of its twins does, since a twin that counts shows the same term
        # (gh_findings).
        def counts(span: Span, view: str, targets: Sequence[GhTarget]) -> bool:
            return any((not span.scope or matcher.scopes[span.scope].reaches([target.repository]))
                       and not span.allowed_for(target.repository) and not gh_own_name(target, view, span)
                       for target in targets)

        def kept(found: GhMatch) -> bool:
            targets = [target for target in reached if target.open and gh_goes_to(found.piece, target.tie)]
            return (counts(found.span, found.view, targets)
                    and not any(counts(span, view, targets) for span, view in found.twins))

        findings = [found for found in findings if kept(found)]
        if not findings and list_problem is None and not unreadable:
            return 0
    name = f"gh {group} {sub}".rstrip()
    target = ", ".join(c_escape(item.shown) for item in reached)
    for found in findings:
        print(f"leak terms: {name} to {target}: {found.finding}", file=sys.stderr)
    for piece, reason in unreadable:
        print(f"leak terms: {name} to {target}: cannot read {piece.shown()}: {reason}", file=sys.stderr)
    if list_problem:
        print(list_problem, file=sys.stderr)
        print(f"leak terms: {name} to {target}: its text cannot be checked without the list", file=sys.stderr)
    advice = f" To send it, {REMOVE_ADVICE}." if findings else ""
    if findings and mutation:
        # The refusal of a raw GraphQL mutation names what to use instead (gh_graphql_advice); a GraphQL call that is
        # not known to be a mutation (GH_GRAPHQL_UNREAD_TARGET), and a refusal with no term, get none.
        advice += f" {gh_graphql_advice(gh_graphql_documents(contents, graphql))}."
    print(f"leak terms: {name}: refused before gh ran, so nothing was sent.{advice}", file=sys.stderr)
    return FOUND_EXIT if findings else LIST_EXIT if list_problem else TEXT_EXIT


def parser() -> argparse.ArgumentParser:
    argument_parser = argparse.ArgumentParser(prog="leak-terms-check")
    modes = argument_parser.add_subparsers(dest="mode", required=True)
    diff = modes.add_parser("diff")
    diff.add_argument("--place-prefix", default="")
    staged = modes.add_parser("staged")
    message = modes.add_parser("message")
    message.add_argument("--cleanup", choices=("verbatim", "whitespace", "strip", "scissors"), default="verbatim")
    message.add_argument("--comment-char")
    message.add_argument("--cut-at-scissors", action="store_true")
    message.add_argument("--place", default="commit message")
    message.add_argument("--encoding", default="utf-8")
    comment_char = modes.add_parser("git-comment-char")
    comment_char.add_argument("--editor-ran", choices=("0", "1"), required=True)
    comment_char.add_argument("--status-shown", choices=("0", "1"), required=True)
    comment_char.add_argument("--cut-line-written", choices=("0", "1"), required=True)
    jj_editor_parser = modes.add_parser("jj-editor")
    jj_editor_parser.add_argument("file")
    jj_preflight = modes.add_parser("jj-editor-preflight")
    jj_preflight.add_argument("listing")
    push = modes.add_parser("push")
    push.add_argument("--remote", required=True)
    push.add_argument("--url", required=True)
    # `gh -- ARGV…` takes a gh call's own arguments, which main hands to gh_check without parsing them.
    modes.add_parser("gh", help="check the text a gh call sends: gh -- ARGV...")
    return argument_parser


def main(arguments: Sequence[str] | None = None) -> int:
    arguments = sys.argv[1:] if arguments is None else list(arguments)
    if arguments[:1] == ["gh"]:
        rest = arguments[1:]
        return gh_check(rest[1:] if rest[:1] == ["--"] else rest)
    args = parser().parse_args(arguments)
    if args.mode == "jj-editor":
        return jj_editor(args.file)
    if args.mode == "jj-editor-preflight":
        return jj_editor_preflight(args.listing)
    try:
        text = "" if args.mode == "staged" else read_stdin(args.encoding if args.mode == "message" else "utf-8")
    except TextError as error:
        print(f"leak terms: cannot read text to check: {error}", file=sys.stderr)
        return TEXT_EXIT

    if args.mode == "git-comment-char":
        character = git_comment_char(
            text, args.editor_ran == "1", args.status_shown == "1", args.cut_line_written == "1"
        )
        if character is not None:
            print(character)
        return 0

    try:
        if args.mode == "push":
            findings = scan_push(text, args.remote, args.url)
        elif args.mode == "staged":
            findings = scan_staged_diff()
        elif not text:
            findings = []
        else:
            matcher = load_terms()
            if args.mode == "diff":
                findings = scan_diff(text, matcher, args.place_prefix)
            else:
                findings = scan_message(text, matcher, args.cleanup, args.comment_char, args.cut_at_scissors, args.place)
    except ListError as error:
        print(error, file=sys.stderr)
        return LIST_EXIT
    except TextError as error:
        print(f"leak terms: cannot read text to check: {error}", file=sys.stderr)
        return TEXT_EXIT

    if not findings:
        return 0
    print_findings(findings)
    return FOUND_EXIT


if __name__ == "__main__":
    raise SystemExit(main())
