#!/usr/bin/env bash
# secret-run: run a command with secrets from whichever store serves the calling process
# (AGENTC-393). Every consumer in dotfiles and every skill calls this, never `agent-secrets` or
# `secrets` directly.
#
#   secret-run [--reason R] [--wait DURATION] [--ttl DURATION] [--dry-run] KEY... -- cmd [args...]
#   secret-run request [--reason R] [--ttl DURATION] [--dry-run] KEY...
#
# The choice is who is calling, never what failed. A process with a secrets-broker identity
# (`agent-secrets identity` exits 0: an agent box's key dir, or a host session the
# agent-secrets helper registered, while the helper holds a launcher credential) gets the broker:
# `agent-secrets KEY... --reason R [--wait DURATION] [--ttl DURATION] -- cmd`, and its exit (75
# pending, 77 denied, any error) is this command's exit; secretsd is never tried after it. A
# process whose client answers "no identity" (identity exits 1: Sami's shells, a session started
# before its launcher registered it, a session on a helper with no launcher credential, a helper
# that does not answer; identity's own notice is shown), and a process with no `agent-secrets` on
# PATH at all (his laptop), runs `secrets KEY... -- cmd` exactly as before and never touches the
# broker; --reason, --wait and --ttl mean nothing to secretsd and are dropped. DURATION is a Go
# duration (0, 30s, 5m): the broker parses it, so a bare number other than 0 fails on the broker
# path. --ttl ends the broker's grant after DURATION instead of at the session's end.
# `request` asks for a grant and gets no value: `agent-secrets request KEY...` on the broker,
# `secrets get KEY` once per key on secretsd (it takes one key), stopping at the first failure.
# Every broker request names who asks, what for and what it runs, since the approval card shows
# only the secret names, the reason and the request's session: `secret-run-reason`, beside this
# file, builds the reason from R, then SECRET_RUN_REASON from the environment (one call's own why,
# where R is fixed, as a gws tier command fixes it in gws/accounts.json), the omp session's id,
# title and subagent (else the Envoy or Claude Code session, else "no omp session; pid N, cwd D"),
# the command's name, its first words and the ids it targets, never a flag's value, and the host
# and pid, within the broker's 400-rune limit. When the environment names no session the client
# sends but PI_SESSION_FILE names one (omp's eval kernel keeps that variable and drops
# OMP_SESSION_ID), OMP_SESSION_ID is exported for the client, which fills the card's Session line.
# If the builder fails, the reason is R and SECRET_RUN_REASON in printable ASCII with the host and
# pid, and says so. --dry-run prints which store would serve, the session id the client would send
# and the reason, and requests nothing: no grant, no command.
#
# A client that is on PATH but cannot run is neither answer, so it is an error (exit 1, a message
# that starts "secret-run: the agent-secrets client cannot run") and nothing runs: no switch to
# secretsd, since that switch reads another store under the caller's feet. That covers a mise shim
# mise cannot resolve to an installed binary, a resolved path that is not an executable file, and
# any identity exit other than 0 or 1: 2 is the client's usage error or a Go panic (every release
# mise.toml can install, legion-envoy-v3.17.1 on, has `identity`), 126 or 127 come from the shell
# when the exec fails, and higher codes from a signal.
# Until 2026-10-28 such a client counted as "no identity": in a relay's `env -i` scope, mise's shim
# looked in mise's default data dir instead of ~/.mise, failed, and ~280 agents silently read
# secretsd for eight minutes.
#
# The client is resolved, never left to mise's shim. A mise shim is a symlink to mise itself, so
# its target is the mise that owns it; secret-run asks that mise for the installed binary with
# `mise which -C / agent-secrets --tool agent-secrets`, under MISE_DATA_DIR, or .bashrc's
# $HOME/.mise when the caller has none (a unit, `env -i`), as shims/knives and shims/claude do.
# `-C /` reads only the machine-wide pin, the one the helper runs, so a working directory whose
# own mise.toml is untrusted or pins another version changes nothing. Any other `agent-secrets` on
# PATH (a box's, a local build) runs as found. Both the identity check and the broker call run the
# resolved path; MISE_DATA_DIR is set for the lookup alone, so `secrets` resolves as before. Only
# mise's stdout is the path: its stderr (a warning about a config key, MISE_VERBOSE or MISE_DEBUG
# output) goes to this command's stderr, and a warning with exit 0 changes nothing.
#
# `mise which` never installs: a pin bumped in mise.toml before `mise install` has run fails
# every secret-run on that machine with the error above, where the shim used to switch silently to
# secretsd. Whoever bumps the agent-secrets pin runs `mise install` before the pin goes live on a
# machine (here, and on each machine `scripts/dotfiles-sync` moves).
set -euo pipefail

usage() {
    cat >&2 <<'EOF'
usage: secret-run [--reason R] [--wait DURATION] [--ttl DURATION] [--dry-run] KEY... -- cmd [args...]
usage: secret-run request [--reason R] [--ttl DURATION] [--dry-run] KEY...
EOF
    exit 2
}

request=0
if [[ "${1:-}" == request ]]; then
    request=1
    shift
fi
reason=() wait=() ttl=() keys=() dry_run=0
while (( $# )) && [[ "$1" != -- ]]; do
    case "$1" in
        --reason) (( $# >= 2 )) || usage; reason=(--reason "$2"); shift 2 ;;
        --reason=*) reason=(--reason "${1#--reason=}"); shift ;;
        --wait) (( ! request && $# >= 2 )) || usage; wait=(--wait "$2"); shift 2 ;;
        --wait=*) (( ! request )) || usage; wait=(--wait "${1#--wait=}"); shift ;;
        --ttl) (( $# >= 2 )) || usage; ttl=(--ttl "$2"); shift 2 ;;
        --ttl=*) ttl=(--ttl "${1#--ttl=}"); shift ;;
        --dry-run) dry_run=1; shift ;;
        -*) usage ;;
        *) keys+=("$1"); shift ;;
    esac
done
(( ${#keys[@]} )) || usage
if (( request )); then
    (( $# == 0 )) || usage
else
    [[ "${1:-}" == -- ]] || usage
    shift
    (( $# )) || usage
fi

cannot_run() {
    # shellcheck disable=SC2016  # $HOME is text for the reader
    printf 'secret-run: the agent-secrets client cannot run (%s), so secret-run cannot tell whether this process has a broker identity; it stops rather than read secretsd instead. Repair or reinstall the client (a mise install under the MISE_DATA_DIR this process has, else under $HOME/.mise), or take agent-secrets off PATH to use secretsd.\n' "$1" >&2
    exit 1
}

client="" identity=1 why=""
if found="$(command -v agent-secrets)"; then
    client="$found"
    target="$(realpath "$found")"
    if [[ "${target##*/}" == mise ]]; then
        client="$(MISE_DATA_DIR="${MISE_DATA_DIR:-$HOME/.mise}" "$target" which -C / agent-secrets --tool agent-secrets </dev/null)" ||
            cannot_run "$found is mise's shim, and mise could not resolve it; its error is above"
    fi
    [[ -f "$client" && -x "$client" ]] || cannot_run "$client is not an executable file"
    identity=0
    why="$("$client" identity 2>&1 >/dev/null)" || identity=$?
    (( identity <= 1 )) || cannot_run "\`$client identity\` exited $identity: ${why//$'\n'/ }"
fi

# request_reason [cmd...]: set reason to the one a broker request carries, and export the session
# id secret-run-reason derives (see the header).
request_reason() {
    local built="" caller="${reason[1]:-}"
    local -a command=()
    (( request )) || command=(-- "$@")
    if built="$("$(dirname "$(realpath "$0")")/secret-run-reason" --pid "$$" "${reason[@]}" "${command[@]}")" &&
        [[ "$built" == *$'\n'* ]]; then
        [[ -z "${built%%$'\n'*}" ]] || export OMP_SESSION_ID="${built%%$'\n'*}"
        reason=(--reason "${built#*$'\n'}")
        return
    fi
    caller="${caller:+$caller; }${SECRET_RUN_REASON:-}"
    caller="$(printf '%s' "${caller:-no reason given}" | LC_ALL=C tr -c '[:print:]' ' ' | tr -s ' ')"
    reason=(--reason "${caller:0:200} | session: unknown, secret-run-reason failed | host: $(uname -n) pid $$")
}

if (( dry_run )); then
    store="secretsd (no agent-secrets client)"
    if (( identity == 0 )); then
        store="broker"
    elif [[ -n "$client" ]]; then
        store="secretsd (no broker identity)"
    fi
    request_reason "$@"
    printf 'secret-run --dry-run: nothing requested\nstore: %s\nkeys: %s\n' "$store" "${keys[*]}"
    (( ! ${#ttl[@]} )) || printf 'ttl: %s\n' "${ttl[1]}"
    printf 'session_id: %s\nreason: %s\n' "${OMP_SESSION_ID:-${ENVOY_SESSION_ID:-${CLAUDE_CODE_SESSION_ID:-none}}}" "${reason[1]}"
    exit 0
fi
if (( identity == 0 )); then
    # omp's eval kernel strips every AGENT_SECRETS_* variable, and the client refuses without a
    # broker URL. The key dir and the helper socket need no export: from the #1589 release the
    # client falls back to the same defaults `identity` just used.
    # shellcheck source=SCRIPTDIR/../agent-secrets/broker-url.sh
    . "${DOTFILES_DIR:-$HOME/.dotfiles}/agent-secrets/broker-url.sh"
    request_reason "$@"
    if (( request )); then
        exec "$client" request "${keys[@]}" "${reason[@]}" "${ttl[@]}"
    fi
    exec "$client" "${keys[@]}" "${reason[@]}" "${wait[@]}" "${ttl[@]}" -- "$@"
fi
if (( identity == 1 )) && [[ -n "$why" ]]; then
    printf '%s\n' "$why" >&2
fi
if (( request )); then
    for key in "${keys[@]}"; do
        secrets get "$key"
    done
    exit 0
fi
exec secrets "${keys[@]}" -- "$@"
