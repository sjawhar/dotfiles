#!/usr/bin/env bash
# secret-run: run a command with secrets from whichever store serves the calling process
# (AGENTC-393). Every consumer in dotfiles and every skill calls this, never `agent-secrets` or
# `secrets` directly.
#
#   secret-run [--reason R] [--wait N] KEY... -- cmd [args...]
#   secret-run request [--reason R] KEY...
#
# The choice is who is calling, never what failed. A process with a secrets-broker identity
# (`agent-secrets identity` exits 0: an agent box's key dir, or a host session the
# agent-secrets helper registered) gets the broker: `agent-secrets KEY... --reason R [--wait N]
# -- cmd`, and its exit (75 pending, 77 denied, any error) is this command's exit. A broker
# outage is an error there, never a switch to secretsd. Any other process (Sami's shells, his
# laptop, a session started before its launcher registered it, a client too old to know
# `identity`, no client at all) runs `secrets KEY... -- cmd` exactly as before, and never
# touches the broker; --reason and --wait mean nothing to secretsd and are dropped.
# `request` asks for a grant and gets no value: `agent-secrets request` on the broker,
# `secrets get` on secretsd.
set -euo pipefail

usage() {
    sed -n '6,7p' "$0" | sed 's/^#  */usage: /' >&2
    exit 2
}

request=0
if [[ "${1:-}" == request ]]; then
    request=1
    shift
fi
reason=() wait=() keys=()
while (( $# )) && [[ "$1" != -- ]]; do
    case "$1" in
        --reason) (( $# >= 2 )) || usage; reason=(--reason "$2"); shift 2 ;;
        --reason=*) reason=(--reason "${1#--reason=}"); shift ;;
        --wait) (( ! request && $# >= 2 )) || usage; wait=(--wait "$2"); shift 2 ;;
        --wait=*) (( ! request )) || usage; wait=(--wait "${1#--wait=}"); shift ;;
        -*) usage ;;
        *) keys+=("$1"); shift ;;
    esac
done
(( ${#keys[@]} )) || usage
if (( request )); then
    (( $# == 0 )) || usage
else
    [[ "${1:-}" == -- ]] || usage
    shift
    (( $# )) || usage
fi

# identity's stdout is not the command's output; its stderr (why there is no identity) is shown.
if command -v agent-secrets >/dev/null 2>&1 && agent-secrets identity >/dev/null; then
    # omp's eval kernel strips every AGENT_SECRETS_* variable and the client refuses without a
    # broker URL; the key dir and the helper socket have defaults the client shares.
    export AGENT_SECRETS_URL="${AGENT_SECRETS_URL:-https://secrets.internal.trajectorylabs.com}"
    if (( request )); then
        exec agent-secrets request "${keys[@]}" "${reason[@]}"
    fi
    exec agent-secrets "${keys[@]}" "${reason[@]}" "${wait[@]}" -- "$@"
fi
if (( request )); then
    exec secrets get "${keys[@]}"
fi
exec secrets "${keys[@]}" -- "$@"
