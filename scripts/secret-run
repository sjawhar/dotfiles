#!/usr/bin/env bash
# secret-run: run a command with secrets from whichever store serves the calling process
# (AGENTC-393). Every consumer in dotfiles and every skill calls this, never `agent-secrets` or
# `secrets` directly.
#
#   secret-run [--reason R] [--wait DURATION] KEY... -- cmd [args...]
#   secret-run request [--reason R] KEY...
#
# The choice is who is calling, never what failed. A process with a secrets-broker identity
# (`agent-secrets identity` exits 0: an agent box's key dir, or a host session the
# agent-secrets helper registered) gets the broker: `agent-secrets KEY... --reason R [--wait
# DURATION] -- cmd`, and its exit (75 pending, 77 denied, any error) is this command's exit. A
# broker outage is an error there, never a switch to secretsd. Any other process (Sami's shells,
# his laptop, a session started before its launcher registered it, no client at all) runs
# `secrets KEY... -- cmd` exactly as before, and never touches the broker; --reason and --wait
# mean nothing to secretsd and are dropped. DURATION is a Go duration (0, 30s, 5m): the broker
# parses it, so a bare number other than 0 fails on the broker path.
# `request` asks for a grant and gets no value: `agent-secrets request KEY...` on the broker,
# `secrets get KEY` once per key on secretsd (it takes one key), stopping at the first failure.
#
# `identity` exists from the legion #1589 release on. The pinned client before it
# (legion-envoy-v3.16.0) has none and exits 2 with its usage, so every process uses secretsd
# until the pin moves; that usage text is not shown. identity's own reason for exit 1 (a helper
# that does not answer, say) is.
set -euo pipefail

usage() {
    cat >&2 <<'EOF'
usage: secret-run [--reason R] [--wait DURATION] KEY... -- cmd [args...]
usage: secret-run request [--reason R] KEY...
EOF
    exit 2
}

request=0
if [[ "${1:-}" == request ]]; then
    request=1
    shift
fi
reason=() wait=() keys=()
while (( $# )) && [[ "$1" != -- ]]; do
    case "$1" in
        --reason) (( $# >= 2 )) || usage; reason=(--reason "$2"); shift 2 ;;
        --reason=*) reason=(--reason "${1#--reason=}"); shift ;;
        --wait) (( ! request && $# >= 2 )) || usage; wait=(--wait "$2"); shift 2 ;;
        --wait=*) (( ! request )) || usage; wait=(--wait "${1#--wait=}"); shift ;;
        -*) usage ;;
        *) keys+=("$1"); shift ;;
    esac
done
(( ${#keys[@]} )) || usage
if (( request )); then
    (( $# == 0 )) || usage
else
    [[ "${1:-}" == -- ]] || usage
    shift
    (( $# )) || usage
fi

identity=1 why=""
if command -v agent-secrets >/dev/null 2>&1; then
    identity=0
    why="$(agent-secrets identity 2>&1 >/dev/null)" || identity=$?
fi
if (( identity == 0 )); then
    # omp's eval kernel strips every AGENT_SECRETS_* variable, and the client refuses without a
    # broker URL. The key dir and the helper socket need no export: from the #1589 release the
    # client falls back to the same defaults `identity` just used.
    if [[ -z "${AGENT_SECRETS_URL:-}" ]]; then
        # shellcheck source=SCRIPTDIR/../agent-secrets/broker.env
        . "${DOTFILES_DIR:-$HOME/.dotfiles}/agent-secrets/broker.env"
    fi
    export AGENT_SECRETS_URL
    if (( request )); then
        exec agent-secrets request "${keys[@]}" "${reason[@]}"
    fi
    exec agent-secrets "${keys[@]}" "${reason[@]}" "${wait[@]}" -- "$@"
fi
if (( identity == 1 )) && [[ -n "$why" ]]; then
    printf '%s\n' "$why" >&2
fi
if (( request )); then
    for key in "${keys[@]}"; do
        secrets get "$key"
    done
    exit 0
fi
exec secrets "${keys[@]}" -- "$@"
