#!/usr/bin/env bash
# Keep each tmux session's windows grouped by the project their panes work in.
#
# Sami, 2026-11-05 08:16:33Z, on the agent boxes: "they are grouped in tmux windows: all their
# panes are grouped by the project that they're on". Before this, `dev` and `agents` interleaved
# every stream in arrival order -- one stream's lane between two of another's -- and a window's
# place said nothing about what it was working on.
#
# A one-off sort decays in minutes: every restart the registry makes, and every new lane, opens
# its window at the end. So this runs as a standing job (`stream-job`, every 5 min) and returns
# at once, changing nothing, whenever the order and the names are already right, which keeps
# window indices stable under whoever is reading them.
#
# THE PROJECT IS DERIVED FROM THE PANE'S PATH, never from a list of names in this file: this
# repository is public and several of our trees are named after a customer. The rule is the first
# directory below a root that holds many trees, which is the repository name for a checkout and
# the lane's own directory for scratch; a pane in none of those roots falls back to the first two
# words of its own title, and then to `misc`. A machine can merge or rename groups in
# `~/.config/tmux-project-aliases` (`<shell glob matching the derived name> <group>`, one per
# line, `#` comments), which is machine-local and not committed.
#
# It renames (`<project>·<the window's own name>`) and reorders. It never kills a window, never
# moves a pane between windows and never touches a process. `--dry-run` prints the plan.
set -uo pipefail

dry=false
sessions=()
while (($#)); do
    case "$1" in
        --dry-run) dry=true ;;
        -*) echo "usage: tmux-group-by-project [--dry-run] [SESSION…]" >&2; exit 2 ;;
        *) sessions+=("$1") ;;
    esac
    shift
done
((${#sessions[@]})) || sessions=(dev agents)

ALIASES="${TMUX_PROJECT_ALIASES:-${XDG_CONFIG_HOME:-$HOME/.config}/tmux-project-aliases}"

# Roots that hold many unrelated trees: the project is the directory directly below one.
roots=("$HOME/src" "$HOME/Code/personal" "$HOME/Code" "$HOME/.worktrees"
       "/mnt/nvme/$USER" "/mnt/durable/$USER" "/mnt/scratch/$USER" "$HOME")
# Directories below a root that are buckets rather than projects: step one level further down.
buckets='tmp|scratch|worktrees|wt|session-tmp|agents|shared|lanes|handover|work|src|boxes'

derive() {   # $1 = pane_current_path -> a project name, or nothing
    local path="$1" rest first
    for r in "${roots[@]}"; do
        [[ "$path" == "$r"/* ]] || continue
        rest="${path#"$r"/}"
        first="${rest%%/*}"
        if [[ "$first" =~ ^($buckets)$ ]]; then
            # A bucket with nothing below it names no project: let the title speak instead.
            [[ "$rest" == */* ]] || return 1
            rest="${rest#*/}"
            first="${rest%%/*}"
            [[ "$first" =~ ^($buckets)$ ]] && return 1
        fi
        [[ -n "$first" ]] && { echo "${first,,}"; return 0; }
    done
    return 1
}

apply_alias() {   # $1 = derived name -> the group it belongs to
    local name="$1" pat group
    [[ -r "$ALIASES" ]] || { echo "$name"; return; }
    while read -r pat group; do
        [[ -z "$pat" || "$pat" == \#* || -z "$group" ]] && continue
        # shellcheck disable=SC2053
        [[ "$name" == $pat ]] && { echo "$group"; return; }
    done <"$ALIASES"
    echo "$name"
}

project_of() {   # $1 = pane_current_path -> the group this window belongs in
    local name
    if name="$(derive "$1")" && [[ -n "$name" ]]; then
        apply_alias "$name"
        return
    fi
    # A pane sitting in a root that holds many trees (`~/src` itself, `/tmp`, `$HOME`) names no
    # project. Group those together rather than giving each its own: one `misc` run says "these
    # are in no project tree", where nine one-window groups just say it nine times.
    apply_alias misc
}

for s in "${sessions[@]}"; do
    tmux has-session -t "=$s:" 2>/dev/null || continue
    mapfile -t rows < <(tmux list-windows -t "=$s:" \
        -F '#{window_index}|#{window_name}|#{pane_current_path}|#{pane_title}')
    ((${#rows[@]})) || continue

    plan=()
    for r in "${rows[@]}"; do
        IFS='|' read -r idx name path title <<<"$r"
        base="${name#*·}"          # idempotent: strip the prefix an earlier run wrote
        plan+=("$(project_of "$path")|$idx|$base")
    done
    mapfile -t ordered < <(printf '%s\n' "${plan[@]}" | sort -t'|' -k1,1 -k3,3)

    settled=true
    want=1
    for row in "${ordered[@]}"; do
        IFS='|' read -r proj idx base <<<"$row"
        [[ "$idx" == "$want" ]] || { settled=false; break; }
        tmux display -p -t "=$s:$idx" '#{window_name}' 2>/dev/null \
            | grep -qxF "$proj·$base" || { settled=false; break; }
        want=$((want + 1))
    done
    $settled && continue

    echo "$s: regrouping ${#ordered[@]} windows"
    # Park everything above the live range first, so no move collides with an occupied index.
    park=1000
    for row in "${ordered[@]}"; do
        IFS='|' read -r proj idx base <<<"$row"
        $dry && { printf '  %-16s %3s -> %s·%s\n' "$proj" "$idx" "$proj" "$base"; continue; }
        tmux rename-window -t "=$s:$idx" "$proj·$base"
        tmux move-window -d -s "=$s:$idx" -t "=$s:$park" 2>/dev/null
        park=$((park + 1))
    done
    $dry || tmux move-window -r -t "=$s:"
done
