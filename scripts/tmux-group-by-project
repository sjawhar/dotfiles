#!/usr/bin/env bash
# Keep each tmux session's windows grouped by the project their panes work in.
#
# Sami, 2026-11-05 08:16:33Z, on the agent boxes: "they are grouped in tmux windows: all their
# panes are grouped by the project that they're on". Before this, `dev` and `agents` interleaved
# every stream in arrival order -- one stream's lane between two of another's -- and a window's
# place said nothing about what it was working on.
#
# A one-off sort decays in minutes: every restart the registry makes, and every new lane, opens
# its window at the end. So this runs as a standing job (`stream-job`, every 5 min) and returns
# at once, changing nothing, whenever the order and the names are already right, which keeps
# window indices stable under whoever is reading them.
#
# THE PROJECT IS DERIVED FROM THE PANE'S PATH, never from a list of names in this file: this
# repository is public and several of our trees are named after a customer. The rule is the first
# directory below a root that holds many trees, which is the repository name for a checkout and
# the lane's own directory for scratch; a pane in none of those roots falls back to the first two
# words of its own title, and then to `misc`. A machine can merge or rename groups in
# `~/.config/tmux-project-aliases` (`<shell glob matching the derived name> <group>`, one per
# line, `#` comments), which is machine-local and not committed.
#
# It renames (`<project>·<the window's own name>`) and reorders. It never kills a window, never
# moves a pane between windows and never touches a process. `--dry-run` prints the plan.
set -uo pipefail

dry=false
merge=false
sessions=()
while (($#)); do
    case "$1" in
        --dry-run) dry=true ;;
        --merge) merge=true ;;
        -*) echo "usage: tmux-group-by-project [--dry-run] [--merge] [SESSION…]" >&2; exit 2 ;;
        *) sessions+=("$1") ;;
    esac
    shift
done
((${#sessions[@]})) || sessions=(dev agents)

ALIASES="${TMUX_PROJECT_ALIASES:-${XDG_CONFIG_HOME:-$HOME/.config}/tmux-project-aliases}"

# Roots that hold many unrelated trees: the project is the directory directly below one.
roots=("$HOME/src" "$HOME/Code/personal" "$HOME/Code" "$HOME/.worktrees"
       "/mnt/nvme/$USER" "/mnt/durable/$USER" "/mnt/scratch/$USER" "$HOME")
# Directories below a root that are buckets rather than projects: step one level further down.
buckets='tmp|scratch|worktrees|wt|session-tmp|agents|shared|lanes|handover|work|src|boxes'

derive() {   # $1 = pane_current_path -> a project name, or nothing
    local path="$1" rest first
    for r in "${roots[@]}"; do
        [[ "$path" == "$r"/* ]] || continue
        rest="${path#"$r"/}"
        first="${rest%%/*}"
        if [[ "$first" =~ ^($buckets)$ ]]; then
            # A bucket with nothing below it names no project: let the title speak instead.
            [[ "$rest" == */* ]] || return 1
            rest="${rest#*/}"
            first="${rest%%/*}"
            [[ "$first" =~ ^($buckets)$ ]] && return 1
        fi
        [[ -n "$first" ]] && { echo "${first,,}"; return 0; }
    done
    return 1
}

apply_alias() {   # $1 = derived name -> the group it belongs to
    local name="$1" pat group
    [[ -r "$ALIASES" ]] || { echo "$name"; return; }
    while read -r pat group; do
        [[ -z "$pat" || "$pat" == \#* || -z "$group" ]] && continue
        # shellcheck disable=SC2053
        [[ "$name" == $pat ]] && { echo "$group"; return; }
    done <"$ALIASES"
    echo "$name"
}

project_of() {   # $1 = pane_current_path -> the group this window belongs in
    local name
    if name="$(derive "$1")" && [[ -n "$name" ]]; then
        apply_alias "$name"
        return
    fi
    # A pane sitting in a root that holds many trees (`~/src` itself, `/tmp`, `$HOME`) names no
    # project. Group those together rather than giving each its own: one `misc` run says "these
    # are in no project tree", where nine one-window groups just say it nine times.
    apply_alias misc
}

# --merge: one window per project, each pane of that project a pane in it.
#
# Sami asked for this on 2026-11-05 at 16:59:58Z (dispatch://INFRA-759), after the rename-and-
# reorder above had left 55 windows whose only grouping was their order: "please get the devbox
# agents grouped into tmux windows by their project (their should be eight windows)".
#
# Everything addresses panes and windows by their IDS (%N, @N), never by index. With
# renumber-windows on, which is this configuration's setting, destroying a window renumbers every
# window above it, so a plan made from indexes is wrong by its second move. Measured here on
# 2026-11-05 at 17:09Z: a first attempt that joined by index put CURL into misc and LANE-C into
# ossv before it was stopped. An id survives both the renumbering and the join.
#
# Nothing is signalled: join-pane moves a pane and its process between windows. A pane's border
# already carries `pane_title`, which omp keeps as the agent's name and what it is doing, so the
# window name is free to be the project and no agent becomes unfindable.
merge_session() {
    local s="$1" rows=() row pane path proj target
    mapfile -t rows < <(tmux list-panes -t "=$s:" -s -F '#{pane_id}|#{pane_current_path}')
    ((${#rows[@]})) || return 0

    # Which panes belong to which project, before anything moves.
    local -A panes=()
    local -a projects=()
    for row in "${rows[@]}"; do
        IFS='|' read -r pane path <<<"$row"
        proj="$(project_of "$path")"
        [[ -z "${panes[$proj]:-}" ]] && projects+=("$proj")
        panes[$proj]="${panes[$proj]:-} $pane"
    done

    echo "$s: ${#projects[@]} projects over ${#rows[@]} panes"
    for proj in "${projects[@]}"; do
        set -- ${panes[$proj]}
        printf '  %-16s %2d panes\n' "$proj" "$#"
    done
    $dry && return 0

    # A project's home window must hold that project only. Breaking its first pane out gives a
    # window that is new and therefore exclusive, which matters when a window already holds two
    # projects' panes: picking an existing window would hand the same one to both. A pane that
    # is alone in its window cannot be broken out and does not need to be -- it is already
    # exclusive -- so either way the home is the window that pane is in afterwards.
    local -A home=()
    # A pane cannot be split off a window that has no room for it. A detached session's windows
    # are `default-size`, 80x24 here, and with a border line per pane that fits about six: the
    # first run of this merge lost 13 joins to "create pane failed" and said only "could not
    # move". So each home window is grown to hold its project before anything joins it, which
    # needs `window-size manual` -- under `latest` tmux puts a detached window straight back to
    # default-size. The setting is restored at the end, so an attached client governs again and
    # the windows follow the terminal Sami is actually looking at.
    local most=0
    for proj in "${projects[@]}"; do
        set -- ${panes[$proj]}
        (($# > most)) && most=$#
    done
    local rows=$((most * 5 + 5))
    ((rows < 24)) && rows=24
    # A SESSION option: `-t "=$s:"` with the colon is a window target and tmux then sets it
    # somewhere that does not govern these windows, which left half of them at 80x24 and lost
    # their joins. Name the session with no colon.
    tmux set-option -t "$s" window-size manual

    for proj in "${projects[@]}"; do
        set -- ${panes[$proj]}
        # -t names the session: without it a detached server breaks the pane out into whichever
        # session was last active, not this one. On 2026-11-05 at 17:13Z that scattered seven
        # project windows across two other agents' sessions (car-2829, ad-gt-1606-cross) while
        # every process stayed alive, and `agents` was left holding one pane.
        tmux break-pane -d -s "$1" -n "$proj" -t "=$s:" 2>/dev/null
        home[$proj]="$(tmux display -p -t "$1" '#{window_id}')"
        shift
        for pane in "$@"; do
            [[ "$(tmux display -p -t "$pane" '#{window_id}')" == "${home[$proj]}" ]] && continue
            # Grow before every join, and re-tile after it. join-pane SPLITS one pane, so
            # without re-tiling each join halves the same pane and the seventh has nowhere to
            # go: measured here, every project stopped at 6 panes even in a 250x75 window.
            # Tiling redistributes the whole window, so the next join splits a full-size pane.
            tmux resize-window -t "${home[$proj]}" -x 250 -y "$rows" 2>/dev/null
            tmux join-pane -d -s "$pane" -t "${home[$proj]}" ||
                echo "  could not move $pane into ${home[$proj]} ($proj)" >&2
            tmux select-layout -t "${home[$proj]}" tiled >/dev/null 2>&1
        done
    done

    for proj in "${projects[@]}"; do
        tmux rename-window -t "${home[$proj]}" "$proj"
        tmux select-layout -t "${home[$proj]}" tiled >/dev/null
    done
    tmux set -t "=$s:" window-size latest
    tmux move-window -r -t "=$s:"
    echo "result:"
    tmux list-windows -t "=$s:" -F '  #{window_index} #{window_name} panes=#{window_panes}'
}

if $merge; then
    for s in "${sessions[@]}"; do
        tmux has-session -t "=$s:" 2>/dev/null || continue
        merge_session "$s"
    done
    exit 0
fi

for s in "${sessions[@]}"; do
    tmux has-session -t "=$s:" 2>/dev/null || continue
    mapfile -t rows < <(tmux list-windows -t "=$s:" \
        -F '#{window_index}|#{window_name}|#{pane_current_path}|#{pane_title}')
    ((${#rows[@]})) || continue

    plan=()
    for r in "${rows[@]}"; do
        IFS='|' read -r idx name path title <<<"$r"
        base="${name#*·}"          # idempotent: strip the prefix an earlier run wrote
        proj="$(project_of "$path")"
        # A window --merge made is named for its project and nothing else. Without this, the
        # rename below would make it `infra·infra` on the next scheduled run, and again and
        # again. A bare name that already IS its project is settled: leave it.
        [[ "$base" == "$proj" ]] && base=""
        plan+=("$proj|$idx|$base")
    done
    mapfile -t ordered < <(printf '%s\n' "${plan[@]}" | sort -t'|' -k1,1 -k3,3)

    # The name a settled window carries: "<project>·<its own name>", or just the project for a
    # window --merge made, which has no name of its own beyond it.
    want_name() { [[ -n "$2" ]] && echo "$1·$2" || echo "$1"; }

    settled=true
    want=1
    for row in "${ordered[@]}"; do
        IFS='|' read -r proj idx base <<<"$row"
        [[ "$idx" == "$want" ]] || { settled=false; break; }
        tmux display -p -t "=$s:$idx" '#{window_name}' 2>/dev/null \
            | grep -qxF "$(want_name "$proj" "$base")" || { settled=false; break; }
        want=$((want + 1))
    done
    $settled && continue

    echo "$s: regrouping ${#ordered[@]} windows"
    # Park everything above the live range first, so no move collides with an occupied index.
    park=1000
    for row in "${ordered[@]}"; do
        IFS='|' read -r proj idx base <<<"$row"
        $dry && { printf '  %-16s %3s -> %s\n' "$proj" "$idx" "$(want_name "$proj" "$base")"; continue; }
        tmux rename-window -t "=$s:$idx" "$(want_name "$proj" "$base")"
        tmux move-window -d -s "=$s:$idx" -t "=$s:$park" 2>/dev/null
        park=$((park + 1))
    done
    $dry || tmux move-window -r -t "=$s:"
done
