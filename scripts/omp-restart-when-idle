#!/usr/bin/env bash
# omp-restart-when-idle PANE [TIMEOUT_SECONDS]
#
# Types `/restart` into an omp session's tmux pane at the session's next idle
# turn end, never on a timer. A session runs it on itself, outside its own
# process, so the wait survives the turn ending:
#
#   tmux run-shell -b "~/.dotfiles/scripts/omp-restart-when-idle $TMUX_PANE"
#
# and then ends its turn. "Idle" is the attention queue's signal
# (omp/extensions/attention-queue.ts): when a turn ends idle, the extension
# pushes a line for the pane into $OMP_ATTENTION_DIR/queue.jsonl, stamped with
# the time in milliseconds, and it drops that line when someone types into the
# pane. The script waits for a line for PANE on PANE's tmux server stamped
# after the script started, so an older line left from before the call does
# not count. It types `/restart` and Enter while that line is still queued,
# which means the composer is empty and nobody has typed since.
#
# It prints nothing when it sends the keys: `run-shell -b` would show any output
# in the pane, over the composer. When no idle turn end arrives within
# TIMEOUT_SECONDS (600 by default), it sends nothing. Instead it prints why,
# which tmux shows in the pane, and exits 1.
#
# $TMUX_ATTENTION_TMUX names the tmux command (tests pass "tmux -L <socket>"),
# as in scripts/tmux-attention.
set -euo pipefail

pane=${1:-}
timeout_s=${2:-600}
[[ "$pane" =~ ^%[0-9]+$ ]] || { echo "omp-restart-when-idle: usage: omp-restart-when-idle PANE [TIMEOUT_SECONDS]; PANE is a tmux pane id like %3, not '$pane'" >&2; exit 2; }
[[ "$timeout_s" =~ ^[1-9][0-9]*$ ]] || { echo "omp-restart-when-idle: TIMEOUT_SECONDS is a positive whole number, not '$timeout_s'" >&2; exit 2; }

queue="${OMP_ATTENTION_DIR:-$HOME/.omp/attention}/queue.jsonl"
read -r -a TMUX_CMD <<<"${TMUX_ATTENTION_TMUX:-tmux}"
tm() { "${TMUX_CMD[@]}" "$@"; }

server=$(tm display -p -t "$pane" '#{pid}')
start_ms=$(( $(date +%s%N) / 1000000 ))
deadline=$(( $(date +%s) + timeout_s ))

idle() {
    [ -e "$queue" ] && jq -en --arg pane "$pane" --arg server "$server" --argjson since "$start_ms" \
        '[inputs | select(.pane == $pane and .server == $server and (.stamp // 0) > $since)] | length > 0' \
        "$queue" >/dev/null 2>&1
}

while [ "$(date +%s)" -lt "$deadline" ]; do
    if idle; then
        tm send-keys -t "$pane" -l /restart
        tm send-keys -t "$pane" Enter
        exit 0
    fi
    sleep 0.5
done

echo "omp-restart-when-idle: pane $pane had no idle turn end within ${timeout_s}s; /restart was not sent. Run it again when the session can end its turn."
exit 1
