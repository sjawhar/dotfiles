#!/usr/bin/env node
// mcp-remote-from-env: run mcp-remote with its server URL taken from an environment variable, so
// a URL that is itself a credential (a webhook id, a token in the query) never sits on a command
// line, where `/proc/<pid>/cmdline` shows it to every user and `ps`/`pgrep -af` prints it.
// mcp-remote reads its URL only from argv (`process.argv.slice(2)` in dist/proxy.js, 0.14.3).
//
//   mcp-remote-from-env <ENV_NAME> [mcp-remote args...]
//
// Run it through npx, which puts the pinned mcp-remote's bin on PATH:
//
//   secrets HA_MCP_URL -- npx -y -p mcp-remote@0.14.3 mcp-remote-from-env HA_MCP_URL --allow-http
//
// It takes the URL from ENV_NAME and deletes the variable, so nothing mcp-remote spawns inherits
// it; resolves the `mcp-remote` bin on PATH to its dist/proxy.js; sets process.argv to what
// `mcp-remote <url> args...` would get; and imports proxy.js in this process. The URL lives only
// in this process's memory: the kernel's command line stays `node mcp-remote-from-env ENV_NAME ...`.
//
// A server that wants a bearer token (ha-mcp's webhook in "Sign in with Home Assistant" mode) gets
// it from the variable named like ENV_NAME with its `URL` part replaced by `TOKEN` (HA_MCP_URL ->
// HA_MCP_TOKEN, HA_MCP_URL_BUSH -> HA_MCP_TOKEN_BUSH; a name with no `URL` part gets `_TOKEN`
// appended). When that variable is set and non-empty, the wrapper deletes it too and adds
// `--header "Authorization: Bearer <token>"` to mcp-remote's in-process argv; when it is unset or
// empty, mcp-remote runs exactly as before, with no Authorization header.
//
// mcp-remote also logs the URL to stderr (`Connecting to remote server: <url>`), and whoever
// launched it may keep that stream. So every stderr write in this process, console.error's
// included, has the URL, its path's last segment (the webhook id on its own) and the token
// replaced with `<ENV_NAME>` (`<TOKEN_NAME>` for the token) first.
"use strict";
const fs = require("node:fs");
const path = require("node:path");
const { pathToFileURL } = require("node:url");

function die(code, message) {
    process.stderr.write(`mcp-remote-from-env: ${message}\n`);
    process.exit(code);
}

const [name, ...rest] = process.argv.slice(2);
if (!name) die(2, "usage: mcp-remote-from-env <ENV_NAME> [mcp-remote args...]");
const url = process.env[name];
if (!url) die(2, `${name} is unset or empty`);
delete process.env[name];

const parts = name.split("_");
const urlPart = parts.lastIndexOf("URL");
if (urlPart === -1) parts.push("TOKEN");
else parts[urlPart] = "TOKEN";
const tokenName = parts.join("_");
const token = process.env[tokenName] || "";
delete process.env[tokenName];

const secrets = [
    [url, name],
    [url.split(/[?#]/)[0].split("/").filter(Boolean).pop(), name],
    [token, tokenName],
].filter(([secret]) => secret);
const redact = (text) => secrets.reduce((out, [secret, label]) => out.split(secret).join(`<${label}>`), text);
const writeStderr = process.stderr.write.bind(process.stderr);
process.stderr.write = (chunk, encoding, callback) => {
    if (typeof chunk === "string") return writeStderr(redact(chunk), encoding, callback);
    const done = typeof encoding === "function" ? encoding : callback;
    return writeStderr(redact(Buffer.from(chunk).toString()), done);
};

function findProxy() {
    for (const dir of (process.env.PATH || "").split(path.delimiter)) {
        if (!dir) continue;
        const bin = path.join(dir, "mcp-remote");
        try {
            fs.accessSync(bin, fs.constants.X_OK);
        } catch {
            continue;
        }
        const target = fs.realpathSync(bin);
        if (!target.endsWith(`${path.sep}dist${path.sep}proxy.js`)) {
            die(1, `${bin} resolves to ${target}, not mcp-remote's dist/proxy.js`);
        }
        return target;
    }
    return die(1, "no mcp-remote on PATH; run this through `npx -y -p mcp-remote@<version>`");
}

const proxy = findProxy();
const header = token ? ["--header", `Authorization: Bearer ${token}`] : [];
process.argv = [process.argv[0], proxy, url, ...header, ...rest];
import(pathToFileURL(proxy).href);
