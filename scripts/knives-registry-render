#!/usr/bin/env bash
# Render the committed knives registry, knives/repos.toml, into this machine's copy,
# ~/.config/knives/repos.toml, and record what the render depends on in
# ~/.config/knives/repos.toml.source-sha256: the source's sha256, the oh-my-pi workspaces path
# the render wrote, and the sha256 of this script, whose sed is the render's rule. A merge that
# changed knives/repos.toml used to reach a machine's copy only when someone re-ran install.sh.
# Three callers run this step: installers/knives.sh with no flag, so an install always replaces
# a hand-edited copy, and scripts/dotfiles-follow and scripts/dotfiles-sync's tools step with
# --if-changed, which writes nothing while the copy is a plain file and the record holds all
# three as this run has them. So a copy rendered while the big local disk's directory was absent
# is rendered again once it is there, and the other way round, and a pull that changes this
# script renders again although knives/repos.toml did not change.
# dotfiles-follow and dotfiles-sync run it only for ~/.dotfiles: the copy is what
# scripts/leak-terms-check reads, so another checkout's registry must not reach it.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/../installers/lib.sh"

if_changed=false
if [[ $# -eq 1 && $1 == --if-changed ]]; then
    if_changed=true
elif [[ $# -ne 0 ]]; then
    echo "usage: knives-registry-render [--if-changed]" >&2
    exit 2
fi

source_file="${DOTFILES_DIR}/knives/repos.toml"
registry="$HOME/.config/knives/repos.toml"
record="${registry}.source-sha256"
shown='~/.config/knives/repos.toml'
mkdir -p "$HOME/.config/knives"
# Hashed before the render: a source that changes during the run then differs from the record,
# so the next run renders it again.
sha="$(sha256sum <"$source_file")"
sha="${sha%% *}"
short="${sha:0:12}"
# The registry is rendered, not linked: a committed file names no machine's path, and oh-my-pi's
# worktrees belong on the big local disk where the machine has one (the branches there are large
# and rebuilt often). Everything else in the file is copied byte for byte.
worktrees="$HOME/.worktrees/oh-my-pi"
# The big disk's directory is named for the home it belongs to, not for the login name.
# KNIVES_REGISTRY_NVME_ROOT replaces /mnt/nvme (the tests point it at a scratch tree).
nvme="${KNIVES_REGISTRY_NVME_ROOT:-/mnt/nvme}/$(basename "$HOME")"
[[ -d "$nvme" ]] && worktrees="$nvme/omp-worktrees/branches"
# The render's own rule is this script: its bytes are hashed too, so a changed script renders
# again once.
rule="$(sha256sum <"${BASH_SOURCE[0]}")"
rule="${rule%% *}"

plain_copy() { [[ -f "$registry" && ! -L "$registry" ]]; }
# The record holds exactly these three lines. A record in an older form (the sha256 alone, or
# without the render line) differs, so the copy is rendered again once.
record_text() { printf 'sha256 %s\nworkspaces %s\nrender %s\n' "$sha" "$worktrees" "$rule"; }
record_current() { [[ -f "$record" ]] && record_text | cmp -s - "$record"; }

if $if_changed && plain_copy && record_current; then
    echo "knives-registry-render: $shown unchanged: knives/repos.toml has sha256 $short, the workspaces path is $worktrees and this script has sha256 ${rule:0:12}, as at the last render; wrote nothing"
    exit 0
fi

rendered="" record_tmp=""
trap 'rm -f -- ${rendered:+"$rendered"} ${record_tmp:+"$record_tmp"}' EXIT
rendered="$(mktemp "${registry}.XXXXXX")"
sed "s#^workspaces = \"~/.worktrees/oh-my-pi\"\$#workspaces = \"${worktrees}\"#" \
    "$source_file" > "$rendered"
if plain_copy && cmp -s "$rendered" "$registry"; then
    did="$shown already held the render of knives/repos.toml (sha256 $short); wrote nothing to it"
else
    chmod 644 "$rendered"
    # -T: the copy itself is replaced, a symlink included. A directory at its path is refused, and
    # the run fails, rather than taking the render inside it and saying it wrote the copy.
    mv -fT "$rendered" "$registry"
    rendered=""
    did="wrote $shown from knives/repos.toml (sha256 $short)"
fi

# The record is written after the copy: a run stopped between the two leaves the old record, so
# the next --if-changed run renders again.
if ! record_current; then
    record_tmp="$(mktemp "${record}.XXXXXX")"
    record_text > "$record_tmp"
    chmod 644 "$record_tmp"
    mv -fT "$record_tmp" "$record"
    record_tmp=""
fi
echo "knives-registry-render: $did"
