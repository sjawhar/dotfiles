#!/usr/bin/env bash
# pod-memory-peak: the memory a farm pod actually used, read from OUTSIDE the pod.
#
#   pod-memory-peak <pod-name> [START] [END]
#
# START and END are RFC3339 (2026-11-05T17:00:00Z); they default to the last 6 hours.
# PROJECT overrides the Google Cloud project (default theorem-agent-infra).
#
# Why this exists. A lane sizing a job kind is told to read its pod's own
# /sys/fs/cgroup/memory.peak. A pod with `runtimeClassName: gvisor` CANNOT: gVisor's sandboxed
# /sys does not carry the host's cgroup files, and the read fails with FileNotFoundError on
# memory.peak, memory.max and memory.stat alike (measured 2026-11-05 on a build Job of the farm,
# dispatch://INFRA-6). Every build Job on that farm uses that runtime class, so for those kinds
# "its next pod records its own peak" is not an instruction anybody can follow.
#
# What was ruled out first, so nobody spends an afternoon on it again:
#   - the node's cAdvisor (/api/v1/nodes/<node>/proxy/metrics/cadvisor, which serves
#     container_memory_max_usage_bytes) is Forbidden: these are Autopilot clusters and there is
#     no node access, so reading the pod's cgroup from the node is out for the same reason;
#   - `kubectl top pod` works but is a current reading, not a peak;
#   - the farm's own sampled mem_peak_gib undercounts: it read 3.16 GiB for a pod that was
#     OOM-killed at a 4 GiB limit, where this reading gives 3.74.
#
# What this reads instead: Cloud Monitoring's kubernetes.io/container/memory/used_bytes for the
# k8s_container, which the NODE measures, outside the sandbox. It exists exactly where the in-pod
# read does not.
#
# SIZE FROM non-evictable, NEVER from the total. non-evictable is anonymous pages plus
# unreclaimable slab -- the memory that gets a pod killed. evictable is page cache the kernel
# drops under pressure. Sizing from a figure that counts reclaimable memory is the error that
# produced four wrong readings in one afternoon (memory.peak, free's "available", a cgroup at
# "93%", and a farm column), and it always reads high.
#
# One real pod carries BOTH errors, in opposite directions, and is the reason this script names
# its fields rather than printing a number. On a 3-container build pod on 2026-11-05: the worker
# peaked at 32.36 GiB non-evictable, the pod total was 33.56, and the right request was 43 GiB.
# Summing used_bytes whole would have said over 100 GiB, because evictable alone peaked at 44.71.
# Reading the wrong container -- which this script itself did for 63 minutes -- said 1.43.
# The column matters more than the number.
#
# IT IS SAMPLED, about one point every 93 s. So:
#   - size at peak plus 30%, never at the peak: a spike shorter than the interval is invisible;
#   - an OOM kill beats this number. If a pod dies at a limit above what this prints, the number
#     is wrong and the kill is right.
# For a kind whose pods are NOT gVisor, the in-pod memory.peak is a true maximum and is better.
#
# UNDER gVISOR THIS READS HIGH, AND THE OVERSTATEMENT CAN BE LARGE. The node accounts the gVisor
# sandbox's own memory together with the container, so the figure is an UPPER BOUND on what the
# cgroup was charged rather than the charge itself. Two measurements on 2026-11-05, and the gap
# between them is the point:
#   - a Guaranteed pod at 192Gi/192Gi read 193.22 GiB here, 0.6% above its limit, no OOM kill;
#   - a pod with a 64Gi memory limit read 101.78 GiB here, 59% above it, and WAS OOM-killed.
#     (Burstable, from cpu 5 against a limit of 8; its memory request equals its memory limit,
#     which is what matters -- a memory limit is a hard cap in every QoS class.)
# The second one is physics: a cgroup capped at 64 GiB cannot be charged 101.78, so 37.8 GiB of
# that reading is not the container's. An overstatement of 0.6% is a rounding error; one of 59%
# would have doubled that kind's request if "peak + 30%" had been applied to it.
#
# AND NOTE WHAT THAT POD STILL NEEDS, because the tool cannot give it: the container hit a hard
# 64Gi during work, so it needs MORE than 64Gi, and this series does not say how much more. The
# honest next step for a kind in that state is to re-run it at a higher limit and read where it
# settles -- not to compute a target from a number that is measuring something larger.
#
# SO: CHECK THE READING AGAINST THE POD'S OWN LIMIT BEFORE SIZING FROM IT.
#   kubectl get pod <pod> -n <ns> -o jsonpath='{.spec.containers[*].resources.limits.memory}'
# A reading at or above the limit does not mean the pod needed more. It means the series is
# inflated for that pod and cannot size it; the limit, and whether the pod completed inside it,
# is the better evidence. This tool is reliable for finding a kind that over-asks by a WIDE
# margin -- a 32 GiB ask against a 1 GiB reading is not 59% of anything -- and unreliable for
# trimming the last few per cent off a pod that already runs near its limit.
set -uo pipefail

pod="${1:-}"
if [[ -z "$pod" || "$pod" == -h || "$pod" == --help ]]; then
    sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'
    exit 2
fi
start="${2:-$(date -u -d '6 hours ago' +%Y-%m-%dT%H:%M:%SZ)}"
end="${3:-$(date -u +%Y-%m-%dT%H:%M:%SZ)}"
project="${PROJECT:-theorem-agent-infra}"

token="$(gcloud auth print-access-token 2>/dev/null)" || true
if [[ -z "$token" ]]; then
    echo "pod-memory-peak: no Google access token; run gcloud auth login or use this box's own identity" >&2
    exit 1
fi

filter="metric.type=\"kubernetes.io/container/memory/used_bytes\" AND resource.labels.pod_name=\"$pod\""
curl -sfG -H "Authorization: Bearer $token" \
    "https://monitoring.googleapis.com/v3/projects/$project/timeSeries" \
    --data-urlencode "filter=$filter" \
    --data-urlencode "interval.startTime=$start" \
    --data-urlencode "interval.endTime=$end" |
    POD="$pod" WINDOW="$start .. $end" python3 -c '
import json, os, sys

try:
    body = json.load(sys.stdin)
except ValueError:
    print("pod-memory-peak: the monitoring API returned nothing readable", file=sys.stderr)
    sys.exit(1)
series = body.get("timeSeries", [])
if not series:
    # An absent series is not a zero: say which it is.
    print(f"no series for {os.environ["POD"]} in {os.environ["WINDOW"]}: the pod ran outside this"
          " window, its name is wrong, or its points have aged out of Cloud Monitoring."
          " It is NOT a pod that used no memory.", file=sys.stderr)
    sys.exit(1)
# Key by CONTAINER as well as memory type. Keying by type alone made every container of a
# multi-container pod overwrite the one before it, so the figure printed was whichever series
# Cloud Monitoring happened to return last. Measured 2026-11-05 on a pod whose output sidecar
# peaked at 1.10 GiB and whose worker peaked at 32.36: the tool said 1.10 and suggested 1.43,
# and a lane sizing a freeze from it would have been OOM-killed immediately. Reported by the
# lane that hit it, within an hour of this script being published.
rows = {}
for s in series:
    labels = s["metric"]["labels"]
    container = s["resource"]["labels"].get("container_name", "?")
    kind = labels.get("memory_type", "unlabelled")
    vals = [int(p["value"]["int64Value"]) for p in s.get("points", [])]
    if vals:
        rows.setdefault((container, kind), []).extend(vals)

print(f"{os.environ["POD"]}  {os.environ["WINDOW"]}")
containers = sorted({c for c, _ in rows},
                    key=lambda c: -max(rows.get((c, "non-evictable"), [0])))
for container in containers:
    print(f"  container {container}:")
    for kind in ("non-evictable", "evictable", "unlabelled"):
        vals = rows.get((container, kind))
        if not vals:
            continue
        mark = "  <- size this container from this" if kind == "non-evictable" else ""
        print(f"    {kind:>14}: peak {max(vals) / 2**30:6.2f} GiB   last {vals[0] / 2**30:6.2f} GiB"
              f"   {len(vals)} samples{mark}")

peaks = {c: max(rows.get((c, "non-evictable"), [0])) for c in containers}
total = sum(peaks.values())
if total:
    if len(containers) > 1:
        parts = " + ".join(f"{p / 2**30:.2f}" for p in peaks.values() if p)
        print(f"  pod total non-evictable: {total / 2**30:.2f} GiB ({parts})")
        print(f"  suggested POD request:   {total * 1.3 / 2**30:.2f} GiB (total + 30%)")
        print("  A per-CONTAINER request comes from the container line above; the pod"
              " total is for a pod-level limit. Sizing either one from the wrong number is how"
              " a 32 GiB worker gets a 1.43 GiB request.")
    else:
        print(f"  suggested request: {total * 1.3 / 2**30:.2f} GiB (peak + 30%), rounded up to"
              " the next size your kind uses")
    print("  CHECK THIS AGAINST THE POD LIMIT before sizing from it:"
          " kubectl get pod <pod> -n <ns>"
          " -o jsonpath=\x27{.spec.containers[*].resources.limits.memory}\x27")
    print("  Under gVisor the node counts the sandbox memory with the container, so this peak"
          " is an UPPER BOUND on the cgroup charge, and the overstatement can be large: one pod"
          " at 192Gi read 193.22 (0.6% over), another at 64Gi read 101.78 (59% over) and was"
          " killed. A reading AT OR ABOVE the limit means the series is inflated for that pod,"
          " NOT that the pod needed more. Good for finding a wide over-ask; not for trimming a"
          " pod that already runs near its limit.")
'
