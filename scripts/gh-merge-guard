#!/usr/bin/env python3
"""gh-merge-guard GH-ARGS...: refuse a gh call that merges or approves a pull request of a gated repo.

shims/gh runs it in an agent session, with the arguments that follow `gh`, for `gh api`,
`gh pr merge` and `gh pr review`, unless PR_GATE_MERGE=1 (set by `pr-gate merge` for its own merge
step). Exit 0 lets gh proceed; exit 1 refuses with one line on stderr naming `pr-gate merge`.

It refuses, when the target is a gated repository (GATED):
  - `gh pr merge` (arming `--auto` included; `--disable-auto` only disarms and passes);
  - `gh pr review --approve`;
  - `gh api` PUT repos/O/R/pulls/N/merge;
  - `gh api` POST repos/O/R/pulls/N/reviews, or .../reviews/ID/events, whose event is APPROVE
    (or whose body comes from stdin, which it cannot read);
  - `gh api graphql` naming mergePullRequest, enablePullRequestAutoMerge or enqueuePullRequest, or
    addPullRequestReview/submitPullRequestReview with APPROVE.
The target is -R/--repo, a pull request URL argument, GH_REPO, the api path, or the current
directory's origin remote. A graphql mutation names its pull request by node id: a new-format id
(PR_kw…, PRR_kw…) carries its repository's database id, which is compared with GATED's; a merge or
approve mutation whose ids carry no repository (a legacy id, or none in the call) is refused.

This stops an accidental merge past the gates, not a determined one: PR_GATE_MERGE=1, the real gh by
its own path, or a token used with curl all get past it.
"""
import base64
import json
import os
import re
import subprocess
import sys

# Repository database ids (`gh api repos/O/R --jq .id`), which new-format node ids carry.
GATED = {"sjawhar/legion": 1146927990, "theorem-labs/agent-infra": 1418087578}
MERGE_MUTATIONS = ("mergePullRequest", "enablePullRequestAutoMerge", "enqueuePullRequest")
APPROVE_MUTATIONS = ("addPullRequestReview", "submitPullRequestReview")
NODE_ID = re.compile(r"\bPRR?_kw[A-Za-z0-9_-]+")
LEGACY_ID = re.compile(r"\bMDE[A-Za-z0-9+/]{8,}={0,2}")


def refuse(what: str, repo: str, pr: str = "<N>") -> None:
    target = repo if repo in GATED else "<owner>/<repo>"
    print(f"gh shim: refused {what} on {repo}: merges and approvals of {' and '.join(GATED)} go through "
          f"`pr-gate merge --repo {target} --pr {pr} --require <gates>`, which checks the gates at the head",
          file=sys.stderr)
    sys.exit(1)


def slug(value: str) -> str:
    """owner/repo from OWNER/REPO, HOST/OWNER/REPO or a GitHub remote URL, lowercased; '' if none."""
    value = re.sub(r"\.git$", "", value.strip().rstrip("/"))
    value = re.sub(r"^[a-z]+://", "", value)
    parts = [p for p in re.split(r"[/:]", value) if p]
    return "/".join(parts[-2:]).lower() if len(parts) >= 2 else ""


def default_repo() -> str:
    """gh's own default: GH_REPO, else the current directory's origin remote."""
    if os.environ.get("GH_REPO"):
        return slug(os.environ["GH_REPO"])
    r = subprocess.run(["git", "remote", "get-url", "origin"], capture_output=True, text=True)
    return slug(r.stdout) if r.returncode == 0 else ""


def take(args: list[str], i: int, long: str, short: str | None) -> tuple[str | None, int]:
    """The value of the flag at args[i] and the index of its last token, if it is LONG/SHORT; else None."""
    a = args[i]
    if a == long or (short and a == short):
        return (args[i + 1] if i + 1 < len(args) else ""), i + 1
    if a.startswith(long + "="):
        return a[len(long) + 1:], i
    if short and a.startswith(short) and len(a) > 2 and not a.startswith("--"):
        return a[2:], i
    return None, i


def pr_target(args: list[str], value_flags: dict[str, str | None]) -> tuple[str, str, list[str]]:
    """(repo, pr, bare flags) of `gh pr merge|review`: -R wins, then a URL argument, then gh's default."""
    repo, pr, flags, i = "", "<N>", [], 0
    while i < len(args):
        a, value = args[i], None
        for long, short in value_flags.items():
            value, j = take(args, i, long, short)
            if value is not None:
                if long == "--repo":
                    repo = slug(value)
                i = j
                break
        if value is None and a != "--":
            m = re.search(r"github\.com/([^/]+/[^/]+)/pull/(\d+)", a)
            if a.startswith("-"):
                flags.append(a)
            elif m:
                repo, pr = repo or m.group(1).lower(), m.group(2)
            elif a.isdigit():
                pr = a
        i += 1
    return repo or default_repo(), pr, flags


def guard_pr_merge(args: list[str]) -> None:
    repo, pr, flags = pr_target(args, {"--repo": "-R", "--author-email": "-A", "--body": "-b",
                                      "--body-file": "-F", "--match-head-commit": None, "--subject": "-t"})
    if any(f in ("--disable-auto", "--help", "-h") for f in flags):
        return
    if repo in GATED:
        refuse(f"`gh pr merge {pr}`", repo, pr)


def guard_pr_review(args: list[str]) -> None:
    repo, pr, flags = pr_target(args, {"--repo": "-R", "--body": "-b", "--body-file": "-F"})
    # -a alone or in a cluster of bare short flags (-ac is not valid gh, but cheap to cover).
    if not any(f == "--approve" or re.fullmatch(r"-[a-z]*a[a-z]*", f) for f in flags):
        return
    if repo in GATED:
        refuse(f"`gh pr review {pr} --approve`", repo, pr)


def repo_ids(text: str) -> tuple[set[int], bool]:
    """Repository ids carried by the new-format pull request and review ids in TEXT; and whether
    any id there carries none (a legacy id, or one that does not decode)."""
    ids, opaque = set(), bool(LEGACY_ID.search(text))
    for token in NODE_ID.findall(text):
        raw = token.split("_", 1)[1]
        try:
            b = base64.urlsafe_b64decode(raw + "=" * (-len(raw) % 4))
        except ValueError:
            opaque = True
            continue
        # msgpack [0, repo_id, item_id]: a fixarray, the version 0, then an unsigned int.
        size = {0xCC: 1, 0xCD: 2, 0xCE: 4, 0xCF: 8}.get(b[2]) if len(b) > 3 else None
        if len(b) > 2 and 0x92 <= b[0] <= 0x9F and b[1] == 0 and b[2] <= 0x7F:
            ids.add(b[2])
        elif size and 0x92 <= b[0] <= 0x9F and b[1] == 0 and len(b) >= 3 + size:
            ids.add(int.from_bytes(b[3:3 + size], "big"))
        else:
            opaque = True
    return ids, opaque


def read_file(path: str) -> str:
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            return f.read()
    except OSError:
        return ""


def guard_api(args: list[str]) -> None:
    method, path, fields, body, stdin_body, i = None, None, {}, "", False, 0
    skip = (("--jq", "-q"), ("--template", "-t"), ("--header", "-H"), ("--preview", "-p"),
            ("--hostname", None), ("--cache", None))
    while i < len(args):
        a = args[i]
        value, j = take(args, i, "--method", "-X")
        if value is not None:
            method, i = value.upper(), j + 1
            continue
        for long, short in (("--raw-field", "-f"), ("--field", "-F")):
            value, j = take(args, i, long, short)
            if value is not None:
                key, _, v = value.partition("=")
                if short == "-F" and v == "@-":
                    stdin_body = True
                else:
                    v = read_file(v[1:]) if short == "-F" and v.startswith("@") else v
                    key = key.split("[", 1)[0]
                    fields[key] = fields.get(key, "") + v
                break
        if value is None:
            value, j = take(args, i, "--input", None)
            if value is not None:
                stdin_body = stdin_body or value == "-"
                body = "" if value == "-" else read_file(value)
        for long, short in skip if value is None else ():
            value, j = take(args, i, long, short)
            if value is not None:
                break
        if value is not None:
            i = j + 1
            continue
        if not a.startswith("-") and path is None:
            path = a
        i += 1
    if path is None:
        return
    method = method or ("POST" if fields or body or stdin_body else "GET")
    path = re.sub(r"^https?://[^/]+/", "", path).strip("/").split("?", 1)[0]
    if "{owner}" in path or "{repo}" in path:
        owner, _, name = default_repo().partition("/")
        path = path.replace("{owner}", owner).replace("{repo}", name)

    if path == "graphql":
        text = "\n".join([body, *fields.values()])
        if stdin_body and not text.strip():
            repo = default_repo()
            if repo in GATED:
                refuse("`gh api graphql` with its query on stdin, which the guard cannot read (pass -f query=…)", repo)
            return
        found = [m for m in MERGE_MUTATIONS if m in text]
        found += [m for m in APPROVE_MUTATIONS if m in text and "APPROVE" in text]
        if not found:
            return
        what = f"`gh api graphql` {', '.join(found)}"
        ids, opaque = repo_ids(text)
        for name, rid in GATED.items():
            if rid in ids:
                refuse(what, name)
        if opaque or not ids:
            refuse(what + " (its ids name no repository the guard can read; pass the PR_kw… node id)",
                   "an unknown repository")
        return

    m = re.fullmatch(r"repos/([^/]+/[^/]+)/pulls/(\d+)/(merge|reviews(?:/\d+/events)?)", path)
    if not m or m.group(1).lower() not in GATED:
        return
    repo, pr, kind = m.group(1).lower(), m.group(2), m.group(3)
    if kind == "merge" and method == "PUT":
        refuse(f"`gh api -X PUT {path}`", repo, pr)
    if kind != "merge" and method == "POST":
        event = fields.get("event", "")
        if body:
            try:
                event = str(json.loads(body).get("event") or event)
            except (ValueError, AttributeError):
                event = "APPROVE" if "APPROVE" in body else event
        if event.upper() == "APPROVE":
            refuse(f"`gh api {path}` with event APPROVE", repo, pr)
        if stdin_body and not event:
            refuse(f"`gh api {path}` with its body on stdin, which the guard cannot read (pass --input FILE)", repo, pr)


def main() -> None:
    args = sys.argv[1:]
    if args[:1] == ["api"]:
        guard_api(args[1:])
    elif args[:2] == ["pr", "merge"]:
        guard_pr_merge(args[2:])
    elif args[:2] == ["pr", "review"]:
        guard_pr_review(args[2:])


if __name__ == "__main__":
    main()
