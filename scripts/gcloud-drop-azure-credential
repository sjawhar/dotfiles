#!/usr/bin/env python3
"""gcloud-drop-azure-credential <gcloud config dir>: remove the Azure box credential gcloud stored.

Run on a Google VM only (scripts/on-google-vm); installers/gcloud-box.sh and shims/gcloud call it.

On an Azure box, installers/gcloud-box.sh's Azure branch stores the box account's credential in
gcloud's credential store (credentials.db) as an external_account entry whose subject token comes
from the Azure Instance Metadata Service (credential_source.url, path /metadata/identity/oauth2/
token). A config dir copied from such a box to a Google VM keeps that entry: ~/.config/gcloud, or a
session's own CLOUDSDK_CONFIG that an agent session moved from sami-rocqperf to sami-devbox brought
along (LINUX-1248's /mnt/nvme/sami/tmp/linux-1248/gcloud, 2026-11-03, dispatch://INFRA-993). gcloud
reads a stored entry before it asks the metadata server (lib/googlecloudsdk/core/credentials/
store.py, _Load), and on a Google VM that Azure path answers 404, so every call failed with
"Unable to retrieve Identity Pool subject token ... gcloud auth login". With the entry gone, gcloud
takes the account's token from the Google metadata server, when the account is the VM's attached
one (dev-sjawhar on sami-devbox).

It removes each stored external_account entry whose credential_source.url has that Azure path, and
the same account's cached token in access_tokens.db; no other entry is touched (a person's login,
a metadata-server entry). Then it compacts credentials.db (VACUUM), so no copy of the removed entry
stays in the file's free pages: shims/gcloud looks for the Azure path's bytes in that file before it
calls this. Prints one line per removed account, "removed the stored external_account credential of
<account> (an Azure one) from <dir>"; exits 0, also when there was nothing to remove, and 1 when a
store cannot be changed.
"""

import json
import os
import sqlite3
import sys
from urllib.parse import urlsplit

AZURE_IMDS_TOKEN_PATH = "/metadata/identity/oauth2/token"
# gcloud's own sqlite calls wait 5 s on a lock; a store a busy box holds longer is left for the next call.
BUSY_SECONDS = 10


def is_azure_entry(value: str) -> bool:
    try:
        credential = json.loads(value)
    except ValueError:
        return False
    if not isinstance(credential, dict) or credential.get("type") != "external_account":
        return False
    source = credential.get("credential_source")
    url = source.get("url") if isinstance(source, dict) else None
    return isinstance(url, str) and urlsplit(url).path == AZURE_IMDS_TOKEN_PATH


def main() -> int:
    if len(sys.argv) != 2:
        print("usage: gcloud-drop-azure-credential <gcloud config dir>", file=sys.stderr)
        return 2
    config_dir = sys.argv[1]
    store = os.path.join(config_dir, "credentials.db")
    if not os.path.isfile(store):
        return 0
    try:
        db = sqlite3.connect(store, timeout=BUSY_SECONDS)
        try:
            if not db.execute("SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = 'credentials'").fetchone():
                return 0
            accounts = [account for account, value in db.execute("SELECT account_id, value FROM credentials")
                        if is_azure_entry(value if isinstance(value, str) else bytes(value).decode("utf-8", "replace"))]
            with db:
                db.executemany("DELETE FROM credentials WHERE account_id = ?", [(a,) for a in accounts])
            db.execute("VACUUM")
        finally:
            db.close()
        tokens = os.path.join(config_dir, "access_tokens.db")
        if accounts and os.path.isfile(tokens):
            tdb = sqlite3.connect(tokens, timeout=BUSY_SECONDS)
            try:
                if tdb.execute("SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = 'access_tokens'").fetchone():
                    with tdb:
                        tdb.executemany("DELETE FROM access_tokens WHERE account_id = ?", [(a,) for a in accounts])
            finally:
                tdb.close()
    except sqlite3.Error as error:
        print(f"gcloud-drop-azure-credential: cannot change {config_dir}'s credential store: {error}", file=sys.stderr)
        return 1
    for account in accounts:
        print(f"removed the stored external_account credential of {account} (an Azure one) from {config_dir}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
