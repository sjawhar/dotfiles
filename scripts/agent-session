#!/usr/bin/env bash
# agent-session: the session environment every agent launcher here shares, then the agent.
#
#   agent-session <agent> [args…]
#
# shims/omp and scripts/cld exec their agent through this; every hop is an exec, so the pid the
# secrets broker's helper registers is the agent's. It
#   - includes gh-app-routes.gitconfig once (GIT_CONFIG_*), so git and gh in the session act as
#     the repo owner's GitHub App, never the user's own login;
#   - puts this checkout's shims/ first on PATH: a session keeps the PATH it started with, and a
#     launching shell's mise hook may have put the real gh ahead of shims/gh;
#   - points GH_CONFIG_DIR at the gh config directory with no login of the user's
#     (scripts/gh-agent-config), so a gh that runs past shims/gh never acts as the user;
#   - points GOOGLE_APPLICATION_CREDENTIALS at the machine's own Google identity, where it has one
#     (installers/gcloud-box.sh), so a Google client library or Pulumi acts as the machine, not as
#     the user, unless the caller names a credential file of its own; on a Google VM it sets
#     none, and the libraries take the VM's account from the metadata server;
#   - gives the session a TMPDIR of its own on the big disk and points the uv, cargo and Go
#     caches there, on a machine that has one (below); on one that has not, nothing changes;
#   - exports the model-spend telemetry variables when this machine holds the collector's token (below);
#   - refuses to resume an omp session that `agentbox move --to` moved off this machine (below);
#   - execs the first <agent> on PATH that is not a wrapper, through scripts/agent-secrets-session.
#     A wrapper is a file whose real path is in a shims/ directory (shims/omp, another checkout's
#     copy of it) or mise's own shims dir, which falls back to PATH when mise has no version for
#     the directory; either would hand the call back to a launcher.
set -euo pipefail

DOTFILES_DIR="${DOTFILES_DIR:-$HOME/.dotfiles}"

(( $# )) || { echo "usage: agent-session <agent> [args…]" >&2; exit 2; }
agent="$1"
shift

# A session `agentbox move --to <machine>` moved to another machine runs THERE now, and one
# session id must never run on two machines at once (dispatch://INFRA-993, R4). The move writes
# a marker, `agentbox-moved`, in the session's own directory (its transcript path without
# `.jsonl`, which holds its subagent transcripts) and the same file as
# ~/.omp/agentbox-moved/<session id>, since a resume by id cannot afford the walk of the session
# tree that finds the transcript (12.5 s on sami-rocqperf, 2026-11-02). Every launcher of omp
# comes through here (shims/omp; scripts/agentbox-run.ts checks it too, in a box), so a resume of
# that session - by path or by id (or a prefix of one) - stops here. The marker counts only on the
# machine it names as `from=`: a copy that reaches the target with a later bulk copy is inert
# there. The move removes it again when the resume on the target fails.
if [[ "${agent##*/}" == omp ]]; then
    moved_index="$HOME/.omp/agentbox-moved"
    this_machine="${AGENTBOX_HOST:-$(hostname -s)}"
    moved_refuse() {
        local marker="$1" from="" to="" at=""
        [[ -f "$marker" ]] || return 0
        from="$(sed -n 's/^from=//p' "$marker" | head -1)"
        [[ "$from" == "$this_machine" ]] || return 0
        to="$(sed -n 's/^to=//p' "$marker" | head -1)"
        at="$(sed -n 's/^time=//p' "$marker" | head -1)"
        echo "agent-session: this session moved to $to at $at (marker $marker); it runs there now, and one session must not run on two machines. Resume it on $to. If that move failed, the move removes this marker itself; remove it by hand only after checking that the session is not running on $to." >&2
        exit 3
    }
    prev="" target=""
    for arg in "$@"; do
        [[ "$arg" == -- ]] && break
        case "$prev" in --resume|-r|--session) target="$arg" ;; esac
        case "$arg" in --resume=*|--session=*) target="${arg#*=}" ;; esac
        prev="$arg"
    done
    if [[ -n "$target" ]]; then
        if [[ "$target" == *.jsonl ]]; then
            moved_refuse "${target%.jsonl}/agentbox-moved"
            [[ "$target" =~ _([0-9a-f-]{36})\.jsonl$ ]] && moved_refuse "$moved_index/${BASH_REMATCH[1]}"
        elif [[ "$target" =~ ^[0-9a-f-]+$ && -d "$moved_index" ]]; then
            for marker in "$moved_index/$target"*; do moved_refuse "$marker"; done
        fi
    fi
    unset -f moved_refuse
fi

routed=""
for ((i = 0; i < ${GIT_CONFIG_COUNT:-0}; i++)); do
    value="GIT_CONFIG_VALUE_$i"
    [[ "${!value:-}" == *gh-app-routes.gitconfig ]] && routed=1
done
if [[ -z "$routed" ]]; then
    n="${GIT_CONFIG_COUNT:-0}"
    export "GIT_CONFIG_KEY_$n=include.path" "GIT_CONFIG_VALUE_$n=$DOTFILES_DIR/gh-app-routes.gitconfig"
    export GIT_CONFIG_COUNT="$((n + 1))"
fi

shims="$DOTFILES_DIR/shims"
dirs=()
IFS=':' read -ra entries <<< "$PATH"
for dir in "${entries[@]}"; do
    [[ -n "$dir" && "$dir" != "$shims" ]] && dirs+=("$dir")
done
PATH="$shims"
for dir in "${dirs[@]}"; do PATH+=":$dir"; done
export PATH

# A directory a caller chose is kept, unless it is the user's own default, which holds his login.
user_gh_cfg="${XDG_CONFIG_HOME:-$HOME/.config}/gh"
if [[ -z "${GH_CONFIG_DIR:-}" || "${GH_CONFIG_DIR%/}" == "$user_gh_cfg" ]]; then
    if gh_cfg="$("$DOTFILES_DIR/scripts/gh-agent-config")"; then
        export GH_CONFIG_DIR="$gh_cfg"
    else
        echo "agent-session: scripts/gh-agent-config failed; GH_CONFIG_DIR is not set, so only shims/gh keeps gh off the user's login" >&2
    fi
fi

# Google's application default credentials (ADC). Client libraries, gcloud's application-default
# commands, Pulumi's gcp provider and its gs:// backend read GOOGLE_APPLICATION_CREDENTIALS, and
# without it the well-known file application_default_credentials.json, which holds whoever last
# ran an ADC login: on sami-rocqperf the user's own login since 2026-11-01T02:53Z, so an agent's
# library call ran as him. On a machine enrolled in the box identity, installers/gcloud-box.sh
# writes the keyless external_account configuration of its service account to
# box_credential_config.json, a file only that installer writes (gcloud rewrites its own copy under
# legacy_credentials/ whenever it stores credentials). A file a caller chose is kept, unless it is
# the well-known file, which names no identity of its own.
#
# A Google VM (sami-devbox, dispatch://INFRA-993) has no such file: gcloud-box.sh removes it and the
# well-known file, and ADC falls through to the metadata server, which is the VM's attached
# account. A box_credential_config.json there is one carried over from an Azure machine; it fetches
# its token from Azure's IMDS, which a Google VM does not have, so it is not exported. The probe
# runs only when that file exists, so a machine without one pays nothing for it.
gcloud_cfg="${CLOUDSDK_CONFIG:-$HOME/.config/gcloud}"
box_adc="$gcloud_cfg/box_credential_config.json"
if [[ -f "$box_adc" ]] && [[ -z "${GOOGLE_APPLICATION_CREDENTIALS:-}" \
    || "$(realpath -m "$GOOGLE_APPLICATION_CREDENTIALS")" == "$(realpath -m "$gcloud_cfg/application_default_credentials.json")" ]] \
    && ! "$DOTFILES_DIR/scripts/on-google-vm"; then
    export GOOGLE_APPLICATION_CREDENTIALS="$box_adc"
fi

# Scratch and language caches on the big disk, where this machine has one (dispatch://INFRA-613).
# Root holds every session's transcript, so a root that fills wedges the whole box, and on
# 2026-10-27 it filled in 5h41m - not from one writer, but from thousands of tool runs writing
# into root-resident scratch and caches (~/.cache/uv 4.4 GB, ~/.cargo 3.1 GB, ~/.cache/go-build,
# /tmp). .bashrc sets the same cache variables for interactive shells; a session's tool shell is
# not interactive, which is why they are set here, for the agent and everything it runs.
#
# A caller's value always wins, and a machine without the directory keeps the home defaults: a
# laptop, and an agent box, which mounts an allow-list of $HOME and no /mnt at all
# (agentbox/AGENTS.md), so no box session is given a path it would lose with the box.
#
# TMPDIR is per session and removed when the session ends: the directory is named for this
# shell's pid, which is the agent's own pid (every hop from here is an exec), and
# devbox/session-scratch-reap.service removes a directory no live process holds. A nested launch
# (scripts/omp-fork) inherits the session's directory rather than making one that outlives it.
#
# On sami-devbox TMPDIR, GOTMPDIR, the session's TMPDIR and the Go build and uv caches go to the
# local-SSD scratch, /mnt/scratch/<user>, which devbox/gce-disks makes at every boot with the same
# layout (dispatch://INFRA-993, "Software"); a machine without it keeps them on /mnt/nvme.
nvme_home="/mnt/nvme/${USER:-$(id -un)}"
scratch_home="$nvme_home"
if [[ -d "/mnt/scratch/${USER:-$(id -un)}" ]]; then
    scratch_home="/mnt/scratch/${USER:-$(id -un)}"
fi
if [[ -d "$nvme_home" ]]; then
    export UV_CACHE_DIR="${UV_CACHE_DIR:-$scratch_home/cache/uv}"
    # A venv on the state disk cannot hardlink from a cache on scratch; say copy, or uv warns at
    # every install that it fell back to it.
    if [[ "$UV_CACHE_DIR" == /mnt/scratch/* ]]; then
        export UV_LINK_MODE="${UV_LINK_MODE:-copy}"
    fi
    export GOCACHE="${GOCACHE:-$scratch_home/gocache}"
    export GOMODCACHE="${GOMODCACHE:-$nvme_home/gomodcache}"
    # Go writes its build tree to GOTMPDIR, and only falls back to TMPDIR when it is unset. The
    # session's own TMPDIR below already lands on the big disk, so this is what keeps a `go build`
    # off the root disk in a tool shell that sets a TMPDIR of its own (dispatch://INFRA-6).
    if mkdir -p "$scratch_home/gotmp" 2>/dev/null && [[ -w "$scratch_home/gotmp" ]]; then
        export GOTMPDIR="${GOTMPDIR:-$scratch_home/gotmp}"
    fi
    # cargo keeps its registry and git checkouts under CARGO_HOME and has no variable for those
    # alone, so the whole directory moves and bin/ links back to ~/.cargo/bin, which is on PATH
    # and holds rustup's shims and every `cargo install` binary. Its own default, $HOME/.cargo,
    # counts as unset: `mise env` exports exactly that value, so every session launched through
    # shims/omp arrives here with it already set and no session would ever move.
    if [[ "${CARGO_HOME:-$HOME/.cargo}" == "$HOME/.cargo" ]] && mkdir -p "$nvme_home/cargo" 2>/dev/null; then
        if [[ -d "$HOME/.cargo/bin" && ! -e "$nvme_home/cargo/bin" ]]; then
            ln -sfn "$HOME/.cargo/bin" "$nvme_home/cargo/bin" 2>/dev/null || true
        fi
        export CARGO_HOME="$nvme_home/cargo"
    fi
    if [[ -n "${AGENT_SESSION_SCRATCH:-}" && -d "${AGENT_SESSION_SCRATCH:-}" ]]; then
        export TMPDIR="$AGENT_SESSION_SCRATCH"
    elif mkdir -p -m 700 "$scratch_home/session-tmp" 2>/dev/null \
        && scratch="$(mktemp -d "$scratch_home/session-tmp/$$-XXXXXXXX" 2>/dev/null)"; then
        export AGENT_SESSION_SCRATCH="$scratch" TMPDIR="$scratch"
    fi
fi

prog=""
if [[ "$agent" == */* ]]; then
    prog="$agent"
else
    mise_shims="${MISE_DATA_DIR:-$HOME/.mise}/shims"
    for dir in "${dirs[@]}"; do
        [[ "$dir" != "$mise_shims" && -f "$dir/$agent" && -x "$dir/$agent" ]] || continue
        real="$(realpath "$dir/$agent")"
        [[ "${real%/*}" == */shims ]] && continue
        prog="$dir/$agent"
        break
    done
    if [[ -z "$prog" ]]; then
        echo "agent-session: no $agent on PATH other than a wrapper (a shims/ dir, $mise_shims); a mise-managed agent needs its pinned version installed (mise install)" >&2
        exit 127
    fi
fi

# Model spend (dispatch://INFRA-165): scripts/agent-spend-env.sh, shared with shims/claude and shims/codex, says
# what is exported and how the session's project is chosen.
# shellcheck source=SCRIPTDIR/agent-spend-env.sh
. "$DOTFILES_DIR/scripts/agent-spend-env.sh"
agent_spend_env "$prog" "$@"

exec "$DOTFILES_DIR/scripts/agent-secrets-session" "$prog" "$@"
