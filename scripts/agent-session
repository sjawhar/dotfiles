#!/usr/bin/env bash
# agent-session: the session environment every agent launcher here shares, then the agent.
#
#   agent-session <agent> [args…]
#
# shims/omp and scripts/cld exec their agent through this; every hop is an exec, so the pid the
# secrets broker's helper registers is the agent's. It
#   - includes gh-app-routes.gitconfig once (GIT_CONFIG_*), so git and gh in the session act as
#     the repo owner's GitHub App, never the user's own login;
#   - puts this checkout's shims/ first on PATH: a session keeps the PATH it started with, and a
#     launching shell's mise hook may have put the real gh ahead of shims/gh;
#   - points GH_CONFIG_DIR at the gh config directory with no login of the user's
#     (scripts/gh-agent-config), so a gh that runs past shims/gh never acts as the user;
#   - points GOOGLE_APPLICATION_CREDENTIALS at the machine's own Google identity, where it has one
#     (installers/gcloud-box.sh), so a Google client library or Pulumi acts as the machine, not as
#     the user, unless the caller names a credential file of its own; on a Google VM it sets
#     none, and the libraries take the VM's account from the metadata server;
#   - turns gcloud's file logging off (CLOUDSDK_CORE_DISABLE_FILE_LOGGING=true) unless the caller
#     set it, so a gcloud run past shims/gcloud writes no token into a log file (below);
#   - turns CodeGraph's usage telemetry off (CODEGRAPH_TELEMETRY=0) unless the caller set it (below);
#   - gives the session a TMPDIR of its own on the big disk and points the uv, cargo and Go
#     caches there, on a machine that has one (below); on one that has not, nothing changes;
#   - exports the model-spend telemetry variables when this machine holds the collector's token (below);
#   - refuses to resume an omp session that `agentbox move --to` moved off this machine (below);
#   - names omp/config.probe.yml, which turns the subagent progress probe on, in an omp session's
#     PI_CONFIG_FILES only when the omp it runs is a release that holds the probe's fix (below);
#   - sets none of DISPATCH_URL, DISPATCH_TOKEN(_FILE), ENVOY_URL, ENVOY_NATS_URL, ENVOY_TOKEN(_FILE)
#     and NATS_NKEY_SEED(_FILE): each overrides one field of every profile's envoy.json, and would
#     turn Envoy on for a profile that has none (scripts/agentbox's session_env sets none either);
#   - execs the first <agent> on PATH that is not a wrapper, through scripts/agent-secrets-session.
#     A wrapper is a file whose real path is in a shims/ directory (shims/omp, another checkout's
#     copy of it) or mise's own shims dir, which falls back to PATH when mise has no version for
#     the directory; either would hand the call back to a launcher. When there is none (a move of
#     the checkout brought a pin nothing installed yet), it runs `mise install` once in the
#     checkout, holding $MISE_DATA_DIR/.dotfiles-install.lock as oryx/install.sh's op step,
#     dotfiles-sync's tools step, dotfiles-follow, shims/knives, installers/mise.sh and
#     installers/librarian-harness-host.sh do, so a launch during a mover's install waits for it.
#     That `mise install` alone gets DOTFILES_INSTALL_LOCK_HELD=1, so a knives call under it that
#     lacks its pin exits 127 at once instead of waiting on the lock, and the agent does not get the
#     marker. Then, whatever the install's result, it asks `mise which <agent>` for the pinned
#     binary and execs that when it is not a wrapper, and exits 127 only when it is missing. A
#     failed install's last lines go to stderr, never stdout.
set -euo pipefail

# No session makes group- or other-writable files, whatever started the shell above it. A tmux
# server started under the systemd user manager takes the manager's 0002 (pam_umask,
# USERGROUPS_ENAB in login.defs), one started another way 0022, so the same command made
# group-writable files in one session and not in the next: after the reset of 2026-11-25
# (dispatch://INFRA-5874) every host session had 0002, and a test suite that refuses a
# group-writable file failed on its own fixtures. A box's sessions run with docker's 0022.
# This adds 022 to the caller's mask and keeps a stricter one (0077 stays 0077).
umask "$(printf '%04o' $(( 8#$(umask) | 8#022 )))"

# The dotfiles checkout this script is in, not the one under HOME: a caller may give the session a
# HOME of its own (shims/tests/test_shim_moved_home.py), and shims/omp execs this script by its path.
_agent_session_self="$(command -p readlink -f -- "${BASH_SOURCE[0]}")"
DOTFILES_DIR="${DOTFILES_DIR:-${_agent_session_self%/scripts/*}}"
# Absolute once, before any cd. A prefix of $PWD, not a `cd` into it, so a directory that exists
# but cannot be entered does not end the launch here under set -e.
[[ "$DOTFILES_DIR" = /* ]] || DOTFILES_DIR="$PWD/$DOTFILES_DIR"

(( $# )) || { echo "usage: agent-session <agent> [args…]" >&2; exit 2; }
agent="$1"
shift

# A session `agentbox move --to <machine>` moved to another machine runs THERE now, and one
# session id must never run on two machines at once (dispatch://INFRA-993, R4). The move writes
# a marker, `agentbox-moved`, in the session's own directory (its transcript path without
# `.jsonl`, which holds its subagent transcripts) and the same file as
# ~/.omp/agentbox-moved/<session id>, since a resume by id cannot afford the walk of the session
# tree that finds the transcript (12.5 s on sami-rocqperf, 2026-11-02). Every launcher of omp
# comes through here (shims/omp; scripts/agentbox-run.ts checks it too, in a box), so a resume of
# that session - by path or by id (or a prefix of one) - stops here. The marker counts only on the
# machine it names as `from=`: a copy that reaches the target with a later bulk copy is inert
# there. The move removes it again when the resume on the target fails.
if [[ "${agent##*/}" == omp ]]; then
    moved_index="$HOME/.omp/agentbox-moved"
    this_machine="${AGENTBOX_HOST:-$(hostname -s)}"
    moved_refuse() {
        local marker="$1" from="" to="" at=""
        [[ -f "$marker" ]] || return 0
        from="$(sed -n 's/^from=//p' "$marker" | head -1)"
        [[ "$from" == "$this_machine" ]] || return 0
        to="$(sed -n 's/^to=//p' "$marker" | head -1)"
        at="$(sed -n 's/^time=//p' "$marker" | head -1)"
        echo "agent-session: this session moved to $to at $at (marker $marker); it runs there now, and one session must not run on two machines. Resume it on $to. If that move failed, the move removes this marker itself; remove it by hand only after checking that the session is not running on $to." >&2
        exit 3
    }
    prev="" target=""
    for arg in "$@"; do
        [[ "$arg" == -- ]] && break
        case "$prev" in --resume|-r|--session) target="$arg" ;; esac
        case "$arg" in --resume=*|--session=*) target="${arg#*=}" ;; esac
        prev="$arg"
    done
    if [[ -n "$target" ]]; then
        if [[ "$target" == *.jsonl ]]; then
            moved_refuse "${target%.jsonl}/agentbox-moved"
            [[ "$target" =~ _([0-9a-f-]{36})\.jsonl$ ]] && moved_refuse "$moved_index/${BASH_REMATCH[1]}"
        elif [[ "$target" =~ ^[0-9a-f-]+$ && -d "$moved_index" ]]; then
            for marker in "$moved_index/$target"*; do moved_refuse "$marker"; done
        fi
    fi
    unset -f moved_refuse
    # Nor is a session resumed while an omp on this machine runs it (scripts/omp-session-live):
    # every resume path comes through here - tmux-resurrect-omp, a pane restarter, a move's
    # relauncher, a person - and on 2026-11-03 two of them started 51 live sessions a second time.
    # It waits up to 60 s, since a relaunch that follows a hang-up starts while the old omp is
    # still tearing down.
    # Inside an agent box omp-session-live refuses to answer about the HOST and exits 3, and a
    # non-zero exit here reads as "no omp runs it": measured 2026-11-05, `omp --resume <id>` run
    # inside a box whose own omp was running that very session (pid 2433) passed this guard and
    # started a second copy. A box can answer about ITSELF, which is where an in-box duplicate
    # is made - an `agentbox restart` relaunch, a move's respawn, a person or an agent at the
    # box's own shell - so it is asked that way, with its own /proc. A duplicate of this session
    # in ANOTHER box, or on the host, is refused where such a launch happens: `agentbox new` on
    # the host asks the host's /proc before it starts a box at all.
    live_env=()
    live_where="on this machine"
    if [[ -e /.dockerenv && -z "${OMP_SESSION_LIVE_PROC:-}" ]]; then
        live_env=(env OMP_SESSION_LIVE_PROC=/proc)
        live_where="in this agent box"
    fi
    if [[ -n "$target" ]] && live="$(${live_env[@]+"${live_env[@]}"} "$DOTFILES_DIR/scripts/omp-session-live" --wait "${AGENT_SESSION_LIVE_WAIT:-60}" "$target")"; then
        echo "agent-session: session $target is running already $live_where ($(sed 's/\t/: /' <<<"$live" | paste -sd ';')); one session must not run twice, so it is not resumed. If that omp is stuck, end it by its pid first." >&2
        exit 3
    fi
fi

routed=""
for ((i = 0; i < ${GIT_CONFIG_COUNT:-0}; i++)); do
    value="GIT_CONFIG_VALUE_$i"
    [[ "${!value:-}" == *gh-app-routes.gitconfig ]] && routed=1
done
if [[ -z "$routed" ]]; then
    n="${GIT_CONFIG_COUNT:-0}"
    export "GIT_CONFIG_KEY_$n=include.path" "GIT_CONFIG_VALUE_$n=$DOTFILES_DIR/gh-app-routes.gitconfig"
    export GIT_CONFIG_COUNT="$((n + 1))"
fi

shims="$DOTFILES_DIR/shims"
dirs=()
IFS=':' read -ra entries <<< "$PATH"
for dir in "${entries[@]}"; do
    [[ -n "$dir" && "$dir" != "$shims" ]] && dirs+=("$dir")
done
PATH="$shims"
for dir in "${dirs[@]}"; do PATH+=":$dir"; done
export PATH

# Envoy's machine identity. pi-envoy uses ENVOY_MACHINE_ID, else the kernel's hostname, which on
# a Google VM is the FQDN. Nothing set it for a session outside an agent box, so an unboxed
# session registered as `sami-devbox.us-west4-a.c.theorem-agent-infra.internal` while every boxed
# session on the same machine registered as `sami-devbox` (scripts/agentbox sets it from
# AGENTBOX_HOST): one machine appeared as two, and anything scoped to a machine -- a broadcast,
# a role check, a census -- saw one group of them. A box's value, and any a caller chose, stay.
if [[ -z "${ENVOY_MACHINE_ID:-}" ]]; then
    envoy_machine="${AGENTBOX_HOST:-$(hostname -s)}"
    export ENVOY_MACHINE_ID="${envoy_machine%%.*}"
fi

# A directory a caller chose is kept, unless it is the user's own default, which holds his login.
user_gh_cfg="${XDG_CONFIG_HOME:-$HOME/.config}/gh"
if [[ -z "${GH_CONFIG_DIR:-}" || "${GH_CONFIG_DIR%/}" == "$user_gh_cfg" ]]; then
    if gh_cfg="$("$DOTFILES_DIR/scripts/gh-agent-config")"; then
        export GH_CONFIG_DIR="$gh_cfg"
    else
        echo "agent-session: scripts/gh-agent-config failed; GH_CONFIG_DIR is not set, so only shims/gh keeps gh off the user's login" >&2
    fi
fi

# Google's application default credentials (ADC). Client libraries, gcloud's application-default
# commands, Pulumi's gcp provider and its gs:// backend read GOOGLE_APPLICATION_CREDENTIALS, and
# without it the well-known file application_default_credentials.json, which holds whoever last
# ran an ADC login: on sami-rocqperf the user's own login since 2026-11-01T02:53Z, so an agent's
# library call ran as him. On a machine enrolled in the box identity, installers/gcloud-box.sh
# writes the keyless external_account configuration of its service account to
# box_credential_config.json, a file only that installer writes (gcloud rewrites its own copy under
# legacy_credentials/ whenever it stores credentials). A file a caller chose is kept, unless it is
# the well-known file, which names no identity of its own.
#
# A Google VM (sami-devbox, dispatch://INFRA-993) has no such file: gcloud-box.sh removes it and the
# well-known file, and ADC falls through to the metadata server, which is the VM's attached
# account. A box_credential_config.json there is one carried over from an Azure machine; it fetches
# its token from Azure's IMDS, which a Google VM does not have, so it is not exported. The probe
# runs only when that file exists, so a machine without one pays nothing for it.
gcloud_cfg="${CLOUDSDK_CONFIG:-$HOME/.config/gcloud}"
box_adc="$gcloud_cfg/box_credential_config.json"
if [[ -f "$box_adc" ]] && [[ -z "${GOOGLE_APPLICATION_CREDENTIALS:-}" \
    || "$(realpath -m "$GOOGLE_APPLICATION_CREDENTIALS")" == "$(realpath -m "$gcloud_cfg/application_default_credentials.json")" ]] \
    && ! "$DOTFILES_DIR/scripts/on-google-vm"; then
    export GOOGLE_APPLICATION_CREDENTIALS="$box_adc"
fi

# gcloud copies each command's output into a file under its configuration directory's logs/, so a
# token it prints lands on disk (dispatch://INFRA-4824). shims/gcloud turns that off for each call
# it runs and installers/gcloud-sdk.sh for ~/.gcloud's SDK, but a gcloud run by its path past both
# reads neither: a Google VM's snap /snap/bin/gcloud wrote one log file holding a made-up token on
# sami-devbox on 2026-11-20. gcloud reads this variable before any configuration file. A value the
# caller set is kept, as the shim keeps it. session_env in scripts/agentbox does the same in a box.
export CLOUDSDK_CORE_DISABLE_FILE_LOGGING="${CLOUDSDK_CORE_DISABLE_FILE_LOGGING:-true}"

# The codegraph CLI (pinned in mise.toml; omp's codegraph tool runs it) records each command it
# runs and sends the counts to telemetry.getcodegraph.com at its next init, index or sync, unless
# DO_NOT_TRACK or CODEGRAPH_TELEMETRY=0 is set or `codegraph telemetry off` was run as this user.
# On sami-devbox on 2026-11-21 its queue held 339 agent commands at 04:30Z, 90 minutes after its
# first run there (the queue file's mtime, and the updated_at of ~/.codegraph/telemetry.json).
# Legion's worker warm-up sets DO_NOT_TRACK; this is the narrower switch, so other tools keep their
# own settings. A value the caller set is kept. session_env in scripts/agentbox does the same in a box.
export CODEGRAPH_TELEMETRY="${CODEGRAPH_TELEMETRY:-0}"

# Machine-local environment, outside this public repository (dispatch://BET-765). A setting that
# names a customer may not be committed here, so each machine keeps its own file and this reads it
# if it exists. Sourced before the session starts, so every host session and every box gets it, and
# a value already in the environment still wins when the file uses the ${VAR:-default} form. Owned
# by this user and not group- or world-writable, or it is ignored: it runs as the session.
session_env="${XDG_CONFIG_HOME:-$HOME/.config}/agent-session/env"
if [[ -f "$session_env" && -O "$session_env" ]]; then
    if [[ -n "$(find "$session_env" -perm /022 -print -quit 2> /dev/null)" ]]; then
        printf 'agent-session: ignoring %s: group- or world-writable\n' "$session_env" >&2
    else
        # shellcheck source=/dev/null
        source "$session_env"
    fi
fi

# Scratch and language caches on the big disk, where this machine has one (dispatch://INFRA-613).
# Root holds every session's transcript, so a root that fills wedges the whole box, and on
# 2026-10-27 it filled in 5h41m - not from one writer, but from thousands of tool runs writing
# into root-resident scratch and caches (~/.cache/uv 4.4 GB, ~/.cargo 3.1 GB, ~/.cache/go-build,
# /tmp). .bashrc sets the same cache variables for interactive shells; a session's tool shell is
# not interactive, which is why they are set here, for the agent and everything it runs.
#
# A caller's value always wins, and a machine without the directory keeps the home defaults (a
# laptop). An agent box sets its own cache variables (session_env in scripts/agentbox), which win. It
# has the directory only as the root-owned parent of a path it was given under it, so this block runs
# there but every mkdir in it fails, and CARGO_HOME, TMPDIR and GOTMPDIR stay as the box had them.
#
# TMPDIR is per session and removed when the session ends: the directory is named for this
# shell's pid, which is the agent's own pid (every hop from here is an exec), and
# devbox/session-scratch-reap.service removes a directory no live process holds. A nested launch
# inherits the session's directory rather than making one that outlives it.
#
# On sami-devbox TMPDIR, GOTMPDIR, the session's TMPDIR and the Go build and uv caches go to the
# local-SSD scratch, /mnt/scratch/<user>, which devbox/gce-disks makes at every boot with the same
# layout (dispatch://INFRA-993, "Software"); a machine without it keeps them on /mnt/nvme.
# AGENT_SESSION_NVME_HOME replaces /mnt/nvme/<user> (the tests point it at a scratch tree).
nvme_home="${AGENT_SESSION_NVME_HOME:-/mnt/nvme/${USER:-$(id -un)}}"
scratch_home="$nvme_home"
if [[ -d "/mnt/scratch/${USER:-$(id -un)}" ]]; then
    scratch_home="/mnt/scratch/${USER:-$(id -un)}"
fi
if [[ -d "$nvme_home" ]]; then
    export UV_CACHE_DIR="${UV_CACHE_DIR:-$scratch_home/cache/uv}"
    # A venv on the state disk cannot hardlink from a cache on scratch; say copy, or uv warns at
    # every install that it fell back to it.
    if [[ "$UV_CACHE_DIR" == /mnt/scratch/* ]]; then
        export UV_LINK_MODE="${UV_LINK_MODE:-copy}"
    fi
    export GOCACHE="${GOCACHE:-$scratch_home/gocache}"
    export GOMODCACHE="${GOMODCACHE:-$nvme_home/gomodcache}"
    # Go writes its build tree to GOTMPDIR, and only falls back to TMPDIR when it is unset. The
    # session's own TMPDIR below already lands on the big disk, so this is what keeps a `go build`
    # off the root disk in a tool shell that sets a TMPDIR of its own (dispatch://INFRA-6). Each
    # session gets its own, set below once its scratch directory is known; this box-wide one is
    # the fallback when there is none.
    shared_gotmp="$scratch_home/gotmp"
    # cargo keeps its registry and git checkouts under CARGO_HOME and has no variable for those
    # alone, so the whole directory moves and bin/ links back to ~/.cargo/bin, which is on PATH
    # and holds rustup's shims and every `cargo install` binary. Its own default, $HOME/.cargo,
    # counts as unset: `mise env` exports exactly that value, so every session launched through
    # shims/omp arrives here with it already set and no session would ever move.
    if [[ "${CARGO_HOME:-$HOME/.cargo}" == "$HOME/.cargo" ]] && mkdir -p "$nvme_home/cargo" 2>/dev/null; then
        if [[ -d "$HOME/.cargo/bin" && ! -e "$nvme_home/cargo/bin" ]]; then
            ln -sfn "$HOME/.cargo/bin" "$nvme_home/cargo/bin" 2>/dev/null || true
        fi
        export CARGO_HOME="$nvme_home/cargo"
    fi
    if [[ -n "${AGENT_SESSION_SCRATCH:-}" && -d "${AGENT_SESSION_SCRATCH:-}" ]]; then
        export TMPDIR="$AGENT_SESSION_SCRATCH"
    elif mkdir -p -m 700 "$scratch_home/session-tmp" 2>/dev/null \
        && scratch="$(mktemp -d "$scratch_home/session-tmp/$$-XXXXXXXX" 2>/dev/null)"; then
        export AGENT_SESSION_SCRATCH="$scratch" TMPDIR="$scratch"
    fi
    # GOTMPDIR is the session's own <scratch>/gotmp, removed with the scratch directory by
    # devbox/session-scratch-reap. On 2026-11-03 at 16:20:04Z one session's cleanup,
    # `rm -rf /mnt/nvme/sami/gotmp/go-build*`, deleted the live build tree of another session's
    # `go test` in the box-wide directory, and that build failed on "vet.cfg: no such file or
    # directory". The box-wide value that .bashrc and the systemd manager (devbox/nvme-tmp.conf,
    # scratch-tmp.conf) give every shell counts as unset; any other value a caller set wins, so a
    # nested launch keeps its parent session's. GOCACHE stays shared: that is
    # where builds reuse each other's work.
    if [[ -z "${GOTMPDIR:-}" || "$GOTMPDIR" == "$shared_gotmp" || "$GOTMPDIR" == "$nvme_home/gotmp" ]]; then
        if [[ -n "${AGENT_SESSION_SCRATCH:-}" && -d "$AGENT_SESSION_SCRATCH" ]] && mkdir -p "$AGENT_SESSION_SCRATCH/gotmp" 2>/dev/null \
            && [[ -w "$AGENT_SESSION_SCRATCH/gotmp" ]]; then
            export GOTMPDIR="$AGENT_SESSION_SCRATCH/gotmp"
        elif mkdir -p "$shared_gotmp" 2>/dev/null && [[ -w "$shared_gotmp" ]]; then
            export GOTMPDIR="$shared_gotmp"
        fi
    fi
    unset shared_gotmp
fi

prog=""
if [[ "$agent" == */* ]]; then
    prog="$agent"
else
    mise_shims="${MISE_DATA_DIR:-$HOME/.mise}/shims"
    for dir in "${dirs[@]}"; do
        [[ "$dir" != "$mise_shims" && -f "$dir/$agent" && -x "$dir/$agent" ]] || continue
        real="$(realpath "$dir/$agent")"
        [[ "${real%/*}" == */shims ]] && continue
        prog="$dir/$agent"
        break
    done
    if [[ -z "$prog" ]]; then
        mise_bin="$(command -v mise)" || mise_bin="$DOTFILES_DIR/bin/mise"
        [[ "$mise_bin" = /* ]] || mise_bin="$PWD/$mise_bin"
        export MISE_DATA_DIR="${MISE_DATA_DIR:-$HOME/.mise}"
        [[ "$MISE_DATA_DIR" = /* ]] || MISE_DATA_DIR="$PWD/$MISE_DATA_DIR"
        mise_shims="$MISE_DATA_DIR/shims"
        # A directory it cannot make shows up below, as flock's failure to open the lock, and the
        # launch still asks mise for the agent rather than ending here under set -e.
        mkdir -p "$MISE_DATA_DIR" 2>/dev/null || true

        limit=600
        if [[ -n ${DOTFILES_TOOLS_TIMEOUT+x} ]]; then
            raw="$DOTFILES_TOOLS_TIMEOUT"
            if [[ "$raw" =~ ^0*([1-9][0-9]*)$ ]] \
                && value="${BASH_REMATCH[1]}" \
                && (( ${#value} <= 3 && 10#$value <= 600 )); then
                limit="$value"
            else
                printf 'agent-session: DOTFILES_TOOLS_TIMEOUT=%s is invalid; using 600\n' "$raw" >&2
            fi
        fi

        grace=10
        out_made=0
        out=""
        if out="$(mktemp 2>/dev/null)"; then
            out_made=1
        elif out="$(TMPDIR=/tmp mktemp 2>/dev/null)"; then
            out_made=1
        else
            printf 'agent-session: cannot make a temporary file in %s or /tmp; mise install output goes to stderr\n' "${TMPDIR:-<unset>}" >&2
        fi
        # A relative TMPDIR gives a relative name, which `mise which`'s stderr redirect, made after
        # the cd into the checkout, would read from the wrong directory.
        if (( out_made )); then
            [[ "$out" = /* ]] || out="$PWD/$out"
            exec {out_fd}>"$out"
        else
            exec {out_fd}>&2
        fi
        rc=0
        # The clock as EPOCHREALTIME gives it (whole seconds where bash has none). Its decimal point
        # follows the locale, so ran drops every non-digit and is in microseconds.
        started="${EPOCHREALTIME:-$(date +%s).000000}"
        (
            # In this subshell alone, so a knives call under the install does not wait on the lock
            # it holds, and the agent exec'd below never has the marker.
            export DOTFILES_INSTALL_LOCK_HELD=1
            # shellcheck disable=SC1007
            CDPATH= cd -- "$DOTFILES_DIR" && exec timeout -k "$grace" "$limit" flock "$MISE_DATA_DIR/.dotfiles-install.lock" "$mise_bin" install
        ) >&"$out_fd" 2>&1 &
        pid=$!
        wait "$pid" || rc=$?
        ended="${EPOCHREALTIME:-$(date +%s).000000}"
        ran=$(( ${ended//[!0-9]/} - ${started//[!0-9]/} ))
        if [[ "$rc" = 124 || "$rc" = 137 ]]; then
            waits=$((grace * 10))
            while (( waits > 0 )) && kill -0 -- "-$pid" 2>/dev/null; do
                sleep 0.1
                waits=$((waits - 1))
            done
            if kill -0 -- "-$pid" 2>/dev/null; then
                kill -KILL -- "-$pid" 2>/dev/null || true
                waits=20
                while (( waits > 0 )) && kill -0 -- "-$pid" 2>/dev/null; do
                    sleep 0.1
                    waits=$((waits - 1))
                done
            fi
        fi
        exec {out_fd}>&-
        # shellcheck disable=SC1007
        if (( out_made )); then
            found="$(CDPATH= cd -- "$DOTFILES_DIR" && "$mise_bin" which "$agent" 2>>"$out")" || found=""
        else
            found="$(CDPATH= cd -- "$DOTFILES_DIR" && "$mise_bin" which "$agent" 2>&2)" || found=""
        fi
        if [[ -n "$found" && -f "$found" && -x "$found" ]] && real="$(realpath "$found")"; then
            if [[ "${real%/*}" != */shims && "${real%/*}" != "$MISE_DATA_DIR/shims" ]]; then
                prog="$found"
            fi
        fi

        reported_output=""
        if (( rc != 0 )); then
            tick='`'
            printf 'agent-session: %smise install%s in %s exited %s' "$tick" "$tick" "$DOTFILES_DIR" "$rc" >&2
            # mise can exit 124 itself, and 137 can be any SIGKILL (the OOM killer's too), so the
            # note needs a run that lasted the limit.
            if [[ "$rc" = 124 || "$rc" = 137 ]] && (( ran >= limit * 1000000 )); then
                printf ' (past its limit of %s s, lock wait included)' "$limit" >&2
            fi
            if (( out_made )); then
                printf '\nlast lines of its output:\n' >&2
                tail -n 20 "$out" >&2 || true
            else
                printf '\nits output is above on stderr\n' >&2
            fi
            reported_output=1
        fi
        if [[ -z "$prog" ]]; then
            echo "agent-session: no $agent on PATH other than a wrapper (a shims/ dir, $mise_shims); a mise-managed agent needs its pinned version installed (mise install)" >&2
            if [[ -z "$reported_output" ]]; then
                if (( out_made )); then
                    printf 'last lines of its output:\n' >&2
                    tail -n 20 "$out" >&2 || true
                else
                    printf 'its output is above on stderr\n' >&2
                fi
            fi
            if (( out_made )); then
                rm -f "$out"
            fi
            exit 127
        fi
        if (( out_made )); then
            rm -f "$out"
        fi
    fi
fi

# The subagent progress probe (task.completionProbe) is on only in a session whose omp holds its
# fix (dispatch://INFRA-4027): omp/config.probe.yml, which sets it true, is named in the list only
# when the binary about to run is a release stamped 20261117-053702 or later. omp/config.yml keeps
# it false, because a running session watches every file its list names and reads the key at each
# subagent start, so true there turns the unfixed probe on in each session of an older release; an
# older session's list, fixed when it started, never names this file. The stamp is read from the
# version directory of the binary's real path (<installs>/<tool>/18.18.6-sami.YYYYMMDD-HHMMSS/bin/omp),
# since `omp --version` prints none. A version with no stamp (a local build, an upstream release),
# or in any other shape, gets no file, so a roll-back of the pin to an older release turns the
# probe off for new sessions with no second edit. The file goes right after omp/config.yml, so the
# machine's config.local.yml (a named profile's local file) and a caller's own overlays, which
# shims/omp puts after config.yml and which win over earlier entries, can still turn the probe off.
# A list that does not name omp/config.yml is left without it. An entry the list already carried (a
# launch from a session whose list names it) is dropped first, so an older release never gets it.
omp_probe_overlay() { # omp_probe_overlay PROG: PI_CONFIG_FILES, with the probe's file where PROG holds the fix
    local real version entry probe="$DOTFILES_DIR/omp/config.probe.yml" fixed=""
    local -a entries=() kept=()
    [[ -n "${PI_CONFIG_FILES:-}" ]] || return 0
    real="$(realpath -- "$1" 2>/dev/null)" || real=""
    version="${real%/bin/omp}"
    version="${version##*/}"
    if [[ "$real" == */bin/omp && "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+-sami\.([0-9]{8})-([0-9]{6})$ ]] \
        && (( 10#${BASH_REMATCH[1]}${BASH_REMATCH[2]} >= 20261117053702 )) && [[ -f "$probe" ]]; then
        fixed=1
    fi
    IFS=: read -ra entries <<<"$PI_CONFIG_FILES"
    for entry in "${entries[@]}"; do
        [[ "$entry" == */omp/config.probe.yml ]] && continue
        kept+=("$entry")
        [[ -n "$fixed" && "$entry" == "$DOTFILES_DIR/omp/config.yml" ]] && kept+=("$probe")
    done
    local IFS=:
    export PI_CONFIG_FILES="${kept[*]}"
}
if [[ "${agent##*/}" == omp ]]; then
    omp_probe_overlay "$prog"
fi

# Model spend (dispatch://INFRA-165): scripts/agent-spend-env.sh, shared with shims/claude and shims/codex, says
# what is exported and how the session's project is chosen.
# shellcheck source=SCRIPTDIR/agent-spend-env.sh
. "$DOTFILES_DIR/scripts/agent-spend-env.sh"
agent_spend_env "$prog" "$@"

exec "$DOTFILES_DIR/scripts/agent-secrets-session" "$prog" "$@"
