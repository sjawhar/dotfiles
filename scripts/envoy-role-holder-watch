}

# Where the state file goes. /mnt/nvme/sami/tmp is the agent devboxes' scratch on the big disk;
# an agent box without it keeps the state under ~/.local/state, which every XDG machine has.
# Measured 2026-10-30 on ossv-agent-open..open6, ossv-agent-git and ossv-agent-repo: /mnt/nvme
# there is a root-owned 755 directory on the root filesystem with no sami/tmp under it, so this
# watch crashed on its first run of every one of them with PermissionError. The test is
# writability, not existence: the path can be a directory this user still cannot write into, and
# `--state` cannot be the answer, since a non-default state file forces --dry-run and the watch
# would then be armed and permanently silent.
_NVME_STATE = Path("/mnt/nvme/sami/tmp/envoy-role-holder-watch/state.json")
DEFAULT_STATE = (
    _NVME_STATE
    if os.access("/mnt/nvme/sami/tmp", os.W_OK)
    else Path(os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local/state")))
    / "envoy-role-holder-watch/state.json"
)
DEFAULT_ENVOY_URL = "http://127.0.0.1:9020"
SESSION_ROOT = Path.home() / ".omp/agent/sessions"
# The procfs every process read goes through. A module constant so tests can point it at a tree.
PROC_ROOT = Path("/proc")
# The developer hosts that can run a moved holder when its Envoy registration has expired.
DEFAULT_CHECK_HOSTS = ("sami-devbox", "sami-rocqperf", "sami-leanperf")
REMOTE_SECONDS = 3.0


UUID_RE = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}")
TEAM_TOPIC = "notifications.team."
# A lane's stream lead holds one of these roles in the lane's working directory.
LEAD_ROLE_RE = re.compile(r"^(stream-)?lead-")
# Files a restarted session is briefed from. Matched on the basename of an absolute .md path the
# session's own transcript names, and on the well-known names in its lane directories.
HANDOVER_NAME_RE = re.compile(r"(?i)(wake|handover|hand-off|handoff|state|brief|dod)")
HANDOVER_WELL_KNOWN = ("WAKE.md", "HANDOVER.md", "HANDOFF.md", "STATE.md")

# The two things this watch may say about a holder, and they are not symmetric.
#
# CANNOT_SEE_HOLDER is the strongest verdict any check here reaches: every source answered "not
# found", and not-found is not death.
#
# HOLDER_DEAD would need positive proof that the session ended -- an exit record, a reaped pid
# with a status, anything the session wrote on its way out. omp writes none: the 2026-10-27T05:52Z
# loss this watch exists for left no error and no exit record. So nothing in this file constructs
# it, `guard_verdict` refuses to send a message carrying it, and it is here only so that every
# alert can name which of the two it established.
HOLDER_DEAD = "the holder is dead"
CANNOT_SEE_HOLDER = "I cannot see this session"

# A transcript written this recently is a live session writing it. 120 s covers a model call and
# a long tool run; past it the file says nothing either way, which is why it is one silent source
# among four and not a verdict.
DEFAULT_WRITE_GRACE = 120.0
# A role whose holder has been unseen this long is dropped from the state file. Bookkeeping, not
# a judgement: the incident has already alerted and escalated, and nothing here re-reads it.
FORGET_AFTER = 86400.0

# ---------------------------------------------------------- the holder's working directory
#
# The fifth source, and the only one that is not about the session at all. The four above ask
# "where is this holder"; this one asks "is anything still writing where it worked". That is a
# weaker question with a weaker answer, and it is here because on 2026-10-30 it was the only
# question anything could answer.
#
# At 22:21:26Z and 22:53:14Z that night roles node-envprobe-d10302216-2 and
# node-envprobe-d10302249-2 alerted, and all four sources above were CORRECTLY silent: no omp
# process named the holder, no transcript under ~/.omp/agent/sessions carried it,
# GET /v1/sessions omitted it and GET /v1/registry/<holder> answered 404. The Verified Linux
# scheduler's envprobe claims a role named node-<deployment>-<number> from a process that is not
# an omp agent -- Envoy's registry takes any registered session id string
# (store.Registry.SetRole, packages/envoy/internal/store/kv.go:602; registration is an HTTP
# call) -- and the lane writes its transcripts into the run directory, not the session root. So
# nothing those four sources read could ever see that holder and the alert could never clear: at
# 30 s a cycle it escalated until the lane ended, and every repeat taught a reader to skip the
# one real alert.
#
# What an mtime does and does not say -- the chief of staff's qualifier of 2026-10-30, which he
# proved on the first incident: ps.log in that run directory grew from 11,178 to 27,939 bytes
# between 22:22Z and 22:31:41Z while the probe's own outputs had stopped at 22:18:55Z. A
# heartbeat written by a watcher is not a heartbeat of the thing watched. So this source NEVER
# says the holder is alive and NEVER says the lane is working. It says that one named file was
# written at one absolute time, and a reader judges whether that file is the work or a log
# beside it. Every sentence it produces names the file.
DEFAULT_DIR_GRACE = 300.0
# The walk is bounded three ways, because a run has a 30 s period and a 90 s TimeoutStartSec:
# entries stat'ed, depth, and wall clock. A truncated walk is reported as truncated and is never
# used to quiet anything -- "I did not finish looking" is not "nothing was written here".
DIR_SCAN_ENTRIES = 20000
DIR_SCAN_DEPTH = 8
DIR_SCAN_SECONDS = 1.0
# A suppressed role is dropped from the state file this long after it was first suppressed.
# Nothing will ever be sent for it, so keeping it is pure bookkeeping, and the suppressed class
# claims a new role every few minutes -- up to a thousand in the stepped capacity test -- in a
# file this watch rewrites and fsyncs every 30 s.
SUPPRESSED_FORGET = 600.0

# ------------------------------------------------------------------- what one run may cost
#
# The whole run has a wall-clock budget, counted from the moment its process started, under the
# unit's 90 s TimeoutStartSec. Measured on sami-rocqperf in the six hours to 2026-11-03T02:36Z at
# load 240-290: 1.0-2.5 s of CPU per run, 6-86 s of wall clock (median 20.7 s, p95 62.6 s), and
# 35 of 545 runs killed at 90 s -- each a period in which nothing after the slow step ran at all.
# A run that reaches the budget stops between two units of work, writes the state file with
# everything it has done, says so in ONE journal line and exits 0, so systemd records no failure;
# the next period starts with the roles this one did not reach (`checked_at`).
DEFAULT_BUDGET = 60.0
# The header reads of transcripts this watch has not read before share this much of a run. One
# read took up to 5 s at load 268, and ~500 of them were 38 s of a 39 s process scan
# (2026-11-03 02:41Z); with the header cache (`load_header_cache`) only a transcript opened since
# the last run is read at all.
HEADER_READ_SECONDS = 10.0
# Every Envoy message is at most this long. The whole text goes to a report file the message
# names last (`write_report`), kept REPORT_KEEP: a pane alert was 2,404 characters, and its
# first 200 carried the decision anyway (dispatch://INFRA-672, review of 2026-11-03).
MESSAGE_LIMIT = 600
REPORT_KEEP = 7 * 86400.0

# ------------------------------------------------------------------ named class suppressions
#
# A suppression here is an exception with a name, a scope, a date and a reason, and the watch
# says it out loud in every alert of every other class while it holds. The alternative is not
# silence: it is every reader on this box learning that role-holder alerts are noise, which is a
# suppression with no name, no expiry, no scope and no record (chief of staff, 2026-10-30
# 22:59Z).
#
# WHEN IT EXPIRES NOTHING SILENTLY CHANGES BACK. Past `until` the class alerts again under the
# ordinary rules, and the watch logs and prints `EXPIRED` in the same places it printed the
# suppression, every run, until somebody deletes the entry. If the clearing rule below turns out
# to be enough on its own, deleting this tuple is the whole removal.
SUPPRESSIONS = (
    {
        "name": "verified-linux envprobe node roles",
        # Narrow on purpose: it matches the scheduler's own role shape and nothing else. The
        # roles live on this box at the same time (bet-owner-*, lead-*, stream-lead-*, node-*
        # claimed by hand) do not match, and a real role-holder alert for any of them still
        # fires tonight.
        "pattern": re.compile(r"^node-envprobe-[0-9a-z]+-[0-9]+$"),
        "shown": "^node-envprobe-[0-9a-z]+-[0-9]+$",
        "until": "2026-11-06T00:00:00Z",
        "why": (
            "envprobe claims this role from a process that is not an omp session and releases it"
