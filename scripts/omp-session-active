#!/usr/bin/env python3
"""omp-session-active: active-work seconds of omp sessions, total and since a line.

Active time sums every gap between two entries that is > 0 and <= --gap-minutes (default 30, the
dispatch://INFRA-26 measurement rule: "gaps over 30 minutes left out"), after sorting all of a
file's timestamps — file order is not time order: a forked session's line-2 `type: "session"`
header carries the fork time while its copied history keeps the original, earlier timestamps, and
an Envoy/IRC `custom_message` entry carries the sender's own clock. --since-line N credits a gap
to active_seconds_since when the later of its two timestamps belongs to a line past N, which is
how the skill librarian asks "how much work since the last interview?".

  omp-session-active [--gap-minutes 30] [--since-line N] SESSION.jsonl...

Prints one JSON object per file:
  {"file", "session_id", "lines", "start", "end", "active_seconds",
   "active_seconds_since", "mtime"}
session_id comes from the filename (…_<id>.jsonl). A line that is not JSON, or has no readable
timestamp, contributes to `lines` but is left out of the sort. Every top-level timestamp seen so
far is an ISO-8601 string; a numeric (epoch-millisecond) timestamp is also accepted in case one
appears. `start`/`end` are the minimum/maximum timestamp seen, not the first/last line.
"""
import argparse
import datetime as dt
import json
import sys
from pathlib import Path


def stamp(entry):
    v = entry.get("timestamp")
    if isinstance(v, (int, float)):
        return v / 1000.0
    if isinstance(v, str):
        try:
            return dt.datetime.fromisoformat(v.replace("Z", "+00:00")).timestamp()
        except ValueError:
            return None
    return None


def one(path: Path, gap_s: float, since_line: int) -> dict:
    lines = 0
    entries = []  # (timestamp, line number), sorted below by timestamp
    with path.open("rb") as fh:
        for n, raw in enumerate(fh, 1):
            lines = n
            try:
                t = stamp(json.loads(raw))
            except ValueError:
                continue
            if t is None:
                continue
            entries.append((t, n))
    entries.sort(key=lambda e: e[0])
    active = active_since = 0.0
    for (t0, _n0), (t1, n1) in zip(entries, entries[1:]):
        gap = t1 - t0
        if 0 < gap <= gap_s:
            active += gap
            if n1 > since_line:
                active_since += gap
    first = entries[0][0] if entries else None
    last = entries[-1][0] if entries else None
    iso = lambda x: dt.datetime.fromtimestamp(x, dt.timezone.utc).isoformat() if x else None
    return {
        "file": str(path),
        "session_id": path.stem.rsplit("_", 1)[-1],
        "lines": lines,
        "start": iso(first),
        "end": iso(last),
        "active_seconds": round(active),
        "active_seconds_since": round(active_since),
        "mtime": round(path.stat().st_mtime),
    }


def main() -> None:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("sessions", nargs="+", type=Path)
    ap.add_argument("--gap-minutes", type=float, default=30.0)
    ap.add_argument("--since-line", type=int, default=0)
    args = ap.parse_args()
    for path in args.sessions:
        if not path.is_file():
            print(f"omp-session-active: {path} is not a file", file=sys.stderr)
            sys.exit(1)
        print(json.dumps(one(path, args.gap_minutes * 60, args.since_line)))


if __name__ == "__main__":
    main()
