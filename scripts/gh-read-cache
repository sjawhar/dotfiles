#!/usr/bin/python3
"""Host-wide read cache in front of GitHub, for the gh calls agent sessions make.

Every agent session on this machine calls GitHub through one GitHub App
installation, so they share one primary rate limit. On 2026-11-01 that limit
reached zero four times and every session that reads GitHub stopped
(dispatch://BET-303). Many of those reads are the same read: several sessions
and several polling loops asking one pull request for its checks every 30-120 s.

This script is what `shims/gh` hands every call to. It does three things, the
first two of which GitHub documents as free or cheap:

  * an identical-read reuse window of 60 s (120 s for the polling shapes
    `gh pr view/checks/list --json`): the same argv, from any session,
    answered from the stored output of the first call, with no request at all;
  * conditional requests for the plain `gh api` GET class: the stored ETag goes
    out as `If-None-Match`, and a `304 Not Modified` does not count against the
    primary rate limit for an authenticated request. Measured here on
    2026-11-01: three conditional reads of
    `repos/theorem-labs/<task repo>` left `X-RateLimit-Used` at
    549, three unconditional ones took it to 550, 551, 552.
  * a write clears what it makes stale: when a write goes through (a `gh pr` or
    `gh issue` verb that is not a read, `gh run rerun`, a `gh api` call with a
    method other than GET or with fields, a GraphQL mutation), every stored
    read of the same pull request or issue, every repository-wide read of that
    repository (`pr list`, `run list`, a branch-named `pr view`) and every
    cross-repository read (`search`, GraphQL) stops being served. A write this
    cannot place in one pull request clears the whole repository; one it cannot
    place in a repository clears everything. On 2026-11-02 three sessions in
    twelve hours read their old pull-request body back after a successful
    `gh pr edit` and edited again or went around the cache.

Nothing that writes is cached: the classifier is an allow-list of read verbs
and, for `gh api`, a GET-only rule. A merge, a rerun, a dequeue, a review, a
comment, anything carrying a request body and anything the allow-list does not
name is run as written and never stored.

Failure is always a pass-through: an unreadable cache, a corrupt entry, an
unexpected gh output shape or any exception at all ends in running the command
the way the caller wrote it. A stored answer is served only inside its reuse
window and only when no write to what it reads finished after its request
went out, or after GitHub itself answered 304.

Usage (from the shim; not a user-facing command):
    gh-read-cache -- <gh args...>
Environment:
    GH_READ_CACHE=0             turn the cache off (the call is still logged)
    GH_READ_CACHE_DIR=<dir>     where entries and the request log live
    GH_READ_CACHE_WINDOW=<secs> reuse window, default 60
    GH_READ_CACHE_GH=<path>     the gh to run on a miss (the shim passes its own)
    GH_READ_CACHE_BYPASS=1      set on the child, so a miss cannot re-enter
    GH_READ_CACHE_PARENT=<pid>  the pid the shim saw as its parent when it exec'd
                                this; another parent now means it already died
"""

from __future__ import annotations

import hashlib
import json
import signal
import os
import fcntl
import random
import re
import shutil
import subprocess
import sys
import time

WINDOW_DEFAULT = 60.0
# The polling shapes. The gate loops on this host read a pull request every 30 s
# or every 120 s, so a 60 s window catches the fast loop and misses the slow one
# by construction: measured over 21:36-22:21Z on 2026-11-01, 11.7% of calls were
# an identical read inside 60 s and 19.9% inside 120 s. 120 s is still inside the
# slower loop's own interval, so no loop sees an answer older than one of its own
# cycles.
WINDOW_POLLING = 120.0
POLLING_COMMANDS = {("pr", "view"), ("pr", "checks"), ("pr", "list")}
# How long the second of two overlapping identical reads waits for the first.
SINGLE_FLIGHT_WAIT = 30.0
MAX_BODY_BYTES = 8 * 1024 * 1024
CACHE_MAX_BYTES = 256 * 1024 * 1024
ENTRY_MAX_AGE = 6 * 3600
LOG_MAX_AGE = 48 * 3600

# Read verbs. A command whose first two words are not here is never cached.
READ_COMMANDS = {
    ("cache", "list"),
    ("issue", "list"),
    ("issue", "status"),
    ("issue", "view"),
    ("label", "list"),
    ("pr", "checks"),
    ("pr", "diff"),
    ("pr", "list"),
    ("pr", "status"),
    ("pr", "view"),
    ("release", "list"),
    ("release", "view"),
    ("repo", "view"),
    ("run", "list"),
    ("run", "view"),
    ("search", "code"),
    ("search", "commits"),
    ("search", "issues"),
    ("search", "prs"),
    ("search", "repos"),
    ("variable", "list"),
    ("workflow", "list"),
    ("workflow", "view"),
}

# Flags that make a read either not a read, not reproducible, or not one
# response: a watch streams, a web call opens a browser, a log is huge.
DENY_FLAGS = {"-w", "--watch", "--web", "--log", "--log-failed", "--input"}

# gh flags that take a separate value, so the word after them is not a verb.
VALUE_FLAGS = {
    "-X", "--method", "-f", "--raw-field", "-F", "--field", "-H", "--header",
    "-q", "--jq", "-t", "--template", "--cache", "--hostname", "--input",
    "-p", "--preview", "-R", "--repo", "--json", "--limit", "-L", "--state",
    "--author", "--label", "--branch", "--base", "--head", "--search",
    "--assignee", "--app", "--user", "--workflow", "--status", "--event",
    "--commit", "--created", "--owner", "--sort", "--order", "--color",
}

# `gh api` flags that carry a request body, so the call is not a GET.
API_BODY_FLAGS = {"-f", "-F", "--field", "--raw-field", "--input"}

# `gh api` flags whose output is not one header block followed by one body, so
# the ETag path (which appends --include) cannot reconstruct the plain output.
API_NO_ETAG_FLAGS = {
    "-i", "--include", "--paginate", "--slurp", "--silent", "--verbose",
    "-t", "--template",
}

# Endpoints whose whole point is the live number; caching one would hide the
# thing it reports.
NEVER_CACHE_ENDPOINTS = {"rate_limit", "/rate_limit"}

CLASS_NONE = "none"
CLASS_WINDOW = "window"
CLASS_ETAG = "etag"


def cache_root() -> str:
    env = os.environ.get("GH_READ_CACHE_DIR")
    if env:
        return env
    user = os.environ.get("USER") or ""
    if not user:
        try:
            import pwd

            user = pwd.getpwuid(os.geteuid()).pw_name
        except Exception:
            user = ""
    # This host keeps bulky, regenerable data off the root disk; a machine
    # without that disk uses the ordinary cache home. No absolute machine path
    # is committed either way.
    if user and os.path.isdir(os.path.join("/mnt/nvme", user)):
        return os.path.join("/mnt/nvme", user, "gh-read-cache")
    base = os.environ.get("XDG_CACHE_HOME") or os.path.join(
        os.path.expanduser("~"), ".cache"
    )
    return os.path.join(base, "gh-read-cache")


def make_private(path: str) -> None:
    """mkdir -p, with every directory this creates private to the owner."""
    os.makedirs(path, mode=0o700, exist_ok=True)
    # os.makedirs applies its mode to the leaf alone, and a directory it
    # created on the way inherits the umask, so a cache under a fresh root
    # would be world-readable.
    part = path
    while part and part != os.sep:
        try:
            if os.stat(part).st_uid == os.geteuid():
                os.chmod(part, 0o700)
        except OSError:
            pass
        if os.path.basename(part) not in ("log", "v1") and not os.path.basename(
            part
        ).startswith("gh-read-cache"):
            break
        part = os.path.dirname(part)


def log_event(root: str, record: dict) -> None:
    if os.environ.get("GH_READ_CACHE_LOG") == "0":
        return
    try:
        logdir = os.path.join(root, "log")
        make_private(logdir)
        path = os.path.join(logdir, time.strftime("%Y%m%d%H", time.gmtime()) + ".jsonl")
        line = json.dumps(record, separators=(",", ":"), default=str) + "\n"
        with open(path, "a", encoding="utf-8") as fh:
            fh.write(line)
    except Exception:
        pass


def flag_value(args: list[str], flags: tuple[str, ...]) -> str | None:
    """Value of the first of `flags` present, as `-f v`, `--flag=v` or `-Rv`."""
    i = 0
    while i < len(args):
        a = args[i]
        for flag in flags:
            if a == flag:
                return args[i + 1] if i + 1 < len(args) else None
            if a.startswith(flag + "="):
                return a[len(flag) + 1 :]
            if len(flag) == 2 and len(a) > 2 and a.startswith(flag):
                return a[2:]
        if a in VALUE_FLAGS:
            i += 1
        i += 1
    return None


def all_flag_values(args: list[str], flags: tuple[str, ...]) -> list[str]:
    out: list[str] = []
    i = 0
    while i < len(args):
        a = args[i]
        matched = False
        for flag in flags:
            if a == flag:
                if i + 1 < len(args):
                    out.append(args[i + 1])
                i += 1
                matched = True
                break
            if a.startswith(flag + "="):
                out.append(a[len(flag) + 1 :])
                matched = True
                break
            if len(flag) == 2 and len(a) > 2 and a.startswith(flag):
                out.append(a[2:])
                matched = True
                break
        if not matched and a in VALUE_FLAGS:
            i += 1
        i += 1
    return out


def positionals(args: list[str], value_flags: set[str] = VALUE_FLAGS) -> list[str]:
    """Words that are not flags and not the value of a flag."""
    out: list[str] = []
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--":
            out.extend(args[i + 1 :])
            break
        if a.startswith("-") and a != "-":
            if a in value_flags:
                i += 1
            i += 1
            continue
        out.append(a)
        i += 1
    return out


def graphql_is_read(args: list[str]) -> bool:
    """A GraphQL call is a read only when its query text says so.

    GraphQL has no ETags and every call is a POST, so the only safe rule is the
    text itself: an anonymous `{...}` or an explicit `query`, with no mutation
    anywhere in it, and nothing read from a file (which this process would have
    to read to know what it says).
    """
    query = None
    for field in all_flag_values(args, ("-f", "--raw-field", "-F", "--field")):
        name, sep, value = field.partition("=")
        if sep and name == "query":
            query = value
    if query is None or query.startswith("@"):
        return False
    text = query.strip()
    if "mutation" in text.lower():
        return False
    return text.startswith("{") or text.startswith("query")


def classify(args: list[str]) -> str:
    """CLASS_NONE, CLASS_WINDOW or CLASS_ETAG for this gh argv."""
    if not args or args[0].startswith("-"):
        return CLASS_NONE
    for a in args:
        if a.split("=", 1)[0] in DENY_FLAGS:
            return CLASS_NONE

    words = positionals(args)
    if words[0] != "api":
        if tuple(words[:2]) not in READ_COMMANDS:
            return CLASS_NONE
        return CLASS_WINDOW

    endpoint = words[1] if len(words) > 1 else ""
    if endpoint.strip("/") in NEVER_CACHE_ENDPOINTS:
        return CLASS_NONE
    method = (flag_value(args, ("-X", "--method")) or "").upper()
    if endpoint == "graphql":
        if not graphql_is_read(args):
            return CLASS_NONE
        if method and method != "POST":
            return CLASS_NONE
        return CLASS_WINDOW
    if method and method != "GET":
        return CLASS_NONE
    for a in args:
        if a.split("=", 1)[0] in API_BODY_FLAGS:
            return CLASS_NONE
    for a in args:
        if a.split("=", 1)[0] in API_NO_ETAG_FLAGS:
            return CLASS_WINDOW
    return CLASS_ETAG


def window_for(args: list[str]) -> float:
    """The reuse window for this call. An explicit setting wins outright."""
    env = os.environ.get("GH_READ_CACHE_WINDOW")
    if env is not None:
        try:
            return float(env)
        except ValueError:
            return WINDOW_DEFAULT
    words = positionals(args)
    if tuple(words[:2]) in POLLING_COMMANDS and any(
        a == "--json" or a.startswith("--json=") for a in args
    ):
        return WINDOW_POLLING
    return WINDOW_DEFAULT


def repo_context(args: list[str]) -> str:
    """What repository this call is about, so two worktrees of one repo share.

    A `-R owner/repo` or GH_REPO says it outright. Without one, gh resolves the
    repository from the working directory, so the origin remote stands in for
    it; a directory that is not a checkout falls back to its own path, which
    only narrows the key.
    """
    explicit = flag_value(args, ("-R", "--repo"))
    if explicit:
        return "repo:" + explicit
    env = os.environ.get("GH_REPO")
    if env:
        return "repo:" + env
    try:
        out = subprocess.run(
            ["git", "remote", "get-url", "origin"],
            capture_output=True,
            text=True,
            timeout=5,
        )
        if out.returncode == 0 and out.stdout.strip():
            return "remote:" + out.stdout.strip()
    except Exception:
        pass
    return "cwd:" + os.getcwd()


def routed_owner(context: str) -> str:
    """The owner the shim routes to, which decides WHICH App installation and
    therefore which token answers. Two owners are two identities even when the
    rest of the call is identical, so the key separates them outright rather
    than relying on the repository string to differ."""
    tail = context.split(":", 1)[1] if ":" in context else context
    tail = tail.rstrip("/")
    if tail.endswith(".git"):
        tail = tail[:-4]
    if "github.com" in tail:
        tail = tail.split("github.com", 1)[1].lstrip(":/")
    parts = [p for p in tail.split("/") if p]
    return parts[0] if parts else ""


def cache_key(args: list[str], context: str) -> str:
    h = hashlib.sha256()
    parts = [
        "v1",
        context,
        "owner:" + routed_owner(context),
        os.environ.get("GH_HOST", ""),
        # An inherited token makes the call act as someone else; never let one
        # identity read another identity's cached answer.
        hashlib.sha256(
            (os.environ.get("GH_TOKEN") or os.environ.get("GITHUB_TOKEN") or "").encode()
        ).hexdigest(),
        # gh formats for a terminal differently from a pipe.
        "tty" if sys.stdout.isatty() else "pipe",
    ]
    parts.extend(args)
    for p in parts:
        h.update(b"\x1f")
        h.update(p.encode("utf-8", "surrogateescape"))
    return h.hexdigest()


# -- what a write makes stale -----------------------------------------------
#
# A read's key is a hash, so a write cannot find the entries it touches by
# name. Instead each write records the time it finished in a marker file per
# scope, and a stored read is served only when its request went out after every
# marker that covers it. A scope is (repository, number) for one pull request
# or issue, (repository, None) for the rest of a repository, and (None, None)
# for a read or write that names no single repository.

# Value flags of the pr/issue verbs, so a body or a title is never read as a
# number. A flag missing here leaves an extra word, and more than one word makes
# the scope the whole repository, never a wrong number.
SCOPE_VALUE_FLAGS = VALUE_FLAGS | {
    "-a", "-b", "-B", "-c", "-e", "-H", "-l", "-m", "-r",
    "--add-assignee", "--add-label", "--add-project", "--add-reviewer",
    "--author-email", "--body", "--body-file", "--comment", "--match-head-commit",
    "--milestone", "--reason", "--remove-assignee", "--remove-label",
    "--remove-milestone", "--remove-project", "--remove-reviewer", "--subject",
    "--title",
}

# Groups whose non-read verbs change something a cached read reports.
WRITE_GROUPS = {
    "pr", "issue", "run", "workflow", "release", "label", "repo", "variable",
    "cache",
}
# Verbs in those groups that change nothing on GitHub.
NOT_WRITES = {
    ("pr", "checkout"), ("repo", "clone"), ("run", "watch"), ("run", "download"),
    ("release", "download"),
}

PR_URL = re.compile(r"^https?://[^/]+/([^/]+)/([^/]+)/(?:pull|issues)/(\d+)")


def normalize_repo(context: str) -> str:
    """`o/r` for a `-R`, GH_REPO or remote context; a cwd context as it is."""
    kind, _, tail = context.partition(":")
    if kind == "cwd":
        return context
    tail = tail.strip().rstrip("/")
    if tail.endswith(".git"):
        tail = tail[:-4]
    parts = [p for p in re.split(r"[/:]", tail) if p]
    if len(parts) < 2:
        return context
    return (parts[-2] + "/" + parts[-1]).lower()


def api_scope(words: list[str], context: str) -> tuple[str | None, str | None]:
    endpoint = words[1] if len(words) > 1 else ""
    endpoint = re.sub(r"^https?://[^/]+/", "", endpoint).split("?", 1)[0].strip("/")
    parts = endpoint.split("/")
    if len(parts) < 3 or parts[0] != "repos":
        return None, None
    if "{" in parts[1] or "{" in parts[2]:
        # gh fills {owner}/{repo} from the same place repo_context reads.
        repo = normalize_repo(context)
    else:
        repo = (parts[1] + "/" + parts[2]).lower()
    if len(parts) >= 5 and parts[3] in ("pulls", "issues") and parts[4].isdigit():
        return repo, parts[4]
    return repo, None


def scope_of(args: list[str], context: str) -> tuple[str | None, str | None]:
    """The repository and pull-request or issue number this call is about."""
    words = positionals(args, SCOPE_VALUE_FLAGS)
    if not words or words[0] == "search":
        return None, None
    if words[0] == "api":
        return api_scope(words, context)
    repo = normalize_repo(context)
    if words[0] in ("pr", "issue") and len(words) == 3:
        target = words[2]
        m = PR_URL.match(target)
        if m:
            return (m.group(1) + "/" + m.group(2)).lower(), m.group(3)
        if target.lstrip("#").isdigit():
            return repo, target.lstrip("#")
    return repo, None


def is_write(args: list[str]) -> bool:
    words = positionals(args)
    if not words:
        return False
    if words[0] == "api":
        endpoint = words[1] if len(words) > 1 else ""
        if endpoint == "graphql":
            return not graphql_is_read(args)
        method = (flag_value(args, ("-X", "--method")) or "").upper()
        if method:
            return method not in ("GET", "HEAD")
        return any(a.split("=", 1)[0] in API_BODY_FLAGS for a in args)
    pair = tuple(words[:2])
    return (
        words[0] in WRITE_GROUPS
        and len(words) >= 2
        and pair not in READ_COMMANDS
        and pair not in NOT_WRITES
    )


def marker_dir(root: str, repo: str | None) -> str:
    base = os.path.join(root, "v1", "inv")
    if repo is None:
        return base
    return os.path.join(base, "r-" + hashlib.sha256(repo.encode()).hexdigest()[:24])


def markers_covering(root: str, scope: tuple[str | None, str | None]) -> list[str]:
    """The markers a write sets that make a read with this scope stale."""
    repo, num = scope
    out = [os.path.join(marker_dir(root, None), "all")]
    if repo is None:
        out.append(os.path.join(marker_dir(root, None), "cross"))
        return out
    d = marker_dir(root, repo)
    out.append(os.path.join(d, "repo"))
    out.append(os.path.join(d, "n" + num) if num else os.path.join(d, "wide"))
    return out


def markers_set_by(root: str, scope: tuple[str | None, str | None]) -> list[str]:
    """The markers a write with this scope sets."""
    repo, num = scope
    if repo is None:
        return [os.path.join(marker_dir(root, None), "all")]
    d = marker_dir(root, repo)
    cross = os.path.join(marker_dir(root, None), "cross")
    if num is None:
        return [os.path.join(d, "repo"), cross]
    return [os.path.join(d, "n" + num), os.path.join(d, "wide"), cross]


def read_marker(path: str) -> float:
    try:
        with open(path, "r", encoding="utf-8") as fh:
            return float(fh.read().strip() or 0)
    except (OSError, ValueError):
        return 0.0


def invalidated(root: str, scope, meta: dict) -> bool:
    """True when a write covering this read finished after its request left."""
    asked = float(meta.get("req", meta.get("t", 0)))
    return any(read_marker(p) >= asked for p in markers_covering(root, scope))


def invalidate(root: str, scope) -> None:
    now = repr(time.time())
    for path in markers_set_by(root, scope):
        try:
            make_private(os.path.dirname(path))
            tmp = path + ".%d.tmp" % os.getpid()
            with open(tmp, "w", encoding="utf-8") as fh:
                fh.write(now)
            os.replace(tmp, path)
        except Exception:
            pass


def run_write(argv: list[str], root: str, context: str, record: dict) -> None:
    """Run a write as written, then mark what it made stale.

    The marks go down whatever the exit code: a write that fails can still have
    reached GitHub (a timeout after the server applied it), and a needless mark
    costs one real read."""
    env = dict(os.environ)
    env["GH_READ_CACHE_BYPASS"] = "1"
    group = child_group()
    try:
        proc = subprocess.Popen(child_command(argv), env=env, **group)
    except OSError:
        exec_passthrough(argv)
        return
    CHILDREN.append(proc)
    # This process must outlive the child to set the marks, so a TERM or HUP
    # aimed at it (its parent's death sends a TERM) is passed on to the child's
    # group instead of ending it. A terminal's ^C reaches a child that shares the
    # terminal's group by itself; a child in a group of its own gets it from here.
    signal.signal(signal.SIGINT, (lambda s, _f: signal_children(s)) if group else signal.SIG_IGN)
    for sig in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, lambda s, _f: signal_children(s))
    while True:
        try:
            code = proc.wait()
            break
        except InterruptedError:
            continue
    try:
        scope = scope_of(argv, context)
    except Exception:
        scope = (None, None)
    invalidate(root, scope)
    log_event(root, dict(record, ev="write", code=code, scope=list(scope)))
    debug("write", "exit %d, cleared %s" % (code, scope))
    sys.exit(code if code >= 0 else 128 - code)


def entry_paths(root: str, key: str) -> tuple[str, str]:
    d = os.path.join(root, "v1", key[:2])
    return os.path.join(d, key + ".meta"), os.path.join(d, key + ".out")


def load_meta(meta_path: str) -> dict | None:
    try:
        with open(meta_path, "r", encoding="utf-8") as fh:
            meta = json.load(fh)
        if isinstance(meta, dict):
            return meta
    except Exception:
        pass
    return None


# GitHub computes a pull request's mergeability lazily and answers UNKNOWN
# (REST: a null `mergeable`) while it does, and the answer to that is to read
# again -- which is exactly what a cache would stop. A body that says so is
# never stored, so the next read is a real read.
UNCOMPUTED = re.compile(
    rb'"(mergeStateStatus"\s*:\s*"UNKNOWN"|mergeable"\s*:\s*null)'
)


def store(
    root: str,
    key: str,
    body: bytes,
    etag: str | None,
    code: int = 0,
    err: bytes = b"",
    req: float | None = None,
) -> None:
    if len(body) + len(err) > MAX_BODY_BYTES:
        return
    if UNCOMPUTED.search(body):
        return
    meta_path, out_path = entry_paths(root, key)
    try:
        make_private(os.path.dirname(meta_path))
        tmp_out = out_path + ".%d.tmp" % os.getpid()
        with open(tmp_out, "wb") as fh:
            fh.write(body)
        os.replace(tmp_out, out_path)
        meta = {
            "t": time.time(),
            # When the request left: a write that finished after it makes
            # this answer stale (invalidated()).
            "req": req if req is not None else time.time(),
            "etag": etag,
            "bytes": len(body),
            "code": code,
            "err": err.decode("utf-8", "replace")[:4096] if err else "",
        }
        tmp_meta = meta_path + ".%d.tmp" % os.getpid()
        with open(tmp_meta, "w", encoding="utf-8") as fh:
            json.dump(meta, fh)
        os.replace(tmp_meta, meta_path)
    except Exception:
        pass


def prune(root: str) -> None:
    """Keep the cache bounded. Cheap, and only on a small share of writes."""
    try:
        now = time.time()
        files = []
        total = 0
        base = os.path.join(root, "v1")
        for dirpath, _dirnames, filenames in os.walk(base):
            for name in filenames:
                p = os.path.join(dirpath, name)
                try:
                    st = os.stat(p)
                except OSError:
                    continue
                if now - st.st_mtime > ENTRY_MAX_AGE or name.endswith(".tmp"):
                    try:
                        os.unlink(p)
                    except OSError:
                        pass
                    continue
                files.append((st.st_mtime, st.st_size, p))
                total += st.st_size
        if total > CACHE_MAX_BYTES:
            files.sort()
            for _mtime, size, p in files:
                if total <= CACHE_MAX_BYTES:
                    break
                try:
                    os.unlink(p)
                    total -= size
                except OSError:
                    pass
        logdir = os.path.join(root, "log")
        if os.path.isdir(logdir):
            for name in os.listdir(logdir):
                p = os.path.join(logdir, name)
                try:
                    if now - os.stat(p).st_mtime > LOG_MAX_AGE:
                        os.unlink(p)
                except OSError:
                    pass
    except Exception:
        pass


def take_lock(path: str, deadline: float):
    """Hold the right to make this request. The second of two overlapping
    identical reads waits here instead of asking GitHub the same question.

    Returns the open file while this process holds the lock, or None. A holder
    that dies releases it: the kernel drops the flock when the file closes. A
    cache that cannot be written at all returns None at once, and then both
    callers simply make their own request, which is the old behaviour."""
    try:
        make_private(os.path.dirname(path))
        fh = open(path, "a+")
    except OSError:
        return None
    while True:
        try:
            fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return fh
        except OSError:
            pass
        if time.time() >= deadline:
            try:
                fh.close()
            except OSError:
                pass
            return None
        time.sleep(0.05)


def read_body(out_path: str) -> bytes | None:
    try:
        with open(out_path, "rb") as fh:
            return fh.read()
    except OSError:
        return None


def child_command(args: list[str]) -> list[str]:
    gh = os.environ.get("GH_READ_CACHE_GH") or shutil.which("gh") or "gh"
    return [gh] + args


# The shim execs this process, so its parent is the outer shim or the shim's own
# caller. When `timeout` or a session killed that parent, nothing told this
# process: it went on with its gh child under it, a GraphQL read 2.5 min after
# its shim had died, as a child of pid 1 (2026-11-03). So it ends when its parent
# does (die_with_parent), and each gh child runs in a process group of its own,
# which a TERM, HUP or INT to this process ends as a whole: the shim, knives, gh
# and the leak check under it.
CHILDREN: list[subprocess.Popen] = []


def child_group() -> dict:
    """Popen arguments that put a child in a group of its own. Not when stdin is a
    terminal: a background group's read from it stops the child (SIGTTIN)."""
    try:
        if os.isatty(0):
            return {}
    except OSError:
        pass
    return {"process_group": 0}


def signal_children(signum: int) -> None:
    for proc in CHILDREN:
        if proc.poll() is not None:
            continue
        try:
            if os.getpgid(proc.pid) == proc.pid:
                os.killpg(proc.pid, signum)
            else:
                proc.send_signal(signum)
        except OSError:
            pass


def end_on_signal(signum: int, _frame) -> None:
    signal_children(signum)
    os._exit(128 + signum)


def die_with_parent() -> None:
    """A TERM, HUP or INT ends this process and its children's groups, and the
    kernel sends the TERM when the parent dies (PR_SET_PDEATHSIG, which an exec
    into the shim keeps). A parent that died before the request was armed shows
    as a parent other than the one the shim named."""
    for sig in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):
        signal.signal(sig, end_on_signal)
    try:
        import ctypes

        ctypes.CDLL(None, use_errno=True).prctl(1, signal.SIGTERM, 0, 0, 0)  # PR_SET_PDEATHSIG
    except (OSError, AttributeError):
        pass
    parent = os.environ.get("GH_READ_CACHE_PARENT", "")
    if parent.isdigit() and os.getppid() != int(parent):
        os._exit(128 + signal.SIGTERM)


def run_child(args: list[str]) -> tuple[int, bytes, bytes]:
    env = dict(os.environ)
    env["GH_READ_CACHE_BYPASS"] = "1"
    with subprocess.Popen(
        child_command(args), stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=env, **child_group()
    ) as proc:
        CHILDREN.append(proc)
        out, err = proc.communicate()
    return proc.returncode, out or b"", err or b""


def exec_passthrough(args: list[str]) -> None:
    env = dict(os.environ)
    env["GH_READ_CACHE_BYPASS"] = "1"
    cmd = child_command(args)
    try:
        os.execvpe(cmd[0], cmd, env)
    except OSError:
        proc = subprocess.run(cmd, env=env)
        sys.exit(proc.returncode)


def split_response(out: bytes) -> tuple[int | None, dict[str, str], bytes]:
    """`gh api --include` writes a status line, headers, a blank line, a body."""
    sep = out.find(b"\r\n\r\n")
    if sep < 0:
        return None, {}, out
    head = out[:sep].decode("utf-8", "replace")
    body = out[sep + 4 :]
    lines = head.split("\r\n")
    status = None
    if lines and lines[0].startswith("HTTP/"):
        bits = lines[0].split()
        if len(bits) > 1 and bits[1].isdigit():
            status = int(bits[1])
    headers = {}
    for line in lines[1:]:
        name, sep2, value = line.partition(":")
        if sep2:
            headers[name.strip().lower()] = value.strip()
    return status, headers, body


def debug(event: str, detail: str = "") -> None:
    if os.environ.get("GH_READ_CACHE_DEBUG") != "1":
        return
    try:
        sys.stderr.write(
            "gh-read-cache: %s%s\n" % (event, (" " + detail) if detail else "")
        )
        sys.stderr.flush()
    except Exception:
        pass


def emit(body: bytes, code: int, err: bytes = b"") -> None:
    try:
        if err:
            sys.stderr.buffer.write(err)
            sys.stderr.buffer.flush()
        sys.stdout.buffer.write(body)
        sys.stdout.buffer.flush()
    except BrokenPipeError:
        os._exit(code)
    sys.exit(code)


def main() -> None:
    argv = sys.argv[1:]
    if argv and argv[0] == "--":
        argv = argv[1:]
    if not argv:
        sys.exit(2)
    die_with_parent()

    root = cache_root()
    base_record = {
        "t": round(time.time(), 3),
        "pid": os.getppid(),
        "sid": os.environ.get("OMP_SESSION_ID", ""),
        "argv": argv[:40],
    }

    if os.environ.get("GH_READ_CACHE") == "0" or os.environ.get("GH_READ_CACHE_BYPASS"):
        log_event(root, dict(base_record, ev="off"))
        exec_passthrough(argv)
        return

    try:
        kind = classify(argv)
    except Exception:
        kind = CLASS_NONE
    if kind == CLASS_NONE:
        try:
            write = is_write(argv)
        except Exception:
            write = False
        if write:
            try:
                context = repo_context(argv)
            except Exception:
                context = "cwd:" + os.getcwd()
            run_write(argv, root, context, base_record)
            return
        log_event(root, dict(base_record, ev="uncached"))
        debug("uncached", "not a read this cache knows")
        exec_passthrough(argv)
        return

    window = window_for(argv)

    try:
        context = repo_context(argv)
        key = cache_key(argv, context)
        scope = scope_of(argv, context)
    except Exception:
        log_event(root, dict(base_record, ev="uncached"))
        exec_passthrough(argv)
        return
    base_record["key"] = key[:16]
    base_record["class"] = kind
    meta_path, out_path = entry_paths(root, key)
    meta = load_meta(meta_path)

    if (
        meta is not None
        and (time.time() - float(meta.get("t", 0))) < window
        and not invalidated(root, scope, meta)
    ):
        body = read_body(out_path)
        if body is not None:
            age = time.time() - float(meta["t"])
            log_event(root, dict(base_record, ev="hit", age=round(age, 2)))
            debug("hit", "age %.1fs, no request made" % age)
            emit(body, int(meta.get("code", 0)), (meta.get("err") or "").encode())

    # Single flight. Only one process asks GitHub this question at a time; the
    # others wait for its answer, and take it only if it arrived after they
    # started waiting. A failure and an uncomputed-mergeability body are never
    # stored at all, so a waiter can only ever inherit a real answer. A wait
    # that runs out makes its own request, so the cache can never be the reason
    # a read does not happen.
    waited_from = time.time()
    try:
        patience = float(
            os.environ.get("GH_READ_CACHE_SINGLE_FLIGHT_WAIT", SINGLE_FLIGHT_WAIT)
        )
    except ValueError:
        patience = SINGLE_FLIGHT_WAIT
    lock = take_lock(meta_path + ".lock", waited_from + patience)
    if time.time() - waited_from > 0.05:
        fresh = load_meta(meta_path)
        if (
            fresh is not None
            and float(fresh.get("t", 0)) >= waited_from
            and not invalidated(root, scope, fresh)
        ):
            body = read_body(out_path)
            if body is not None:
                age = time.time() - float(fresh["t"])
                log_event(root, dict(base_record, ev="hit", shared=True, age=round(age, 2)))
                debug("hit", "shared another call's answer, no request made")
                emit(body, int(fresh.get("code", 0)), (fresh.get("err") or "").encode())
        meta = fresh if fresh is not None else meta

    if kind == CLASS_ETAG:
        args = list(argv) + ["--include"]
        if meta is not None and meta.get("etag"):
            args += ["-H", "If-None-Match: %s" % meta["etag"]]
        asked = time.time()
        code, out, err = run_child(args)
        status, headers, body = split_response(out)
        if status == 304:
            try:
                with open(out_path, "rb") as fh:
                    cached = fh.read()
            except OSError:
                cached = None
            if cached is not None:
                store(root, key, cached, meta.get("etag") if meta else None, req=asked)
                log_event(root, dict(base_record, ev="revalidated"))
                debug("revalidated", "304 Not Modified, free of the rate limit")
                emit(cached, 0)
        if status is not None and 200 <= status < 300 and code == 0:
            store(root, key, body, headers.get("etag"), req=asked)
            log_event(root, dict(base_record, ev="miss", status=status))
            debug("miss", "HTTP %s" % status)
            if random.random() < 0.02:
                prune(root)
            emit(body, 0)
        # Anything else (a 404, an auth failure, an output shape this does not
        # recognise) is reported the way gh reported it, and nothing is stored.
        log_event(root, dict(base_record, ev="passthrough", status=status, code=code))
        emit(body if status is not None else out, code, err)

    asked = time.time()
    code, out, err = run_child(argv)
    # Success, or the one non-zero code gh defines for a read: `gh pr checks`
    # answers 8 while checks are pending, and replaying 0 there would turn a
    # pending gate into a pass. Nothing else is stored, because a non-zero exit
    # with output is what a BROKEN gh looks like: the knives race leaves this
    # shim holding the knives wrapper, and `gh api ...` then prints that tool's
    # usage text and exits non-zero. A ten-second corruption must not be served
    # for another sixty.
    if code == 0 or (code == 8 and not err):
        store(root, key, out, None, code=code, err=err, req=asked)
        if random.random() < 0.02:
            prune(root)
        log_event(root, dict(base_record, ev="miss", code=code))
        debug("miss", "exit %d, stored" % code)
    else:
        log_event(root, dict(base_record, ev="passthrough", code=code))
        debug("passthrough", "exit %d, not stored" % code)
    emit(out, code, err)


if __name__ == "__main__":
    try:
        main()
    except SystemExit:
        raise
    except BrokenPipeError:
        os._exit(0)
    except Exception:
        # Never let this layer be the reason a gh call fails.
        try:
            exec_passthrough(sys.argv[2:] if sys.argv[1:2] == ["--"] else sys.argv[1:])
        except Exception:
            os._exit(70)
