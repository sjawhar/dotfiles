#!/usr/bin/python3
"""Post a pull-request review as the Legion review App, refusing if the head moved.

This lived in /mnt/nvme/sami/tmp/infra-wake and was deleted, with every verdict file beside
it, by something sweeping /mnt/nvme/sami/tmp on 2026-10-31 between 02:57Z and 03:20Z; the
gateway lane lost a script in the same window. It lives in ~/.dotfiles now, because a lane's
working tools do not belong on a path every session treats as scratch.

The head check is the point. A verdict names one head, and GitHub will happily attach it to
whatever the branch holds now, so a review posted after a force-push describes a tree nobody
has. If the head has moved, this refuses and the caller re-gates.

GH_TOKEN is never exported. The installation token is passed to one `gh` call through its own
environment, so no later command in the caller's shell speaks as the App.

The review App's key is human-tier (Sami, 2026-10-26: "move the Legion reviewer App private
key back to the human tier; he grants it to dev-box agents that need it"), so it comes from
the secrets broker through secret-run and is never written to disk.

Usage:
  post-review <pr> <40-char head sha> APPROVE|REQUEST_CHANGES|COMMENT <body-file> <owner/repo>
"""

import fcntl
import json
import os
import pathlib
import subprocess
import sys
import time

APP_ID = "5341243"  # git config gh-app.review.app-id
KEY_SECRET = "GH_REVIEW_APP_PRIVATE_KEY_B64"  # git config gh-app.review.key-secret
EVENTS = ("APPROVE", "REQUEST_CHANGES", "COMMENT")


def die(message: str, code: int = 2) -> None:
    print(f"post-review: {message}", file=sys.stderr)
    raise SystemExit(code)


def cache_path(owner: str, repo: str) -> pathlib.Path:
    base = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    directory = pathlib.Path(base) / "post-review"
    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    return directory / f"{owner}-{repo}.token"


def cached_token(path: pathlib.Path) -> str | None:
    """A GitHub installation token lives an hour; reuse it rather than asking again.

    Each mint goes through the secrets broker to a human-tier key, so it asks Sami to approve
    a grant. One verdict per approval made a night of gating a night of approving (Sami,
    2026-11-01: "STOP REQUESTING THE REVIEW KEY SO MANY DAMN TIMES"). The token, not the key,
    is what the calls need, so it is kept owner-only in the runtime directory, which is tmpfs
    and goes at reboot, and is used while more than five minutes of its hour remain.
    """
    try:
        held = json.loads(path.read_text())
    except (OSError, ValueError):
        return None
    token = held.get("token", "")
    if not token.startswith("ghs_") or held.get("expires_at", 0) - time.time() < 300:
        return None
    return token


def installation_token(owner: str, repo: str) -> str:
    """Mint an installation token for the review App, through the broker, or reuse a live one.

    Concurrent callers with a cold cache must not each mint: every mint is a grant prompt on
    Sami's phone, and three verdicts posted in the same minute after the hour turned over asked
    him three times. So the mint runs under an exclusive lock, and a caller that waited re-reads
    the cache before minting, so only the first caller asks.
    """
    path = cache_path(owner, repo)
    held = cached_token(path)
    if held:
        return held
    lock = open(path.with_suffix(".lock"), "w")
    fcntl.flock(lock, fcntl.LOCK_EX)
    held = cached_token(path)
    if held:
        lock.close()
        return held
    script = (
        "import base64,json,os,subprocess,sys,time,urllib.request\n"
        "import jwt\n"
        "key = base64.b64decode(os.environ['" + KEY_SECRET + "'])\n"
        "now = int(time.time())\n"
        "assertion = jwt.encode({'iat': now - 60, 'exp': now + 540, 'iss': '" + APP_ID + "'},"
        " key, algorithm='RS256')\n"
        "def api(path, method='GET'):\n"
        "    req = urllib.request.Request('https://api.github.com' + path, method=method)\n"
        "    req.add_header('Authorization', 'Bearer ' + assertion)\n"
        "    req.add_header('Accept', 'application/vnd.github+json')\n"
        "    return json.load(urllib.request.urlopen(req))\n"
        "inst = api('/repos/' + sys.argv[1] + '/' + sys.argv[2] + '/installation')\n"
        "out = api('/app/installations/%d/access_tokens' % inst['id'], 'POST')\n"
        "print(json.dumps({'token': out['token'], 'expires_at': out['expires_at']}))\n"
    )
    run = subprocess.run(
        [
            "secret-run",
            "--register",
            "--reason",
            f"post-review {owner}/{repo}",
            KEY_SECRET,
            "--",
            "python3",
            "-c",
            script,
            owner,
            repo,
        ],
        capture_output=True,
        text=True,
    )
    if run.returncode != 0:
        die(f"could not mint a review App token:\n{run.stderr.strip()}", 1)
    printed = run.stdout.strip().splitlines()[-1]
    try:
        minted = json.loads(printed)
        token = minted["token"]
        expires_at = time.mktime(time.strptime(minted["expires_at"], "%Y-%m-%dT%H:%M:%SZ"))
        expires_at -= time.timezone
    except (ValueError, KeyError):
        die(f"the broker returned no installation token: {run.stdout.strip()[:200]}", 1)
    if not token.startswith("ghs_"):
        die(f"the broker returned no installation token: {printed[:200]}", 1)
    path.write_text(json.dumps({"token": token, "expires_at": expires_at}))
    path.chmod(0o600)
    lock.close()
    return token


def gh(token: str, *args: str, stdin: str | None = None) -> str:
    run = subprocess.run(
        ["gh", *args],
        capture_output=True,
        text=True,
        input=stdin,
        env={**__import__("os").environ, "GH_TOKEN": token},
    )
    if run.returncode != 0:
        die(f"gh {' '.join(args)} failed:\n{run.stderr.strip()}", 1)
    return run.stdout.strip()


def notify_author(token: str, slug: str, pr: str, head: str, event: str, stamp: str) -> None:
    """Tell the session that made the head commit that its verdict is on the pull request.

    A verdict that reaches a peer in conversation and not the author is a verdict that was not
    delivered: agent infra's 2026-10-31 drop sweep put 233.3 of 240.0 delayed hours on owed gate
    verdicts, and the measured fix (FRAC tick 46-47, dispatch://BET-59/artifact/speed-log-md) is
    to send each verdict to its author the moment it posts.

    The address is the head commit's own `Omp-Session:` trailer, which this estate's commits
    carry. Everything here is best effort: the review is already posted, so no failure of this
    may fail the command, and a commit with no trailer simply gets no message.
    """
    import os
    import re

    try:
        message = subprocess.run(
            ["gh", "api", f"repos/{slug}/commits/{head}", "--jq", ".commit.message"],
            capture_output=True,
            text=True,
            env={**os.environ, "GH_TOKEN": token},
            timeout=60,
        ).stdout
        found = re.search(r"^Omp-Session:\s*([0-9a-fA-F-]{36})\s*$", message, re.MULTILINE)
        if not found:
            print(f"post-review: no Omp-Session trailer on {head[:8]}, nobody told")
            return
        session = found.group(1)
        verdict = "APPROVED" if event == "APPROVE" else event
        text = (
            f"Review posted: **{verdict}** on {slug}#{pr} at `{head}`, {stamp}.\n\n"
            f"https://github.com/{slug}/pull/{pr}\n\n"
            "You are addressed because this is the session named by that commit's "
            "`Omp-Session:` trailer. If the verdict asks for changes, the head moves and the "
            "next verdict names the new head."
        )
        sent = subprocess.run(
            ["envoy", "send", session, text], capture_output=True, text=True, timeout=60
        )
        if sent.returncode == 0:
            print(f"post-review: told {session}")
        else:
            print(f"post-review: could not tell {session}: {sent.stderr.strip()[:200]}")
    except Exception as error:  # noqa: BLE001 - the review is posted; this must never fail it
        print(f"post-review: could not tell the author: {error}")


def main() -> None:
    if len(sys.argv) < 6:
        die(
            "usage: post-review <pr> <head-sha> APPROVE|REQUEST_CHANGES|COMMENT"
            " <body-file> <owner/repo>"
        )
    pr, head, event, body_file, slug = sys.argv[1:6]

    if event not in EVENTS:
        die(f"event must be one of {', '.join(EVENTS)}, not {event}")
    if len(head) != 40:
        die(f"the head must be the full 40-character sha, not {head}")
    body = pathlib.Path(body_file)
    if not body.is_file():
        die(f"cannot read {body_file}")
    owner, _, repo = slug.partition("/")
    if not repo:
        die(f"the repository must be owner/repo, not {slug}")

    token = installation_token(owner, repo)

    live = gh(token, "api", f"repos/{slug}/pulls/{pr}", "--jq", ".head.sha")
    if live != head:
        die(
            f"refusing, the head moved: {slug}#{pr} is at {live}, the verdict names {head}",
            1,
        )

    payload = json.dumps(
        {"commit_id": head, "event": event, "body": body.read_text()}
    )
    gh(token, "api", "--method", "POST", f"repos/{slug}/pulls/{pr}/reviews", "--input", "-", stdin=payload)

    stamp = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    print(f"post-review: posted {event} on {slug}#{pr} at {head} ({stamp})")
    notify_author(token, slug, pr, head, event, stamp)


if __name__ == "__main__":
    main()
