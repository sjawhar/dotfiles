#!/usr/bin/python3
"""Post a pull-request review as the Legion review App, refusing if the head moved.

This lived in /mnt/nvme/sami/tmp/infra-wake and was deleted, with every verdict file beside
it, by something sweeping /mnt/nvme/sami/tmp on 2026-10-31 between 02:57Z and 03:20Z; the
gateway lane lost a script in the same window. It lives in ~/.dotfiles now, because a lane's
working tools do not belong on a path every session treats as scratch.

The head check is the point. A verdict names one head, and GitHub will happily attach it to
whatever the branch holds now, so a review posted after a force-push describes a tree nobody
has. If the head has moved, this refuses and the caller re-gates.

GH_TOKEN is never exported. The installation token is passed to one `gh` call through its own
environment, so no later command in the caller's shell speaks as the App.

The review App's tokens are minted by the secrets broker from the human-tier github-app secret
LEGION_REVIEW_APP (dispatch://INFRA-1031), so this script never holds the App's private key: it
asks secret-run for that secret narrowed to the one repository it reviews, and the broker hands
it a one-hour installation token. Each new grant waits for Sami's approval in Dispatch.

Every verdict ends with a `Reviewed by model: <id>` line, so a reader can tell a cross-family
review from a same-family one. The id is `--model` when given; otherwise every model that answered
in the omp session running this command, read from its transcript (PI_SESSION_FILE, which omp sets
in each session's and subagent's shell). A session posting a verdict another session wrote passes
that session's model with `--model`, since its own transcript names its own model.

Write the reviewer's prompt as a check for correctness and data loss, not as an attack: OpenAI
refused a GPT-6.1 Sol review whose prompt said "try to break it" ("flagged for possible
cybersecurity risk", 2026-11-03 12:58Z, ~/.omp/logs/omp.2026-11-03.34578.log).

A review of a pull request that adds or changes a Kubernetes Job manifest checks it against
theorem-labs/verification-skills plugins/dev-infra/skills/running-heavy-jobs/references/review-checklist.md.

Usage:
  post-review [--model <id>] [--dry-run] <pr> <40-char head sha> APPROVE|REQUEST_CHANGES|COMMENT
              <body-file> <owner/repo>

--dry-run prints the review it would post, footer included, and mints, reads and posts nothing.
"""

import argparse
import fcntl
import json
import os
import pathlib
import subprocess
import sys
import tempfile
import time

TOKEN_SECRET = "LEGION_REVIEW_APP"  # the broker's github-app secret of App 5341243
EVENTS = ("APPROVE", "REQUEST_CHANGES", "COMMENT")


def die(message: str, code: int = 2) -> None:
    print(f"post-review: {message}", file=sys.stderr)
    raise SystemExit(code)


# The review App's installation token belongs to the machine, not to one agent box. A box gets a
# private /run/user/$UID (scripts/agentbox mount_args), so a cache under $XDG_RUNTIME_DIR was one
# cache per box: each box asked Sami for its own grant of the human-tier review secret — the thing
# cached_token exists to stop — and a box recreated by `agentbox move` threw away the hour already
# granted to its session. agentbox binds the host's /run/user/$UID/post-review into every box at
# that same path, so the fixed path is the shared one and $XDG_RUNTIME_DIR is not.
# POST_REVIEW_CACHE_DIR stands in for that shared path; the tests use it.
def cache_dir() -> pathlib.Path:
    # The shared machine directory first. The fallbacks keep a context that does not have it
    # posting on a cache of its own: a box created before the bind (whose own /run/user/$UID is
    # private and writable, so it behaves exactly as it did before), a pod or a VM with no
    # per-user runtime directory, a different uid.
    shared = os.environ.get("POST_REVIEW_CACHE_DIR") or f"/run/user/{os.getuid()}/post-review"
    candidates = [pathlib.Path(shared)]
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if runtime:
        candidates.append(pathlib.Path(runtime) / "post-review")
    candidates.append(pathlib.Path(tempfile.gettempdir()) / f"post-review-{os.getuid()}")
    for directory in candidates:
        try:
            directory.mkdir(mode=0o700, parents=True, exist_ok=True)
        except OSError:
            continue
        if os.access(directory, os.W_OK | os.X_OK):
            return directory
    die(f"no writable token cache directory among {', '.join(str(c) for c in candidates)}")
    raise AssertionError  # die raises


def cache_path(owner: str, repo: str) -> pathlib.Path:
    return cache_dir() / f"{owner}-{repo}.token"


def cached_token(path: pathlib.Path) -> str | None:
    """A GitHub installation token lives an hour; reuse it rather than asking again.

    Each grant of the human-tier review App secret asks Sami to approve it. One verdict per
    approval made a night of gating a night of approving (Sami, 2026-11-01: "STOP REQUESTING THE
    REVIEW KEY SO MANY DAMN TIMES"). So the token is kept owner-only in the runtime directory,
    which is tmpfs and goes at reboot, and is used while more than five minutes of its hour remain.
    """
    try:
        held = json.loads(path.read_text())
    except (OSError, ValueError):
        return None
    token = held.get("token", "")
    if not token.startswith("ghs_") or held.get("expires_at", 0) - time.time() < 300:
        return None
    return token


# How long a caller with a cold cache waits for another session's request for the token before it
# asks too. Long enough that one approval usually serves every verdict posted in that minute; short
# enough that a request nobody approves does not hold anyone else's post. The variable is for tests.
ASK_WAIT_SECONDS = int(os.environ.get("POST_REVIEW_ASK_WAIT_SECONDS", "120"))

# Runs under secret-run, so only after the grant: the broker's wait for a human is over before it
# starts. The broker put its release in the environment under TOKEN_SECRET:
# {"installations": {"<owner>": {"installation_id": N, "token": "ghs_...", "expires_at": "..."}}}.
# It takes the cache lock for the cache write alone, and re-reads the cache under that lock, so two
# grants that land together leave one token in the cache.
MINT_SCRIPT = (
    "import calendar,fcntl,json,os,sys,time\n"
    "owner, repo, cache, lock_path = sys.argv[1:5]\n"
    "lock = open(lock_path, 'w')\n"
    "fcntl.flock(lock, fcntl.LOCK_EX)\n"
    "try:\n"
    "    held = json.load(open(cache))\n"
    "except (OSError, ValueError):\n"
    "    held = {}\n"
    "if str(held.get('token', '')).startswith('ghs_') and held.get('expires_at', 0) - time.time() >= 300:\n"
    "    print(json.dumps(held))\n"
    "    sys.exit(0)\n"
    "release = json.loads(os.environ['" + TOKEN_SECRET + "'])['installations']\n"
    "entry = next((v for k, v in release.items() if k.lower() == owner.lower()), None)\n"
    "if entry is None:\n"
    "    sys.exit('the review App has no installation on ' + owner)\n"
    "stamp = entry['expires_at'].replace('Z', '+00:00')[:19]\n"
    "minted = {'token': entry['token'],"
    " 'expires_at': calendar.timegm(time.strptime(stamp, '%Y-%m-%dT%H:%M:%S'))}\n"
    "if minted['token'].startswith('ghs_'):\n"
    "    fd = os.open(cache + '.tmp', os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)\n"
    "    with os.fdopen(fd, 'w') as f:\n"
    "        f.write(json.dumps(minted))\n"
    "    os.replace(cache + '.tmp', cache)\n"
    "print(json.dumps(minted))\n"
)


def installation_token(owner: str, repo: str) -> str:
    """Mint an installation token for the review App, through the broker, or reuse a live one.

    Every mint is a grant prompt on Sami's phone, and three verdicts posted in the same minute
    after the hour turned over asked him three times. So a caller with a cold cache first waits
    up to ASK_WAIT_SECONDS for another session's request (it holds `.asking`) to fill the cache,
    and asks itself only when none is in flight or that wait runs out. No lock is held across the
    broker's wait for the human: on 2026-11-02 at 19:31Z one request waiting for an approval held
    the per-repo lock for more than nine minutes and stopped every other session's post. The
    cache lock covers only the token POST and the cache write, inside MINT_SCRIPT.
    """
    path = cache_path(owner, repo)
    held = cached_token(path)
    if held:
        return held
    asking = open(path.with_suffix(".asking"), "w")
    deadline = time.monotonic() + ASK_WAIT_SECONDS
    while True:
        try:
            fcntl.flock(asking, fcntl.LOCK_EX | fcntl.LOCK_NB)
            break
        except BlockingIOError:
            held = cached_token(path)
            if held:
                asking.close()
                return held
            if time.monotonic() >= deadline:
                print(
                    f"post-review: another session's request for {TOKEN_SECRET} has waited more than"
                    f" {ASK_WAIT_SECONDS} s for its approval; asking as well",
                    file=sys.stderr,
                )
                break
            time.sleep(1)
    held = cached_token(path)
    if held:
        asking.close()
        return held
    run = subprocess.run(
        [
            "secret-run",
            "--register",
            "--reason",
            f"post-review {owner}/{repo}",
            "--github-owner",
            owner,
            "--github-repo",
            repo,
            TOKEN_SECRET,
            "--",
            "python3",
            "-c",
            MINT_SCRIPT,
            owner,
            repo,
            str(path),
            str(path.with_suffix(".lock")),
        ],
        capture_output=True,
        text=True,
    )
    asking.close()
    if run.returncode != 0:
        die(f"could not mint a review App token:\n{run.stderr.strip()}", 1)
    printed = run.stdout.strip().splitlines()[-1] if run.stdout.strip() else ""
    try:
        token = json.loads(printed)["token"]
    except (ValueError, KeyError, TypeError):
        die(f"the broker returned no installation token: {run.stdout.strip()[:200]}", 1)
    if not token.startswith("ghs_"):
        die(f"the broker returned no installation token: {printed[:200]}", 1)
    return token


def gh(token: str, *args: str, stdin: str | None = None) -> str:
    run = subprocess.run(
        ["gh", *args],
        capture_output=True,
        text=True,
        input=stdin,
        env={**__import__("os").environ, "GH_TOKEN": token},
    )
    if run.returncode != 0:
        die(f"gh {' '.join(args)} failed:\n{run.stderr.strip()}", 1)
    return run.stdout.strip()


def notify_author(token: str, slug: str, pr: str, head: str, event: str, stamp: str) -> None:
    """Tell the session that made the head commit that its verdict is on the pull request.

    A verdict that reaches a peer in conversation and not the author is a verdict that was not
    delivered: agent infra's 2026-10-31 drop sweep put 233.3 of 240.0 delayed hours on owed gate
    verdicts, and the measured fix (FRAC tick 46-47, dispatch://BET-59/artifact/speed-log-md) is
    to send each verdict to its author the moment it posts.

    The address is the head commit's own `Omp-Session:` trailer, which this estate's commits
    carry. Everything here is best effort: the review is already posted, so no failure of this
    may fail the command, and a commit with no trailer simply gets no message.
    """
    import os
    import re

    try:
        message = subprocess.run(
            ["gh", "api", f"repos/{slug}/commits/{head}", "--jq", ".commit.message"],
            capture_output=True,
            text=True,
            env={**os.environ, "GH_TOKEN": token},
            timeout=60,
        ).stdout
        found = re.search(r"^Omp-Session:\s*([0-9a-fA-F-]{36})\s*$", message, re.MULTILINE)
        if not found:
            print(f"post-review: no Omp-Session trailer on {head[:8]}, nobody told")
            return
        session = found.group(1)
        verdict = "APPROVED" if event == "APPROVE" else event
        text = (
            f"Review posted: **{verdict}** on {slug}#{pr} at `{head}`, {stamp}.\n\n"
            f"https://github.com/{slug}/pull/{pr}\n\n"
            "You are addressed because this is the session named by that commit's "
            "`Omp-Session:` trailer. If the verdict asks for changes, the head moves and the "
            "next verdict names the new head."
        )
        # The body goes on stdin: `envoy send` refuses one given as a command-line word in an
        # agent session, where the shell expands backticks and $(...) in it before envoy sees it.
        sent = subprocess.run(
            ["envoy", "send", "--message-file", "-", session],
            input=text, capture_output=True, text=True, timeout=60,
        )
        if sent.returncode == 0:
            print(f"post-review: told {session}")
        else:
            print(f"post-review: could not tell {session}: {sent.stderr.strip()[:200]}")
    except Exception as error:  # noqa: BLE001 - the review is posted; this must never fail it
        print(f"post-review: could not tell the author: {error}")


def answering_models(session_file: str) -> list[str]:
    """Every model that answered in one omp session, in the order each first answered.

    omp writes each assistant turn to the session's JSONL transcript with the provider and model
    that served it, so a fallback mid-review (Codex spent, the turn answered by Claude) shows up
    as a second id rather than being hidden behind the model the reviewer was asked to run on.
    """
    seen: list[str] = []
    try:
        with open(session_file, encoding="utf-8", errors="replace") as lines:
            for line in lines:
                if '"assistant"' not in line:
                    continue
                try:
                    entry = json.loads(line)
                except ValueError:
                    continue
                message = entry.get("message") if entry.get("type") == "message" else None
                if not isinstance(message, dict) or message.get("role") != "assistant":
                    continue
                model = message.get("model")
                if not model:
                    continue
                provider = message.get("provider")
                name = f"{provider}/{model}" if provider else str(model)
                if name not in seen:
                    seen.append(name)
    except OSError:
        return []
    return seen


def model_footer(explicit: str | None) -> str:
    """The line every verdict ends with, naming the model that wrote it."""
    if explicit:
        return f"Reviewed by model: `{explicit}` (given with --model)"
    session_file = os.environ.get("PI_SESSION_FILE", "")
    models = answering_models(session_file) if session_file else []
    if models:
        named = ", then ".join(f"`{m}`" for m in models)
        return f"Reviewed by model: {named} (read from the posting session's transcript)"
    print(
        "post-review: no --model and no omp transcript in PI_SESSION_FILE to read it from;"
        " the verdict says the model is unknown. Pass --model <id> of the model that wrote it.",
        file=sys.stderr,
    )
    return "Reviewed by model: unknown (no --model given, no omp session transcript to read)"


def main() -> None:
    parser = argparse.ArgumentParser(prog="post-review", description=__doc__.splitlines()[0])
    parser.add_argument("pr")
    parser.add_argument("head")
    parser.add_argument("event")
    parser.add_argument("body_file")
    parser.add_argument("slug")
    parser.add_argument("--model", help="the model that wrote the verdict (default: read from the session)")
    parser.add_argument("--dry-run", action="store_true", help="print the review; post nothing")
    args = parser.parse_args()
    pr, head, event, body_file, slug = args.pr, args.head, args.event, args.body_file, args.slug

    if event not in EVENTS:
        die(f"event must be one of {', '.join(EVENTS)}, not {event}")
    if len(head) != 40:
        die(f"the head must be the full 40-character sha, not {head}")
    body = pathlib.Path(body_file)
    if not body.is_file():
        die(f"cannot read {body_file}")
    owner, _, repo = slug.partition("/")
    if not repo:
        die(f"the repository must be owner/repo, not {slug}")

    text = body.read_text().rstrip("\n") + "\n\n---\n" + model_footer(args.model) + "\n"
    if args.dry_run:
        print(f"post-review: dry run, would post {event} on {slug}#{pr} at {head}:\n")
        print(text, end="")
        return

    token = installation_token(owner, repo)

    live = gh(token, "api", f"repos/{slug}/pulls/{pr}", "--jq", ".head.sha")
    if live != head:
        die(
            f"refusing, the head moved: {slug}#{pr} is at {live}, the verdict names {head}",
            1,
        )

    payload = json.dumps({"commit_id": head, "event": event, "body": text})
    gh(token, "api", "--method", "POST", f"repos/{slug}/pulls/{pr}/reviews", "--input", "-", stdin=payload)

    stamp = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    print(f"post-review: posted {event} on {slug}#{pr} at {head} ({stamp})")
    notify_author(token, slug, pr, head, event, stamp)


if __name__ == "__main__":
    main()
