#!/usr/bin/env bash
# Mirror OpenCode slash-commands into oh-my-pi prompt templates as symlinks.
# OMP names a template by its BASENAME only (prompt-templates.ts:105), so the farm
# is flat and the filename always equals the invocation name.
# Collisions across namespaces are renamed <namespace>--<basename>, matching the
# convention used by the existing skills flattening.
# Idempotent: safe to re-run; refreshes links and prunes dangling ones.
set -euo pipefail

PROMPTS_DIR="${PROMPTS_DIR:-$HOME/.omp/agent/prompts}"

# Commands OMP must not inherit verbatim. Each needs a hand-written OMP analog
# because its body relies on something OMP does not have.
#   sdd - dispatches via task(category=...); OMP has no categories (see Lane F).
EXCLUDE=("sdd")

NAMESPACES=(
  "sjawhar:$HOME/.dotfiles/plugins/sjawhar/commands"
  "legion:$HOME/.dotfiles/vendor/legion/.opencode/commands"
  "sentry:$HOME/.dotfiles/vendor/sentry-for-ai/commands"
)

is_excluded() {
  local name=$1
  for e in "${EXCLUDE[@]}"; do [ "$e" = "$name" ] && return 0; done
  return 1
}

mkdir -p "$PROMPTS_DIR"

linked=0; skipped=0; skipped_real=0; collided=0; pruned=0
declare -A OWNER=()

for pair in "${NAMESPACES[@]}"; do
  ns="${pair%%:*}"; src="${pair#*:}"
  [ -d "$src" ] || { echo "skip namespace $ns (no such dir: $src)"; continue; }
  for file in "$src"/*.md; do
    [ -e "$file" ] || continue
    base=$(basename "$file" .md)
    if is_excluded "$base"; then
      echo "skip $ns/$base (excluded; OMP analog is hand-written)"
      skipped=$((skipped+1))
      continue
    fi
    target="$base"
    if [ -n "${OWNER[$base]:-}" ]; then
      # Basename already claimed by another namespace. Disambiguate BOTH sides:
      # rename the incumbent too, so neither silently owns the bare name.
      incumbent="${OWNER[$base]}"
      if [ -L "$PROMPTS_DIR/$base.md" ]; then
        incumbent_target="$PROMPTS_DIR/${incumbent}--${base}.md"
        if [ -e "$incumbent_target" ] && [ ! -L "$incumbent_target" ]; then
          echo "warn: skip collision rename for $incumbent/$base (real path exists: $incumbent_target)"
          skipped_real=$((skipped_real+1))
        else
          mv -f "$PROMPTS_DIR/$base.md" "$incumbent_target"
          echo "collision on '$base': renamed incumbent to ${incumbent}--${base}"
        fi
      fi
      target="${ns}--${base}"
      collided=$((collided+1))
      echo "collision on '$base': linking $ns copy as $target"
    else
      OWNER[$base]="$ns"
    fi
    if [ -e "$PROMPTS_DIR/$target.md" ] && [ ! -L "$PROMPTS_DIR/$target.md" ]; then
      echo "warn: skip $ns/$target (real path exists: $PROMPTS_DIR/$target.md)"
      skipped_real=$((skipped_real+1))
      continue
    fi
    ln -sfn "$file" "$PROMPTS_DIR/$target.md"
    linked=$((linked+1))
  done
done

# Prune links whose source disappeared. Keep the scope flat and symlinks-only:
# Lane F owns the real prompts/sdd.md file and this cleanup must never touch it.
while IFS= read -r link; do
  if [ ! -e "$link" ]; then rm -f "$link"; pruned=$((pruned+1)); fi
done < <(find "$PROMPTS_DIR" -maxdepth 1 -type l 2>/dev/null)

echo "linked=$linked excluded=$skipped skipped-real=$skipped_real collision-renamed=$collided pruned=$pruned"
find "$PROMPTS_DIR" -maxdepth 1 -name '*.md' | sort
