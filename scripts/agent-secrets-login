#!/usr/bin/env bash
# agent-secrets-login: log this host's helper in as one operator (once per host, or again after
# the credential expires or is revoked).
#
#   agent-secrets-login <github-login>
#
# The helper generates a fresh machine key (never written to disk) and signs a credential-request
# object naming this operator; the broker mints an 8-symbol confirmation code and opens a pending
# machine-login record. The operator approves it on the Dispatch credential page — a human-only
# route: no agent can answer it — the code shown here must match what Dispatch shows before
# approving. The credential that results lives only in the helper's process memory; nothing
# credential-shaped ever touches disk. The operator login itself is stored at
# ~/.config/agent-secrets/operator, read by the helper on every login attempt; re-running this
# script replaces it.
set -euo pipefail

op="${1:-}"
[[ -n "$op" && "$op" != -* ]] || { echo "usage: agent-secrets-login <github-login>" >&2; exit 2; }
command -v agent-secrets >/dev/null 2>&1 || { echo "agent-secrets-login: agent-secrets is not installed (mise install agent-secrets)" >&2; exit 1; }
systemctl --user cat agent-secrets-helper.service >/dev/null 2>&1 \
    || { echo "agent-secrets-login: the agent-secrets helper is not installed on this machine (bash installers/agent-secrets.sh)" >&2; exit 1; }
if [[ -z "${AGENT_SECRETS_URL:-}" ]]; then
    # shellcheck source=SCRIPTDIR/../agent-secrets/broker.env
    . "${DOTFILES_DIR:-$HOME/.dotfiles}/agent-secrets/broker.env"
fi
export AGENT_SECRETS_URL
export AGENT_SECRETS_APPROVE_URL="${AGENT_SECRETS_APPROVE_URL:-https://dispatch.internal.trajectorylabs.com}"
export AGENT_SECRETS_HELPER_SOCK="${AGENT_SECRETS_HELPER_SOCK:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/agent-secrets/helper.sock}"

dir="$HOME/.config/agent-secrets"
mkdir -p "$dir"
chmod 700 "$dir"
(umask 077; printf '%s\n' "$op" >"$dir/operator")
chmod 600 "$dir/operator"
host="$(hostname -s)"

# The helper serves with or without a credential; a socket login needs it running and listening.
# `systemctl start` returns before the helper has opened its socket, and `launcher login` dials
# once, so wait for the socket first.
systemctl --user is-active --quiet agent-secrets-helper.service \
    || { systemctl --user reset-failed agent-secrets-helper.service 2>/dev/null || true
         systemctl --user start agent-secrets-helper.service; }
for _ in $(seq 1 50); do
    [[ -S "$AGENT_SECRETS_HELPER_SOCK" ]] && break
    sleep 0.2
done
[[ -S "$AGENT_SECRETS_HELPER_SOCK" ]] \
    || { echo "agent-secrets-login: the helper did not open $AGENT_SECRETS_HELPER_SOCK within 10 s (systemctl --user status agent-secrets-helper)" >&2; exit 1; }

echo "agent-secrets-login: starting machine login for $op on $host" >&2
agent-secrets launcher login
echo "agent-secrets-login: launcher credential issued for $op on $host" >&2
