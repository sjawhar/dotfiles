#!/usr/bin/env bash
# agent-secrets-login: obtain this host's launcher credential for one operator, once per host.
#
#   agent-secrets-login <github-login>
#
# The secrets broker opens an ask on the operator's standing secrets issue in Dispatch, naming
# this host; the operator taps Approve (a human-only route: no agent can answer it), and the
# credential is released to the waiting command, which stores it 0600 at
# ~/.config/agent-secrets/launcher.token — a path agentbox/mounts never lists, so no agent box
# can read it. The operator's login is stored beside it: scripts/agentbox enrolls every box
# under it, and agent-secrets-helper enrolls every host session under it. Re-running replaces
# both; the helper reads the files on every broker call, so it needs no restart.
set -euo pipefail

op="${1:-}"
[[ -n "$op" && "$op" != -* ]] || { echo "usage: agent-secrets-login <github-login>" >&2; exit 2; }
command -v agent-secrets >/dev/null 2>&1 || { echo "agent-secrets-login: agent-secrets is not installed (mise install agent-secrets)" >&2; exit 1; }
export AGENT_SECRETS_URL="${AGENT_SECRETS_URL:-https://secrets.internal.trajectorylabs.com}"

dir="$HOME/.config/agent-secrets"
mkdir -p "$dir"
chmod 700 "$dir"
host="$(hostname -s)"
echo "agent-secrets-login: asking $AGENT_SECRETS_URL for a launcher credential for $op on $host; approve the ask in Dispatch (it expires in 10 minutes)" >&2
agent-secrets launcher login --operator "$op" --host "$host" --out "$dir/launcher.token"
(umask 077; printf '%s\n' "$op" >"$dir/operator")
chmod 600 "$dir/launcher.token" "$dir/operator"
echo "agent-secrets-login: launcher credential for $op on $host at $dir/launcher.token" >&2

# The helper exits at start without a credential; now that one exists, (re)start it. A helper
# that is already running keeps its sessions: start is a no-op on an active unit.
if systemctl --user cat agent-secrets-helper.service >/dev/null 2>&1; then
    systemctl --user reset-failed agent-secrets-helper.service 2>/dev/null || true
    systemctl --user start agent-secrets-helper.service \
        && echo "agent-secrets-login: agent-secrets-helper started" >&2
fi
