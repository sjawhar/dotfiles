#!/usr/bin/env bash
# devbox-offbox-act <command> [args]
#
# The acting half of scripts/devbox-offbox-watch, run ON sami-devbox and shipped over ssh stdin
# (`ssh sami-devbox bash -s -- <command> …`) so it is never a published version behind the watch.
#
#   live <freshness-seconds> <session-id>…
#       Four readings per id, printed as their own lines. The caller decides; nothing here is a
#       verdict on its own.
#
#         holder <id> host|<container> <pid>   a process holding that session's transcript open
#                                              FOR WRITING, on the host and inside each box
#         fresh  <id> <age seconds> <path>     its transcript was written within <freshness>
#         proc   <id> <pid> <command line>     a host process whose words include `omp` and the id
#         box    <id> <container> <command>    the same, inside an agent box
#         live   <id> 0|1                      what `omp-session-live` says
#
#       The file is the test that works; argv is a hint. At 21:26Z on 2026-11-04 session
#       01a1a7fc-a94f-72f8-9651-bd5ecd335709 was writing its transcript and sending Envoy
#       messages while NO process on the host and none inside any of the 111 running boxes
#       carried its id on a command line: it was started from a transcript path through a
#       wrapper. Every argv test, however its path rule is written, is blind to that. So the
#       caller reads `holder` and `fresh` first and `proc`/`box`/`live` only as further signals,
#       and a session with no reading at all is not "dead", it is a candidate -- and only when
#       `boxscan ok` says every agent box answered.
#
#   restart <tmux-session> <window-title> <cwd> <resume command>
#       Open a new window named <window-title> in <tmux-session> (created detached if it does not
#       exist) and run the resume command there through `bash -lc`, from <cwd>. The window keeps a
#       login shell afterwards, so a resume that fails leaves its output on screen instead of
#       closing the window. Prints `window=<tmux id>`.
#
#   await <session-id> <seconds>
#       Ask omp-session-live every 5 s until the session is live or <seconds> pass. `live` or
#       `dead`, exit 0 or 1.
#
# It never kills, signals or stops anything.
set -uo pipefail

export PATH="$HOME/.dotfiles/shims:$HOME/.dotfiles/bin:$HOME/.dotfiles/scripts:$HOME/.local/bin:$HOME/.mise/shims:/usr/local/bin:/usr/bin:/bin"
export MISE_DATA_DIR="$HOME/.mise"
live_test="$HOME/.dotfiles/scripts/omp-session-live"

command="${1:?command}"
shift

case "$command" in
live)
    fresh_window="${1:?freshness seconds}"
    shift

    # 1. The transcript, written within <freshness>. One find over the sessions root for every id
    #    at once; `-newermt` lets the kernel do the filtering. A session waiting on a person
    #    writes nothing for hours, so this is a positive signal only, never an absence proof.
    while IFS= read -r line; do
        when="${line%% *}"; path="${line#* }"
        name="${path##*/}"
        for id in "$@"; do
            [[ "$name" == *"_$id.jsonl" ]] || continue
            printf 'fresh %s %s %s\n' "$id" "$(( $(date +%s) - ${when%.*} ))" "$path"
        done
    done < <(find "$HOME/.omp/agent/sessions" -maxdepth 2 -name '*.jsonl' \
        -newermt "-$fresh_window seconds" -printf '%T@ %p\n' 2>/dev/null || true)

    # 2. Who holds a transcript of the session open FOR WRITING. omp's session writer keeps its
    #    file open O_WRONLY|O_APPEND for its whole life, and only a writer runs a transcript: an
    #    omp opens another session's file read-only whenever a tool reads it. On the host, only
    #    omp processes are asked, since nothing else writes one.
    for d in /proc/[0-9]*; do
        c=""; read -r c 2>/dev/null <"$d/comm" || continue
        [[ "$c" == omp ]] || continue
        for fd in "$d"/fd/*; do
            target="$(readlink "$fd" 2>/dev/null)" || continue
            [[ "$target" == *.jsonl ]] || continue
            flags="$(awk '/^flags:/ { print $2 }' "${fd/\/fd\//\/fdinfo\/}" 2>/dev/null)"
            [[ "$flags" =~ ^[0-7]+$ ]] && (( (8#$flags & 3) != 0 )) || continue
            for id in "$@"; do
                [[ "${target##*/}" == *"_$id.jsonl" ]] || continue
                printf 'holder %s host %s\n' "$id" "${d##*/}"
            done
        done
    done

    for id in "$@"; do
        if "$live_test" "$id" >/dev/null 2>&1; then
            printf 'live %s 1\n' "$id"
        else
            printf 'live %s 0\n' "$id"
        fi
    done
    # One `ps` for every id at once, taken before the awk that reads it, so neither this ssh
    # command nor the filter appears in its own answer. A bash loop over /proc instead took most
    # of a minute on this box's 14,683 processes, which is most of a run.
    #
    # A process counts only when one of its words IS `omp` (`… -- omp --resume <id>`, an
    # `agentbox` line, a docker run, the omp binary itself) and another holds the id. "The line
    # contains omp somewhere" is not enough: a `grep` over transcripts under ~/.omp whose
    # arguments name a session matched that way, and would have blocked that session's restart
    # for as long as the grep ran.
    snapshot="$(ps -eww -o pid=,args= 2>/dev/null)"
    printf '%s\n' "$snapshot" | awk -v ids="$*" '
        BEGIN { count = split(ids, id, " ") }
        {
            pid = $1
            line = $0
            sub(/^ *[0-9]+ +/, "", line)
            runs_omp = 0
            words = split(line, word, " ")
            for (w = 1; w <= words; w++) {
                base = word[w]
                sub(/^.*\//, "", base)
                if (base == "omp") { runs_omp = 1; break }
            }
            if (!runs_omp) next
            for (i = 1; i <= count; i++)
                if (index(line, id[i])) printf "proc %s %s %s\n", id[i], pid, substr(line, 1, 400)
        }'
    # Second, independent test: every running agentbox container, asked for its own processes.
    # It exists because `omp-session-live` answers "dead" for a live session whose transcript
    # directory is not literally named `sessions` -- a `--session-dir` of `.../session/` is
    # enough (measured 2026-11-04: 01a1a682-6912 and 01a1a682-6922, alive in
    # agentbox-10842ee2b3b8 and its sibling, both reported dead). A resumed copy re-registers
    # under the live session's id, takes its Envoy messages and roles, and on exit drops the
    # original's registration, so the original keeps working and becomes unaddressable. The
    # caller restarts only when BOTH tests say dead, and never when this one could not run.
    #
    # `boxscan ok` is printed only when every running container answered. A container that did
    # not is a `boxerror` line and makes the scan not ok: a box that cannot be asked is not an
    # empty box.
    # Agent boxes only, by name. A session is boxed by `agentbox new`, which names its container
    # `agentbox-<id>`; other containers on this host run services and hold no omp. Two of them
    # carry no `ps` at all (measured 2026-11-04: 50264757a42e and ccbf568c46b0), and counting
    # those as "could not be asked" would hold every restart for ever for no reason. A box that
    # IS an agentbox and does not answer still stops the whole run.
    if ! boxes="$(docker ps --filter name=agentbox- -q 2>/dev/null)"; then
        printf 'boxscan failed docker ps did not answer\n'
    else
        # The boxes are asked in parallel, 8 at a time. One `docker exec` per box for both
        # readings (its descriptors and its command lines) and serially cost 140 s over 111
        # boxes, which does not fit inside a 5-minute timer; in parallel it is a few seconds.
        # `docker exec` runs as root in the box, so it sees every process's fds, which the host
        # cannot for a box's uid -- that is what finds a session whose omp carries its id nowhere
        # in an argv.
        answers="$(mktemp -d)"
        trap 'rm -rf "$answers"' EXIT
        running=0
        for container in $boxes; do
            {
                if inner="$(timeout 25 docker exec "$container" sh -c '
                    for d in /proc/[0-9]*; do
                        read -r comm <"$d/comm" 2>/dev/null || continue
                        [ "$comm" = omp ] || continue
                        for fd in "$d"/fd/*; do
                            target=$(readlink "$fd" 2>/dev/null) || continue
                            case "$target" in *.jsonl) ;; *) continue ;; esac
                            n=${fd##*/}
                            flags=$(awk "/^flags:/ { print \$2 }" "$d/fdinfo/$n" 2>/dev/null)
                            [ -n "$flags" ] && [ $(( 0$flags & 3 )) -ne 0 ] || continue
                            echo "HOLDS ${d#/proc/} $target"
                        done
                    done
                    ps -eo args= | sed "s/^/ARGS /"' 2>/dev/null)"; then
                    printf '%s\n' "$inner" >"$answers/$container"
                else
                    : >"$answers/$container.failed"
                fi
            } &
            running=$((running + 1))
            if ((running >= 8)); then wait -n 2>/dev/null || wait; running=$((running - 1)); fi
        done
        wait
        failures="$(find "$answers" -name '*.failed' -printf . | wc -c)"
        for path in "$answers"/*; do
            [[ -f "$path" && "$path" != *.failed ]] || continue
            container="${path##*/}"
            while read -r kind pid target; do
                [[ "$kind" == HOLDS ]] || continue
                for id in "$@"; do
                    [[ "${target##*/}" == *"_$id.jsonl" ]] || continue
                    printf 'holder %s %s %s\n' "$id" "$container" "$pid"
                done
            done <"$path"
            sed -n 's/^ARGS //p' "$path" | awk -v ids="$*" -v box="$container" '
                BEGIN { count = split(ids, id, " ") }
                {
                    runs_omp = 0
                    words = split($0, word, " ")
                    for (w = 1; w <= words; w++) {
                        base = word[w]
                        sub(/^.*\//, "", base)
                        if (base == "omp") { runs_omp = 1; break }
                    }
                    if (!runs_omp) next
                    for (i = 1; i <= count; i++)
                        if (index($0, id[i])) printf "box %s %s %s\n", id[i], box, substr($0, 1, 300)
                }'
        done
        for path in "$answers"/*.failed; do
            [[ -e "$path" ]] || continue
            container="${path##*/}"
            printf 'boxerror %s\n' "${container%.failed}"
        done
        if ((failures)); then
            printf 'boxscan failed %s container(s) did not answer\n' "$failures"
        else
            printf 'boxscan ok %s containers\n' "$(printf '%s\n' "$boxes" | grep -c .)"
        fi
    fi
    ;;
restart)
    session="${1:?tmux session}" title="${2:?window title}" cwd="${3:?cwd}" resume="${4:?resume}"
    # An entry may write its tmux field as `agents:its-window`. A tmux session name holds no
    # colon, so everything from the first one is the owner's note about where in that session the
    # window used to be; the new window is named for the entry's title either way.
    session="${session%%:*}"
    [[ -d "$cwd" ]] || { printf 'error=cwd %s does not exist\n' "$cwd" >&2; exit 1; }
    if ! tmux has-session -t "=$session" 2>/dev/null; then
        tmux new-session -d -s "$session" -c "$cwd" || exit 1
        printf 'created_tmux_session=%s\n' "$session"
    fi
    # One argument for tmux, which hands it to `sh -c`. The login shell after the resume keeps
    # the window and its output when the resume exits. No newline inside the quoted string: bash's
    # `%q` spells one as $'\n', which the `sh` tmux runs the argument with cannot read.
    inner="$(printf 'exec bash -lc %q' "$resume; exec bash -l")"
    window="$(tmux new-window -d -P -F '#{session_name}:#{window_index} #{window_id}' \
        -t "=$session:" -n "$title" -c "$cwd" "$inner")" || exit 1
    printf 'window=%s\n' "$window"
    ;;
await)
    id="${1:?session id}" seconds="${2:-180}"
    deadline=$((SECONDS + seconds))
    while :; do
        if "$live_test" "$id" >/dev/null 2>&1; then
            echo live
            exit 0
        fi
        ((SECONDS < deadline)) || break
        sleep 5
    done
    echo dead
    exit 1
    ;;
*)
    echo "devbox-offbox-act: unknown command $command" >&2
    exit 2
    ;;
esac
