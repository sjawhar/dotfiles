#!/usr/bin/env bash
# devbox-offbox-act <command> [args]
# devbox-offbox-act --forced                 (the forced command of the cluster watcher's key)
#
# The acting half of scripts/devbox-offbox-watch, run ON sami-devbox. The watcher on
# sami-rocqperf ships it over ssh stdin (`ssh sami-devbox bash -s -- <command> …`), so there it
# is never a published version behind the watch. The watcher in the dispatch cluster cannot:
# its key carries a forced command, and a forced command gets no stdin of its own, so there the
# host runs a PINNED COPY of this file, installed by installers/devbox-offbox-act-host.sh
# (dispatch://INFRA-993). Both forms run the same code; `--forced` only decides where the
# command comes from and how little of it is allowed.
#
#   live <freshness-seconds> <session-id>…
#       Five readings per id, printed as their own lines. The caller decides; nothing here is a
#       verdict on its own.
#
#         holder <id> host|<container> <pid>   a process holding that session's transcript open
#                                              FOR WRITING, on the host and inside each box
#         fresh  <id> <age seconds> <path>     its transcript was written within <freshness>
#         proc   <id> <pid> <command line>     a host process whose words include `omp` and the id
#         box    <id> <container> <command>    the same, inside an agent box
#         live   <id> 0|1                      what `omp-session-live` says
#         restarting <id> <age seconds>      agentbox-run.ts is relaunching that box's omp
#                                            right now (its marker's age); the session is dead
#                                            in that gap and must not be restarted from here
#
#       The file is the test that works; argv is a hint. At 21:26Z on 2026-11-04 session
#       01a1a7fc-a94f-72f8-9651-bd5ecd335709 was writing its transcript and sending Envoy
#       messages while NO process on the host and none inside any of the 111 running boxes
#       carried its id on a command line: it was started from a transcript path through a
#       wrapper. Every argv test, however its path rule is written, is blind to that. So the
#       caller reads `holder` and `fresh` first and `proc`/`box`/`live` only as further signals,
#       and a session with no reading at all is not "dead", it is a candidate -- and only when
#       `boxscan ok` says every agent box answered.
#
#   restart <tmux-session> <stream-window> <cwd> <resume command>
#   restart-entry <session-id>
#       Split a detached pane in the stream window and tile it. If that window is absent, use
#       chief. A missing chief is an error: this command never creates a session or window.
#       Run through `bash -lc`, from <cwd>, then keep a login shell so failed resume output stays
#       visible. Prints `window=<target> <id>` and `pane=<id>`. `restart-entry` reads tmux placement
#       and the resume from the host's own registry, never from the caller, so the forced key
#       cannot ask for an arbitrary `agentbox new`.
#
#   await <session-id> <seconds>
#       Ask omp-session-live every 5 s until the session is live or <seconds> pass. `live` or
#       `dead`, exit 0 or 1.
#
# It never kills, signals or stops anything.
#
# Under `--forced` the command is SSH_ORIGINAL_COMMAND, parsed here and not by any shell, and
# only four forms are accepted: `probe`, `live <uuid>…`, `restart <uuid>` and `await <uuid>`,
# each uuid matched against ^[0-9a-f-]{36}$. Everything else -- a shell, `agentbox new --dir /`,
# a second command after a `;`, a path, a flag -- exits nonzero with one line on stderr. The
# freshness and await windows are this file's own under `--forced`, so they are not the
# caller's either, and `restart` reads its resume line from the registry. What the key cannot do
# at all, because sshd refuses it before this file runs, is a shell, a port forward, an agent
# forward, X11 and a tty: that is the `restrict` in its authorized_keys line.
set -uo pipefail

export PATH="$HOME/.dotfiles/shims:$HOME/.dotfiles/bin:$HOME/.dotfiles/scripts:$HOME/.local/bin:$HOME/.mise/shims:/usr/local/bin:/usr/bin:/bin"
export MISE_DATA_DIR="$HOME/.mise"
live_test="$HOME/.dotfiles/scripts/omp-session-live"
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# The registry and the merge train, which the forced command reads instead of taking them from
# the caller. The environment overrides are for the tests alone; nothing sets them in anger.
registry_dir="${DEVBOX_OFFBOX_REGISTRY:-/mnt/durable/sami/restart-registry/sessions}"
train_dir="${DEVBOX_OFFBOX_TRAIN:-/mnt/nvme/sami/tmp/verified-linux/redesign/merge-train}"
# Where agentbox-run.ts records that it is relaunching a box's omp (`restarting` below). It is a
# mounted path, so a marker written inside a box is readable here on the host.
restart_markers="${AGENTBOX_RESTART_MARKERS:-$HOME/.cache/omp/agentbox}"
# The windows the forced command uses, which match the watcher's own FRESH_SECONDS and
# AWAIT_SECONDS. A caller that could set them could make every session look fresh.
forced_fresh_seconds=120
forced_await_seconds=45

# A session id, in full: 8-4-4-4-12 hexadecimal. Not `[0-9a-f-]{36}`, which also admits 36 hyphens
# and is not uuid syntax, however little the rest of the file would do with one.
uuid_re='^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'

# The most ids one `live` may carry. The key is read-only, so an unbounded list costs the watched
# box CPU rather than privilege -- but 3,000 ids ran 34 s wall and 43 s user against the pinned
# copy with the box scan stubbed out (the INFRA lead's gate of agent-infra#2194, 2026-11-05), and a
# real pass adds the 116-box scan on top of that. 256 is far above what the watch asks for: the
# registry held 20-odd entries at its largest, and the watch sends every `auto_restart=yes` entry
# in one call.
forced_live_max_ids=256

refuse() {
    printf 'devbox-offbox-act --forced: %s\n' "$1" >&2
    exit 2
}

# The forced command. sshd puts the client's command in SSH_ORIGINAL_COMMAND and runs this file
# with no argument of its own; nothing here is passed to a shell, so a `;`, a `$(…)`, a newline
# or a quote is not a thing to escape, it is a thing to refuse.
if [[ "${1-}" == --forced ]]; then
    (( $# == 1 )) || refuse "takes no argument of its own; the command is SSH_ORIGINAL_COMMAND"
    original="${SSH_ORIGINAL_COMMAND-}"
    [[ -n "$original" ]] || refuse "no command given, and this key carries no shell"
    [[ "$original" != *$'\n'* ]] || refuse "a command of more than one line is not accepted"
    [[ "$original" != *[^[:alnum:][:blank:]_-]* ]] \
        || refuse "only letters, digits, spaces, '_' and '-' are accepted: $original"
    read -r -a words <<<"$original"
    (( ${#words[@]} )) || refuse "no command given, and this key carries no shell"
    # The count is checked BEFORE any per-id work: matching 3,000 ids against the regex is itself
    # the cost a cap exists to stop.
    (( ${#words[@]} - 1 <= forced_live_max_ids )) \
        || refuse "at most $forced_live_max_ids session ids in one command, not $(( ${#words[@]} - 1 ))"
    for word in "${words[@]:1}"; do
        [[ "$word" =~ $uuid_re ]] || refuse "not a session id: $word"
    done
    case "${words[0]}" in
    probe)
        (( ${#words[@]} == 1 )) || refuse "probe takes no argument"
        exec bash "$here/devbox-offbox-probe" /proc "$registry_dir" "$train_dir"
        ;;
    live)
        (( ${#words[@]} >= 2 )) || refuse "live needs at least one session id"
        set -- live "$forced_fresh_seconds" "${words[@]:1}"
        ;;
    restart)
        (( ${#words[@]} == 2 )) || refuse "restart takes one session id and nothing else"
        set -- restart-entry "${words[1]}"
        ;;
    await)
        (( ${#words[@]} == 2 )) || refuse "await takes one session id and nothing else"
        set -- await "${words[1]}" "$forced_await_seconds"
        ;;
    *)
        refuse "command not accepted: ${words[0]} (only probe, live, restart and await are)"
        ;;
    esac
fi

# Both transports split an existing stream window. No path/title inference, window creation,
# renaming or reordering: entries without a usable stream go to the existing chief window.
do_restart() {
    local session="${1%%:*}" stream="${2:-chief}" cwd="$3" resume="$4"
    local inner location target window pane format='#{session_name}:#{window_name} #{window_id} #{pane_id}'
    if [[ "$session" == dev ]]; then session=agents; stream=chief; fi
    case "$stream" in
        chief|ossv|linux|tasks|grader|infra|rocq|cicd) ;;
        *) printf 'refused_window=%s\n' "$stream"
           printf 'refused window=%s; using chief\n' "$stream" >&2
           stream=chief ;;
    esac
    [[ -d "$cwd" ]] || { printf 'error=cwd %s does not exist\n' "$cwd" >&2; return 1; }
    window="$(tmux list-windows -t "=$session" -f "#{==:#{window_name},$stream}" \
        -F '#{window_id}' 2>/dev/null)" || window=""
    if [[ -z "$window" && "$stream" != chief ]]; then
        printf 'fallback=%s:%s missing; using %s:chief\n' "$session" "$stream" "$session"
        stream=chief
        window="$(tmux list-windows -t "=$session" -f '#{==:#{window_name},chief}' \
            -F '#{window_id}' 2>/dev/null)" || window=""
    fi
    [[ -n "$window" ]] || {
        printf 'error=no existing %s:chief window; rebuild the layout before restarting; nothing created\n' "$session" >&2
        return 1
    }
    # One argument for tmux's `sh -c`. Keep a login shell after the resume exits, preserving its
    # output. No newline in this string: `sh` cannot read bash's %q spelling of one as $'\n'.
    inner="$(printf 'exec bash -lc %q' "$resume; exec bash -l")"
    location="$(tmux split-window -d -P -F "$format" -t "$window" -c "$cwd" "$inner")" || return 1
    read -r target window pane <<<"$location"
    printf 'window=%s %s\n' "$target" "$window"
    printf 'pane=%s\n' "$pane"
    # Once spawned, a layout failure is not a failed restart: the pane is already running.
    tmux select-layout -t "$window" tiled >/dev/null \
        || printf 'layout_warning=could not tile %s\n' "$target"
}

command="${1:?command}"
shift

case "$command" in
live)
    fresh_window="${1:?freshness seconds}"
    shift

    # 1. The transcript, written within <freshness>. One find over the sessions root for every id
    #    at once; `-newermt` lets the kernel do the filtering. A session waiting on a person
    #    writes nothing for hours, so this is a positive signal only, never an absence proof.
    while IFS= read -r line; do
        when="${line%% *}"; path="${line#* }"
        name="${path##*/}"
        for id in "$@"; do
            [[ "$name" == *"_$id.jsonl" ]] || continue
            printf 'fresh %s %s %s\n' "$id" "$(( $(date +%s) - ${when%.*} ))" "$path"
        done
    done < <(find "$HOME/.omp/agent/sessions" -maxdepth 2 -name '*.jsonl' \
        -newermt "-$fresh_window seconds" -printf '%T@ %p\n' 2>/dev/null || true)

    # 1b. A box whose omp is being relaunched right now. `agentbox restart` hangs omp up and
    #     spawns a fresh one in the same container, and in that gap the session is dead by every
    #     test here: no holder, no fresh transcript, no process, and omp-session-live says
    #     nothing. At 10:10Z on 2026-11-05 a watcher pass read exactly that and asked for a
    #     restart of a session UTIL was restarting in place; only `agentbox new`'s own duplicate
    #     guard stopped there being two of it. agentbox-run.ts writes a marker before it hangs omp
    #     up and removes it once the new omp registers, so this is a READING like the others --
    #     the caller refuses while it is fresh, and it expires, because a relaunch that died must
    #     not make a session unrestartable for ever.
    for id in "$@"; do
        marker="$restart_markers/restarting-$id"
        [[ -f "$marker" ]] || continue
        at=""
        while IFS= read -r line; do
            [[ "${line%%=*}" == at ]] && at="${line#*=}"
        done <"$marker"
        [[ "$at" =~ ^[0-9]+$ ]] || at="$(stat -c %Y "$marker" 2>/dev/null || echo 0)"
        printf 'restarting %s %s\n' "$id" "$(( $(date +%s) - at ))"
    done

    # 2. Who holds a transcript of the session open FOR WRITING. omp's session writer keeps its
    #    file open O_WRONLY|O_APPEND for its whole life, and only a writer runs a transcript: an
    #    omp opens another session's file read-only whenever a tool reads it. On the host, only
    #    omp processes are asked, since nothing else writes one.
    for d in /proc/[0-9]*; do
        c=""; read -r c 2>/dev/null <"$d/comm" || continue
        [[ "$c" == omp ]] || continue
        for fd in "$d"/fd/*; do
            target="$(readlink "$fd" 2>/dev/null)" || continue
            [[ "$target" == *.jsonl ]] || continue
            flags="$(awk '/^flags:/ { print $2 }' "${fd/\/fd\//\/fdinfo\/}" 2>/dev/null)"
            [[ "$flags" =~ ^[0-7]+$ ]] && (( (8#$flags & 3) != 0 )) || continue
            for id in "$@"; do
                [[ "${target##*/}" == *"_$id.jsonl" ]] || continue
                printf 'holder %s host %s\n' "$id" "${d##*/}"
            done
        done
    done

    # Shared by the host scan below and the box scan further down, so the two can never drift:
    # does THIS command line RUN that session, as against merely mentioning it?
    owns_fn='
function runs_omp(line,   n, word, w, base) {
    n = split(line, word, " ")
    for (w = 1; w <= n; w++) { base = word[w]; sub(/^.*\//, "", base); if (base == "omp") return 1 }
    return 0
}
function owns_session(line, sid,   n, word, w, arg) {
    n = split(line, word, " ")
    for (w = 1; w <= n; w++) {
        arg = word[w]
        if ((arg == "--resume" || arg == "--session-id") && w < n) {
            if (index(word[w + 1], sid)) return 1
        } else if (index(arg, "--resume=") == 1 || index(arg, "--session-id=") == 1) {
            if (index(arg, sid)) return 1
        } else if (arg ~ /^\/.*\.jsonl$/ && index(arg, sid)) {
            return 1
        }
    }
    return 0
}'

    for id in "$@"; do
        if "$live_test" "$id" >/dev/null 2>&1; then
            printf 'live %s 1\n' "$id"
        else
            printf 'live %s 0\n' "$id"
        fi
    done
    # One `ps` for every id at once, taken before the awk that reads it, so neither this ssh
    # command nor the filter appears in its own answer. A bash loop over /proc instead took most
    # of a minute on this box's 14,683 processes, which is most of a run.
    #
    # A process counts only when one of its words IS `omp` (`… -- omp --resume <id>`, an
    # `agentbox` line, a docker run, the omp binary itself) AND the id is that process's own
    # session: the value of `--resume`/`--session-id`, or a transcript path it was given. "The
    # line contains omp somewhere" is not enough: a `grep` over transcripts under ~/.omp whose
    # arguments name a session matched that way, and would have blocked that session's restart
    # for as long as the grep ran.
    #
    # Nor is "an omp process whose line holds the id anywhere". A headless `omp -p` carries its
    # whole PROMPT in its arguments, and a prompt routinely names another session: the Verified
    # Linux drift checker is told to report to its lead, so its line holds the lead's id. On
    # 2026-11-05 at 04:28Z that made the post-reboot restart skip the lead, SPEEDCOACH and PIPE
    # as live while all three were dead, and it would have held this watcher off that lead for
    # as long as the hourly checker ran. The test is the same one `omp-session-live` applies:
    # the session a process RUNS, not a session it mentions.
    snapshot="$(ps -eww -o pid=,args= 2>/dev/null)"
    printf '%s\n' "$snapshot" | awk -v ids="$*" "$owns_fn"'
        BEGIN { count = split(ids, id, " ") }
        {
            pid = $1
            line = $0
            sub(/^ *[0-9]+ +/, "", line)
            if (!runs_omp(line)) next
            for (i = 1; i <= count; i++)
                if (owns_session(line, id[i]))
                    printf "proc %s %s %s\n", id[i], pid, substr(line, 1, 400)
        }'
    # Second, independent test: every running agentbox container, asked for its own processes.
    # It exists because `omp-session-live` answers "dead" for a live session whose transcript
    # directory is not literally named `sessions` -- a `--session-dir` of `.../session/` is
    # enough (measured 2026-11-04: 01a1a682-6912 and 01a1a682-6922, alive in
    # agentbox-10842ee2b3b8 and its sibling, both reported dead). A resumed copy re-registers
    # under the live session's id, takes its Envoy messages and roles, and on exit drops the
    # original's registration, so the original keeps working and becomes unaddressable. The
    # caller restarts only when BOTH tests say dead, and never when this one could not run.
    #
    # `boxscan ok` is printed only when every running container answered. A container that did
    # not is a `boxerror` line and makes the scan not ok: a box that cannot be asked is not an
    # empty box.
    # Agent boxes only, by name. A session is boxed by `agentbox new`, which names its container
    # `agentbox-<id>`; other containers on this host run services and hold no omp. Two of them
    # carry no `ps` at all (measured 2026-11-04: 50264757a42e and ccbf568c46b0), and counting
    # those as "could not be asked" would hold every restart for ever for no reason. A box that
    # IS an agentbox and does not answer still stops the whole run.
    if ! boxes="$(docker ps --filter name=agentbox- -q 2>/dev/null)"; then
        printf 'boxscan failed docker ps did not answer\n'
    else
        # The boxes are asked in parallel, 8 at a time. One `docker exec` per box for both
        # readings (its descriptors and its command lines) and serially cost 140 s over 111
        # boxes, which does not fit inside a 5-minute timer; in parallel it is a few seconds.
        # `docker exec` runs as root in the box, so it sees every process's fds, which the host
        # cannot for a box's uid -- that is what finds a session whose omp carries its id nowhere
        # in an argv.
        answers="$(mktemp -d)"
        trap 'rm -rf "$answers"' EXIT
        running=0
        for container in $boxes; do
            {
                if inner="$(timeout 25 docker exec "$container" sh -c '
                    for d in /proc/[0-9]*; do
                        read -r comm <"$d/comm" 2>/dev/null || continue
                        [ "$comm" = omp ] || continue
                        for fd in "$d"/fd/*; do
                            target=$(readlink "$fd" 2>/dev/null) || continue
                            case "$target" in *.jsonl) ;; *) continue ;; esac
                            n=${fd##*/}
                            flags=$(awk "/^flags:/ { print \$2 }" "$d/fdinfo/$n" 2>/dev/null)
                            [ -n "$flags" ] && [ $(( 0$flags & 3 )) -ne 0 ] || continue
                            echo "HOLDS ${d#/proc/} $target"
                        done
                    done
                    ps -eo args= | sed "s/^/ARGS /"' 2>/dev/null)"; then
                    printf '%s\n' "$inner" >"$answers/$container"
                else
                    : >"$answers/$container.failed"
                fi
            } &
            running=$((running + 1))
            if ((running >= 8)); then wait -n 2>/dev/null || wait; running=$((running - 1)); fi
        done
        wait
        failures="$(find "$answers" -name '*.failed' -printf . | wc -c)"
        for path in "$answers"/*; do
            [[ -f "$path" && "$path" != *.failed ]] || continue
            container="${path##*/}"
            while read -r kind pid target; do
                [[ "$kind" == HOLDS ]] || continue
                for id in "$@"; do
                    [[ "${target##*/}" == *"_$id.jsonl" ]] || continue
                    printf 'holder %s %s %s\n' "$id" "$container" "$pid"
                done
            done <"$path"
            sed -n 's/^ARGS //p' "$path" | awk -v ids="$*" -v box="$container" "$owns_fn"'
                BEGIN { count = split(ids, id, " ") }
                {
                    if (!runs_omp($0)) next
                    for (i = 1; i <= count; i++)
                        if (owns_session($0, id[i]))
                            printf "box %s %s %s\n", id[i], box, substr($0, 1, 300)
                }'
        done
        for path in "$answers"/*.failed; do
            [[ -e "$path" ]] || continue
            container="${path##*/}"
            printf 'boxerror %s\n' "${container%.failed}"
        done
        if ((failures)); then
            printf 'boxscan failed %s container(s) did not answer\n' "$failures"
        else
            printf 'boxscan ok %s containers\n' "$(printf '%s\n' "$boxes" | grep -c .)"
        fi
    fi
    ;;
restart)
    do_restart "${1:?tmux session}" "${2:-chief}" "${3:?cwd}" "${4:?resume}" || exit 1
    ;;
restart-entry)
    # The forced command's restart: every value comes from this host's own registry entry for
    # that session, so the key can ask for the resume line its owner wrote and nothing else.
    id="${1:?session id}"
    [[ "$id" =~ $uuid_re ]] || { printf 'error=not a session id: %s\n' "$id" >&2; exit 2; }
    entry="$registry_dir/$id.entry"
    # A regular file, and not a symlink: writing one into the registry already needs access past
    # anything this key has, but reading through it is not a thing the forced command should do.
    [[ -f "$entry" && ! -L "$entry" ]] \
        || { printf 'error=no registry entry %s\n' "$entry" >&2; exit 1; }
    entry_session="" entry_title="" entry_cwd="" entry_resume="" entry_tmux=""
    while IFS= read -r line; do
        [[ "$line" == *=* ]] || continue
        case "${line%%=*}" in
        session) entry_session="${line#*=}" ;;
        title) entry_title="${line#*=}" ;;
        cwd) entry_cwd="${line#*=}" ;;
        resume) entry_resume="${line#*=}" ;;
        tmux) entry_tmux="${line#*=}" ;;
        esac
    done <"$entry"
    # The file is named for a session; an entry naming another one is not acted on, so a file
    # dropped into the registry cannot borrow a session id it does not hold.
    [[ "$entry_session" == "$id" ]] \
        || { printf 'error=%s holds session=%s\n' "$entry" "$entry_session" >&2; exit 1; }
    for pair in "tmux:$entry_tmux" "title:$entry_title" "cwd:$entry_cwd" "resume:$entry_resume"; do
        [[ -n "${pair#*:}" ]] || { printf 'error=%s has no %s\n' "$entry" "${pair%%:*}" >&2; exit 1; }
    done
    printf 'entry=%s\n' "$entry"
    printf 'resume=%s\n' "$entry_resume"
    entry_stream=chief
    [[ "$entry_tmux" == *:* ]] && entry_stream="${entry_tmux#*:}"
    do_restart "$entry_tmux" "$entry_stream" "$entry_cwd" "$entry_resume" || exit 1
    ;;
await)
    id="${1:?session id}" seconds="${2:-180}"
    deadline=$((SECONDS + seconds))
    while :; do
        if "$live_test" "$id" >/dev/null 2>&1; then
            echo live
            exit 0
        fi
        ((SECONDS < deadline)) || break
        sleep 5
    done
    echo dead
    exit 1
    ;;
*)
    echo "devbox-offbox-act: unknown command $command" >&2
    exit 2
    ;;
esac
