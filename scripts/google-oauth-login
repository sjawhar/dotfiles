#!/usr/bin/env python3
"""google-oauth-login: Google's installed-app OAuth flow for exactly the scopes asked for.

    google-oauth-login --client-env VAR --scope SCOPE [--scope SCOPE ...] [--login-hint EMAIL]

Prints the resulting authorized_user credential ({"type", "client_id", "client_secret",
"refresh_token"}) as one line of JSON on stdout, for `secrets edit-human KEY` to read from a pipe,
and the consent URL and the granted scopes on stderr. VAR names an environment variable that holds
the OAuth client: an authorized_user credential already minted on it, or a downloaded client file
({"installed": {...}}), so the client secret never reaches argv.

`gws auth login` always adds openid and the two userinfo scopes. This is for a credential that must
carry nothing else, such as a Gmail send key: mailbox warns about a send credential whose grant holds
any scope besides gmail.send.

The consent page opens through xdg-open; on a headless machine the dotfiles shim hands it to
`forward open`, which also carries the localhost callback back here. The callback listens on
127.0.0.1 for 300 s, forward's window for it. Every requested scope must be granted (an unchecked
box on the consent page is an error), and so must a refresh token.
"""
import argparse
import base64
import hashlib
import http.server
import json
import os
import secrets
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

AUTH_URL = "https://accounts.google.com/o/oauth2/v2/auth"
TOKEN_URL = "https://oauth2.googleapis.com/token"
TIMEOUT_S = 300


def fail(message: str) -> None:
    print(f"google-oauth-login: {message}", file=sys.stderr)
    sys.exit(1)


def load_client(var: str) -> tuple[str, str]:
    raw = os.environ.get(var)
    if not raw:
        fail(f"environment variable {var} is empty or unset")
    try:
        data = json.loads(raw)
    except json.JSONDecodeError:
        fail(f"{var} does not hold JSON")
    data = data.get("installed") or data.get("web") or data
    client_id, client_secret = data.get("client_id"), data.get("client_secret")
    if not client_id or not client_secret:
        fail(f"{var} holds no client_id and client_secret")
    return client_id, client_secret


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    parser.add_argument("--client-env", required=True, metavar="VAR")
    parser.add_argument("--scope", action="append", required=True)
    parser.add_argument("--login-hint", metavar="EMAIL")
    args = parser.parse_args()
    client_id, client_secret = load_client(args.client_env)

    state = secrets.token_urlsafe(24)
    verifier = secrets.token_urlsafe(64)
    challenge = base64.urlsafe_b64encode(hashlib.sha256(verifier.encode()).digest()).rstrip(b"=").decode()
    callback: dict[str, str] = {}

    class Handler(http.server.BaseHTTPRequestHandler):
        def do_GET(self) -> None:
            query = urllib.parse.parse_qs(urllib.parse.urlsplit(self.path).query)
            if query.get("state", [""])[0] != state:
                self.send_response(404)
                self.end_headers()
                return
            callback.update({key: values[0] for key, values in query.items()})
            body = b"Sign-in finished. You can close this tab.\n" if "code" in query else b"Sign-in failed.\n"
            self.send_response(200)
            self.send_header("Content-Type", "text/plain")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def log_message(self, *_args: object) -> None:
            pass

    server = http.server.HTTPServer(("127.0.0.1", 0), Handler)
    redirect_uri = f"http://localhost:{server.server_port}"
    params = {
        "client_id": client_id,
        "redirect_uri": redirect_uri,
        "response_type": "code",
        "scope": " ".join(args.scope),
        "access_type": "offline",
        "prompt": "consent",
        "state": state,
        "code_challenge": challenge,
        "code_challenge_method": "S256",
    }
    if args.login_hint:
        params["login_hint"] = args.login_hint
    url = f"{AUTH_URL}?{urllib.parse.urlencode(params)}"
    print(f"Consent page: {url}", file=sys.stderr, flush=True)
    opener_env = {key: value for key, value in os.environ.items() if key != args.client_env}
    subprocess.run(["xdg-open", url], stdout=subprocess.DEVNULL, env=opener_env, check=True)

    deadline = time.monotonic() + TIMEOUT_S
    while not callback:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            fail(f"no sign-in callback within {TIMEOUT_S} s")
        server.timeout = remaining
        server.handle_request()
    server.server_close()
    if "code" not in callback:
        fail(f"Google refused the grant: {callback.get('error', 'no code in the callback')}")

    body = urllib.parse.urlencode(
        {
            "code": callback["code"],
            "client_id": client_id,
            "client_secret": client_secret,
            "redirect_uri": redirect_uri,
            "grant_type": "authorization_code",
            "code_verifier": verifier,
        }
    ).encode()
    try:
        with urllib.request.urlopen(TOKEN_URL, body, timeout=30) as response:
            token = json.load(response)
    except urllib.error.HTTPError as error:
        reply = json.loads(error.read() or b"{}")
        fail(f"code exchange failed: HTTP {error.code} {reply.get('error')}: {reply.get('error_description')}")

    granted = set(token.get("scope", "").split())
    missing = [scope for scope in args.scope if scope not in granted]
    if missing:
        fail(f"the consent did not grant {' '.join(missing)}; granted: {' '.join(sorted(granted))}")
    if not token.get("refresh_token"):
        fail("Google returned no refresh token")
    print(f"Granted: {' '.join(sorted(granted))}", file=sys.stderr)
    credential = {
        "type": "authorized_user",
        "client_id": client_id,
        "client_secret": client_secret,
        "refresh_token": token["refresh_token"],
    }
    print(json.dumps(credential, separators=(",", ":")))


if __name__ == "__main__":
    main()
