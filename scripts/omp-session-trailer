#!/bin/bash
# omp-session-trailer GIT [GIT_OPTION…]: whether a commit that `GIT [GIT_OPTION…]` makes
# from an omp session carries the Omp-Session trailer. Exit 0 adds it, exit 1 leaves it
# off; stdout says why. shims/git asks it for every `git commit` and shims/jj for every
# jj command that can write a description (`shims/AGENTS.md`).
#
# The trailer names an agent session, and the published release repositories of the
# owners in PUBLISHING_OWNERS (scripts/github-visibility.bash) must not carry one:
# theorem-labs' public repositories (oss-verify, oss-verify-proofs, rocq, …) gathered
# dozens before this check existed. So the trailer is left off when any github.com remote
# of the repository belongs to one of those owners and GitHub says the repository is
# public, or GitHub cannot say: any remote, not only origin, because a commit made against
# a private origin is pushed to the public remote beside it. Every other repository keeps
# it; Sami's own public repositories use it on purpose (Legion's Delivery page,
# scripts/pr-gate, session attribution). `git config omp.sessionTrailer true|false`
# decides before any of this. The visibility answer and its cache come from
# scripts/github-visibility.bash: an unknown answer leaves the trailer off, so
# attribution may be absent, never leaked.
set -euo pipefail

# shellcheck source=github-visibility.bash
source "${BASH_SOURCE[0]%/*}/github-visibility.bash"

git=("$@")
case "$("${git[@]}" config --type=bool --get omp.sessionTrailer 2>/dev/null || true)" in
    true) echo "on: omp.sessionTrailer is true"; exit 0 ;;
    false) echo "off: omp.sessionTrailer is false"; exit 1 ;;
esac

# `git remote -v` prints each remote's fetch and push URL after insteadOf rewriting.
urls=()
while read -r _name url _kind; do
    urls+=("$url")
done < <("${git[@]}" remote -v 2>/dev/null || true)
mapfile -t slugs < <(publishing_slugs "${urls[@]}")
if ((${#slugs[@]} == 0)); then
    echo "on: no github.com remote owned by ${PUBLISHING_OWNERS[*]}"
    exit 0
fi

for slug in "${slugs[@]}"; do
    answer="$(github_visibility "$slug")"
    case "$answer" in
        private | internal) ;;
        *) echo "off: github.com/$slug is $answer"; exit 1 ;;
    esac
done
echo "on: github.com/${slugs[*]} not public"
exit 0
