#!/bin/bash
# omp-session-trailer GIT [GIT_OPTION…]: whether a commit that `GIT [GIT_OPTION…]` makes
# from an omp session carries the Omp-Session trailer. Exit 0 adds it, exit 1 leaves it
# off; stdout says why. shims/git asks it for every commit it stamps (and its prepare-
# commit-msg hook, shims/git-hooks/, asks again for the repository it runs in), and
# shims/jj for every jj command that can write a description (`shims/AGENTS.md`).
#
# Every repository carries the trailer, public ones included: it is how a commit is
# traced to its session (session attribution, Legion's Delivery page, scripts/pr-gate,
# the chief of staff's audit), and upstream PRs are opened from commits that carry it
# (skill://fork-work). A checkout opts out with `git config omp.sessionTrailer false`.
set -euo pipefail

git=("$@")
case "$("${git[@]}" config --type=bool --get omp.sessionTrailer 2>/dev/null || true)" in
    false) echo "off: omp.sessionTrailer is false"; exit 1 ;;
    true) echo "on: omp.sessionTrailer is true" ;;
    *) echo "on: omp.sessionTrailer is unset" ;;
esac
exit 0
