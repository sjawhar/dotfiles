#!/usr/bin/env bash
# envoy-nats-seed: this machine's cached NATS nkey seed, which pi-envoy and the
# claude-envoy bridge authenticate to NATS with when the session's envoy.json
# names it as a natsSeed command. No launcher runs it.
#
#   envoy-nats-seed [SOURCE]            print the seed file's path, or nothing when there is none
#   envoy-nats-seed [SOURCE] --value    print the seed itself, or exit 1 naming why there is none
#   envoy-nats-seed [SOURCE] --refresh  fetch the seed now, whatever the cache holds
#
#   With no SOURCE the seed is production's `omp-session` seed in AWS. SOURCE names
#   a seed in GCP Secret Manager instead, in any order around the mode:
#   --gcp-secret SECRET --gcp-project PROJECT --gcloud-configuration NAME
#
# --value is for an envoy.json `"natsSeed": "!$HOME/.dotfiles/scripts/envoy-nats-seed --value"`
# entry (/bin/sh expands $HOME, so it needs no PATH): the client reads the command's
# stdout as the seed, so the value never sits in an environment or an argv. It
# caches and refreshes exactly as path mode does.
#
# The default seed lives in AWS Secrets Manager ($SECRET_ID), read with the
# default credential chain; a GCP source's lives in its secret, read with the
# login of the gcloud configuration it names. On a machine a seed lives only in
# one 0600 file per source under $XDG_RUNTIME_DIR/envoy, a tmpfs cleared at
# boot, beside that source's own miss marker and lock. It never enters an argv
# or an environment: aws writes it straight into a 0600 temp file beside the
# cache, and gcloud writes it there through --out-file; the temp file replaces
# the cache by rename once it holds a user nkey seed.
#
# The first call after boot fetches while its caller waits (one AWS or gcloud
# call, bounded by FETCH_TIMEOUT_S; a lock makes parallel calls share it). Every
# later call only stats the file. Once the file, or the last failed attempt,
# is older than REFRESH_S, a call starts one detached background refresh and
# carries on with what it has. A rotated seed therefore reaches sessions started
# within an hour of the rotation's first call, or at once after --refresh; a
# running session keeps the seed it connected with until it restarts.
#
# No secret, no credentials, no CLI: nothing is printed, and the one attempt
# that failed says why on one stderr line; its retries are silent and in
# the background, at most one per REFRESH_S. A failed refresh keeps the cached
# seed. Path mode then exits 0, --value exits 1.
set -uo pipefail

SECRET_ID="production/envoy/nats-nkey-seed-omp-session"
REGION="us-west-2"
REFRESH_S=3600
FETCH_TIMEOUT_S=5

say() { echo "envoy-nats-seed: $*" >&2; }

# The GCP source's flags come out of the arguments wherever they sit; what is
# left selects the mode exactly as it does with no source. Each value must be a
# name GCP allows, so a mode flag never stands in for a missing value, no name
# reaches outside $dir, and the `.` that joins project and secret in the
# cache's file name is in neither, so two sources never share a file.
gcp_refused() {
    say "a GCP source needs --gcp-secret SECRET, --gcp-project PROJECT and --gcloud-configuration NAME: $1"
    exit 2
}
declare -A gcp=()
source_args=() args=()
while (( $# )); do
    case "$1" in
        --gcp-secret|--gcp-project|--gcloud-configuration)
            (( $# >= 2 )) && [[ "$2" != -* ]] || gcp_refused "$1 has no value"
            [[ -z "${gcp[$1]+set}" ]] || gcp_refused "$1 is given twice"
            if [[ "$1" == --gcp-secret ]]; then re='^[A-Za-z0-9_][A-Za-z0-9_-]*$'; else re='^[a-z][a-z0-9-]*$'; fi
            [[ "$2" =~ $re ]] || gcp_refused "$1 '$2' is not a name GCP allows"
            gcp[$1]="$2"
            source_args+=("$1" "$2")
            shift 2
            ;;
        *) args+=("$1"); shift ;;
    esac
done
set -- "${args[@]}"
if (( ${#gcp[@]} )); then
    for flag in --gcp-secret --gcp-project --gcloud-configuration; do
        [[ -n "${gcp[$flag]+set}" ]] || gcp_refused "$flag is missing"
    done
fi
gcp_secret="${gcp[--gcp-secret]-}"
gcp_project="${gcp[--gcp-project]-}"
gcloud_config="${gcp[--gcloud-configuration]-}"

dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/envoy"
if [[ -n "$gcp_secret" ]]; then
    seed="$dir/nats-nkey-seed-gcp-$gcp_project.$gcp_secret"
    cli=gcloud provider=GCP secret_name="projects/$gcp_project/secrets/$gcp_secret"
else
    seed="$dir/nats-nkey-seed-omp-session"
    cli=aws provider=AWS secret_name="$SECRET_ID"
fi
# The last failed attempt: its mtime says when, its content why.
miss="$seed.miss"
lock="$seed.lock"

usable() { [[ -s "$seed" && -O "$seed" ]]; }
older_than_refresh() { (( $(date +%s) - $(stat -c %Y "$1" 2>/dev/null || echo 0) >= REFRESH_S )); }
recent_miss() { [[ -e "$miss" ]] && ! older_than_refresh "$miss"; }
# The lock on fd 9, flock's own arguments passed through; quiet when it cannot be had.
take_lock() { exec 9>>"$lock" && flock "$@" 9; } 2>/dev/null
# The first of the tools the locked paths need that this machine lacks.
missing_tool() {
    local t
    for t in flock timeout setsid; do
        command -v "$t" >/dev/null 2>&1 || { echo "$t"; return 0; }
    done
    return 1
}

# Records a failed attempt in the miss marker; `loud` also says why.
record_miss() {
    local loud="$1" reason="$2"
    { printf '%s\n' "$reason" >"$miss"; } 2>/dev/null
    [[ "$loud" == loud ]] || return 0
    if usable; then
        say "could not refresh the NATS credential ($reason); keeping the cached one"
    else
        say "no NATS credential ($reason); retried hourly in the background"
    fi
}

# Runs the source's CLI, which writes the seed into the file $1 and nowhere
# else; the CLI's stderr is left to the caller. -k: a CLI that ignores TERM
# still cannot hold the first call past the timeout.
fetch_into() {
    if [[ -n "$gcp_secret" ]]; then
        # The named configuration's login, never a selection the calling shell
        # made: shims/gcloud refuses a GCLOUD_ACCOUNT naming no configuration
        # before gcloud runs, and CLOUDSDK_CORE_ACCOUNT outranks a
        # configuration's own account. Either would record a miss for every
        # caller on the machine. stdout is dropped and stdin closed, so no
        # prompt can wait on a caller's terminal.
        env -u GCLOUD_ACCOUNT -u CLOUDSDK_ACTIVE_CONFIG_NAME -u CLOUDSDK_CORE_ACCOUNT \
            timeout -k 2 "$FETCH_TIMEOUT_S" gcloud --configuration "$gcloud_config" \
            secrets versions access latest --secret "$gcp_secret" --project "$gcp_project" \
            --out-file "$1" >/dev/null </dev/null
    else
        # The default credential chain (a devbox's instance role), never a profile
        # the calling shell selected: one shell's staging profile would otherwise
        # record a miss for every caller on the machine.
        env -u AWS_PROFILE -u AWS_DEFAULT_PROFILE timeout -k 2 "$FETCH_TIMEOUT_S" \
            aws secretsmanager get-secret-value --region "$REGION" \
            --secret-id "$SECRET_ID" --query SecretString --output text >"$1"
    fi
}

# The line of a failed fetch's output that says why: the last non-blank one, or
# gcloud's last ERROR: line, since gcloud also prints notices (its update
# notice among them) on stderr.
why() {
    local line=""
    [[ -n "$gcp_secret" ]] && line="$(grep '^ERROR:' <<<"$1" | tail -1)"
    [[ -n "$line" ]] || line="$(grep -v '^[[:space:]]*$' <<<"$1" | tail -1)"
    cut -c1-240 <<<"$line"
}

# One attempt. On failure the cache is left as it was and the miss marker
# records the reason.
fetch() {
    local loud="$1" tmp err reason
    if ! tmp="$(mktemp "$seed.XXXXXX" 2>/dev/null)"; then
        record_miss "$loud" "cannot create a file in $dir"
        return 1
    fi
    if ! command -v "$cli" >/dev/null 2>&1; then
        reason="the $cli CLI is not installed"
    elif err="$(fetch_into "$tmp" 2>&1)"; then
        # The readers trim the file (legion #1471), so a stored value with
        # surrounding whitespace is accepted and cached trimmed.
        if [[ "$(grep -cv '^[[:space:]]*$' "$tmp")" -eq 1 ]] \
            && grep -xE '[[:space:]]*SU[A-Z2-7]{56}[[:space:]]*' "$tmp" | tr -d '[:space:]' >"$tmp.v" \
            && [[ -s "$tmp.v" ]]; then
            mv -f "$tmp.v" "$seed"
            rm -f "$tmp" "$miss"
            return 0
        fi
        reason="$secret_name does not hold a user nkey seed"
    else
        case $? in
            124|137) reason="$provider did not answer within ${FETCH_TIMEOUT_S}s" ;;
            *) reason="$(why "$err")" ;;
        esac
    fi
    rm -f "$tmp" "$tmp.v"
    record_miss "$loud" "$reason"
    return 1
}

# The re-exec keeps the source, so it refreshes this cache and no other.
refresh_in_background() {
    setsid "${BASH_SOURCE[0]}" "${source_args[@]}" --background </dev/null >/dev/null 2>&1 &
}

umask 077
# No usable per-boot directory (none on this machine, or not ours): no cache,
# no miss marker to rate-limit a message with, so say nothing.
if ! mkdir -p "$dir" 2>/dev/null || ! [[ -O "$dir" && -w "$dir" ]]; then
    [[ "${1:-}" == --refresh || "${1:-}" == --value ]] && { say "cannot use $dir"; exit 1; }
    exit 0
fi

# Path mode prints the seed file's path; --value prints the seed. With no seed,
# path mode exits 0 and --value exits 1.
value=0
emit() { if (( value )); then cat "$seed"; else echo "$seed"; fi; }
none() { if (( value )); then say "no NATS credential: ${1:-none cached and no fetch possible}"; exit 1; fi; exit 0; }

case "${1:-}" in
    "") ;;
    --value) value=1 ;;
    --refresh)
        if t="$(missing_tool)"; then say "$t is not installed"; exit 1; fi
        take_lock -w $((FETCH_TIMEOUT_S + 5)) || { say "cannot take $lock"; exit 1; }
        fetch loud || exit 1
        echo "$seed"
        exit 0
        ;;
    --background)
        if t="$(missing_tool)"; then record_miss quiet "$t is not installed"; exit 0; fi
        take_lock -n || exit 0
        # Another refresh may have finished while this one was starting.
        if usable && ! older_than_refresh "$seed"; then exit 0; fi
        recent_miss && exit 0
        fetch quiet
        exit 0
        ;;
    *) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
esac

if usable; then
    emit
    if older_than_refresh "$seed" && ! recent_miss; then refresh_in_background; fi
    exit 0
fi
if [[ -e "$miss" ]]; then
    # An attempt already failed this boot; the caller gets no seed without waiting.
    recent_miss || refresh_in_background
    none "$(cat "$miss" 2>/dev/null)"
fi
# The first call this boot: fetch now, so this caller gets the seed.
if t="$(missing_tool)"; then record_miss loud "$t is not installed"; none "$t is not installed"; fi
take_lock -w $((FETCH_TIMEOUT_S + 5)) || none "cannot take $lock"
# A parallel call may have fetched, or failed, while this one waited.
if usable; then emit; exit 0; fi
[[ -e "$miss" ]] && none "$(cat "$miss" 2>/dev/null)"
fetch loud && { emit; exit 0; }
none "$(cat "$miss" 2>/dev/null)"
