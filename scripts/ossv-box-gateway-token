#!/usr/bin/env bash
# ossv-box-gateway-token writes an OIDC ID token of the box's own identity for Oh My Pi's
# model-gateway provider. The timer runs it every ten minutes, so the token file stays newer than
# the token's one-hour lifetime.
#
# No box mints as another account:
#   - a box in Google Cloud reads the ID token of the account its VM runs as from the metadata
#     server, which issues one for any audience and needs no IAM role.
#   - an Azure box, whose ADC is an external_account credential through the azure/entra pool,
#     mints the ID token of the account that credential names in service_account_impersonation_url,
#     with the federated access token its own managed-identity token buys at Google STS. That
#     principal already holds roles/iam.workloadIdentityUser on the account (agent-infra
#     box-identity/), which carries iam.serviceAccounts.getOpenIdToken, the permission
#     generateIdToken checks.
set -euo pipefail

# The systemd user unit has no login PATH; jq and curl come from the system or mise.
export PATH="$HOME/.dotfiles/shims:$HOME/.dotfiles/bin:$PATH"

audience=model-gateway-gce
cred=${GOOGLE_APPLICATION_CREDENTIALS:-$HOME/.config/gcloud/application_default_credentials.json}
metadata=${OSSV_GCE_METADATA_HOST:-metadata.google.internal}
d="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/ossv-box"
f="$d/gateway-token"


fail() {
    rm -f "$f.new"
    logger -t ossv-box-gateway-token -- "$1"
    echo "ossv-box-gateway-token: $1" >&2
    exit 1
}

# bearer prints a curl config line that carries a token, so no token reaches a command line.
bearer() { printf 'header = "Authorization: Bearer %s"\n' "$1"; }

# federated_token prints the box's federated access token from an external_account credential.
federated_token() {
    local url field token_url sts_audience subject_type subject
    local -a headers=()
    url=$(jq -er '.credential_source.url' "$cred") || fail "$cred has no credential_source.url"
    field=$(jq -er '.credential_source.format.subject_token_field_name' "$cred") || fail "$cred names no subject token field"
    token_url=$(jq -er '.token_url' "$cred")
    sts_audience=$(jq -er '.audience' "$cred")
    subject_type=$(jq -er '.subject_token_type' "$cred")
    while IFS= read -r h; do headers+=(-H "$h"); done < <(jq -r '.credential_source.headers // {} | to_entries[] | "\(.key): \(.value)"' "$cred")
    subject=$(curl -fsS -m 10 "${headers[@]}" "$url" | jq -er --arg f "$field" '.[$f]') || fail "no subject token from $url"
    printf %s "$subject" | curl -fsS -m 20 "$token_url" \
        --data-urlencode 'grant_type=urn:ietf:params:oauth:grant-type:token-exchange' \
        --data-urlencode "audience=$sts_audience" \
        --data-urlencode 'scope=https://www.googleapis.com/auth/cloud-platform' \
        --data-urlencode 'requested_token_type=urn:ietf:params:oauth:token-type:access_token' \
        --data-urlencode "subject_token_type=$subject_type" \
        --data-urlencode 'subject_token@-' | jq -er '.access_token'
}

# gce_identity_token prints the ID token of the account the VM runs as, straight from the metadata
# server: it issues one for any audience, and the VM needs no IAM role for its own identity.
gce_identity_token() {
    curl -fsS -m 10 -H 'Metadata-Flavor: Google' \
        "http://$metadata/computeMetadata/v1/instance/service-accounts/default/identity?audience=$audience&format=full"
}

# federated_identity_token prints the ID token of the account an external_account credential names,
# minted with the box's own federated access token.
federated_identity_token() {
    local target access
    target=$(jq -er '.service_account_impersonation_url' "$cred" |
        sed -n 's#.*/serviceAccounts/\([^:]*\):.*#\1#p') ||
        fail "$cred names no service account"
    [[ -n $target ]] || fail "$cred names no service account"
    access=$(federated_token) || fail "no federated access token from $cred"
    curl -fsS -m 20 -K <(bearer "$access") -H 'Content-Type: application/json' \
        -d "{\"audience\":\"$audience\",\"includeEmail\":true}" \
        "https://iamcredentials.googleapis.com/v1/projects/-/serviceAccounts/$target:generateIdToken" |
        jq -er '.token'
}

install -d -m 700 "$d"
if [[ -r $cred ]] && [[ $(jq -r '.type' "$cred") == external_account ]]; then
    token=$(federated_identity_token | tr -d '\r\n') || token=""
else
    token=$(gce_identity_token | tr -d '\r\n') || token=""
fi

case "$token" in
    *.*.*)
        umask 077
        printf %s "$token" > "$f.new"
        mv -f "$f.new" "$f"
        logger -t ossv-box-gateway-token -- "identity token written to $f"
        ;;
    *)
        fail "no identity token for this box's own account"
        ;;
esac
