#!/usr/bin/env bash
# legion-brief-watch: whether the warn-first window of the human brief on Legion READY packets can
# close, read from Dispatch alone (nothing from GitHub).
#
#   legion-brief-watch --project <KEY> --release-time <RFC3339> [--dry-run]
#   legion-brief-watch --whoami
#
# A READY packet is a message.created whose body starts `READY #`, and it counts when it was posted
# after --release-time (the brief's merge). A packet is warned when it carries
# `Warning: brief-missing`, or the merger's no-brief placeholder `Outcome: (the pull request body
# carries no brief)` (either alone is enough), or when the line right after its READY header is not
# an `Outcome:` line, the mark of a merger that never saw the brief.
# When the newest LEGION_BRIEF_WATCH_MIN (5) counted packets are none of them warned, it sends one
# notice to Envoy role LEGION_BRIEF_WATCH_ROLE (agentc-1305) with `scripts/envoy notify`, records
# it in LEGION_BRIEF_WATCH_STATE (~/.omp/agent/legion-brief-watch.json) so it goes out once, and
# exits 1, so the daily user timer installers/legion-brief-watch.sh arms shows `failed` and its
# journal holds the notice. Otherwise it prints one line and exits 0. --dry-run
# prints the notice instead of sending it. Exit 2: a bad argument, no Dispatch URL or token, a
# failed Dispatch read, or a notice Envoy did not take. --whoami prints who Dispatch takes the
# resolved token for, and exits 0.
#
# The URL and token resolve as resolveDispatchConfig does for every agent session (Legion
# packages/envoy-client/src/dispatch-config.ts): DISPATCH_URL, else dispatch.serverUrl of
# ENVOY_CONFIG (~/.config/opencode/envoy.json) when its dispatch.enabled is true; DISPATCH_TOKEN_FILE
# (never a fallback past it), else DISPATCH_TOKEN when set, else dispatch.token. Unlike the library,
# an enabled file with no serverUrl is an error, not localhost: a timer talking to a local port
# would count nothing and say nothing.
set -euo pipefail
shopt -s inherit_errexit
# Every file the watch writes, the bearer's header file first, is private to this user.
umask 077

# The checkout this script is in, as installers/lib.sh finds its own, so a hand run from a workspace
# sends through that workspace's scripts/envoy.
DOTFILES_DIR="${DOTFILES_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
ENVOY_CONFIG="${ENVOY_CONFIG:-$HOME/.config/opencode/envoy.json}"
STATE="${LEGION_BRIEF_WATCH_STATE:-$HOME/.omp/agent/legion-brief-watch.json}"
ROLE="${LEGION_BRIEF_WATCH_ROLE:-agentc-1305}"
MIN="${LEGION_BRIEF_WATCH_MIN:-5}"
PROJECT=""
RELEASE=""
DRY_RUN=false
WHOAMI=false

fail() { echo "legion-brief-watch: $*" >&2; exit 2; }
need_value() { (($# >= 2)) || fail "$1 needs a value"; }

while (($#)); do
    case "$1" in
        --project) need_value "$@"; PROJECT="$2"; shift 2 ;;
        --release-time) need_value "$@"; RELEASE="$2"; shift 2 ;;
        --dry-run) DRY_RUN=true; shift ;;
        --whoami) WHOAMI=true; shift ;;
        -h|--help) awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"; exit 0 ;;
        *) fail "unknown argument $1" ;;
    esac
done

# envoy_config JQ prints JQ over ENVOY_CONFIG, or over {} when there is no such file.
envoy_config() {
    [[ -e "$ENVOY_CONFIG" ]] || { jq -rn "{} | $1"; return; }
    jq -r "$1" "$ENVOY_CONFIG" 2>/dev/null || fail "$ENVOY_CONFIG is not a readable envoy.json"
}

# resolve_dispatch_config sets URL and writes the bearer to HEADER, a file in the WORK directory
# the EXIT trap removes: the bearer reaches curl only through that file, never an argv /proc shows.
resolve_dispatch_config() {
    local token
    if [[ -n "${DISPATCH_TOKEN_FILE+x}" ]]; then
        token=$(cat -- "$DISPATCH_TOKEN_FILE" 2>/dev/null) \
            || fail "DISPATCH_TOKEN_FILE names $DISPATCH_TOKEN_FILE, which could not be read"
        token="${token#"${token%%[![:space:]]*}"}"
        token="${token%"${token##*[![:space:]]}"}"
        [[ -n "$token" ]] || fail "DISPATCH_TOKEN_FILE names $DISPATCH_TOKEN_FILE, which is empty"
    elif [[ -n "${DISPATCH_TOKEN+x}" ]]; then
        token="$DISPATCH_TOKEN"
        [[ -n "$token" ]] || fail "DISPATCH_TOKEN must be a non-empty bearer token"
    else
        token=$(envoy_config '.dispatch.token // empty')
        [[ -n "$token" ]] || fail "no Dispatch token: DISPATCH_TOKEN_FILE and DISPATCH_TOKEN are unset and $ENVOY_CONFIG has no dispatch.token"
    fi
    if [[ -n "${DISPATCH_URL+x}" ]]; then
        URL="$DISPATCH_URL"
        [[ -n "$URL" ]] || fail "DISPATCH_URL must be a valid URL"
    elif [[ "$(envoy_config '.dispatch.enabled == true')" == true ]]; then
        URL=$(envoy_config '.dispatch.serverUrl // empty')
        [[ -n "$URL" ]] || fail "$ENVOY_CONFIG enables dispatch but sets no dispatch.serverUrl, and DISPATCH_URL is unset"
    else
        fail "no Dispatch URL: DISPATCH_URL is unset and $ENVOY_CONFIG does not enable dispatch.serverUrl (dispatch.enabled is not true)"
    fi
    while [[ "$URL" == */ ]]; do URL="${URL%/}"; done
    WORK=$(mktemp -d)
    trap 'rm -rf "$WORK"' EXIT
    HEADER="$WORK/header"
    printf 'Authorization: Bearer %s\n' "$token" >"$HEADER"
}

dispatch_get() {
    local out
    out=$(curl -sS --fail-with-body --max-time 30 -H "@$HEADER" "$URL/api/v1/$1" 2>&1) \
        || fail "Dispatch at $URL failed GET /api/v1/$1: $out"
    printf '%s\n' "$out"
}

if $WHOAMI; then
    resolve_dispatch_config
    dispatch_get whoami
    exit 0
fi

# Every instant goes through one parser: Dispatch writes Go's RFC 3339 with nanoseconds and may
# write an offset, so neither text order nor jq's own fromdateiso8601 compares them correctly.
# installers/legion-brief-watch.sh checks the unit's --release-time against this same grammar.
# shellcheck disable=SC2016 # a jq program: its $ are jq's
EPOCH='def epoch: . as $t
    | (capture("^(?<s>[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2})(?<f>[.][0-9]+)?(?<z>Z|[+-][0-9]{2}:[0-9]{2})$")
       // error("not an RFC 3339 instant: \($t)"))
    | (.s + "Z" | fromdateiso8601) + ("0\(.f // "")" | tonumber)
      - (if .z == "Z" then 0
         else (if .z[0:1] == "-" then -1 else 1 end) * ((.z[1:3] | tonumber) * 3600 + (.z[4:6] | tonumber) * 60)
         end);'

[[ "$PROJECT" =~ ^[A-Za-z0-9_-]+$ ]] || fail "--project <KEY> is required (a Dispatch project key)"
release_epoch=$(jq -n --arg t "$RELEASE" "$EPOCH"' $t | epoch' 2>/dev/null) \
    || fail "--release-time <RFC3339> is required, as the brief's merge instant (e.g. 2026-10-01T12:00:00Z); got '${RELEASE}'"
[[ "$MIN" =~ ^[1-9][0-9]*$ ]] || fail "LEGION_BRIEF_WATCH_MIN must be a positive whole number"

if ! $DRY_RUN && [[ -e "$STATE" ]]; then
    sent=$(jq -r '.goNoticeSentAt // empty' "$STATE") || fail "$STATE is not valid JSON"
    if [[ -n "$sent" ]]; then
        echo "legion-brief-watch: the go-notice already went out at $sent ($STATE); nothing to do"
        exit 0
    fi
fi

resolve_dispatch_config

# Dispatch advances an issue's updated_at with every event on it, so an issue holding a packet
# posted after the release was updated after it.
issues=$(dispatch_get "issues?project=$PROJECT&updated_since=$(date -u -d "@${release_epoch%.*}" +%Y-%m-%dT%H:%M:%SZ)")

# Every page of every listed issue, fetched by one curl over one connection. An issue's events are
# numbered 1..last_seq, so its pages start after 0, 200, … below last_seq (Dispatch's limit is 200).
# The listing's two fields are checked before either reaches the curl config.
mkdir "$WORK/pages"
jq -r --arg url "$URL" --arg dir "$WORK/pages" '.[]
    | if (.key | type) == "string" and (.last_seq | type) == "number" and (.last_seq | . >= 1 and . == floor)
      then . else error("an issue listed as \(.)") end
    | (.key | @uri) as $k | range(0; .last_seq; 200)
    | "url = \"\($url)/api/v1/issues/\($k)/events?after=\(.)&limit=200\"\noutput = \"\($dir)/\($k)-\(.).json\""' \
    <<<"$issues" >"$WORK/pages.curlrc" || fail "Dispatch answered GET /api/v1/issues with no issue list"
if [[ -s "$WORK/pages.curlrc" ]]; then
    out=$(curl -sS --fail-early --fail-with-body --max-time 30 -H "@$HEADER" -K "$WORK/pages.curlrc" 2>&1) \
        || fail "Dispatch at $URL failed an issue event page: $out"
fi

shopt -s nullglob
summary=$(jq -n -r --argjson release "$release_epoch" --argjson min "$MIN" "$EPOCH"'
    def has_outcome: .body | test("^READY #[^\n]*\nOutcome: ");
    def warned: (.body | contains("Warning: brief-missing") or contains("(the pull request body carries no brief)"))
        or (has_outcome | not);
    [inputs[] | select(.type == "message.created" and (.payload.body | startswith("READY #")))
     | {at: (.created_at | epoch), body: .payload.body} | select(.at > $release)]
    | sort_by(.at) as $all
    | $all[-$min:] as $newest
    | [($all | length), ([$all[] | select(has_outcome)] | length),
       ([$all[] | select(warned)] | length), ($newest | length), ([$newest[] | select(warned)] | length)]
    | @tsv' "$WORK"/pages/*.json </dev/null) || fail "could not read the event pages Dispatch returned"
read -r n with_outcome warned newest newest_warned <<<"$summary"

if (( newest < MIN || newest_warned > 0 )); then
    echo "legion-brief-watch: $n READY packets on $PROJECT posted after $RELEASE ($with_outcome with Outcome, $warned warned); the newest $newest carry $newest_warned warned, and the go-notice needs the newest $MIN with none"
    exit 0
fi

msg="legion-brief-watch (systemd timer on ${HOSTNAME:-$(hostname)}): the newest $MIN READY packets on $PROJECT posted after $RELEASE each carry an Outcome line and no brief-missing warning ($n such packets in all, $warned warned). The warn-first window can close: open the flip PR (AGENTC-1305's brief child issue, plan Task A5 step 3)."
echo "$msg"
if $DRY_RUN; then
    echo "legion-brief-watch: dry run; not sent, not recorded"
    exit 1
fi

# The record is written before the send, so a notice that went out cannot fail to be recorded;
# only the rename, within one directory, follows it.
mkdir -p "$(dirname "$STATE")" || fail "cannot create $(dirname "$STATE") to record the go-notice; it is not sent"
jq -n --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '{goNoticeSentAt: $at}' >"$STATE.tmp" \
    || fail "cannot write $STATE.tmp to record the go-notice; it is not sent"
"$DOTFILES_DIR/scripts/envoy" notify "notifications.role.$ROLE" "$msg" \
    || { rm -f "$STATE.tmp"; fail "Envoy did not take the go-notice; it is not recorded, so the next run sends it again"; }
mv "$STATE.tmp" "$STATE"
exit 1
