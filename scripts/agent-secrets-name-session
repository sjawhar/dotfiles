#!/usr/bin/env bash
# agent-secrets-name-session: a Claude Code session names itself to the agent-secrets helper
# (dispatch://INFRA-3848), so a restart of the helper keeps the session's broker identity and its
# grants. omp sessions do the same in omp/extensions/session-env.ts.
#
# Claude Code runs it as an async SessionStart hook (.claude/settings.json) with the hook's JSON
# on stdin, whose session_id is the session's own. The hook is registered for the sources startup,
# resume and clear and not compact, so it runs once for each session id in a process, and
# SessionStart does not fire for a subagent. scripts/cld registers the session with the helper
# before claude has an id (scripts/agent-session, through scripts/agent-secrets-session), so the
# launcher names none; the helper takes the name here, from inside the session, finding the
# session's root from the caller's pid.
#
# It registers only after `agent-secrets identity` exits 0, which on a host means the caller is
# inside a session the helper registered. Outside one the register can only go wrong: since
# cybermonklabs/legion#4151 a register without --exec attaches the nearest omp above the caller.
# As a rule no omp is above a Claude hook, so the helper would refuse it (NOT_A_SESSION) at every
# start of a claude that scripts/cld did not launch; where one is (claude run from an omp
# session's shell), that omp is another session, which this id must not name.
#
# A claude process names one id: the first the helper takes. `/clear` gives the same process a new
# id and runs this hook again, and the helper refuses a session it has named another id. So the
# hook first reads `agent-secrets-helper sessions`, which lists each live session's root pid and
# runtime id (`session-<id>` once a register has named it), finds the nearest root above itself,
# the same rule the helper uses, and does nothing when that session is named already. The
# process's broker identity, with the requests and grants bound to it, stays under that first id
# for as long as the process runs. `agent-secrets self --json` and `identity --source` do not say
# whether the session has a name; the list does. A list that cannot be read, or that names no
# root above the hook, is no evidence of a name, so the hook registers then.
#
# It does nothing in an agent box (AGENTBOX_BOX: the box's launcher names its session), with no
# helper socket, or with no session id. Claude owns the background process and its output, so
# neither a helper call nor an open output pipe delays session start. Keep that parent link: an
# orphaned worker loses the session ancestry the helper and the hook's walk need. Success prints
# nothing; a refusal writes one line on stderr for Claude to collect when the hook finishes. The
# script always exits 0.
set -uo pipefail

[[ -n "${AGENTBOX_BOX:-}" ]] && exit 0
sock="${AGENT_SECRETS_HELPER_SOCK:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/agent-secrets/helper.sock}"
[[ -S "$sock" ]] || exit 0
id="$(jq -r '.session_id // empty' 2>/dev/null)" || exit 0
[[ -n "$id" ]] || exit 0
export AGENT_SECRETS_HELPER_SOCK="$sock"

# Each call is bounded: identity asks the helper once with a 2 s deadline of its own, sessions
# with 5 s, and register redials a helper that is starting for up to 10 s.
timeout 10 agent-secrets identity >/dev/null 2>&1 || exit 0
if rows="$(timeout 10 agent-secrets-helper sessions 2>/dev/null)"; then
    declare -A runtime_of=()
    while IFS=$'\t' read -r root runtime _; do
        [[ -n "$root" ]] && runtime_of[$root]="$runtime"
    done <<<"$rows"
    pid=$$
    for _ in {1..64}; do
        if [[ -n "${runtime_of[$pid]:-}" ]]; then
            [[ "${runtime_of[$pid]}" == session-* ]] && exit 0
            break
        fi
        { stat="$(</proc/"$pid"/stat)"; } 2>/dev/null || break
        read -r _ pid _ <<<"${stat##*) }"
        ((pid > 1)) || break
    done
fi
if ! why="$(timeout 10 agent-secrets register --session-id "$id" 2>&1 >/dev/null)"; then
    echo "agent-secrets-name-session: agent-secrets register --session-id $id failed, so a helper restart ends this session's broker identity: ${why##*$'\n'}" >&2
fi
exit 0
