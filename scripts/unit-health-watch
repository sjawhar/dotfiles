    / "stream-jobs"
)

# RUN NEVER ENDS opened 13 times in a replay of this box's user journal (2026-11-01 10:50Z to
# 11-03 03:34Z) at the old two-period floor, and every one of those runs ended by itself:
# transcript-import (every 10 min, floor 22 min) ran 32-45 min, omp-transcript-offload (15 min,
# 33 min) 36-40 min, a repository mirror (5 min, 15 min) 20-41 min, agent-files-archive (20 min,
# 43 min) 69 and 88 min. The limit is twice the unit's own p99 run time when that is longer,
# from the completed runs of the last two days (kept an hour in the state file), and for a
# oneshot never past TimeoutStartSec + TimeoutStopSec. Twice the p95 left 12 of the 13 (the p95
# of the runs before each one was 8-19 min); twice the p99 leaves 5, each a run past twice the
# p99 of that unit's runs before it. Only a unit already running past its earliest limit needs
# the history, so most passes read nothing more.
RUN_TIME_LOOKBACK = 2 * 86400.0
RUN_TIME_REFRESH = 3600.0
# Every message fits one Envoy notice; the detail goes to a report file kept a week.
MESSAGE_LIMIT = 600
REPORT_KEEP = 7 * 86400.0

# A session nobody will bring back. Since 2026-11-04 nothing on this machine or on
# sami-rocqperf restarts a crashed agent session: omp-memory-watch, which did it as a side
# duty, was stopped on Sami's word (17:10:29Z), and devbox-offbox-watch is stopped after its
# liveness check made four duplicate sessions that night. The SRE chose a gap over an automatic
# resume ("a gap is the cheaper failure") and asked for this instead: a report, every pass, of
# each session that WOULD have been restarted and now will not be.
#
# THIS NEVER STARTS ANYTHING. It reads and it tells one person.
#
# A session is dead when all three hold:
#   - the restart registry has an entry for it saying auto_restart=yes;
#   - no process holds its transcript open. `sudo -n fuser` is the test, run on the host, where
#     it sees the holders inside agent boxes too (proved 2026-11-04 21:52Z on 01a1a292,
#     01a1a688 and 01a170e0). A fuser that cannot run at all decides nothing: no session is
#     called dead on a failed test;
#   - its transcript has not been written for DEAD_SESSION_SILENCE. A live session writes a
#     line per tool call; fifteen minutes of nothing, with no process holding the file, is a
#     session that ended rather than one that is thinking.
# Each newly dead id is said once. An id that comes back -- held again, or written again --
# clears, so a later death of the same id is said again.
DEAD_SESSION_SILENCE = 900.0
DEFAULT_RESTART_REGISTRY = Path("/mnt/durable/sami/restart-registry/sessions")
# The planned-reboot flag: while this file exists, dead sessions are counted and logged and
# nobody is told. It sits beside the registry, where whoever runs the window is already
# working, and it is a file rather than a time window so that forgetting to remove it is
# visible in every run's log line.
DEFAULT_REBOOT_WINDOW = Path("/mnt/durable/sami/restart-registry/reboot-window")
# Where omp keeps this machine's transcripts, one directory per working tree. Only 12 of the
# 78 registry entries name a `.jsonl` in their resume line, so the id in a transcript's file
# name is what finds the other 66.
DEFAULT_TRANSCRIPTS = Path.home() / ".omp/agent/sessions"
# Who hears a notice no entry routes: the SRE session, by id and not by role. The box-health
# role may itself be held by one of the dead, and this is the one message that must not go to
# a dead reader.
DEAD_SESSION_TARGET = SRE


def log(message: str) -> None:
    stamp = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    print(f"{stamp} {message}", flush=True)


def iso(epoch: float | None) -> str:
    if not epoch:
        return "never"
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(epoch))


def human_time(seconds: float | None) -> str:
    if seconds is None:
        return "-"
    seconds = max(0.0, float(seconds))
    if seconds < 90:
        return f"{seconds:.0f}s"
    if seconds < 5400:
        return f"{seconds / 60:.0f}min"
    if seconds < 172800:
        return f"{seconds / 3600:.1f}h"
    return f"{seconds / 86400:.1f}d"


# ------------------------------------------------------------------------------- Envoy


class Envoy:
    """The listener this machine's sessions use, resolved the way scripts/envoy resolves it."""

    def __init__(self, timeout: float = 8.0) -> None:
        path = os.environ.get("ENVOY_CONFIG_FILE") or str(
            Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config")))
            / "legion/envoy.json"
        )
        try:
            config = json.loads(Path(path).read_text()).get("envoy") or {}
        except (OSError, ValueError):
            config = {}
        if config.get("enabled") is False:
            raise SystemExit(f"{path} sets envoy.enabled to false: Envoy is off")
        self.url = (
            os.environ.get("ENVOY_URL") or config.get("url") or DEFAULT_ENVOY_URL
        ).rstrip("/")
        self.timeout = timeout
        token = os.environ.get("ENVOY_TOKEN") or config.get("token") or ""
        if token.startswith("!"):
            try:
                done = subprocess.run(
                    ["/bin/sh", "-c", token[1:]],
                    capture_output=True,
                    check=False,
                    text=True,
                    timeout=10,
                    stdin=subprocess.DEVNULL,
                )
                token = done.stdout.strip() if done.returncode == 0 else ""
            except (OSError, subprocess.SubprocessError):
                token = ""
        self.token = token

    def request(
        self, method: str, path: str, body: dict | None = None
    ) -> tuple[int, dict | list]:
        data = json.dumps(body).encode() if body is not None else None
        request = urllib.request.Request(self.url + path, data=data, method=method)
        if data is not None:
            request.add_header("Content-Type", "application/json")
        if self.token:
            request.add_header("Authorization", f"Bearer {self.token}")
        try:
            with urllib.request.urlopen(request, timeout=self.timeout) as answer:
                raw = answer.read().decode() or "{}"
                return answer.status, json.loads(raw)
        except urllib.error.HTTPError as error:
            raw = error.read().decode() or "{}"
            try:
                return error.code, json.loads(raw)
            except ValueError:
                return error.code, {"error": raw.strip()}
        except (TimeoutError, urllib.error.URLError, ValueError, OSError) as error:
            return 0, {"error": str(error)}

    def send(self, session_id: str, message: str) -> bool:
        status, body = self.request(
            "POST",
            "/v1/messages/send",
            {"target_session": session_id, "message": message, "source": "envoy"},
        )
        if status != 200:
            log(f"  send to {session_id} failed: {status} {body}")
        return status == 200

    def publish(self, topic: str, message: str) -> bool:
        status, body = self.request(
            "POST",
            "/v1/messages/publish",
            {"topic": topic, "message": message, "source": "envoy"},
        )
        if status != 200:
            log(f"  publish to {topic} failed: {status} {body}")
        return status == 200


def box_health_owner() -> str:
    """The session id BOX_HEALTH_OWNER names, or "" for the role-then-SRE default.

    An unusable value is refused at start, not at the first alert: a watch that drops its
    alerts quietly is the failure this watch exists to catch.
    """
    owner = (os.environ.get("BOX_HEALTH_OWNER") or "").strip()
    if owner and not OWNER_RE.fullmatch(owner):
        raise SystemExit(
            f"BOX_HEALTH_OWNER={owner!r} is not an omp session id"
            " (01xxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx); unset it for the box-health role"
        )
    return owner


def tell_box_health(envoy: Envoy, text: str) -> str:
    """Tell this box's health owner, and say who heard it ("" when every route refused)."""
    owner = box_health_owner()
    if owner:
        return owner if envoy.send(owner, text) else ""
    if envoy.publish(BOX_HEALTH_ROLE_TOPIC, text):
        return BOX_HEALTH_ROLE_TOPIC
    if envoy.send(SRE, text):
        return SRE
    return ""


# ------------------------------------------------------------- sessions nobody will restart


def registry_entries(directory: Path) -> list[dict]:
    """Every `<id>.entry` in the restart registry, as its `key=value` lines.

    A value runs to the end of its line (the `resume` and `after` lines hold spaces and `=`),
    and a line that is not `key=value` is skipped rather than guessed at. An unreadable entry
    is skipped with its error, because one bad file must not hide the other 77.
    """
    entries = []
    try:
        paths = sorted(directory.glob("*.entry"))
    except OSError as error:
        log(f"restart registry {directory} cannot be listed: {error}")
        return entries
    for path in paths:
        try:
            text = path.read_text(encoding="utf-8", errors="replace")
        except OSError as error:
            log(f"restart registry entry {path.name} cannot be read: {error}")
            continue
        fields = {"path": str(path), "session": path.stem}
        for line in text.splitlines():
            key, sep, value = line.partition("=")
            if sep and key.strip() and " " not in key.strip():
                fields.setdefault(key.strip(), value)
        entries.append(fields)
    return entries


_RESUME_TRANSCRIPT = re.compile(r"--resume\s+(\S+\.jsonl)")


def transcript_index(root: Path) -> dict[str, str]:
    """Every omp transcript on this machine, by the session id in its name.

    omp names a transcript `<timestamp>_<session id>.jsonl` under one directory per working
    tree. Only 12 of this box's 78 registry entries name a `.jsonl` in their resume line -- 66
    resume through `agentbox new … -- omp` and carry none -- so the id is what finds the rest:
    this index resolved 73 of the 78 on 2026-11-04. It costs one scandir per tree, 0.01 s for
    976 trees and 2,139 transcripts, which is why it is built once a pass rather than globbed
    per session. Where a session has several, the newest name wins.
    """
    index: dict[str, str] = {}
    try:
        trees = [entry.path for entry in os.scandir(root) if entry.is_dir()]
    except OSError as error:
        log(f"transcripts under {root} cannot be listed: {error}")
        return index
    for tree in trees:
        try:
            for entry in os.scandir(tree):
                name = entry.name
                if not name.endswith(".jsonl") or "_" not in name:
                    continue
                session = name[: -len(".jsonl")].split("_", 1)[1]
                kept = index.get(session)
                if kept is None or name > os.path.basename(kept):
                    index[session] = entry.path
        except OSError:
            continue
    return index


def entry_transcript(entry: dict, index: dict[str, str] | None = None) -> str:
    """The transcript this session writes: the one its resume command names, else the one
    whose file name carries its id."""
    match = _RESUME_TRANSCRIPT.search(entry.get("resume", ""))
    if match:
        return match.group(1)
    return (index or {}).get(entry.get("session", ""), "")


# One scan for every session, not one call each. `fuser` walks every process's descriptors, so it
# costs the same whether it is asked about one file or a hundred: on 2026-11-05 this box ran 11,205
# processes in 75 agent boxes and one `sudo -n fuser` took 8.4 s, so the 100-entry registry cost
# about 840 s against this unit's 180 s limit. The watch was killed on every run from then on
# (`Result: timeout`, 2 min 57 s of CPU), which is to say the watch that reports silence went
# silent itself. One pass over /proc/*/fd answers for every path at once and took 0.63 s.
_HELD: dict[str, set[str]] | None = None


def held_transcripts() -> dict[str, set[str]] | None:
    """Every transcript held open on this host: {"paths", "names"}, or None when the scan failed.

    Read on the host with sudo, so a holder inside an agent box counts. A box sees the shared
    `~/.omp/agent/sessions` at the host's own path -- measured 2026-11-05, all 419 held
    transcripts read `/home/sami/.omp/agent/sessions/...`, boxed sessions included -- so the path
    matches as a string. The file name is kept as well, because it carries the session id and is
    unique: a box whose view of the path differs would then read as "held" rather than "gone". A
    wrong "held" keeps one line out of a message; a wrong "gone" announces a death that did not
    happen.

    No output means the scan did not work, not that nothing is open: a box with live sessions
    always holds transcripts. That reads as None, and every session stays off the dead list.
    """
    global _HELD
    if _HELD is None:
        out = run_command(
            [
                "sudo",
                "-n",
                "sh",
                "-c",
                'find /proc/[0-9]*/fd -maxdepth 1 -lname "*.jsonl" -printf "%l\\n" 2>/dev/null',
            ],
            timeout=60,
        )
        paths = {
            # A process holding a file that has since been removed reads "<path> (deleted)".
            line.removesuffix(" (deleted)")
            for line in (text.strip() for text in out.splitlines())
            if line.startswith("/")
        }
        if not paths:
            log("no transcript holder found in /proc: the scan did not work, judging nobody gone")
        _HELD = {"paths": paths, "names": {path.rsplit("/", 1)[-1] for path in paths}}
    return _HELD if _HELD["paths"] else None


def transcript_held(path: str) -> bool | None:
    """Whether a process holds this file open: True, False, or None when the test did not run."""
    held = held_transcripts()
    if held is None:
        return None
    return path in held["paths"] or path.rsplit("/", 1)[-1] in held["names"]


def dead_sessions(
    directory: Path, root: Path, now: float, silence: float
) -> tuple[list[dict], int]:
    """(the sessions that are gone, how many entries were judged).

    **Every** entry is judged, not only the ones that say `auto_restart=yes`. CHIEF, 2026-11-04:
    a `no` means "do not bring me back", not "do not tell anyone I am gone", and a session that
    will not come back by itself is exactly the one whose promises are most likely to be
    inherited by nobody. His near-case that day: a build-trial session died about 11:28Z with
    one of Sami's measured reruns due at 18:00. `auto_restart` decides only whether anything
    would restart it, and the message says which it was.

    One dict per gone session: its id, title, owner_note, the lead to tell, its transcript and
    its last write. The cheap test (the file's mtime) runs before the `sudo fuser` call, so a
    box with 78 registered sessions makes a handful of fuser calls, not 78.
    """
    found: list[dict] = []
    judged = 0
    index = transcript_index(root)
    for entry in registry_entries(directory):
        transcript = entry_transcript(entry, index)
        if not transcript:
            # No transcript anywhere for this id: nothing to judge, and nothing invented.
            continue
        judged += 1
        try:
            written = os.path.getmtime(transcript)
        except OSError:
            continue
        if now - written < silence:
            continue
        if transcript_held(transcript) is not False:
            continue
        found.append(
            {
                "session": entry.get("session", ""),
                "title": (entry.get("title", "") or "").strip() or "-",
                "note": (entry.get("owner_note", "") or "").strip(),
                "role": (entry.get("role", "") or "").strip(),
                "lead": (entry.get("lead", "") or "").strip(),
                "auto_restart": (entry.get("auto_restart", "") or "").strip() or "-",
                "transcript": transcript,
                "written": written,
            }
        )
    return found, judged


def dead_session_message(item: dict, registry: str, host: str) -> str:
    """One notice: who is gone, what they had promised, and that nothing will bring them back.

    The owner_note is the point of the message -- it is the promise that is about to be
    inherited by nobody -- so it gets whatever room is left after the facts, and the entry file
    is named for the rest of it and for the resume command.
    """
    restart = (
        "The registry says auto_restart=yes, but nothing restarts sessions on this machine any"
        " more"
        if item["auto_restart"] == "yes"
        else f"The registry says auto_restart={item['auto_restart']}, so nothing would have"
        " brought it back in any case"
    )
    head = (
        f"SESSION GONE AND NOT RESTARTED on {host}: {item['session']}"
        f" ({item['title']}{', ' + item['role'] if item['role'] else ''})."
        f" Last transcript write {iso(item['written'])}; no process holds it open."
        f" {restart} (dispatch://INFRA-993). It stays down until a person resumes it:"
        f" {registry}/{item['session']}.entry has the resume command. What it had promised: "
    )
    tail = " […]"
    room = MESSAGE_LIMIT - len(head)
    note = item["note"] or "the entry records no owner_note."
    if room <= len(tail):
        return head[:MESSAGE_LIMIT]
    return head + (note if len(note) <= room else note[: room - len(tail)] + tail)


def dead_session_target(item: dict) -> tuple[str, str]:
    """(kind, where) the notice goes: ("topic", <role topic>) or ("session", <id>).

    The stream lead when the entry names one in `lead=`, and the SRE otherwise. Nothing else in
    an entry says who a session's lead is: `role` is the dead session's OWN role, so sending
    there reaches the session that just died. Rather than guess a lead from a role's prefix,
    an entry with no `lead=` goes to the SRE, who is always live and always reads -- and the
    message names the dead session's role, so the SRE can hand it on. Whoever owns the registry
    adds `lead=<role>` to an entry to route it straight.
    """
    if item["lead"]:
        return "topic", f"notifications.role.{item['lead']}"
    return "session", DEAD_SESSION_TARGET


def report_dead_sessions(
    envoy: Envoy, state: "State", options: argparse.Namespace, now: float
) -> list[str]:
    """Say each newly gone session once, to its stream lead. Returns the ids said.

    **It starts nothing.** The restart duty belongs to the off-box watcher's gate list and
    stays off until box-aware liveness is proved there on three ids (the SRE, 2026-11-04
    21:58Z: tonight's four twin sessions came from an automatic resume, and a gap is the
    cheaper failure). This is the reporting that closes that gap.
    """
    directory = Path(options.registry)
    if not directory.is_dir():
        return []
    found, judged = dead_sessions(
        directory, Path(options.transcripts), now, options.dead_silence
    )
    known = state.data.setdefault("dead_sessions", {})
    alive = {item["session"] for item in found}
    for session in [sid for sid in known if sid not in alive]:
        known.pop(session)
    # The planned-reboot window. Its deaths are expected, so they are recorded as seen and
    # never said, now or when the window ends: a reboot that takes 60 sessions down must not
    # arrive as 60 messages an hour later. A session that dies after the flag is removed is
    # new again and is said.
    quiet = Path(options.reboot_window).exists()
    host = socket.gethostname()
    said = []
    for item in found:
        if item["session"] in known:
            continue
        if quiet:
            known[item["session"]] = now
            log(f"session {item['session']} gone, not said: {options.reboot_window} exists")
            continue
        message = dead_session_message(item, str(options.registry), host)
        kind, where = dead_session_target(item)
        if options.print_alert or options.dry_run:
            print(f"to {where}:\n{message}\n")
        if options.dry_run:
            said.append(item["session"])
            continue
        sent = (
            envoy.publish(where, message)
            if kind == "topic"
            else envoy.send(where, message)
        )
        # A lead's topic with no holder reaches nobody, and this notice must not be the one
        # that is lost: the SRE hears it instead, and the log says so.
        if not sent and kind == "topic":
            log(f"{where} refused it; telling {DEAD_SESSION_TARGET} instead")
            sent = envoy.send(DEAD_SESSION_TARGET, message)
            where = DEAD_SESSION_TARGET
        if not sent:
            # Not recorded as said, so the next pass tries again.
            log(f"NOBODY HEARD IT: session {item['session']} is gone and Envoy refused")
            continue
        log(f"told {where}: session {item['session']} ({item['title']}) is gone")
        said.append(item["session"])
        known[item["session"]] = now
    log(
        f"restart registry: {judged} registered session(s) judged,"
        f" {len(found)} gone, {len(said)} newly said"
        + (f"; quiet: {options.reboot_window} exists" if quiet else "")
    )
    return said


# ------------------------------------------------------------------------------- systemd

_SPAN_UNITS = {
    "us": 1e-6,
    "usec": 1e-6,
    "ms": 1e-3,
    "msec": 1e-3,
    "s": 1.0,
    "sec": 1.0,
    "min": 60.0,
    "m": 60.0,
    "h": 3600.0,
    "hr": 3600.0,
    "d": 86400.0,
    "w": 604800.0,
    "month": 2629800.0,
    "M": 2629800.0,
    "y": 31557600.0,
}
_SPAN_RE = re.compile(
    r"(\d+(?:\.\d+)?)\s*(usec|us|msec|ms|month|min|sec|hr|s|m|h|d|w|M|y)?"
)


def parse_timespan(text: str) -> float | None:
    """Seconds in a systemd time span ("30s", "1min 30s", "1d 15h 3.8s"); None for infinity."""
    text = (text or "").strip()
    if not text or text == "infinity":
        return None
    total = 0.0
    matched = False
    for number, unit in _SPAN_RE.findall(text):
        matched = True
        # A bare number in a property value is microseconds.
        total += float(number) * (_SPAN_UNITS[unit] if unit else 1e-6)
    return total if matched else None


def parse_when(text: str) -> float | None:
    """Epoch seconds from systemctl's "Mon 2026-11-02 14:07:47 UTC" (read under TZ=UTC)."""
    text = (text or "").strip()
    if not text or text in {"n/a", "0"}:
        return None
    if text.startswith("@"):
        try:
            return float(text[1:])
        except ValueError:
            return None
    match = re.search(r"(\d{4}-\d\d-\d\d \d\d:\d\d:\d\d)", text)
    if not match:
        return None
    return float(calendar.timegm(time.strptime(match.group(1), "%Y-%m-%d %H:%M:%S")))


def run_command(argv: list[str], timeout: float = 60.0) -> str:
    try:
        done = subprocess.run(
            argv,
            capture_output=True,
            check=False,
            text=True,
            timeout=timeout,
            stdin=subprocess.DEVNULL,
            env=dict(os.environ, TZ="UTC", SYSTEMD_PAGER="", SYSTEMD_COLORS="0"),
        )
    except (OSError, subprocess.SubprocessError) as error:
        log(f"  {' '.join(argv[:3])} failed: {error}")
        return ""
    return done.stdout


def show(units: list[str], properties: list[str]) -> dict[str, dict[str, list[str]]]:
    """`systemctl --user show` for many units at once: {Id: {property: [values...]}}.

    A property can repeat (TimersMonotonic has one line per trigger), so each holds a list.
    """
    if not units:
        return {}
    out = run_command(
        ["systemctl", "--user", "show", "-p", ",".join(properties), "--", *units]
    )
    found: dict[str, dict[str, list[str]]] = {}
    for block in out.split("\n\n"):
        props: dict[str, list[str]] = {}
        for line in block.splitlines():
            key, sep, value = line.partition("=")
            if sep:
                props.setdefault(key, []).append(value)
        if props.get("Id"):
            found[props["Id"][0]] = props
    return found


def first(props: dict[str, list[str]], key: str) -> str:
    values = props.get(key) or [""]
    return values[0]


def calendar_period(spec: str) -> float | None:
    """The shortest gap between three consecutive elapses of an OnCalendar spec."""
    out = run_command(
        ["systemd-analyze", "calendar", "--iterations=3", spec], timeout=20
    )
    return calendar_period_from(out)


def calendar_period_from(out: str) -> float | None:
    stamps = [
        parse_when(line.split(":", 1)[1])
        for line in out.splitlines()
        if line.strip().startswith(("Next elapse:", "Iteration #"))
    ]
    stamps = [stamp for stamp in stamps if stamp]
    gaps = [
        later - earlier
        for earlier, later in itertools.pairwise(stamps)
        if later > earlier
    ]
    return min(gaps) if gaps else None


_MONOTONIC_RE = re.compile(r"(OnUnitActiveUSec|OnUnitInactiveUSec)=([^;}]+)")
_CALENDAR_RE = re.compile(r"OnCalendar=([^;]+?)\s*;")


def timer_period(
    props: dict[str, list[str]], calendar_lookup=None
) -> tuple[float | None, str]:
    """(seconds between firings, the trigger that says so); None for a timer that fires once.

    OnActiveSec, OnBootSec and OnStartupSec fire once and are not a period.
    """
    calendar_lookup = calendar_lookup or calendar_period
    best: tuple[float | None, str] = (None, "fires once")
    for value in props.get("TimersMonotonic") or []:
        for trigger, span in _MONOTONIC_RE.findall(value):
            seconds = parse_timespan(span)
            if seconds and (best[0] is None or seconds < best[0]):
                name = (
                    "OnUnitActiveSec"
                    if trigger == "OnUnitActiveUSec"
                    else "OnUnitInactiveSec"
                )
                best = (seconds, f"{name}={span.strip()}")
    for value in props.get("TimersCalendar") or []:
        for spec in _CALENDAR_RE.findall(value):
            seconds = calendar_lookup(spec.strip())
            if seconds and (best[0] is None or seconds < best[0]):
                best = (seconds, f"OnCalendar={spec.strip()}")
    return best


TIMER_PROPS = [
    "Id",
    "Unit",
    "LoadState",
    "ActiveState",
    "UnitFileState",
    "TimersMonotonic",
    "TimersCalendar",
    "LastTriggerUSec",
    "NextElapseUSecRealtime",
    "RandomizedDelayUSec",
    "AccuracyUSec",
    "ActiveEnterTimestamp",
]
SERVICE_PROPS = [
    "Id",
    "Type",
    "LoadState",
    "ActiveState",
    "SubState",
    "TimeoutStartUSec",
    "TimeoutStopUSec",
    "OnFailure",
    "Documentation",
    "InvocationID",
    "ExecMainStartTimestamp",
    "InactiveExitTimestamp",
    "InactiveEnterTimestamp",
]


def timer_names() -> list[str]:
    """Every timer systemd has loaded, and every enabled timer unit file, which catches one that
    is enabled but was never loaded or was stopped."""
    names: set[str] = set()
    for line in run_command(
        ["systemctl", "--user", "list-timers", "--all", "--no-legend", "--plain"]
    ).splitlines():
        for word in line.split():
            if word.endswith(".timer"):
                names.add(word)
    for line in run_command(
        [
            "systemctl",
            "--user",
            "list-unit-files",
            "--type=timer",
            "--no-legend",
            "--plain",
        ]
    ).splitlines():
        parts = line.split()
        # A template file is not a timer that runs.
        if (
            len(parts) >= 2
            and parts[0].endswith(".timer")
            and parts[1] in ENABLED_STATES
            and "@" not in parts[0]
        ):
            names.add(parts[0])
    return sorted(names)


def discover() -> list[dict]:
    """Every timer on this user manager, with its service and its period."""
    timers = show(timer_names(), TIMER_PROPS)
    services = show(
        sorted(
            {first(props, "Unit") for props in timers.values() if first(props, "Unit")}
        ),
        SERVICE_PROPS,
    )
    found = []
    for name, props in sorted(timers.items()):
        period, trigger = timer_period(props)
        service_name = first(props, "Unit")
        service = services.get(service_name, {})
        documentation = [
            doc.split(":", 1)[1] if doc.startswith("file:") else doc
            for value in service.get("Documentation") or []
            for doc in value.split()
        ]
        found.append(
            {
                "timer": name,
                "service": service_name,
                "load_state": first(props, "LoadState"),
                "active_state": first(props, "ActiveState"),
                "unit_file_state": first(props, "UnitFileState"),
                "period": period,
                "trigger": trigger,
                "inactive_trigger": trigger.startswith("OnUnitInactiveSec"),
                "last_trigger": parse_when(first(props, "LastTriggerUSec")),
                "next_elapse": parse_when(first(props, "NextElapseUSecRealtime")),
                "timer_since": parse_when(first(props, "ActiveEnterTimestamp")),
                "slack": (parse_timespan(first(props, "RandomizedDelayUSec")) or 0.0)
                + (parse_timespan(first(props, "AccuracyUSec")) or 0.0),
                "service_type": first(service, "Type"),
                "service_state": first(service, "ActiveState"),
                "service_substate": first(service, "SubState"),
                "timeout_start": parse_timespan(first(service, "TimeoutStartUSec")),
                "timeout_stop": parse_timespan(first(service, "TimeoutStopUSec")),
                # The units its OnFailure= starts: a handler that says this unit's failures.
                "on_failure": first(service, "OnFailure").split(),
                "documentation": documentation,
                "invocation": first(service, "InvocationID"),
                "run_started": parse_when(first(service, "ExecMainStartTimestamp"))
                or parse_when(first(service, "InactiveExitTimestamp")),
                "service_inactive_since": parse_when(
                    first(service, "InactiveEnterTimestamp")
                ),
            }
        )
    return found


# ------------------------------------------------------------------------------- the journal

JOURNAL_FIELDS = (
    "MESSAGE_ID,JOB_TYPE,JOB_RESULT,UNIT_RESULT,USER_INVOCATION_ID,MESSAGE,USER_UNIT"
)


def journal_records(services: list[str], since: float, until: float) -> list[dict]:
    """systemd's own records about these units, one read for all of them.

    USER_UNIT matches only what the user manager wrote about a unit, never the unit's output, so
    an hour of every timer here is about a thousand records and 0.1 s: the units' own output for
    the same units over 50 hours is 200,000 records and 44 s on this box.
    """
    if not services:
        return []
    argv = [
        "journalctl",
        "--user",
        "--no-pager",
        "-o",
        "json",
        f"--output-fields={JOURNAL_FIELDS}",
        f"--since=@{int(since)}",
        f"--until=@{int(until) + 1}",
        *[f"USER_UNIT={service}" for service in services],
    ]
    records = []
    for line in run_command(argv, timeout=90).splitlines():
        try:
            records.append(json.loads(line))
        except ValueError:
            continue
    return records


def text_of(record: dict) -> str:
    message = record.get("MESSAGE")
    if isinstance(message, list):  # journald hands non-UTF-8 text as a byte list
        message = bytes(value for value in message if isinstance(value, int)).decode(
            "utf8", "replace"
        )
    return str(message or "").strip()


def runs_from_records(records: list[dict]) -> dict[str, list[dict]]:
    """{service: [run, ...]}, one run per invocation, from systemd's records about the unit."""
    runs: dict[str, dict[str, dict]] = {}
    for record in records:
        unit = record.get("USER_UNIT")
        if not unit:
            continue
        when = int(record.get("__REALTIME_TIMESTAMP") or 0) / 1e6
        invocation = record.get("USER_INVOCATION_ID") or f"t{when:.6f}"
        message_id = record.get("MESSAGE_ID") or ""
        if message_id == UNIT_RESOURCES:
            continue
        run = runs.setdefault(unit, {}).setdefault(
            invocation,
            {
                "invocation": invocation,
                "started": None,
                "first_seen": when,
                "outcome": None,
                "ended": None,
                "lines": [],
            },
        )
        if message_id == UNIT_STARTING:
            run["started"] = when
        elif message_id == UNIT_SKIPPED or record.get("JOB_RESULT") == "skipped":
            run["outcome"] = run["outcome"] or "skipped"
            run["ended"] = when
        elif message_id == UNIT_STARTED and record.get("JOB_RESULT") == "done":
            run["done"] = when
        elif message_id == UNIT_RESULT:
            run["outcome"] = (
                "timeout"
                if record.get("UNIT_RESULT") == "timeout"
                else (record.get("UNIT_RESULT") or "failed")
            )
            run["ended"] = when
            run["lines"].append((when, text_of(record)))
        elif message_id == UNIT_FAILED:
            if not run["outcome"]:
                run["outcome"] = record.get("JOB_RESULT") or "failed"
                run["ended"] = when
        elif message_id == UNIT_PROCESS_EXIT or not message_id:
            text = text_of(record)
            if text:
                run["lines"].append((when, text))
    return {
        unit: sorted(
            by_invocation.values(), key=lambda run: run["started"] or run["first_seen"]
        )
        for unit, by_invocation in runs.items()
    }


def tally(
    runs: list[dict],
    since: float,
    until: float,
    live_invocation: str = "",
    oneshot: bool = True,
) -> dict:
    """Counts for the runs that STARTED inside [since, until].

    A oneshot service's "Finished" is its run completing; any other type's "Started" is only its
    start, so for those a run counts as completed once it has ended without a failure.
    """
    counts = {
        "started": 0,
        "completed": 0,
        "killed": 0,
        "failed": 0,
        "skipped": 0,
        "running": 0,
    }
    failures: dict[str, int] = {}
    last_failure: dict | None = None
    first_start = last_start = None
    for run in runs:
        began = run["started"] or run["first_seen"]
        if began < since or began > until:
            continue
        outcome = run.get("outcome")
        if outcome == "skipped" and not run["started"]:
            counts["skipped"] += 1
            continue
        counts["started"] += 1
        first_start = began if first_start is None else min(first_start, began)
        last_start = began if last_start is None else max(last_start, began)
        if outcome == "timeout":
            counts["killed"] += 1
        elif outcome and outcome != "skipped":
            counts["failed"] += 1
            failures[outcome] = failures.get(outcome, 0) + 1
        elif run.get("done") and (oneshot or run["invocation"] != live_invocation):
            counts["completed"] += 1
        else:
            counts["running"] += 1
            continue
        if outcome and (
            last_failure is None or (run["ended"] or 0) >= (last_failure["ended"] or 0)
        ):
            last_failure = run
    counts["ended"] = counts["completed"] + counts["killed"] + counts["failed"]
    counts["failures"] = failures
    counts["first_start"] = first_start
    counts["last_start"] = last_start
    counts["last_failure"] = (
        {
            "at": last_failure["ended"],
            "started": last_failure["started"] or last_failure["first_seen"],
            "outcome": last_failure["outcome"],
            "lines": [text for _, text in last_failure["lines"]],
        }
        if last_failure
        else None
    )
    return counts


def last_own_line(service: str, since: float, until: float) -> tuple[float | None, str]:
    """The last line the unit itself printed in [since, until], or (None, "")."""
    out = run_command(
        [
            "journalctl",
            "--user",
            "--no-pager",
            "-o",
            "json",
            "--output-fields=MESSAGE",
            "-n",
            "1",
            f"--since=@{int(since)}",
            f"--until=@{int(until) + 1}",
            f"_SYSTEMD_USER_UNIT={service}",
        ],
        timeout=30,
    )
    for line in reversed(out.splitlines()):
        try:
            record = json.loads(line)
        except ValueError:
            continue
        return int(record.get("__REALTIME_TIMESTAMP") or 0) / 1e6, text_of(record)[:400]
    return None, ""


def own_line_for(
    service: str, counts: dict, since: float, until: float
) -> tuple[float | None, str]:
    """The last line the unit printed in its last failed run, or in the window when none failed:
    what the run was doing when it ended is the line a reader needs."""
    failure = counts.get("last_failure")
    if failure:
        return last_own_line(service, failure["started"], failure["at"])
    return last_own_line(service, since, until)


# ------------------------------------------------------------------------------- judgement


def window_for(unit: dict, options: argparse.Namespace) -> float:
    """The last hour, or two periods and the timer's slack when that is longer, so a unit that
    fires hourly or daily always has a run inside its window."""
    period = unit.get("period")
    if not period:
        return options.window
    return max(options.window, 2 * period + unit.get("slack", 0.0) + 60)


def overdue_after(unit: dict) -> float:
    """How long a periodic timer may go without firing before it counts as stopped."""
    return 2 * unit["period"] + unit.get("slack", 0.0) + 120


def stuck_floor(unit: dict, options: argparse.Namespace) -> float:
    """Two periods, slack and 2 min, and at least --stuck-after: how long a run may last when
    nothing else is known about the unit."""
    return max(overdue_after(unit), options.stuck_after)


def systemd_ends(unit: dict) -> float | None:
    """When systemd itself must have ended a run: TimeoutStartSec + TimeoutStopSec of a oneshot,
    whose start is its whole run. None for other types, where TimeoutStartSec bounds only the
    start (infra977-trial-feed, Type=simple, 2 min, runs for hours)."""
    if unit.get("service_type") not in {"oneshot", ""} or not unit.get("timeout_start"):
        return None
    return unit["timeout_start"] + (unit.get("timeout_stop") or 0.0)


def stuck_earliest(unit: dict, options: argparse.Namespace) -> float:
    """The shortest any limit below can be: the floor, or systemd's end when that is sooner.

    A `max_run` from the expected list replaces both, as it does in stuck_limit: the unit's
    owner has said how long a run of it may take, and no run shorter than that is read as
    stuck or needs its run time history looked up.
    """
    if unit.get("max_run"):
        return float(unit["max_run"])
    ends = systemd_ends(unit)
    floor = stuck_floor(unit, options)
    return min(floor, ends) if ends else floor


def percentile(values: list[float], share: float) -> float | None:
    """The nearest-rank percentile: the smallest value with `share` of them at or below it."""
    if not values:
        return None
    ordered = sorted(values)
    return ordered[max(0, math.ceil(share * len(ordered)) - 1)]


def completed_run_times(runs: list[dict]) -> list[float]:
    """Seconds from `Starting X...` to `Finished X.` of every run that completed."""
    return [
        run["done"] - run["started"]
        for run in runs
        if run.get("started") and run.get("done") and not run.get("outcome")
    ]


def run_time_history(units: list[dict], now: float, cache: dict) -> dict[str, dict]:
    """{service: {"p99", "longest", "runs", "at"}} for these units' completed runs.

    From `cache` (the state file's) while an entry is under RUN_TIME_REFRESH old, else from one
    journal read of the last RUN_TIME_LOOKBACK for every stale unit at once. Only a oneshot's
    `Finished` ends its run, so other service types have no history and keep the floor.
    """
    services = [
        unit["service"]
        for unit in units
        if unit.get("service_type") in {"oneshot", ""}
    ]
    stale = [
        service
        for service in services
        if now - float((cache.get(service) or {}).get("at") or 0) >= RUN_TIME_REFRESH
    ]
    if stale:
        runs = runs_from_records(journal_records(stale, now - RUN_TIME_LOOKBACK, now))
        for service in stale:
            times = completed_run_times(runs.get(service, []))
            cache[service] = {
                "p99": percentile(times, 0.99),
                "longest": max(times, default=None),
                "runs": len(times),
                "at": now,
            }
    return {service: cache[service] for service in services}


def stuck_limit(
    unit: dict, options: argparse.Namespace, history: dict | None = None
) -> tuple[float, str]:
    """(how long one run may last before it NEVER ENDS, where that limit comes from).

    Twice the unit's own p99 run time of the last two days, or the two-period floor when that
    is longer; for a oneshot, never past TimeoutStartSec + TimeoutStopSec, even below the
    floor: past that, systemd itself should have ended the run. Since the p99 is at most the
    longest completed run, the raise never passes twice the longest.
    """
    limit = stuck_floor(unit, options)
    source = f"two periods, at least {human_time(options.stuck_after)}"
    p99 = (history or {}).get("p99")
    if p99 and 2 * p99 > limit:
        limit = 2 * p99
        source = (
            f"2 x its p99 run time of {human_time(p99)} over {history.get('runs', 0)} runs,"
            f" longest {human_time(history.get('longest'))}"
        )
    ends = systemd_ends(unit)
    if ends and ends < limit:
        limit, source = ends, "its TimeoutStartSec + TimeoutStopSec"
    # The owner's own figure wins over all of it, including systemd's. agent-files-archive is
    # the case this exists for: OnUnitInactiveSec=20min and a normal cycle of 5-7 min, so the
    # floor is 22 min, and after the reset of 2026-11-04 one run took 47 minutes because the
    # shared request budget of its tracker client sleeps while every lane re-downloads at
    # once. RUN NEVER ENDS opened at 43 min on a run that was working. Its owner asked for 3 h.
    if unit.get("max_run"):
        limit = float(unit["max_run"])
        source = f"its max_run in {options.expected}"
    return limit, source


def judged(unit: dict, kind: str) -> bool:
    """Whether this watch says `kind` for this unit: not a failed run of a unit whose OnFailure=
    handler says its failures itself (omp-session-sql-sweep, omp-login-watch), so each failure
    has one message."""
    return not (unit.get("on_failure") and kind in FAILURE_KINDS)


def judge(
    unit: dict,
    counts: dict,
    now: float,
    options: argparse.Namespace,
    live: bool = True,
    limit: tuple[float, str] | None = None,
) -> dict[str, str]:
    """{kind: why} for every condition that holds for this unit now.

    `limit` is the unit's stuck_limit when its run time history was read; without it a run is
    held to the floor.
    """
    found: dict[str, str] = {}
    if not unit.get("period"):
        return found
    window = window_for(unit, options)
    if (
        judged(unit, "no-completion")
        and counts["ended"]
        and counts["completed"] == 0
    ):
        found["no-completion"] = (
            f"completed 0 of {counts['started']} runs started in the last {human_time(window)}"
        )
    if (
        judged(unit, "killed")
        and counts["ended"]
        and counts["killed"] >= options.min_killed
        and counts["killed"] / counts["ended"] > options.killed_share
    ):
        found["killed"] = (
            f"{counts['killed']} of {counts['ended']} runs that ended in the last {human_time(window)}"
            f" were killed at the time limit ({counts['killed'] / counts['ended']:.0%},"
            f" over the {options.killed_share:.0%} this watch allows)"
        )
    if not live:
        return found
    running = unit.get("service_state") in RUNNING_STATES
    enabled = unit.get("unit_file_state") in ENABLED_STATES
    timer_active = unit.get("active_state") == "active"
    if not timer_active and enabled:
        found["dead-timer"] = (
            f"{unit['timer']} is {unit.get('unit_file_state')} but {unit.get('active_state') or 'not loaded'},"
            " so it will not fire"
        )
    elif timer_active and not running:
        base = unit.get("last_trigger") or unit.get("timer_since")
        if unit.get("inactive_trigger") and unit.get("service_inactive_since"):
            base = max(base or 0, unit["service_inactive_since"])
        if base and now - base > overdue_after(unit):
            found["dead-timer"] = (
                f"{unit['timer']} last fired {human_time(now - base)} ago ({iso(base)}) and fires every"
                f" {human_time(unit['period'])}; its service is not running"
            )
    if running and unit.get("run_started"):
        age = now - unit["run_started"]
        seconds, source = limit or stuck_limit(unit, options)
        if age > seconds:
            found["stuck"] = (
                f"the run that started at {iso(unit['run_started'])} is still {unit.get('service_state')}"
                f" after {human_time(age)}, over its {human_time(seconds)} limit ({source});"
                " no other run can start"
            )
    return found


def clears(
    kind: str, unit: dict, counts: dict, findings: dict, options: argparse.Namespace
) -> bool:
    """Hysteresis for the kill share: it clears at half the bar, never on it."""
    if kind in findings:
        return False
    if kind == "killed" and counts["ended"] and counts["killed"] >= options.min_killed:
        return (
            counts["killed"] / counts["ended"]
            <= options.killed_share * options.clear_factor
        )
    return True


# ------------------------------------------- the expected timers, and the streams' own jobs


# A line of the expected list: a timer name, then optional `key=value` fields. A value runs to
# the next `key=` or to the end of the line, so `owner=01a16553 MACH` is one value.
_FIELD_RE = re.compile(r"([A-Za-z_][A-Za-z0-9_]*)=(.*?)(?=\s+[A-Za-z_][A-Za-z0-9_]*=|\Z)")
_EXPECTED_READ: dict[tuple[str, float, int], tuple[dict[str, dict], str]] = {}


def expected_timers(path: Path) -> tuple[dict[str, dict], str]:
    """({timer: its fields}, "" or why the list could not be read).

    One name per line, `#` starts a comment anywhere, a name without `.timer` gets one. After
    the name a line may carry `key=value` fields; two are read, and an unknown one is kept so
    a reader of --report sees it:

      owner=<who>     who to go to. The comment after `#` may say it instead; neither is read
                      by any rule, both are printed in the alert.
      max_run=<span>  how long one run of this unit's service may take before RUN NEVER ENDS
                      (stuck_limit). Without it the limit is this watch's own, which knows
                      nothing about what the unit does.

    A list that cannot be read is said in this run's log and in the report, and alerts nobody:
    a watch that wakes the lead about its own configuration file is a watch people turn off.

    The result is memoised on the file's path, mtime and size, because one pass reads the list
    twice (once for max_run, once for the expected conditions) and the file never changes
    inside a pass.
    """
    try:
        stat = path.stat()
        key = (str(path), stat.st_mtime, stat.st_size)
        if key in _EXPECTED_READ:
            return _EXPECTED_READ[key]
        text = path.read_text()
    except OSError as error:
        return {}, str(error)
    entries: dict[str, dict] = {}
    for line in text.splitlines():
        body = line.split("#", 1)[0].strip()
        if not body:
            continue
        name, _, rest = body.partition(" ")
        if not name.endswith(".timer"):
            name += ".timer"
        fields = {
            match.group(1).lower(): match.group(2).strip()
            for match in _FIELD_RE.finditer(rest.strip())
        }
        entry: dict = {"owner": fields.pop("owner", ""), "extra": fields}
        span = fields.pop("max_run", "")
        if span:
            seconds = parse_every(span)
            if seconds:
                entry["max_run"] = seconds
            else:
                log(f"  {path}: {name} has max_run={span!r}, which is not a time span; ignored")
        entries[name] = entry
    _EXPECTED_READ[key] = (entries, "")
    return entries, ""


EXPECTED_PROPS = [
    "Id",
    "Unit",
    "LoadState",
    "ActiveState",
    "UnitFileState",
    "TimersMonotonic",
    "TimersCalendar",
    "LastTriggerUSec",
    "ActiveEnterTimestamp",
]


def expected_state(entries: dict[str, dict], units: list[dict]) -> dict[str, dict]:
    """Each expected timer with what systemd says about it and what its line says: from `units`
    where this box has the timer, and from one `systemctl show` for the rest.

    A timer whose unit file is there but not enabled is in neither half of `timer_names()`, so
    telling MISSING from NOT ENABLED needs that one call: systemd answers LoadState=not-found
    for a name with no unit file anywhere, and a loaded unit with UnitFileState=disabled for
    one that is only unarmed. On a box where every expected timer is enabled there is nothing
    to ask and no call is made.
    """
    names = list(entries)
    found = {
        unit["timer"]: dict(unit) for unit in units if unit["timer"] in entries
    }
    unknown = [name for name in names if name not in found]
    props = show(unknown, EXPECTED_PROPS) if unknown else {}
    for name in unknown:
        prop = props.get(name, {})
        period, trigger = timer_period(prop) if prop else (None, "fires once")
        found[name] = {
            "timer": name,
            "service": first(prop, "Unit"),
            "load_state": first(prop, "LoadState") or "not-found",
            "active_state": first(prop, "ActiveState"),
            "unit_file_state": first(prop, "UnitFileState"),
            "period": period,
            "trigger": trigger,
            "last_trigger": parse_when(first(prop, "LastTriggerUSec")),
            "timer_since": parse_when(first(prop, "ActiveEnterTimestamp")),
            "slack": 0.0,
        }
    for name, entry in entries.items():
        found[name]["owner"] = entry.get("owner") or ""
        if entry.get("max_run"):
            found[name]["max_run"] = entry["max_run"]
    return found


def judge_expected(
    states: dict[str, dict], now: float, options: argparse.Namespace, live: bool = True
) -> dict[str, dict[str, str]]:
    """{timer: {kind: why}} for every expected timer that is missing, unarmed or late.

    The owner its line names, when it has one, goes in the text: the lead who reads the alert
    should not have to open the list to learn whose timer it is.
    """
    found: dict[str, dict[str, str]] = {}
    for name, unit in sorted(states.items()):
        kinds: dict[str, str] = {}
        load = unit.get("load_state") or "not-found"
        state = unit.get("unit_file_state") or ""
        owner = f" (owner {unit['owner']})" if unit.get("owner") else ""
        if load in {"not-found", "error", "bad-setting"} or (not state and not load):
            kinds["timer-missing"] = (
                f"{name}{owner} is in {options.expected} but this user manager has no such"
                f" timer ({load}); nothing starts its service, and nothing will say so"
            )
        elif load == "masked" or state == "masked":
            kinds["timer-missing"] = (
                f"{name}{owner} is masked, so it cannot be started at all"
            )
        elif state not in ENABLED_STATES:
            kinds["timer-disabled"] = (
                f"{name}{owner} is {state or 'not installed'}, not enabled, so the next reset"
                " of this box loses it; `systemctl --user enable --now` arms it"
            )
        elif (
            live
            and unit.get("period")
            # A timer whose service is running has not stopped: an OnUnitInactiveSec timer is
            # not even armed until the run ends. agent-files-archive fires 20 min after each
            # run ends and a run of it may take 3 h (its max_run), so the clock below would
            # otherwise say HAS NOT RUN of a unit that is working.
            and unit.get("service_state") not in RUNNING_STATES
        ):
            base = unit.get("last_trigger") or unit.get("timer_since")
            if unit.get("inactive_trigger") and unit.get("service_inactive_since"):
                base = max(base or 0, unit["service_inactive_since"])
            limit = EXPECTED_PERIODS * unit["period"] + (unit.get("slack") or 0.0)
            if base and now - base > limit:
                kinds["timer-stale"] = (
                    f"{name}{owner} last fired {human_time(now - base)} ago ({iso(base)}) and"
                    f" fires every {human_time(unit['period'])}, over the"
                    f" {EXPECTED_PERIODS:g} periods this list allows"
                )
        if kinds:
            found[name] = kinds
    return found


def parse_every(text: str) -> float | None:
    """Seconds in a job file's `every`: `15m`, `1h`, `90s`, or a bare number of seconds.

    A bare number in a systemd property is microseconds (parse_timespan); in a file a person
    writes by hand it is seconds, which is the one difference.
    """
    text = (text or "").strip()
    if not text:
        return None
    if re.fullmatch(r"\d+(?:\.\d+)?", text):
        return float(text)
    return parse_timespan(text)


def state_value(directory: Path, name: str) -> str:
    try:
        return (directory / name).read_text().strip()
    except OSError:
        return ""


def state_when(directory: Path, name: str) -> float | None:
    """The epoch seconds a stream-job state file opens with (`<epoch> <ISO stamp>`)."""
    head = state_value(directory, name).split()
    try:
        return float(head[0]) if head else None
    except ValueError:
        return None


def stream_jobs(options: argparse.Namespace) -> list[dict]:
    """Every stream job this box has, with its owner, its interval and what the runner recorded.

    The job files and the state are plain text that scripts/stream-job writes; this watch only
    reads them, and a job directory it cannot read is a job with no last finish, which is
    exactly the thing it says.
    """
    jobs: list[dict] = []
    try:
        files = sorted(Path(options.stream_jobs).glob("*.job"))
    except OSError:
        return jobs
    for path in files:
        try:
            text = path.read_text()
            mtime = path.stat().st_mtime
        except OSError:
            continue
        fields: dict[str, str] = {}
        for line in text.splitlines():
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            key, sep, value = line.partition("=")
            if sep:
                fields[key.strip().lower()] = value.strip()
        directory = Path(options.stream_job_state) / path.stem
        jobs.append(
            {
                "name": path.stem,
                "file": str(path),
                "owner": fields.get("owner", "nobody named"),
                "command": fields.get("command", ""),
                "every": parse_every(fields.get("every", "")),
                "file_mtime": mtime,
                "last_start": state_when(directory, "last-start"),
                "last_finish": state_when(directory, "last-finish"),
                "last_exit": state_value(directory, "last-exit"),
                "last_line": state_value(directory, "last-line"),
                "state_dir": str(directory),
            }
        )
    return jobs


def judge_jobs(
    jobs: list[dict], now: float, options: argparse.Namespace
) -> dict[str, dict[str, str]]:
    """{job name: {kind: why}} for every stream job that has not finished in three intervals."""
    found: dict[str, dict[str, str]] = {}
    for job in jobs:
        if not job.get("every"):
            continue
        limit = EXPECTED_PERIODS * job["every"]
        last, started = job.get("last_finish"), job.get("last_start")
        if last is not None and now - last <= limit:
            continue
        if last is not None:
            why = (
                f"{job['name']} (owner {job['owner']}) last finished {human_time(now - last)}"
                f" ago ({iso(last)}) and runs every {human_time(job['every'])}"
            )
            if started and started > last:
                why += f"; a run started {human_time(now - started)} ago has not ended"
            if job.get("last_exit") not in ("", "0"):
                why += f"; its last exit was {job['last_exit']}"
        else:
            since = started or job.get("file_mtime")
            if since and now - since <= limit:
                continue
            why = (
                f"{job['name']} (owner {job['owner']}) has never finished since its job file"
                f" was written {human_time(now - (since or now))} ago, and runs every"
                f" {human_time(job['every'])}"
            )
        found[job["name"]] = {"job-stale": why}
    return found


def expected_text(
    states: dict[str, dict],
    jobs: list[dict],
    timer_found: dict[str, dict[str, str]],
    job_found: dict[str, dict[str, str]],
    missing_list: str,
) -> str:
    """The expected list and the stream jobs as the report shows them."""
    lines = [
        f"{'expected timer':<36} {'state':<22} {'last fired':<20} {'owner':<20}  verdict"
    ]
    if missing_list:
        lines.append(f"  the list could not be read: {missing_list}")
    for name, unit in sorted(states.items()):
        kinds = timer_found.get(name) or {}
        verdict = (
            "; ".join(HEADLINE[kind] for kind in EXPECTED_KINDS if kind in kinds) or "ok"
        )
        if unit.get("max_run"):
            verdict += f" (max_run {human_time(unit['max_run'])})"
        # A timer with no unit file reads ActiveState=inactive like a timer between runs, so
        # the column says its LoadState instead: that is the difference the reader needs.
        load = unit.get("load_state") or "not-found"
        state = (
            f"{unit.get('active_state') or '-'}/{unit.get('unit_file_state') or '-'}"
            if load == "loaded"
            else f"{load}/{unit.get('unit_file_state') or '-'}"
        )
        lines.append(
            f"{name:<36} {state:<22} {iso(unit.get('last_trigger')):<20}"
            f" {(unit.get('owner') or '-')[:20]:<20}  {verdict}"
        )
    lines.append("")
    lines.append(f"{'stream job':<28} {'owner':<28} {'every':>6} {'last finish':<20}  verdict")
    if not jobs:
        lines.append("  no job files; the streams have written none yet")
    for job in sorted(jobs, key=lambda item: item["name"]):
        kinds = job_found.get(job["name"]) or {}
        verdict = (
            "; ".join(HEADLINE[kind] for kind in JOB_KINDS if kind in kinds)
            or ("ok" if job.get("every") else "no `every`, not judged")
        )
        if job.get("last_exit") not in ("", "0", None):
            verdict += f" (last exit {job['last_exit']})"
        lines.append(
            f"{job['name']:<28} {job['owner'][:28]:<28} {human_time(job.get('every')) if job.get('every') else '-':>6}"
            f" {iso(job.get('last_finish')):<20}  {verdict}"
        )
    return "\n".join(lines)


# ------------------------------------------------------------------------------- reading


def reading(
    unit: dict, counts: dict | None, now: float, options: argparse.Namespace
) -> dict:
    window = window_for(unit, options)
    row = {
        "timer": unit["timer"],
        "service": unit["service"],
        "period": unit.get("period"),
        "trigger": unit.get("trigger"),
        "timer_state": f"{unit.get('active_state')}/{unit.get('unit_file_state')}",
        "service_state": unit.get("service_state"),
        "last_trigger": iso(unit.get("last_trigger")),
        "window": window,
        "on_failure": unit.get("on_failure") or [],
    }
    if counts:
        row.update(
            {
                key: counts[key]
                for key in (
                    "started",
                    "completed",
                    "killed",
                    "failed",
                    "running",
                    "skipped",
                )
            }
        )
        row["failures"] = counts["failures"]
    return row


def report_text(
    rows: list[dict],
    verdicts: dict[str, dict[str, str]],
    until: float,
    live: bool = True,
) -> str:
    lines = [
        f"unit-health-watch on {socket.gethostname()}, window ending {iso(until)}"
        + (
            ""
            if live
            else "; a past window: runs counted from the journal, timer and run state not judged,"
            " 'last fired' is as of now"
        ),
        (
            f"{'service':<36} {'every':>6} {'window':>6} {'start':>5} {'done':>5} {'kill':>5} {'fail':>5} {'run':>4}"
            f"  {'last fired':<20}  verdict"
        ),
    ]
    for row in rows:
        found = verdicts.get(row["service"]) or {}
        verdict = "; ".join(HEADLINE[kind] for kind in KINDS if kind in found) or (
            "ok" if row.get("period") else "not periodic, not judged"
        )
        if row.get("on_failure") and row.get("period"):
            verdict += f" (failed runs told by {' '.join(row['on_failure'])})"
        if row.get("period") is None:
            counts = f"{'-':>5} {'-':>5} {'-':>5} {'-':>5} {'-':>4}"
        else:
            counts = (
                f"{row.get('started', 0):>5} {row.get('completed', 0):>5} {row.get('killed', 0):>5}"
                f" {row.get('failed', 0):>5} {row.get('running', 0):>4}"
            )
        lines.append(
            f"{row['service']:<36} {human_time(row.get('period')):>6} {human_time(row['window']):>6} {counts}"
            f"  {row['last_trigger']:<20}  {verdict}"
        )
    return "\n".join(lines)


# ------------------------------------------------------------------------------- alerts

ADVICE = {
    "no-completion": "Every check this unit makes is off while this holds, and its own alerts are"
    " silent with it.",
    "killed": "A run killed at its time limit has outgrown TimeoutStartSec, usually on a loaded box:"
    " envoy-role-holder-watch needed more than its 25 s at load 450 on 2026-11-02. Measure a run's"
    " wall time now, then make the run cheaper or raise the limit.",
    "dead-timer": "Nothing starts this unit any more, so it reports nothing and fails nothing."
    " `systemctl --user start <timer>` re-arms it once the reason it stopped is known.",
    "stuck": "A run that never ends holds the unit, so the timer cannot start the next one."
    " Read what the run is waiting on before stopping it.",
    "timer-missing": "This box is meant to have this timer and does not. After the reset of"
    " 2026-11-04 three watches came back as a linked .service with no .timer, so nothing fired"
    " and nothing complained. `installers/expected-timers.sh` links and enables every timer in"
    " the list and is safe to run again.",
    "timer-disabled": "The timer exists but is not enabled, so it is gone at the next reset of"
    " this box even though it may be running now. Enable it, or take its name out of the list"
    " if it was retired on purpose.",
    "timer-stale": "The timer is enabled and has not fired for three of its own periods. Either"
    " its service never ends (see RUN NEVER ENDS for that unit) or the timer was stopped;"
    " `systemctl --user list-timers <timer>` says which.",
    "job-stale": "A stream's standing job stopped finishing. The owner named in the line owns"
    " the job; the runner is scripts/stream-job and the job's own output is in its state"
    " directory.",
}


def expected_block(name: str, unit: dict, kinds: dict[str, str], path: Path) -> str:
    """One expected timer's news: what the list wants, what systemd has, and what to read."""
    lines = [
        f"{name}: "
        + "; ".join(f"{HEADLINE[kind]} - {why}" for kind, why in kinds.items())
        + "."
    ]
    lines.append(
        f"  systemd now: load {unit.get('load_state') or '-'}, unit file"
        f" {unit.get('unit_file_state') or '-'}, {unit.get('active_state') or 'not loaded'},"
        f" every {human_time(unit.get('period'))}, last fired {iso(unit.get('last_trigger'))},"
        f" service {unit.get('service') or 'unknown'}."
    )
    lines.append(
        f"  Read: systemctl --user status {name}; systemctl --user list-timers --all {name};"
        f" the list is {path}."
    )
    for kind in kinds:
        lines.append(f"  {ADVICE[kind]}")
    return "\n".join(lines)


def job_block(job: dict, kinds: dict[str, str]) -> str:
    """One stream job's news: who owns it, what it runs, and what the runner last recorded."""
    lines = [
        f"stream job {job['name']}: "
        + "; ".join(f"{HEADLINE[kind]} - {why}" for kind, why in kinds.items())
        + "."
    ]
    lines.append(
        f"  Owner {job['owner']}; every {human_time(job.get('every'))}; last start"
        f" {iso(job.get('last_start'))}, last finish {iso(job.get('last_finish'))}, last exit"
        f" {job.get('last_exit') or '-'}."
    )
    if job.get("last_line"):
        lines.append(f"  Last line it printed: {job['last_line'][:200]}")
    lines.append(f"  Command: {job.get('command') or '-'}")
    lines.append(
        f"  Read: {job['file']}; {job['state_dir']}; journalctl --user -u stream-job.service."
    )
    for kind in kinds:
        lines.append(f"  {ADVICE[kind]}")
    return "\n".join(lines)


def unit_block(
    unit: dict,
    counts: dict,
    kinds: dict[str, str],
    since: float,
    until: float,
    own: tuple,
) -> str:
    service = unit["service"]
    timeout = unit.get("timeout_start")
    limit = (
        f"its {human_time(timeout)} start limit (TimeoutStartSec)"
        if timeout
        else "its time limit"
    )
    failures = ", ".join(
        f"{count} {result}" for result, count in sorted(counts["failures"].items())
    )
    lines = [
        f"{service}: "
        + "; ".join(f"{HEADLINE[kind]} - {why}" for kind, why in kinds.items())
        + "."
    ]
    lines.append(
        f"  Journal, {iso(since)} to {iso(until)}: {counts['started']} started, {counts['completed']} completed,"
        f" {counts['killed']} killed at {limit}, {counts['failed']} failed otherwise"
        + (f" ({failures})" if failures else "")
        + f", {counts['running']} still running."
    )
    lines.append(
        f"  Timer {unit['timer']}: {unit.get('trigger')}, {unit.get('active_state')}, last fired"
        f" {iso(unit.get('last_trigger'))}, next {iso(unit.get('next_elapse')) if unit.get('next_elapse') else '-'}."
    )
    failure = counts.get("last_failure")
    if failure:
        lines.append(
            f"  Last error, {iso(failure['at'])} ({failure['outcome']}): "
            + " / ".join(failure["lines"][-3:])
        )
    when, text = own
    scope = "its last failed run" if failure else "the window"
    lines.append(
        f"  Last line the unit printed in {scope}, {iso(when)}: {text}"
        if text
        else f"  The unit printed nothing in {scope}."
    )
    read = [
        f"journalctl --user -u {service} --since {iso(since)}",
        f"systemctl --user status {service} {unit['timer']}",
    ]
    read += unit.get("documentation") or []
    lines.append("  Read: " + "; ".join(read))
    for kind in kinds:
        lines.append(f"  {ADVICE[kind].replace('<timer>', unit['timer'])}")
    return "\n".join(lines)


def report_dir(options: argparse.Namespace) -> Path:
    return Path(options.state).parent / "reports"


def write_report(
    options: argparse.Namespace, now: float, kind: str, body: str
) -> tuple[Path, str]:
    """(the report's path, "" or why it could not be written). A dry run writes nothing."""
    path = report_dir(options) / f"{time.strftime('%Y%m%dT%H%M%SZ', time.gmtime(now))}-{kind}.txt"
    if options.dry_run:
        return path, ""
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(body.rstrip("\n") + "\n")
    except OSError as error:
        log(f"  cannot write {path}: {error}")
        return path, str(error)
    return path, ""


def prune_reports(options: argparse.Namespace) -> None:
    """Delete this watch's reports older than REPORT_KEEP."""
    if options.dry_run:
        return
    cutoff = time.time() - REPORT_KEEP
    try:
        entries = list(report_dir(options).glob("*.txt"))
    except OSError:
        return
    for entry in entries:
        try:
            if entry.stat().st_mtime < cutoff:
                entry.unlink()
        except OSError:
            continue


def fit(head: str, items: list[str], tail: str, limit: int = MESSAGE_LIMIT) -> str:
    """`head`, as many of `items` as fit, and `tail`, in at most `limit` characters.

    Items that do not fit are counted; a first item longer than the room left is cut.
    """

    def compose(shown: list[str], left: int) -> str:
        body = "; ".join(shown) + "." if shown else ""
        more = f" {left} more in the report." if left else ""
        return f"{head}{body}{more} {tail}"

    shown: list[str] = []
    for index, item in enumerate(items):
        left = len(items) - index - 1
        if len(compose(shown + [item], left)) <= limit:
            shown.append(item)
            continue
        if not shown:
            room = limit - len(compose([""], left)) - 1
            shown.append(item[: max(0, room)].rstrip() + "…")
            continue
        return compose(shown, len(items) - len(shown))
    return compose(shown, 0)


# ------------------------------------------------------------------------------- state


class State:
    """The one file this watch owns: its open conditions.

    Opened under an exclusive, non-blocking flock for the whole run, so a hand run and the timer
    can never both decide that a condition is new; the loser skips its period.
    """

    def __init__(self, path: Path) -> None:
        self.path = path
        path.parent.mkdir(parents=True, exist_ok=True)
        self.handle = open(path, "a+")
        try:
            fcntl.flock(self.handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
            self.locked = True
        except OSError:
            self.locked = False
            self.data = {}
            return
        self.handle.seek(0)
        try:
            self.data = json.loads(self.handle.read() or "{}")
        except ValueError:
            self.data = {}

    def commit(self, options: argparse.Namespace) -> None:
        if options.dry_run and not options.write_state:
            return
        self.handle.seek(0)
        self.handle.truncate()
        json.dump(self.data, self.handle, indent=1, sort_keys=True)
        self.handle.flush()
        os.fsync(self.handle.fileno())

    def close(self) -> None:
        try:
            self.handle.close()
        except OSError:
            pass


# ------------------------------------------------------------------------------- one run


def assess(
    options: argparse.Namespace,
    now: float,
    live: bool,
    run_times: dict | None = None,
) -> tuple[list[dict], dict, dict, dict]:
    """(units, counts by service, findings by service, window start by service).

    `run_times` is the state file's cache of each unit's p99 run time (run_time_history); a
    report passes none and reads what it needs.
    """
    units = discover()
    # A `max_run=` in the expected list is the owner's own statement of how long a run of that
    # unit may take; it is carried on the unit so stuck_limit uses it (see stuck_limit).
    entries, _ = expected_timers(Path(options.expected))
    for unit in units:
        entry = entries.get(unit["timer"]) or {}
        if entry.get("max_run"):
            unit["max_run"] = entry["max_run"]
    periodic = [unit for unit in units if unit.get("period")]
    windows = {unit["service"]: window_for(unit, options) for unit in periodic}
    since = now - max(windows.values(), default=options.window)
    runs = runs_from_records(journal_records(sorted(windows), since, now))
    # Only a run already past the earliest its limit can be may be NEVER ENDS, so only those
    # units need their run time history.
    long_running = [
        unit
        for unit in periodic
        if live
        and unit.get("service_state") in RUNNING_STATES
        and unit.get("run_started")
        and now - unit["run_started"] > stuck_earliest(unit, options)
    ]
    history = run_time_history(
        long_running, now, run_times if run_times is not None else {}
    )
    counts: dict[str, dict] = {}
    findings: dict[str, dict[str, str]] = {}
    starts: dict[str, float] = {}
    for unit in periodic:
        service = unit["service"]
        starts[service] = now - windows[service]
        counts[service] = tally(
            runs.get(service, []),
            starts[service],
            now,
            live_invocation=unit.get("invocation", "") if live else "",
            oneshot=unit.get("service_type") in {"oneshot", ""},
        )
        findings[service] = judge(
            unit,
            counts[service],
            now,
            options,
            live=live,
            limit=stuck_limit(unit, options, history[service])
            if service in history
            else None,
        )
    return units, counts, findings, starts


def assess_expected(
    options: argparse.Namespace, now: float, units: list[dict], live: bool
) -> tuple[dict, dict, list[dict], dict, str]:
    """(expected timer states, their findings, the stream jobs, their findings, list error).

    Cheap: the list is one small file, the stream jobs are a handful of small files, and the
    only systemd call is the one `expected_state` makes for a name this box does not have
    enabled.
    """
    entries, error = expected_timers(Path(options.expected))
    states = expected_state(entries, units)
    timer_found = judge_expected(states, now, options, live=live)
    jobs = stream_jobs(options)
    job_found = judge_jobs(jobs, now, options) if live else {}
    return states, timer_found, jobs, job_found, error


def run_once(options: argparse.Namespace) -> int:
    now = options.at or time.time()
    live = options.at is None

    if options.report:
        units, counts, findings, starts = assess(options, now, live)
        states, timer_found, jobs, job_found, list_error = assess_expected(
            options, now, units, live
        )
        rows = [
            reading(unit, counts.get(unit["service"]), now, options) for unit in units
        ]
        if options.json:
            print(
                json.dumps(
                    {
                        "at": iso(now),
                        "units": rows,
                        "findings": findings,
                        "expected": {
                            "list": str(options.expected),
                            "error": list_error,
                            "timers": states,
                            "findings": timer_found,
                        },
                        "stream_jobs": {"jobs": jobs, "findings": job_found},
                    },
                    indent=1,
                    sort_keys=True,
                )
            )
        else:
            print(report_text(rows, findings, now, live))
            print()
            print(expected_text(states, jobs, timer_found, job_found, list_error))
        return 0

    envoy = Envoy(timeout=options.http_timeout)
    state = State(options.state)
    if not state.locked:
        log(f"another run holds {options.state}; skipping this period")
        return 0
    run_times: dict = state.data.setdefault("run_times", {})
    units, counts, findings, starts = assess(options, now, live, run_times)
    states, timer_found, jobs, job_found, list_error = assess_expected(
        options, now, units, live
    )
    if list_error:
        log(f"the expected timer list {options.expected} could not be read: {list_error}")
    incidents: dict = state.data.setdefault("incidents", {})
    by_service = {unit["service"]: unit for unit in units if unit.get("period")}
    by_job = {job["name"]: job for job in jobs}
    for service in [name for name in run_times if name not in by_service]:
        run_times.pop(service)
    opened: dict[str, dict[str, str]] = {}
    opened_expected: dict[str, dict[str, str]] = {}
    opened_jobs: dict[str, dict[str, str]] = {}
    cleared: list[str] = []

    for service, unit in sorted(by_service.items()):
        for kind in KINDS:
            key = f"{service}|{kind}"
            incident = incidents.get(key)
            if not judged(unit, kind):
                if incidents.pop(key, None) is not None:
                    log(
                        f"  {service}: {HEADLINE[kind]} closed unsaid; {' '.join(unit['on_failure'])}"
                        " says its failed runs"
                    )
                continue
            why = findings[service].get(kind)
            if why:
                if not incident:
                    incidents[key] = {"opened_at": now, "why": why}
                    opened.setdefault(service, {})[kind] = why
                else:
                    # Still true is no new fact: it is kept, and not said again.
                    incident["why"] = why
            elif incident and clears(
                kind, unit, counts[service], findings[service], options
            ):
                cleared.append(
                    f"{service} {HEADLINE[kind]} cleared after {human_time(now - incident['opened_at'])}"
                )
                incidents.pop(key)
    # An expected timer, and a stream job, keep their own conditions. Their keys are the timer
    # name and `job:<name>`, never a service, so the two sets cannot collide.
    for name in sorted(states):
        for kind in EXPECTED_KINDS:
            key = f"{name}|{kind}"
            incident = incidents.get(key)
            why = (timer_found.get(name) or {}).get(kind)
            if why:
                if not incident:
                    incidents[key] = {"opened_at": now, "why": why}
                    opened_expected.setdefault(name, {})[kind] = why
                else:
                    incident["why"] = why
            elif incident:
                cleared.append(
                    f"{name} {HEADLINE[kind]} cleared after {human_time(now - incident['opened_at'])}"
                )
                incidents.pop(key)
    for name in sorted(by_job):
        for kind in JOB_KINDS:
            key = f"job:{name}|{kind}"
            incident = incidents.get(key)
            why = (job_found.get(name) or {}).get(kind)
            if why:
                if not incident:
                    incidents[key] = {"opened_at": now, "why": why}
                    opened_jobs.setdefault(name, {})[kind] = why
                else:
                    incident["why"] = why
            elif incident:
                cleared.append(
                    f"stream job {name} {HEADLINE[kind]} cleared after"
                    f" {human_time(now - incident['opened_at'])}"
                )
                incidents.pop(key)
    # A unit whose timer is gone cannot be judged; its conditions close with that said. A name
    # taken out of the expected list, or a job file deleted, closes the same way: the lead who
    # removed it decided it, and this watch says so once and forgets it.
    for key in sorted(incidents):
        name, _, kind = key.partition("|")
        if kind in EXPECTED_KINDS:
            if name not in states:
                cleared.append(
                    f"{name} {HEADLINE.get(kind, kind)} closed: it is no longer in {options.expected}"
                )
                incidents.pop(key)
            continue
        if kind in JOB_KINDS:
            if name.removeprefix("job:") not in by_job:
                cleared.append(
                    f"{name} {HEADLINE.get(kind, kind)} closed: its job file is gone"
                )
                incidents.pop(key)
            continue
        if name not in by_service:
            cleared.append(
                f"{name} {HEADLINE.get(kind, kind)} closed: no loaded timer starts this unit any more"
            )
            incidents.pop(key)

    host = socket.gethostname()
    message = ""
    report = ""
    any_opened = bool(opened or opened_expected or opened_jobs)
    if any_opened or cleared:
        sections = [
            f"unit-health-watch on {host} at {iso(now)}. It only reports; it changed no unit."
        ]
        blocks = [
            unit_block(
                by_service[service],
                counts[service],
                kinds,
                starts[service],
                now,
                own_line_for(service, counts[service], starts[service], now),
            )
            for service, kinds in sorted(opened.items())
        ]
        blocks += [
            expected_block(name, states[name], kinds, Path(options.expected))
            for name, kinds in sorted(opened_expected.items())
        ]
        blocks += [
            job_block(by_job[name], kinds) for name, kinds in sorted(opened_jobs.items())
        ]
        if blocks:
            sections.append("Opened:\n\n" + "\n\n".join(blocks))
        if cleared:
            sections.append("Cleared:\n" + "\n".join(f"  {line}." for line in cleared))
        rows = [reading(unit, counts.get(unit["service"]), now, options) for unit in units]
        sections.append("Every timer now:\n" + report_text(rows, findings, now, live))
        sections.append(
            f"The expected list ({options.expected}) and the stream jobs now:\n"
            + expected_text(states, jobs, timer_found, job_found, list_error)
        )
        sections.append(f"How it judges: {Path(os.path.realpath(__file__))}.md")
        report = "\n\n".join(sections)
        path, error = write_report(options, now, "open" if any_opened else "clear", report)
        tail = (
            f"Full report: {path}"
            if not error
            else f"No report ({error}); `unit-health-watch --report` reads every timer now."
        )
        if any_opened:
            items = [
                f"{service} {HEADLINE[kind]} - {why}"
                for service, kinds in sorted(opened.items())
                for kind, why in kinds.items()
            ]
            items += [
                f"{name} {HEADLINE[kind]} - {why}"
                for name, kinds in sorted(opened_expected.items())
                for kind, why in kinds.items()
            ]
            items += [
                f"stream job {name} {HEADLINE[kind]} - {why}"
                for name, kinds in sorted(opened_jobs.items())
                for kind, why in kinds.items()
            ]
            # The headline names what this run found. A run that found only a missing timer
            # must not open with UNIT RUNS NOT COMPLETING: the lead reads the first words and
            # goes to the journal of a unit that is not there.
            first_kind = next(
                (
                    kind
                    for kinds in (
                        *opened.values(),
                        *opened_expected.values(),
                        *opened_jobs.values(),
                    )
                    for kind in kinds
                ),
                "",
            )
            head = (
                f"UNIT RUNS NOT COMPLETING on {host}, for the box-health lead: "
                if opened
                else f"{HEADLINE[first_kind]} on {host}, for the box-health lead: "
            )
            message = fit(head, items + [f"also {line}" for line in cleared], tail)
        else:
            message = fit(f"UNIT HEALTH CLEARED on {host}: ", cleared, tail)
    prune_reports(options)

    # Sessions nobody will restart. Separate from everything above: its own reader, its own
    # message per id, and its own reader -- one person, not the box-health role. It runs on a
    # live pass only, since `--at` replays a past hour of the journal and the registry and the
    # transcripts on disk are of now.
    if live:
        report_dead_sessions(envoy, state, options, now)

    state.data["last_run"] = now
    state.data["last_summary"] = {
        service: {
            key: counts[service][key]
            for key in ("started", "completed", "killed", "failed")
        }
        for service in counts
    }
    state.commit(options)
    state.close()

    log(
        f"checked {len(by_service)} periodic timer(s) of {len(units)},"
        f" {len(states)} expected timer(s) and {len(jobs)} stream job(s);"
        f" open: {len(incidents)}; new:"
        f" {sum(len(kinds) for kinds in (*opened.values(), *opened_expected.values(), *opened_jobs.values()))};"
        f" cleared: {len(cleared)}"
    )
    if not message:
        return 0
    if options.print_alert or options.dry_run:
        print(message + "\n")
    if options.dry_run:
        print(report + "\n")
        return 0
    target = tell_box_health(envoy, message)
    if target:
        log(f"told {target}")
    else:
        # The state already records the news as said, so this line is the only trace that it
        # reached nobody.
        log("NOBODY HEARD IT: the message was refused by every Envoy route; see above")
    return 0


def parse_at(text: str) -> float:
    match = re.fullmatch(
        r"(\d{4}-\d\d-\d\d)[T ](\d\d:\d\d)(?::(\d\d))?Z?", text.strip()
    )
    if not match:
        raise argparse.ArgumentTypeError(
            f"{text!r} is not a UTC time like 2026-11-02T11:00Z"
        )
    stamp = f"{match.group(1)} {match.group(2)}:{match.group(3) or '00'}"
    return float(calendar.timegm(time.strptime(stamp, "%Y-%m-%d %H:%M:%S")))


def main() -> int:
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument(
        "--window",
        type=float,
        default=3600.0,
        help="seconds of runs to count (default 3600; two periods when longer)",
    )
    parser.add_argument(
        "--killed-share",
        type=float,
        default=0.25,
        help="alert when more than this share of the runs that ended were killed at the time limit (default 0.25)",
    )
    parser.add_argument(
        "--min-killed",
        type=int,
        default=2,
        help="killed runs needed before the share counts (default 2)",
    )
    parser.add_argument(
        "--clear-factor",
        type=float,
        default=0.5,
        help="the kill share clears at this fraction of its bar (default 0.5)",
    )
    parser.add_argument(
        "--stuck-after",
        type=float,
        default=900.0,
        help="a run is stuck only after this many seconds as well as two periods, or twice its"
        " p99 run time when that is longer (default 900)",
    )
    parser.add_argument(
        "--state",
        type=Path,
        default=DEFAULT_STATE,
        help=f"state file (default {DEFAULT_STATE})",
    )
    parser.add_argument(
        "--expected",
        type=Path,
        default=DEFAULT_EXPECTED,
        help=f"the list of timers that must be enabled on this box (default {DEFAULT_EXPECTED})",
    )
    parser.add_argument(
        "--stream-jobs",
        type=Path,
        default=DEFAULT_STREAM_JOBS,
        help=f"the streams' job files, *.job (default {DEFAULT_STREAM_JOBS})",
    )
    parser.add_argument(
        "--stream-job-state",
        type=Path,
        default=DEFAULT_STREAM_JOB_STATE,
        help=f"what scripts/stream-job records per job (default {DEFAULT_STREAM_JOB_STATE})",
    )
    parser.add_argument(
        "--registry",
        type=Path,
        default=DEFAULT_RESTART_REGISTRY,
        help="the restart registry whose auto_restart=yes sessions are reported when they die"
        f" and nothing brings them back (default {DEFAULT_RESTART_REGISTRY})",
    )
    parser.add_argument(
        "--dead-silence",
        type=float,
        default=DEAD_SESSION_SILENCE,
        help="seconds without a transcript write, with no process holding it, before a"
        f" registered session is called gone (default {DEAD_SESSION_SILENCE:.0f})",
    )
    parser.add_argument(
        "--reboot-window",
        type=Path,
        default=DEFAULT_REBOOT_WINDOW,
        help="while this file exists, dead sessions are logged and nobody is told, for a"
        f" planned reboot (default {DEFAULT_REBOOT_WINDOW})",
    )
    parser.add_argument(
        "--transcripts",
        type=Path,
        default=DEFAULT_TRANSCRIPTS,
        help="where omp keeps this machine's transcripts, used to find a registered session's"
        f" own file by its id (default {DEFAULT_TRANSCRIPTS})",
    )
    parser.add_argument(
        "--http-timeout",
        type=float,
        default=8.0,
        help="Envoy request timeout (default 8 s)",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="decide and print, send nothing, write no state",
    )
    parser.add_argument(
        "--write-state",
        action="store_true",
        help="with --dry-run, still write the state file",
    )
    parser.add_argument(
        "--print-alert",
        action="store_true",
        help="print a message to stdout as well as sending it",
    )
    parser.add_argument(
        "--report",
        action="store_true",
        help="print every timer's reading now; send nothing, write no state",
    )
    parser.add_argument(
        "--json", action="store_true", help="with --report, one JSON object"
    )
    parser.add_argument(
        "--at",
        type=parse_at,
        default=None,
        help="with --report, count the window ending at this UTC time (2026-11-02T11:00Z); timer state is not judged",
    )
    options = parser.parse_args()
    box_health_owner()  # refuse an unusable BOX_HEALTH_OWNER before any work
    if options.at is not None and not options.report:
        parser.error("--at reads the past and only works with --report")
    return run_once(options)


if __name__ == "__main__":
    raise SystemExit(main())
