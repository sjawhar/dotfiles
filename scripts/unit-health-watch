)
# A timer in that list that has not fired for more than this many of its own periods is said.
# Three, not two: TIMER STOPPED FIRING already says a timer that stops while the box has it,
# and this is the coarse net for a timer that came back wrong after a reset.
EXPECTED_PERIODS = 3.0

# The streams' standing jobs (scripts/stream-job): the job files, and the state the runner
