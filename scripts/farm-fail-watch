#!/usr/bin/env python3
"""The build farm's failure watch: what killed a farm job, and what the lane should do.

Why this exists, and why it had to change (dispatch://OSSV-175, 2026-11-04):

  Kubernetes reports an ephemeral-storage eviction of a container as `OOMKilled` with exit
  137, exactly as it reports a memory kill. The watch read the exit code and the memory
  limit and never looked at the disk peak, so on 2026-11-04 at 21:09Z it told an OSS Verify
  lane that farm/20261104t210028z-2d717d (spirv-tools/spvtools_binary_parser_fuzzer,
  oft-check) was OOM-killed at its 8503Mi memory limit and advised at least 1.25 x that.
  The pod's own numbers: memory peak 1.89 GiB of 8503Mi (22%), disk peak 19.66 GiB of a
  4Gi ephemeral-storage request (491%), and the kernel's `oom_kill` counter 0. The kill was
  disk. A lane that followed the advice would have bought memory it did not need and been
  killed again at the same disk size.

So the rule here is: NEVER name a resource from the exit code. Compare each peak against
ITS OWN bound -- memory peak against the memory limit, disk peak against the
ephemeral-storage request -- and name the one that was at its bound. Name both when both
are near theirs, saying which was closer. When the evidence does not separate them, say so;
"the kill reason is not distinguishable from these" is a better message than a confident
wrong one. The advice then follows the named resource, and a disk kill never advises a
memory raise.

Evidence, in the order it is preferred (each part is optional; the message says what was
missing):
  the pod            `kubectl -n <ns> get pod <pod> -o json`: the job container's
                     terminated reason and exit code, and the container's own memory limit
                     and ephemeral-storage request. A killed pod is often already gone.
  result.json        the farm's own record, gs://<bucket>/out/ossv/<run>/result.json:
                     memory_peak_bytes, disk_peak_bytes, oom_kill, the failed pods.
  usage.json         the sampler's last sample, beside it, when result.json has no peaks.
  job.json           gs://<bucket>/in/ossv/<run>/job.json: the unit, the kind, the sizes
                     the job asked for and `size.mode`, which the measured-size warning
                     below needs.
The bucket is the one the farm recorded for the run in $OSSV_N6_DIR/job-buckets/<run>
(/mnt/nvme/<user>/ossv-n6 by default), else $OSSV_RUNS_BUCKET.

The second defect of that night is another team's (the CI/CD lead, bin/ossv-job-farm): the
farm's measured sizing keys a size by unit, kind and compute class and NOT by whether the
job has a build store, so a store-less run of a unit whose history is store-backed is sized
at that history's disk peak (about 1.6 GiB there) and killed at about 20 GiB. This watch
does not fix it; where it reports a disk kill of a job whose size came from the index
(`size.mode=measured`) it adds one line naming the risk and telling the lane to pass
`--disk` explicitly.
"""

from __future__ import annotations

import argparse
from datetime import datetime, timedelta, timezone
import glob
import json
import math
import os
import re
import subprocess
import sys

GIB = 1 << 30

# A resource is AT its bound when its peak reaches this share of it. The kernel kills a
# container AT memory.max, and the kubelet evicts a pod at or past its ephemeral-storage
# request, so the resource that ended the job reads at or above 1.0 -- but the last sample
# before a kill is a sample, not the instant of death (the sampler here reads every 15 s),
# so a peak a little under the bound still counts.
AT_BOUND = 0.95
# NEAR its bound: close enough that it cannot be ruled out while the other is at its bound.
NEAR_BOUND = 0.80
# The margin a new size gets over the measured peak, matching the farm's own disk rule
# (max(4Gi, 1.3 x the peak)) and its memory margin.
MARGIN = 1.3
# The memory case's other arm: when the largest single process held less than this share of
# the limit, no single process can be made to fit by a bigger pod -- the job ran too many at
# once, and serialising is the fix, not memory.
SERIALISE_SHARE = 0.5
# The memory case's fallback when the sampler recorded no per-process memory (CURL,
# 2026-11-04 21:25Z). `cpu_last_cores` at the last sample before the kill, against the job's
# core count: at or above this share of it, many processes were running when the total
# reached the limit -- the parallel case. farm/20261104t204327z-bda302 read 29.336 of 31.0
# cores (95%) with a 56.8 GiB peak at its 56Gi limit: 29 processes of about 2 GiB each.
PARALLEL_SHARE = 0.7
# At or below this many cores, the others had finished and one process was alone: the
# single oversized step, the one shape a bigger pod fixes.
ALONE_CORES = 1.5
# The N6 farm's runs bucket, where a run's job.json and result.json live when this machine
# has no job-buckets record of the run (devbox/sami-devbox-check, N6_BUCKETS).
RUNS_BUCKET = "gs://theorem-ossv-runs"

# Monitoring samples every 60 s, occasionally 120 s. Allow 5 s of timestamp jitter,
# 0.10 GiB of drawdown from the running high, and pauses shorter than five minutes.
# A sustained climb needs ten minutes of coverage and at least 0.25 GiB gained in
# EVERY five-minute window (ending at the next sample). This rejects a late spike or
# a five-minute plateau without requiring every rounded reading to rise strictly.
SERIES_MAX_GAP = 125
SERIES_MIN_SPAN = 600
SERIES_WINDOW = 300
SERIES_DIP_GIB = 0.10
SERIES_MIN_GAIN_GIB = 0.25


def gib(value: float | None) -> str:
    """BYTES as GiB, for a message a person reads."""
    return "unknown" if value is None else f"{value / GIB:.2f} GiB"


def share(peak: float | None, bound: float | None) -> float | None:
    """PEAK as a share of its own BOUND, or None when either is unknown."""
    if peak is None or not bound:
        return None
    return peak / bound


def pct(value: float | None) -> str:
    return "unknown" if value is None else f"{value:.0%}"


def size_bytes(text: str | int | float | None) -> int | None:
    """A Kubernetes quantity ("8503Mi", "4Gi", "2000000") as bytes."""
    if text is None:
        return None
    if isinstance(text, (int, float)):
        return int(text)
    match = re.fullmatch(r"\s*(\d+(?:\.\d+)?)\s*([EPTGMK]i?|m)?\s*", str(text))
    if not match:
        return None
    scale = {
        None: 1, "": 1, "m": 0.001,
        "K": 10 ** 3, "M": 10 ** 6, "G": 10 ** 9, "T": 10 ** 12, "P": 10 ** 15, "E": 10 ** 18,
        "Ki": 1 << 10, "Mi": 1 << 20, "Gi": 1 << 30, "Ti": 1 << 40, "Pi": 1 << 50, "Ei": 1 << 60,
    }[match.group(2)]
    return int(float(match.group(1)) * scale)


def whole_gib(value: float) -> str:
    """A size a lane can pass to the farm: whole GiB, rounded up, at least 1Gi."""
    return f"{max(1, math.ceil(value / GIB))}Gi"


def unit_name(label: str | None) -> str | None:
    """The unit as a lane writes it. The pod label carries `__` where the name has `/`,
    since a label value may not hold a slash."""
    return label.replace("__", "/", 1) if label else label


def bound_text(raw, byte_count: float | None) -> str:
    """A bound as the lane passed it and as a size to compare: "8503Mi (8.30 GiB)"."""
    if byte_count is None:
        return "unknown"
    return f"{raw} ({gib(byte_count)})" if raw else gib(byte_count)


# --- the evidence -------------------------------------------------------------------------


def number(value) -> float | None:
    return float(value) if isinstance(value, (int, float)) and not isinstance(value, bool) else None


def pod_evidence(pod: dict | None) -> dict:
    """The job container's end and its own bounds, from a pod object. {} for no pod."""
    if not pod:
        return {}
    found: dict = {"name": (pod.get("metadata") or {}).get("name")}
    for status in (pod.get("status") or {}).get("containerStatuses") or []:
        if status.get("name") != "job":
            continue
        terminated = (status.get("state") or {}).get("terminated") or {}
        found["reason"] = terminated.get("reason")
        found["exit_code"] = terminated.get("exitCode")
        found["finished_at"] = terminated.get("finishedAt")
        found["started_at"] = terminated.get("startedAt")
    for container in (pod.get("spec") or {}).get("containers") or []:
        if container.get("name") != "job":
            continue
        resources = container.get("resources") or {}
        limits = resources.get("limits") or {}
        requests = resources.get("requests") or {}
        found["memory_limit_text"] = limits.get("memory") or requests.get("memory")
        found["memory_limit_bytes"] = size_bytes(found["memory_limit_text"])
        # Ephemeral storage is evicted against the REQUEST, which is what the pod is
        # guaranteed; a limit above it does not keep the pod alive on a squeezed node.
        found["disk_request_text"] = (
            requests.get("ephemeral-storage") or limits.get("ephemeral-storage"))
        found["disk_request_bytes"] = size_bytes(found["disk_request_text"])
    reason = (pod.get("status") or {}).get("reason")
    if reason:
        found["pod_reason"] = reason
    message = (pod.get("status") or {}).get("message")
    if message:
        found["pod_message"] = message
    return {key: value for key, value in found.items() if value is not None}


# The nodes' own record of every container the kernel or the kubelet killed. It outlives the
# pod, the Job and result.json, so it is the last place a killed pod can still be named.
FAILURES_RECORD = os.environ.get(
    "FARM_FAILURES_RECORD", "/mnt/durable/sami/tmp/farm-util/failures.jsonl")


def failures_evidence(run: str | None, path: str | None = None) -> dict:
    """What the failures record knows about one run: its pod, and the largest process killed.

    `killedRssKb` is the resident size of the task the kernel chose, which is the largest
    single process at the moment of death. It is the field that separates a unit wanting one
    big allocation from a unit running too many workers at once: CURL's 9edfc2 died at a 12Gi
    limit with a largest process of 3.0 GiB, so the 11.19 GiB peak was sixteen workers, not one
    heavy file, and the fix was `-j`, not memory (2026-11-06).

    Rows naming another run are never borrowed, and an unreadable record is not an error: the
    caller is already in a failure path and must not be stopped by a missing file.
    """
    if not run:
        return {}
    found: dict = {}
    try:
        with open(path or FAILURES_RECORD, encoding="utf-8", errors="replace") as handle:
            for line in handle:
                if run not in line:
                    continue
                try:
                    row = json.loads(line)
                except ValueError:
                    continue
                pod = row.get("pod")
                if not pod or run not in pod:
                    continue
                found["pod"] = pod
                found["pod_from"] = "failures record"
                killed = number(row.get("killedRssKb"))
                if not killed:
                    continue
                found["killed_rss_bytes"] = int(killed) * 1024
                found["killed_task"] = row.get("task")
                found["killed_container"] = row.get("container")
                # The denominator must be the limit of the thing that ran out. Harbor runs its
                # agent and its verifier each in a NESTED container capped at 32 GiB inside a
                # 96 GiB pod: two `lean` kills at 20.4 GiB were 64% of the container and 21% of
                # the pod, and this code judged them against the pod and answered "serialise --
                # too many at once" when the right answer was a bigger limit (BET-628,
                # 2026-11-06). The record carries the nested container's id and an EMPTY
                # `resources`, so where it records no limit of its own, no share is computed and
                # no verdict is reached: a missing denominator must produce no answer rather than
                # a confident wrong one.
                limit = size_bytes(((row.get("resources") or {}).get("limits") or {}).get("memory"))
                if limit:
                    found["killed_limit_bytes"] = limit
                    found["largest_process_bytes"] = int(killed) * 1024
    except OSError:
        return {}
    return found


def evidence(job: dict | None, result: dict | None, pod: dict | None,
             failures: str | None = None) -> dict:
    """Everything the verdict is allowed to read, in one dict.

    The pod is preferred for the bounds and the end, because it is what the kubelet acted
    on; job.json's sizes are what the farm ASKED for, which an admission policy may have
    changed. The peaks come from the farm's record, which is the only place they exist once
    the pod is gone.
    """
    job = job or {}
    result = result or {}
    from_pod = pod_evidence(pod)
    failed = (result.get("failed_pods") or [{}])[-1]
    terminated = ((failed.get("job") or {}).get("terminated")) or {}
    found = {
        "run": job.get("id") or result.get("run"),
        "unit": unit_name((job.get("labels") or {}).get("ossv-unit")),
        "kind": (job.get("labels") or {}).get("ossv-kind"),
        "pod": from_pod.get("name") or failed.get("name"),
        # Owner keys, best first. `theorem.dev/omp-session` is the one a submitter should stamp
        # (INFRA lead, 2026-11-05): the farm's failure notifier routes by it, and the scratch
        # script behind the unlabelled `pi-shjob-*` Jobs now writes it on the Job and the pod
        # template. `ossv-owner` stays here because existing Jobs carry it, and it is read LAST
        # on purpose: in cluster-grants that key also EXEMPTS a Job from build-cpu-burst
        # admission, so a lane that adds it to get itself attributed changes its own scheduling
        # as a side effect. Do not advise anyone to add `ossv-owner`; advise the omp-session key.
        "owner": ((job.get("omp_session") or {}).get("id")
                  or (job.get("labels") or {}).get("theorem.dev/omp-session")
                  or (job.get("labels") or {}).get("ossv-owner")),
        "reason": from_pod.get("reason") or terminated.get("reason"),
        "exit_code": from_pod.get("exit_code", terminated.get("exitCode")),
        "finished_at": from_pod.get("finished_at") or terminated.get("finishedAt") or result.get("finished"),
        "started_at": from_pod.get("started_at") or terminated.get("startedAt"),
        "pod_reason": from_pod.get("pod_reason") or failed.get("reason"),
        "pod_message": from_pod.get("pod_message") or failed.get("message"),
        "memory_limit_bytes": from_pod.get("memory_limit_bytes", size_bytes(job.get("memory"))),
        "memory_limit_text": from_pod.get("memory_limit_text") or job.get("memory"),
        "disk_request_bytes": from_pod.get("disk_request_bytes", size_bytes(job.get("disk"))),
        "disk_request_text": from_pod.get("disk_request_text") or job.get("disk"),
        "memory_peak_bytes": number(result.get("memory_peak_bytes")),
        "memory_peak_kind": result.get("memory_peak_kind"),
        "disk_peak_bytes": number(result.get("disk_peak_bytes")),
        "disk_peak_kind": result.get("disk_peak_kind"),
        "oom_kill": number(result.get("oom_kill")) or 0,
        # The sampler records this only when it saw the processes; absent for a job that
        # died between two samples, as farm/20261104t210028z-2d717d did (23 s of life).
        "largest_process_bytes": number(
            result.get("largest_process_bytes") or result.get("max_rss_bytes")),
        # How many processes the sampler saw at the peak. Named in the serialise advice,
        # because "the largest process held 21 of 48 GiB" invites the reader to look for the
        # missing 27 GiB somewhere exotic -- files on a memory-backed filesystem, say -- when
        # the ordinary answer is the other seven workers. On 2026-11-05 the box-health lead
        # read exactly that gap as files and told a lane so; the pod ran eight workers under
        # one parent and the measurement inside it showed file and shmem both 0.
        "process_count": number(
            result.get("process_count") or result.get("sampled_process_count")),
        # The last sample's cores, the stand-in for the per-process test when the log has
        # no per-process memory in it (CURL, 2026-11-04 21:25Z).
        "cpu_last_cores": number(result.get("cpu_last_cores")),
        "cpu_peak": number(result.get("cpu_peak")),
        "cpu_limit_cores": number(result.get("cpu_limit_cores")),
        "cpu_limit": number(job.get("cpu_limit")),
        "cpu": number(job.get("cpu")),
        "size_mode": (job.get("size") or {}).get("mode"),
        "size_index": (job.get("size") or {}).get("index"),
        "store": job.get("store"),
        "recent_disk_peaks": [number(peak.get("disk_peak_bytes"))
                              for peak in (job.get("size") or {}).get("recent_peaks") or []],
        # History is one unbounded-growth warning, not the only check: shell-offload jobs
        # have none. Their own Monitoring series can still show a sustained climb.
        "recent_memory_peaks": [number(peak.get("memory_peak_bytes"))
                                for peak in (job.get("size") or {}).get("recent_peaks") or []],
    }
    if not found.get("pod"):
        # The cluster and result.json can both have lost the pod: a lane that deletes a killed
        # Job, rather than let it retry at a limit that already killed it, is doing the right
        # thing and takes the pod with it. Without a name read_memory_shape returns `unknown /
        # no pod name`, which is the ONE answer the raise-or-fix rule cannot branch on -- so the
        # advice went branchless exactly for the lanes that cleaned up properly (CURL, 9edfc2,
        # 2026-11-06). The nodes' record has the name: 654 of 654 kernel-oom rows carry one.
        recovered = failures_evidence(found.get("run"), failures)
        for key, value in recovered.items():
            if found.get(key) is None:
                found[key] = value
    return found


def read_memory_shape(found: dict) -> dict:
    """Reuse pod-memory-series; keep only shape/rate, NEVER a peak usable for sizing.

    gVisor charges sandbox memory to the container in this node series. Its height may
    exceed the container limit, so it must not enter the farm's memory_peak_bytes path.
    A 60 s sampler sees a climb but cannot rule out a short spike.
    """
    unknown = {"status": "unknown"}
    pod = found.get("pod")
    if not pod:
        return dict(unknown, reason="no pod name")
    try:
        end = datetime.fromisoformat(found["finished_at"].replace("Z", "+00:00")) \
            if found.get("finished_at") else datetime.now(timezone.utc)
        start = datetime.fromisoformat(found["started_at"].replace("Z", "+00:00")) \
            if found.get("started_at") else end - timedelta(hours=6)
    except ValueError:
        return dict(unknown, reason="the job's time window could not be read")
    helper = os.path.join(os.path.dirname(os.path.abspath(__file__)), "pod-memory-series")
    text = run_text([helper, pod, start.isoformat().replace("+00:00", "Z"),
                     end.isoformat().replace("+00:00", "Z")])
    if not text:
        return dict(unknown, reason="pod-memory-series could not be read (no points or API access)")

    # Parse timestamped rows, not the helper's peak summary or bars. Never combine
    # sidecars with the job; shell-offload pods may instead have one differently named
    # container. Multiple streams for one container are ambiguous, not one trajectory.
    containers = {}
    points = None
    for line in text.splitlines():
        header = re.match(r"  container ([^:]+):", line)
        if header:
            name = header.group(1)
            if name in containers:
                return dict(unknown, reason="multiple memory series for one container")
            points = containers[name] = []
            continue
        sample = re.match(r"\s+(\d{4}-\S+)\s+(\d+(?:\.\d+)?) GiB(?:\s|$)", line)
        if sample and points is not None:
            try:
                stamp = datetime.fromisoformat(sample.group(1).replace("Z", "+00:00"))
                points.append((stamp.timestamp(), float(sample.group(2))))
            except ValueError:
                return dict(unknown, reason="a series timestamp could not be read")
    if "job" in containers:
        points = containers["job"]
    elif len(containers) == 1:
        points = next(iter(containers.values()))
    else:
        return dict(unknown, reason="no points for an identifiable job container")
    if not points:
        return dict(unknown, reason="no points for the job container")
    points.sort()
    span = points[-1][0] - points[0][0]
    if span < SERIES_MIN_SPAN:
        return dict(unknown, reason="fewer than ten minutes of series samples")
    if any(not 0 < right[0] - left[0] <= SERIES_MAX_GAP
           for left, right in zip(points, points[1:])):
        return dict(unknown, reason="series gaps exceed the 60 s sampler's one missed sample")
    if found.get("finished_at") and end.timestamp() - points[-1][0] > SERIES_MAX_GAP:
        return dict(unknown, reason="the series stops before the kill's last two minutes")

    high = points[0][1]
    window_end = 0
    for stamp, value in points:
        high = max(high, value)
        if high - value > SERIES_DIP_GIB + 1e-9:
            return {"status": "checked"}
        while window_end < len(points) and points[window_end][0] - stamp < SERIES_WINDOW:
            window_end += 1
        if window_end < len(points) and points[window_end][1] - value < SERIES_MIN_GAIN_GIB:
            return {"status": "checked"}
    return {"status": "unbounded", "minutes": span / 60,
            "rate_gib_per_minute": (points[-1][1] - points[0][1]) / (span / 60)}


# --- the verdict --------------------------------------------------------------------------


def verdict(found: dict) -> dict:
    """Which resource was at its bound: "memory", "disk", "both" or "unknown".

    Never the exit code: an ephemeral-storage eviction and a memory kill are both
    `OOMKilled`, exit 137. Each peak is compared with its own bound, and the kernel's
    `oom_kill` counter settles a memory kill on its own, since nothing but the memcg OOM
    killer raises it.
    """
    memory = share(found.get("memory_peak_bytes"), found.get("memory_limit_bytes"))
    disk = share(found.get("disk_peak_bytes"), found.get("disk_request_bytes"))
    kernel_oom = (found.get("oom_kill") or 0) > 0
    at_memory = kernel_oom or (memory is not None and memory >= AT_BOUND)
    at_disk = disk is not None and disk >= AT_BOUND
    near_memory = at_memory or (memory is not None and memory >= NEAR_BOUND)
    near_disk = at_disk or (disk is not None and disk >= NEAR_BOUND)
    state = {"memory_share": memory, "disk_share": disk, "kernel_oom": kernel_oom,
             "memory_known": memory is not None, "disk_known": disk is not None}

    if near_memory and near_disk:
        closer = "memory" if kernel_oom or (memory or 0) >= (disk or 0) else "disk"
        return dict(state, resource="both", closer=closer, why=(
            "both were at or near their own bound"
            + (", and the kernel's oom_kill counter names memory" if kernel_oom else "")))
    if near_memory:
        return dict(state, resource="memory", closer="memory", why=(
            f"the kernel's oom_kill counter is {int(found.get('oom_kill') or 0)}" if kernel_oom
            else "the memory peak reached its limit while the disk peak did not reach its request"))
    if near_disk:
        return dict(state, resource="disk", closer="disk", why=(
            "the disk peak passed its ephemeral-storage request while the memory peak stayed"
            " well under its limit"))
    return dict(state, resource="unknown", closer=None, why=(
        "neither peak reached its own bound"
        if memory is not None and disk is not None
        else "a peak or a bound is missing, so the two cannot be compared"))


def read_retry_of(bucket: str, parent_id: str) -> dict | None:
    """The limit and peak of the run this one is an OOM retry of, as facts and nothing more.

    A retry at a higher limit gives a second point on the same work. Whether the two points
    mean a job with a fixed appetite that was underestimated, or one that grows until it is
    stopped, is what the two numbers are FOR -- this reads them and draws no conclusion. The
    OSS Verify curl lane raised the distinction on 2026-11-06 with one pair (32Gi then 40Gi,
    peaks 33.28 and 41.36 GiB) and retracted its own reading of a single point when the
    second arrived; one pair is not enough to decide anything in code.
    """
    parent = parent_id.split("/", 1)[1] if "/" in parent_id else parent_id
    job = read_object(bucket, f"in/ossv/{parent}/job.json")
    result = read_object(bucket, f"out/ossv/{parent}/result.json")
    if job is None and result is None:
        return None
    return {"run": parent_id,
            "limit_text": (job or {}).get("memory"),
            "limit_bytes": size_bytes((job or {}).get("memory")),
            "peak_bytes": number((result or {}).get("memory_peak_bytes"))}


def retry_line(found: dict) -> str | None:
    """Both points on one line, with no reading of them attached."""
    of = found.get("retry_of")
    if not of:
        return None
    before = (f"{of['run']} was given {bound_text(of.get('limit_text'), of.get('limit_bytes'))}"
              f" and peaked at {gib(of.get('peak_bytes'))}")
    now = (f"this run was given {bound_text(found.get('memory_limit_text'), found.get('memory_limit_bytes'))}"
           f" and peaked at {gib(found.get('memory_peak_bytes'))}")
    return (f"THIS IS THE SECOND KILL OF THE SAME WORK: {before}; {now}."
            " Two points on one job say more than one does, and they are left here unread:"
            " a peak that lands at about the same figure both times is a fixed appetite that"
            " was underestimated, and a peak that follows the limit upward is something that"
            " grows until it is stopped, which more memory does not fix.")


# How many lines of the end of job.log are searched for a proof-script error, and the most
# that is quoted back. Measured on the OSS Verify curl lane's three runs of 2026-11-06
# (CURL, 02:33Z): a clean run of the tree held no `Error:` line at all in 28,060 lines;
# the two that died at the same 10Gi limit carried one 2 and 50 lines from the end. 40 was
# the window the lane first proposed and it misses the second of those, so 200 is used.
LOG_TAIL_LINES = 200
LOG_ERROR_QUOTE = 6


def read_script_error(bucket: str, run: str) -> str | None:
    """The error a Rocq run ended on, from the end of its job.log, or None.

    Why a killed job is asked this at all: a run that hits a syntax or elaboration error in a
    large context does not fail cheaply. The curl lane measured the same unit, the same tree
    and the same limit at 4.84 GiB when it compiled and 10.96 and 10.72 GiB when it did not --
    roughly double -- so at a limit sized for the clean run the broken one is OOM-killed, and
    it arrives here as a memory kill whose real cause is sitting in the last few lines of its
    own log. Advising more memory for that buys memory for a bug and costs another farm slot.
    """
    text = run_text(["gcloud", "storage", "cat", f"{bucket}/out/ossv/{run}/job.log"])
    if not text:
        return None
    tail = text.splitlines()[-LOG_TAIL_LINES:]
    for index, line in enumerate(tail):
        if line.startswith("Error:") or line.startswith("Error "):
            quoted = [part for part in tail[index:index + LOG_ERROR_QUOTE] if part.strip()]
            return "\n".join(quoted)
    return None


def script_error_advice(found: dict) -> str:
    """What to do about a kill whose log ends in an error: fix the error, do not buy memory."""
    return ("DO NOT RAISE MEMORY YET: this job's log ends in an error, so the kill may be a"
            " consequence of the error rather than of the size. A Rocq run that fails in a large"
            " context has been measured using about twice the memory of the same run that"
            " compiles (OSS Verify curl lane, 2026-11-06: 4.84 GiB against 10.96 and 10.72 GiB,"
            " same unit, same tree, same limit -- though all three are SAMPLED figures, see"
            " below, and the two larger ones ended in exit 143, a cancel, not an OOM kill)."
            " Fix the error, build it locally, and only re-measure the size if it still does not"
            " fit. The last lines of the log:\n" + str(found.get("script_error")))


def sampled_peak_advice(found: dict) -> str:
    """Label a gVisor sampled peak, and no longer refuse to size from it.

    On the gVisor `build` class the sandbox's cgroup has no `memory.peak`, so the farm records
    `memory_peak_kind: sampled`. Two claims were made about that figure on 2026-11-06 and both
    were retracted by the lanes that made them: a 1.5-to-3.5x gap against the kernel's peak, and
    "a sampled peak exceeded its cgroup while the kernel never acted" -- the kernel had acted,
    in a third record (the nodes' failures.jsonl) that neither lane had read.

    What the measurements actually show: two pairs of the same work measured both ways agree
    closely -- 29.13 GiB sampled against 29.66 kernel, and 11.76 and 11.52 against 11.88 and
    11.89. So there is no evidence for refusing to size from a sampled peak, and refusing would
    withhold the advice from most gVisor kills on a claim that does not hold. The notice says
    what kind of figure it is and leaves the sizing in place; six paired probes are in flight
    to settle whether the agreement holds in general.
    """
    return ("This job's peak is a SAMPLED figure (gVisor build class), not the kernel's"
            " memory.peak. Two pairs of identical work measured both ways agreed within about"
            " 1-2% (29.13 GiB sampled against 29.66 kernel; 11.76 and 11.52 against 11.88 and"
            " 11.89), so the size below is used as normal. Earlier claims of a 1.5-to-3.5x gap,"
            " and that a sampled peak can exceed a cgroup the kernel never enforced, were both"
            " RETRACTED by the lanes that made them on 2026-11-06. If this size proves wrong,"
            " re-measure on a class that records memory_peak_kind: kernel rather than applying"
            " any correction factor: none is established.")


def memory_advice(found: dict) -> str:
    """The sizing advice, with the sampled-peak label in front of it when one applies."""
    if found.get("script_error"):
        return script_error_advice(found)
    advice = _memory_sizing(found)
    if found.get("memory_peak_kind") == "sampled":
        return sampled_peak_advice(found) + "\n" + advice
    return advice


def _memory_sizing(found: dict) -> str:
    """A sustained series climb withholds sizing. Otherwise serialise when many processes
    ran at once, or size at 1.3 x the farm's peak when one process was simply too big.

    After the shape check, the per-process test is first: the largest process under half
    the limit means no bigger pod helps. The sampler records that only when it saw the
    processes, and
    a job that dies between two samples leaves none -- the log of
    farm/20261104t204327z-bda302 (killed at 56Gi, 21:22:12Z) was ten lines with no
    per-process memory in it at all. So when it is missing, `cpu_last_cores` at the last
    sample stands in (CURL, 2026-11-04 21:25Z): near the job's core count, many processes
    were running when the total reached the limit -- the parallel case, whose answer is
    fewer at once at the same limit; near 1, the others had finished and one process was
    alone -- the single oversized step, and only then is a bigger pod right. That is weaker
    evidence than the per-process samples, and the wording says so.
    """
    peak = found.get("memory_peak_bytes")
    limit = found.get("memory_limit_bytes")
    largest = found.get("largest_process_bytes")
    cores = found.get("cpu_last_cores")
    core_count = found.get("cpu_limit_cores") or found.get("cpu_limit") or found.get("cpu")
    shape = found.get("memory_shape") or {"status": "unknown", "reason": "series not read"}
    if shape["status"] == "unbounded":
        rate = shape["rate_gib_per_minute"]
        if limit:
            current = limit / GIB
            bought = (f"At that observed slope, raising the {current:g}Gi limit to"
                      f" {current * 1.25:g}Gi buys about {current * 0.25 / rate:.0f} more"
                      f" minutes; {current * 2:g}Gi buys about {current / rate:.0f} more minutes.")
        else:
            bought = (f"At that observed slope, another 16Gi of limit buys about"
                      f" {16 / rate:.0f} more minutes.")
        return (f"Memory growth looks unbounded: a climb of about {rate:.1f} GiB a minute"
                f" over {shape['minutes']:.0f} minutes with no plateau. {bought}"
                " In short, any limit you pick is a date, not a fix. Fix the job's growth before"
                " resubmitting, rather than buying memory. These are slope-only illustrations,"
                " not container kill-time predictions: gVisor includes sandbox memory in the"
                " node series. Trust the shape, never the height; do not size from it.")
    shape_note = (" Series checked: no sustained climb without a plateau; 60 s samples cannot"
                  " rule out a short spike." if shape["status"] == "checked" else
                  f" Memory shape unknown: {shape.get('reason', 'series not read')}; bounded"
                  " growth has not been checked. Read the series before buying memory.")
    sized = (f"--memory {whole_gib(MARGIN * peak)} (1.3 x the {gib(peak)} peak)"
             if peak is not None else None)
    # Every raise assumes bounded growth. History independently warns when a recent run
    # of the same unit and kind peaked above this run's limit: this peak may be what the
    # job was given, not what it needs.
    unbounded = None
    recent = [p for p in found.get("recent_memory_peaks") or [] if p]
    if recent and limit and max(recent) > limit:
        unbounded = (f" BUT A RECENT RUN OF THIS KIND PEAKED AT {gib(max(recent))}, above this"
                     f" run's {gib(limit)} limit, so this peak is not what the job needs -- it"
                     " is what it was given. Sizing from it will be killed again. Measure"
                     " whether the growth is bounded before buying memory; if it is not, the"
                     " fix is in the job, not in the limit.")

    count = found.get("process_count")
    if largest is not None and limit:
        if largest < SERIALISE_SHARE * limit:
            # Name the count and the arithmetic. A reader given only the largest process looks
            # for the rest of the limit somewhere else and can reach for an exotic answer;
            # given "8 processes, the largest 21 GiB", the rest is obviously the other seven.
            many = (f" The sampler saw {int(count)} processes, so the rest of the"
                    f" {gib(limit)} is the other {int(count) - 1}, not memory held somewhere"
                    " the samples do not show." if count and count > 1 else "")
            return (f"SERIALISE: the largest single process held {gib(largest)}, under half the"
                    f" {gib(limit)} limit, so the job ran too many at once and a bigger pod buys"
                    f" nothing.{many} Run the steps one at a time (fewer jobs, -j1)." + shape_note)
        return ((f"RAISE MEMORY to {sized}."
                 if sized else "RAISE MEMORY: no memory peak was recorded, so resubmit once"
                 " with the sampler's record kept and size from that peak at 1.3 x.")
                + (unbounded or "") + shape_note)

    weaker = ("no per-process samples in this job's log; from cpu_last_cores"
              f" {cores:.2f} of {float(core_count):.0f} cores at the last sample"
              if cores is not None and core_count else None)
    if weaker and cores >= PARALLEL_SHARE * float(core_count):
        return (f"SERIALISE, probably: {weaker}, this looks like the parallel case -- many"
                " processes running when the total reached the limit. The answer is fewer at"
                " once at the same limit (-j fewer), not a bigger pod. Confirm from the next"
                " run's per-process samples before buying memory." + shape_note)
    if weaker and cores <= ALONE_CORES:
        return ((f"RAISE MEMORY to {sized}. {weaker}, this looks like one process alone -- the"
                 " single oversized step, which only a bigger pod fixes."
                 if sized else f"RAISE MEMORY: {weaker}, this looks like one process alone, but"
                 " no memory peak was recorded to size from; resubmit once with the sampler's"
                 " record kept.") + (unbounded or "") + shape_note)
    if sized is None:
        return ("RAISE MEMORY: no memory peak was recorded, so resubmit once with the"
                " sampler's record kept and size from that peak at 1.3 x."
                + (unbounded or "") + shape_note)
    advice = f"RAISE MEMORY to {sized}."
    if weaker:
        advice += (f" {weaker}, which is neither the parallel case nor one process alone, so"
                   " the serialise test is unsettled; keep the next run's per-process samples.")
    elif found.get("killed_rss_bytes"):
        # The record named the killed task but not the limit of the container it died in --
        # a nested container, typically. Say the size and stop: a share against the pod's
        # limit is the wrong fraction and produced the wrong instruction once already.
        advice += (f" The kernel killed {found.get('killed_task') or 'a task'} at"
                   f" {gib(found['killed_rss_bytes'])}, but the record does not carry the memory"
                   " limit of the container it died in, so NO serialise-or-raise verdict is"
                   " reached here: that share must be taken against the container that ran out,"
                   " which for a nested container is not this pod's limit. Read that"
                   " container's own memory.max.")
    else:
        advice += (" The largest single process was not recorded and the last sample has no"
                   " cpu_last_cores, so the serialise test could not be applied.")
    return advice + (unbounded or "") + shape_note


def disk_advice(found: dict) -> str:
    peak = found.get("disk_peak_bytes")
    if peak is None:
        return ("RAISE DISK: no disk peak was recorded, so resubmit once with the sampler's"
                " record kept and size from that peak at 1.3 x.")
    return (f"RAISE DISK to --disk {whole_gib(MARGIN * peak)} (1.3 x the {gib(peak)} peak)."
            " Do not raise memory: it was not the bound.")


def store_warning(found: dict) -> str | None:
    """The other team's defect, named where it bites: a disk kill of a job the index sized.

    The farm's measured size is keyed by unit, kind and compute class and not by whether the
    job has a build store, so a store-less run of a unit whose history is store-backed gets
    that history's disk peak and is killed. Fixing it is the CI/CD lead's (bin/ossv-job-farm).
    """
    if found.get("size_mode") != "measured":
        return None
    peaks = [peak for peak in found.get("recent_disk_peaks") or [] if peak]
    history = f" Its recent runs' disk peaks are about {gib(max(peaks))}." if peaks else ""
    return ("WARNING: this job's size came from the index (size.mode=measured). The farm keys a"
            " measured size by unit, kind and compute class and NOT by whether the job has a"
            f" build store, so a store-less run of a store-backed unit is sized from"
            f" store-backed history and killed.{history} Pass --disk explicitly until the farm's"
            " sizing is fixed (the CI/CD lead's, bin/ossv-job-farm).")


def owner_line(found: dict) -> str:
    """Who this notice is for, and why that is a lane rather than an agent.

    `theorem.dev/omp-session` and `ossv-owner` both carry the SESSION id, and every agent of a
    session shares it, so the owner names a lane and not the agent that submitted the job. On
    2026-11-06 the OSS Verify curl lane had to broadcast to five live agents to find whose
    `farm/20261106t020425z-1af893` was, and the first to answer ruled itself out by its KIND
    (`n6-unit` against the job's `rocq-kit`), which was on the job all along. So the notice says
    it: the kind and the unit are what tell the agents of a lane apart.
    """
    owner, kind, unit = found.get("owner"), found.get("kind"), found.get("unit")
    if kind or unit:
        which = (f" This job is the agent running ossv-kind={kind or 'unlabelled'}, unit"
                 f" {unit or 'unlabelled'}: an agent on another kind or unit rules itself out"
                 f" from this line alone, without asking anyone.")
    else:
        which = (" The job carries neither ossv-kind nor ossv-unit, so nothing here tells one"
                 " agent from another; whoever submitted it has to answer.")
    if not owner:
        return ("OWNER NOT LABELLED: the job carries no theorem.dev/omp-session, so this notice"
                " could not be routed to a lane at all." + which)
    return (f"OWNER {owner} IS A SESSION, NOT AN AGENT -- every agent of that session shares the"
            f" label, so this names a lane.{which}")


def message(found: dict, call: dict | None = None) -> str:
    """The whole message as the lane receives it."""
    call = call or verdict(found)
    memory = (f"memory peak {gib(found.get('memory_peak_bytes'))} of its"
              f" {bound_text(found.get('memory_limit_text'), found.get('memory_limit_bytes'))}"
              f" limit ({pct(call['memory_share'])})")
    disk = (f"disk peak {gib(found.get('disk_peak_bytes'))} of its"
            f" {bound_text(found.get('disk_request_text'), found.get('disk_request_bytes'))}"
            f" ephemeral-storage request ({pct(call['disk_share'])})")
    head = (f"FARM JOB KILLED: {found.get('run')}"
            f" ({found.get('unit')}, {found.get('kind')})"
            f" at {found.get('finished_at')}, {found.get('reason')}, exit {found.get('exit_code')}.")
    lines = [head, owner_line(found)]
    second_kill = retry_line(found)
    if second_kill:
        lines.append(second_kill)

    if call["resource"] == "memory":
        lines.append(f"MEMORY was at its bound: {memory}; {disk}. ({call['why']}.)")
        lines.append(memory_advice(found))
    elif call["resource"] == "disk":
        lines.append(f"DISK, not memory: {disk}; {memory}."
                     " Kubernetes reports an ephemeral-storage eviction as OOMKilled, exit 137,"
                     " exactly as it reports a memory kill, so the exit code names neither.")
        lines.append(disk_advice(found))
    elif call["resource"] == "both":
        lines.append(f"BOTH were at their bound: {memory}; {disk}."
                     f" {call['closer'].upper()} was closer to its own bound.")
        lines.append(memory_advice(found))
        lines.append(disk_advice(found).replace(" Do not raise memory: it was not the bound.", ""))
    else:
        lines.append(f"NOT DISTINGUISHABLE: killed at exit {found.get('exit_code')}"
                     f" ({found.get('reason')}); {memory}; {disk};"
                     " the kill reason is not distinguishable from these"
                     f" ({call['why']}).")
        lines.append("DO NOT raise either size blindly. Resubmit the job once with the sampler's"
                     " record kept and read the peak that moves; if it is gone for good, ask the"
                     " farm for this run's result.json.")

    if call["resource"] in ("disk", "both"):
        warning = store_warning(found)
        if warning:
            lines.append(warning)
    return "\n".join(lines)


# --- reading a real job ---------------------------------------------------------------------


def run_text(args: list[str], timeout: int = 90) -> str | None:
    try:
        done = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.SubprocessError):
        return None
    return done.stdout if done.returncode == 0 and done.stdout.strip() else None


def bucket_roots() -> list[str]:
    """Where the farm's run index may be on this machine. A box's own user is not the host
    user whose /mnt/nvme the farm writes under (ubuntu in a box, sami on the host), so the
    directories are looked for rather than built from $USER."""
    named = os.environ.get("OSSV_N6_DIR")
    if named:
        return [named]
    return sorted(path for path in glob.glob("/mnt/nvme/*/ossv-n6") if os.path.isdir(path))


def bucket_of(run: str) -> str | None:
    """The bucket the farm recorded for this run, else $OSSV_RUNS_BUCKET, else the farm's
    own bucket -- the one devbox/sami-devbox-check names as the N6 runs bucket."""
    for root in bucket_roots():
        try:
            with open(os.path.join(root, "job-buckets", run), encoding="utf-8") as handle:
                recorded = handle.read().strip()
        except OSError:
            continue
        if recorded:
            return recorded
    return os.environ.get("OSSV_RUNS_BUCKET") or RUNS_BUCKET


def read_object(bucket: str, path: str) -> dict | None:
    text = run_text(["gcloud", "storage", "cat", f"{bucket}/{path}"])
    try:
        return json.loads(text) if text else None
    except json.JSONDecodeError:
        return None


def read_pod(namespace: str, pod: str, context: str) -> dict | None:
    text = run_text(["kubectl", "--context", context, "-n", namespace, "get", "pod", pod, "-o", "json"])
    try:
        return json.loads(text) if text else None
    except json.JSONDecodeError:
        return None


def collect_pod(ref: str, context: str) -> tuple[dict, list[str]]:
    """The evidence for a pod named directly: "<namespace>/<pod>", or "<pod>" in builds-ossv.

    A lane outside OSS Verify has a pod name and no run id. The failure notice tells the owner
    to run this tool on the pod "for the shape", and before this it could not be done: the job
    argument is a farm run, and a pod name found no bucket and answered `unknown` with no
    evidence (NEWSRC, builds-bet, 2026-11-06).

    There is no farm record to read, so there is no peak and no sizing advice -- those come
    from result.json, which only OSS Verify runs write. What this path gives is what the pod
    itself knows (its limits, its kill) and the memory SHAPE from the series, which is the
    thing the notice actually promises. The shape is read whenever the kernel killed the
    container, rather than when `verdict` says "memory": without a peak the verdict cannot say
    anything, and refusing to look at the series because of that would deny the shape to
    exactly the lane this path exists for.
    """
    namespace, _, name = ref.rpartition("/")
    namespace = namespace or "builds-ossv"
    missing: list[str] = []
    pod = read_pod(namespace, name, context)
    if pod is None:
        missing.append(f"the pod {namespace}/{name} (not in the cluster)")
    found = evidence(None, None, pod)
    found.setdefault("namespace", namespace)
    found["pod_found"] = pod is not None
    if not found.get("pod"):
        found["pod"] = name
    killed = found.get("reason") == "OOMKilled" or bool(found.get("oom_kill"))
    if killed or verdict(found)["resource"] in ("memory", "both"):
        found["memory_shape"] = read_memory_shape(found)
    return found, missing


def collect(run_id: str, context: str) -> tuple[dict, list[str]]:
    """The evidence for a job id ("farm/<run>" or "<run>"), and what could not be read."""
    run = run_id.split("/", 1)[1] if "/" in run_id else run_id
    missing: list[str] = []
    bucket = bucket_of(run)
    job = result = None
    if bucket:
        job = read_object(bucket, f"in/ossv/{run}/job.json")
        result = read_object(bucket, f"out/ossv/{run}/result.json")
        if result is None:
            result = read_object(bucket, f"out/ossv/{run}/usage.json")
            if result is None:
                missing.append("result.json and usage.json")
        if job is None:
            missing.append("job.json")
    else:
        missing.append("the run's bucket (no job-buckets record, no OSSV_RUNS_BUCKET)")
    pod = None
    names = [pod.get("name") for pod in ((result or {}).get("failed_pods") or []) if pod.get("name")]
    namespace = (job or {}).get("namespace") or "builds-ossv"
    if names:
        pod = read_pod(namespace, names[-1], context)
        if pod is None:
            missing.append(f"the pod {names[-1]} (gone from the cluster)")
    else:
        missing.append("the pod (no failed pod recorded)")
    found = evidence(job, result, pod)
    if not found.get("pod") and names:
        found["pod"] = names[-1]
    if verdict(found)["resource"] in ("memory", "both"):
        found["memory_shape"] = read_memory_shape(found)
        # Only for a memory kill, and only after the shape: the log is tens of thousands of
        # lines, and a disk kill's cause is never a proof-script error.
        if bucket:
            found["script_error"] = read_script_error(bucket, run)
            parent = (job or {}).get("oom_retry_of")
            if parent:
                found["retry_of"] = read_retry_of(bucket, parent)
    return found, missing


def send(owner: str, text: str) -> bool:
    """One Envoy message to the lane that owns the job, its body on stdin.

    `envoy send` refuses a body given as a command-line word in an agent session: the shell
    expands backticks and $(...) in such a word before envoy sees it.
    """
    here = os.path.dirname(os.path.abspath(__file__))
    done = subprocess.run([os.path.join(here, "envoy"), "send", "--message-file", "-", owner],
                          input=text, capture_output=True, text=True, timeout=60)
    if done.returncode != 0:
        print(f"farm-fail-watch: envoy send to {owner} failed: {done.stderr.strip()}", file=sys.stderr)
    return done.returncode == 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description="Say what killed a farm job, and what its lane should do about it.")
    parser.add_argument("job", nargs="?", help="the job id, farm/<run> or <run>")
    parser.add_argument("--context", default="gke_theorem-agent-infra_us-west1_dispatch",
                        help="the kubectl context the farm's namespace is in")
    parser.add_argument("--send", action="store_true",
                        help="send the message to the job's owning session over Envoy"
                             " (without it, the message is printed and nobody is told)")
    parser.add_argument("--to", help="send to this session id instead of the job's owner")
    parser.add_argument("--json", action="store_true", help="print the evidence and the verdict")
    parser.add_argument("--pod", metavar="NAMESPACE/POD",
                        help="read a pod directly instead of a farm run, for a lane outside OSS"
                             " Verify that has a pod name and no run id; the namespace defaults"
                             " to builds-ossv. There is no farm record on this path, so the"
                             " answer carries the pod's own limits and the memory shape, and no"
                             " peak or sizing advice")
    options = parser.parse_args(argv)
    if bool(options.job) == bool(options.pod):
        parser.error("give exactly one of the job id or --pod NAMESPACE/POD")

    found, missing = (collect_pod(options.pod, options.context) if options.pod
                      else collect(options.job, options.context))
    call = verdict(found)
    if options.pod and not found.get("pod_found"):
        text = (f"{options.pod}: not in the cluster, so there is nothing to read. A pod that"
                " has been deleted keeps its kill only in the farm's record, which exists for"
                " OSS Verify runs; for another namespace the evidence is gone with the pod."
                "\nCatch the next one while it is still there, or keep the kill yourself: the"
                " kernel's own line in the node's journal survives the pod.")
    elif options.pod and not found.get("reason") and found.get("exit_code") is None:
        # A pod still running, or one that ended without being killed, has no kill to explain.
        # message() would render its killed-job sentence with None in every slot, which reads
        # like a failed read rather than an absent failure.
        text = (f"{options.pod}: no kill to explain — the container reports no termination"
                f" reason and no exit code"
                + (", and it is still running." if not found.get("finished_at")
                   else f", and it finished at {found['finished_at']}.")
                + "\nIf you expected a kill here, the pod you want is a previous one: a"
                " restarted container's kill lives in its last state, and a deleted pod's"
                " lives only in the farm's record.")
    else:
        text = message(found, call)
    if missing:
        text += "\nCould not be read: " + "; ".join(missing) + "."
    if options.json:
        print(json.dumps({"evidence": found, "verdict": call, "missing": missing,
                          "message": text}, indent=1, sort_keys=True))
        return 0
    print(text)
    if options.send:
        owner = options.to or found.get("owner")
        if not owner:
            print("farm-fail-watch: no owner session to send to", file=sys.stderr)
            return 1
        return 0 if send(owner, text) else 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
