#!/usr/bin/env python3
"""One agent box's end of the host tmux relay: it runs the box's tmux commands as the user, and
refuses the ones that would end another session.

WHY THIS EXISTS. Every box is given the host's tmux server, so a lead inside a box can drive
other sessions' panes (dispatch://INFRA-702). That also gave every box `kill-server`. At
16:53:58Z on 2026-11-04 the host server died and took every pane on sami-devbox with it: the
chief of staff was down 40 minutes, and the ~120 box relaunches that followed drove the machine
into a 74-minute kernel stall (dispatch://INFRA-1192).

WHY NOT A FILTER IN FRONT OF THE SOCKET. tmux's client/server protocol is binary imsg frames
(16-byte header: type, len, flags, peerid, pid; the command's argv packed in the payload of one
frame whose numeric type comes from a `enum msgtype` that shifts between tmux releases), and the
client hands the server file descriptors over SCM_RIGHTS. A byte filter would have to parse that
and track the version of both ends. So the relay no longer carries tmux's protocol at all: this
program speaks a one-line-per-argument protocol with the box, decides, and runs the HOST's own
tmux client against the host socket. Version skew between the image's tmux and the host's (3.4
against 3.8, which broke a boxed move on 2026-11-03) stops mattering for the same reason.

HOW THE CALLER IS IDENTIFIED. By the socket it connected to, nothing it says. `agentbox new`
gives each box a socket of its own, 0600, under $RUN_BASE/<box>/tmux, bind-mounted into that box
and no other, served by a transient user unit `agentbox-tmux-<box>` whose environment the
launcher writes: the box's name, and the pane the box was launched from (TMUX_PANE, which the
launcher passes only for a launch from the host's default server). A box cannot reach another
box's socket and cannot change that unit's environment.

WHAT IS REFUSED. `kill-server` always. `kill-session`, `kill-window`, `kill-pane` (and their
aliases and unambiguous prefixes) when any pane they would destroy is not the box's own pane or
a pane the box created through this relay. Everything else is passed through unchanged, which is
the whole point: `send-keys`, `capture-pane`, `list-panes`, `display-message`, `new-window`,
`respawn-pane` on any pane still work, because a lead steers other sessions with them.

WHAT THIS IS NOT. It is a guard, not a boundary. A box already reaches the host's systemd user
manager through the relayed session bus, so it can start a socat of its own to the host tmux
socket; and `send-keys` into any pane sitting at a shell runs a command as the host user. Agent
boxes are segregation, not isolation (Sami, dispatch://INFRA-702/comment/41bdfb9d). This stops
the accident and the careless command - the shape that actually took the machine down - and
nothing claims more.
"""

from __future__ import annotations

import base64
import fcntl
import os
import re
import shlex
import signal
import stat as stat_module
import subprocess
import sys
import tempfile
import time
from pathlib import Path

BOX = os.environ.get("AGENTBOX_GUARD_BOX", "")
PANE = os.environ.get("AGENTBOX_GUARD_PANE", "")
SOCK = os.environ.get("AGENTBOX_GUARD_SOCK", "")
STATE = os.environ.get("AGENTBOX_GUARD_STATE", "")
TMUX_HINT = os.environ.get("AGENTBOX_GUARD_TMUX", "")
# A box that sends nothing this long is not a client of ours (a real tmux binary that found the
# socket sends binary imsg frames and no GO line, and must not hold the connection open). The
# deadline is SIGALRM and not a socket timeout: `socket.socket(fileno=os.dup(0)).settimeout()`
# sets O_NONBLOCK on the file DESCRIPTION, which the dup shares with fd 0, so stdin went
# non-blocking and a request that had not arrived in the instant python reached it read as end
# of input. Half of the calls from box agentbox-6378059a3ea1 failed that way at 03:01Z on
# 2026-11-05 ("this socket is not tmux's protocol"), which left `$(tmux new-window -P -F ...)`
# empty and the next command aimed at an empty target - refused, since an empty target is the
# server's current pane and that is another session's.
READ_TIMEOUT = 30

# Every kill command, its aliases, and what a target of it names. tmux accepts any unambiguous
# prefix, so a word is taken as a kill command when it is a prefix of one of these; a word that is
# a prefix of several (`kill-s`, `k`) counts as all of them, which tmux itself would call
# ambiguous and refuse anyway.
KILLS = {
    "kill-server": "server",
    "kill-session": "session",
    "kill-window": "window",
    "killw": "window",
    "kill-pane": "pane",
    "killp": "pane",
}
# Commands that cannot create a pane, so a run of them needs no before/after pane census. Anything
# not listed gets one, including run-shell, if-shell and source-file, which can create panes
# indirectly. Prefix-matched like the kills.
NO_NEW_PANE = (
    "capture-pane", "capturep", "display-message", "display", "displayp", "display-panes",
    "has-session", "kill-pane", "killp", "kill-server", "kill-session", "kill-window", "killw",
    "list-buffers", "lsb", "list-clients", "lsc", "list-commands", "lscm", "list-keys", "lsk",
    "list-panes", "lsp", "list-sessions", "ls", "list-windows", "lsw", "pipe-pane", "pipep",
    "refresh-client", "refresh", "rename-session", "rename", "rename-window", "renamew",
    "resize-pane", "resizep", "resize-window", "resizew", "select-pane", "selectp",
    "select-window", "selectw", "send-keys", "send", "send-prefix", "set-environment", "setenv",
    "set-option", "set", "set-window-option", "setw", "show-environment", "showenv",
    "show-messages", "showmsgs", "show-options", "show", "show-window-options", "showw",
    "swap-pane", "swapp", "swap-window", "swapw", "wait-for", "wait",
)
# Commands that create a pane and take tmux's `-e NAME=VALUE`, with their aliases.
# Prefix-matched like the kills.
PANE_CREATORS = (
    "new-session", "new", "new-window", "neww", "split-window", "splitw", "respawn-pane",
    "respawnp", "respawn-window", "respawnw", "display-popup", "popup",
)
# Commands that run a shell command without making a pane, so they take no -e: their command is
# wrapped in a shell of its own with the marker set for all of it. These flags take a value.
SHELL_RUNNERS = ("run-shell", "run", "pipe-pane", "pipep")
SHELL_RUNNER_VALUE_FLAGS = ("-c", "-d", "-t")
# Commands that hand the SERVER a tmux command to run later, or in another session, where the
# marker cannot follow: the environment of an if-shell condition is not the environment of its
# branch, and a binding or a hook outlives the box that installed it. Refused (INFRA-1538).
NESTED_TMUX_COMMANDS = (
    "if-shell", "if", "bind-key", "bind", "set-hook", "confirm-before", "confirm",
    "command-prompt", "display-menu", "menu",
)


def log(line: str) -> None:
    if not STATE:
        return
    try:
        with open(os.path.join(STATE, "tmux-guard.log"), "a", encoding="utf-8") as handle:
            handle.write(f"{time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())} {BOX} {line}\n")
    except OSError:
        pass


def read_request() -> tuple[list[str], str]:
    """The box's argv and its working directory, or raise ValueError for anything else."""
    stdin = sys.stdin.buffer
    args: list[str] = []
    cwd = ""
    while True:
        line = stdin.readline()
        if not line:
            raise ValueError("the box closed the connection before GO")
        line = line.rstrip(b"\r\n")
        if line == b"GO":
            return args, cwd
        head, _, rest = line.partition(b" ")
        if head == b"A":
            args.append(base64.b64decode(rest).decode("utf-8", "surrogateescape"))
        elif head == b"CWD":
            cwd = base64.b64decode(rest).decode("utf-8", "surrogateescape")
        else:
            raise ValueError("not this relay's protocol")
        if len(args) > 4096:
            raise ValueError("too many arguments")


def respond(out: bytes, err: bytes, code: int) -> None:
    stdout = sys.stdout.buffer
    stdout.write(b"O " + base64.b64encode(out) + b"\n")
    stdout.write(b"E " + base64.b64encode(err) + b"\n")
    stdout.write(b"X %d\n" % code)
    stdout.flush()


def refuse(message: str) -> None:
    log("REFUSED " + message.splitlines()[0])
    respond(b"", message.encode("utf-8") + b"\n", 1)
    sys.exit(0)


def refuse_nested(word: str) -> None:
    """A command that hands the server a tmux command to run later, where no marker follows."""
    refuse(
        f"agentbox-tmux-guard: refusing `tmux {word} …` from box {BOX}.\n"
        "  It hands the host's tmux SERVER a command to run later, or in another session, where\n"
        "  neither this relay nor ~/.dotfiles/shims can mark it as an agent's: the pane it\n"
        "  eventually makes would run as the person whose server it is (dispatch://INFRA-1538),\n"
        "  and a key binding or a hook a box installs outlives the box.\n"
        "  Instead: run the work in a pane of your own now — `tmux new-window -d <command>`,\n"
        "  which this relay marks — and read it back with capture-pane.")


def tmux_bin() -> str:
    """The host tmux client that can talk to the host's server. A client of another version
    answers `server exited unexpectedly`, so the choice is probed once and cached beside the
    box's state (the launcher's hint first, then PATH, then the host's mise installs)."""
    cache = Path(STATE) / "tmux-bin" if STATE else None
    if cache is not None and cache.is_file():
        candidate = cache.read_text(encoding="utf-8").strip()
        if candidate and os.access(candidate, os.X_OK):
            return candidate
    home = Path(os.path.expanduser("~"))
    candidates = [TMUX_HINT] if TMUX_HINT else []
    for directory in os.environ.get("PATH", "").split(":"):
        if directory:
            candidates.append(os.path.join(directory, "tmux"))
    # The mise SHIM, not only an install path: on sami-devbox tmux 3.8 is reachable at
    # ~/.mise/shims/tmux and at no */installs/*tmux*/*/bin/tmux, while the unit's PATH is
    # systemd's, whose /usr/bin/tmux is 3.4. Without this the probe fell through to 3.4, every
    # command the guard ALLOWED answered "server exited unexpectedly" against this 3.8 server,
    # and only its refusals worked - measured in box agentbox-6378059a3ea1 at 03:03Z on
    # 2026-11-05, which is what creating one live box before a fleet-wide reboot is for.
    candidates.append(str(home / ".mise/shims/tmux"))
    candidates.append(str(home / ".local/share/mise/shims/tmux"))
    for root in (home / ".mise/installs", home / ".local/share/mise/installs"):
        candidates.extend(str(path) for path in sorted(root.glob("*tmux*/*/bin/tmux")))
    candidates.append("/usr/bin/tmux")
    for candidate in candidates:
        if not candidate or not os.access(candidate, os.X_OK):
            continue
        # The shim refuses nothing here and execs the real binary, but it is a shell script: skip
        # it so the cache holds the binary itself.
        probe = subprocess.run([candidate, "-S", SOCK, "list-sessions"],
                               capture_output=True, timeout=20, check=False)
        if probe.returncode == 0:
            if cache is not None:
                try:
                    cache.write_text(candidate + "\n", encoding="utf-8")
                except OSError:
                    pass
            return candidate
    # Said in the log rather than left as tmux's own "server exited unexpectedly".
    log(f"no tmux client could talk to {SOCK}; tried {len(candidates)} candidates")
    return "tmux"


def tmux(*args: str) -> subprocess.CompletedProcess[bytes]:
    return subprocess.run([TMUX, "-S", SOCK, *args], capture_output=True, check=False)


def pane_table() -> list[tuple[str, str, str, str, str]]:
    """(pane id, window id, session id, session name, window index) for every pane."""
    done = tmux("list-panes", "-a", "-F",
                "#{pane_id}\t#{window_id}\t#{session_id}\t#{session_name}\t#{window_index}")
    rows = []
    for line in done.stdout.decode("utf-8", "replace").splitlines():
        fields = line.split("\t")
        if len(fields) == 5:
            rows.append((fields[0], fields[1], fields[2], fields[3], fields[4]))
    return rows


def owned_panes() -> set[str]:
    owned = {PANE} if PANE else set()
    if STATE:
        try:
            with open(os.path.join(STATE, "owned-panes"), encoding="utf-8") as handle:
                owned.update(line.strip() for line in handle if line.strip())
        except OSError:
            pass
    return owned


def remember_panes(new: set[str]) -> None:
    if not STATE or not new:
        return
    try:
        with open(os.path.join(STATE, "owned-panes"), "a", encoding="utf-8") as handle:
            fcntl.flock(handle, fcntl.LOCK_EX)
            for pane in sorted(new):
                handle.write(pane + "\n")
    except OSError:
        pass


def split_commands(args: list[str]) -> list[list[str]]:
    """tmux's own argv splitting: a word that is `;` separates two commands, a word ending in an
    unescaped `;` separates after itself, and `\\;` is a literal semicolon."""
    commands: list[list[str]] = []
    current: list[str] = []
    for arg in args:
        if arg == ";":
            commands.append(current)
            current = []
        elif arg.endswith(";") and not arg.endswith("\\;"):
            current.append(arg[:-1])
            commands.append(current)
            current = []
        else:
            current.append(arg[:-2] + ";" if arg.endswith("\\;") else arg)
    commands.append(current)
    return [command for command in commands if command]


def kill_kinds(word: str) -> set[str]:
    return {kind for name, kind in KILLS.items() if name.startswith(word)}


def may_create_pane(word: str) -> bool:
    return not any(name.startswith(word) for name in NO_NEW_PANE)


# Server and client options sit before the first command word; these three take a value.
SERVER_OPTION_WITH_VALUE = ("-c", "-f", "-T")


def after_server_options(args: list[str]) -> list[str]:
    """The command words, having refused an -L or -S that would aim at another tmux server."""
    index = 0
    while index < len(args):
        arg = args[index]
        if arg == "--":
            return args[index + 1:]
        if not arg.startswith("-") or arg == "-":
            return args[index:]
        if arg[:2] in ("-L", "-S"):
            refuse(
                f"agentbox-tmux-guard: refusing `{shlex.join(args)}` from box {BOX}.\n"
                "  This relay serves one server, the host's default. An -L or -S through it\n"
                "  would aim at another server, whose panes are not this box's to end.\n"
                "  Drop the option to use this relay; for a server of the box's own, run the\n"
                "  real binary: `/usr/bin/tmux -L <name> …`.")
        index += 2 if arg in SERVER_OPTION_WITH_VALUE else 1
    return []


def shell_command_file(command: str) -> str:
    """The box's command, byte for byte, in a private file whose path tmux reads nothing in.

    The command may not travel as text in the tmux argument: tmux expands `#{…}`, `#S`, `#T`
    and the rest in it AFTER this relay has quoted it, so a format value holding a quote broke
    out of the quoted word, and doubling every `#` is no transport either — the box's own shim
    doubles them as well, and tmux leaves `##` alone before `[` (dispatch://INFRA-1538, rounds
    6 and 7). The file's first line is `rm -f -- "$0"`, so it removes itself as the shell
    starts, which also makes `$0` the file's path rather than the shell's name, and is the ONLY
    thing that removes it: a file whose command tmux never starts, or has only QUEUED, stays.
    Removing it by age or on a failed call would take a queued command's file with it, and the
    residue is bytes of the box's own command text in a private directory on tmpfs that logout
    and reboot clear (round 9).

    The directory is XDG_RUNTIME_DIR's, else /run/user/<uid>, else this guard's own state
    directory, and nothing else: a name under a shared temporary directory is another user's to
    guess and to plant a symlink at, which `makedirs(exist_ok=True)` and `chmod` would then
    follow (round 8). It is made with mkdir 0700 and then checked with lstat — a symlink,
    another owner or any other mode refuses the call — and the file inside it is created
    O_CREAT|O_EXCL|O_NOFOLLOW, mode 0600.
    """
    base = next((candidate for candidate in
                 (os.environ.get("XDG_RUNTIME_DIR"), f"/run/user/{os.getuid()}", STATE)
                 if candidate and private_directory(candidate)), "")
    if not base:
        refuse(f"agentbox-tmux-guard: refusing `tmux run-shell …` from box {BOX}.\n"
               "  None of XDG_RUNTIME_DIR, /run/user/<uid> and this relay's state directory is a\n"
               "  directory of this user's own, mode 0700, and the box's command needs one to\n"
               "  reach tmux unchanged.")
    directory = os.path.join(base, "agentbox-tmux-guard-commands")
    try:
        os.mkdir(directory, 0o700)
    except FileExistsError:
        pass
    except OSError as error:
        refuse(f"agentbox-tmux-guard: refusing `tmux run-shell …` from box {BOX}.\n"
               f"  {directory} cannot be made ({error}), and the box's command needs it.")
    if not private_directory(directory):
        refuse(f"agentbox-tmux-guard: refusing `tmux run-shell …` from box {BOX}.\n"
               f"  {directory} is not a directory of this user's own, mode 0700 and no symlink,\n"
               "  so a command cannot be handed to tmux through it. Remove it and try again.")
    handle, path = tempfile.mkstemp(prefix="agent-", dir=directory)
    if not re.fullmatch(r"[A-Za-z0-9._/-]+", path):
        os.close(handle)
        os.unlink(path)
        refuse(f"agentbox-tmux-guard: refusing `tmux run-shell …` from box {BOX}.\n"
               f"  The private directory for the command ({directory}) has characters tmux or a\n"
               "  shell would read, so the command cannot be handed over unchanged.")
    os.fchmod(handle, 0o600)
    with os.fdopen(handle, "w", encoding="utf-8") as file:
        file.write('rm -f -- "$0"\n' + command + "\n")
    return path


def private_directory(path: str) -> bool:
    """A real directory of this user's own, mode 0700, reached through no symlink."""
    try:
        found = os.lstat(path)
    except OSError:
        return False
    return (stat_module.S_ISDIR(found.st_mode) and found.st_uid == os.getuid()
            and stat_module.S_IMODE(found.st_mode) == 0o700)


def mark_new_panes(args: list[str]) -> list[str]:
    """Mark every command this box starts on the host server as the box's.

    A new pane takes the SERVER's environment, not the environment of whoever asked for it, so a
    box's `tmux new-window` produced a host pane with no marker at all, and ~/.dotfiles/shims
    read every command in it as the person's own (dispatch://INFRA-1538, rounds 3 and 4). The
    box's own shims/tmux passes the markers it holds; this adds the one the relay knows for
    certain, the box, whatever shim the box runs. tmux takes the last -e for a name, so a marker
    the box already passed keeps its value.

    A command that makes a pane takes `-e NAME=VALUE`. run-shell and pipe-pane make no pane and
    take no -e: their command goes into a file of its own (shell_command_file) and tmux is
    handed `env <markers> /bin/sh <path>`. This relay, not the box's shim, is the one wrapper
    that may do it: the file has to be on the machine the tmux server runs on, and two wrappers
    rewriting one command is what broke `${#v}` (round 7). The relay cannot see the box's own
    environment, so the markers are the two it knows: the box, and AGENT_SHIM_AGENT=1, which
    every agent_context copy reads. They are marked and not refused because `scripts/agentbox
    move` starts the box relauncher with `tmux run-shell -b`. Every command of a `;`-separated
    list is treated.
    """
    if not BOX:
        return args
    marker = f"AGENTBOX_SESSION={BOX}"
    prefix = f"env {marker} AGENT_SHIM_AGENT=1 "
    out: list[str] = []
    index = 0
    while index < len(args):  # the server options, which sit before the first command word
        arg = args[index]
        if arg == "--":
            out.append(arg)
            index += 1
            break
        if not arg.startswith("-") or arg == "-":
            break
        out.append(arg)
        if arg in SERVER_OPTION_WITH_VALUE and index + 1 < len(args):
            out.append(args[index + 1])
            index += 1
        index += 1
    starts_command = True
    awaiting_shell_command = False
    rest = args[index:]
    position = 0
    while position < len(rest):
        arg = rest[position]
        position += 1
        if arg == ";":
            ends_command, word = True, ""
        elif arg.endswith(";") and not arg.endswith("\\;"):
            ends_command, word = True, arg[:-1]
        else:
            ends_command, word = False, arg
        if starts_command and word:
            if any(name.startswith(word) for name in NESTED_TMUX_COMMANDS):
                refuse_nested(word)
            if any(name.startswith(word) for name in PANE_CREATORS):
                out.append(word)
                out.extend(["-e", marker])
                if ends_command:
                    out.append(";")
                starts_command = ends_command
                continue
            if any(name.startswith(word) for name in SHELL_RUNNERS):
                out.append(arg)
                awaiting_shell_command = not ends_command
                starts_command = ends_command
                continue
        if awaiting_shell_command and not ends_command:
            if "C" in arg[1:] and arg.startswith("-"):
                # run-shell -C: the argument is a tmux command the server runs, not a shell
                # command of its own, so there is nothing here to mark.
                refuse_nested("run-shell -C")
            if arg in SHELL_RUNNER_VALUE_FLAGS and position < len(rest):
                out.extend([arg, rest[position]])
                position += 1
                continue
            if not arg.startswith("-"):
                # The shell command: the first word that is not a flag. It goes to tmux as a
                # FILE, whose path holds nothing tmux expands and nothing a shell splits, so
                # the command arrives byte for byte; `env <markers> /bin/sh <path>` then runs
                # all of it marked.
                out.append(f"{prefix}/bin/sh {shell_command_file(arg)}")
                awaiting_shell_command = False
                continue
        out.append(arg)
        if ends_command:
            awaiting_shell_command = False
        starts_command = ends_command
    return out


def kill_target(command: list[str]) -> tuple[str | None, bool]:
    """The -t value of a kill command (None when it has none) and whether -a was given."""
    target: str | None = None
    everything = False
    index = 1
    while index < len(command):
        arg = command[index]
        if arg == "-t" and index + 1 < len(command):
            target = command[index + 1]
            index += 2
            continue
        if arg.startswith("-t") and len(arg) > 2:
            target = arg[2:]
            index += 1
            continue
        if arg.startswith("-") and arg != "-":
            everything = everything or "a" in arg[1:]
        index += 1
    return target, everything


def resolve(target: str) -> tuple[str, str, str] | None:
    """(pane id, window id, session id) the target names, or None when tmux cannot resolve it."""
    done = tmux("display-message", "-p", "-t", target, "#{pane_id}\t#{window_id}\t#{session_id}")
    fields = done.stdout.decode("utf-8", "replace").strip().split("\t")
    if done.returncode != 0 or len(fields) != 3 or not fields[0]:
        return None
    return fields[0], fields[1], fields[2]


def victims(kind: str, target: str, everything: bool) -> tuple[list[str], str] | None:
    """Every pane the kill would destroy, and a human description of the target."""
    spot = resolve(target)
    if spot is None:
        return None
    pane, window, session = spot
    rows = pane_table()
    where = next((f"session {row[3]}, window {row[4]}" for row in rows if row[0] == pane), "")
    if kind == "pane":
        panes = [row[0] for row in rows if row[1] == window and row[0] != pane] if everything \
            else [pane]
    elif kind == "window":
        panes = [row[0] for row in rows if row[2] == session and row[1] != window] if everything \
            else [row[0] for row in rows if row[1] == window]
    else:
        panes = [row[0] for row in rows if row[2] != session] if everything \
            else [row[0] for row in rows if row[2] == session]
    return panes, where


def check(args: list[str]) -> list[list[str]]:
    """Refuse the kills that would end another session; return the commands for everything else."""
    commands = split_commands(after_server_options(args))
    if not commands:
        refuse(f"agentbox-tmux-guard: box {BOX} sent no tmux command.\n"
               "  This socket is the host's tmux server relayed into the box. It runs commands;\n"
               "  it cannot attach, because the box has none of the host's terminals.")
    own = owned_panes()
    own_text = ", ".join(sorted(own)) if own else "no pane of its own (it was not launched from " \
        "a pane of the host's default tmux server)"
    for command in commands:
        kinds = kill_kinds(command[0])
        if not kinds:
            continue
        if "server" in kinds:
            refuse(
                f"agentbox-tmux-guard: refusing `{shlex.join(command)}` from box {BOX}.\n"
                "  kill-server on the host's tmux server ends EVERY agent pane on this machine.\n"
                "  That happened at 16:53:58Z on 2026-11-04 and cost 114 minutes"
                " (dispatch://INFRA-1192).\n"
                "  A box may kill only its own pane or window"
                f" (this box owns: {own_text}).\n"
                "  For a server of your own inside the box: `tmux -L <name> kill-server`.")
        kind = sorted(kinds)[0]
        target, everything = kill_target(command)
        if target is None:
            refuse(
                f"agentbox-tmux-guard: refusing `{shlex.join(command)}` from box {BOX}.\n"
                "  It names no target, so the host's tmux server would pick its own most recent\n"
                f"  {kind}, which belongs to some other session. Name the target:"
                f" `-t {sorted(own)[0] if own else '%<your pane>'}`.\n"
                f"  This box owns: {own_text}.")
        found = victims(kind, target, everything)
        if found is None:
            continue  # tmux will report the bad target itself, in its own words.
        panes, where = found
        foreign = [pane for pane in panes if pane not in own]
        if foreign:
            refuse(
                f"agentbox-tmux-guard: refusing `{shlex.join(command)}` from box {BOX}.\n"
                f"  It would kill {len(panes)} pane(s), {len(foreign)} of them this box does not"
                f" own: {' '.join(foreign[:12])}"
                f"{' …' if len(foreign) > 12 else ''}"
                f"{f' ({where})' if where else ''}.\n"
                f"  This box owns: {own_text}.\n"
                "  Steering other sessions' panes is unchanged: send-keys, capture-pane,\n"
                "  display-message, list-panes, new-window and respawn-pane all still work.")
    return commands


def main() -> int:
    if not SOCK or not os.path.exists(SOCK):
        respond(b"", b"agentbox-tmux-guard: this host has no tmux server at "
                + SOCK.encode() + b"\n", 1)
        return 0
    def late(_signum: int, _frame: object) -> None:
        raise TimeoutError(f"no request in {READ_TIMEOUT}s")

    signal.signal(signal.SIGALRM, late)
    signal.alarm(READ_TIMEOUT)
    try:
        args, cwd = read_request()
    except (ValueError, OSError) as error:
        sys.stdout.buffer.write(
            b"agentbox-tmux-guard: this socket is not tmux's protocol (" + str(error).encode()
            + b"). Run `tmux` from PATH, which is "
            b"~/.dotfiles/shims/tmux and speaks to this relay.\n")
        sys.stdout.buffer.flush()
        return 2
    finally:
        signal.alarm(0)

    global TMUX
    TMUX = tmux_bin()
    commands = check(args)
    args = mark_new_panes(args)

    census = any(may_create_pane(command[0]) for command in commands)
    before = {row[0] for row in pane_table()} if census else set()
    directory = cwd if cwd and os.path.isdir(cwd) else os.path.expanduser("~")
    done = subprocess.run([TMUX, "-S", SOCK, *args], capture_output=True, check=False,
                          cwd=directory)
    # Nothing removes a command file from here: the file's own first line does that when its
    # command starts, and a file whose command tmux has only QUEUED must survive a failure
    # elsewhere in the same call (round 9 of dispatch://INFRA-1538).
    if census:
        remember_panes({row[0] for row in pane_table()} - before)
    respond(done.stdout, done.stderr, done.returncode)
    return 0


TMUX = "tmux"
if __name__ == "__main__":
    sys.exit(main())
