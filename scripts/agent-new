#!/usr/bin/env bash
# agent-new: start a fresh omp agent for one request, in a new tmux pane, in one command.
#
#   agent-new [--box|--host] [--window W | --session S] [--repo R --name N [--base REF]]
#             [--dry-run] REQUEST
#
# REQUEST is a Dispatch issue key (INFRA-897), a brief file (@brief.md or a path to one), or the
# request as text. A key becomes a first message that tells the agent to read, claim and finish
# the issue; a file is attached to the first message as omp's @file; text is sent as it is.
#
# --box     run the session in an agent box: the pane runs `agentbox new --dir <dir> -- omp …`
#           (agentbox/AGENTS.md). The default on a Google VM (scripts/on-google-vm), where every
#           session runs in a box (sami-devbox, dispatch://INFRA-993); --host is the default
#           elsewhere and runs `omp` on the host. A brief outside <dir>, ~/src and
#           /mnt/durable/<user> gives the box its directory as one more --dir.
# --window  split a pane in this tmux window. Each stream has one window on sami-rocqperf
#           (dispatch://INFRA-202, "Windows on sami-rocqperf").
# --session open the pane as a new window named N in this tmux session, made if absent.
#           Without --window or --session, a host session splits the caller's window, and a boxed
#           session, or any session started outside tmux, opens a new window in the caller's
#           tmux session (outside tmux: session `agents`). The window's name is N: --name, else
#           the issue key in lower case, else the brief file's name without its extension.
# --repo    start in a new worktree of ~/src/R at ~/src/R-N on branch N, cut by agent-workspace
#           (from origin's default branch, or --base). Without --repo the pane starts in the
#           caller's current directory, as typing `omp` there would.
#
# The pane runs through the user's interactive bash, so shims/omp and scripts/agent-session give
# the session its usual environment (gh-app routing, shims-first PATH, secrets-broker identity),
# and a box gets its own from scripts/agentbox. When omp exits, the pane keeps a shell; a box
# closes with it. Why this exists: a request folded into a running session is done only where it
# overlaps (dispatch://INFRA-897), and the taking-a-new-request skill offers a fresh agent "with
# the command that starts it".
set -euo pipefail

DOTFILES_DIR="${DOTFILES_DIR:-$HOME/.dotfiles}"

usage() {
    sed -n '4,6p' "$0" | sed 's/^# \{0,1\}//' >&2
    exit 2
}

window="" session="" repo="" name="" base="" dry=0 box=""
while (($#)); do
    case "$1" in
        --box) box=1; shift ;;
        --host) box=0; shift ;;
        --window) window="${2:?--window needs a value}"; shift 2 ;;
        --session) session="${2:?--session needs a value}"; shift 2 ;;
        --repo) repo="${2:?--repo needs a value}"; shift 2 ;;
        --name) name="${2:?--name needs a value}"; shift 2 ;;
        --base) base="${2:?--base needs a value}"; shift 2 ;;
        --dry-run) dry=1; shift ;;
        -h | --help) usage ;;
        --) shift; break ;;
        -*) echo "agent-new: unknown flag $1" >&2; usage ;;
        *) break ;;
    esac
done
(($#)) || usage
request="$*"
[[ -z "$window" || -z "$session" ]] || { echo "agent-new: give --window or --session, not both" >&2; exit 2; }
if [[ -z "$box" ]]; then
    if "$DOTFILES_DIR/scripts/on-google-vm"; then box=1; else box=0; fi
fi

brief=""
if [[ "$request" =~ ^[A-Z][A-Z0-9]*-[0-9]+$ ]]; then
    msg="Your task is dispatch://$request. Read it with \`dispatch read --issue $request\`, claim it, and finish it to the goal and acceptance its spec states."
    : "${name:=$(tr '[:upper:]' '[:lower:]' <<<"$request")}"
elif [[ "$request" == @* || -f "$request" ]]; then
    file="${request#@}"
    [[ -f "$file" ]] || { echo "agent-new: no brief file at $file" >&2; exit 1; }
    brief="$(realpath -- "$file")"
    msg="@$brief"
else
    msg="$request"
fi

if [[ -n "$repo" ]]; then
    [[ -n "$name" ]] || { echo "agent-new: --repo needs --name (or an issue key as REQUEST)" >&2; exit 2; }
    dir="$HOME/src/$(basename -- "$repo")-$name"
    ws=(agent-workspace new --path "$dir")
    [[ -z "$base" ]] || ws+=(--base "$base")
    ws+=("$repo" "$name")
else
    dir="$PWD"
    ws=()
fi

if ((box)); then
    run=(agentbox new --dir "$dir")
    # The box sees ~/src, /mnt/durable/<user>, its --dirs and the home allow-list, and nothing
    # else of the host: a brief anywhere else would be a missing file in the box.
    if [[ -n "$brief" ]]; then
        brief_dir="${brief%/*}"
        case "$brief/" in
            "$dir"/* | "$HOME/src/"* | "/mnt/durable/$(id -un)/"*) ;;
            *)
                [[ "$brief_dir" != "$HOME" && "$brief_dir" != / ]] \
                    || { echo "agent-new: a box cannot be given all of $brief_dir for the brief; put $brief in a directory of its own" >&2; exit 1; }
                run+=(--dir "$brief_dir")
                ;;
        esac
    fi
    run+=(-- omp "$msg")
else
    run=(omp "$msg")
fi
pane_cmd="$(printf '%q ' "${run[@]}"); exec bash"

in_tmux=0
[[ -n "${TMUX_PANE:-}" ]] && in_tmux=1
if [[ -z "$window" && -z "$session" ]] && ((in_tmux)) && ! ((box)); then
    window="$(tmux display-message -p -t "$TMUX_PANE" '#{session_name}:#{window_index}')"
fi

if [[ -n "$window" ]]; then
    open=(tmux split-window -d -P -F '#{pane_id}' -t "$window" -c "$dir" bash -ic "$pane_cmd")
    where="window $window"
else
    if [[ -z "$name" && -n "$brief" ]]; then name="$(basename -- "${brief%.*}")"; fi
    [[ -n "$name" ]] || { echo "agent-new: a new window needs a name; give --name" >&2; exit 2; }
    [[ "$name" =~ ^[A-Za-z0-9_-]+$ ]] || { echo "agent-new: window name '$name' may hold only letters, digits, - and _" >&2; exit 2; }
    if [[ -z "$session" ]]; then
        if ((in_tmux)); then session="$(tmux display-message -p -t "$TMUX_PANE" '#{session_name}')"; else session=agents; fi
    fi
    if tmux has-session -t "=$session" 2>/dev/null; then
        if tmux list-windows -t "=$session" -F '#{window_name}' | grep -qxF -- "$name"; then
            echo "agent-new: session $session already has a window named $name; choose another --name" >&2
            exit 1
        fi
        open=(tmux new-window -d -P -F '#{pane_id}' -t "=$session:" -n "$name" -c "$dir" bash -ic "$pane_cmd")
    else
        open=(tmux new-session -d -P -F '#{pane_id}' -s "$session" -n "$name" -c "$dir" bash -ic "$pane_cmd")
    fi
    where="window $session:$name"
fi

if ((dry)); then
    ((${#ws[@]})) && printf 'would run: %s\n' "${ws[*]@Q}"
    printf 'would run: %s\n' "${open[*]@Q}"
    exit 0
fi

if ((${#ws[@]})); then
    "${ws[@]}" >&2
    [[ -d "$dir" ]] || { echo "agent-new: agent-workspace made no directory at $dir" >&2; exit 1; }
fi

if ! pane="$("${open[@]}" 2>/tmp/agent-new.$$.err)"; then
    # tmux 3.8 says "no space for a new pane" (measured 2026-11-02), which the old pattern here,
    # 'no space for new pane', never matched, so a full window was never tiled.
    if [[ -n "$window" ]] && grep -qE 'no space for (a )?new pane' /tmp/agent-new.$$.err; then
        tmux select-layout -t "$window" tiled >/dev/null
        pane="$("${open[@]}")"
    else
        cat /tmp/agent-new.$$.err >&2
        rm -f /tmp/agent-new.$$.err
        exit 1
    fi
fi
rm -f /tmp/agent-new.$$.err

echo "pane $pane in $where, directory $dir$( ((box)) && echo ', in an agent box')"
((${#ws[@]})) && echo "when done: agent-workspace rm $dir"
exit 0
