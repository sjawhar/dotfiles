#!/usr/bin/env bash
# disk-gate: one reader of a shared disk, for every lane on this box.
#
# A lane that is about to write a lot asks here first. The gate takes a lock, so
# concurrent askers are answered one at a time, and it counts the space other
# lanes have already been promised but not yet written. Without it each lane
# reads `df` for itself, twenty lanes see the same free space at the same
# instant, and they all start: /mnt/nvme fell 18 GiB in two minutes that way on
# 2026-11-01, and crossed its floor four times in eight hours.
#
#   disk-gate reserve <gib> <name> [--written <gib>] [--mount /mnt/nvme]   # 0 = go, 1 = wait
#   disk-gate renew <name> [<gib>] [--written <gib>] [--mount PATH]        # 0 = kept, 1 = not
#   disk-gate release <name>                                               # when the work ends
#   disk-gate status [--mount /mnt/nvme]
#   disk-gate attach <name> <pid> [--mount PATH]   # measure <pid>'s tree for a held name
#
# A reservation expires after RESERVE_TTL_S (default 2 h), so a lane that dies
# does not hold space for ever. `reserve` prints why it refused, with numbers.
#
# What a reservation costs. `df` already shows the bytes a lane has written, so
# the gate counts only the part of a reservation not yet written: <gib> minus
# what the holder has written on this mount. Counting the full <gib> would
# subtract written bytes twice, once in `df` and once in the reservation.
#
# The gate measures what a holder wrote, so a lane changes nothing to get this.
# `reserve` records its caller (the gate's parent process: the `bash -c` or the
# agent that ran it) with its start time and cgroup scope, and a baseline for
# each process in the caller's tree from /proc/<pid>/io (write_bytes minus
# cancelled_write_bytes). Each later call adds up the growth over the tree as it
# is then. /proc/<pid>/io counts writes to every file system, so a process
# counts only when its writes are bound to this mount, by the st_dev test of
# disk-fill-watch's mount_evidence(), made strict: its cwd is on the mount, and
# it holds no directory and no file open for writing on another disk-backed file
# system. That test sees only what a process has open when it is read, so the
# measured figure is also capped by how far free space on the mount has fallen:
# one holder's by the fall since it reserved, all holders' together by the fall
# since the oldest of them reserved. A holder whose process is gone, or that the
# gate cannot read, is counted at its full size, so a wrong guess makes the gate
# stricter, never looser.
#
# `--written <gib>` overrides the measurement with the bytes the reserved work
# now holds on this mount (for example `du -s --block-size=1G` of its output
# tree); a later call without it keeps that figure. Use it when the work runs
# outside the caller's tree (a docker build writes from dockerd), or when the
# caller exits before the work ends; or point the gate at the process that does
# the work with `disk-gate attach <name> <pid>`.
#
# A renewal (`renew`, or `reserve` again under a held name) that does not raise
# what the holder costs is never refused, so a lane can renew downward, or
# report what it wrote, at any time. A renewal that raises it is checked as a
# new reservation; when refused, the holder keeps its old reservation, because
# dropping it would offer other lanes the bytes it is still about to write. A
# renewal keeps measuring the process it first recorded while that one lives.
set -uo pipefail

MOUNT=/mnt/nvme
MOUNT_GIVEN=0
WRITTEN=
STATE_DIR="${DISK_GATE_STATE:-/mnt/nvme/sami/scratch/disk-gate}"
RESERVE_TTL_S="${DISK_GATE_TTL:-7200}"

# The floor each mount keeps free after every reservation is honoured. These are
# the fleet's own numbers: /mnt/nvme's 78 GiB floor is what disk-fill-watch
# alerts on, and / needs more headroom than its 18 GiB floor because a full root
# stops every session on the box at once (2026-10-27T00:00:31Z: rsyslog,
# journald and dockerd's exec went together).
#
# The floor is room for the writes no reservation covers: every session's
# transcripts, worktrees and caches on the disk. Those grow with what the disk
# holds, so on a disk larger than sami-rocqperf's 3,464 GiB array /mnt/nvme keeps
# the same share of itself that 78 GiB is there, 2.25%, rounded up. On sami-devbox
# that is 369 GiB of its 16,383 GiB state disk, which is also /home there, so a
# full disk stops every session at once, as a full root does. sami-rocqperf keeps
# 78 GiB.
floor_gib() {
	case "$1" in
	/mnt/nvme) df -B1 --output=size "$1" | tail -1 | awk '{f = $1 / 1073741824 * 0.0225; f = (f == int(f)) ? f : int(f) + 1; print (f > 78) ? f : 78}' ;;
	/) echo 40 ;;
	*) echo 20 ;;
	esac
}

usage() {
	echo "usage: disk-gate reserve <gib> <name> [--written GIB] [--mount PATH] | renew <name> [<gib>] [--written GIB] [--mount PATH] | release <name> | status [--mount PATH] | attach <name> <pid> [--mount PATH]" >&2
	exit 2
}

is_gib() { [[ "$1" =~ ^[0-9]+(\.[0-9]+)?$ ]]; }

free_gib() { df -B1 --output=avail "$1" | tail -1 | awk '{printf "%.1f", $1/1073741824}'; }

state_file() { echo "$STATE_DIR/$(echo "$1" | tr / _).tsv"; }

# A row is: name, GiB reserved, epoch seconds, GiB reported with --written
# (empty when none), then the measured holder: pid, its start time in clock
# ticks, its cgroup scope, GiB free on the mount when it reserved, the uptime in
# clock ticks then, its tree's baseline as pid:start:bytes,... ("-" for a
# process whose /proc/<pid>/io could not be read), and the agent id
# (PI_SESSION_ID) it ran under, if any. An older gate wrote only the first three
# or four fields; such a row is counted from what it reported.
#
# An agent harness runs every agent's commands as children of one process: omp
# runs a session's subagents in its own process, so the gate's parent is that
# process, and its tree holds the commands of agents that reserved nothing.
# When the caller has an agent id, only processes started under the same id
# count. The harness process itself has none, so its own writes (session logs)
# never count, and neither do the bytes a finished command leaves in its
# counter when the harness reaps it: a holder whose writing command has ended is
# counted in full again, until it renews with --written or releases.
#
# The measurement is in Python because it reads /proc for every process, once
# per call: `measure LEDGER MOUNT FREE SKIP [ROOT AGENT]` (see measure() below).
read -r -d '' PROBE_PY <<'PY'
import math, os, stat, sys

GIB = 1 << 30
# As disk-fill-watch: a process with more open files than this is not read through, so it
# does not count.
FD_SCAN_LIMIT = 256
# File systems that hold no disk bytes: a file open there does not take writes off the mount.
VIRTUAL = {
    "proc", "sysfs", "tmpfs", "devtmpfs", "devpts", "cgroup", "cgroup2", "mqueue", "debugfs",
    "tracefs", "securityfs", "pstore", "bpf", "hugetlbfs", "fusectl", "configfs", "autofs",
    "binfmt_misc", "efivarfs", "nsfs", "ramfs", "rpc_pipefs", "squashfs",
}


def stat_of(pid):
    """(ppid, start time in clock ticks), or None for a process that is gone."""
    try:
        with open(f"/proc/{pid}/stat", "rb") as fh:
            data = fh.read()
        rest = data[data.rindex(b")") + 2 :].split()
        return int(rest[1]), int(rest[19])
    except (OSError, ValueError, IndexError):
        return None


def written(pid):
    """Bytes this process and the children it reaped sent to storage, or None if unreadable."""
    try:
        with open(f"/proc/{pid}/io") as fh:
            v = dict(line.split(": ", 1) for line in fh.read().splitlines() if ": " in line)
        return int(v["write_bytes"]) - int(v["cancelled_write_bytes"])
    except (OSError, ValueError, KeyError):
        return None


def processes():
    found = {}
    for name in os.listdir("/proc"):
        if name.isdigit():
            s = stat_of(name)
            if s:
                found[int(name)] = s
    return found


def tree(root, start, procs, skip):
    """{pid: start} for ROOT and its descendants, if ROOT is still the process that started then."""
    if root not in procs or procs[root][1] != start:
        return {}
    kids = {}
    for pid, (ppid, _) in procs.items():
        kids.setdefault(ppid, []).append(pid)
    found, todo = {}, [root]
    while todo:
        pid = todo.pop()
        if pid == skip or pid in found:
            continue
        found[pid] = procs[pid][1]
        todo.extend(kids.get(pid, ()))
    return found


def disk_kinds():
    """{st_dev: whether that file system holds disk bytes}, from the mount table."""
    kinds = {}
    try:
        with open("/proc/self/mountinfo") as fh:
            for line in fh:
                left, _, right = line.partition(" - ")
                major, minor = left.split()[2].split(":")
                kinds[os.makedev(int(major), int(minor))] = right.split()[0] not in VIRTUAL
    except (OSError, ValueError, IndexError):
        pass
    return kinds


def writable(pid, fd):
    """Whether fd is open for writing. Unknown counts as writing, so it cannot earn a discount."""
    try:
        with open(f"/proc/{pid}/fdinfo/{fd}") as fh:
            for line in fh:
                if line.startswith("flags:"):
                    return int(line.split()[1], 8) & os.O_ACCMODE in (os.O_WRONLY, os.O_RDWR)
    except (OSError, ValueError, IndexError):
        pass
    return True


def bound(pid, device, kinds):
    """Whether what this process writes lands on `device`, by st_dev through /proc/<pid>/{cwd,fd}.

    disk-fill-watch's mount_evidence() places a writer on a mount when its cwd, a file it has
    open for writing or a directory it holds is there. Here that is not enough, because a
    discount for bytes that went to another disk lets the gate pass the floor: the cwd must be
    on the mount, and no directory or file open for writing may be on another disk.
    """
    try:
        if os.stat(f"/proc/{pid}/cwd").st_dev != device:
            return False
        fds = os.listdir(f"/proc/{pid}/fd")
    except OSError:
        return False
    if len(fds) > FD_SCAN_LIMIT:
        return False
    for fd in fds:
        try:
            st = os.stat(f"/proc/{pid}/fd/{fd}")
        except OSError:
            continue
        if st.st_dev == device or not kinds.get(st.st_dev, True):
            continue
        if stat.S_ISDIR(st.st_mode) or (stat.S_ISREG(st.st_mode) and writable(pid, fd)):
            return False
    return True


def scope_of(pid):
    try:
        with open(f"/proc/{pid}/cgroup") as fh:
            path = fh.read().splitlines()[0].split(":", 2)[2]
        return os.path.basename(path).replace("\t", " ").replace(",", " ") or "-"
    except (OSError, IndexError):
        return "-"


def agent_of(pid):
    """The PI_SESSION_ID a process started with, or None."""
    try:
        with open(f"/proc/{pid}/environ", "rb") as fh:
            for item in fh.read().split(b"\0"):
                if item.startswith(b"PI_SESSION_ID="):
                    return item[len(b"PI_SESSION_ID=") :].decode(errors="replace")
    except OSError:
        pass
    return None


def ident(root, skip, agent, free, procs):
    """The holder fields for ROOT's tree, or "" when ROOT is gone. AGENT "@" is ROOT's own.

    A caller that is init or a systemd manager is not recorded: its tree is every process it
    started, so a lane launched straight from a unit would be credited with the whole box.
    """
    with open("/proc/uptime") as fh:
        ticks = int(float(fh.read().split()[0]) * os.sysconf("SC_CLK_TCK"))
    if root not in procs or root == 1:
        return ""
    try:
        with open(f"/proc/{root}/comm") as fh:
            if fh.read().strip() in ("systemd", "init"):
                return ""
    except OSError:
        return ""
    if agent == "@":
        agent = agent_of(root) or ""
    start = procs[root][1]
    base = []
    for pid, pstart in tree(root, start, procs, skip).items():
        if agent and agent_of(pid) != agent:
            continue
        w = written(pid)
        base.append(f"{pid}:{pstart}:{'-' if w is None else w}")
    return f"{root}\t{start}\t{scope_of(root)}\t{free:g}\t{ticks}\t{','.join(base)}\t{agent}"


def measured_bytes(row, members, device, kinds):
    """Growth since the baseline over the processes of the tree whose writes are bound here."""
    ticks = int(row[8])
    agent = row[10]
    base = {}
    for item in row[9].split(","):
        if item:
            pid, start, w = item.split(":")
            base[(int(pid), int(start))] = None if w == "-" else int(w)
    total = 0
    for pid, start in members.items():
        if agent and agent_of(pid) != agent:
            continue  # another agent's command under the same harness process
        if (pid, start) in base:
            then = base[(pid, start)]
            if then is None:
                continue  # unreadable at the reservation: its growth is unknown
        elif start <= ticks:
            continue  # alive at the reservation but not measured then: its growth is unknown
        else:
            then = 0  # started after the reservation
        if not bound(pid, device, kinds):
            continue
        now = written(pid)
        if now is not None:
            total += max(0, now - then)
    return total


def measure(ledger, mount, free, skip, root, agent):
    """Print ROOT's holder fields (an empty line without ROOT), then one line per row."""
    try:
        with open(ledger) as fh:
            rows = [line.rstrip("\n").split("\t") for line in fh if line.strip()]
    except OSError:
        rows = []
    try:
        device = os.stat(mount).st_dev
    except OSError:
        device = None
    procs = processes() if root or any(len(r) >= 10 and r[3] == "" for r in rows) else {}
    print(ident(int(root), skip, agent, free, procs) if root else "")
    kinds = disk_kinds()
    out = []
    for r in rows:
        r = r + [""] * (11 - len(r))
        line = [r[0], r[1], r[2], 0.0, "none", r[4] or "-"]
        try:
            gib = float(r[1])
            if r[3] != "":
                line[3:5] = [float(r[3]), "reported"]
            elif r[4]:
                members = tree(int(r[4]), int(r[5]), procs, skip)
                line[5] = f"{r[4]} ({r[6]})"
                if not members:
                    line[4] = "gone"
                elif device is not None:
                    w = measured_bytes(r, members, device, kinds) / GIB
                    line[3:5] = [min(w, max(0.0, float(r[7]) - free), gib), "measured"]
                    line.append((int(r[8]), float(r[7])))
        except (ValueError, IndexError):
            line[3:5] = [0.0, "none"]
        out.append(line)
    # Measured holders together wrote no more here than free space fell since the oldest of
    # them reserved.
    held = [line for line in out if line[4] == "measured"]
    if held:
        fall = max(0.0, min(held, key=lambda line: line[6][0])[6][1] - free)
        total = sum(line[3] for line in held)
        if total > fall:
            for line in held:
                line[3] *= fall / total
    for line in out:
        # Rounded down, so the rounding never lowers a cost.
        written_gib = math.floor(line[3] * 100) / 100 if line[4] == "measured" else line[3]
        print("\t".join([line[0], line[1], line[2], f"{written_gib:.2f}", line[4], line[5]]))
    return 0


if __name__ == "__main__":
    _, _, ledger, mount, free, skip, root, agent = sys.argv
    sys.exit(measure(ledger, mount, float(free), int(skip), root, agent))
PY

probe() { python3 -I -S -c "$PROBE_PY" "$@" 2>/dev/null; }

# measure FILE FREE [PID AGENT]: set MEASURED to one line per row of FILE: name,
# GiB reserved, epoch, GiB written, how (reported, measured, gone or none) and
# the measured pid; and IDENT to the holder fields for PID's tree from now, when
# PID is given (AGENT "@" takes PID's own agent id). Without the probe only
# reported figures count. Callers hold the lock.
measure() {
	local f="$1" free="$2" out
	MEASURED="" IDENT=""
	if out=$(probe measure "$f" "$MOUNT" "$free" "$$" "${3:-}" "${4:-}"); then
		IDENT=${out%%$'\n'*}
		[[ "$out" == *$'\n'* ]] && MEASURED=${out#*$'\n'}
		return 0
	fi
	[[ -s "$f" ]] || return 0
	MEASURED=$(awk -F'\t' 'BEGIN {OFS = "\t"} {print $1, $2, $3, ($4 == "" ? 0 : $4), ($4 == "" ? "none" : "reported"), "-"}' "$f")
}

# What a measured line costs: reserved minus written, never below 0.
# shellcheck disable=SC2016 # awk fields, not shell expansions
AWK_COST='function cost(    c) { c = $2 - $4; return (c > 0 ? c : 0) }'

# cost_of GIB WRITTEN: what a reservation of GIB with WRITTEN written costs.
cost_of() {
	awk -v g="$1" -v w="$2" 'BEGIN { c = g - w; printf "%g", (c > 0 ? c : 0) }'
}

# Drop expired rows, print the rest. Callers hold the lock.
live_rows() {
	local f="$1" now
	now=$(date +%s)
	[[ -f "$f" ]] || return 0
	awk -v now="$now" -v ttl="$RESERVE_TTL_S" -F'\t' '($3 + ttl) > now' "$f"
}

# Holder lines for status and refusals, from measure's lines.
print_holders() {
	[[ -n "$1" ]] || return 0
	awk -F'\t' -v mount="$MOUNT" "$AWK_COST"'
	{
		printf "  %s %s GiB since %s", $1, $2, strftime("%H:%M:%SZ", $3)
		if ($5 == "reported" && $4 > 0) printf ", %g GiB written, %g GiB still counted", $4, cost()
		else if ($5 == "measured") printf ", pid %s wrote %g GiB on %s, %g GiB still counted", $6, $4, mount, cost()
		else if ($5 == "gone") printf ", pid %s gone and nothing reported, counted in full", $6
		printf "\n"
	}' <<<"$1"
}

# Sum of what every measured line but NAME costs.
held_except() {
	[[ -n "$1" ]] || { echo 0; return; }
	DG_NAME="$2" awk -F'\t' "$AWK_COST"'
	$1 != ENVIRON["DG_NAME"] { s += cost() }
	END { printf "%g", s + 0 }' <<<"$1"
}

# grant MODE NAME GIB: reserve or renew NAME on $MOUNT. Empty GIB (renew only)
# keeps the held size; empty $WRITTEN keeps the last reported figure.
grant() {
	local mode="$1" name="$2" gib="$3" f lock old line oldgib oldreported oldhow oldwritten reported written held free floor cost oldcost total ident measured
	mkdir -p "$STATE_DIR"
	f="$(state_file "$MOUNT")"
	lock="$f.lock"
	exec 9>"$lock"
	flock 9
	live_rows "$f" >"$f.tmp" 2>/dev/null || true
	mv -f "$f.tmp" "$f"
	old=$(DG_NAME="$name" awk -F'\t' '$1 == ENVIRON["DG_NAME"]' "$f")
	if [[ -z "$old" && "$mode" == renew ]]; then
		flock -u 9
		echo "disk-gate: NOT RENEWED. No reservation named $name is held on $MOUNT. Run 'disk-gate reserve <gib> $name' to ask again." >&2
		return 1
	fi
	free=$(free_gib "$MOUNT")
	floor=$(floor_gib "$MOUNT")
	measure "$f" "$free" "$PPID" "${PI_SESSION_ID:-}"
	measured="$MEASURED"
	line=$(DG_NAME="$name" awk -F'\t' '$1 == ENVIRON["DG_NAME"]' <<<"$measured")
	oldgib=$(awk -F'\t' 'NR == 1 {print $2}' <<<"$old")
	oldreported=$(awk -F'\t' 'NR == 1 {print $4}' <<<"$old")
	oldhow=$(awk -F'\t' 'NR == 1 {print $5}' <<<"$line")
	oldwritten=$(awk -F'\t' 'NR == 1 {print $4}' <<<"$line")
	[[ -n "$gib" ]] || gib="$oldgib"
	reported="${WRITTEN:-$oldreported}"
	# Keep measuring the process the reservation first recorded while it lives;
	# otherwise measure this caller from now.
	if [[ "$oldhow" == measured ]]; then
		ident=$(awk -F'\t' 'NR == 1 {OFS = "\t"; print $5, $6, $7, $8, $9, $10, $11}' <<<"$old")
	else
		ident="$IDENT"
	fi
	if [[ -n "$reported" ]]; then
		written="$reported"
	elif [[ "$oldhow" == measured ]]; then
		written="$oldwritten"
	else
		written=0
	fi
	held=$(held_except "$measured" "$name")
	cost=$(cost_of "$gib" "$written")
	total=$(awk -v f="$free" -v h="$held" -v c="$cost" -v fl="$floor" 'BEGIN {printf "%.1f", f - h - c - fl}')
	local written_note=""
	awk -v w="$written" 'BEGIN {exit !(w > 0)}' && written_note=" (${gib} reserved, $(awk -v w="$written" 'BEGIN {printf "%g", w}') written)"
	if [[ -n "$old" ]]; then
		oldcost=$(cost_of "$oldgib" "${oldwritten:-0}")
	fi
	# A new reservation, or a renewal that raises the cost, must fit above the
	# floor. A renewal that does not raise it adds nothing, so it always holds.
	if { [[ -z "$old" ]] || awk -v c="$cost" -v o="$oldcost" 'BEGIN {exit !(c > o)}'; } &&
		awk -v t="$total" 'BEGIN {exit !(t < 0)}'; then
		echo "disk-gate: NO. $MOUNT has ${free} GiB free; ${held} GiB is reserved by other lanes and not yet written; your ${cost} GiB${written_note} would leave $(awk -v f="$free" -v h="$held" -v c="$cost" 'BEGIN {printf "%.1f", f - h - c}') GiB, under the ${floor} GiB floor."
		[[ -n "$old" ]] && echo "disk-gate: you keep your ${oldgib} GiB reservation as it was; it expires on its old schedule."
		[[ -n "$measured" ]] && { echo "disk-gate: holders:"; print_holders "$measured"; }
		flock -u 9
		return 1
	fi
	{
		DG_NAME="$name" awk -F'\t' '$1 != ENVIRON["DG_NAME"]' "$f"
		printf '%s\t%s\t%s\t%s' "$name" "$gib" "$(date +%s)" "$reported"
		[[ -n "$ident" ]] && printf '\t%s' "$ident"
		printf '\n'
	} >"$f.new"
	mv -f "$f.new" "$f"
	# The file's name encodes the mount lossily (`/` becomes `_`), so keep the
	# real path beside it for `release`, which finds a name across mounts.
	printf '%s\n' "$MOUNT" >"$f.mount"
	local margin
	margin=$(awk -v t="$total" -v fl="$floor" 'BEGIN {if (t < 0) printf "%.1f GiB under", -t; else printf "%.1f GiB over", t; printf " the %s GiB floor", fl}')
	if [[ "$mode" == renew ]]; then
		echo "disk-gate: RENEWED. $name on $MOUNT counts ${cost} GiB${written_note} for another $((RESERVE_TTL_S / 60)) min. $MOUNT ${free} GiB free, ${held} GiB reserved by others, ${margin}."
	else
		echo "disk-gate: GO. $MOUNT ${free} GiB free, ${held} GiB reserved by others, ${cost} GiB now yours${written_note}${old:+ (renewed; it was ${oldcost} GiB)}, ${margin}. Run 'disk-gate release $name' when the work ends."
	fi
	flock -u 9
	return 0
}

cmd_reserve() {
	local gib="$1" name="$2"
	is_gib "$gib" || usage
	[[ -n "$name" && "$name" != *$'\t'* ]] || usage
	grant reserve "$name" "$gib"
}

# Renew a held reservation: refresh its expiry, and change its size or the
# bytes it has written. Without --mount it finds the name on any mount, as
# release does.
cmd_renew() {
	local name="$1" gib="$2" f m rc=0 mounts=()
	[[ -n "$name" && "$name" != *$'\t'* ]] || usage
	[[ -z "$gib" ]] || is_gib "$gib" || usage
	if [[ "$MOUNT_GIVEN" == 1 ]]; then
		grant renew "$name" "$gib"
		return
	fi
	shopt -s nullglob
	for f in "$STATE_DIR"/*.tsv; do
		DG_NAME="$name" awk -F'\t' '$1 == ENVIRON["DG_NAME"] {found = 1} END {exit !found}' "$f" &&
			mounts+=("$(cat "$f.mount" 2>/dev/null || echo "$MOUNT")")
	done
	shopt -u nullglob
	if ((${#mounts[@]} == 0)); then
		echo "disk-gate: NOT RENEWED. No reservation named $name is held on any mount. Run 'disk-gate reserve <gib> $name' to ask again." >&2
		return 1
	fi
	for m in "${mounts[@]}"; do
		MOUNT="$m"
		grant renew "$name" "$gib" || rc=1
	done
	return "$rc"
}

# Point a held reservation's measurement at PID's tree, from now: for work that
# runs under another process than the one that reserved (a lane that reserved
# in one shell and builds in another). It changes neither the size nor the
# expiry.
cmd_attach() {
	local name="$1" pid="$2" f lock ident
	[[ -n "$name" && "$name" != *$'\t'* && "$pid" =~ ^[0-9]+$ ]] || usage
	mkdir -p "$STATE_DIR"
	f="$(state_file "$MOUNT")"
	lock="$f.lock"
	exec 9>"$lock"
	flock 9
	if ! [[ -f "$f" ]] || ! DG_NAME="$name" awk -F'\t' '$1 == ENVIRON["DG_NAME"] {found = 1} END {exit !found}' "$f"; then
		flock -u 9
		echo "disk-gate: NOT ATTACHED. No reservation named $name is held on $MOUNT." >&2
		return 1
	fi
	measure "$f" "$(free_gib "$MOUNT")" "$pid" @
	ident="$IDENT"
	if [[ -z "$ident" ]]; then
		flock -u 9
		echo "disk-gate: NOT ATTACHED. No process $pid can be read." >&2
		return 1
	fi
	DG_NAME="$name" DG_IDENT="$ident" awk -F'\t' 'BEGIN {OFS = "\t"}
	$1 == ENVIRON["DG_NAME"] { print $1, $2, $3, $4, ENVIRON["DG_IDENT"]; next }
	{ print }' "$f" >"$f.new"
	mv -f "$f.new" "$f"
	flock -u 9
	echo "disk-gate: ATTACHED. $name on $MOUNT now counts what pid $pid's tree writes there from now."
}

# Release a reservation by name. Without --mount it looks in every mount's
# state file, because a lane that reserved with `--mount /mnt/durable` and
# releases the usual way must not be told it freed a claim the gate still
# counts (found 2026-11-02 01:4xZ: the claim stayed held until it expired).
# A name held nowhere is an error, exit 1, never a reported success.
cmd_release() {
	local name="$1" f lock found=0 where=() files=()
	[[ -n "$name" ]] || usage
	mkdir -p "$STATE_DIR"
	if [[ "$MOUNT_GIVEN" == 1 ]]; then
		files=("$(state_file "$MOUNT")")
	else
		shopt -s nullglob
		files=("$STATE_DIR"/*.tsv)
		shopt -u nullglob
	fi
	for f in "${files[@]}"; do
		lock="$f.lock"
		exec 9>"$lock"
		flock 9
		if [[ -f "$f" ]] && grep -q -P "^\Q$name\E\t" "$f"; then
			grep -v -P "^\Q$name\E\t" "$f" >"$f.new" 2>/dev/null || true
			mv -f "$f.new" "$f"
			found=1
			where+=("$(cat "$f.mount" 2>/dev/null || basename "$f" .tsv)")
		fi
		flock -u 9
	done
	if ((found == 0)); then
		echo "disk-gate: NOT RELEASED. No reservation named $name is held$([[ "$MOUNT_GIVEN" == 1 ]] && echo " on $MOUNT" || echo " on any mount"). Run 'disk-gate status --mount <mount>' to see who holds what." >&2
		return 1
	fi
	local m
	for m in "${where[@]}"; do
		echo "disk-gate: released $name on $m; $(free_gib "$m" 2>/dev/null || echo '?') GiB free."
	done
}

# status prunes expired rows, so it writes the state file: it takes the same lock
# as reserve and release. Without it, a status that ran while a reserve held the
# lock rewrote the file from a copy made in the middle of that reserve, and both
# used "$f.tmp", so other lanes' reservations were lost: 2026-11-02, 40 statuses
# against 40 reserves of one name in a private ledger left 1 holder of 3.
# "Reserved" here is what holders have not yet written.
cmd_status() {
	local f lock held free floor measured
	f="$(state_file "$MOUNT")"
	mkdir -p "$STATE_DIR"
	lock="$f.lock"
	exec 9>"$lock"
	flock 9
	live_rows "$f" >"$f.tmp" 2>/dev/null || true
	mv -f "$f.tmp" "$f" 2>/dev/null || true
	free=$(free_gib "$MOUNT")
	floor=$(floor_gib "$MOUNT")
	measure "$f" "$free"
	measured="$MEASURED"
	held=$(held_except "$measured" "")
	echo "$MOUNT: ${free} GiB free, ${held} GiB reserved, ${floor} GiB floor, $(awk -v f="$free" -v h="$held" -v fl="$floor" 'BEGIN {printf "%.1f", f - h - fl}') GiB available to reserve."
	print_holders "$measured"
	flock -u 9
	return 0
}

[[ $# -ge 1 ]] || usage
cmd="$1"
shift
args=()
while (($#)); do
	case "$1" in
	--mount)
		MOUNT="${2:-}"
		MOUNT_GIVEN=1
		shift 2
		;;
	--written)
		WRITTEN="${2:-}"
		is_gib "$WRITTEN" || usage
		shift 2
		;;
	*)
		args+=("$1")
		shift
		;;
	esac
done
case "$cmd" in
reserve) cmd_reserve "${args[0]:-}" "${args[1]:-}" ;;
renew) cmd_renew "${args[0]:-}" "${args[1]:-}" ;;
release) cmd_release "${args[0]:-}" ;;
status) cmd_status ;;
attach) cmd_attach "${args[0]:-}" "${args[1]:-}" ;;
*) usage ;;
esac
