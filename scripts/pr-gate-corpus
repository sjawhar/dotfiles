#!/usr/bin/env bash
# pr-gate-corpus - standing regression for pr-gate's verdict matcher. Runs offline against synthetic bodies.
# Extracts the LIVE grammar (GR), polarity sets (POS/NEG), code-span strip (VS) and verdict-sha scan from
# scripts/pr-gate, so a drift in the script fails here, not on a real PR. Exit 1 on any failing case.
#
# Every shape below was a real event on 2026-09-25/26: a false green, a false block, or a restatement round.
# Add a row when the matcher gets a new form or a new hole; the row IS the fix's acceptance.
set -uo pipefail
F="${PR_GATE:-$(dirname "$(readlink -f "$0")")/pr-gate}"
VS=$(grep -oP "^VS='\K.*(?=')" "$F"); POS=$(grep -oP "^POS='\K.*(?=')" "$F"); NEG=$(grep -oP "^NEG='\K.*(?=')" "$F")
# The grammar lives inside three identical jq string literals; lift the first and un-escape jq's \\ -> \.
GR=$(grep -oP 'select\(\.b\|vs\|test\("\K\(\?i:verdict:.*?(?="\)\)\]\|sort_by\(\.t\)\|reverse)' "$F" | head -1 | sed 's/\\\\/\\/g')
PL=$(grep -oP "^PL='\\K.*(?=')" "$F")
SU=$(grep -oP "^SU='\\K.*(?=')" "$F")
[ -n "$GR" ] && [ -n "$POS" ] && [ -n "$NEG" ] && [ -n "$VS" ] && [ -n "$PL" ] && [ -n "$SU" ] || { echo "could not extract matcher pieces from $F (GR=${#GR} POS=${#POS} NEG=${#NEG} VS=${#VS} PL=${#PL} SU=${#SU})"; exit 2; }
fail=0; n=0
# t <expected> <body>   expected = "g=<grammar> p=<positive> n=<negative> sha=<verdict sha (only when g=true) or ->"
t() { local exp="$1" body="$2"; n=$((n+1))
  got=$(jq -n --arg b "$body" --arg gr "$GR" --arg pos "$POS" --arg neg "$NEG" "$VS$PL$SU"'($b|vs) as $v | "g=\($v|test($gr)) p=\($v|test($pos)) n=\($v|test($neg)) sha=\(if ($v|test($gr)) then ($v|vsha($pos;$neg)|if . == "" then "-" else . end) else "-" end)"' -r)
  if [ "$got" = "$exp" ]; then echo "PASS $got :: ${body:0:72}"; else echo "FAIL got [$got] want [$exp] :: ${body:0:72}"; fail=1; fi; }
H=486fc48e0629a1b2c3d4e5f60718293a4b5c6d7e
echo "== positives at head =="
t "g=true p=true n=false sha=486fc48e"   "VERDICT: APPROVE at 486fc48e ($H)"
t "g=true p=true n=false sha=486fc48e"   "MERGE 486fc48e — extends my 143425f5 review. The one nit I raised is now taken"
t "g=true p=true n=false sha=188327f0"   "**ACCEPT at 188327f0.** GraphQL at this head reads threads=3 unresolved=0"
t "g=true p=true n=false sha=$H"         "Verdict: ACCEPT ($H) - delta read"
t "g=true p=true n=false sha=-"          "**Verdict: clean — the delta is exactly as described**"
t "g=true p=true n=false sha=a96869d"    'Reviewed `a96869d` (`a96869d5b02f9a367d1414eb6a3d2e0ba58b1f3e`): **clean, no findings.** [Run](https://x/actions/runs/1)'
t "g=true p=true n=false sha=$H"         "Merge-decision review. Verdict: MERGE at $H. Everything below was re-derived from a clean extraction"
t "g=true p=true n=false sha=aadf66d3"   "MERGE-WITH-NITS aadf66d3 — Extends my MERGE 2e1234c2 review; the nits are PR-body wording"
echo "== the verdict sha is the FIRST short-or-long sha, not the first 40-hex (hawk pin df0e9892 on #20186) =="
t "g=true p=true n=false sha=00473e0f"   "Verdict: APPROVE at 00473e0f ## Code review, round 7: #20186 at 00473e0f. Scope: the pin to hawk df0e989212345678901234567890abcdefabcdef"
# A delta review names its BASE first and its verdict on a later line: the verdict sha is the one after "at" on the
# VERDICT line, not the body's first hex (inspect-release lane, agent-c#20026, 2026-09-28).
t "g=true p=true n=false sha=f2314fb2"   'delta only: `fda41a10` -> `f2314fb2` (two child commits, 3 files). VERDICT: APPROVE at f2314fb2'
t "g=true p=true n=false sha=f2314fb2"   "$(printf 'delta only: fda41a10 -> f2314fb2\n\nVERDICT: APPROVE at f2314fb2 -- the two findings are closed')"
t "g=true p=true n=false sha=$H"         "APPROVE at $H (image digest sha256:556b68aa556b68aa556b68aa556b68aa556b68aa556b68aa556b68aa556b68aa)"
echo "== negatives / rejections =="
t "g=true p=false n=true sha=433fa449"   "VERDICT: CHANGES REQUESTED at 433fa449 - two claims disproved"
t "g=true p=false n=true sha=188327f0"   "Verdict: REJECT at 188327f0 - the accept criteria are unmet"
t "g=true p=false n=true sha=9edad355"   "Verdict: HOLD at 9edad355 - alarm text > 1024 chars"
t "g=true p=false n=true sha=b2183a5f"   "VERDICT: BLOCK at b2183a5f -- NEW-6 from the body claims"
t "g=true p=false n=true sha=-"          "Verdict: FAIL — the migration guard does not fire"
echo "== neutral: grammar but no polarity -> pr-gate fails closed (PASS is a tester half, #20200) =="
t "g=true p=false n=false sha=36ae1e27"  "Verdict: PASS at 36ae1e27 (tester run)"
echo "== NOT verdicts: requests, replies, prose, quoted grammar =="
t "g=false p=false n=false sha=-"        "Please accept or reject the round at your convenience - ask the reviewer to accept or reject"
t "g=false p=false n=false sha=-"        "Accepted: fixed in 188327f0 (thread reply, not a verdict)"
t "g=false p=false n=false sha=-"        "Reviewer: please restate as \`ACCEPT at 188327f0\` so the gate line goes green"
t "g=false p=false n=false sha=-"        "Head stable since 09:30Z; ready to merge 486fc48e once pcr settles green"
t "g=false p=false n=false sha=-"        "please merge 486fc48e when you can - author"
t "g=false p=false n=false sha=-"        $'Re-cite requested.\n  merge conflict at 486fc48e resolved by rebase'
t "g=false p=false n=false sha=-"        "Reviewer: post \`MERGE 486fc48e\` as the first line"
t "g=false p=false n=false sha=-"        "@claude review  Delta since your verdict at 1d64f1ca: one commit, $H"
echo "== a later-line bare VERB <sha> is NOT a verdict (first-line rule; jq ^ is string start) =="
t "g=false p=false n=false sha=-"        $'Some preamble line\nMERGE 486fc48e\nmore text'
echo "== polarity is decided by the FIRST hit (legion#1430: an APPROVE recounting its earlier REQUEST_CHANGES) =="
tp() { local exp="$1" body="$2"; n=$((n+1)); got=$(jq -n --arg b "$body" --arg pos "$POS" --arg neg "$NEG" "$VS$PL"'$b|vs|pol($pos;$neg)' -r)
  if [ "$got" = "$exp" ]; then echo "PASS pol=$got :: ${body:0:72}"; else echo "FAIL pol got [$got] want [$exp] :: ${body:0:72}"; fail=1; fi; }
tp pos  "Verdict: APPROVE at 2846a746 (round 4). My round-2 REQUEST_CHANGES at 11aa22bb is cleared: both findings fixed."
tp neg  "VERDICT: REQUEST_CHANGES at 2846a746 - the round-3 APPROVE at 11aa22bb is withdrawn; the guard still fires on the move-back"
tp pos  "**ACCEPT at 188327f0.** Supersedes my BLOCK at b18fa260 (stale cites)."
tp neg  "Verdict: BLOCK at b2183a5f -- NEW-6 from the body claims; NEW-4/NEW-5 fixed"
tp none "Verdict: PASS at 36ae1e27 (tester run)"
tp pos  "MERGE-WITH-NITS 143425f5 - one non-blocking hardening nit; my earlier REQUEST_CHANGES at 0000aaaa is cleared"
tp pos  'Reviewed `a96869d` (`a96869d5b02f9a367d1414eb6a3d2e0ba58b1f3e`): **clean, no findings.**'
echo "== the oracle's DOES NOT BLOCK is verdict-bearing, in neither polarity set by itself (agent-c#20410, AGENTC-1070) =="
t "g=true p=false n=false sha=4f659f925529e430a0497de212dbaec240397ee1" "Verdict: DOES NOT BLOCK at 4f659f925529e430a0497de212dbaec240397ee1 (UNPROVEN CLAIMS: 5, none blocking) Oracle re-judge after the owner's census. This supersedes the BLOCKS verdict in 5861618968."
t "g=true p=false n=true sha=4f659f925529e430a0497de212dbaec240397ee1" "Verdict: BLOCKS at 4f659f925529e430a0497de212dbaec240397ee1 (UNPROVEN CLAIMS: 7, 1 blocking: staging only)"
tp none "Verdict: DOES NOT BLOCK at 4f659f925529e430a0497de212dbaec240397ee1 (UNPROVEN CLAIMS: 5, none blocking). This supersedes the BLOCKS verdict in 5861618968."
echo "== supersession across artifacts: a later DOES NOT BLOCK retracts the SAME author's BLOCKS at the SAME head, and nothing else =="
# ts <expected> <json array of {t,u,b}>   expected = green | blocked | neutral, the polarity stage's three outcomes
ts() { local exp="$1" arts="$2"; n=$((n+1)); got=$(jq -n --argjson a "$arts" --arg pos "$POS" --arg neg "$NEG" "$VS$PL$SU"'$a|gate($pos;$neg)|if .negt!="" and (.post=="" or .negt>.post) then "blocked" elif .negt=="" and .post=="" then "neutral" else "green" end' -r)
  if [ "$got" = "$exp" ]; then echo "PASS seq=$got :: $(jq -r '[.[]|"\(.u):\(.b[0:28])"]|join(" | ")' <<<"$arts")"; else echo "FAIL seq got [$got] want [$exp] :: $arts"; fail=1; fi; }
B="Verdict: BLOCKS at $H (UNPROVEN CLAIMS: 7, 1 blocking)"
D="Verdict: DOES NOT BLOCK at $H (UNPROVEN CLAIMS: 5, none blocking). This supersedes the BLOCKS verdict above."
A="VERDICT: APPROVE at $H"
ts green   "[{\"t\":\"2026-09-28T01:15:00Z\",\"u\":\"oracle\",\"b\":\"$B\"},{\"t\":\"2026-09-28T01:36:00Z\",\"u\":\"oracle\",\"b\":\"$D\"}]"
ts blocked "[{\"t\":\"2026-09-28T01:15:00Z\",\"u\":\"oracle\",\"b\":\"$D\"},{\"t\":\"2026-09-28T01:36:00Z\",\"u\":\"oracle\",\"b\":\"$B\"}]"
ts blocked "[{\"t\":\"2026-09-28T01:15:00Z\",\"u\":\"oracle\",\"b\":\"$B\"},{\"t\":\"2026-09-28T01:36:00Z\",\"u\":\"other-reviewer\",\"b\":\"$D\"}]"
ts neutral "[{\"t\":\"2026-09-28T01:36:00Z\",\"u\":\"oracle\",\"b\":\"$D\"}]"
ts blocked "[{\"t\":\"2026-09-28T01:15:00Z\",\"u\":\"oracle\",\"b\":\"Verdict: BLOCKS at 1111aaaa (older head)\"},{\"t\":\"2026-09-28T01:36:00Z\",\"u\":\"oracle\",\"b\":\"$D\"}]"
ts green   "[{\"t\":\"2026-09-28T00:53:00Z\",\"u\":\"coordinator\",\"b\":\"$A\"},{\"t\":\"2026-09-28T01:15:00Z\",\"u\":\"oracle\",\"b\":\"$B\"},{\"t\":\"2026-09-28T01:36:00Z\",\"u\":\"oracle\",\"b\":\"$D\"}]"
ts blocked "[{\"t\":\"2026-09-28T00:53:00Z\",\"u\":\"coordinator\",\"b\":\"$A\"},{\"t\":\"2026-09-28T01:15:00Z\",\"u\":\"oracle\",\"b\":\"$B\"}]"
ts green   "[{\"t\":\"2026-09-28T00:10:00Z\",\"u\":\"reviewer-a\",\"b\":\"VERDICT: REQUEST_CHANGES at $H - two claims disproved\"},{\"t\":\"2026-09-28T00:53:00Z\",\"u\":\"coordinator\",\"b\":\"$A\"}]"
# Same-author supersession reads each artifact's verdict-line sha: a DOES NOT BLOCK written as a delta (base named first)
# still retracts that author's BLOCKS at the head.
ts green   "[{\"t\":\"2026-09-28T01:15:00Z\",\"u\":\"oracle\",\"b\":\"Verdict: BLOCKS at f2314fb2 (1 blocking)\"},{\"t\":\"2026-09-28T01:36:00Z\",\"u\":\"oracle\",\"b\":\"delta only: fda41a10 -> f2314fb2. Verdict: DOES NOT BLOCK at f2314fb2\"}]"
ts blocked "[{\"t\":\"2026-09-28T00:10:00Z\",\"u\":\"coordinator\",\"b\":\"$A\"},{\"t\":\"2026-09-28T00:53:00Z\",\"u\":\"reviewer-a\",\"b\":\"VERDICT: REQUEST_CHANGES at $H - two claims disproved\"}]"
echo "== check-run aggregation reads the WHOLE list, not a page (#20057: 198 runs, one verdict line per page) =="
CSQ=$(grep -oP "^CSQ='\K.*(?=')" "$F"); [ -n "$CSQ" ] || { echo "could not extract CSQ from $F"; exit 1; }
# tc <expected> <jq program building the slurped check-run array>
tc() { local exp="$1" gen="$2"; n=$((n+1)); got=$(jq -nr "$gen | $CSQ")
  if [ "$got" = "$exp" ]; then echo "PASS $got"; else echo "FAIL got [$got] want [$exp] :: $gen"; fail=1; fi; }
R='{status:"completed",conclusion:"success",started_at:"1"}'
tc "ok=150 fail=1 running=0 :: failing=z" "[range(150) as \$i | $R + {name:\"c\(\$i)\"}] + [{name:\"z\",status:\"completed\",conclusion:\"failure\",started_at:\"1\"}]"
tc "ok=1 fail=0 running=0 :: failing="    "[{name:\"x\",status:\"completed\",conclusion:\"failure\",started_at:\"1\"}, {name:\"x\",status:\"completed\",conclusion:\"success\",started_at:\"2\"}]"
tc "ok=0 fail=0 running=0 :: failing="    "[]"
tc "ok=1 fail=0 running=1 :: failing="    "[$R + {name:\"a\"}, {name:\"b\",status:\"in_progress\",conclusion:null,started_at:\"1\"}]"
echo "== Legion handoffs: a .legion/ path the PR does not delete blocks; deleting them stays green (sjawhar/legion#1678) =="
LG=$(grep -oP "^LG='\K.*(?=')" "$F"); [ -n "$LG" ] || { echo "could not extract LG from $F"; exit 1; }
# tl <expected blocking files, space-separated, empty = the check stays silent> <json array of {filename,status}>
tl() { local exp="$1" files="$2"; n=$((n+1)); got=$(jq -nr --argjson f "$files" "\$f|$LG")
  if [ "$got" = "$exp" ]; then echo "PASS legion=[$got]"; else echo "FAIL legion got [$got] want [$exp] :: $files"; fail=1; fi; }
tl ".legion/review.json" '[{"filename":"src/a.ts","status":"modified"},{"filename":".legion/review.json","status":"added"}]'
tl ""                    '[{"filename":".legion/implement.json","status":"removed"},{"filename":".legion/plan.json","status":"removed"},{"filename":".legion/review.json","status":"removed"},{"filename":".legion/test.json","status":"removed"}]'
tl ""                    '[{"filename":"src/a.ts","status":"modified"},{"filename":"packages/daemon-go/cmd/legion/main.go","status":"added"}]'
tl ".legion/plan.json"   '[{"filename":".legion/plan.json","status":"modified"},{"filename":".legion/test.json","status":"removed"}]'
echo; echo "$n cases, fail=$fail"; exit $fail
