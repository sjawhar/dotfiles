#!/usr/bin/env python3
"""secret-run-reason: the reason a secrets-broker credential request carries, for scripts/secret-run.

  secret-run-reason --pid PID [--reason R] [-- CMD [ARGS...]]

Prints two lines. The first is a session id for secret-run to export as OMP_SESSION_ID before it
runs the agent-secrets client, or nothing. The second is the reason.

The reason is the only text an approval card shows besides the secret names ("The agent's stated
reason"), and the card's "Session" line comes from the session_id the client puts in the request
body: OMP_SESSION_ID, else ENVOY_SESSION_ID, else CLAUDE_CODE_SESSION_ID (requestSessionID in
sjawhar/legion packages/envoy/cmd/agent-secrets/identity.go). Until 2026-10-31 every gws request
from every session read "gws theorem modify" with "No session named", because accounts.json fixes
the reason and omp's eval kernel runs with no OMP_SESSION_ID (it keeps PI_SESSION_FILE).

So the reason says, in this order, cut to fit:
  - why: R, then SECRET_RUN_REASON from the environment (a caller sets it on one call, such as a
    gws call, whose tier command fixes R), or "no reason given";
  - session: the omp session id and title (the first line of its transcript, the title slot omp
    rewrites in place), and the subagent when PI_SESSION_FILE is a subagent's transcript; else
    the Envoy or Claude Code session id; else "no omp session; pid N, cwd D";
  - runs: the command's name and its first three words before any flag, the ids it targets (the
    top-level "...Id" and "id" fields of a JSON argument such as gws's --params, a --repo or -R
    value, a GitHub or Google Docs URL), and how many arguments it leaves out; "request only, no
    command" for `secret-run request`;
  - host: this machine's name and the pid the request comes from (secret-run execs the client).

The first line is the omp session id when the environment names none the client sends, but
PI_SESSION_FILE names one: with it exported, the request names its session.

No argument value reaches the reason except those words and ids: a flag's value can be a token, a
JSON body can hold a document's text. A word that looks like a credential is left out, and a
credential pattern anywhere in the text (a caller's reason, a title) is replaced by "[redacted]".
The broker refuses a reason over 400 runes or holding a rune of category Cc, Cf, Cs, Co, Zl or Zp
(validateReason in sjawhar/legion packages/envoy/internal/broker/record/record.go), so control
and separator characters become spaces, format, surrogate, private-use and unassigned characters
are dropped, each part has a length cap, and the whole reason ends at 400 runes.
"""

from __future__ import annotations

import json
import os
import re
import socket
import sys
import unicodedata
from collections.abc import Mapping
from pathlib import Path

MAX_REASON = 400
WHY_MAX = 100
SESSION_ID_MAX = 64
TITLE_MAX = 48
SUBAGENT_MAX = 24
RUNS_MAX = 100
WORD_MAX = 40
HOST_MAX = 32
CWD_MAX = 60
COMMAND_WORDS = 3
TARGETS_MAX = 3
JSON_ARGUMENT_MAX = 65536
TITLE_LINE_MAX = 65536

UUID = r"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"
SESSION_ID_RE = re.compile(UUID)
# omp/extensions/session-env.ts: a top-level transcript; a subagent's lives in the directory of
# the same name without .jsonl.
TOP_LEVEL_TRANSCRIPT = re.compile(rf"\d{{4}}-\d{{2}}-\d{{2}}T[\d-]+Z_({UUID})\.jsonl")
TOP_LEVEL_DIRECTORY = re.compile(rf"\d{{4}}-\d{{2}}-\d{{2}}T[\d-]+Z_({UUID})")
# The session variables the agent-secrets client reads, in its order.
CLIENT_SESSION_VARIABLES = ("OMP_SESSION_ID", "ENVOY_SESSION_ID", "CLAUDE_CODE_SESSION_ID")

TOKEN_RE = re.compile(
    r"ya29\.[\w.-]+|1//0[\w-]+|gh[opsur]_[A-Za-z0-9]{20,}|github_pat_\w{20,}|xox[abeoprs]-[\w-]+"
    r"|sk-[\w-]{20,}|A[KS]IA[0-9A-Z]{16}|AIza[\w-]{30,}|glpat-[\w-]{20,}|eyJ[\w-]{8,}\.[\w-]{8,}\.[\w-]*"
)
WORD_RE = re.compile(r"[A-Za-z0-9_./~][A-Za-z0-9._:@/+,~-]*")
ID_VALUE_RE = re.compile(r"[A-Za-z0-9_.:@+-]{1,128}")
ID_KEY_REFUSED = re.compile(r"(?i)token|secret|passw|auth|credential|key")
REPO_RE = re.compile(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+")
GITHUB_URL = re.compile(r"https?://(?:www\.)?github\.com/([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)(?:/(?:pull|issues)/(\d+))?")
GOOGLE_URL = re.compile(
    r"https?://(?:docs|drive)\.google\.com/(?:(?:document|spreadsheets|presentation|forms|file)/d/|open\?id=)"
    r"([A-Za-z0-9_-]{10,})"
)
DROPPED_CATEGORIES = frozenset({"Cf", "Cs", "Co", "Cn"})
SPACE_CATEGORIES = frozenset({"Cc", "Zl", "Zp", "Zs"})


def clean(text: str) -> str:
    """One line the broker accepts: no refused or unassigned rune, single spaces."""
    kept = []
    for character in text:
        category = unicodedata.category(character)
        if category in SPACE_CATEGORIES:
            kept.append(" ")
        elif category not in DROPPED_CATEGORIES:
            kept.append(character)
    return " ".join("".join(kept).split())


def mask(text: str) -> str:
    return TOKEN_RE.sub("[redacted]", text)


def clip(text: str, limit: int) -> str:
    return text if len(text) <= limit else text[: limit - 1].rstrip() + "…"


def clip_left(text: str, limit: int) -> str:
    return text if len(text) <= limit else "…" + text[len(text) - limit + 1 :]


def looks_like_a_credential(word: str) -> bool:
    if TOKEN_RE.search(word):
        return True
    tail = word.rsplit("/", 1)[-1]
    return (
        len(tail) >= 24
        and any(c.isdigit() for c in tail)
        and any(c.islower() for c in tail)
        and any(c.isupper() for c in tail)
    )


def plain_word(word: str) -> bool:
    return len(word) <= 128 and WORD_RE.fullmatch(word) is not None and not looks_like_a_credential(word)


def shorten(word: str) -> str:
    if len(word) <= WORD_MAX:
        return word
    if "/" in word:
        return clip("…/" + word.rstrip("/").rsplit("/", 1)[-1], WORD_MAX)
    return clip(word, WORD_MAX)


def id_key(key: object) -> bool:
    return isinstance(key, str) and (key == "id" or key.endswith("Id")) and not ID_KEY_REFUSED.search(key)


def targets(arguments: list[str]) -> list[str]:
    """What the command acts on, from the shapes that name it, never from a free-text value."""
    found: list[str] = []

    def add(label: str, value: str) -> None:
        item = f"{label}={value}"
        if item not in found:
            found.append(item)

    previous = ""
    for argument in arguments:
        flag, equals, inline = argument.partition("=") if argument.startswith("--") else (argument, "", "")
        value = inline if equals else argument
        if (previous in ("--repo", "-R") and REPO_RE.fullmatch(argument)) or (
            equals and flag == "--repo" and REPO_RE.fullmatch(inline)
        ):
            add("repo", value)
        text = value.strip()
        if text.startswith("{") and len(text) <= JSON_ARGUMENT_MAX:
            try:
                data = json.loads(text)
            except ValueError:
                data = None
            if isinstance(data, dict):
                for key, item in data.items():
                    if id_key(key) and isinstance(item, (str, int)) and not isinstance(item, bool):
                        item = str(item)
                        if item != "me" and ID_VALUE_RE.fullmatch(item):
                            add(key, item)
        elif text.startswith(("http://", "https://")):
            github = GITHUB_URL.match(text)
            if github:
                add("repo", github[1] + (f"#{github[2]}" if github[2] else ""))
            google = GOOGLE_URL.match(text)
            if google:
                add("fileId", google[1])
        previous = argument
    return found[:TARGETS_MAX]


def runs(command: list[str] | None) -> str:
    if command is None:
        return "request only, no command"
    if not command:
        return "no command"
    name = os.path.basename(command[0])
    words = [shorten(name) if plain_word(name) else "…"]
    for argument in command[1 : 1 + COMMAND_WORDS]:
        if argument.startswith("-") or not plain_word(argument):
            break
        words.append(shorten(argument))
    left_out = len(command) - len(words)
    words += targets(command[1:])
    if left_out:
        words.append(f"+{left_out} args")
    return clip(mask(" ".join(words)), RUNS_MAX)


def transcript_root(session_file: str) -> tuple[Path | None, str]:
    """(the top-level transcript, the subagent name) of an omp transcript path."""
    path = Path(session_file)
    if TOP_LEVEL_TRANSCRIPT.fullmatch(path.name):
        return path, ""
    for ancestor in path.parents:
        if TOP_LEVEL_DIRECTORY.fullmatch(ancestor.name):
            subagent = ".".join(path.relative_to(ancestor).with_suffix("").parts)
            return ancestor.parent / f"{ancestor.name}.jsonl", subagent
    return None, ""


def find_transcript(session_id: str, home: Path) -> Path | None:
    if not SESSION_ID_RE.fullmatch(session_id):
        return None
    return next(iter(sorted((home / ".omp" / "agent" / "sessions").glob(f"*/*_{session_id}.jsonl"))), None)


def read_title(transcript: Path) -> str:
    """The session's title: omp keeps it in a fixed-width first line it rewrites in place, and an
    older transcript has it in its session header. Never more than two lines read."""
    try:
        if not transcript.is_file():
            return ""
        with transcript.open("rb") as handle:
            for _ in range(2):
                line = handle.readline(TITLE_LINE_MAX)
                if not line:
                    break
                entry = json.loads(line)
                if isinstance(entry, dict) and entry.get("type") in ("title", "session"):
                    title = entry.get("title")
                    if isinstance(title, str) and title.strip():
                        return title
    except (OSError, ValueError):
        pass
    return ""


def session(environment: Mapping[str, str], pid: int, cwd: str, home: Path) -> tuple[str, str]:
    """(the session part of the reason, the session id to export or "")."""
    root, subagent = transcript_root(environment.get("PI_SESSION_FILE", ""))
    root_id = TOP_LEVEL_TRANSCRIPT.fullmatch(root.name)[1] if root else ""
    named = {variable: environment.get(variable, "").strip() for variable in CLIENT_SESSION_VARIABLES}
    export = ""
    session_id = named["OMP_SESSION_ID"]
    if not session_id and not named["ENVOY_SESSION_ID"] and not named["CLAUDE_CODE_SESSION_ID"]:
        session_id = export = root_id
    if session_id:
        if session_id != root_id:
            root, subagent = find_transcript(session_id, home), ""
        title = read_title(root) if root else ""
        part = f"omp {clip(clean(mask(session_id)), SESSION_ID_MAX)}"
        if title:
            part += f' "{clip(clean(mask(title)), TITLE_MAX)}"'
        if subagent:
            part += f" subagent {clip(clean(mask(subagent)), SUBAGENT_MAX)}"
        return part, export
    if named["ENVOY_SESSION_ID"]:
        return f"envoy {clip(clean(mask(named['ENVOY_SESSION_ID'])), SESSION_ID_MAX)}", ""
    if named["CLAUDE_CODE_SESSION_ID"]:
        return f"claude {clip(clean(mask(named['CLAUDE_CODE_SESSION_ID'])), SESSION_ID_MAX)}", ""
    return f"no omp session; pid {pid}, cwd {clip_left(clean(mask(cwd)), CWD_MAX)}", ""


def working_directory(home: Path) -> str:
    try:
        cwd = os.getcwd()
    except OSError:
        return "unknown"
    home_text = str(home)
    if home_text not in ("", "/") and (cwd == home_text or cwd.startswith(home_text + "/")):
        return "~" + cwd[len(home_text) :]
    return cwd


def build(
    caller_reason: str,
    command: list[str] | None,
    environment: Mapping[str, str],
    pid: int,
    host: str | None = None,
    cwd: str | None = None,
) -> tuple[str, str]:
    """(the session id to export or "", the reason)."""
    home = Path(environment.get("HOME") or Path.home())
    host = socket.gethostname() if host is None else host
    cwd = working_directory(home) if cwd is None else cwd
    session_part, export = session(environment, pid, cwd, home)
    host_part = f"host: {clip(clean(host), HOST_MAX) or 'unknown'}"
    if not session_part.startswith("no omp session"):
        host_part += f" pid {pid}"
    rest = " | ".join((f"session: {session_part}", f"runs: {runs(command)}", host_part))
    # The caller's words give way first, so the session, the command and the pid always show.
    why_max = max(16, min(WHY_MAX, MAX_REASON - len(rest) - len(" | ")))
    stated = [part for part in (caller_reason.strip(), environment.get("SECRET_RUN_REASON", "").strip()) if part]
    why = clip(clean(mask("; ".join(stated))), why_max) or "no reason given"
    return export, clip(clean(f"{why} | {rest}"), MAX_REASON)


USAGE = "usage: secret-run-reason --pid PID [--reason R] [-- CMD [ARGS...]]"


def main(argv: list[str]) -> int:
    pid = os.getppid()
    caller_reason = ""
    command: list[str] | None = None
    arguments = iter(argv)
    try:
        for argument in arguments:
            if argument == "--pid":
                pid = int(next(arguments))
            elif argument == "--reason":
                caller_reason = next(arguments)
            elif argument == "--":
                command = list(arguments)
            else:
                raise ValueError(argument)
    except (StopIteration, ValueError):
        print(USAGE, file=sys.stderr)
        return 2
    export, reason = build(caller_reason, command, os.environ, pid)
    sys.stdout.buffer.write(f"{export}\n{reason}\n".encode())
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
