#!/usr/bin/env bash
# hawk-token: print one fresh Hawk (Cognito) access token on stdout and nothing else.
#
# A thin wrapper over agent-c's `hawk-token` console script (agent-c #19673,
# meta/trajectory_labs/src/trajectory_labs/hawk_token.py), which performs one OAuth
# refresh grant per run through hawk's own refresh path so every run yields a jti
# middleman has never seen. omp's models.local.yml resolves `!hawk-token` for the
# anthropic provider's apiKey and X-Api-Key header; omp caches the value for the
# process and re-runs this on a 401. The script name is stable so live omp sessions
# and `agentbox doctor` need no change.
#
# The console script runs from a private shallow checkout of agent-c main that this
# wrapper owns, not from ~/src/agent-c: that is the shared jj store's default
# workspace and its working copy sits wherever the last session left it. The
# checkout lives under ~/src (a dot-dir, so `agentbox new <repo>` never sees it)
# because ~/src is already mounted rw into every box — one clone on the host serves
# every running session with no restart. It is refreshed at most once per
# REFRESH_SECONDS and only when the run is not on a client's 401-retry budget (omp
# kills a `!command` after 10 s); `uv sync --frozen` is a no-op when the lock has not
# moved, so the steady-state cost is one `uv run` (~1 s warm).
set -euo pipefail

: "${HAWK_API_URL:=https://api.hawk.internal.trajectorylabs.com}"
export HAWK_API_URL

root="${AGENTBOX_SRC:-$HOME/src}/.hawk-token"
checkout="$root/agent-c"
stamp="$root/.refreshed"
REFRESH_SECONDS="${HAWK_TOKEN_REFRESH_SECONDS:-21600}"
mkdir -p "$root"

log() { echo "hawk-token: $*" >&2; }

if [ ! -f "$stamp" ]; then
    # First run, or a previous first run died mid-way: build in a scratch dir and
    # rename into place, so a half-clone never masquerades as a checkout. The stamp
    # is written last and is the readiness marker every later run keys on. The
    # scratch dir is per-invocation, so two first runs (host and a box, say) do not
    # touch each other's; whichever finishes second wins the rename, harmlessly.
    log "first run: cloning agent-c main into $checkout (about a minute)"
    scratch="$(mktemp -d "$root/.clone.XXXXXX")"
    git clone --quiet --depth 1 --branch main --filter=blob:none \
        https://github.com/trajectory-labs-pbc/agent-c.git "$scratch/agent-c" 1>&2
    rm -rf "$checkout"
    mv "$scratch/agent-c" "$checkout"
    rmdir "$scratch"
    # The venv records absolute paths, so it is built at the final location.
    ( cd "$checkout" && uv sync --frozen --no-dev --quiet 1>&2 )
    touch "$stamp"
elif [ -z "$(find "$stamp" -newermt "-$REFRESH_SECONDS seconds" 2>/dev/null)" ]; then
    # Stale: advance to main. Never on a hot path — a client retrying a 401 has
    # already spent seconds; a fetch that fails leaves the previous checkout usable.
    if ( cd "$checkout" && git fetch --quiet --depth 1 origin main 1>&2 \
        && git reset --quiet --hard origin/main 1>&2 \
        && uv sync --frozen --no-dev --quiet 1>&2 ); then
        touch "$stamp"
    else
        log "refresh of $checkout failed; minting from the previous checkout (see stderr above)"
    fi
fi

exec uv run --frozen --no-dev --project "$checkout" hawk-token --api-url "$HAWK_API_URL" "$@"
