#!/usr/bin/env bash
# hawk-token: print one fresh Hawk (Cognito) access token on stdout and nothing else.
#
# A thin wrapper over agent-c's `hawk-token` console script (agent-c #19673,
# meta/trajectory_labs/src/trajectory_labs/hawk_token.py), which performs one OAuth
# refresh grant per run through hawk's own refresh path so every run yields a jti
# middleman has never seen. omp's models.local.yml resolves `!hawk-token` for the
# anthropic provider's apiKey and X-Api-Key header; omp caches the value for the
# process and re-runs this on a 401. The script name is stable so live omp sessions
# and `agentbox doctor` need no change.
#
# The console script runs from a private shallow checkout of agent-c main that this
# wrapper owns, not from ~/src/agent-c: that is the shared jj store's default
# workspace and its working copy sits wherever the last session left it. The
# checkout lives under ~/src (a dot-dir, so `agentbox new` never offers it as a repo)
# because ~/src is already mounted rw into every box: one clone on the host serves
# every running session with no restart.
#
# Minting never runs git. omp kills a `!command` after 10 s, and the host and every
# box share this checkout. On 2026-09-24 a refresh done in place on the minting path
# was killed mid-write at 11:42; its leftover index.lock failed every later refresh
# until 2026-09-25 07:08, and `!hawk-token` came back empty in several sessions. So:
#   - two slots, $root/agent-c and $root/agent-c.alt; `current` is a symlink to the
#     live one, and minting always runs from whatever `current` resolves to;
#   - a stale stamp starts ONE detached background refresh (flock, which the kernel
#     releases if the holder dies; a mkdir lock where flock is missing) that rebuilds
#     the IDLE slot, checks it can import the console script's module, and only then
#     swaps `current` with an atomic rename;
#   - the live slot is never rewritten, so a refresh killed at any point leaves the
#     previous checkout intact and minting unaffected.
# Each slot's venv records absolute paths, so it is built at that slot's path; slots
# never move, only the symlink does. Refresh output goes to $root/refresh.log.
set -euo pipefail
# omp kills a `!command` after 10 s, so the whole run, not only the mint, spends one budget.
started_ns="$(date +%s%N)"
MINT_BUDGET_MS=9000

: "${HAWK_API_URL:=https://api.hawk.internal.trajectorylabs.com}"
export HAWK_API_URL

root="${AGENTBOX_SRC:-$HOME/src}/.hawk-token"
current="$root/current"
stamp="$root/.refreshed"
REFRESH_SECONDS="${HAWK_TOKEN_REFRESH_SECONDS:-21600}"
LOCK_STALE_MINUTES=30
REFRESH_ARG=__hawk_token_background_refresh
mkdir -p "$root"

log() { echo "hawk-token: $*" >&2; }

# take_lock nonblock|block: hold the refresh lock for the rest of this process.
take_lock() {
    if command -v flock >/dev/null 2>&1; then
        exec 9>"$root/.refresh.lock"
        if [ "$1" = nonblock ]; then flock -n 9; else flock 9; fi
        return
    fi
    local dir="$root/.refresh.lock.d"
    until mkdir "$dir" 2>/dev/null; do
        if [ -n "$(find "$dir" -maxdepth 0 -mmin +"$LOCK_STALE_MINUTES" 2>/dev/null)" ]; then
            rm -rf "$dir"
        elif [ "$1" = nonblock ]; then
            return 1
        else
            sleep 2
        fi
    done
    trap 'rm -rf "$dir"' EXIT
}

# release_lock: drop the lock before exec (exec replaces the process without running traps).
release_lock() {
    if command -v flock >/dev/null 2>&1; then exec 9>&-; else rm -rf "$root/.refresh.lock.d"; trap - EXIT; fi
}

# build_slot DIR: make DIR a checkout of agent-c main with a working venv. DIR is never
# the live slot, and the refresh lock is held, so any git lock file in it is a leftover
# from a killed run. Every step fails the function explicitly: errexit does not apply
# inside a function called as an `if` condition.
build_slot() {
    local slot=$1 scratch
    if [ -d "$slot/.git" ]; then
        find "$slot/.git" -name '*.lock' -type f -delete || return 1
        ( cd "$slot" && git fetch --quiet --depth 1 origin main && git reset --quiet --hard origin/main ) || return 1
    else
        scratch="$(mktemp -d "$root/.clone.XXXXXX")" || return 1
        git clone --quiet --depth 1 --branch main --filter=blob:none \
            https://github.com/trajectory-labs-pbc/agent-c.git "$scratch/agent-c" || { rm -rf "$scratch"; return 1; }
        rm -rf "$slot" && mv "$scratch/agent-c" "$slot" && rmdir "$scratch" || return 1
    fi
    ( cd "$slot" && uv sync --frozen --no-dev --quiet ) || return 1
    # Validate the command minting runs, not `uv run hawk-token`: a slot venv
    # without the console script would make uv fall back to this wrapper on PATH,
    # which mints from the live slot and passes the check vacuously.
    "$slot/.venv/bin/hawk-token" --api-url "$HAWK_API_URL" >/dev/null 2>&1 || return 1
}

# publish NAME: point `current` at the sibling slot NAME, atomically (rename(2)
# replaces the symlink itself, never follows it).
publish() {
    ln -sfn "$1" "$current.tmp.$$"
    if mv -Tf "$current.tmp.$$" "$current" 2>/dev/null; then return; fi
    python3 -c 'import os, sys; os.replace(sys.argv[1], sys.argv[2])' "$current.tmp.$$" "$current"
}

if [ "${1:-}" = "$REFRESH_ARG" ]; then
    take_lock nonblock || exit 0
    # A sibling may have finished a refresh while this one was starting.
    if [ -n "$(find "$stamp" -newermt "-$REFRESH_SECONDS seconds" 2>/dev/null)" ]; then exit 0; fi
    live="$(basename "$(readlink "$current")")"
    if [ "$live" = agent-c ]; then idle=agent-c.alt; else idle=agent-c; fi
    if build_slot "$root/$idle"; then
        publish "$idle"
        touch "$stamp"
        log "$(date -u +%FT%TZ) refreshed: current -> $idle"
    else
        log "$(date -u +%FT%TZ) refresh of $root/$idle failed; still minting from $live"
    fi
    exit 0
fi

if [ ! -L "$current" ]; then
    if [ -f "$stamp" ] && [ -d "$root/agent-c/.git" ]; then
        # A checkout built by the single-checkout version of this wrapper: adopt it.
        publish agent-c
    else
        # First run: there is nothing to mint from yet, so build in the foreground.
        take_lock block
        if [ ! -L "$current" ]; then
            log "first run: cloning agent-c main into $root/agent-c (about a minute)"
            build_slot "$root/agent-c" 1>&2 || { log "first-run build failed (see stderr above)"; exit 1; }
            publish agent-c
            touch "$stamp"
        fi
        release_lock
        # A foreground build that outlived the budget proves the caller is not omp's
        # 10 s `!command` (a terminal bootstrapping a fresh machine), so give the mint
        # a fresh budget; a fast build keeps whatever was left.
        [ $(( ($(date +%s%N) - started_ns) / 1000000 )) -lt "$MINT_BUDGET_MS" ] || started_ns="$(date +%s%N)"
    fi
fi

if [ -z "$(find "$stamp" -newermt "-$REFRESH_SECONDS seconds" 2>/dev/null)" ]; then
    # Detached from this call's session, so omp killing the minting call cannot reach it.
    if command -v setsid >/dev/null 2>&1; then
        setsid "${BASH_SOURCE[0]}" "$REFRESH_ARG" </dev/null >>"$root/refresh.log" 2>&1 &
    else
        nohup "${BASH_SOURCE[0]}" "$REFRESH_ARG" </dev/null >>"$root/refresh.log" 2>&1 &
    fi
fi

# A mint that prints nothing is worse than one that fails: omp stores the empty
# value as the anthropic apiKey, reports MissingApiKeyError, and makes no request
# at all, so its own re-mint-on-401 can never fire again this turn. On 2026-09-27
# a transient failure at 14:07Z did exactly that on two machines seven seconds
# apart.
#
# A mint slows down with the machine: a healthy one takes about 1.5 s, but at load
# 200 on 32 cores (2026-09-28 19:20Z) the same mint took 7-9 s. The earlier two
# fixed 4 s attempts then failed for every session that minted, so the first
# attempt now gets whatever is left of the budget, and a second runs only if time
# remains, which is what a fast transient failure leaves.
#
# The slot's console script runs directly. `uv run` re-resolved the project and
# reinstalled it into the shared slot venv on every mint: about 3 s under load, and
# a concurrent write into one venv from every session minting at once. The
# background refresh validates each new slot by running this same console script
# before publishing it (build_slot).
mint_bin="$(readlink -f "$current")/.venv/bin/hawk-token"
err="$(mktemp)"
trap 'rm -f "$err"' EXIT
tries=0
for attempt in 1 2; do
    left_ms=$(( MINT_BUDGET_MS - ($(date +%s%N) - started_ns) / 1000000 ))
    if [ "$attempt" = 2 ]; then
        # Pause before retrying only when a retry can still fit in the budget.
        [ "$left_ms" -gt 1500 ] || break
        sleep 0.5
        # Re-read the clock: under the load this budget exists for, sleep overshoots.
        left_ms=$(( MINT_BUDGET_MS - ($(date +%s%N) - started_ns) / 1000000 ))
    fi
    [ "$left_ms" -gt 500 ] || break
    tries=$attempt
    if command -v timeout >/dev/null 2>&1; then
        out="$(timeout "$(( left_ms / 1000 )).$(printf '%03d' $(( left_ms % 1000 )))" \
            "$mint_bin" --api-url "$HAWK_API_URL" "$@" 2>"$err")" || out=""
    else
        out="$("$mint_bin" --api-url "$HAWK_API_URL" "$@" 2>"$err")" || out=""
    fi
    if [ -n "$out" ]; then printf '%s\n' "$out"; exit 0; fi
done
log "mint produced no token after $tries attempt(s) in $(( ($(date +%s%N) - started_ns) / 1000000 )) ms of a ${MINT_BUDGET_MS} ms budget; last stderr follows"
cat "$err" >&2
exit 1
