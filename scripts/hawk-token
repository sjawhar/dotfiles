#!/usr/bin/env bash
# hawk-token: print one fresh Hawk (Cognito) access token on stdout and nothing else.
#
# omp's models.yml resolves `!hawk-token` for the anthropic provider's apiKey and
# X-Api-Key header (omp/models.yml), so the model gateway gets a per-person,
# short-lived credential instead of a static Anthropic key. omp caches the value
# for the process and re-runs the command on a 401.
#
# Every invocation mints a token with a FRESH jti via the OAuth refresh grant
# (`hawk auth refresh-token` supplies the RT; the Hawk API's /auth/config supplies
# the Cognito token endpoint and client id). The jti matters: middleman spends a
# token's jti on the one Anthropic exchange it is allowed, so handing omp's 401
# retry the SAME cached token (what `hawk auth access-token` does until 5 minutes
# before expiry) can never heal the cross-workspace `assertion_consumed` challenge
# — a fresh jti always can. Cost is one refresh grant per helper invocation
# (process start or 401 retry), never per request. The pool's web client has
# refresh-token rotation OFF (verified 2026-09-17), so this never invalidates the
# hawk CLI's stored session; if Cognito ever returns a rotated refresh token the
# grant response would carry `refresh_token`, and this script warns loudly since
# dropping it would strand the CLI's stored one. Any failure on the fresh path
# falls back to `hawk auth access-token` (the pre-2026-09-17 behavior), logged.
#
# hawk writes every notice (access-token refresh, CLI version check, login help)
# to stderr, and omp's `!command` resolver lets the child inherit the TUI's
# stderr, so stderr is captured to a log here. stdout is accepted only when it is
# exactly one JWT: anything else fails loudly instead of becoming a credential.
#
# Runs the hawk synced into the agent-c checkout — uv.lock pins it to the same
# commit as the infrastructure — never a standalone `uv tool install` copy, which
# drifts from that pin (using-hawk skill in agent-c).
#
# Inside an agent box (the image's /etc/agentbox-identity marker) the GNOME
# keyring that holds the Hawk session is deliberately absent, so the token is
# read from the socket scripts/agentbox mounts in: on the host the unit
# agentbox-hawk-token runs this script once per connection and streams the JWT
# back. The same one-JWT rule applies to what arrives.
set -euo pipefail

# The Hawk API that issues the token. It must belong to the same stack as the
# gateway baseUrl in omp/models.yml: production (the default here, armed
# 2026-09-15) pairs with https://api.hawk.internal.trajectorylabs.com, staging
# with https://api.hawk.staging.trajectorylabs.com. Tokens are stored per
# stack, so `hawk login` is needed once per API URL.
export HAWK_API_URL="${HAWK_API_URL:-https://api.hawk.internal.trajectorylabs.com}"

log_dir="${XDG_STATE_HOME:-$HOME/.local/state}/hawk-token"
mkdir -p "$log_dir"
log="$log_dir/hawk.log"

if [[ -e /etc/agentbox-identity ]]; then
    # Same path as HAWK_SOCK in scripts/agentbox; /run/user/<uid> is bound at
    # the host path, so the uid is the host's.
    sock="/run/user/$UID/agentbox/hawk-token/hawk-token.sock"
    if [[ ! -S "$sock" ]]; then
        echo "hawk-token: in an agent box but the host forwarder socket $sock is missing; run \`agentbox doctor\` on the host" >&2
        exit 1
    fi
    where="$log, or \`journalctl --user -u agentbox-hawk-token\` on the host"
    # -u: read the socket, write stdout, never touch stdin; socat exits on the
    # forwarder's EOF instead of waiting on a stdin that omp keeps open.
    if ! token="$(socat -u "UNIX-CONNECT:$sock" STDOUT 2>>"$log")"; then
        echo "hawk-token: reading from the host forwarder at $sock failed; see $where" >&2
        exit 1
    fi
else
    agent_c="${AGENT_C_DIR:-$HOME/agent-c}"
    hawk="$agent_c/.venv/bin/hawk"
    if [[ ! -x "$hawk" ]]; then
        echo "hawk-token: no hawk at $hawk; run \`uv sync\` in $agent_c (or set AGENT_C_DIR to the checkout)" >&2
        exit 1
    fi
    where="$log"
    fresh_mint() {
        local rt config token_endpoint client_id response
        rt="$("$hawk" auth refresh-token 2>>"$log")" || return 1
        [[ -n "$rt" ]] || return 1
        config="$(curl -fsS --max-time 10 "$HAWK_API_URL/auth/config" 2>>"$log")" || return 1
        read -r token_endpoint client_id < <(python3 -c '
import json, sys
d = json.loads(sys.argv[1])
print(d["token_endpoint"], d["client_id"])
' "$config" 2>>"$log") || return 1
        [[ -n "$token_endpoint" && -n "$client_id" ]] || return 1
        # Public client: the refresh grant needs no secret. The RT travels in the
        # POST body over TLS, same as the hawk CLI's own refresh.
        response="$(curl -fsS --max-time 15 "$token_endpoint" \
            -H 'Content-Type: application/x-www-form-urlencoded' \
            --data-urlencode 'grant_type=refresh_token' \
            --data-urlencode "client_id=$client_id" \
            --data-urlencode "refresh_token=$rt" 2>>"$log")" || return 1
        python3 -c '
import json, sys
d = json.loads(sys.stdin.read())
if "refresh_token" in d:
    print(
        "hawk-token: Cognito returned a ROTATED refresh token; rotation is expected"
        " to be off, and dropping it strands the hawk CLI session. Re-run hawk login"
        " and investigate the pool client config.",
        file=sys.stderr,
    )
token = d.get("access_token", "")
if not token:
    raise SystemExit(1)
print(token)
' <<<"$response" 2>>"$log"
    }
    if ! token="$(fresh_mint)"; then
        echo "hawk-token: fresh mint via the refresh grant failed; falling back to the cached token (see $log)" >>"$log"
        if ! token="$("$hawk" auth access-token 2>>"$log")"; then
            echo "hawk-token: \`hawk auth access-token\` failed for $HAWK_API_URL; see $log (usually: run \`hawk login\` for that API, or unlock the keyring)" >&2
            exit 1
        fi
    fi
fi
if [[ ! "$token" =~ ^[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+$ ]]; then
    echo "hawk-token: got something other than one JWT (${#token} bytes); see $where" >&2
    exit 1
fi
printf '%s\n' "$token"
