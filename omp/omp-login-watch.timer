[Unit]
Description=Check every minute that this box's omp sessions still have a provider login

[Timer]
OnActiveSec=30s
OnUnitActiveSec=60s
# The ask must reach a person within five minutes of the crossing, and one pass costs 4-15 s,
# so a minute of period plus 10 s of accuracy leaves the whole budget to Dispatch. A tighter
# period would buy nothing: only a person can act on the alert.
AccuracySec=10s

[Install]
WantedBy=timers.target
