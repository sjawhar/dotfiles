[Unit]
Description=Report omp sessions spending on per-token API billing (openai, opencode-zen)
# Reports every hour and does not alert. Sami, 2026-09-27T03:11Z, answering
# dispatch://AGENTC-27/ask/1295ec24-de6f-4fa9-9ed8-c06baa55f692 with "Allow it":
# "Agents may use the OpenAI API overnight. I change the watch to report spend
# every hour instead of raising an alarm." -- and "Just shut up." The watch half
# has no time scope. A deviation exits non-zero, so the unit goes `failed` and the
# journal records the finding: that is the report. --alert would also send it to
# the `sre` Envoy role, and the SRE would then chase spend he has allowed. Do not
# add --alert back without a new ruling.

[Service]
Type=oneshot
ExecStart=%h/.dotfiles/scripts/omp-billing-watch --hours 1
