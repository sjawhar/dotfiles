[Unit]
Description=Tell the box-health owner once when the Rocq speed lead's root omp session hangs on a tool call
Documentation=file:%h/.dotfiles/scripts/omp-root-hang-watch.md

[Service]
Type=oneshot
# Below the lanes: the watch reads one file and answers on a 30-minute scale, so a run that
# starts a minute late changes nothing.
Nice=15
IOSchedulingClass=idle
# A quiet run costs about 0.4 s of CPU and 1-2 s wall on sami-rocqperf at load 215
# (2026-11-03): python3 start-up, one GET /v1/sessions (0.15 s), one stat. Its 4 failures in 40 h
# were all kills at the old 120 s limit during box-wide stalls (2026-11-02 18:15Z and 22:16Z,
# 2026-11-03 00:32Z and 00:37Z), when omp-memory-watch, envoy-role-holder-watch, omp-login-watch
# and disk-fill-watch timed out in the same minutes and `systemctl --user` itself answered
# "Connection timed out"; the 00:32Z run had used 1.0 s of CPU in its 120 s. 240 s rides out such
# a stall and still ends before the next 5-minute start; an alert adds one `envoy send` (60 s
# cap in the script).
TimeoutStartSec=240
# `envoy` is a bash script that needs the same tools a shell gives it.
Environment=PATH=%h/.dotfiles/shims:%h/.dotfiles/bin:%h/.dotfiles/scripts:%h/.local/bin:%h/.mise/shims:/usr/local/bin:/usr/bin:/bin
Environment=MISE_DATA_DIR=%h/.mise
ExecStart=%h/.dotfiles/scripts/omp-root-hang-watch
