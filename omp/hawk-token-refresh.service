[Unit]
Description=Mint a fresh hawk-token credential off any agent turn's budget (scripts/AGENTS.md's `hawk-token` entry)
# Runs the ordinary `hawk-token` mint (its own cache-fallback and slot-refresh
# machinery are unchanged) with no 9/10 s budget of its own: a systemd oneshot has
# nothing racing it, so a slow mint under load just takes longer, it does not fail.
# Its ONLY effect that matters here is the atomic rewrite of
# $root/last-good-token (hawk-token's own `save_token()`), which
# `scripts/hawk-token-fast` -- what omp's `!command` actually calls now -- reads
# with no network or OAuth exchange at all. Keeping the cache's floor
# (CACHE_MIN_TTL_SECONDS=300) 300s/3600s away from the token's 1-hour lifetime, a
# 3-minute refresh cadence leaves about 55 minutes of slack even if every refresh
# in a row fails.

[Service]
Type=oneshot
ExecStart=%h/.dotfiles/scripts/hawk-token
# hawk-token prints the live token itself on stdout (the thing `hawk-token-fast`
# would otherwise have to mint live) -- a secret this unit's only consumer never
# reads, since the side effect that matters is its `save_token()` rewrite of
# last-good-token. Discard it rather than let the journal hold a plaintext token
# every 3 minutes; its own log() messages (refresh/slot-rebuild status) go to
# stderr and still reach the journal for debugging.
StandardOutput=null
# Same PATH gap as ctx-ingest.service: systemd user units default to
# /usr/bin:/bin, which resolves neither the dotfiles git shim nor mise's uv shim
# that hawk-token's `uv sync`/mint step needs. %h, not a literal /home/ubuntu:
# this unit runs on more than one machine (sami-agents, devbox-agents-2, the
# laptop, oryx), each with its own $HOME.
Environment=PATH=%h/.dotfiles/shims:%h/.dotfiles/bin:%h/.dotfiles/scripts:%h/.local/bin:%h/.mise/shims:/usr/local/bin:/usr/bin:/bin
# mise's own shims (the `uv` one, and whatever the slot-refresh's
# `gh-app-token` credential helper resolves `secrets` to) need their data dir
# told explicitly: a systemd user unit does not inherit the interactive
# .bashrc export, so mise falls back to the XDG default (~/.local/share/mise),
# finds no installs there, and the slot-refresh's credential helper dies with
# "secrets is not a valid shim" -- installers/mise.sh's own environment.d
# drop-in documents exactly this gap for other mise-shimmed user services.
Environment=MISE_DATA_DIR=%h/.mise
