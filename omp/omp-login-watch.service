[Unit]
Description=Tell a person when this box's omp sessions have lost a provider login
Documentation=file:%h/.dotfiles/scripts/omp-login-watch.md
# A pass that dies sends nothing, and this is the only watch here whose alert a person needs.
# Without this line a dead watch is a red unit in a journal nobody reads, which is the silence
# of 2026-11-01 again (dispatch://INFRA-387); the handler says it over Envoy.
OnFailure=omp-login-watch-failed.service

[Service]
Type=oneshot
# Last in line for CPU and disk, like omp-memory-watch: this box runs at load 100+, and a
# watch that competes with the sessions it watches is worse than one that answers later.
Nice=15
IOSchedulingClass=idle
# One pass is a read-only sqlite read, a /proc read of the omp processes, one Envoy GET and the
# tails of the transcripts written in the last five minutes, found from the files the sessions
# hold open and a cache, not a walk of the session tree: 0.6-3.7 s at load 250 with 51 omp
# processes (2026-11-03). The evidence stops at 30 s from the process's start whatever the box
# does: each evidence read runs in a forked child under a hard limit, and a pass whose read is
# cut opens only a crossing the credential store shows on its own, then exits 0. A run that
# cannot finish is killed, so runs never pile up on the 60 s period. The dispatch CLI gets 60 s
# of it, or what is left of the pass's 100 s.
TimeoutStartSec=120
# The dispatch CLI is how this watch reaches a person, and it is the only alert path here that
# needs an environment: bun on PATH, the host it belongs to, and a session id to act as. The id
# is this machine's, so installers/omp-login-watch.sh writes it in a drop-in beside this unit.
Environment=PATH=%h/.mise/shims:%h/.dotfiles/scripts:/usr/local/bin:/usr/bin:/bin
Environment=DISPATCH_HOST=omp
ExecStart=%h/.dotfiles/scripts/omp-login-watch
