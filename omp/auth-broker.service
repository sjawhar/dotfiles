[Unit]
Description=omp auth-broker: the one process that refreshes this machine's model logins
# Without it, every omp session on the machine refreshes the shared login itself,
# against one SQLite file. Anthropic's refresh tokens are single use, so a refresh
# that wins the exchange and then loses its write leaves a spent token in the row
# and the next refresh gets invalid_grant, which disables the login for every
# session. That happened on 2026-10-25 at 07:20Z: 48 processes raced after one
# revoked access token, and nothing could reach Anthropic until a new sign-in
# 7 hours later (dispatch://INFRA-387).
#
# The broker serves the same local store, so it needs no sign-in of its own. A
# session that has `auth.broker.url` set asks it for an access token and never
# holds a refresh token, and the broker refreshes anything within 5 minutes of
# expiry on its own. Sessions already running keep refreshing directly until they
# restart; they race less, because the broker keeps the token fresh ahead of them.
After=default.target

[Service]
Type=simple
# The broker's own bearer token is written to ~/.omp/auth-broker.token (0600) at
# first start, and a client on this machine reads that file itself, so the client
# needs only the URL.
ExecStart=%h/.mise/shims/omp auth-broker serve --bind=127.0.0.1:18777
Restart=always
RestartSec=2
# A systemd user unit gets /usr/bin:/bin, which resolves neither mise's shims nor
# the dotfiles ones; and mise needs its data dir named, since the unit does not
# read the interactive .bashrc (installers/mise.sh's environment.d drop-in
# documents the same gap).
Environment=PATH=%h/.dotfiles/shims:%h/.dotfiles/bin:%h/.dotfiles/scripts:%h/.local/bin:%h/.mise/shims:/usr/local/bin:/usr/bin:/bin
Environment=MISE_DATA_DIR=%h/.mise
# The broker is a client of nothing: leaving these set would make it ask itself.
Environment=OMP_AUTH_BROKER_URL=
Environment=OMP_AUTH_BROKER_TOKEN=

[Install]
WantedBy=default.target
