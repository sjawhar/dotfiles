[Unit]
Description=Report omp sessions whose Anthropic prompt caching stopped holding (uncached input share)
# Reports every hour and does not alert, on the ruling the billing watch runs
# under. Sami, 2026-09-27T03:11Z, answering
# dispatch://AGENTC-27/ask/1295ec24-de6f-4fa9-9ed8-c06baa55f692 with "Allow it":
# "Agents may use the OpenAI API overnight. I change the watch to report spend
# every hour instead of raising an alarm." -- and "Just shut up." That ruling
# named the billing watch; the coordinator's brief of 2026-09-30 that asked for
# this watch applied it here: no --alert to any Envoy role. A deviation exits
# non-zero, so the unit goes `failed` and the journal records the finding: that
# is the report. The script has no --alert; do not add one without a new ruling.

[Service]
Type=oneshot
ExecStart=%h/.dotfiles/scripts/omp-cache-watch --hours 1
