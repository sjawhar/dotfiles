[Unit]
Description=Alert over Envoy before a filesystem on this machine fills
Documentation=file:%h/.dotfiles/scripts/disk-fill-watch.md

[Service]
Type=oneshot
# Last in line for CPU and disk: this box runs at load 100+, and a disk watch whose own reads
# add to the IO it is watching is worse than one that answers later.
Nice=15
IOSchedulingClass=idle
# A run that cannot finish is killed, so runs can never pile up on the 5-minute period. The
# script bounds itself first (--run-budget, 90 s): an ordinary pass is statvfs plus a budgeted
# scratch scan, ~10 s on this box at load 250, and a pass that alerts also samples /proc/*/io
# twice 15 s apart, reads the guard's journal and sizes young directories, measured at 67 s.
# Seven runs in the 6 h to 2026-11-03T02:39Z were killed here because the scan had no bound of
# its own; now the run skips what it cannot pay for and still sends.
TimeoutStartSec=120
# --no-mount-alerts: from 2026-11-07, agent-infra#2349 gives this machine the `owner:sjawhar`
# attribute, so Datadog's own host monitors page on a filesystem filling here. The timer stays,
# because nothing else does its other three duties -- the IOPS-cap check, naming the processes
# that are writing, and the free-space series the forecast reads -- but two alerts for one
# crossing teach people to ignore both. Turning off the one duty rather than removing the timer
# was the INFRA lead's call, 2026-11-07 14:08Z.
ExecStart=%h/.dotfiles/scripts/disk-fill-watch --no-mount-alerts
