[Unit]
Description=Watch sami-devbox from this machine: restart the registry's dead sessions, alert on the box and on the merge train
Documentation=file:%h/.dotfiles/scripts/devbox-offbox-watch.md

[Service]
Type=oneshot
# It watches another machine, so it must not compete with this one's own work.
Nice=15
IOSchedulingClass=idle
# One pass per timer tick: `oneshot` plus a timer, the shape every other watch here has. The one
# rule that shape imposes is that a run must end well inside the timer's period, because systemd
# starts no second run while one is active and the timer then looks stopped: at 19:46:31Z on
# 2026-11-04 a run waited 180 s for each of three restarts, stayed `activating` past three
# periods, and unit-health-watch reported "TIMER STOPPED FIRING". So a run is bounded instead:
# one ssh probe (about 1 s), one liveness call (one `omp-session-live` per auto_restart=yes entry
# on sami-devbox, about 0.75 s each, some 35 s at 44 entries), and at most 3 restarts of 45 s
# each, since a session that is not up by then is looked at again on the next run. That is about
# 170 s at worst. TimeoutStartSec kills a run that goes past 240 s, so systemd is free again
# before the next start rather than sitting in `activating`.
TimeoutStartSec=240
# `envoy` is a bash script that needs the same tools a shell gives it, and ssh must find its config.
Environment=PATH=%h/.dotfiles/shims:%h/.dotfiles/bin:%h/.dotfiles/scripts:%h/.local/bin:%h/.mise/shims:/usr/local/bin:/usr/bin:/bin
Environment=MISE_DATA_DIR=%h/.mise
ExecStart=%h/.dotfiles/scripts/devbox-offbox-watch
