[Unit]
Description=Daily AskGate readout (scripts/advisor-report)

[Timer]
OnCalendar=*-*-* 06:00:00 UTC
# A box that was asleep or rebooted still runs the readout it missed: the kill rules read the
# last 24 hours and the whole window, and neither waits for the next day.
Persistent=true
# Keeps the stats.db sync the readout starts off the minute every other daily unit starts.
RandomizedDelaySec=180

[Install]
WantedBy=timers.target
