{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/src/config/mcp-schema.json",
  "mcpServers": {
    "slack": {
      "type": "http",
      "url": "https://mcp.slack.com/mcp",
      "oauth": {
        "clientId": "1601185624273.8899143856786",
        "callbackPort": 3118
      }
    },
    "apify": {
      "command": "secrets",
      "args": [
        "APIFY_TOKEN",
        "--",
        "npx",
        "-y",
        "@apify/actors-mcp-server"
      ]
    },
    "home-assistant": {
      "command": "secrets",
      "args": [
        "HA_MCP_URL",
        "--",
        "npx",
        "-y",
        "-p",
        "mcp-remote@0.14.3",
        "mcp-remote-from-env",
        "HA_MCP_URL",
        "--allow-http"
      ]
    },
    "deel": {
      "lazy": true,
      "command": "secrets",
      "args": [
        "DEEL_API_KEY",
        "--",
        "npx",
        "-y",
        "mcp-remote@0.14.3",
        "https://api.letsdeel.com/mcp",
        "--header",
        "Authorization: Bearer ${DEEL_API_KEY}"
      ],
      "enabled": true
    },
    "retell": {
      "lazy": true,
      "command": "secrets",
      "args": [
        "RETELL_API_KEY",
        "--",
        "npx",
        "-y",
        "mcp-remote@0.14.3",
        "https://mcp.retellai.com",
        "--header",
        "Authorization: Bearer ${RETELL_API_KEY}"
      ]
    }
  }
}
