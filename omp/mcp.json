{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/src/config/mcp-schema.json",
  "mcpServers": {
    "slack": {
      "command": "secrets",
      "args": [
        "SLACK_MCP_XOXP_TOKEN",
        "--",
        "slack-mcp-server",
        "--no-cache"
      ],
      "env": {
        "SLACK_MCP_ADD_MESSAGE_TOOL": "true",
        "SLACK_MCP_ATTACHMENT_TOOL": "true"
      }
    },
    "apify": {
      "command": "secrets",
      "args": [
        "APIFY_TOKEN",
        "--",
        "npx",
        "-y",
        "@apify/actors-mcp-server"
      ]
    },
    "home-assistant": {
      "command": "secrets",
      "args": [
        "HA_MCP_URL",
        "--",
        "npx",
        "-y",
        "-p",
        "mcp-remote@0.14.3",
        "mcp-remote-from-env",
        "HA_MCP_URL",
        "--allow-http"
      ]
    },
    "deel": {
      "lazy": true,
      "command": "secrets",
      "args": [
        "DEEL_API_KEY",
        "--",
        "npx",
        "-y",
        "mcp-remote@0.14.3",
        "https://api.letsdeel.com/mcp",
        "--header",
        "Authorization: Bearer ${DEEL_API_KEY}"
      ],
      "enabled": true
    },
    "chathub": {
      "command": "secrets",
      "args": [
        "MATRIX_HUB_URL",
        "MATRIX_HUB_TOKEN",
        "--",
        "chathub-mcp"
      ]
    }
  }
}
