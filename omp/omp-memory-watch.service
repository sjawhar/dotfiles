[Unit]
Description=Warn an agent session over Envoy before the kernel OOM-kills its omp scope
Documentation=file:%h/.dotfiles/scripts/omp-memory-watch.md

[Service]
Type=oneshot
# Last in line for CPU and disk, like envoy-role-holder-watch: this box runs at load 100+, and a
# memory watch that competes with the lanes it watches is worse than one that answers later.
Nice=15
IOSchedulingClass=idle
# A run that cannot finish is killed; runs cannot pile up whatever this is, since a oneshot that
# is still starting absorbs the next timer tick. The alerting is /proc and /sys reads (~0.3 s);
# each acting pass stops itself at a time from the run's start: the oom bias at 6 s, the pane
# restarter at 14 s, the scope adoption at 40 s (a systemd call is begun only with 10 s left).
# At load 350-450 on 2026-11-02 most runs took 1-2 s, some 13-16 s, and whole-box stalls in
# which systemd itself logged nothing killed runs at the old 25 s. Until 13:20Z the restarter
# also ran envoy-role-holder-watch's unbounded walk of the session root, which alone took
# minutes; that walk now has a 3 s budget.
TimeoutStartSec=90
# The pane restarter talks to the default tmux server, as envoy-role-holder-watch's pane check
# does: the socket directory .bashrc sets, and the mise-managed tmux the server was started from
# (/usr/bin/tmux is 3.4 against a 3.8 server). A systemd service sources no shell.
Environment=TMUX_TMPDIR=%h/.tmux/sockets
Environment=PATH=%h/.dotfiles/shims:%h/.dotfiles/bin:%h/.dotfiles/scripts:%h/.local/bin:%h/.mise/shims:/usr/local/bin:/usr/bin:/bin
Environment=MISE_DATA_DIR=%h/.mise
ExecStart=%h/.dotfiles/scripts/omp-memory-watch
