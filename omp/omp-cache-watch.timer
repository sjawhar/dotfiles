[Unit]
Description=Hourly check that omp's Anthropic prompt caching holds

[Timer]
# Half past, so its stats.db sync does not race the billing watch's on the hour.
OnCalendar=*-*-* *:30:00
# A box that was asleep or rebooted still gets the check it missed.
Persistent=true
RandomizedDelaySec=180

[Install]
WantedBy=timers.target
