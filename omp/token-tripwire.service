[Unit]
Description=Tell a session over Envoy when secretsd stops knowing its token
Documentation=file:%h/.dotfiles/scripts/token-tripwire.md

[Service]
# It follows a journal, so it runs until stopped rather than on a timer: the state it watches
# for is invisible until a session asks for a secret, and the pid that asked can only be
# attributed to a box while it is still alive. A periodic pass would read a journal of pids
# that have exited, which is exactly the state that left 59 sessions untold on 2026-11-07.
Type=simple
Restart=always
RestartSec=10
# Last in line: this box runs at load 100+ and a watch is never the work.
Nice=15
IOSchedulingClass=idle
ExecStart=%h/.dotfiles/scripts/token-tripwire

[Install]
WantedBy=default.target
