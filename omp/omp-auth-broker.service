[Unit]
Description=omp auth-broker on a database of its own: the one process that refreshes this machine's model logins
# The broker before this one (auth-broker.service) served the same ~/.omp/agent/agent.db every
# session writes. bun:sqlite is synchronous, so each of its writes that waited on another
# process's lock froze the whole broker: on 2026-10-25 its usage writes failed `database is
# locked` 146 times in 25 minutes, it went silent for up to 42 s at a time, and its connection
# queue filled while new sessions waited on it (dispatch://INFRA-387). This one keeps its login in
# a directory no other process writes, so it never waits on anyone's lock.
#
# Its login is a sign-in of its own, never a copy of the sessions' row: two refreshers on one
# token chain is the race that emptied the box at 07:20Z that day. A separate sign-in is a
# separate chain, as each of Sami's boxes already holds its own.
After=default.target

[Service]
Type=simple
ExecStart=%h/.mise/shims/omp auth-broker serve --bind=127.0.0.1:18778
Restart=always
RestartSec=2
# Where omp keeps agent.db: the broker's own, created on first start.
Environment=PI_CODING_AGENT_DIR=%h/.omp/auth-broker
# A systemd user unit gets /usr/bin:/bin, which resolves neither mise's shims nor the dotfiles
# ones; and mise needs its data dir named, since the unit does not read the interactive .bashrc.
Environment=PATH=%h/.dotfiles/shims:%h/.dotfiles/bin:%h/.dotfiles/scripts:%h/.local/bin:%h/.mise/shims:/usr/local/bin:/usr/bin:/bin
Environment=MISE_DATA_DIR=%h/.mise
# The broker is a client of nothing: leaving these set would make it ask itself.
Environment=OMP_AUTH_BROKER_URL=
Environment=OMP_AUTH_BROKER_TOKEN=

[Install]
WantedBy=default.target
