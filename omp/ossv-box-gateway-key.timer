[Unit]
Description=sami-rocqperf: put the model-gateway key back after a reboot, and every 10 minutes

[Timer]
# At boot, because the key lives in tmpfs and a session that starts before it is there reaches no model.
OnBootSec=30s
OnUnitActiveSec=10min
AccuracySec=30s

[Install]
WantedBy=timers.target
