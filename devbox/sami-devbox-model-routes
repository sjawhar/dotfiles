#!/usr/bin/env bash
# sami-devbox-model-routes: (sami-devbox only) declare GPT-6.1 Sol through the model gateway for
# omp's cross-family agents, and keep the implementation roles on config.yml's Codex-then-Claude.
# Run by devbox/sami-devbox-provision at step install, after install.sh's models.yml build and
# once mise has installed yq; safe to run again (dispatch://INFRA-993).
#
# sami-devbox has held Sami's ChatGPT (Codex) login since 2026-11-11 00:53Z, so the implementation
# roles run on the Codex subscription and fall to Claude on the gateway only when Codex refuses
# (measured 00:53Z: a fresh deep subagent served by openai-codex/gpt-5.6-terra). Without that
# login a Codex turn goes straight to Claude. The gateway's openai/ group (dispatch://INFRA-481,
# agent-infra #1476) serves GPT-6.1 Sol to the dev-box@ ID token (team box), per token. Sami's
# decision of 2026-11-11 (dispatch://INFRA-2212/ask/7aea7dfe-7b75-48a3-ae31-f2573aaeea2c): the
# implementation roles use Codex then Claude, never the per-token OpenAI API; only the cross-family
# agents stay on Sol. From 2026-11-03 20:55Z to then this script put slow and deep on gateway Sol at
# xhigh too, and that route cost $13,112 of OpenAI on 11-06..11-08. This script:
#   1. in omp/models.local.yml, declares GPT-6.1 Sol and its Flex tier twice on the same
#      route: as the provider `model-gateway-openai` (OpenAI Responses at <gateway>/v1),
#      sami-rocqperf's ids, and as `model-gateway/openai/gpt-6.1-sol[-flex]`, the ids
#      omp/config.yml's Sol chains name second. It removes every other `openai/` model from
#      `model-gateway`, so nothing here reaches Terra, Astra or Luna;
#   2. in omp/config.local.yml, points the cross-family astra, astra-api and gpt-api agents at
#      `model-gateway/openai/gpt-6.1-sol` (the id a session started before step 1 already knows: a
#      live session re-reads config.local.yml at each subagent spawn but keeps the models.yml it
#      started with); removes any slow or deep role and any sami-proxy override, so those take
#      config.yml's Codex models and their Claude fallback; leaves review and oracle to omp/config.yml;
#      and removes the fallback chains that sent openai-codex/<id> and openai/<id> to gateway models;
#   3. rebuilds ~/.omp/agent/models.yml with scripts/omp-models-build, so a new omp reads it.
# sami-rocqperf's overlays are not touched.
set -euo pipefail

[[ "$(hostname -s)" == sami-devbox ]] || { echo "sami-devbox-model-routes: sami-devbox only" >&2; exit 1; }
DOTFILES_DIR="${DOTFILES_DIR:-$HOME/.dotfiles}"
models="$DOTFILES_DIR/omp/models.local.yml"
config="$DOTFILES_DIR/omp/config.local.yml"
for f in "$models" "$config"; do [[ -f "$f" ]] || { echo "sami-devbox-model-routes: no $f" >&2; exit 1; }; done

url="$(yq -r '.providers["model-gateway"].baseUrl // ""' "$models")"
[[ -n "$url" ]] || { echo "sami-devbox-model-routes: no model-gateway baseUrl in $models" >&2; exit 1; }
key="$(yq -r '.providers["model-gateway"].apiKey // ""' "$models")"
[[ "$key" == '!'* ]] || { echo "sami-devbox-model-routes: model-gateway's apiKey in $models is not a !command" >&2; exit 1; }

SOL=openai/gpt-6.1-sol
# @review and @oracle lead on the Flex tier (omp/config.yml, 2026-11-04), so this box must
# declare it as well, or those chains fall through to the standard ids below it.
FLEX=openai/gpt-6.1-sol-flex
ROUTE="model-gateway/$SOL"

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
cp -p "$models" "$tmp/models.yml"
cp -p "$config" "$tmp/config.yml"

ID="$SOL" FLEXID="$FLEX" URL="$url/v1" KEY="$key" yq -i '
    .providers["model-gateway"].models |= map(select((.id | test("^openai/") | not)
        or .id == strenv(ID) or .id == strenv(FLEXID))) |
    (select([.providers["model-gateway"].models[] | select(.id == strenv(ID))] | length == 0)
        | .providers["model-gateway"].models) += [{
            "id": strenv(ID), "name": strenv(ID), "api": "openai-responses", "baseUrl": strenv(URL),
            "reasoning": true, "thinking": {"mode": "effort", "efforts": ["low", "medium", "high", "xhigh", "max"]},
            "input": ["text", "image"], "contextWindow": 1050000, "maxTokens": 128000}] |
    (select([.providers["model-gateway"].models[] | select(.id == strenv(FLEXID))] | length == 0)
        | .providers["model-gateway"].models) += [{
            "id": strenv(FLEXID), "name": strenv(FLEXID), "api": "openai-responses", "baseUrl": strenv(URL),
            "reasoning": true, "thinking": {"mode": "effort", "efforts": ["low", "medium", "high", "xhigh", "max"]},
            "input": ["text", "image"], "contextWindow": 1050000, "maxTokens": 128000}] |
    (select(.providers["model-gateway-openai"] == null) | .providers["model-gateway-openai"]) = {
        "baseUrl": strenv(URL), "apiKey": strenv(KEY), "api": "openai-responses",
        "models": [{
            "id": strenv(ID), "name": "gpt-6.1-sol", "reasoning": true, "input": ["text", "image"],
            "contextWindow": 1050000, "maxTokens": 128000,
            "cost": {"input": 2, "output": 10, "cacheRead": 0.1, "cacheWrite": 2.5},
            "thinking": {"mode": "effort", "efforts": ["low", "medium", "high", "xhigh", "max"]}},
        {
            "id": strenv(FLEXID), "name": "gpt-6.1-sol-flex", "reasoning": true, "input": ["text", "image"],
            "contextWindow": 1050000, "maxTokens": 128000,
            "cost": {"input": 2, "output": 10, "cacheRead": 0.1, "cacheWrite": 2.5},
            "thinking": {"mode": "effort", "efforts": ["low", "medium", "high", "xhigh", "max"]}}]}
' "$tmp/models.yml"

ROUTE="$ROUTE" yq -i '
    del(.modelRoles.slow) | del(.modelRoles.deep) |
    del(.modelRoles.review) | del(.modelRoles.oracle) |
    del(.task.agentModelOverrides["sami-proxy"]) |
    .task.agentModelOverrides.astra = strenv(ROUTE) + ":xhigh" |
    .task.agentModelOverrides["astra-api"] = strenv(ROUTE) + ":xhigh" |
    .task.agentModelOverrides["gpt-api"] = strenv(ROUTE) + ":xhigh" |
    .retry.fallbackChains |= ((. // {}) | with_entries(select(
        ((.key | test("^openai(-codex)?/")) and (.value | length > 0) and
         ([.value[] | select(test("^model-gateway/openai/") | not)] | length == 0)) | not)))
' "$tmp/config.yml"

# Install by mv, keeping each file's mode; only a changed file moves.
cmp -s "$tmp/models.yml" "$models" || mv "$tmp/models.yml" "$models"
cmp -s "$tmp/config.yml" "$config" || mv "$tmp/config.yml" "$config"

DOTFILES_DIR="$DOTFILES_DIR" "$DOTFILES_DIR/scripts/omp-models-build"

out="${OMP_AGENT_DIR:-$HOME/.omp/agent}/models.yml"
echo "sami-devbox-model-routes: model-gateway-openai: $(yq -r '[.providers["model-gateway-openai"].models[].id] | join(" ")' "$out"); model-gateway openai/: $(yq -r '[.providers["model-gateway"].models[].id | select(test("^openai/"))] | join(" ")' "$out") at $url/v1"
yq -r '"slow=" + (.modelRoles.slow // "config.yml") + " deep=" + (.modelRoles.deep // "config.yml") + " astra=" + .task.agentModelOverrides.astra + " sami-proxy=" + (.task.agentModelOverrides["sami-proxy"] // "config.yml")' "$config"
