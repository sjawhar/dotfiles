#!/usr/bin/env bash
# sami-devbox-model-routes: (sami-devbox only) send omp's OpenAI models through the model gateway.
# Run by devbox/sami-devbox-provision at step install, after install.sh's models.yml merge and
# once mise has installed yq; safe to run again (dispatch://INFRA-993).
#
# sami-devbox holds no ChatGPT login: the spec bars a person's login there, and omp's agent.db is
# not copied. So every openai-codex/<id> that agents and roles name has no credential on it. The
# gateway's openai/ group (dispatch://INFRA-481, agent-infra #1476) serves OpenAI models to the
# dev-box@ ID token (team box), and the OpenAI API agents and roles move there too, so the
# machine's OpenAI traffic has one route. This script:
#   1. declares the gateway's openai/ models in the ossv-gateway provider of omp/models.local.yml,
#      on the OpenAI Responses API at <gateway>/v1, as ossv-gateway/openai/<id> (the gateway takes
#      the id with its openai/ prefix and refuses the bare one with 403);
#   2. in omp/config.local.yml, points the roles (slow, deep, review, oracle) and the agents that
#      name an OpenAI model (astra, sami-proxy, astra-api, gpt-api) at them, and makes the gateway
#      model the fallback chain of each openai-codex/<id> and openai/<id> key, so a turn that
#      fails on one walks to the gateway. A session STARTED with `--model openai-codex/<id>`
#      still stops at model selection ("Use /login"; measured 2026-11-03), and needs /model;
#   3. merges models.yml as installers/omp.sh does, so a new omp reads it.
# The gateway serves gpt-6-astra, gpt-6.1-terra, gpt-6.1-sol and gpt-6-luna, and no 5.6 model, so
# each 5.6 id takes the 6.1/6 model of its tier (TO below): terra -> 6.1-terra, which config.yml's
# own openai/gpt-5.6-terra chain falls to first.
# sami-rocqperf's overlays are not touched: it keeps the ChatGPT login and the direct API.
set -euo pipefail

[[ "$(hostname -s)" == sami-devbox ]] || { echo "sami-devbox-model-routes: sami-devbox only" >&2; exit 1; }
DOTFILES_DIR="${DOTFILES_DIR:-$HOME/.dotfiles}"
models="$DOTFILES_DIR/omp/models.local.yml"
config="$DOTFILES_DIR/omp/config.local.yml"
out="${OMP_AGENT_DIR:-$HOME/.omp/agent}/models.yml"
for f in "$models" "$config"; do [[ -f "$f" ]] || { echo "sami-devbox-model-routes: no $f" >&2; exit 1; }; done

url="$(yq -r '.providers["ossv-gateway"].baseUrl // ""' "$models")"
[[ -n "$url" ]] || { echo "sami-devbox-model-routes: no ossv-gateway baseUrl in $models" >&2; exit 1; }

GATEWAY_OPENAI=(gpt-6-astra gpt-6.1-terra gpt-6.1-sol gpt-6-luna)
# An OpenAI model id named by openai-codex/ or openai/ -> the gateway id it goes to.
declare -A TO=(
    [gpt-6-astra]=gpt-6-astra
    [gpt-6.1-sol]=gpt-6.1-sol
    [gpt-6.1-terra]=gpt-6.1-terra
    [gpt-6-luna]=gpt-6-luna
    [gpt-5.6-terra]=gpt-6.1-terra
    [gpt-5.6-sol]=gpt-6.1-sol
    [gpt-5.6-luna]=gpt-6-luna
)

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
cp -p "$models" "$tmp/models.yml"
cp -p "$config" "$tmp/config.yml"

for id in "${GATEWAY_OPENAI[@]}"; do
    ID="openai/$id" URL="$url/v1" yq -i '
        .providers["ossv-gateway"].models |= ((. // []) | map(select(.id != strenv(ID)))) |
        .providers["ossv-gateway"].models += [{
            "id": strenv(ID), "name": strenv(ID), "api": "openai-responses", "baseUrl": strenv(URL),
            "reasoning": true, "thinking": {"mode": "effort", "efforts": ["low", "medium", "high", "xhigh", "max"]},
            "input": ["text", "image"], "contextWindow": 1050000, "maxTokens": 128000}]
    ' "$tmp/models.yml"
done

yq -i '
    .modelRoles.slow = "ossv-gateway/openai/gpt-6.1-terra:xhigh" |
    .modelRoles.deep = "ossv-gateway/openai/gpt-6.1-terra:xhigh" |
    .modelRoles.review = "ossv-gateway/openai/gpt-6.1-terra:xhigh" |
    .modelRoles.oracle = "ossv-gateway/openai/gpt-6.1-terra:high" |
    .task.agentModelOverrides.astra = "ossv-gateway/openai/gpt-6-astra:xhigh" |
    .task.agentModelOverrides["sami-proxy"] = "ossv-gateway/openai/gpt-6-astra:high" |
    .task.agentModelOverrides["astra-api"] = "ossv-gateway/openai/gpt-6-astra:xhigh" |
    .task.agentModelOverrides["gpt-api"] = "ossv-gateway/openai/gpt-6.1-terra:xhigh"
' "$tmp/config.yml"
for id in $(printf '%s\n' "${!TO[@]}" | sort); do
    for provider in openai-codex openai; do
        KEY="$provider/$id" DEST="ossv-gateway/openai/${TO[$id]}" yq -i '
            .retry.fallbackChains[strenv(KEY)] = [strenv(DEST)]
        ' "$tmp/config.yml"
    done
done

# Install by mv, keeping each file's mode; only a changed file moves.
cmp -s "$tmp/models.yml" "$models" || mv "$tmp/models.yml" "$models"
cmp -s "$tmp/config.yml" "$config" || mv "$tmp/config.yml" "$config"

# installers/omp.sh's merge, into the file omp reads.
yq eval-all '. as $item ireduce ({}; . * $item)' "$DOTFILES_DIR/omp/models.yml" "$models" > "$out.new"
if cmp -s "$out.new" "$out"; then rm -f "$out.new"; else mv "$out.new" "$out"; fi

echo "sami-devbox-model-routes: $(yq -r '[.providers["ossv-gateway"].models[].id | select(test("^openai/"))] | join(" ")' "$out") at $url/v1"
yq -r '"slow=" + .modelRoles.slow + " deep=" + .modelRoles.deep + " astra=" + .task.agentModelOverrides.astra + " sami-proxy=" + .task.agentModelOverrides["sami-proxy"]' "$config"
