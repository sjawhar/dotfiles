#!/bin/bash
# sami-devbox-provision: step 2 of dispatch://INFRA-993's cutover, "Provision", run from
# sami-rocqperf by a session that acts in Google Cloud as dev-sjawhar@ (the box identity) and is on
# the tailnet. It turns the bare VM agent-infra bootstrap/samidevbox.go makes into a machine an
# agent session can be moved to, and ends with the A2 check. The drill that follows is
# devbox/sami-devbox-drill.
#
#   sami-devbox-provision [--from STEP] [--only STEP]
#
# Steps, in order; each is safe to run again:
#   vm         the VM is RUNNING; first login as sami through `gcloud compute ssh` (the guest agent
#              makes the user from the key it puts in the instance's metadata; OS Login is off);
#              the startup script has installed its packages and formatted the state and cold
#              disks; sami is uid 1000.
#   host       the root layer, devbox/gce-host.sh, from a throwaway clone: the disk units (RAID,
#              /mnt/scratch, swap, /mnt/nvme, /mnt/durable, /home and /theorem, /theorem-ext4,
#              /theorem-xfs from the state disk, /tmp and /var/tmp from the scratch at the next
#              boot), Docker's data on the state disk, journald's 2 GiB cap on the boot disk,
#              Sysbox, Tailscale joined as sami-devbox, Sami's own untagged node: the step prints
#              the login URL `tailscale up` gives and waits until Sami signs in there
#              (dispatch://INFRA-1099), linger. From here every step goes over Tailscale SSH.
#   dotfiles   ~/.dotfiles cloned from GitHub (public, no login) onto the state disk, colocated jj.
#   secrets    the secret files that are in no repository (SECRET_FILES below), over Tailscale SSH.
#   leakcheck  the public-text leak check shims/gh requires, in ~/.local/share/public-leak-check
#              (agentbox/mounts gives boxes that directory) with its pointer: the agent-infra tag
#              devbox/leak-check-tag.env names, installed as the tag's leak-check/INSTALL.md says.
#   prepush    the leak check's pre-push hook in every checkout that pushes to a public repository:
#              the same tag's install-prepush-hook.sh and sweep-hooks.sh in
#              ~/.local/share/public-leak-check-hooks, then one pass of the sweep over its own roots
#              (it decides which checkouts are public), and ~/.dotfiles, which no root covers.
#   tools      a first install.sh pass for mise's tools, then the secrets broker's host helper
#              (installers/agent-secrets.sh). The pass is expected to stop at installers/omp.sh:
#              its private marketplaces clone with a GitHub App token, which on this machine comes
#              only through the broker, which needs the login of the next step (the clean-container
#              dry run, 2026-11-02).
#   broker     the secrets broker's machine login: prints a code a person types at Dispatch's
#              /credentials/machine page; the step waits for the approval.
#   install    install.sh again, now to the end; devbox/install.sh; then the standalone installers
#              sami-rocqperf runs (EXTRA_INSTALLERS below).
#   image      the agent-box image, built on the machine (`agentbox rebuild`).
#   responder  the outside responder exists: the CronJob box-monitor in the dispatch cluster.
#   speed      Tailscale SSH throughput from sami-rocqperf to sami-devbox, the path step 3's bulk
#              copy takes.
#   check      devbox/sami-devbox-check --mark-ready on the machine (A2). On a pass it writes the
#              marker `agentbox move --to sami-devbox` requires.
#
# Envoy needs nothing deployed on the machine: the hub's listener (agent-infra envoy/) serves
# every device the tailnet lets reach it, and bootstrap/ grants every member's device, Sami's
# sami-devbox among them, tcp 9020 and 4222 on the hub. A session reaches it with the envoy.json
# the secrets step copies.
set -euo pipefail

VM=sami-devbox
ZONE=us-west4-a
PROJECT=theorem-agent-infra
MACHINE_TYPE=c4-highmem-288-lssd
REPO=https://github.com/sjawhar/dotfiles
KUBE=(kubectl --context gke_theorem-agent-infra_us-west1_dispatch -n box-monitor)
SSH=(ssh -o BatchMode=yes -o ConnectTimeout=15 -o StrictHostKeyChecking=accept-new "sami@$VM")
GSSH=(gcloud compute ssh "sami@$VM" --zone "$ZONE" --project "$PROJECT" --strict-host-key-checking=no --quiet)
LOGS="${SAMI_DEVBOX_PROVISION_LOGS:-/mnt/nvme/$(id -un)/scratch/devbox-provision/provision}"

# The files a session on the machine needs that no repository holds (spec "Shared state during
# the cutover": they copy at step 2). Paths are relative to $HOME and copied to the same path.
# Never a person's login: no gcloud, Azure or GitHub sign-in is here, and none may be added.
# scripts/dotfiles-follow reads this array too: the paths here that git tracks (.dotfiles/secrets.env)
# are the ones it lets differ from their commit when it fast-forwards ~/.dotfiles on the machine.
#   .config/sops/age/keys.txt       sami-rocqperf's machine age key, a recipient of every
#                                   agent-tier secrets.env (.sops.yaml), so secretsd decrypts there
#                                   with no `sops updatekeys`; sami-rocqperf retires.
#   .dotfiles/secrets.env           the working copy, which differs from its last commit.
#   .dotfiles/.secrets/             the private overlay (theorem-labs/sami) with its uncommitted
#                                   secrets.local.env and secrets.env.
#   .dotfiles/secrets.human.d/CAP_BROWSER.local.env   untracked human-tier file (YubiKey only).
#   .dotfiles/omp/config.local.yml, .dotfiles/omp/models.local.yml
#                                   untracked overlays: the model gateway provider and roles.
#   .dotfiles/.claude/envoy.json, .config/legion/envoy.json
#                                   Envoy and Dispatch for Claude Code and omp sessions (the
#                                   Dispatch token).
#   .ssh/jj-signing, .ssh/jj-signing.pub
#                                   the commit-signing key, registered on GitHub as
#                                   jj-signing-sami-rocqperf; it moves rather than a new key being
#                                   registered (spec "Software").
SECRET_FILES=(
    .config/sops/age/keys.txt
    .dotfiles/secrets.env
    .dotfiles/.secrets/
    .dotfiles/secrets.human.d/CAP_BROWSER.local.env
    .dotfiles/omp/config.local.yml
    .dotfiles/omp/models.local.yml
    .dotfiles/.claude/envoy.json
    .config/legion/envoy.json
    .ssh/jj-signing
    .ssh/jj-signing.pub
)

# The standalone installers sami-rocqperf runs that install.sh and devbox/install.sh do not
# (spec "Software"; the inventory's user units). Left out on purpose: forward's laptop roles,
# chathub, voxtype, ghostty (laptop programs); transcript-store-jobs, whose units move with their
# owner at step 4; omp-login-watch, which reads omp's credential store (~/.omp/agent/agent.db)
# and so arms at step 5, when the global omp state copies; and pulumi-drift-watch, which mints
# its token from the `theorem` gcloud configuration, a person's login that this machine never
# holds.
EXTRA_INSTALLERS=(
    disk-fill-watch load-swap-watch envoy-role-holder-watch omp-memory-watch session-cpu-record
    # No gateway credential installer: every gateway provider mints this box's own identity token
    # per call (scripts/gateway-token), so there is nothing to arm
    # (dispatch://INFRA-993/comment/be112388). The one exception is the BET-59 verified-grader
    # stream's key, which the gateway serves to team `verified-grader` alone and so to no identity
    # caller; its unit runs at boot and never repeats, and it goes when the gateway takes an
    # identity token for that team.
    verified-grader-gateway-key
    # What the librarian's test harnesses need on the host beyond mise.toml: the exact omp build
    # their runs are compared at, and Playwright's Chromium (installers/librarian-harness-host.sh).
    librarian-harness-host
    # Not here:
    # - omp-root-hang-watch watches the root session holding the Envoy role lead-rocq-speed
    #   (SPEEDCOACH), whose transcript is on sami-rocqperf. Arm it here when that session moves.
    # - hawk-token-refresh: sami-rocqperf does not arm it (checked 2026-11-02: `systemctl --user
    #   is-enabled` not-found), and no omp model there uses hawk. It would fail every 3 minutes
    #   here: it clones a private repository with no GitHub credential and mints with a hawk
    #   login, a person's, that this machine never holds.
)

# The agent-azure user-assigned identity of theorem-labs/agent-infra#1146 (box-identity output
# agentAzureClientId). Not a secret: shims/az reads it from ~/.config/agent-azure/client-id.
AGENT_AZURE_CLIENT_ID=6133297b-4afa-4f36-ab55-67413835961e

# The public-text leak check (step leakcheck): files come only from the tag that
# devbox/leak-check-tag.env names, read from this machine's agent-infra clone, and each install
# appends its TAKEN, INSTALLED and RELEASED lines to the live install record in the shared path,
# which is also the install lock (agent-infra leak-check/INSTALL.md).
AGENT_INFRA="${AGENT_INFRA:-$HOME/src/agent-infra}"
LEAK_CHECK_SHARED="/mnt/nvme/$(id -un)/frac-verify/shared/leak-check"
LEAK_CHECK_RECORD="$LEAK_CHECK_SHARED/.editor-slot/holder"
# shellcheck source=leak-check-tag.env
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/leak-check-tag.env"

STEPS=(vm host dotfiles secrets leakcheck prepush tools broker install image responder speed check)

stamp() { date -u +%FT%TZ; }
say() { echo "$(stamp) == $*"; }
die() { echo "$(stamp) FAIL $*" >&2; exit 1; }
remote() { "${SSH[@]}" "bash -lc $(printf '%q' "$*")"; }

step_vm() {
    local d
    d="$(gcloud compute instances describe "$VM" --zone "$ZONE" --project "$PROJECT" --format='value(status,machineType.basename())')"
    [[ "$d" == "RUNNING	$MACHINE_TYPE" ]] || die "$VM: want RUNNING $MACHINE_TYPE, got '$d'"
    say "$VM RUNNING, $MACHINE_TYPE"
    # The first login puts sami's key in the instance's own metadata (project keys are blocked on
    # this VM) and the guest agent makes the user; retry while it does.
    local i
    for i in $(seq 30); do
        "${GSSH[@]}" --command true 2>/dev/null && break
        (( i == 30 )) && die "gcloud compute ssh sami@$VM never answered"
        sleep 10
    done
    "${GSSH[@]}" --command 'set -e
        for i in $(seq 120); do [ -e /var/lib/sami-devbox/packages-installed ] && break; sleep 5; done
        [ -e /var/lib/sami-devbox/packages-installed ] || { echo "startup script has not finished"; exit 1; }
        for d in state cold; do t=$(sudo blkid -p -s TYPE -o value /dev/disk/by-id/google-$d); [ "$t" = xfs ] || { echo "$d disk: $t"; exit 1; }; done
        [ "$(id -u)" = 1000 ] || { echo "sami is uid $(id -u), not 1000: paths and file owners from the old boxes would not match"; exit 1; }
        sudo -n true
        echo "startup script done; state and cold disks XFS; sami uid 1000 with sudo"'
}

step_host() {
    say "Sign in as sami@theorem.dev at the login URL tailscale up prints below; the step waits for it"
    "${GSSH[@]}" --command "set -e
        rm -rf /tmp/dotfiles-bootstrap
        git clone -q --depth 1 $REPO /tmp/dotfiles-bootstrap
        sudo SUDO_USER=sami bash /tmp/dotfiles-bootstrap/devbox/gce-host.sh
        rm -rf /tmp/dotfiles-bootstrap"
    local i
    for i in $(seq 60); do
        tailscale ping -c 1 --timeout 5s "$VM" >/dev/null 2>&1 && "${SSH[@]}" true 2>/dev/null && break
        (( i == 60 )) && die "$VM is not reachable over Tailscale SSH 10 minutes after the join"
        sleep 10
    done
    # The addresses are the ones agent-infra bootstrap/'s hosts entries sami-devbox and
    # sami-devbox-v6 must hold (bootstrap/README.md, "sami-devbox", "The tailnet").
    say "Tailscale SSH sami@$VM answers; $(tailscale status --json | jq -r --arg h "$VM" '. as $s | .Peer[] | select(.HostName == $h) | "\(.DNSName) \(.TailscaleIPs | join(" ")) owner \($s.User[(.UserID | tostring)].LoginName // "unknown") tags [\((.Tags // []) | join(","))]"')"
}

step_dotfiles() {
    remote "set -e
        [ -d ~/.dotfiles/.git ] || git clone -q $REPO ~/.dotfiles
        git -C ~/.dotfiles log --oneline -1"
}

step_secrets() {
    local f missing=()
    for f in "${SECRET_FILES[@]}"; do [[ -e "$HOME/$f" ]] || missing+=("$f"); done
    (( ${#missing[@]} == 0 )) || die "not on this machine: ${missing[*]}"
    # --relative keeps each path under $HOME; -a keeps the 0600 modes; nothing is deleted there.
    (cd "$HOME" && rsync -a --relative -e "ssh -o BatchMode=yes" "${SECRET_FILES[@]}" "sami@$VM:")
    remote 'ls -l ~/.config/sops/age/keys.txt ~/.config/legion/envoy.json ~/.ssh/jj-signing ~/.dotfiles/secrets.env ~/.dotfiles/omp/models.local.yml && du -sh ~/.dotfiles/.secrets'
    # This machine's copy of sami-rocqperf's overlay names that machine's credential, so rewrite
    # the gateway providers to mint this box's own identity token per call: dev-sjawhar@ is a
    # gateway account of team `box` with no pins (agent-infra model-gateway/vm/ossv_box_accounts.py),
    # so a Google VM needs no key and no impersonation (dispatch://INFRA-993/comment/be112388).
    # The built-in `anthropic` provider is left alone on purpose: this machine does hold a direct
    # Anthropic login (verified 2026-11-03), and every Claude chain ends on `anthropic/...`, so
    # giving it the gateway's baseUrl would send the whole chain through the gateway and leave a
    # down gateway with no Claude at all (omp/AGENTS.md). installers/omp.sh merges the overlay at
    # step tools; yq is not here before that.
    remote 'set -e
        f=~/.dotfiles/omp/models.local.yml
        sed -i -E "s|^( +)(apiKey: \"!cat /run/user/[0-9]+/ossv-box/gateway-(key\|token)\"\|apiKeyFile: /run/user/[0-9]+/ossv-box/gateway-key)\$|\1apiKey: \"!/home/sami/.dotfiles/scripts/gateway-token\"|" "$f"
        ! grep -nE "ossv-box/gateway-(key|token)" "$f"
        grep -n "scripts/gateway-token" "$f"'
    remote "install -d -m 0755 ~/.config/agent-azure
        printf '%s\n' $AGENT_AZURE_CLIENT_ID > ~/.config/agent-azure/client-id
        chmod 0644 ~/.config/agent-azure/client-id
        ls -l ~/.config/agent-azure/client-id"
}

step_leakcheck() {
    local files=(public-leak-check.sh README.md must-pass-lines.txt) f stage who out
    who="sami-devbox-provision ($(id -un)@$(hostname -s))"
    git -C "$AGENT_INFRA" fetch -q origin tag "$LEAK_CHECK_TAG" tag "$LEAK_CHECK_PREV" \
        || die "could not fetch $LEAK_CHECK_TAG and $LEAK_CHECK_PREV into $AGENT_INFRA"
    f="$(git -C "$AGENT_INFRA" rev-parse "$LEAK_CHECK_TAG^{commit}")"
    [[ "$f" == "$LEAK_CHECK_COMMIT" ]] || die "$LEAK_CHECK_TAG is commit $f, not $LEAK_CHECK_COMMIT (devbox/leak-check-tag.env)"
    stage="$(mktemp -d)"
    # $stage is local, so the trap expands it now.
    # shellcheck disable=SC2064
    trap "rm -rf '$stage'" EXIT
    mkdir "$stage/prev"
    for f in "${files[@]}"; do
        git -C "$AGENT_INFRA" show "$LEAK_CHECK_TAG:leak-check/$f" > "$stage/$f"
        git -C "$AGENT_INFRA" show "$LEAK_CHECK_PREV:leak-check/$f" > "$stage/prev/$f"
    done
    (cd "$stage/prev" && sha256sum "${files[@]}") > "$stage/prev.sha256"
    rm -rf "$stage/prev"
    printf '%s\n' "$LEAK_CHECK_HOME_SHA256" > "$stage/tag.sha256"
    # No ruleset protects the tags: the files must be the bytes the tag's announcement gave.
    (cd "$stage" && sha256sum -c tag.sha256) \
        || die "$LEAK_CHECK_TAG's files are not the sha256 in devbox/leak-check-tag.env; stop and tell whoever sent the tag"
    # INSTALL.md installs the shared path first; this machine follows it.
    (cd "$LEAK_CHECK_SHARED" && sha256sum -c --quiet "$stage/tag.sha256") \
        || die "$LEAK_CHECK_SHARED does not hold $LEAK_CHECK_TAG; install it there first (INSTALL.md)"
    out="$(tail -n 1 "$LEAK_CHECK_RECORD")"
    [[ "$out" == *"slot FREE" ]] || die "the leak-check install slot is held; $LEAK_CHECK_RECORD ends: ${out:0:300}"
    echo "TAKEN $(stamp) by $who to install $LEAK_CHECK_TAG ($LEAK_CHECK_COMMIT)" >> "$LEAK_CHECK_RECORD"
    remote 'rm -rf /tmp/plc-stage'
    rsync -t -e "ssh -o BatchMode=yes" "${files[@]/#/$stage/}" "$stage/tag.sha256" "$stage/prev.sha256" "sami@$VM:/tmp/plc-stage/" \
        || die "could not copy $LEAK_CHECK_TAG to $VM; the slot stays held (TAKEN line in $LEAK_CHECK_RECORD)"
    # Copy only over the previous tag, or this one on a second run; a new machine has no files.
    # Each file is written as .<name>.new and moved over the installed one only when all are written.
    out="$(remote 'set -e; s=/tmp/plc-stage; d=$HOME/.local/share/public-leak-check
        mkdir -p "$d" "$HOME/.config/public-leak-check"
        have="$(cd "$d" && sha256sum public-leak-check.sh README.md must-pass-lines.txt 2>/dev/null || true)"
        if [ -n "$have" ] && [ "$have" != "$(cat "$s/prev.sha256")" ] && [ "$have" != "$(cat "$s/tag.sha256")" ]; then
            echo "$d holds neither the previous tag nor this one, so nothing was copied:"; echo "$have"; exit 1
        fi
        install -m 0555 "$s/public-leak-check.sh" "$d/.public-leak-check.sh.new"
        install -m 0644 "$s/README.md" "$d/.README.md.new"
        install -m 0644 "$s/must-pass-lines.txt" "$d/.must-pass-lines.txt.new"
        for f in public-leak-check.sh README.md must-pass-lines.txt; do mv -f "$d/.$f.new" "$d/$f"; done
        printf "%s\n" "$d/public-leak-check.sh" > "$HOME/.config/public-leak-check/path"
        (cd "$d" && sha256sum -c "$s/tag.sha256")
        test -x "$d/public-leak-check.sh"; echo "test -x public-leak-check.sh: exit 0"
        rm -rf "$s"' 2>&1)" \
        || { echo "$out"; die "the install on $VM failed; the slot stays held (TAKEN line in $LEAK_CHECK_RECORD)"; }
    echo "$out"
    echo "INSTALLED $(stamp) by $who: $LEAK_CHECK_TAG in $VM:~/.local/share/public-leak-check: $(tr '\n' ' ' <<<"$out")" >> "$LEAK_CHECK_RECORD"
    echo "RELEASED $(stamp) by $who: checks run: $LEAK_CHECK_TAG is $LEAK_CHECK_COMMIT, its files have the sha256 of devbox/leak-check-tag.env, the shared path holds them, $VM sha256sum -c and test -x passed; slot FREE" >> "$LEAK_CHECK_RECORD"
    say "$VM holds $LEAK_CHECK_TAG; record lines appended to $LEAK_CHECK_RECORD"
}

# The pre-push hook (step prepush). sweep-hooks.sh loops for ever; its code up to that loop
# (`i=0`) is one pass, `sweep ROOTS...`, run here once with the script's own roots. A box clone
# (agentbox new) copies its template's hooks, and the templates are under the slow root.
step_prepush() {
    local files=(install-prepush-hook.sh sweep-hooks.sh) f stage out
    stage="$(mktemp -d)"
    # shellcheck disable=SC2064
    trap "rm -rf '$stage'" RETURN
    for f in "${files[@]}"; do git -C "$AGENT_INFRA" show "$LEAK_CHECK_TAG:leak-check/$f" > "$stage/$f"; done
    printf '%s\n' "$LEAK_CHECK_HOOK_SHA256" > "$stage/hook.sha256"
    (cd "$stage" && sha256sum -c hook.sha256) \
        || die "$LEAK_CHECK_TAG's hook files are not the sha256 in devbox/leak-check-tag.env"
    remote 'rm -rf /tmp/pph-stage'
    rsync -t -e "ssh -o BatchMode=yes" "${files[@]/#/$stage/}" "$stage/hook.sha256" "sami@$VM:/tmp/pph-stage/" \
        || die "could not copy the hook files to $VM"
    out="$(remote 'set -e; s=/tmp/pph-stage; d=$HOME/.local/share/public-leak-check-hooks
        mkdir -p "$d"
        for f in install-prepush-hook.sh sweep-hooks.sh; do install -m 0755 "$s/$f" "$d/.$f.new"; done
        for f in install-prepush-hook.sh sweep-hooks.sh; do mv -f "$d/.$f.new" "$d/$f"; done
        (cd "$d" && sha256sum -c "$s/hook.sha256")
        rm -rf "$s"
        "$d/install-prepush-hook.sh" "$HOME/.dotfiles"
        : > "$d/provision-sweep.log"
        bash -c "$(sed "/^i=0\$/,\$d" "$d/sweep-hooks.sh")
            here=$d; log=$d/provision-sweep.log
            sweep \"\${fast_roots[@]}\" \"\${slow_roots[@]}\""
        cat "$d/provision-sweep.log"
        tail -n 1 "$d/provision-sweep.log" | grep -q ", 0 failed$"' 2>&1)" \
        || { echo "$out"; die "the pre-push hook install on $VM failed"; }
    echo "$out"
    say "$VM: every checkout of a public repository has the pre-push hook"
}

step_tools() {
    remote 'cd ~/.dotfiles
        bash install.sh && echo "install.sh, first pass: completed" || echo "install.sh, first pass: stopped (exit $?); expected at installers/omp.sh until the broker login"
        # install.sh put mise on PATH in its own child shell only; load what it installed.
        [ -f ~/.bashrc ] && . ~/.bashrc
        command -v mise >/dev/null || { echo "mise is not on PATH after the first pass"; exit 1; }
        bash installers/agent-secrets.sh'
}

step_broker() {
    # login-status exits 0 while the helper holds a launcher credential; otherwise the login
    # prints a code for the operator to type at Dispatch's /credentials/machine page, and waits.
    remote 'agent-secrets machine login-status || agent-secrets-login sami@theorem.dev'
}

step_install() {
    remote "set -e
        cd ~/.dotfiles
        bash install.sh
        bash devbox/install.sh
        # After install.sh's models.yml merge: omp's OpenAI agents and roles go through the
        # gateway's openai/ group, since this machine holds no ChatGPT login (the script says why).
        bash devbox/sami-devbox-model-routes
        failed=''
        for i in ${EXTRA_INSTALLERS[*]}; do
            echo \"--- installers/\$i.sh\"
            bash installers/\$i.sh || failed=\"\$failed \$i\"
        done
        [ -d .jj ] || jj git init --colocate
        [ -z \"\$failed\" ] || { echo \"installers that failed:\$failed\"; exit 1; }"
}

step_image() {
    remote '"$HOME/.dotfiles/scripts/agentbox" rebuild && docker image ls --format "{{.Repository}}:{{.Tag}} {{.Size}}" | grep agentbox'
}

step_responder() {
    local s
    s="$("${KUBE[@]}" get cronjob box-monitor -o jsonpath='{.spec.schedule} suspend={.spec.suspend} lastSuccess={.status.lastSuccessfulTime}' 2>&1)" \
        || die "the responder is not deployed (agent-infra monitoring/responder.go): $s"
    say "responder CronJob box-monitor: $s"
    "${KUBE[@]}" logs "$("${KUBE[@]}" get jobs --sort-by=.metadata.creationTimestamp -o name | tail -1)" 2>&1 | sed 's/^/     /'
}

# Throughput over the path step 3's rsync takes: ssh over Tailscale from this machine. Zeros, as
# neither ssh (Compression is off by default) nor WireGuard compresses, so the bytes cost what a
# real file's do; one stream and four at once, as rsync runs one per tree.
step_speed() {
    local size_mib=4096 t0 t1 n
    for n in 1 4; do
        t0=$(date +%s.%N)
        for _ in $(seq "$n"); do
            head -c "${size_mib}M" /dev/zero | "${SSH[@]}" 'cat >/dev/null' &
        done
        wait
        t1=$(date +%s.%N)
        say "ssh over Tailscale, $n stream(s) x $size_mib MiB: $(awk -v b=$((n * size_mib)) -v t0="$t0" -v t1="$t1" 'BEGIN { s = t1 - t0; printf "%.0f MiB/s (%.1f s)", b / s, s }')"
    done
    tailscale ping -c 5 "$VM" 2>&1 | tail -2
}

step_check() {
    remote '"$HOME/.dotfiles/devbox/sami-devbox-check" --mark-ready'
}

from="" only=""
while (( $# )); do
    case "$1" in
        --from) from="$2"; shift 2 ;;
        --only) only="$2"; shift 2 ;;
        *) awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0" >&2; exit 2 ;;
    esac
done
mkdir -p "$LOGS"
log="$LOGS/provision-$(date -u +%Y%m%dT%H%M%SZ).log"
exec > >(tee -a "$log") 2>&1
echo "log: $log"
started=""
[[ -z "$from" ]] && started=1
for s in "${STEPS[@]}"; do
    [[ "$s" == "$from" ]] && started=1
    [[ -n "$started" ]] || continue
    [[ -z "$only" || "$s" == "$only" ]] || continue
    say "step $s"
    "step_$s"
    say "step $s done"
done
