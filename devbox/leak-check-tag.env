# shellcheck shell=bash disable=SC2034 # sourced; the sourcing scripts use these
# The tag of theorem-labs/agent-infra's leak-check/ that sami-devbox holds in
# ~/.local/share/public-leak-check. devbox/sami-devbox-provision (step leakcheck) installs it as the
# tag's leak-check/INSTALL.md says; devbox/sami-devbox-check compares the installed files with the
# sha256 here. Sourced by both.
#
# To install a new tag: set LEAK_CHECK_PREV to the tag installed now, LEAK_CHECK_TAG and
# LEAK_CHECK_COMMIT to the new one, and LEAK_CHECK_HOME_SHA256 to the `sha256sum` lines of these
# three files in the message that announced the tag (no ruleset protects the tags, so the provision
# compares the tag's files with them). Keep the file order.
LEAK_CHECK_TAG=leak-check-v2
LEAK_CHECK_PREV=leak-check-v1
LEAK_CHECK_COMMIT=1fb417ec5a10afcd5b9a2886670e51cebcce5f0d
LEAK_CHECK_HOME_SHA256='f926efc20f282216cd0a7e9d484531cb6ebff2ada3811ec3343f2acd04a27392  public-leak-check.sh
bf3c60d0a54e6397ae5bcf396fac50ed5b08f351aa9ddbe38211a411527136f7  README.md
8a634191c171aad01dd55096de87c852babed8aace95e68b7be336a31010e623  must-pass-lines.txt'
# The pre-push hook's installer and FRAC's hook sweep, from the same tag, which step prepush installs
# in ~/.local/share/public-leak-check-hooks and sami-devbox-check reads. Same order rule.
LEAK_CHECK_HOOK_SHA256='493f66d3aa31420e5b56d8698f78dfb1fabaf036174b2f17c21d915f4a26c5e0  install-prepush-hook.sh
9965b6957941a56192fcda1fd48d2f360f67e84732b0f6848ff231f4d897b164  sweep-hooks.sh'
