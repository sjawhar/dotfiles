[Unit]
Description=Delete empty tmp* directories older than a day from the big disk's TMPDIR
# Python's tempfile.mkdtemp() makes tmpXXXXXXXX under TMPDIR (/mnt/nvme/<user>/tmp on the
# devboxes) and never removes it; a caller that moves its output out leaves the empty directory
# behind. sami-rocqperf held 624,713 of them on 2026-10-25, 50,000-230,000 made a day
# (dispatch://INFRA-6). Only empty ones go, and only after a day, so no live run loses its dir.
ConditionPathIsDirectory=/mnt/nvme/%u/tmp

[Service]
Type=oneshot
Nice=19
IOSchedulingClass=idle
Environment=PATH=/usr/local/bin:/usr/bin:/bin
# The find it runs, and why a directory that vanishes during the walk does not fail the run while
# every other error does: devbox/tmp-empty-prune.
ExecStart=%h/.dotfiles/devbox/tmp-empty-prune
