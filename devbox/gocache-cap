#!/bin/bash
# gocache-cap: keep the box's Go build cache near its size limits, and never remove an entry a
# running build may still read. devbox/box-cleanup runs it every 15 minutes; the
# gocache-cap.service comment says why the limits are what they are.
#
# What a running build may still read. Go has no size-based trim: it drops only entries unused for
# 5 days. When a build uses an entry whose mtime is over an hour old, Go sets that mtime to now
# (cmd/go/internal/cache, mtimeInterval), so an entry a build used at time T has an mtime no older
# than T - 1 h. A `go` command opens what it looked up much later than the lookup: the linker of
# the last test binary of a `go test ./...` reads standard-library archives the command looked up
# when it started, which can be hours earlier. So the one line that holds is this: no `go` command
# running now has looked up an entry whose mtime is older than the start of the oldest running `go`
# command, less that hour and a margin. Every deletion here stays behind that line, whatever the
# ages and sizes below say. A build that starts after the line is drawn refreshes what it uses to a
# later mtime, so it is covered too. If the processes cannot be listed, nothing is deleted.
#
# Over GOCACHE_TRIM_BYTES it deletes the entries older than GOCACHE_TRIM_AGE_MIN, which keeps every
# lane's working set warm; a build that wants a deleted entry recompiles it. If the cache is still
# over GOCACHE_CAP_BYTES, it deletes the entries older than GOCACHE_CAP_AGE_MIN too, behind the same
# line. A reader that is not a `go` command (a linter reading export data after `go list` exits)
# keeps an entry for at least the age less an hour after it looked the entry up.
#
# It never runs `go clean -cache`. That removes every entry, the ones running builds have looked
# up and not yet opened included, and its four runs here from 2026-11-15 08:17Z to 2026-11-16
# 04:18Z broke concurrent builds with `link: cannot open file …/gocache/…-d` (dispatch://INFRA-3905).
# Past the cap with nothing more that is safe to delete, it says so and stops: a disk that fills is
# for box-cleanup's floor alert to report, not a reason to break builds.
#
# What remains: find tests an entry's mtime and unlinks it microseconds later, and a build that
# looks the entry up and checks that the file is there inside that gap loses it. Go's own trim
# (cmd/go/internal/cache, Trim) deletes the same way.
#
# GOCACHE_CAP_DIR (default <scratch>/gocache, where <scratch> is /mnt/scratch/<user> when
# devbox/gce-disks made it, as on sami-devbox, and /mnt/nvme/<user> otherwise: the GOCACHE .bashrc
# and scripts/agent-session set), GOCACHE_TRIM_BYTES (default 25 GB), GOCACHE_TRIM_AGE_MIN (default
# 180), GOCACHE_CAP_BYTES (default 50 GB) and GOCACHE_CAP_AGE_MIN (default 120) can be set to
# override the defaults, so that a test can run the unit against a scratch cache. No setting moves
# the line the running builds draw.
set -euo pipefail

scratch="/mnt/nvme/$(id -un)"
if [[ -d "/mnt/scratch/$(id -un)" ]]; then scratch="/mnt/scratch/$(id -un)"; fi
dir="${GOCACHE_CAP_DIR:-$scratch/gocache}"
trim_at="${GOCACHE_TRIM_BYTES:-25000000000}"
trim_age="${GOCACHE_TRIM_AGE_MIN:-180}"
cap="${GOCACHE_CAP_BYTES:-50000000000}"
cap_age="${GOCACHE_CAP_AGE_MIN:-120}"
# Go refreshes an entry's mtime only when it is older than this (cmd/go/internal/cache).
go_refresh_seconds=3600
# Slack for ps's whole-second ages and for the time between reading the clock and listing processes.
guard_margin_seconds=600

if [[ ! -d "$dir" ]]; then
    echo "gocache-cap: $dir is absent; nothing to cap"
    echo "gocache-cap: reclaimed-bytes: 0"
    exit 0
fi

# Builds add and remove entries while du walks the cache. du still prints the total of what it
# read, but exits 1 for each entry gone before it got there, which under `set -e` ends the run
# (devbox/nvme-cache-cap failed this way on 2026-11-02 20:39Z). A vanished entry is not an error
# here; any other du error still is.
size_of() {
    local out errs rc=0
    errs="$(mktemp)"
    out="$(du -sb "$1" 2>"$errs")" || rc=$?
    if ((rc != 0)) && grep -qv ': No such file or directory$' "$errs"; then
        cat "$errs" >&2
        rm -f "$errs"
        return "$rc"
    fi
    rm -f "$errs"
    [[ -n "$out" ]] || return 1
    printf '%s\n' "${out%%$'\t'*}"
}

size="$(size_of "$dir")"
if ((size <= trim_at)); then
    echo "gocache-cap: $dir is $size bytes, at or under the trim size of $trim_at"
    echo "gocache-cap: reclaimed-bytes: 0"
    exit 0
fi

# A lane that named its own GOCACHE under this directory (gocache/INFRA, gocache/LINUX)
# made a second cache inside it. The size above counts that cache, so treat it too. A Go
# cache directory is one that holds trim.txt.
caches=()
[[ -f "$dir/trim.txt" ]] && caches+=("$dir")
for sub in "$dir"/*/; do
    sub="${sub%/}"
    [[ "${sub##*/}" =~ ^[0-9a-f]{2}$ ]] && continue
    [[ -f "$sub/trim.txt" ]] && caches+=("$sub")
done

# The oldest `go` command this user runs, as "<age in seconds> <pid>", or "0 -" when none runs.
# Every one of this user's processes is listed, this script's own among them, so an empty list
# means ps could not see, and that is an error, never "no build is running". So is a line it cannot
# read. errexit does not reach into the $(...) this runs in, so each failure returns by hand.
oldest_go() {
    local up out age pid comm best_age=0 best_pid=-
    up="$(cut -d. -f1 /proc/uptime)" || return 1
    [[ "$up" =~ ^[0-9]+$ ]] || return 1
    out="$(ps -u "$(id -u)" -o etimes=,pid=,comm=)" || return 1
    if [[ -z "$out" ]]; then
        echo "gocache-cap: ps listed no process of $(id -un), not even this one; deleting nothing" >&2
        return 1
    fi
    while read -r age pid comm; do
        if [[ ! "$age" =~ ^[0-9]+$ ]]; then
            echo "gocache-cap: cannot read the age in ps's line '$age $pid $comm'; deleting nothing" >&2
            return 1
        fi
        [[ "$comm" == go ]] || continue
        # A process that started after ps read the clock gets a wrapped, huge age: it is new.
        ((age <= up)) || age=0
        if ((age > best_age)); then
            best_age="$age"
            best_pid="$pid"
        fi
    done <<<"$out"
    echo "$best_age $best_pid"
}

now="$(date +%s)"
go_line="$(oldest_go)"
read -r go_age go_pid <<<"$go_line"
guard=$((now - go_age - go_refresh_seconds - guard_margin_seconds))
if [[ "$go_pid" == - ]]; then
    held="no go command was running, so everything newer than $(date -u -d "@$guard" +%FT%TZ) was kept"
else
    held="the oldest running go command (pid $go_pid, ${go_age}s old) kept everything newer than $(date -u -d "@$guard" +%FT%TZ)"
fi

# delete_older AGE_MIN: delete, in every cache, the entries older than AGE_MIN minutes and older
# than the guard; print the bytes deleted. Entries live in the 00-ff directories; a build that runs
# now may delete or replace one, so a file gone by the time find reaches it is not an error. -printf
# follows -delete, so a file counts only once it is gone.
delete_older() {
    local cutoff=$((now - $1 * 60)) cache bytes=0 n
    ((cutoff < guard)) || cutoff="$guard"
    for cache in "${caches[@]}"; do
        while read -r n; do
            bytes=$((bytes + n))
        done < <(find "$cache" -mindepth 2 -maxdepth 2 -path "$cache/[0-9a-f][0-9a-f]/*" -type f \
            ! -newermt "@$cutoff" -delete -printf '%s\n' 2>/dev/null || true)
    done
    echo "$bytes"
}

removed="$(delete_older "$trim_age")"
trimmed="$(size_of "$dir")"
if ((trimmed <= cap)); then
    echo "gocache-cap: $dir was $size bytes, over the trim size of $trim_at; deleted $removed bytes of entries unused for $trim_age min ($held); now $trimmed bytes"
    echo "gocache-cap: reclaimed-bytes: $removed"
    exit 0
fi

more="$(delete_older "$cap_age")"
removed=$((removed + more))
final="$(size_of "$dir")"
if ((final <= cap)); then
    echo "gocache-cap: $dir was $size bytes, $trimmed after deleting entries unused for $trim_age min, over the cap of $cap; deleted entries unused for $cap_age min too, $removed bytes in all ($held); now $final bytes"
else
    echo "gocache-cap: $dir was $size bytes, $trimmed after deleting entries unused for $trim_age min, over the cap of $cap; deleted entries unused for $cap_age min too, $removed bytes in all ($held); now $final bytes, still over the cap: every entry left was used in the last $cap_age min or may be held by a running go command, so nothing more is safe to delete"
fi
# What a caller may count as reclaimed, for box-cleanup: the bytes of the entries this run deleted,
# not a before-and-after of the directory, which counts the builds writing into it meanwhile.
echo "gocache-cap: reclaimed-bytes: $removed"
