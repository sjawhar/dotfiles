#!/bin/bash
# gocache-cap: keep the box's Go build caches, all of them together, near one pair of size limits,
# and never remove an entry a running build may still read. devbox/box-cleanup runs it every 15
# minutes; the gocache-cap.service comment says why the limits are what they are.
#
# Which caches. Every Go build cache under the roots /mnt/scratch/<user> (where devbox/gce-disks
# makes it, as on sami-devbox: the GOCACHE .bashrc, scripts/agent-session and Go's env file set),
# /mnt/nvme/<user> (the same GOCACHE on a machine without the scratch disk) and ~/.cache (Go's own
# default, ~/.cache/go-build, for a go command that has no GOCACHE). A Go build cache is a
# directory holding trim.txt and the README whose first line cmd/go writes into every cache it uses;
# golangci-lint's cache has the same layout and a README of its own, and its readers are not `go`
# commands, so it is left alone. The search stays on each root's filesystem (agent box disk images
# are loop mounts under /mnt/nvme/<user>) and does not enter .git, node_modules, or a directory
# named with two hex digits, which is where a cache keeps its entries. It takes a trim.txt at most
# GOCACHE_CAP_DEPTH levels below a root: 4 by default, so a cache at most three directories down,
# which every pass can afford (1,331 caches in 10 s on sami-devbox on 2026-11-21, against 746 s to
# depth 6, which found 142 more); 0 means no limit, for a sweep by hand. A deeper cache, or one
# outside the roots, is capped while a go command builds in it: the GOCACHE in the environment of
# every running go command this user can read is added. A lane that names its own GOCACHE
# (gocache/INFRA, <scratch>/<lane>/gocache), an agent box's cache
# (<scratch>/box-cache/<box>/go-build) and Go's default are all caught. The limits hold for the
# caches' sum, not for each one: on 2026-11-21 at 03:2xZ sami-devbox held 571 GB in the box's
# GOCACHE, 475 GB in Go's default, which nothing capped, and 3.4 TB in the 879 caches named gocache*
# one or two directories below /mnt/scratch/<user>, which nothing capped either; a limit per cache
# would cap none of the small ones however many there are.
#
# What a running build may still read. Go has no size-based trim: it drops only entries unused for
# 5 days. When a build uses an entry whose mtime is over an hour old, Go sets that mtime to now
# (cmd/go/internal/cache, mtimeInterval), so an entry a build used at time T has an mtime no older
# than T - 1 h. A `go` command opens what it looked up much later than the lookup: the linker of
# the last test binary of a `go test ./...` reads standard-library archives the command looked up
# when it started, which can be hours earlier. So the one line that holds is this: no `go` command
# running now has looked up an entry whose mtime is older than the start of the oldest running `go`
# command, less that hour and a margin. Every deletion here stays behind that line, whatever the
# ages and sizes below say. A build that starts after the line is drawn refreshes what it uses to a
# later mtime, so it is covered too. If the processes cannot be listed, nothing is deleted.
#
# The `go` commands of every user count, not only this one's: an agent box's builds run on the host
# as uid 101000 (Sysbox maps the box's uid 1000 there) and write the box's cache, and a container
# runs as whatever uid it was given. A zombie does not count: it has exited and reads nothing. A
# `go` started at 2026-11-20 23:16:36Z in the container gw-slice5, whose pid 1 is `sleep infinity`
# and reaps nothing, was a zombie at 03:2xZ the next morning. Counted as the oldest running build,
# it held the line at 22:06:36Z in every pass from the one that ended 01:26:56Z, and the passes
# after that one deleted 0 bytes while the box's GOCACHE grew from 431 GB to 671 GB (04:00:43Z). A
# process whose main thread is a zombie while other threads run (ps prints Zl) is still running,
# and counts.
#
# Over GOCACHE_TRIM_BYTES it deletes the entries older than GOCACHE_TRIM_AGE_MIN, which keeps every
# lane's working set warm; a build that wants a deleted entry recompiles it. If the caches are still
# over GOCACHE_CAP_BYTES, it deletes the entries older than GOCACHE_CAP_AGE_MIN too, behind the same
# line. A reader that is not a `go` command (a linter reading export data after `go list` exits)
# keeps an entry for at least the age less an hour after it looked the entry up.
#
# It never runs `go clean -cache`. That removes every entry, the ones running builds have looked
# up and not yet opened included, and its four runs here from 2026-11-15 08:17Z to 2026-11-16
# 04:18Z broke concurrent builds with `link: cannot open file …/gocache/…-d` (dispatch://INFRA-3905).
# Past the cap with nothing more that is safe to delete, it says so and stops: a disk that fills is
# for box-cleanup's floor alert to report, not a reason to break builds.
#
# What remains: find tests an entry's mtime and unlinks it microseconds later, and a build that
# looks the entry up and checks that the file is there inside that gap loses it. Go's own trim
# (cmd/go/internal/cache, Trim) deletes the same way.
#
# GOCACHE_CAP_ROOTS (space-separated directories to search instead of the three above),
# GOCACHE_CAP_DEPTH (default 4; 0 for no limit), GOCACHE_TRIM_BYTES (default 25 GB),
# GOCACHE_TRIM_AGE_MIN (default 180), GOCACHE_CAP_BYTES (default 50 GB) and GOCACHE_CAP_AGE_MIN
# (default 120) can be set to override the defaults, so that a test can run the unit against a
# scratch tree. No setting moves the line the running builds draw.
set -euo pipefail

user="$(id -un)"
if [[ -n "${GOCACHE_CAP_ROOTS:-}" ]]; then
    read -ra roots <<<"$GOCACHE_CAP_ROOTS"
else
    roots=("/mnt/scratch/$user" "/mnt/nvme/$user" "$HOME/.cache")
fi
depth="${GOCACHE_CAP_DEPTH:-4}"
if [[ ! "$depth" =~ ^[0-9]+$ ]]; then
    echo "gocache-cap: GOCACHE_CAP_DEPTH must be a whole number, not '$depth'" >&2
    exit 2
fi
depth_args=() searched_depth="to depth $depth"
if ((depth > 0)); then depth_args=(-maxdepth "$depth"); else searched_depth="at every depth"; fi
trim_at="${GOCACHE_TRIM_BYTES:-25000000000}"
trim_age="${GOCACHE_TRIM_AGE_MIN:-180}"
cap="${GOCACHE_CAP_BYTES:-50000000000}"
cap_age="${GOCACHE_CAP_AGE_MIN:-120}"
# Go refreshes an entry's mtime only when it is older than this (cmd/go/internal/cache).
go_refresh_seconds=3600
# Slack for ps's whole-second ages and for the time between reading the clock and listing processes.
guard_margin_seconds=600

find_errs="$(mktemp)"
trap 'rm -f "$find_errs"' EXIT

# Every Go build cache under the roots, and every one a running go command names, sorted. Lanes
# make and remove their caches while find walks, so a directory gone before find reaches it is not
# an error. Any other error (a directory this user cannot read) is counted and said, because a
# cache inside it is not capped; it does not stop the caches that were found from being capped.
go_readme="This directory holds cached build artifacts from the Go build system."
proc="${PROC_ROOT:-/proc}"
mapfile -t found < <(
    for root in "${roots[@]}"; do
        [[ -d "$root" ]] || continue
        find "$root" -xdev -mindepth 1 "${depth_args[@]}" \
            \( -type d \( -name '[0-9a-f][0-9a-f]' -o -name .git -o -name node_modules \) -prune \) \
            -o \( -type f -name trim.txt -printf '%h\n' \) \
            2>>"$find_errs" || true
    done
)
# The GOCACHE each running go command names. A box's or a container's go runs as another uid, or
# in a namespace whose environ this user may not read; a box's cache is under <scratch>/box-cache,
# which the search finds.
named=()
while read -r pid comm; do
    [[ "$comm" == go ]] || continue
    value="$(tr '\0' '\n' 2>/dev/null <"$proc/$pid/environ" | grep -m 1 '^GOCACHE=')" || continue
    value="${value#GOCACHE=}"
    if [[ "$value" == /* ]]; then named+=("${value%/}"); fi
done < <(ps -e -o pid=,comm= 2>/dev/null || true)
mapfile -t candidates < <(printf '%s\n' "${found[@]}" "${named[@]}" | LC_ALL=C sort -u)
declare -A walked=()
for dir in "${found[@]}"; do walked["$dir"]=1; done
caches=() extra=0
for dir in "${candidates[@]}"; do
    [[ -n "$dir" && -f "$dir/trim.txt" ]] || continue
    first=""
    { IFS= read -r first <"$dir/README"; } 2>/dev/null || true
    [[ "$first" == "$go_readme" ]] || continue
    caches+=("$dir")
    if [[ -z "${walked[$dir]:-}" ]]; then extra=$((extra + 1)); fi
done
unread="$(grep -cv ': No such file or directory$' "$find_errs" || true)"
searched="${roots[*]} ($searched_depth)"
if ((extra > 0)); then
    searched+=" and $extra more a running go command builds in"
fi
if ((unread > 0)); then
    noun=directories
    if ((unread == 1)); then noun=directory; fi
    echo "gocache-cap: $unread $noun under ${roots[*]} could not be read, so a Go build cache inside one is not capped"
    grep -v ': No such file or directory$' "$find_errs" | head -n 5 >&2 || true
fi

if ((${#caches[@]} == 0)); then
    echo "gocache-cap: found no Go build cache under $searched; nothing to cap"
    echo "gocache-cap: reclaimed-bytes: 0"
    exit 0
fi

# The caches no other found cache contains: the sizes are taken over these, so a lane cache inside
# the box's GOCACHE (gocache/INFRA) is counted once, inside its parent.
declare -A is_cache=()
for cache in "${caches[@]}"; do is_cache["$cache"]=1; done
tops=()
for cache in "${caches[@]}"; do
    parent="$cache" nested=no
    while [[ "$parent" == */* ]]; do
        parent="${parent%/*}"
        [[ -n "$parent" ]] || break
        if [[ -n "${is_cache[$parent]:-}" ]]; then
            nested=yes
            break
        fi
    done
    [[ "$nested" == yes ]] || tops+=("$cache")
done

# Builds add and remove entries while du walks a cache, and lanes remove whole caches. du still
# prints the total of what it read, but exits 1 for each entry gone before it got there, which under
# `set -e` ends the run (devbox/nvme-cache-cap failed this way on 2026-11-02 20:39Z). A vanished
# entry is not an error here; any other du error still is. Prints the sum over its arguments.
size_of() {
    local out errs rc=0 line total=0
    errs="$(mktemp)"
    out="$(du -sb "$@" 2>"$errs")" || rc=$?
    if ((rc != 0)) && grep -qv ': No such file or directory$' "$errs"; then
        cat "$errs" >&2
        rm -f "$errs"
        return "$rc"
    fi
    rm -f "$errs"
    [[ -n "$out" ]] || return 1
    while IFS= read -r line; do
        total=$((total + ${line%%$'\t'*}))
    done <<<"$out"
    printf '%s\n' "$total"
}

count="${#caches[@]} Go build cache" holds=holds
if ((${#caches[@]} != 1)); then count+="s" holds=hold; fi
size="$(size_of "${tops[@]}")"
if ((size <= trim_at)); then
    echo "gocache-cap: $count under $searched $holds $size bytes, at or under the trim size of $trim_at"
    echo "gocache-cap: reclaimed-bytes: 0"
    exit 0
fi

# The oldest `go` command any user runs, as "<age in seconds> <pid>", or "0 -" when none runs.
# Every process is listed, this script's own among them, so an empty list means ps could not see,
# and that is an error, never "no build is running". So is a line it cannot read. errexit does not
# reach into the $(...) this runs in, so each failure returns by hand.
oldest_go() {
    local up out age pid stat comm best_age=0 best_pid=-
    up="$(cut -d. -f1 "$proc/uptime")" || return 1
    [[ "$up" =~ ^[0-9]+$ ]] || return 1
    out="$(ps -e -o etimes=,pid=,stat=,comm=)" || return 1
    if [[ -z "$out" ]]; then
        echo "gocache-cap: ps listed no process, not even this one; deleting nothing" >&2
        return 1
    fi
    while read -r age pid stat comm; do
        if [[ ! "$age" =~ ^[0-9]+$ ]]; then
            echo "gocache-cap: cannot read the age in ps's line '$age $pid $stat $comm'; deleting nothing" >&2
            return 1
        fi
        [[ "$comm" == go ]] || continue
        # Exited and not yet reaped: it reads nothing. A zombie main thread with live threads (Zl) runs.
        [[ "$stat" == Z* && "$stat" != *l* ]] && continue
        # A process that started after ps read the clock gets a wrapped, huge age: it is new.
        ((age <= up)) || age=0
        if ((age > best_age)); then
            best_age="$age"
            best_pid="$pid"
        fi
    done <<<"$out"
    echo "$best_age $best_pid"
}

now="$(date +%s)"
go_line="$(oldest_go)"
read -r go_age go_pid <<<"$go_line"
guard=$((now - go_age - go_refresh_seconds - guard_margin_seconds))
if [[ "$go_pid" == - ]]; then
    held="no go command was running, so everything newer than $(date -u -d "@$guard" +%FT%TZ) was kept"
else
    held="the oldest running go command (pid $go_pid, ${go_age}s old) kept everything newer than $(date -u -d "@$guard" +%FT%TZ)"
fi

# delete_older AGE_MIN: delete, in every cache, the entries older than AGE_MIN minutes and older
# than the guard; print the bytes deleted. Entries live in the 00-ff directories; a build that runs
# now may delete or replace one, so a file gone by the time find reaches it is not an error, and
# neither is a cache a lane removed meanwhile. -printf follows -delete, so a file counts only once
# it is gone.
delete_older() {
    local cutoff=$((now - $1 * 60)) cache bytes=0 n
    ((cutoff < guard)) || cutoff="$guard"
    for cache in "${caches[@]}"; do
        while read -r n; do
            bytes=$((bytes + n))
        done < <(find "$cache" -mindepth 2 -maxdepth 2 -path "$cache/[0-9a-f][0-9a-f]/*" -type f \
            ! -newermt "@$cutoff" -delete -printf '%s\n' 2>/dev/null || true)
    done
    echo "$bytes"
}

removed="$(delete_older "$trim_age")"
trimmed="$(size_of "${tops[@]}")"
if ((trimmed <= cap)); then
    echo "gocache-cap: $count under $searched held $size bytes, over the trim size of $trim_at; deleted $removed bytes of entries unused for $trim_age min ($held); now $trimmed bytes"
    echo "gocache-cap: reclaimed-bytes: $removed"
    exit 0
fi

more="$(delete_older "$cap_age")"
removed=$((removed + more))
final="$(size_of "${tops[@]}")"
if ((final <= cap)); then
    echo "gocache-cap: $count under $searched held $size bytes, $trimmed after deleting entries unused for $trim_age min, over the cap of $cap; deleted entries unused for $cap_age min too, $removed bytes in all ($held); now $final bytes"
else
    echo "gocache-cap: $count under $searched held $size bytes, $trimmed after deleting entries unused for $trim_age min, over the cap of $cap; deleted entries unused for $cap_age min too, $removed bytes in all ($held); now $final bytes, still over the cap: every entry left was used in the last $cap_age min or may be held by a running go command, so nothing more is safe to delete"
fi
# What a caller may count as reclaimed, for box-cleanup: the bytes of the entries this run deleted,
# not a before-and-after of the caches, which counts the builds writing into them meanwhile.
echo "gocache-cap: reclaimed-bytes: $removed"
