#!/bin/bash
# gocache-cap: keep the box's Go build cache under its size limits.
# devbox/gocache-cap.service runs it every hour; the unit's comment says why the limits are what they are.
#
# Go has no size-based trim: it drops only entries unused for 5 days. It does refresh an entry's
# mtime when it uses an entry whose mtime is over an hour old, so an entry used in the last two
# hours has an mtime under three hours old. Over GOCACHE_TRIM_BYTES this deletes the entries
# older than GOCACHE_TRIM_AGE_MIN, which keeps every lane's working set warm; a build that wants
# a deleted entry recompiles it. Only if the cache is still over GOCACHE_CAP_BYTES does it run
# `go clean -cache`, which removes the whole cache: every entry directory (00-ff) is deleted, and
# README, trim.txt and log.txt are kept.
#
# GOCACHE_CAP_DIR (default <scratch>/gocache, where <scratch> is /mnt/scratch/<user> when
# devbox/gce-disks made it, as on sami-devbox, and /mnt/nvme/<user> otherwise: the GOCACHE .bashrc
# and scripts/agent-session set), GOCACHE_TRIM_BYTES (default 25 GB),
# GOCACHE_TRIM_AGE_MIN (default 180) and GOCACHE_CAP_BYTES (default 50 GB) can be set to override
# the defaults, so that a test can run the unit against a scratch cache.
set -euo pipefail

scratch="/mnt/nvme/$(id -un)"
if [[ -d "/mnt/scratch/$(id -un)" ]]; then scratch="/mnt/scratch/$(id -un)"; fi
dir="${GOCACHE_CAP_DIR:-$scratch/gocache}"
trim_at="${GOCACHE_TRIM_BYTES:-25000000000}"
trim_age="${GOCACHE_TRIM_AGE_MIN:-180}"
cap="${GOCACHE_CAP_BYTES:-50000000000}"

if [[ ! -d "$dir" ]]; then
    echo "gocache-cap: $dir is absent; nothing to cap"
    echo "gocache-cap: reclaimed-bytes: 0"
    exit 0
fi

# Builds add and remove entries while du walks the cache. du still prints the total of what it
# read, but exits 1 for each entry gone before it got there, which under `set -e` ends the run
# (devbox/nvme-cache-cap failed this way on 2026-11-02 20:39Z). A vanished entry is not an error
# here; any other du error still is.
size_of() {
    local out errs rc=0
    errs="$(mktemp)"
    out="$(du -sb "$1" 2>"$errs")" || rc=$?
    if ((rc != 0)) && grep -qv ': No such file or directory$' "$errs"; then
        cat "$errs" >&2
        rm -f "$errs"
        return "$rc"
    fi
    rm -f "$errs"
    [[ -n "$out" ]] || return 1
    printf '%s\n' "${out%%$'\t'*}"
}

size="$(size_of "$dir")"
if ((size <= trim_at)); then
    echo "gocache-cap: $dir is $size bytes, at or under the trim size of $trim_at"
    echo "gocache-cap: reclaimed-bytes: 0"
    exit 0
fi

# A lane that named its own GOCACHE under this directory (gocache/INFRA, gocache/LINUX)
# made a second cache inside it. The size above counts that cache, so treat it too. A Go
# cache directory is one that holds trim.txt.
caches=()
[[ -f "$dir/trim.txt" ]] && caches+=("$dir")
for sub in "$dir"/*/; do
    sub="${sub%/}"
    [[ "${sub##*/}" =~ ^[0-9a-f]{2}$ ]] && continue
    [[ -f "$sub/trim.txt" ]] && caches+=("$sub")
done

# Entries live in the 00-ff directories; a build that runs now may delete or replace one, so a
# file that is gone by the time find reaches it is not an error.
for cache in "${caches[@]}"; do
    find "$cache" -mindepth 2 -maxdepth 2 -path "$cache/[0-9a-f][0-9a-f]/*" -type f -mmin "+$trim_age" -delete 2>/dev/null || true
done
trimmed="$(size_of "$dir")"
if ((trimmed <= cap)); then
    echo "gocache-cap: $dir was $size bytes, over the trim size of $trim_at; deleted entries unused for $trim_age min; now $trimmed bytes"
    echo "gocache-cap: reclaimed-bytes: $((size - trimmed))"
    exit 0
fi

# go clean reads the module in its working directory; / has none.
cd /
for cache in "${caches[@]}"; do
    GOCACHE="$cache" go clean -cache
done
final="$(size_of "$dir")"
echo "gocache-cap: $dir was $size bytes, $trimmed after the trim, over the cap of $cap; cleaned ${caches[*]}; now $final bytes"
# What a caller may count as reclaimed, for box-cleanup: this cache's own before-and-after, not
# a df delta taken around the run. `du -sb` is apparent size, so this is bytes of file content
# removed from this directory, which is the honest thing a cache cleaner can say about itself.
echo "gocache-cap: reclaimed-bytes: $((size - final))"
