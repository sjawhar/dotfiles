[Unit]
Description=Every 15 minutes: guarded cache caps and due daily sweeps (box-cleanup.service)

[Timer]
# One schedule for all seven cleaners. The script gates costly sweeps to once per day;
# the cheap, self-guarding cache caps must not wait a day while images fill the disk in hours.
# Fifteen minutes leaves several passes inside a 1 h 37 min fill horizon. Keep the jitter
# within a minute, and catch a missed pass after downtime without adding another timer.
OnCalendar=*:0/15
Persistent=true
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
