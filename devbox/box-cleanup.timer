[Unit]
Description=Daily: run every disk cleaner on this box once, log what each freed (box-cleanup.service)

[Timer]
# One schedule for what used to be seven: docker-cap, gocache-cap and nvme-cache-cap hourly,
# session-scratch-reap every 2 minutes, tmp-stale-reap hourly, session-tmp-reap and
# tmp-empty-prune daily (dispatch://INFRA-993/ask/d44b73ba, 2026-11-04). Persistent, so a run
# missed while the box was down happens when it comes back, which is exactly the morning after
# a reset, when the disks are fullest.
OnCalendar=daily
Persistent=true
RandomizedDelaySec=1800

[Install]
WantedBy=timers.target
