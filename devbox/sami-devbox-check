#!/bin/bash
# sami-devbox-check: acceptance check A2 of dispatch://INFRA-993 on sami-devbox, and the part of
# A5 a running machine can show (the disks are where the boot units put them).
#
#   sami-devbox-check               on sami-devbox, as sami: the host checks, then a new agent
#                                   box that runs this script with --in-box; exit 0 only when
#                                   every check of both passes.
#   sami-devbox-check --mark-ready  the same, and on a pass writes the readiness marker that
#                                   `agentbox move --to sami-devbox` requires before it moves
#                                   any session (CUTOVER_DIR/target-ready).
#   sami-devbox-check --in-box      the box half; agentbox runs it, a person does not.
#   sami-devbox-check --pins        only the pin lines (knives is mise.toml's pin, mise has every
#                                   pin installed), on the host; scripts/dotfiles-follow runs it
#                                   after each fast-forward. No log file, no marker.
#
# A2 asks that a NEW session on the machine runs in an agent box and reaches, from inside the
# box, Google Cloud as dev-sjawhar@, the build pool, the secrets broker, Envoy, Dispatch, MLflow,
# the model gateway with a dev-box@ token and Azure; and that no person's login file is on any
# mounted disk. Both halves also clone-check private theorem-labs repositories over https
# (github_check). The box half is run through `agentbox new`, the same launcher a session goes
# through, so a check passes only with what a real box gets: its mounts, its relays, its env.
#
# Each line is `ok`, `FAIL` or `note`, with what was expected and what was read, so the log is
# the evidence. The log goes to CUTOVER_DIR/a2-<UTC time>.log as well as to stdout.
set -uo pipefail

DOTFILES_DIR="${DOTFILES_DIR:-$HOME/.dotfiles}"
CUTOVER_DIR="${SAMI_DEVBOX_CUTOVER_DIR:-/mnt/nvme/$(id -un)/cutover}"
TAILNET=tail12ec1c.ts.net
ACCOUNT="dev-sjawhar@theorem-agent-infra.iam.gserviceaccount.com"
DEV_BOX="dev-box@theorem-agent-infra.iam.gserviceaccount.com"
KUBE_CONTEXT=gke_theorem-agent-infra_us-west1_dispatch
# The file names A2 lists. A2's list names credentialed_accounts.db, which gcloud does not
# write; the store that holds a gcloud login is credentials.db, one row per account with its
# refresh token (googlecloudsdk/core/credentials/store.py), so host_logins also reads every
# credentials.db for a row of type authorized_user, a person's login.
LOGIN_FILES=(application_default_credentials.json box_credential_config.json legacy_credentials credentialed_accounts.db)

fails=0
ok() { echo "ok   $*"; }
fail() { echo "FAIL $*"; fails=$((fails + 1)); }
note() { echo "note $*"; }
stamp() { date -u +%FT%TZ; }

# --- the box half ----------------------------------------------------------------------------
in_box() {
    [[ -n "${AGENTBOX_BOX:-}" ]] || { echo "sami-devbox-check --in-box runs inside an agent box" >&2; exit 2; }
    echo "== box $AGENTBOX_BOX, $(stamp)"
    ok "session runs in agent box $AGENTBOX_BOX (AGENTBOX_BOX set, /etc/agentbox-identity $( [[ -e /etc/agentbox-identity ]] && echo present || echo absent))"

    local out got tok
    # Google Cloud as the attached account: the account gcloud names, and a token Google
    # itself says belongs to it, so a configured name with no working credential fails.
    got="$(gcloud auth list --filter=status:ACTIVE --format='value(account)' 2>&1)"
    [[ "$got" == "$ACCOUNT" ]] && ok "gcloud auth list: active account $got" || fail "gcloud auth list: want $ACCOUNT, got: $got"
    if tok="$(gcloud auth print-access-token 2>&1)"; then
        got="$(curl -fsS -m 20 --data-urlencode "access_token=$tok" https://oauth2.googleapis.com/tokeninfo 2>&1 | jq -r '.email // empty')"
        [[ "$got" == "$ACCOUNT" ]] && ok "Google tokeninfo: the token gcloud prints is $got's" || fail "Google tokeninfo: want $ACCOUNT, got: ${got:-no email}"
    else
        fail "gcloud auth print-access-token: $(tail -1 <<<"$tok")"
    fi

    # The build pool: the GKE cluster the builds run in, through the box's ~/.kube.
    got="$(kubectl --context "$KUBE_CONTEXT" -n builds auth can-i create jobs 2>&1)"
    [[ "$got" == yes ]] && ok "build pool: kubectl -n builds auth can-i create jobs: yes" || fail "build pool: kubectl -n builds auth can-i create jobs: $got"

    # The secrets broker: the box's own enrolment, which the broker made through the host's
    # machine login, and its front door. A read through the broker needs a person's grant, so the
    # read below is the agent tier, through secretsd and the machine's age key copied at step 2.
    if [[ -s "${AGENT_SECRETS_KEY_DIR:-/nonexistent}/enrollment" ]]; then
        ok "secrets broker: box enrolled ($(cat "$AGENT_SECRETS_KEY_DIR/enrollment"))"
    else
        fail "secrets broker: box not enrolled: $(cat "${AGENT_SECRETS_KEY_DIR:-/nonexistent}/enrollment.error" 2>/dev/null || echo "no AGENT_SECRETS_KEY_DIR or no enrollment file")"
    fi
    got="$(curl -sS -m 10 -o /dev/null -w '%{http_code}' "https://secrets.$TAILNET/healthz" 2>&1)"
    [[ "$got" == 200 ]] && ok "secrets broker: https://secrets.$TAILNET/healthz 200" || fail "secrets broker: healthz answered $got"
    # secrets prints where the value came from on stderr first; the length is the last line.
    out="$(secrets CERAMIC_API_KEY -- sh -c 'echo ${#CERAMIC_API_KEY}' 2>&1 | tail -1)"
    [[ "$out" =~ ^[0-9]+$ && "$out" -gt 0 ]] && ok "secrets: agent-tier CERAMIC_API_KEY resolves ($out characters)" || fail "secrets CERAMIC_API_KEY: $out"

    # Envoy: the API through the box relay, and the NATS bus by name.
    out="$(ENVOY_MAX_TIME=5 "$DOTFILES_DIR/scripts/envoy" ps --json 2>&1)" && ok "Envoy API answers ($(jq length <<<"$out" 2>/dev/null) sessions)" || fail "Envoy API: $(head -1 <<<"$out")"
    timeout 5 bash -c "exec 3<>/dev/tcp/envoy-hub.$TAILNET/4222" 2>/dev/null && ok "Envoy NATS envoy-hub.$TAILNET:4222 reachable" || fail "Envoy NATS envoy-hub.$TAILNET:4222 unreachable"

    # Dispatch, with the token in the session's envoy.json. The CLI is the omp plugin's; omp puts
    # its directory on a session's PATH and sets DISPATCH_HOST and DISPATCH_SESSION_ID, and this
    # script is not run by omp, so it names the CLI and sets both as a session's shell has them.
    got="$(DISPATCH_HOST="${DISPATCH_HOST:-omp}" DISPATCH_SESSION_ID="${DISPATCH_SESSION_ID:-$(cat /proc/sys/kernel/random/uuid)}" \
        "$DOTFILES_DIR/omp/plugins/node_modules/@sjawhar/pi-envoy/bin/dispatch" read --issue INFRA-993 2>&1 | head -1)"
    [[ "$got" == "Title: sami-devbox"* ]] && ok "Dispatch: dispatch read --issue INFRA-993 -> ${got:0:60}" || fail "Dispatch: dispatch read --issue INFRA-993 -> $got"

    # MLflow, the company tracking server (tailnet Service svc:mlflow).
    got="$(curl -sS -m 10 "http://mlflow.$TAILNET/health" 2>&1)"
    [[ "$got" == OK ]] && ok "MLflow: http://mlflow.$TAILNET/health OK" || fail "MLflow: /health answered: $got"

    gateway_check
    azure_check
    tools_check
    github_check "in the box"

    echo "== box done, $fails failed, $(stamp)"
    return "$fails"
}

# Private theorem-labs repositories over https: each must answer `git ls-remote <url> HEAD` with a
# sha, as a clone needs. In the box this is the box's git (the gh-app routing include); on the
# host it is a plain shell's git, as `agentbox move --to` runs its remote commands over ssh, so
# the host half drops every agent marker and the routing include before it asks
# (installers/gh-app-host.sh: on this machine shims/gh answers the user's helper through the App).
GITHUB_REPOS=(machcsl-riscv oss-verify-proofs-internal)
github_check() {
    local where="$1" repo out sha ref
    local -a unset=()
    [[ "$where" == "in the box" ]] || unset=(-u GIT_CONFIG_COUNT -u GIT_CONFIG_PARAMETERS -u OMP_SESSION_ID
        -u PI_SESSION_FILE -u PI_TOOL_BRIDGE_URL -u AGENTBOX_SESSION)
    for repo in "${GITHUB_REPOS[@]}"; do
        out="$(env "${unset[@]}" GIT_TERMINAL_PROMPT=0 timeout 400 git ls-remote "https://github.com/theorem-labs/$repo" HEAD 2>&1)"
        sha=""
        while read -r ref _; do [[ "$ref" =~ ^[0-9a-f]{40}$ ]] && sha="$ref"; done < <(grep -P '\tHEAD$' <<<"$out")
        [[ -n "$sha" ]] && ok "GitHub $where: git ls-remote https://github.com/theorem-labs/$repo HEAD -> $sha" \
            || fail "GitHub $where: git ls-remote https://github.com/theorem-labs/$repo HEAD: $(tail -1 <<<"$out")"
    done
}

# The pins: knives is mise.toml's pin, and mise has every pin of mise.toml installed. The box half
# runs the first, the host half the second, and `--pins` runs both on the host:
# scripts/dotfiles-follow runs it after each fast-forward and its `mise install`.
knives_check() {
    local pin got
    pin="$(sed -n 's/^"github:sjawhar\/knives" = "\([^"]*\)".*/\1/p' "$DOTFILES_DIR/mise.toml")"
    got="$(knives --version 2>&1 | tail -1)"
    [[ -n "$pin" && "$got" == "knives $pin" ]] && ok "knives: $got (the mise.toml pin)" || fail "knives: want 'knives $pin', got: $got"
}

mise_check() {
    local missing
    missing="$(cd "$DOTFILES_DIR" && mise ls --missing 2>&1)"
    [[ -z "$missing" ]] && ok "mise: every pin in mise.toml is installed" || fail "mise ls --missing: $(tr '\n' ';' <<<"$missing")"
}

# The pinned tools, the inner docker's ghcr.io login, and omp's Slack MCP credential, as a
# session in a box sees them.
tools_check() {
    local got live model
    # The public-text leak check shims/gh requires before gh pr create/edit/comment: the pointer
    # and the script it names, both in the box.
    got="$(cat "$HOME/.config/public-leak-check/path" 2>&1)"
    [[ -x "$got" ]] && ok "public-leak-check: $got is in the box" || fail "public-leak-check: the pointer names '$got', which this box does not have; shims/gh refuses gh pr create/edit/comment"

    knives_check

    got="$(jq -r '(.auths // {}) | keys | join(",")' "$HOME/.docker/config.json" 2>&1)"
    if [[ ",$got," == *,ghcr.io,* ]]; then
        ok "docker in the box: logged in to ghcr.io (auths: $got)"
    elif ! secrets GHCR_PULL_TOKEN -- true >/dev/null 2>&1; then
        echo "WAIT docker in the box: no ghcr.io login: ghcr.io takes only a classic personal access token for org packages (the sjawhar-agent App token gets 403); a classic PAT from a machine user means creating an account, which is Sami's decision; no session needs a private ghcr image now"
    else
        fail "docker in the box: GHCR_PULL_TOKEN resolves but ~/.docker/config.json has no ghcr.io login (auths: ${got:-none})"
    fi

    # agent.db is not copied to this machine and it holds no person's login (INFRA-993 decision
    # 18:24Z), so no live credential there is the expected state, named by two WAIT lines.
    read -r got live < <(python3 - "$HOME/.omp/agent/agent.db" <<'PY' 2>&1
import sqlite3, sys
try:
    db = sqlite3.connect(f"file:{sys.argv[1]}?mode=ro", uri=True)
    q = "select count(*) from auth_credentials where disabled_cause is null"
    slack = db.execute(q + " and provider = 'mcp_oauth:profile:default:https://mcp.slack.com/mcp'").fetchone()[0]
    print(slack, db.execute(q).fetchone()[0])
except Exception as e:
    print("error", str(e).replace(" ", "_"))
PY
)
    if [[ "$got" == 1 ]]; then
        ok "slack MCP: omp holds one live Slack credential"
    elif [[ "$got" == 0 && "$live" == 0 ]]; then
        echo "WAIT slack MCP: needs a person's Slack OAuth (Sami's), which the spec bars on this machine; agent.db is not copied (decided 18:24Z)"
    else
        fail "slack MCP: live Slack credentials: $got (all live credentials: $live)"
    fi
    # anthropic/ goes through ossv-gateway with the dev-box@ token (omp/models.local.yml, written
    # by sami-devbox-provision's secrets step): a real turn from inside the box.
    got="$(timeout 200 omp -p "say ok" --model anthropic/claude-opus-4-8 2>&1 | tail -1)"
    [[ "${got,,}" == *ok* ]] && ok "anthropic/claude-opus-4-8 through ossv-gateway answers: $got" || fail "anthropic/claude-opus-4-8: $got"
    # openai/ goes through the gateway's openai group too (devbox/sami-devbox-model-routes): the
    # slow role and astra's model each answer a real turn. A fail prints "Use /login" or an HTTP 4xx.
    for model in @slow ossv-gateway/openai/gpt-6-astra:xhigh; do
        got="$(timeout 200 omp -p "say ok" --model "$model" 2>&1 | tail -1)"
        [[ "${got,,}" == *ok* ]] && ok "$model through ossv-gateway's openai group answers: $got" || fail "$model: $got"
    done
}

# jwt_claim prints one claim of a JWT's payload.
jwt_claim() {
    local p="${1#*.}"
    p="${p%%.*}"
    p="$(tr '_-' '/+' <<<"$p")"
    while (( ${#p} % 4 )); do p="$p="; done
    base64 -d <<<"$p" 2>/dev/null | jq -r --arg c "$2" '.[$c] // empty'
}

# The model gateway takes a Google ID token for audience model-gateway-gce as a bearer and checks
# its account against its own list (agent-infra model-gateway/vm/ossv_box_auth.py). A2 asks for
# dev-box@'s token: on sami-devbox the host's ossv-box-gateway-token timer mints it by
# impersonation (scripts/ossv-box-gateway-token), and the box reads it through the read-only
# ossv-box mount.
gateway_check() {
    local f="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/ossv-box/gateway-token" token email url code
    if [[ ! -s "$f" ]]; then
        fail "model gateway: no ID token at $f (host timer ossv-box-gateway-token)"
        return
    fi
    token="$(<"$f")"
    email="$(jwt_claim "$token" email)"
    [[ "$email" == "$DEV_BOX" ]] && ok "model gateway: ID token's email is $email, audience $(jwt_claim "$token" aud)" || fail "model gateway: ID token's email: want $DEV_BOX, got ${email:-none}"
    # The gateway sessions use: the ossv-gateway provider's baseUrl in omp/models.local.yml.
    url="$(awk '/^  ossv-gateway:/ { p = 1; next } p && /baseUrl:/ { print $2; exit } /^  [^ ]/ { p = 0 }' "$DOTFILES_DIR/omp/models.local.yml" 2>/dev/null)"
    [[ -n "$url" ]] || { fail "model gateway: no ossv-gateway baseUrl in $DOTFILES_DIR/omp/models.local.yml"; return; }
    code="$(curl -sS -m 20 -o /dev/null -w '%{http_code}' -K <(printf 'header = "Authorization: Bearer %s"\n' "$token") "$url/v1/models" 2>&1)"
    [[ "$code" == 200 ]] && ok "model gateway: $url/v1/models with the dev-box@ token: 200" || fail "model gateway: $url/v1/models with the dev-box@ token answered $code"
    # And a token it cannot verify is refused, so the 200 above was the token's doing.
    code="$(curl -sS -m 20 -o /dev/null -w '%{http_code}' -H 'Authorization: Bearer x.y.z' "$url/v1/models" 2>&1)"
    [[ "$code" == 401 ]] && ok "model gateway: a forged token answers 401" || fail "model gateway: a forged token answered $code, want 401"
}

azure_check() {
    local out
    # As a session's az call: shims/az chooses the agents' Azure identity only in an agent session
    # (OMP_SESSION_ID and its kin), which this script, run by agentbox directly, is not.
    out="$(AGENTBOX_SESSION="${AGENTBOX_SESSION:-sami-devbox-check}" az account show --query '{user:user.name,type:user.type,subscription:id}' -o json 2>&1)"
    if [[ "$(jq -r '.type // empty' <<<"$out" 2>/dev/null)" == servicePrincipal ]]; then
        ok "Azure: az account show as service principal $(jq -r .user <<<"$out") on subscription $(jq -r .subscription <<<"$out")"
    elif [[ -z "${AGENT_AZURE_CLIENT_ID:-}" && ! -s "$HOME/.config/agent-azure/client-id" ]]; then
        # The one wait A2 allows: the agent-azure identity is not issued yet, so the client id
        # shims/az needs is absent. Any other az failure is a FAIL.
        echo "WAIT Azure: $(tail -1 <<<"$out") (waits on agent-infra #1146, AzureWIF)"
    else
        fail "Azure: az account show: want a servicePrincipal, got: $(tail -1 <<<"$out")"
    fi
}

# --- the host half ---------------------------------------------------------------------------
host_disks() {
    local src fstype
    for spec in "/mnt/nvme google-state" "/mnt/durable google-cold"; do
        read -r mnt dev <<<"$spec"
        src="$(findmnt -n -o SOURCE --target "$mnt" 2>/dev/null)"
        fstype="$(findmnt -n -o FSTYPE --target "$mnt" 2>/dev/null)"
        if [[ "$(findmnt -n -o TARGET --target "$mnt" 2>/dev/null)" == "$mnt" && "$(readlink -f "$src")" == "$(readlink -f "/dev/disk/by-id/$dev")" && "$fstype" == xfs ]]; then
            ok "disk: $mnt is $dev ($src, $fstype)"
        else
            fail "disk: $mnt: want /dev/disk/by-id/$dev xfs, got ${src:-nothing} ${fstype:-}"
        fi
    done
    # /home is the state disk's /mnt/nvme/home, bound: same device, same inode.
    if [[ "$(stat -c %d:%i /home 2>/dev/null)" == "$(stat -c %d:%i /mnt/nvme/home 2>/dev/null)" ]]; then
        ok "disk: /home is /mnt/nvme/home (bind)"
    else
        fail "disk: /home is not /mnt/nvme/home: $(findmnt -n -o SOURCE,FSTYPE /home 2>&1)"
    fi
    src="$(findmnt -n -o SOURCE /mnt/scratch 2>/dev/null)"
    if [[ "$src" == /dev/md* ]]; then
        local md members
        md="$(basename "$(readlink -f "$src")")"
        members="$(find "/sys/block/$md/slaves" -mindepth 1 -maxdepth 1 2>/dev/null | wc -l)"
        ok "disk: /mnt/scratch is $src ($(lsblk -dno SIZE "$src" 2>/dev/null | tr -d ' '), RAID of $members local SSDs)"
    else
        fail "disk: /mnt/scratch: want a RAID md device, got ${src:-nothing}"
    fi
    if swapon --show=NAME --noheadings 2>/dev/null | grep -qx /mnt/scratch/swapfile; then
        ok "swap: /mnt/scratch/swapfile active ($(swapon --show=SIZE --noheadings 2>/dev/null | head -1 | tr -d ' '))"
    else
        fail "swap: /mnt/scratch/swapfile not active: $(swapon --show 2>&1 | tr '\n' ' ')"
    fi
    [[ -d "/mnt/scratch/$(id -un)" && -O "/mnt/scratch/$(id -un)" ]] && ok "scratch: /mnt/scratch/$(id -un) is $(id -un)'s" || fail "scratch: /mnt/scratch/$(id -un) missing or not $(id -un)'s"
}

# sudo_find ARRAY ARGS...: `sudo -n find ARGS`, appending each path to the array named ARRAY, and
# a FAIL when find (or sudo) exits non-zero, so a walk that failed never reads as one that found
# nothing.
sudo_find() {
    local -n into="$1"
    shift
    local out err rc=0
    out="$(mktemp)" err="$(mktemp)"
    # shellcheck disable=SC2024  # the output files are sami's own temp files, on purpose
    sudo -n find "$@" >"$out" 2>"$err" || rc=$?
    mapfile -t -O "${#into[@]}" into <"$out"
    (( rc == 0 )) || fail "logins: sudo -n find $1 exited $rc: $(tail -1 "$err")"
    rm -f "$out" "$err"
    return "$rc"
}

# No person's login on any mounted disk: the A2 file names, a gh login, and any gcloud or Azure
# store that holds a user's login. Every local filesystem is walked once (-xdev per mount).
host_logins() {
    local -a names=() found=() dbs=() profiles=()
    local n f walked=1
    for n in "${LOGIN_FILES[@]}"; do names+=(-name "$n" -o); done
    names+=(-path '*/.config/gh/hosts.yml')
    for mnt in / /mnt/nvme /mnt/durable /mnt/scratch; do
        sudo_find found "$mnt" -xdev \( "${names[@]}" \) -print || walked=0
    done
    if (( ${#found[@]} )); then
        fail "logins: person's login files present: ${found[*]}"
    elif (( walked )); then
        ok "logins: no ${LOGIN_FILES[*]} or .config/gh/hosts.yml on /, /mnt/nvme, /mnt/durable, /mnt/scratch"
    fi
    # gcloud's own stores: a row whose credential is authorized_user is a person's login.
    found=()
    walked=1
    sudo_find dbs / /mnt/nvme /mnt/durable -xdev -name credentials.db -path '*gcloud*' -print || walked=0
    for f in "${dbs[@]}"; do
        n="$(python3 - "$f" <<'PY' 2>&1
import json, sqlite3, sys
con = sqlite3.connect(f"file:{sys.argv[1]}?mode=ro", uri=True)
rows = con.execute("select account_id, value from credentials").fetchall()
print(" ".join(a for a, v in rows if json.loads(v).get("type") == "authorized_user"))
PY
)"
        [[ -n "$n" ]] && found+=("$f: $n")
    done
    if (( ${#found[@]} )); then fail "logins: gcloud user logins stored: ${found[*]}"
    elif (( walked )); then ok "logins: no gcloud credentials.db holds an authorized_user row"; fi
    # Azure: a profile whose subscriptions name a user is a person's login.
    found=()
    walked=1
    sudo_find profiles / /mnt/nvme /mnt/durable -xdev -name azureProfile.json -print || walked=0
    for f in "${profiles[@]}"; do
        sudo -n cat "$f" 2>/dev/null | jq -e '[.subscriptions[]?.user.type] | any(. == "user")' >/dev/null 2>&1 && found+=("$f")
    done
    if (( ${#found[@]} )); then fail "logins: Azure user login in ${found[*]}"
    elif (( walked )); then ok "logins: no azureProfile.json names a user"; fi
}

host_identity() {
    local got
    [[ "$(hostname -s)" == sami-devbox ]] && ok "host: hostname sami-devbox" || fail "host: hostname $(hostname -s)"
    [[ "$(id -u)" == 1000 && "$(id -un)" == sami ]] && ok "host: user sami uid 1000" || fail "host: user $(id -un) uid $(id -u), want sami 1000"
    got="$(tailscale status --self --json 2>/dev/null | jq -r '[.Self.HostName, (.Self.Tags // [] | join(","))] | join(" ")')"
    [[ "$got" == "sami-devbox tag:sami-devbox" ]] && ok "tailnet: node sami-devbox, tag:sami-devbox" || fail "tailnet: want 'sami-devbox tag:sami-devbox', got '$got'"
    got="$(curl -fsS -m 5 -H 'Metadata-Flavor: Google' http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/email 2>&1)"
    [[ "$got" == "$ACCOUNT" ]] && ok "host: the VM's attached account is $got" || fail "host: metadata account: $got"
    [[ ! -e "$HOME/.config/gcloud/box_credential_config.json" && -z "${GOOGLE_APPLICATION_CREDENTIALS:-}" ]] \
        && ok "host: no box_credential_config.json and no GOOGLE_APPLICATION_CREDENTIALS (ADC is the metadata server)" \
        || fail "host: a credential file is configured: ${GOOGLE_APPLICATION_CREDENTIALS:-$HOME/.config/gcloud/box_credential_config.json}"
}

# No unit failing on the machine: the user manager's and the system's failed lists are empty, and
# unit-health-watch (scripts/unit-health-watch) holds no open condition in its state file.
host_units() {
    local got state
    got="$(systemctl --user --failed --no-legend --plain 2>&1)"
    [[ -z "$got" ]] && ok "units: systemctl --user --failed lists nothing" || fail "units: systemctl --user --failed: $(tr '\n' ';' <<<"$got")"
    # logind's session-*.scope units are login sessions (an ssh session killed by a client timeout
    # leaves one failed), not provisioning units: a note, not a FAIL. Every other unit is judged.
    got="$(systemctl --failed --no-legend --plain 2>&1)"
    local sessions
    sessions="$(awk '$1 ~ /^session-.*\.scope$/ { print $1 }' <<<"$got")"
    got="$(awk '$1 !~ /^session-.*\.scope$/' <<<"$got")"
    [[ -n "$sessions" ]] && note "units: failed login-session scopes (not judged): $(tr '\n' ' ' <<<"$sessions")"
    [[ -z "$got" ]] && ok "units: systemctl --failed lists nothing but login-session scopes" || fail "units: systemctl --failed: $(tr '\n' ';' <<<"$got")"
    for state in "/mnt/nvme/$(id -un)/tmp/unit-health-watch/state.json" "${XDG_STATE_HOME:-$HOME/.local/state}/unit-health-watch/state.json"; do
        [[ -s "$state" ]] && break
    done
    if [[ ! -s "$state" ]]; then
        fail "units: unit-health-watch has no state file (has it run? systemctl --user status unit-health-watch.timer)"
    elif got="$(jq -r '(.incidents // {}) | to_entries[] | "\(.key): \(.value.why)"' "$state" 2>&1)" && [[ -z "$got" ]]; then
        ok "units: unit-health-watch has nothing open (state $state, last run $(jq -r '.last_run | todate? // .' "$state"))"
    else
        fail "units: unit-health-watch has open conditions: $(tr '\n' ';' <<<"$got")"
    fi
}

# The dotfiles follow origin's main by themselves (scripts/dotfiles-follow): its timer is active,
# its last run exited 0, and that run, at most 30 minutes ago, left ~/.dotfiles on origin/main
# with no condition open and its tools installed.
host_follow() {
    local got state outcome age head target tools
    got="$(systemctl --user is-active dotfiles-follow.timer 2>&1)"
    [[ "$got" == active ]] || { fail "dotfiles-follow: timer is '$got', want active (devbox/install.sh arms it)"; return; }
    # One line per property, sorted, so the order systemctl prints them in does not matter.
    got="$(systemctl --user show -p Result -p ExecMainStatus -p ExecMainExitTimestamp dotfiles-follow.service 2>&1 | sort | tr '\n' ' ')"
    if [[ " $got" == *" ExecMainExitTimestamp= "* || " $got" != *" ExecMainStatus=0 "* || " $got" != *" Result=success "* ]]; then
        fail "dotfiles-follow: its last run did not exit 0, or none ran: $got"
        return
    fi
    for state in "/mnt/nvme/$(id -un)/tmp/dotfiles-follow/state.json" "${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles-follow/state.json"; do
        [[ -s "$state" ]] && break
    done
    outcome="$(jq -r '"\(.last_outcome) \(now - (.last_run // 0) | floor) \(.head[0:12]) \(.target[0:12]) \(.tools_ok_head == .head)"' "$state" 2>&1)"
    read -r got age head target tools <<<"$outcome"
    if [[ "$got" == ok && "$age" =~ ^[0-9]+$ && "$age" -le 1800 && "$head" == "$target" && "$tools" == true ]]; then
        ok "dotfiles-follow: timer active; its last run, ${age}s ago, exited 0 and left ~/.dotfiles on origin/main $head with its tools installed (state $state)"
    else
        fail "dotfiles-follow: last run: '$outcome' (want: outcome ok, at most 1800 s ago, HEAD = origin/main, tools installed at HEAD; state $state)"
    fi
}

# Movers (S3 and others) run scripts on sami-rocqperf over ssh after the move, so this machine
# must reach it. While the tailnet rule tag:sami-devbox -> sami-rocqperf tcp:22 is pending
# (dispatch://INFRA-734) the connection times out, which is a WAIT; any other error is a FAIL.
rocqperf_check() {
    local out rc=0
    out="$(ssh -o BatchMode=yes -o ConnectTimeout=15 sami@sami-rocqperf true </dev/null 2>&1)" || rc=$?
    if (( rc == 0 )); then
        ok "ssh sami-devbox -> sami-rocqperf: ssh -o BatchMode=yes sami@sami-rocqperf true exits 0"
    elif [[ "$out" == *"timed out"* ]]; then
        echo "WAIT ssh sami-devbox -> sami-rocqperf: tailnet rule tag:sami-devbox -> sami-rocqperf tcp:22 pending (dispatch://INFRA-734)"
    else
        fail "ssh sami-devbox -> sami-rocqperf: exit $rc: $(tail -1 <<<"$out")"
    fi
}

host() {
    echo "== host $(hostname -s), $(stamp)"
    host_identity
    host_disks
    host_units
    host_follow
    local missing
    mise_check
    missing="$(yq '.providers.anthropic.baseUrl == .providers["ossv-gateway"].baseUrl and .providers.anthropic.apiKey == "!cat /run/user/1000/ossv-box/gateway-token"' "$HOME/.omp/agent/models.yml" 2>&1)"
    [[ "$missing" == true ]] && ok "omp models.yml: anthropic/ uses ossv-gateway's baseUrl and the gateway token" || fail "omp models.yml: anthropic/ is not routed through ossv-gateway with the gateway token: $missing"
    # The openai/ agents and roles go to the gateway's openai group (devbox/sami-devbox-model-routes):
    # the slow and deep roles and the astra and sami-proxy agents name ossv-gateway/openai/ models,
    # and omp's merged models.yml declares at least 4 of them.
    missing="$(yq -r '.modelRoles.slow, .modelRoles.deep, .task.agentModelOverrides.astra, .task.agentModelOverrides["sami-proxy"]' "$DOTFILES_DIR/omp/config.local.yml" 2>&1)"
    if [[ "$(grep -c '^ossv-gateway/openai/' <<<"$missing")" == 4 && "$(wc -l <<<"$missing")" == 4 ]]; then
        ok "omp config.local.yml: slow, deep, astra and sami-proxy use ossv-gateway/openai/ ($(tr '\n' ' ' <<<"$missing"))"
    else
        fail "omp config.local.yml: slow, deep, astra, sami-proxy want ossv-gateway/openai/<id> each, got: $(tr '\n' ';' <<<"$missing")"
    fi
    missing="$(yq '[.providers["ossv-gateway"].models[].id | select(test("^openai/"))] | length' "$HOME/.omp/agent/models.yml" 2>&1)"
    [[ "$missing" =~ ^[0-9]+$ && "$missing" -ge 4 ]] && ok "omp models.yml: ossv-gateway declares $missing openai/ models" || fail "omp models.yml: ossv-gateway's openai/ models: want 4 or more, got: $missing"
    host_logins
    github_check "on the host"
    rocqperf_check
    echo "-- agentbox doctor (host and a throwaway box), for the record; A2 is decided by the lines above and the box half"
    # Bounded, and into a file rather than a pipe: it is for the record, and on 2026-11-02 a doctor
    # killed by its bound left its throwaway box's `sudo umount` running, which held a pipe's write
    # end open and so held A2 for as long as the umount queue did.
    local doctor_out
    doctor_out="$(mktemp)"
    timeout -k 30 600 "$DOTFILES_DIR/scripts/agentbox" doctor </dev/null >"$doctor_out" 2>&1
    (( $? == 124 || $? == 137 )) && note "agentbox doctor did not finish in 10 minutes; stopped (its box teardown may still run)"
    sed 's/^/   doctor: /' "$doctor_out"
    rm -f "$doctor_out"
    echo "-- a new agent box runs the box half"
    local rc=0
    "$DOTFILES_DIR/scripts/agentbox" new --dir "$CUTOVER_DIR" -- bash "$DOTFILES_DIR/devbox/sami-devbox-check" --in-box </dev/null || rc=$?
    (( rc == 0 )) || fail "box half: exit $rc (its own FAIL lines are above)"
    host_kernel
    echo "== $fails failed, $(stamp)"
    (( fails == 0 ))
}

# The kernel is not wedged (2026-11-02: cgroup writeback left umounts, fusermount3 and sync in D
# state, and every box teardown hung). D3 first: the throwaway boxes this run made (the doctor's,
# agentbox-doctor*) are torn down within 5 minutes, no umount of a box is left, and no
# agentbox-doctor* mount stays. Then D2, sync completes; then D1, last, so a teardown umount that
# blocks past 10 minutes is caught too.
host_kernel() {
    local boxes got deadline=$((SECONDS + 300))
    boxes="/mnt/nvme/$(id -un)/agentbox/boxes"
    while (( SECONDS < deadline )); do
        got="$(pgrep -af "umount .*$boxes/agentbox-" ; findmnt -rn -o TARGET | grep "^$boxes/agentbox-doctor")"
        [[ -z "$got" ]] && break
        sleep 10
    done
    [[ -z "$got" ]] && ok "D3: box teardown: no umount of a box runs and no agentbox-doctor mount stays" \
        || fail "D3: box teardown hangs after 5 minutes: $(tr '\n' ';' <<<"$got")"
    # sync in the background: a sync stuck in D state cannot be killed, so `timeout sync` would
    # wait on it forever.
    local p _
    sync </dev/null >/dev/null 2>&1 & p=$!
    for _ in $(seq 60); do kill -0 "$p" 2>/dev/null || break; sleep 1; done
    if kill -0 "$p" 2>/dev/null; then fail "D2: sync did not complete in 60 s (pid $p left running)"; disown "$p"
    else ok "D2: sync completes"; fi
    # The time since each D task last ran (/proc/<pid>/sched se.exec_start, ms since boot), so it
    # measures time blocked, not process age.
    # shellcheck disable=SC2016  # the inner shell and awk expand these
    local dtasks
    if ! dtasks="$(sudo -n sh -c 'up=$(cut -d" " -f1 /proc/uptime); for d in /proc/[0-9]*; do grep -q "^State:.D" $d/status 2>/dev/null || continue; s=$(awk "/^se.exec_start/{print \$3}" $d/sched 2>/dev/null); [ -n "$s" ] && echo "$up $s ${d#/proc/} $(tr " " _ < $d/comm)"; done; true' 2>&1)"; then
        fail "D1: the D-state scan did not run: $dtasks"
    else
        got="$(awk '{b=$1-$2/1000; if (b>600) printf "pid %s (%s) in D state for %d s\n",$3,$4,b}' <<<"$dtasks")"
        [[ -z "$got" ]] && ok "D1: no task in D state over 600 s" || fail "D1: $(tr '\n' ';' <<<"$got")"
    fi
    (( fails == 0 ))
}

case "${1:-}" in
    --in-box) in_box; exit $? ;;
    --pins) knives_check; mise_check; (( fails == 0 )); exit $? ;;
    ""|--mark-ready) ;;
    *) awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0" >&2; exit 2 ;;
esac

mkdir -p "$CUTOVER_DIR" || exit 1
# An old marker says nothing about this run: remove it first, so a failed or crashed run leaves none.
rm -f "$CUTOVER_DIR/target-ready" || exit 1
log="$CUTOVER_DIR/a2-$(date -u +%Y%m%dT%H%M%SZ).log"
host 2>&1 | tee "$log"
status=("${PIPESTATUS[@]}")
fails="$(grep -c '^FAIL' "$log")"
echo "log: $log"
if (( status[0] != 0 || status[1] != 0 )) && (( fails == 0 )); then
    echo "FAIL the host checks exited ${status[0]} (tee ${status[1]}) with no FAIL line: they stopped early" | tee -a "$log"
    fails=1
fi
if (( fails == 0 )) && ! grep -qx "== 0 failed, .*" "$log"; then
    echo "FAIL the host checks did not reach their last line" | tee -a "$log"
    fails=1
fi
if (( fails == 0 )) && [[ "${1:-}" == --mark-ready ]]; then
    # The marker names the run, and every WAIT line of it: what passed only because it waits on
    # someone else.
    { printf '%s %s %s\n' "$(stamp)" "$(git -C "$DOTFILES_DIR" rev-parse HEAD)" "$log"
      grep '^WAIT' "$log" || true; } >"$CUTOVER_DIR/target-ready"
    echo "wrote $CUTOVER_DIR/target-ready$(grep -q '^WAIT' "$log" && echo ", with its WAIT lines")"
fi
(( fails == 0 ))
