    [[ "$missing" =~ ^[0-9]+$ && "$missing" -ge 2 ]] && ok "omp models.yml: model-gateway declares $missing openai/ models" || fail "omp models.yml: model-gateway's openai/ models: want 2 or more, got: $missing"
    host_logins
