# --- the host half ---------------------------------------------------------------------------
host_disks() {
    local src fstype
    for spec in "/mnt/nvme google-state" "/mnt/durable google-cold"; do
        read -r mnt dev <<<"$spec"
        src="$(findmnt -n -o SOURCE --target "$mnt" 2>/dev/null)"
        fstype="$(findmnt -n -o FSTYPE --target "$mnt" 2>/dev/null)"
        if [[ "$(findmnt -n -o TARGET --target "$mnt" 2>/dev/null)" == "$mnt" && "$(readlink -f "$src")" == "$(readlink -f "/dev/disk/by-id/$dev")" && "$fstype" == xfs ]]; then
            ok "disk: $mnt is $dev ($src, $fstype)"
        else
            fail "disk: $mnt: want /dev/disk/by-id/$dev xfs, got ${src:-nothing} ${fstype:-}"
        fi
    done
    # /home and the lane trees are the state disk's, bound: same device, same inode.
    local d
    for d in home theorem theorem-ext4 theorem-xfs; do
        if [[ "$(stat -c %d:%i "/$d" 2>/dev/null)" == "$(stat -c %d:%i "/mnt/nvme/$d" 2>/dev/null)" ]]; then
            ok "disk: /$d is /mnt/nvme/$d (bind)"
        else
            fail "disk: /$d is not /mnt/nvme/$d: $(findmnt -n -o SOURCE,FSTYPE "/$d" 2>&1)"
        fi
    done
    src="$(findmnt -n -o SOURCE /mnt/scratch 2>/dev/null)"
    if [[ "$src" == /dev/md* ]]; then
        local md members
        md="$(basename "$(readlink -f "$src")")"
        members="$(find "/sys/block/$md/slaves" -mindepth 1 -maxdepth 1 2>/dev/null | wc -l)"
        ok "disk: /mnt/scratch is $src ($(lsblk -dno SIZE "$src" 2>/dev/null | tr -d ' '), RAID of $members local SSDs)"
    else
        fail "disk: /mnt/scratch: want a RAID md device, got ${src:-nothing}"
    fi
    if swapon --show=NAME --noheadings 2>/dev/null | grep -qx /mnt/scratch/swapfile; then
        ok "swap: /mnt/scratch/swapfile active ($(swapon --show=SIZE --noheadings 2>/dev/null | head -1 | tr -d ' '))"
    else
        fail "swap: /mnt/scratch/swapfile not active: $(swapon --show 2>&1 | tr '\n' ' ')"
    fi
    [[ -d "/mnt/scratch/$(id -un)" && -O "/mnt/scratch/$(id -un)" ]] && ok "scratch: /mnt/scratch/$(id -un) is $(id -un)'s" || fail "scratch: /mnt/scratch/$(id -un) missing or not $(id -un)'s"
    # /tmp and /var/tmp are bound from the scratch only at a boot (devbox/gce-disks, bind_tmp), so
    # until the first planned reset after the change they are still the boot disk's: a WAIT.
    for d in "tmp /tmp" "var-tmp /var/tmp"; do
        read -r src mnt <<<"$d"
        if [[ "$(stat -c %d:%i "$mnt" 2>/dev/null)" == "$(stat -c %d:%i "/mnt/scratch/$src" 2>/dev/null)" ]]; then
            ok "scratch: $mnt is /mnt/scratch/$src (bind)"
        elif ! mountpoint -q "$mnt"; then
            echo "WAIT scratch: $mnt is still the boot disk's; devbox/gce-disks binds it from /mnt/scratch/$src at the next planned reset (devbox/sami-devbox.md, \"/tmp and /var/tmp\")"
        else
            fail "scratch: $mnt is a mount of something other than /mnt/scratch/$src: $(findmnt -n -o SOURCE,FSTYPE "$mnt" 2>&1)"
        fi
    done
}

# The boot disk holds the OS only (dispatch://INFRA-993, "Shape and disks"): sami-rocqperf's root
# filled up, and on 2026-11-03 10 GiB of lane logs landed on sami-devbox's in /theorem. Two tests:
# / uses at most ROOT_MAX_GIB; and no directory on the root filesystem outside the OS's own
# (ROOT_OS_DIRS) holds more than 1 GiB, counted without those directories and without any mount
# below it (`du -x`: /home, /var/lib/docker, /theorem and the other binds are other filesystems,
# and a bind hides what the boot disk holds under it, which only the df test sees). /var/log is
# the OS's while it holds at most 2 GiB (journald's cap is 2 GiB, devbox/journald-cap.conf). The
# directory named is the deepest one over the limit, so the line says where the bytes are. du runs
# with sudo and a time bound: it took 0.4 s on 2026-11-03.
ROOT_MAX_GIB=40
ROOT_OS_DIRS=(/usr /var/lib/apt /var/cache/apt /boot /snap /var/lib/snapd /opt /var/log)
ROOT_DU_SECONDS=120
# stdin: `du -x -B1 -0 /`; argv: the OS's directories. Prints `TOTAL <bytes> <dirs>`, `VARLOG
# <bytes>` and one `BIG <bytes> <path>` per deepest directory over 1 GiB of its own.
ROOT_DU_PY='
import sys
GIB = 1024 ** 3
os_dirs = sys.argv[1:]
sizes = {}
for rec in sys.stdin.buffer.read().split(b"\0"):
    size, tab, path = rec.partition(b"\t")
    if tab:
        sizes[path.decode("utf-8", "surrogateescape")] = int(size)
def under(p, a):
    return p == a or p.startswith(a.rstrip("/") + "/")
present = [a for a in os_dirs if a in sizes]
own = {}
for p, s in sizes.items():
    if any(under(p, a) for a in os_dirs):
        continue
    own[p] = s - sum(sizes[a] for a in present if under(a, p))
big = [p for p, s in own.items() if s > GIB]
deepest = [p for p in big if not any(q != p and under(q, p) for q in big)]
print("TOTAL", sizes.get("/", 0), len(sizes))
print("VARLOG", sizes.get("/var/log", 0))
for p in sorted(deepest, key=lambda p: -own[p]):
    print("BIG", own[p], p)
'
host_rootfs() {
    local used res err rc kind size path total=0 dirs=0 varlog=0 big=() t0=$SECONDS
    used="$(df -B1 --output=used / 2>/dev/null | tail -1 | tr -d ' ')"
    if [[ "$used" =~ ^[0-9]+$ ]] && (( used <= ROOT_MAX_GIB * 1024 ** 3 )); then
        ok "root disk: / uses $(numfmt --to=iec "$used"), at most ${ROOT_MAX_GIB}G"
    else
        fail "root disk: / uses ${used:-?} bytes, over ${ROOT_MAX_GIB}G (df -B1 --output=used /)"
    fi
    err="$(mktemp)"
    # shellcheck disable=SC2024  # the error file is sami's own temp file, on purpose
    res="$(sudo -n timeout "$ROOT_DU_SECONDS" du -x -B1 -0 / 2>"$err" | python3 -c "$ROOT_DU_PY" "${ROOT_OS_DIRS[@]}"; echo "RC ${PIPESTATUS[0]} ${PIPESTATUS[1]}")"
    rc="$(sed -n 's/^RC //p' <<<"$res")"
    if [[ "$rc" == "124 "* ]]; then
        fail "root disk: sudo du -x / did not finish in $ROOT_DU_SECONDS s"
    elif [[ "$rc" == "1 0" ]] && [[ -s "$err" ]] && ! grep -qv ': No such file or directory$' "$err"; then
        note "root disk: du -x /: $(grep -c '' "$err") path(s) went away during the walk, e.g. $(tail -1 "$err")"
        rc="0 0"
    fi
    if [[ "$rc" != "0 0" ]]; then
        fail "root disk: sudo du -x / | python3 exited $rc: $(tail -1 "$err")"
        rm -f "$err"
        return
    fi
    rm -f "$err"
    while read -r kind size path; do
        case "$kind" in
            TOTAL) total="$size" dirs="$path" ;;
            VARLOG) varlog="$size" ;;
            BIG) big+=("$path $(numfmt --to=iec "$size")") ;;
        esac
    done <<<"$res"
    if (( ${#big[@]} )); then
        fail "root disk: outside the OS's directories, over 1G of its own: $(printf '%s; ' "${big[@]}")move it to the state disk (/mnt/nvme) or the scratch (/mnt/scratch)"
    else
        ok "root disk: no directory outside ${ROOT_OS_DIRS[*]} holds over 1G of its own (du -x /: $(numfmt --to=iec "$total") in $dirs directories, $((SECONDS - t0)) s)"
    fi
    if (( varlog <= 2 * 1024 ** 3 )); then
        ok "root disk: /var/log holds $(numfmt --to=iec "$varlog"), at most 2G"
    else
        fail "root disk: /var/log holds $(numfmt --to=iec "$varlog"), over 2G (journald's cap: devbox/journald-cap.conf)"
    fi
}

# sudo_find ARRAY ARGS...: `sudo -n find ARGS`, appending each path to the array named ARRAY, and
# a FAIL when find (or sudo) exits non-zero, so a walk that failed never reads as one that found
# nothing. A path that sessions remove while find walks it is not a failure: find then exits 1
# and says "No such file or directory" for it (A2 of 08:22Z on 2026-11-03 failed on a file a lane
# deleted under /mnt/nvme/sami/wt/SkipRecheck). Only when every error line is that one is the run
# a pass, with a note; any other error, or a non-zero exit with no error line, stays a FAIL.
sudo_find() {
    local -n into="$1"
    shift
    local out err rc=0
    out="$(mktemp)" err="$(mktemp)"
    # shellcheck disable=SC2024  # the output files are sami's own temp files, on purpose
    sudo -n find "$@" >"$out" 2>"$err" || rc=$?
    mapfile -t -O "${#into[@]}" into <"$out"
    if (( rc == 1 )) && [[ -s "$err" ]] && ! grep -qv ': No such file or directory$' "$err"; then
        note "logins: sudo -n find $1: $(grep -c '' "$err") path(s) went away during the walk, e.g. $(tail -1 "$err")"
        rc=0
    fi
    (( rc == 0 )) || fail "logins: sudo -n find $1 exited $rc: $(tail -1 "$err")"
    rm -f "$out" "$err"
    return "$rc"
}

# legacy_is_keyless DIR: DIR, a gcloud legacy_credentials directory, holds no person's login and no
# long-lived secret: each adc.json in it is a keyless external_account (type external_account, no
# private_key, no refresh_token), each .boto names only such a file (gs_external_account_file) and
# holds no refresh token or key, and nothing else is there. A user login (authorized_user, a .boto
# with gs_oauth2_refresh_token) and a service account key (service_account, with a private_key)
# both fail: no session here uses a service account key.
legacy_is_keyless() {
    local f t out rc=0
    out="$(sudo -n find "$1" -type f -print 2>&1)" || rc=$?
    (( rc == 0 )) || return 1
    while IFS= read -r f; do
        [[ -n "$f" ]] || continue
        t="$(sudo -n cat "$f" 2>/dev/null)" || return 1
        ! grep -qiE 'refresh_token|private_key|service_key' <<<"$t" || return 1
        case "${f##*/}" in
            adc.json)
                [[ "$(jq -r '.type // empty' <<<"$t" 2>/dev/null)" == external_account ]] || return 1 ;;
            .boto)
                # Its only setting lines name the external account's adc.json.
                ! grep -vE '^[[:space:]]*(\[Credentials\]|gs_external_account_file[[:space:]]*=.*|#.*)?[[:space:]]*$' <<<"$t" | grep -q . || return 1 ;;
            *) return 1 ;;
        esac
    done <<<"$out"
}

# No person's login on any mounted disk: the A2 file names, a gh login, and any gcloud or Azure
# store that holds a user's login. Every local filesystem is walked once (-xdev per mount).
# A2 names legacy_credentials as a person's login, and gcloud also writes that directory for the
# machine's own accounts: a session's own CLOUDSDK_CONFIG that holds dev-sjawhar@'s keyless
# external_account has one, and `agentbox move --to` carries it with the session (three on
# 2026-11-03 05:25-05:39Z). So a legacy_credentials directory is judged by what it holds, as
# credentials.db is below: one that legacy_is_keyless passes is a note, not a FAIL; every other
# file of the list, and a service account key, is a FAIL.
host_logins() {
    local -a names=() found=() person=() machine=() dbs=() profiles=()
    local n f walked=1
    for n in "${LOGIN_FILES[@]}"; do names+=(-name "$n" -o); done
    names+=(-path '*/.config/gh/hosts.yml')
    for mnt in / /mnt/nvme /mnt/durable /mnt/scratch; do
        sudo_find found "$mnt" -xdev \( "${names[@]}" \) -print || walked=0
    done
    for f in "${found[@]}"; do
        if [[ "${f##*/}" == legacy_credentials ]] && legacy_is_keyless "$f"; then machine+=("$f"); else person+=("$f"); fi
    done
    (( ${#machine[@]} )) && note "logins: legacy_credentials holding only keyless external_account credentials (no person's login, no key): ${machine[*]}"
    if (( ${#person[@]} )); then
        fail "logins: person's login files present: ${person[*]}"
    elif (( walked )); then
        ok "logins: no ${LOGIN_FILES[*]} or .config/gh/hosts.yml holding a person's login on /, /mnt/nvme, /mnt/durable, /mnt/scratch"
    fi
    # gcloud's own stores: a row whose credential is authorized_user is a person's login.
    found=()
    walked=1
    sudo_find dbs / /mnt/nvme /mnt/durable -xdev -name credentials.db -path '*gcloud*' -print || walked=0
    for f in "${dbs[@]}"; do
        n="$(python3 - "$f" <<'PY' 2>&1
import json, sqlite3, sys
con = sqlite3.connect(f"file:{sys.argv[1]}?mode=ro", uri=True)
rows = con.execute("select account_id, value from credentials").fetchall()
print(" ".join(a for a, v in rows if json.loads(v).get("type") == "authorized_user"))
PY
)"
        [[ -n "$n" ]] && found+=("$f: $n")
    done
    if (( ${#found[@]} )); then fail "logins: gcloud user logins stored: ${found[*]}"
    elif (( walked )); then ok "logins: no gcloud credentials.db holds an authorized_user row"; fi
    # Azure: a profile whose subscriptions name a user is a person's login.
    found=()
    walked=1
    sudo_find profiles / /mnt/nvme /mnt/durable -xdev -name azureProfile.json -print || walked=0
    for f in "${profiles[@]}"; do
        sudo -n cat "$f" 2>/dev/null | jq -e '[.subscriptions[]?.user.type] | any(. == "user")' >/dev/null 2>&1 && found+=("$f")
    done
    if (( ${#found[@]} )); then fail "logins: Azure user login in ${found[*]}"
    elif (( walked )); then ok "logins: no azureProfile.json names a user"; fi
}

# Owners of the copied trees: to depth 3, every entry under /mnt/nvme/sami and /mnt/durable/sami is
# sami's. tar -x made parent directories as root when a shard did not carry them (2026-11-03: an
# agentbox move was refused on root-owned /mnt/nvme/sami/tmp/restack). The exceptions are paths
# that root owns on sami-rocqperf too (container and root-run outputs, and the root-run cold moves),
# found by the bulk copy's comparison on 2026-11-03; anything under them is not judged here.
OWNER_EXCEPTIONS=(
    /mnt/durable/sami/nvme-cold          # cold moves of 2026-11-01..03, made as root on rocqperf
    /mnt/durable/sami/src-cold           # the same
    /mnt/durable/sami/craft-tmp/r4       # Rocq build outputs of a root container
    /mnt/nvme/sami/chief                 # root-owned on rocqperf
    /mnt/nvme/sami/tmp/pr1295-probe      # Rocq build outputs of a root container
    /mnt/nvme/sami/tmp/task12            # build logs and objects of a root container
    /mnt/nvme/sami/keyrestore-pr/tasks/.pytest_cache
    /mnt/nvme/sami/pinship/accept/d-fastgrade
)
host_owners() {
    local -a found=() bad=()
    local f e skip walked=1
    sudo_find found /mnt/nvme/sami /mnt/durable/sami -maxdepth 3 ! -user sami -print || walked=0
    for f in "${found[@]}"; do
        skip=0
        for e in "${OWNER_EXCEPTIONS[@]}"; do [[ "$f" == "$e" || "$f" == "$e"/* ]] && { skip=1; break; }; done
        (( skip )) || bad+=("$f")
    done
    if (( ${#bad[@]} )); then
        fail "owners: ${#bad[@]} entries to depth 3 under /mnt/nvme/sami and /mnt/durable/sami are not sami's, e.g. ${bad[*]:0:5}"
    elif (( walked )); then
        ok "owners: 0 entries to depth 3 under /mnt/nvme/sami and /mnt/durable/sami owned by anyone but sami ($(( ${#found[@]} )) under the ${#OWNER_EXCEPTIONS[@]} documented root-owned paths)"
    fi
}

host_identity() {
    local got
    [[ "$(hostname -s)" == sami-devbox ]] && ok "host: hostname sami-devbox" || fail "host: hostname $(hostname -s)"
    [[ "$(id -u)" == 1000 && "$(id -un)" == sami ]] && ok "host: user sami uid 1000" || fail "host: user $(id -un) uid $(id -u), want sami 1000"
    # Sami's own node (dispatch://INFRA-1099): no tag, and his login owns it. Until agent-infra
    # #1849 applies, the node may still be the tagged one it was provisioned as; both pass, so the
    # sign-in that removes the tag does not fail this check and block `agentbox move --to`.
    got="$(tailscale status --self --json 2>/dev/null | jq -r '"\(.Self.HostName) tags [\((.Self.Tags // []) | join(","))] owner \(.User[(.Self.UserID | tostring)].LoginName // "unknown")"')"
    case "$got" in
        "sami-devbox tags [] owner sami@theorem.dev") ok "tailnet: node sami-devbox, no tag, owner sami@theorem.dev" ;;
        "sami-devbox tags [tag:sami-devbox] owner "*) ok "tailnet: node sami-devbox, still tag:sami-devbox until Sami signs it in (INFRA-1099)" ;;
        *) fail "tailnet: want 'sami-devbox tags [] owner sami@theorem.dev', got '$got'" ;;
    esac
    got="$(curl -fsS -m 5 -H 'Metadata-Flavor: Google' http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/email 2>&1)"
    [[ "$got" == "$ACCOUNT" ]] && ok "host: the VM's attached account is $got" || fail "host: metadata account: $got"
    [[ ! -e "$HOME/.config/gcloud/box_credential_config.json" && -z "${GOOGLE_APPLICATION_CREDENTIALS:-}" ]] \
        && ok "host: no box_credential_config.json and no GOOGLE_APPLICATION_CREDENTIALS (ADC is the metadata server)" \
        || fail "host: a credential file is configured: ${GOOGLE_APPLICATION_CREDENTIALS:-$HOME/.config/gcloud/box_credential_config.json}"
}

# No unit failing on the machine: the user manager's and the system's failed lists are empty, and
# unit-health-watch (scripts/unit-health-watch) holds no open condition in its state file.
host_units() {
    local got state
    got="$(systemctl --user --failed --no-legend --plain 2>&1)"
    [[ -z "$got" ]] && ok "units: systemctl --user --failed lists nothing" || fail "units: systemctl --user --failed: $(tr '\n' ';' <<<"$got")"
    # logind's session-*.scope units are login sessions (an ssh session killed by a client timeout
    # leaves one failed), not provisioning units: a note, not a FAIL. Every other unit is judged.
    got="$(systemctl --failed --no-legend --plain 2>&1)"
    local sessions
    sessions="$(awk '$1 ~ /^session-.*\.scope$/ { print $1 }' <<<"$got")"
    got="$(awk '$1 !~ /^session-.*\.scope$/' <<<"$got")"
    [[ -n "$sessions" ]] && note "units: failed login-session scopes (not judged): $(tr '\n' ' ' <<<"$sessions")"
    [[ -z "$got" ]] && ok "units: systemctl --failed lists nothing but login-session scopes" || fail "units: systemctl --failed: $(tr '\n' ';' <<<"$got")"
    for state in "/mnt/nvme/$(id -un)/tmp/unit-health-watch/state.json" "${XDG_STATE_HOME:-$HOME/.local/state}/unit-health-watch/state.json"; do
        [[ -s "$state" ]] && break
    done
    if [[ ! -s "$state" ]]; then
        fail "units: unit-health-watch has no state file (has it run? systemctl --user status unit-health-watch.timer)"
    elif got="$(jq -r '(.incidents // {}) | to_entries[] | "\(.key): \(.value.why)"' "$state" 2>&1)" && [[ -z "$got" ]]; then
        ok "units: unit-health-watch has nothing open (state $state, last run $(jq -r '.last_run | todate? // .' "$state"))"
    else
        fail "units: unit-health-watch has open conditions: $(tr '\n' ';' <<<"$got")"
    fi
}

# The dotfiles follow origin's main by themselves (scripts/dotfiles-follow): its timer is active,
# its last run exited 0, and that run, at most 30 minutes ago, left ~/.dotfiles on origin/main
# with no condition open and its tools installed.
host_follow() {
    local got state outcome age head target tools
    got="$(systemctl --user is-active dotfiles-follow.timer 2>&1)"
    [[ "$got" == active ]] || { fail "dotfiles-follow: timer is '$got', want active (devbox/install.sh arms it)"; return; }
    # One line per property, sorted, so the order systemctl prints them in does not matter.
    got="$(systemctl --user show -p Result -p ExecMainStatus -p ExecMainExitTimestamp dotfiles-follow.service 2>&1 | sort | tr '\n' ' ')"
    if [[ " $got" == *" ExecMainExitTimestamp= "* || " $got" != *" ExecMainStatus=0 "* || " $got" != *" Result=success "* ]]; then
        fail "dotfiles-follow: its last run did not exit 0, or none ran: $got"
        return
    fi
    for state in "/mnt/nvme/$(id -un)/tmp/dotfiles-follow/state.json" "${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles-follow/state.json"; do
        [[ -s "$state" ]] && break
    done
    outcome="$(jq -r '"\(.last_outcome) \(now - (.last_run // 0) | floor) \(.head[0:12]) \(.target[0:12]) \(.tools_ok_head == .head)"' "$state" 2>&1)"
    read -r got age head target tools <<<"$outcome"
    if [[ "$got" == ok && "$age" =~ ^[0-9]+$ && "$age" -le 1800 && "$head" == "$target" && "$tools" == true ]]; then
        ok "dotfiles-follow: timer active; its last run, ${age}s ago, exited 0 and left ~/.dotfiles on origin/main $head with its tools installed (state $state)"
    else
        fail "dotfiles-follow: last run: '$outcome' (want: outcome ok, at most 1800 s ago, HEAD = origin/main, tools installed at HEAD; state $state)"
    fi
}

# The apt packages devbox/gce-host.sh adds for lanes (2026-11-03): python3 has pip and venv (the
# N6 farm runs `python3 -m pip install --target`), and the commands of the other packages resolve.
host_packages() {
    local out dir c missing=""
    out="$(python3 -m pip --version 2>&1)" && ok "python3 -m pip --version: $out" || fail "python3 -m pip --version: $(tail -1 <<<"$out")"
    dir="$(mktemp -d)"
    out="$(python3 -m venv "$dir/venv" 2>&1)" && [[ -x "$dir/venv/bin/python" ]] && ok "python3 -m venv: made $dir/venv" || fail "python3 -m venv: $(tail -1 <<<"$out")"
    rm -rf "$dir"
    for c in opam m4 bwrap gdb stress-ng keyctl psql Xvfb qemu-img qemu-system-x86_64; do
        command -v "$c" >/dev/null || missing+=" $c"
    done
    [[ -z "$missing" ]] && ok "lane packages: opam m4 bwrap gdb stress-ng keyctl psql Xvfb qemu-img qemu-system-x86_64 resolve" || fail "lane packages: missing command(s):$missing"
}

# The open-file soft limit of Tailscale SSH and sshd sessions (devbox/nofile.conf). The unit
# property holds once gce-host.sh installed the drop-in; a running daemon has it only when it
# started after the drop-in, and tailscaled restarts only at a planned reset (devbox/sami-devbox.md,
# "Next planned reset"). /proc/<pid>/limits cannot show it: tailscaled and its be-child are Go,
# which raises its own soft limit to the hard one (524287 seen) and gives its children the soft
# limit it started with.
host_nofile() {
    local unit got started installed
    for unit in tailscaled ssh; do
        got="$(systemctl show "$unit.service" -p LimitNOFILESoft --value 2>&1)"
        if [[ "$got" != 65536 ]]; then
            fail "nofile: $unit.service LimitNOFILESoft=$got, want 65536; run sudo devbox/gce-host.sh"
            continue
        fi
        started="$(systemctl show "$unit.service" -p ExecMainStartTimestamp --value --timestamp=unix 2>&1)"
        started="${started#@}"
        installed="$(stat -c %Y "/etc/systemd/system/$unit.service.d/60-nofile.conf" 2>&1)"
        if [[ "$started" =~ ^[0-9]+$ && "$installed" =~ ^[0-9]+$ && "$started" -ge "$installed" ]]; then
            ok "nofile: $unit.service LimitNOFILESoft=65536, and its process started after the drop-in"
        elif [[ "$unit" == tailscaled && "$started" =~ ^[0-9]+$ && "$installed" =~ ^[0-9]+$ ]]; then
            echo "WAIT nofile: tailscaled.service LimitNOFILESoft=65536, but tailscaled started before the drop-in, so its sessions start at its old soft limit until it restarts (devbox/sami-devbox.md, \"Next planned reset\")"
        else
            fail "nofile: $unit.service started @$started, drop-in written @$installed: restart $unit.service (KillMode=process keeps sessions)"
        fi
    done
}

# bwrap makes its network namespace as sami: the AppArmor profile devbox/gce-host.sh installs
# (Ubuntu 24.04 denies unprivileged user namespaces without it) is byte for byte the dotfiles'
# copy, and a bwrap sandbox with its own network namespace and / read-only runs `true`. That
# command line is in the private repository theorem-labs/sami, cloned at .secrets, one line of
# arguments: the public-text leak check refuses bubblewrap options in this public repository.
BWRAP_SMOKE_FILE="$DOTFILES_DIR/.secrets/dotfiles/devbox/bwrap-smoke"
host_bwrap() {
    local want got out rc=0
    local -a args=()
    want="$(sha256sum "$DOTFILES_DIR/devbox/apparmor-bwrap" 2>&1)" && want="${want%% *}"
    got="$(sha256sum /etc/apparmor.d/bwrap 2>&1)" && got="${got%% *}"
    if [[ "$want" =~ ^[0-9a-f]{64}$ && "$got" == "$want" ]]; then
        ok "bwrap AppArmor profile: /etc/apparmor.d/bwrap is devbox/apparmor-bwrap (sha256 ${want:0:12})"
    else
        fail "bwrap AppArmor profile: /etc/apparmor.d/bwrap ($(tail -1 <<<"$got")) is not devbox/apparmor-bwrap ($(tail -1 <<<"$want")); run sudo devbox/gce-host.sh"
    fi
    read -ra args 2>/dev/null <"$BWRAP_SMOKE_FILE"
    (( ${#args[@]} )) || { fail "bwrap sandbox: no command line in $BWRAP_SMOKE_FILE (git -C $DOTFILES_DIR/.secrets pull)"; return; }
    out="$(bwrap "${args[@]}" 2>&1)" || rc=$?
    (( rc == 0 )) && ok "bwrap ${args[*]}: exit 0" || fail "bwrap ${args[*]}: exit $rc: $(tail -1 <<<"$out")"
}

# Movers (S3 and others) run scripts on sami-rocqperf over ssh after the move, so this machine
# must reach it. Both are Sami's own nodes, so Tailscale SSH on sami-rocqperf takes the
# connection as sami by the policy's accept rule for his own devices (dispatch://INFRA-1099).
rocqperf_check() {
    local out rc=0
    out="$(ssh -o BatchMode=yes -o ConnectTimeout=15 sami@sami-rocqperf true </dev/null 2>&1)" || rc=$?
    if (( rc == 0 )); then
        ok "ssh sami-devbox -> sami-rocqperf: ssh -o BatchMode=yes sami@sami-rocqperf true exits 0"
    else
        fail "ssh sami-devbox -> sami-rocqperf: exit $rc: $(tail -1 <<<"$out")"
    fi
}

# The public-text leak check: ~/.local/share/public-leak-check holds the tag of agent-infra's
# leak-check/ that devbox/leak-check-tag.env names (sami-devbox-provision's step leakcheck installs
# it), so its three files must have that file's sha256.
leak_check_host_check() {
    local here d out rc=0
    # shellcheck source=leak-check-tag.env
    . "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/leak-check-tag.env"
    here="$(cat "$HOME/.config/public-leak-check/path" 2>&1)"
    [[ -x "$here" ]] || { fail "public-leak-check: the pointer names '$here', which is not an executable file here"; return; }
    d="$(dirname "$here")"
    out="$(cd "$d" && sha256sum -c <<<"$LEAK_CHECK_HOME_SHA256" 2>&1)" || rc=$?
    (( rc == 0 )) && ok "public-leak-check: $d holds $LEAK_CHECK_TAG (${LEAK_CHECK_COMMIT:0:12}): $(tr '\n' ' ' <<<"$out")" \
        || fail "public-leak-check: $d is not $LEAK_CHECK_TAG (sha256sum -c exit $rc): $(grep -v ': OK$' <<<"$out" | tr '\n' ' ')install it: sami-devbox-provision --only leakcheck"
}

# The leak check's pre-push hook: every checkout under ~/src that pushes to a public repository has
# it. Which checkouts are public is decided by the sweep's own code (sweep-hooks.sh up to its loop,
# as sami-devbox-provision's step prepush runs it), with an installer that installs nothing and
# fails, so each checkout without the hook is one FAILED line and nothing on disk changes.
prepush_hook_host_check() {
    local d="$HOME/.local/share/public-leak-check-hooks" t out rc=0 summary missing
    # shellcheck source=leak-check-tag.env
    . "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/leak-check-tag.env"
    out="$(cd "$d" && sha256sum -c <<<"$LEAK_CHECK_HOOK_SHA256" 2>&1)" || rc=$?
    (( rc == 0 )) || { fail "pre-push hook: $d is not $LEAK_CHECK_TAG's hook files (sha256sum -c exit $rc): $(tr '\n' ' ' <<<"$out")install them: sami-devbox-provision --only prepush"; return; }
    t="$(mktemp -d)"
    printf '#!/bin/sh\nexit 1\n' > "$t/install-prepush-hook.sh" && chmod +x "$t/install-prepush-hook.sh"
    bash -c "$(sed '/^i=0$/,$d' "$d/sweep-hooks.sh")
        here=$t; log=$t/log; sweep \"\$HOME/src\"" </dev/null >/dev/null 2>&1
    summary="$(grep ' sweep \[' "$t/log" 2>/dev/null | tail -n 1)"
    missing="$(sed -n 's/^[^ ]* FAILED //p' "$t/log" 2>/dev/null | tr '\n' ' ')"
    rm -rf "$t"
    if [[ -n "$summary" && -z "$missing" ]]; then
        ok "pre-push hook: every public checkout under ~/src has it (${summary#* sweep })"
    else
        fail "pre-push hook: missing in ${missing:-(the sweep pass wrote no summary)}; install: sami-devbox-provision --only prepush"
    fi
}

# kubectl as a non-interactive ssh command gets it, through the kubeconfig the ossv-job-farm uses.
# Its smoke failed on 2026-11-03 11:35Z with "Install gke-gcloud-auth-plugin": that PATH has
# ~/.mise/shims but not ~/.local/bin, so installers/gcloud-sdk.sh links the plugin into
# /usr/local/bin. SSH_PATH is `ssh sami@sami-devbox 'echo $PATH'` as read on 2026-11-03, and
# MISE_DATA_DIR is set in that shell too (without it the shim installs a second kubectl).
SSH_PATH="$HOME/.cargo/bin:$HOME/.dotfiles/shims:$HOME/.dotfiles/bin:$HOME/.dotfiles/scripts:$HOME/.npm-global/bin:$HOME/.mise/shims:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games:/usr/local/games:/snap/bin"
host_plain_path_kubectl() {
    local out rc=0
    out="$(env -i HOME="$HOME" MISE_DATA_DIR="$HOME/.mise" KUBECONFIG="${KUBECONFIG:-$HOME/.kube/config}" PATH="$SSH_PATH" \
        kubectl --context "$KUBE_CONTEXT" -n "$N6_NAMESPACE" get jobs --chunk-size 1 -o name 2>&1)" || rc=$?
    (( rc == 0 )) && ok "ssh-PATH kubectl: env -i kubectl -n $N6_NAMESPACE get jobs: exit 0 ($(grep -c . <<<"$out") jobs)" \
        || fail "ssh-PATH kubectl: env -i kubectl -n $N6_NAMESPACE get jobs: exit $rc: $(tail -1 <<<"$out")"
}

host() {
    echo "== host $(hostname -s), $(stamp)"
    host_identity
    host_disks
    host_rootfs
    host_units
    host_follow
    host_packages
    host_bwrap
    host_nofile
    host_plain_path_kubectl
    local missing
    mise_check
    missing="$(yq '.providers.anthropic.baseUrl == .providers["ossv-gateway"].baseUrl and .providers.anthropic.apiKey == "!cat /run/user/1000/ossv-box/gateway-token"' "$HOME/.omp/agent/models.yml" 2>&1)"
    [[ "$missing" == true ]] && ok "omp models.yml: anthropic/ uses ossv-gateway's baseUrl and the gateway token" || fail "omp models.yml: anthropic/ is not routed through ossv-gateway with the gateway token: $missing"
    # The openai/ agents and roles go to the gateway's openai group (devbox/sami-devbox-model-routes):
    # the slow and deep roles and the astra and sami-proxy agents name ossv-gateway/openai/ models,
    # and omp's merged models.yml declares at least 4 of them.
    missing="$(yq -r '.modelRoles.slow, .modelRoles.deep, .task.agentModelOverrides.astra, .task.agentModelOverrides["sami-proxy"]' "$DOTFILES_DIR/omp/config.local.yml" 2>&1)"
    if [[ "$(grep -c '^ossv-gateway/openai/' <<<"$missing")" == 4 && "$(wc -l <<<"$missing")" == 4 ]]; then
        ok "omp config.local.yml: slow, deep, astra and sami-proxy use ossv-gateway/openai/ ($(tr '\n' ' ' <<<"$missing"))"
    else
        fail "omp config.local.yml: slow, deep, astra, sami-proxy want ossv-gateway/openai/<id> each, got: $(tr '\n' ';' <<<"$missing")"
    fi
    missing="$(yq '[.providers["ossv-gateway"].models[].id | select(test("^openai/"))] | length' "$HOME/.omp/agent/models.yml" 2>&1)"
    [[ "$missing" =~ ^[0-9]+$ && "$missing" -ge 4 ]] && ok "omp models.yml: ossv-gateway declares $missing openai/ models" || fail "omp models.yml: ossv-gateway's openai/ models: want 4 or more, got: $missing"
    host_logins
    host_owners
    github_check "on the host"
    tq_check "on the host"
    rocqperf_check
    leak_check_host_check
    prepush_hook_host_check
    ossv_tree_host_check
    n6_check "on the host"
    echo "-- agentbox doctor (host and a throwaway box), for the record; A2 is decided by the lines above and the box half"
    # Bounded, and into a file rather than a pipe: it is for the record, and on 2026-11-02 a doctor
    # killed by its bound left its throwaway box's `sudo umount` running, which held a pipe's write
    # end open and so held A2 for as long as the umount queue did.
    local doctor_out
    doctor_out="$(mktemp)"
    timeout -k 30 600 "$DOTFILES_DIR/scripts/agentbox" doctor </dev/null >"$doctor_out" 2>&1
    (( $? == 124 || $? == 137 )) && note "agentbox doctor did not finish in 10 minutes; stopped (its box teardown may still run)"
    sed 's/^/   doctor: /' "$doctor_out"
    rm -f "$doctor_out"
    echo "-- a new agent box runs the box half"
    local rc=0
    "$DOTFILES_DIR/scripts/agentbox" new --dir "$CUTOVER_DIR" --dir "$BOXID_DIR" -- bash "$DOTFILES_DIR/devbox/sami-devbox-check" --in-box </dev/null || rc=$?
    (( rc == 0 )) || fail "box half: exit $rc (its own FAIL lines are above)"
    host_kernel
    echo "== $fails failed, $(stamp)"
    (( fails == 0 ))
}

# The kernel is not wedged (2026-11-02: cgroup writeback left umounts, fusermount3 and sync in D
# state, and every box teardown hung). D3 first: the throwaway boxes this run made (the doctor's,
# agentbox-doctor*) are torn down within 5 minutes, no umount of a box is left, and no
# agentbox-doctor* mount stays. Then D2, sync completes; then D1, last, so a teardown umount that
# blocks past 10 minutes is caught too.
host_kernel() {
    local boxes got deadline=$((SECONDS + 300))
    boxes="/mnt/nvme/$(id -un)/agentbox/boxes"
    while (( SECONDS < deadline )); do
        got="$(pgrep -af "umount .*$boxes/agentbox-" ; findmnt -rn -o TARGET | grep "^$boxes/agentbox-doctor")"
        [[ -z "$got" ]] && break
        sleep 10
    done
    [[ -z "$got" ]] && ok "D3: box teardown: no umount of a box runs and no agentbox-doctor mount stays" \
        || fail "D3: box teardown hangs after 5 minutes: $(tr '\n' ';' <<<"$got")"
    # sync in the background: a sync stuck in D state cannot be killed, so `timeout sync` would
    # wait on it forever.
    local p _
    sync </dev/null >/dev/null 2>&1 & p=$!
    for _ in $(seq 60); do kill -0 "$p" 2>/dev/null || break; sleep 1; done
    if kill -0 "$p" 2>/dev/null; then fail "D2: sync did not complete in 60 s (pid $p left running)"; disown "$p"
    else ok "D2: sync completes"; fi
    # The time since each D task last ran (/proc/<pid>/sched se.exec_start, ms since boot), so it
    # measures time blocked, not process age.
    # shellcheck disable=SC2016  # the inner shell and awk expand these
    local dtasks
    if ! dtasks="$(sudo -n sh -c 'up=$(cut -d" " -f1 /proc/uptime); for d in /proc/[0-9]*; do grep -q "^State:.D" $d/status 2>/dev/null || continue; s=$(awk "/^se.exec_start/{print \$3}" $d/sched 2>/dev/null); [ -n "$s" ] && echo "$up $s ${d#/proc/} $(tr " " _ < $d/comm)"; done; true' 2>&1)"; then
        fail "D1: the D-state scan did not run: $dtasks"
    else
        got="$(awk '{b=$1-$2/1000; if (b>600) printf "pid %s (%s) in D state for %d s\n",$3,$4,b}' <<<"$dtasks")"
        [[ -z "$got" ]] && ok "D1: no task in D state over 600 s" || fail "D1: $(tr '\n' ';' <<<"$got")"
    fi
    (( fails == 0 ))
}

case "${1:-}" in
    --in-box) in_box; exit $? ;;
    --pins) knives_check; mise_check; (( fails == 0 )); exit $? ;;
    --root) host_rootfs; (( fails == 0 )); exit $? ;;
    ""|--mark-ready) ;;
    *) awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0" >&2; exit 2 ;;
esac

mkdir -p "$CUTOVER_DIR" || exit 1
# An old marker says nothing about this run: remove it first, so a failed or crashed run leaves none.
rm -f "$CUTOVER_DIR/target-ready" || exit 1
log="$CUTOVER_DIR/a2-$(date -u +%Y%m%dT%H%M%SZ).log"
host 2>&1 | tee "$log"
status=("${PIPESTATUS[@]}")
fails="$(grep -c '^FAIL' "$log")"
echo "log: $log"
if (( status[0] != 0 || status[1] != 0 )) && (( fails == 0 )); then
    echo "FAIL the host checks exited ${status[0]} (tee ${status[1]}) with no FAIL line: they stopped early" | tee -a "$log"
    fails=1
fi
if (( fails == 0 )) && ! grep -qx "== 0 failed, .*" "$log"; then
    echo "FAIL the host checks did not reach their last line" | tee -a "$log"
    fails=1
fi
if (( fails == 0 )) && [[ "${1:-}" == --mark-ready ]]; then
    # The marker names the run, and every WAIT line of it: what passed only because it waits on
    # someone else.
    { printf '%s %s %s\n' "$(stamp)" "$(git -C "$DOTFILES_DIR" rev-parse HEAD)" "$log"
      grep '^WAIT' "$log" || true; } >"$CUTOVER_DIR/target-ready"
    echo "wrote $CUTOVER_DIR/target-ready$(grep -q '^WAIT' "$log" && echo ", with its WAIT lines")"
fi
(( fails == 0 ))
