# jwt_claim prints one claim of a JWT's payload.
jwt_claim() {
    local p="${1#*.}"
    p="${p%%.*}"
    p="$(tr '_-' '/+' <<<"$p")"
    while (( ${#p} % 4 )); do p="$p="; done
    base64 -d <<<"$p" 2>/dev/null | jq -r --arg c "$2" '.[$c] // empty'
}

# The model gateway takes a Google ID token for audience model-gateway-gce as a bearer and checks
# its account against its own list (agent-infra model-gateway/vm/ossv_box_auth.py). A2 mints that
# token itself, as a session does: scripts/gateway-token asks the metadata server, which in a box
# is the host's relay. Nothing is cached, so there is no file to find and no timer to be behind
# (dispatch://INFRA-993/comment/be112388).
gateway_check() {
    local token email aud url code
    token="$("$DOTFILES_DIR/scripts/gateway-token" 2>&1)" || {
        fail "model gateway: scripts/gateway-token minted nothing: $(tail -1 <<< "$token")"
        return
    }
    email="$(jwt_claim "$token" email)"
    aud="$(jwt_claim "$token" aud)"
    # This box's own account, which the gateway's list serves as team `box` with no pins
    # (shared/boxaccounts' dev-box@ entry); the metadata relay serves its token with no mint here.
    [[ "$email" == "$ACCOUNT" && "$aud" == model-gateway-gce ]] && ok "model gateway: minted an ID token for $email, audience $aud" || fail "model gateway: minted token: want $ACCOUNT for model-gateway-gce, got ${email:-none} for ${aud:-none}"
    # The gateway sessions use: the model-gateway provider's baseUrl in omp/models.local.yml.
    url="$(awk '/^  model-gateway:/ { p = 1; next } p && /baseUrl:/ { print $2; exit } /^  [^ ]/ { p = 0 }' "$DOTFILES_DIR/omp/models.local.yml" 2>/dev/null)"
    [[ -n "$url" ]] || { fail "model gateway: no model-gateway baseUrl in $DOTFILES_DIR/omp/models.local.yml"; return; }
    code="$(curl -sS -m 20 -o /dev/null -w '%{http_code}' -K <(printf 'header = "Authorization: Bearer %s"\n' "$token") "$url/v1/models" 2>&1)"
    [[ "$code" == 200 ]] && ok "model gateway: $url/v1/models with a freshly minted token: 200" || fail "model gateway: $url/v1/models with a freshly minted token answered $code"
    # And a token it cannot verify is refused, so the 200 above was the token's doing.
    code="$(curl -sS -m 20 -o /dev/null -w '%{http_code}' -H 'Authorization: Bearer x.y.z' "$url/v1/models" 2>&1)"
    [[ "$code" == 401 ]] && ok "model gateway: a forged token answers 401" || fail "model gateway: a forged token answered $code, want 401"
}

