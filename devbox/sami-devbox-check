    missing="$(yq -r '[.providers[] | (.apiKey // "")] | map(select(test("/ossv-box/|/verified-grader/"))) | length' "$HOME/.omp/agent/models.yml" 2>&1)"
    [[ "$missing" == 0 ]] && ok "omp models.yml: no provider reads a cached gateway credential file" || fail "omp models.yml: $missing provider(s) still read a cached gateway credential file"
