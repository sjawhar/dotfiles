# data_copy_check [NOW] -- the stream's data copy (TOOLS's loop 6, /mnt/durable/sami/tools-loops/data-copy.sh)
# saved the live tree to Cloud Storage within 2 h: after each verified snapshot it writes its UTC time to
# OSSV_DATA_COPY_OK. The loop starts here in the freeze of 2026-11-03, so before OSSV_DATA_COPY_FROM the line
# is a note, neither ok nor FAIL. NOW is the Unix time to judge at (default: now). The stamp is the one the
# loop writes since 2026-11-06, in notes/: its old path in ops.git went with that retired directory.
OSSV_DATA_COPY_OK=/mnt/nvme/sami/oss-verifier/notes/ossv-data-copy.ok
OSSV_DATA_COPY_FROM=2026-11-04T00:30:00Z
data_copy_check() {
    local now="${1:-$(date +%s)}" from got at
    from="$(date -d "$OSSV_DATA_COPY_FROM" +%s)"
    got="$(head -c 64 "$OSSV_DATA_COPY_OK" 2>/dev/null | tr -d '\n')"
    at="$(date -d "$got" +%s 2>/dev/null)" || at=""
    if [[ -n "$got" && -n "$at" ]] && (( now - at <= 7200 )); then
        ok "data copy: $OSSV_DATA_COPY_OK says the live tree was saved at $got, $(( (now - at) / 60 )) min ago (at most 120)"
    elif (( now < from )); then
        note "data copy: $OSSV_DATA_COPY_OK reads '${got:-nothing}'; a stamp within 2 h is not expected yet (from $OSSV_DATA_COPY_FROM)"
    else
        fail "data copy: $OSSV_DATA_COPY_OK reads '${got:-nothing}', want a time at most 2 h old (TOOLS's loop 6)"
    fi
}

