# Owners of the copied trees: to depth 3, every entry under /mnt/nvme/sami and /mnt/durable/sami is
# sami's. tar -x made parent directories as root when a shard did not carry them (2026-11-03: an
# agentbox move was refused on root-owned /mnt/nvme/sami/tmp/restack). The exceptions are paths
# that root owns on sami-rocqperf too (container and root-run outputs, and the root-run cold moves),
# found by the bulk copy's comparison on 2026-11-03; anything under them is not judged here.
OWNER_EXCEPTIONS=(
    /mnt/durable/sami/nvme-cold          # cold moves of 2026-11-01..03, made as root on rocqperf
    /mnt/durable/sami/src-cold           # the same
    /mnt/durable/sami/craft-tmp/r4       # Rocq build outputs of a root container
    /mnt/nvme/sami/chief                 # root-owned on rocqperf
    /mnt/nvme/sami/tmp/pr1295-probe      # Rocq build outputs of a root container
    /mnt/nvme/sami/tmp/task12            # build logs and objects of a root container
    /mnt/nvme/sami/keyrestore-pr/tasks/.pytest_cache
    /mnt/nvme/sami/pinship/accept/d-fastgrade
)
host_owners() {
    local -a found=() bad=()
    local f e skip walked=1
    sudo_find found /mnt/nvme/sami /mnt/durable/sami -maxdepth 3 ! -user sami -print || walked=0
    for f in "${found[@]}"; do
        skip=0
        for e in "${OWNER_EXCEPTIONS[@]}"; do [[ "$f" == "$e" || "$f" == "$e"/* ]] && { skip=1; break; }; done
        (( skip )) || bad+=("$f")
    done
    if (( ${#bad[@]} )); then
        fail "owners: ${#bad[@]} entries to depth 3 under /mnt/nvme/sami and /mnt/durable/sami are not sami's, e.g. ${bad[*]:0:5}"
    elif (( walked )); then
        ok "owners: 0 entries to depth 3 under /mnt/nvme/sami and /mnt/durable/sami owned by anyone but sami ($(( ${#found[@]} )) under the ${#OWNER_EXCEPTIONS[@]} documented root-owned paths)"
    fi
}

host_identity() {
    local got
    [[ "$(hostname -s)" == sami-devbox ]] && ok "host: hostname sami-devbox" || fail "host: hostname $(hostname -s)"
    [[ "$(id -u)" == 1000 && "$(id -un)" == sami ]] && ok "host: user sami uid 1000" || fail "host: user $(id -un) uid $(id -u), want sami 1000"
    # Sami's own node (dispatch://INFRA-1099): no tag, and his login owns it. Until agent-infra
    # #1849 applies, the node may still be the tagged one it was provisioned as; both pass, so the
    # sign-in that removes the tag does not fail this check and block `agentbox move --to`.
    got="$(tailscale status --self --json 2>/dev/null | jq -r '"\(.Self.HostName) tags [\((.Self.Tags // []) | join(","))] owner \(.User[(.Self.UserID | tostring)].LoginName // "unknown")"')"
    case "$got" in
        "sami-devbox tags [] owner sami@theorem.dev") ok "tailnet: node sami-devbox, no tag, owner sami@theorem.dev" ;;
        "sami-devbox tags [tag:sami-devbox] owner "*) ok "tailnet: node sami-devbox, still tag:sami-devbox until Sami signs it in (INFRA-1099)" ;;
        *) fail "tailnet: want 'sami-devbox tags [] owner sami@theorem.dev', got '$got'" ;;
    esac
    metadata_account_check "on the host"
    # The VM's own attached account, from the server itself and not the relay: it changes only while
    # the VM is stopped, so until then it is a note beside the account the relay serves.
    got="$(curl -fsS -m 5 --noproxy '*' -H 'Metadata-Flavor: Google' http://169.254.169.254/computeMetadata/v1/instance/service-accounts/default/email 2>&1)"
    if [[ "$got" == "$ACCOUNT" ]]; then
        ok "host: the VM's attached account is $got"
    else
        note "host: the VM's attached account is $got; the clients here act as $ACCOUNT only through the metadata relay (installers/agent-identity.sh)"
    fi
    [[ ! -e "$HOME/.config/gcloud/box_credential_config.json" && -z "${GOOGLE_APPLICATION_CREDENTIALS:-}" ]] \
        && ok "host: no box_credential_config.json and no GOOGLE_APPLICATION_CREDENTIALS (ADC is the metadata server)" \
        || fail "host: a credential file is configured: ${GOOGLE_APPLICATION_CREDENTIALS:-$HOME/.config/gcloud/box_credential_config.json}"
}

# The host profile: agent-infra monitoring/host/guard.sh, the revision OS Config applies (the object
# its policy reads), run as OS Config's validate runs it, with cloud=gcp and the full profile. Left
# without cloud=, guard.sh checks the Azure profile and fails datadog_config and fail2ban_ignoreip on
# this VM (2026-11-03 23:18Z, dispatch://INFRA-993). Any failed check is a FAIL. On a timed box
# check waits for the timing gate, so it is bounded.
# The object is read as legion-reader@, through gcloud-reader --as legion: that account holds
# roles/storage.objectViewer on this one object alone (agent-infra monitoring/gcp_baseline.go,
# gcpProfileReader; theorem-labs/agent-infra#5201), and dev-box@, which the box's agents act as
# after dispatch://INFRA-1433's switch, holds no read on the bucket (census row U47).
GUARD_OBJECT=gs://theorem-agent-infra-monitoring-profile/host/guard.sh
host_guard() {
    local script out rc=0
    script="$(mktemp)"
    if ! out="$(GCLOUD_READER_REASON='sami-devbox-check: the host profile host/guard.sh' \
            "$HOME/.dotfiles/scripts/gcloud-reader" --as legion -- gcloud storage cp "$GUARD_OBJECT" "$script" 2>&1)"; then
        fail "guard: gcloud storage cp $GUARD_OBJECT: $(tail -1 <<<"$out")"
        rm -f "$script"
        return
    fi
    out="$(timeout 900 sudo -n bash "$script" check cloud=gcp profile=full 2>&1)" || rc=$?
    rm -f "$script"
    if (( rc == 0 )) && grep -qx 'guard: 0 failed' <<<"$out"; then
        ok "guard: guard.sh check cloud=gcp profile=full: $(grep -c '^check .*=ok$' <<<"$out") checks ok, 0 failed"
    else
        local failed
        failed="$(grep -E '^check .*=FAIL|^guard: ' <<<"$out" | tr '\n' ';')"
        fail "guard: guard.sh check cloud=gcp profile=full exited $rc: ${failed:-$(tail -1 <<<"$out")}"
    fi
}

# failed_units MANAGER: the units `systemctl MANAGER --failed` lists (MANAGER --user or --system),
# one `<kind> <unit>` per line; on an error, the error, and a non-zero exit. Kind `session` is
# logind's session-*.scope, a login session (an ssh session killed by a client timeout leaves one
# failed). Kind `transient` is a unit made at run time, not installed: systemd-run's (agents'
# tests and probes, many of which fail on purpose: 255 of the 259 failed user units on 2026-11-22)
# and a program's own scope (Chromium asks for app-org.chromium.Chromium-<pid>.scope, which fails
# with result `resources` when the pid has ended or sits in a cgroup the manager may not move it
# from). A unit is transient when Transient=yes or its unit file is in the manager's transient
# directory, where a daemon-reload leaves it with Transient=no. Kind `unit` is any other: one the
# machine was provisioned with. A unit gone between the list and the show is left out.
failed_units() {
    local list rc=0
    list="$(systemctl "$1" --failed --no-legend --plain 2>&1)" || rc=$?
    (( rc == 0 )) || { tr '\n' ';' <<<"$list"; return "$rc"; }
    [[ -n "$list" ]] || return 0
    awk '{ print $1 }' <<<"$list" | xargs -r systemctl "$1" show -p Id -p LoadState -p Transient -p FragmentPath -- 2>/dev/null | awk '
        function emit() {
            if (id != "" && load != "not-found")
                print (id ~ /^session-.*\.scope$/ ? "session" : (t == "yes" || f ~ /\/systemd\/transient\// ? "transient" : "unit")), id
            id = load = t = f = ""
        }
        /^Id=/ { id = substr($0, 4) }
        /^LoadState=/ { load = substr($0, 11) }
        /^Transient=/ { t = substr($0, 11) }
        /^FragmentPath=/ { f = substr($0, 14) }
        /^$/ { emit() }
        END { emit() }'
}

# No unit failing on the machine: neither manager's failed list holds an installed unit, and
# unit-health-watch (scripts/unit-health-watch) holds no open condition in its state file. Failed
# login-session scopes and transient units (failed_units) are notes, not FAILs.
host_units() {
    local got state manager kinds judged transient sessions
    for manager in --user --system; do
        if ! kinds="$(failed_units "$manager")"; then
            fail "units: systemctl $manager --failed: $kinds"
            continue
        fi
        judged="$(awk '$1 == "unit" { print $2 }' <<<"$kinds")"
        transient="$(awk '$1 == "transient" { print $2 }' <<<"$kinds")"
        sessions="$(awk '$1 == "session" { print $2 }' <<<"$kinds")"
        [[ -n "$sessions" ]] && note "units: failed login-session scopes of systemctl $manager (not judged): $(tr '\n' ' ' <<<"$sessions")"
        [[ -n "$transient" ]] && note "units: $(grep -c . <<<"$transient") failed transient units of systemctl $manager (systemd-run's and programs' own scopes; not judged), e.g. $(head -3 <<<"$transient" | tr '\n' ' ')"
        if [[ -z "$judged" ]]; then
            ok "units: systemctl $manager --failed lists no installed unit"
        else
            fail "units: systemctl $manager --failed lists installed units: $(tr '\n' ' ' <<<"$judged")"
        fi
    done
    for state in "/mnt/nvme/$(id -un)/tmp/unit-health-watch/state.json" "${XDG_STATE_HOME:-$HOME/.local/state}/unit-health-watch/state.json"; do
        [[ -s "$state" ]] && break
    done
    if [[ ! -s "$state" ]]; then
        fail "units: unit-health-watch has no state file (has it run? systemctl --user status unit-health-watch.timer)"
    elif got="$(jq -r '(.incidents // {}) | to_entries[] | "\(.key): \(.value.why)"' "$state" 2>&1)" && [[ -z "$got" ]]; then
        ok "units: unit-health-watch has nothing open (state $state, last run $(jq -r '.last_run | todate? // .' "$state"))"
    else
        fail "units: unit-health-watch has open conditions: $(tr '\n' ';' <<<"$got")"
    fi
}

# The apt packages devbox/gce-host.sh adds for lanes (2026-11-03): python3 has pip and venv (the
# N6 farm runs `python3 -m pip install --target`), and the commands of the other packages resolve.
host_packages() {
    local out dir c missing=""
    out="$(python3 -m pip --version 2>&1)" && ok "python3 -m pip --version: $out" || fail "python3 -m pip --version: $(tail -1 <<<"$out")"
    dir="$(mktemp -d)"
    out="$(python3 -m venv "$dir/venv" 2>&1)" && [[ -x "$dir/venv/bin/python" ]] && ok "python3 -m venv: made $dir/venv" || fail "python3 -m venv: $(tail -1 <<<"$out")"
    rm -rf "$dir"
    for c in opam m4 bwrap gdb stress-ng keyctl psql Xvfb qemu-img qemu-system-x86_64; do
        command -v "$c" >/dev/null || missing+=" $c"
    done
    [[ -z "$missing" ]] && ok "lane packages: opam m4 bwrap gdb stress-ng keyctl psql Xvfb qemu-img qemu-system-x86_64 resolve" || fail "lane packages: missing command(s):$missing"
}

# The open-file soft limit of Tailscale SSH and sshd sessions (devbox/nofile.conf). The unit
# property holds once gce-host.sh installed the drop-in; a running daemon has it only when it
# started after the drop-in, and tailscaled restarts only at a planned reset (devbox/sami-devbox.md,
# "Next planned reset"). /proc/<pid>/limits cannot show it: tailscaled and its be-child are Go,
# which raises its own soft limit to the hard one (524287 seen) and gives its children the soft
# limit it started with.
host_nofile() {
    local unit got started installed
    for unit in tailscaled ssh; do
        got="$(systemctl show "$unit.service" -p LimitNOFILESoft --value 2>&1)"
        if [[ "$got" != 65536 ]]; then
            fail "nofile: $unit.service LimitNOFILESoft=$got, want 65536; run sudo devbox/gce-host.sh"
            continue
        fi
        started="$(systemctl show "$unit.service" -p ExecMainStartTimestamp --value --timestamp=unix 2>&1)"
        started="${started#@}"
        installed="$(stat -c %Y "/etc/systemd/system/$unit.service.d/60-nofile.conf" 2>&1)"
        if [[ "$started" =~ ^[0-9]+$ && "$installed" =~ ^[0-9]+$ && "$started" -ge "$installed" ]]; then
            ok "nofile: $unit.service LimitNOFILESoft=65536, and its process started after the drop-in"
        elif [[ "$unit" == tailscaled && "$started" =~ ^[0-9]+$ && "$installed" =~ ^[0-9]+$ ]]; then
            echo "WAIT nofile: tailscaled.service LimitNOFILESoft=65536, but tailscaled started before the drop-in, so its sessions start at its old soft limit until it restarts (devbox/sami-devbox.md, \"Next planned reset\")"
        else
            fail "nofile: $unit.service started @$started, drop-in written @$installed: restart $unit.service (KillMode=process keeps sessions)"
        fi
    done
}

# bwrap makes its network namespace as sami: the AppArmor profile devbox/gce-host.sh installs
# (Ubuntu 24.04 denies unprivileged user namespaces without it) is byte for byte the dotfiles'
# copy, and a bwrap sandbox with its own network namespace and / read-only runs `true`. That
# command line is in the private repository theorem-labs/sami, cloned at .secrets, one line of
# arguments: the public-text leak check refuses bubblewrap options in this public repository.
BWRAP_SMOKE_FILE="$DOTFILES_DIR/.secrets/dotfiles/devbox/bwrap-smoke"
host_bwrap() {
    local want got out rc=0
    local -a args=()
    want="$(sha256sum "$DOTFILES_DIR/devbox/apparmor-bwrap" 2>&1)" && want="${want%% *}"
    got="$(sha256sum /etc/apparmor.d/bwrap 2>&1)" && got="${got%% *}"
    if [[ "$want" =~ ^[0-9a-f]{64}$ && "$got" == "$want" ]]; then
        ok "bwrap AppArmor profile: /etc/apparmor.d/bwrap is devbox/apparmor-bwrap (sha256 ${want:0:12})"
    else
        fail "bwrap AppArmor profile: /etc/apparmor.d/bwrap ($(tail -1 <<<"$got")) is not devbox/apparmor-bwrap ($(tail -1 <<<"$want")); run sudo devbox/gce-host.sh"
    fi
    read -ra args 2>/dev/null <"$BWRAP_SMOKE_FILE"
    (( ${#args[@]} )) || { fail "bwrap sandbox: no command line in $BWRAP_SMOKE_FILE (git -C $DOTFILES_DIR/.secrets pull)"; return; }
    out="$(bwrap "${args[@]}" 2>&1)" || rc=$?
    (( rc == 0 )) && ok "bwrap ${args[*]}: exit 0" || fail "bwrap ${args[*]}: exit $rc: $(tail -1 <<<"$out")"
}

# The public-text leak check: ~/.local/share/public-leak-check holds the tag of agent-infra's
# leak-check/ that devbox/leak-check-tag.env names (sami-devbox-provision's step leakcheck installs
# it), so its launcher, Python module, README and must-pass fixture must have that file's sha256.
leak_check_host_check() {
    local here d out rc=0
    # shellcheck source=leak-check-tag.env
    . "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/leak-check-tag.env"
    here="$(cat "$HOME/.config/public-leak-check/path" 2>&1)"
    [[ -x "$here" ]] || { fail "public-leak-check: the pointer names '$here', which is not an executable file here"; return; }
    d="$(dirname "$here")"
    out="$(cd "$d" && sha256sum -c <<<"$LEAK_CHECK_HOME_SHA256" 2>&1)" || rc=$?
    (( rc == 0 )) && ok "public-leak-check: $d holds $LEAK_CHECK_TAG (${LEAK_CHECK_COMMIT:0:12}): $(tr '\n' ' ' <<<"$out")" \
        || fail "public-leak-check: $d is not $LEAK_CHECK_TAG (sha256sum -c exit $rc): $(grep -v ': OK$' <<<"$out" | tr '\n' ' ')install it: sami-devbox-provision --only leakcheck"
}

# The leak check's pre-push hook: every checkout under ~/src that pushes to a public repository has
# it. Which checkouts are public is decided by the sweep's own code (sweep-hooks.sh up to its loop,
# as sami-devbox-provision's step prepush runs it), with an installer that installs nothing and
# fails, so each checkout without the hook is one FAILED line and nothing on disk changes. A
# checkout the sweep left for a later pass (`DEFERRED <path>`: its per-pass cap on visibility
# lookups, dispatch://BET-706) is not known to have the hook, so it fails the line as well.
prepush_hook_host_check() {
    local d="$HOME/.local/share/public-leak-check-hooks" t out rc=0 summary missing deferred
    # shellcheck source=leak-check-tag.env
    . "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/leak-check-tag.env"
    out="$(cd "$d" && sha256sum --strict -c <<<"$LEAK_CHECK_HOOK_SHA256" 2>&1)" || rc=$?
    (( rc == 0 )) || { fail "pre-push hook: $d is not $LEAK_CHECK_TAG's hook files (sha256sum -c exit $rc): $(tr '\n' ' ' <<<"$out")install them: sami-devbox-provision --only prepush"; return; }
    t="$(mktemp -d)"
    printf '#!/bin/sh\nexit 1\n' > "$t/install-prepush-hook.sh" && chmod +x "$t/install-prepush-hook.sh"
    bash -c "$(sed '/^i=0$/,$d' "$d/sweep-hooks.sh")
        here=$t; log=$t/log; sweep \"\$HOME/src\"" </dev/null >/dev/null 2>&1
    summary="$(grep ' sweep \[' "$t/log" 2>/dev/null | tail -n 1)"
    missing="$(sed -n 's/^[^ ]* FAILED //p' "$t/log" 2>/dev/null | tr '\n' ' ')"
    deferred="$(sed -n 's/^[^ ]* DEFERRED //p' "$t/log" 2>/dev/null | tr '\n' ' ')"
    rm -rf "$t"
    # The summary's `<D> deferred` decides too, should a deferred checkout have no line of its own.
    if [[ -z "$deferred" && "$summary" =~ ,\ ([1-9][0-9]*)\ deferred, ]]; then
        deferred="${BASH_REMATCH[1]} checkout(s) the summary counts "
    fi
    if [[ -n "$summary" && -z "$missing" && -z "$deferred" ]]; then
        ok "pre-push hook: every public checkout under ~/src has it (${summary#* sweep })"
    else
        local nosum=""
        [[ -n "$summary" ]] || nosum=" the sweep pass wrote no summary;"
        fail "pre-push hook:${missing:+ missing in $missing;}${deferred:+ not verified (the sweep deferred their visibility lookups to a later pass) in $deferred;}$nosum install: sami-devbox-provision --only prepush"
    fi
}

# The global hooks dispatcher of dispatch://BET-706 R6, which step prepush installs: global/ holds every
# entry of the tag's global-hooks/ (whose sha256 prepush_hook_host_check compares), executable and byte
# for byte, and nothing else; global.gitconfig, which install-global-hooks.sh writes last, is there; and
# git's global config includes it (.gitconfig's [include]), so git's hooks directory is global/. A
# global.gitconfig over an incomplete global/ is the worst case: git looks for every hook there, so a
# name global/ lacks runs no repository's own hook of that name anywhere.
global_hooks_host_check() {
    local d="$HOME/.local/share/public-leak-check-hooks" f name n=0 wrong="" got
    [[ -f "$d/global.gitconfig" ]] || {
        fail "global hooks: $d/global.gitconfig is missing, so git runs no leak check on a push from a checkout without the pre-push hook; install: sami-devbox-provision --only prepush"
        return
    }
    for f in "$d"/global-hooks/*; do
        [[ -f "$f" ]] || continue
        name="${f##*/}" n=$((n + 1))
        { [[ -x "$d/global/$name" ]] && cmp -s "$f" "$d/global/$name"; } || wrong+="$name "
    done
    ((n > 0)) || {
        fail "global hooks: $d/global-hooks/ has no entries, so whether $d/global/ is complete is unknown; install: sami-devbox-provision --only prepush"
        return
    }
    for f in "$d"/global/*; do
        [[ -e "$f" || -L "$f" ]] || continue
        [[ -f "$d/global-hooks/${f##*/}" ]] || wrong+="${f##*/} (not the tag's) "
    done
    [[ -z "$wrong" ]] || {
        fail "global hooks: $d/global.gitconfig is there but $d/global/ is incomplete or not the tag's: ${wrong}; git runs no repository's own hook of a missing name. Install: sami-devbox-provision --only prepush, or turn it off: $d/install-global-hooks.sh --remove $d"
        return
    }
    got="$(git config --global --includes --type=path --get core.hooksPath 2>/dev/null)" || got=""
    [[ "$got" == "$d/global" ]] || {
        fail "global hooks: installed in $d but not switched on: git's global core.hooksPath is '$got', not $d/global (the [include] in ~/.dotfiles/.gitconfig)"
        return
    }
    ok "global hooks: git runs $d/global/ for every repository without a hooks path of its own ($n entries)"
}

# kubectl as a non-interactive ssh command gets it, through the kubeconfig the ossv-job-farm uses.
# Its smoke failed on 2026-11-03 11:35Z with "Install gke-gcloud-auth-plugin": that PATH has
# ~/.mise/shims but not ~/.local/bin, so installers/gcloud-sdk.sh links the plugin into
# /usr/local/bin. SSH_PATH is `ssh sami@sami-devbox 'echo $PATH'` as read on 2026-11-03, and
# MISE_DATA_DIR is set in that shell too (without it the shim installs a second kubectl). That shell
# also gets GCE_METADATA_HOST, _ROOT and _IP from .bashrc once the host's clients read the metadata
# relay (installers/agent-identity.sh), so each one set here is passed on. The namespace is builds,
# which the box account's team set reads (move census row U07). The list is one request for one
# job (`?limit=1`); the server's remainingItemCount gives the total. It was `get jobs --chunk-size
# 1`, one request per job: over the 1,910 jobs of 2026-11-22 that paging ran for 220 s, outlived
# its continue token and failed with `Error from server (Expired)`, which read as an expired
# credential.
SSH_PATH="$HOME/.cargo/bin:$HOME/.dotfiles/shims:$HOME/.dotfiles/bin:$HOME/.dotfiles/scripts:$HOME/.npm-global/bin:$HOME/.mise/shims:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games:/usr/local/games:/snap/bin"
host_plain_path_kubectl() {
    local out rc=0 name n
    local -a relay=()
    for name in GCE_METADATA_HOST GCE_METADATA_ROOT GCE_METADATA_IP; do
        [[ -n "${!name:-}" ]] && relay+=("$name=${!name}")
    done
    out="$(env -i HOME="$HOME" MISE_DATA_DIR="$HOME/.mise" KUBECONFIG="${KUBECONFIG:-$HOME/.kube/config}" PATH="$SSH_PATH" \
        ${relay[@]+"${relay[@]}"} kubectl --context "$KUBE_CONTEXT" get --raw "/apis/batch/v1/namespaces/builds/jobs?limit=1" 2>&1)" || rc=$?
    n="$(jq -r 'select(.kind == "JobList") | (.items | length) + (.metadata.remainingItemCount // 0)' <<<"$out" 2>/dev/null)"
    (( rc == 0 )) && [[ "$n" =~ ^[0-9]+$ ]] && ok "ssh-PATH kubectl: env -i kubectl get --raw /apis/batch/v1/namespaces/builds/jobs?limit=1: exit 0 ($n jobs)" \
        || fail "ssh-PATH kubectl: env -i kubectl get --raw /apis/batch/v1/namespaces/builds/jobs?limit=1: exit $rc: $(tail -1 <<<"$out" | cut -c1-300)"
}

# The Dispatch CLI by name, as a shell omp did not start finds it (shims/dispatch): on the host with
# the plain ssh command's PATH (SSH_PATH), in a box with the box's own PATH.
dispatch_cli_check() {
    local where="$1" out rc=0
    if [[ "$where" == "on the host" ]]; then
