        || fail "transcript store $where: tq sql 'SELECT count() FROM sessions': ${out:-nothing on stdout}; stderr: $(tail -1 "$err")"
    if grep -q 'warning' "$err"; then note "transcript store $where: $(grep -m1 'warning' "$err")"; fi
