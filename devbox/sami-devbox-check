# --- the host half ---------------------------------------------------------------------------
host_disks() {
    local src fstype
    for spec in "/mnt/nvme google-state" "/mnt/durable google-cold"; do
        read -r mnt dev <<<"$spec"
        src="$(findmnt -n -o SOURCE --target "$mnt" 2>/dev/null)"
        fstype="$(findmnt -n -o FSTYPE --target "$mnt" 2>/dev/null)"
        if [[ "$(findmnt -n -o TARGET --target "$mnt" 2>/dev/null)" == "$mnt" && "$(readlink -f "$src")" == "$(readlink -f "/dev/disk/by-id/$dev")" && "$fstype" == xfs ]]; then
            ok "disk: $mnt is $dev ($src, $fstype)"
        else
            fail "disk: $mnt: want /dev/disk/by-id/$dev xfs, got ${src:-nothing} ${fstype:-}"
        fi
    done
    # /home and the lane trees are the state disk's, bound: same device, same inode.
    local d
    for d in home theorem theorem-ext4 theorem-xfs; do
        if [[ "$(stat -c %d:%i "/$d" 2>/dev/null)" == "$(stat -c %d:%i "/mnt/nvme/$d" 2>/dev/null)" ]]; then
            ok "disk: /$d is /mnt/nvme/$d (bind)"
        else
            fail "disk: /$d is not /mnt/nvme/$d: $(findmnt -n -o SOURCE,FSTYPE "/$d" 2>&1)"
        fi
    done
    src="$(findmnt -n -o SOURCE /mnt/scratch 2>/dev/null)"
    if [[ "$src" == /dev/md* ]]; then
        local md members
        md="$(basename "$(readlink -f "$src")")"
        members="$(find "/sys/block/$md/slaves" -mindepth 1 -maxdepth 1 2>/dev/null | wc -l)"
        ok "disk: /mnt/scratch is $src ($(lsblk -dno SIZE "$src" 2>/dev/null | tr -d ' '), RAID of $members local SSDs)"
    else
        fail "disk: /mnt/scratch: want a RAID md device, got ${src:-nothing}"
    fi
    # /proc/swaps, the table `swapon --show` prints: swapon is in /usr/sbin, which a PATH need not
    # hold (2026-11-22: the tmux server's PATH, which agent sessions inherit, lacked it, and
    # `swapon: command not found` failed this line with both swap files active). Sizes are KiB.
    local swaps
    swaps="$(awk 'NR > 1 && $1 == "/mnt/scratch/swapfile" { print $3 }' /proc/swaps 2>&1)"
    if [[ "$swaps" =~ ^[0-9]+$ ]]; then
        ok "swap: /mnt/scratch/swapfile active ($(numfmt --to=iec --from-unit=1024 "$swaps"), /proc/swaps)"
    else
        fail "swap: /mnt/scratch/swapfile not active: /proc/swaps lists: $(awk 'NR > 1 { printf "%s ", $1 }' /proc/swaps 2>&1)"
    fi
    [[ -d "/mnt/scratch/$(id -un)" && -O "/mnt/scratch/$(id -un)" ]] && ok "scratch: /mnt/scratch/$(id -un) is $(id -un)'s" || fail "scratch: /mnt/scratch/$(id -un) missing or not $(id -un)'s"
    # /tmp and /var/tmp are bound from the scratch only at a boot (devbox/gce-disks, bind_tmp), so
    # until the first planned reset after the change they are still the boot disk's: a WAIT.
    for d in "tmp /tmp" "var-tmp /var/tmp"; do
        read -r src mnt <<<"$d"
        if [[ "$(stat -c %d:%i "$mnt" 2>/dev/null)" == "$(stat -c %d:%i "/mnt/scratch/$src" 2>/dev/null)" ]]; then
            ok "scratch: $mnt is /mnt/scratch/$src (bind)"
        elif ! mountpoint -q "$mnt"; then
            echo "WAIT scratch: $mnt is still the boot disk's; devbox/gce-disks binds it from /mnt/scratch/$src at the next planned reset (devbox/sami-devbox.md, \"/tmp and /var/tmp\")"
        else
            fail "scratch: $mnt is a mount of something other than /mnt/scratch/$src: $(findmnt -n -o SOURCE,FSTYPE "$mnt" 2>&1)"
        fi
    done
}

# The boot disk holds the OS only (dispatch://INFRA-993, "Shape and disks"): sami-rocqperf's root
# filled up, and on 2026-11-03 10 GiB of lane logs landed on sami-devbox's in /theorem. Two tests:
# / uses at most ROOT_MAX_GIB; and no directory on the root filesystem outside the OS's own
# (ROOT_OS_DIRS) holds more than 1 GiB, counted without those directories and without any mount
# below it (`du -x`: /home, /var/lib/docker, /theorem and the other binds are other filesystems,
# and a bind hides what the boot disk holds under it, which only the df test sees). /var/log is
# the OS's while it holds at most VARLOG_MAX_GIB: journald's 2 GiB (devbox/journald-cap.conf),
# rsyslog's text copy of the same records, which devbox/logrotate-rsyslog keeps under about 1 GiB,
# and sysstat's month of samples (205 MiB on 2026-11-22). Until 2026-11-22 the limit was journald's
# 2 GiB alone, which a full journal reaches by itself, while rsyslog rotated weekly with no size
# bound: /var/log held 7.3 GiB, 4.2 GiB of it one week's syslog.1. The directory named is the
# deepest one over the limit, so the line says where the bytes are. du runs with sudo and a time
# bound: it took 0.4 s on 2026-11-03.
ROOT_MAX_GIB=40
ROOT_OS_DIRS=(/usr /var/lib/apt /var/cache/apt /boot /snap /var/lib/snapd /opt /var/log)
ROOT_DU_SECONDS=120
VARLOG_MAX_GIB=4
# stdin: `du -x -B1 -0 /`; argv: the OS's directories. Prints `TOTAL <bytes> <dirs>`, `VARLOG
# <bytes>` and one `BIG <bytes> <path>` per deepest directory over 1 GiB of its own.
ROOT_DU_PY='
import sys
GIB = 1024 ** 3
os_dirs = sys.argv[1:]
sizes = {}
for rec in sys.stdin.buffer.read().split(b"\0"):
    size, tab, path = rec.partition(b"\t")
    if tab:
        sizes[path.decode("utf-8", "surrogateescape")] = int(size)
def under(p, a):
    return p == a or p.startswith(a.rstrip("/") + "/")
present = [a for a in os_dirs if a in sizes]
own = {}
for p, s in sizes.items():
    if any(under(p, a) for a in os_dirs):
        continue
    own[p] = s - sum(sizes[a] for a in present if under(a, p))
big = [p for p, s in own.items() if s > GIB]
deepest = [p for p in big if not any(q != p and under(q, p) for q in big)]
print("TOTAL", sizes.get("/", 0), len(sizes))
print("VARLOG", sizes.get("/var/log", 0))
for p in sorted(deepest, key=lambda p: -own[p]):
    print("BIG", own[p], p)
'
host_rootfs() {
    local used res err rc kind size path total=0 dirs=0 varlog=0 big=() t0=$SECONDS
    used="$(df -B1 --output=used / 2>/dev/null | tail -1 | tr -d ' ')"
    if [[ "$used" =~ ^[0-9]+$ ]] && (( used <= ROOT_MAX_GIB * 1024 ** 3 )); then
        ok "root disk: / uses $(numfmt --to=iec "$used"), at most ${ROOT_MAX_GIB}G"
    else
        fail "root disk: / uses ${used:-?} bytes, over ${ROOT_MAX_GIB}G (df -B1 --output=used /)"
    fi
    err="$(mktemp)"
    # shellcheck disable=SC2024  # the error file is sami's own temp file, on purpose
    res="$(sudo -n timeout "$ROOT_DU_SECONDS" du -x -B1 -0 / 2>"$err" | python3 -c "$ROOT_DU_PY" "${ROOT_OS_DIRS[@]}"; echo "RC ${PIPESTATUS[0]} ${PIPESTATUS[1]}")"
    rc="$(sed -n 's/^RC //p' <<<"$res")"
    if [[ "$rc" == "124 "* ]]; then
        fail "root disk: sudo du -x / did not finish in $ROOT_DU_SECONDS s"
    elif [[ "$rc" == "1 0" ]] && [[ -s "$err" ]] && ! grep -qv ': No such file or directory$' "$err"; then
        note "root disk: du -x /: $(grep -c '' "$err") path(s) went away during the walk, e.g. $(tail -1 "$err")"
        rc="0 0"
    fi
    if [[ "$rc" != "0 0" ]]; then
        fail "root disk: sudo du -x / | python3 exited $rc: $(tail -1 "$err")"
        rm -f "$err"
        return
    fi
    rm -f "$err"
    while read -r kind size path; do
        case "$kind" in
            TOTAL) total="$size" dirs="$path" ;;
            VARLOG) varlog="$size" ;;
            BIG) big+=("$path $(numfmt --to=iec "$size")") ;;
        esac
    done <<<"$res"
    if (( ${#big[@]} )); then
        fail "root disk: outside the OS's directories, over 1G of its own: $(printf '%s; ' "${big[@]}")move it to the state disk (/mnt/nvme) or the scratch (/mnt/scratch)"
    else
        ok "root disk: no directory outside ${ROOT_OS_DIRS[*]} holds over 1G of its own (du -x /: $(numfmt --to=iec "$total") in $dirs directories, $((SECONDS - t0)) s)"
    fi
    if (( varlog <= VARLOG_MAX_GIB * 1024 ** 3 )); then
        ok "root disk: /var/log holds $(numfmt --to=iec "$varlog"), at most ${VARLOG_MAX_GIB}G"
    else
        fail "root disk: /var/log holds $(numfmt --to=iec "$varlog"), over ${VARLOG_MAX_GIB}G (journald's cap devbox/journald-cap.conf, rsyslog's rotation devbox/logrotate-rsyslog); largest: $(sudo -n du -xsh /var/log/* 2>/dev/null | sort -rh | head -3 | tr '\t\n' ' ;')"
    fi
}

# sudo_find ARRAY ARGS...: `sudo -n find ARGS`, appending each path to the array named ARRAY, and
# a FAIL when find (or sudo) exits non-zero, so a walk that failed never reads as one that found
# nothing (find_judge).
sudo_find() {
    local arr="$1" out err rc=0
    shift
    out="$(mktemp)" err="$(mktemp)"
    # shellcheck disable=SC2024  # the output files are sami's own temp files, on purpose
    sudo -n find "$@" >"$out" 2>"$err" || rc=$?
    find_judge "$arr" "sudo -n find $1" "$rc" "$out" "$err"
}

# find_judge ARRAY LABEL RC OUT ERR: append the paths in file OUT to the array named ARRAY, judge
# find's exit status RC and its error file ERR, remove both files, and return the judged status. A
# path that sessions remove while find walks it is not a failure: find then exits 1 and says "No
# such file or directory" for it (A2 of 08:22Z on 2026-11-03 failed on a file a lane deleted under
# /mnt/nvme/sami/wt/SkipRecheck). Only when every error line is that one is the run a pass, with a
# note; any other error, or a non-zero exit with no error line, stays a FAIL.
find_judge() {
    local -n judged="$1"
    local label="$2" rc="$3" out="$4" err="$5"
    mapfile -t -O "${#judged[@]}" judged <"$out"
    if (( rc == 1 )) && [[ -s "$err" ]] && ! grep -qv ': No such file or directory$' "$err"; then
        note "logins: $label: $(grep -c '' "$err") path(s) went away during the walk, e.g. $(tail -1 "$err")"
        rc=0
    fi
    (( rc == 0 )) || fail "logins: $label exited $rc: $(tail -1 "$err")"
    rm -f "$out" "$err"
    return "$rc"
}

# What the login walk does not enter: directories that package managers, build tools, git and the
# container runtime fill with what they install or generate, where gcloud, gh and az never write a
# login (they write in a config directory: ~/.config/gcloud or CLOUDSDK_CONFIG, ~/.config/gh,
# ~/.azure, which the walk still reaches wherever it is). A file in them with a login file's name
# is package data (a test fixture), not a person's login. Docker's, containerd's and Sysbox's data
# directories hold image layers and container filesystems: a login there was copied from a
# directory the walk reads, or pulled with an image. Until 2026-11-22 the walk entered all of them:
# three whole walks of each disk, one for the A2 names, one for credentials.db, one for
# azureProfile.json, and on 2026-11-22, at a load of 2,000 on 288 CPUs, the first walk of
# /mnt/nvme (426 million inodes) alone had run for over 80 minutes when it was stopped.
LOGIN_PRUNE=(-name node_modules -o -name _opam -o -name .lake -o -name _build -o -name site-packages
    -o -name gomodcache -o -name go-build -o -name 'gocache*' -o -path '*/pkg/mod' -o -path '*.git/objects'
    -o -path /mnt/nvme/docker -o -path /mnt/nvme/containerd -o -path /mnt/nvme/sysbox)
LOGIN_MOUNTS=(/ /mnt/nvme /mnt/durable /mnt/scratch)

# login_walks ARRAY EXPR...: one pruned walk of each of LOGIN_MOUNTS for EXPR, the four at once
# (one find per disk), each judged by find_judge; the paths go to the array named ARRAY, and the
# time of each walk to LOGIN_WALK_TIMES. Non-zero when any walk failed.
login_walks() {
    local arr="$1" dir i rc secs t0=$SECONDS walked=0
    local -a pids=()
    shift
    dir="$(mktemp -d)"
    for i in "${!LOGIN_MOUNTS[@]}"; do
        (
            r=0
            # shellcheck disable=SC2024  # the output files are sami's own temp files, on purpose
            sudo -n find "${LOGIN_MOUNTS[i]}" -xdev -type d \( "${LOGIN_PRUNE[@]}" \) -prune -o \( "$@" \) -print \
                >"$dir/$i.out" 2>"$dir/$i.err" || r=$?
            echo "$r $((SECONDS - t0))" >"$dir/$i.rc"
        ) &
        pids+=($!)
    done
    wait "${pids[@]}"
    LOGIN_WALK_TIMES=""
    for i in "${!LOGIN_MOUNTS[@]}"; do
        read -r rc secs <"$dir/$i.rc" || { rc=2 secs=unknown; }
        find_judge "$arr" "the walk of ${LOGIN_MOUNTS[i]}" "$rc" "$dir/$i.out" "$dir/$i.err" || walked=1
        LOGIN_WALK_TIMES+="${LOGIN_MOUNTS[i]} $secs s; "
    done
    rm -rf "$dir"
    return "$walked"
}

# legacy_is_keyless DIR: DIR, a gcloud legacy_credentials directory, holds no person's login and no
# long-lived secret: each adc.json in it is a keyless external_account (type external_account, no
# private_key, no refresh_token), each .boto names only such a file (gs_external_account_file) and
# holds no refresh token or key, and nothing else is there. A user login (authorized_user, a .boto
# with gs_oauth2_refresh_token) and a service account key (service_account, with a private_key)
# both fail: no session here uses a service account key.
legacy_is_keyless() {
    local f t out rc=0
    out="$(sudo -n find "$1" -type f -print 2>&1)" || rc=$?
    (( rc == 0 )) || return 1
    while IFS= read -r f; do
        [[ -n "$f" ]] || continue
        t="$(sudo -n cat "$f" 2>/dev/null)" || return 1
        ! grep -qiE 'refresh_token|private_key|service_key' <<<"$t" || return 1
        case "${f##*/}" in
            adc.json)
                [[ "$(jq -r '.type // empty' <<<"$t" 2>/dev/null)" == external_account ]] || return 1 ;;
            .boto)
                # Its only setting lines name the external account's adc.json.
                ! grep -vE '^[[:space:]]*(\[Credentials\]|gs_external_account_file[[:space:]]*=.*|#.*)?[[:space:]]*$' <<<"$t" | grep -q . || return 1 ;;
            *) return 1 ;;
        esac
    done <<<"$out"
}

# LOGIN_JUDGE_PY: judge, as root, each login file named on stdin (one path a line) by what it holds,
# and print `<verdict>TAB<path>[TAB<accounts>]` a line (a tab, so a path may hold spaces). Verdicts:
#   person   a person's login or a long-lived secret: a JSON credential with a refresh_token or a
#            private_key, a gh hosts.yml with a GitHub token (gho_, ghp_, ghu_, ghs_, ghr_,
#            github_pat_), a credentialed_accounts.db (A2 names it), a gcloud credentials.db with an
#            authorized_user row (its accounts follow);
#   machine  a keyless external_account (an Azure box's identity: no refresh token, no key);
#   empty    no credential at all: a JSON or hosts.yml with neither, a credentials.db with no row or no
#            credentials table. Go tests leave such files behind by the thousand: on 2026-11-22, 7,174
#            application_default_credentials.json holding only {"type": "authorized_user"} in
#            TestCreateSignalHelper temp directories, each a FAIL while the check judged by name;
#   error    a file that could not be read, which says nothing, so it fails the line.
# credentials.db is read with immutable=1: a store gcloud left a journal beside is read as it is,
# with no lock and no write (mode=ro alone answered "attempt to write a readonly database").
LOGIN_JUDGE_PY='
import json, os, re, sqlite3, sys
SECRET = re.compile(r"\"(refresh_token|private_key)\"\s*:\s*\"[^\"]+")
GH_TOKEN = re.compile(r"oauth_token:\s*[\x27\"]?(gh[opusr]_|github_pat_)")
def say(*fields):
    print("\t".join(fields))
for path in (line.rstrip("\n") for line in sys.stdin):
    if not path:
        continue
    name = os.path.basename(path)
    try:
        if name == "credentialed_accounts.db":
            say("person", path)
        elif name == "credentials.db":
            con = sqlite3.connect("file:" + path + "?mode=ro&immutable=1", uri=True)
            try:
                rows = con.execute("select account_id, value from credentials").fetchall()
            except sqlite3.OperationalError as e:
                if "no such table" not in str(e):
                    raise
                rows = []
            users = [a for a, v in rows if json.loads(v).get("type") == "authorized_user"]
            say("person", path, ",".join(users)) if users else say("empty", path)
        else:
            text = open(path, errors="replace").read()
            if name == "hosts.yml":
                say("person" if GH_TOKEN.search(text) else "empty", path)
            elif SECRET.search(text):
                say("person", path)
            else:
                try:
                    kind = json.loads(text).get("type")
                except (ValueError, AttributeError):
                    kind = None
                say("machine" if kind == "external_account" else "empty", path)
    except Exception as e:
        say("error", path, type(e).__name__)
'

# login_paths_line ARRAY: the count of the paths in the array named ARRAY, the directories that hold
# most of them, and the first five, so a line stays readable when there are thousands (run 2 of
# 2026-11-22 printed one line of 1 MB).
login_paths_line() {
    local -n lp="$1"
    printf '%s' "${#lp[@]}, mostly under $(printf '%s\n' "${lp[@]}" | awk -F/ '{ print "/" $2 "/" $3 "/" $4 "/" $5 }' \
        | sort | uniq -c | sort -rn | head -3 | awk '{ printf "%s%s (%s)", (NR > 1 ? ", " : ""), $2, $1 }'); e.g. ${lp[*]:0:5}"
}

# No person's login on any mounted disk: the A2 file names, a gh login, and any gcloud or Azure
# store that holds a user's login. Every local filesystem is walked once (-xdev per mount) for all
# of these names together, past the trees LOGIN_PRUNE names (login_walks), and each walk's time is a
# note. Until 2026-11-22 it was walked three times, once per kind of file, and the second and third
# walks skipped /mnt/scratch.
# A file is judged by what it holds (LOGIN_JUDGE_PY), not by its name: A2 names the files, and gcloud,
# Go tests and moved sessions write files of those names that hold no person's login. A
# legacy_credentials directory is judged by legacy_is_keyless: gcloud writes it for the machine's
# own accounts too, and `agentbox move --to` carries a session's own CLOUDSDK_CONFIG holding
# dev-sjawhar@'s keyless external_account (three on 2026-11-03 05:25-05:39Z). Keyless and empty ones
# are notes; a person's login, a key, and a file that could not be read are FAILs.
host_logins() {
    local -a names=() hits=() files=() person=() machine=() empty=() unread=() profiles=() users=()
    local n f verdict path rest walked=1
    for n in "${LOGIN_FILES[@]}"; do names+=(-name "$n" -o); done
    names+=(-path '*/.config/gh/hosts.yml' -o \( -name credentials.db -path '*gcloud*' \) -o -name azureProfile.json)
    login_walks hits "${names[@]}" || walked=0
    note "logins: walks (one pruned find per disk, the four at once): ${LOGIN_WALK_TIMES%; }"
    for f in "${hits[@]}"; do
        case "${f##*/}" in
            azureProfile.json) profiles+=("$f") ;;
            legacy_credentials) if legacy_is_keyless "$f"; then machine+=("$f"); else person+=("$f"); fi ;;
            *) files+=("$f") ;;
        esac
    done
    while IFS=$'\t' read -r verdict path rest; do
        case "$verdict" in
            person) person+=("$path"); [[ -n "$rest" ]] && users+=("$path: $rest") ;;
            machine) machine+=("$path") ;;
            empty) empty+=("$path") ;;
            *) unread+=("$path${rest:+ ($rest)}") ;;
        esac
    done < <((( ${#files[@]} )) && printf '%s\n' "${files[@]}" | sudo -n python3 -c "$LOGIN_JUDGE_PY" 2>&1)
    (( ${#machine[@]} )) && note "logins: keyless external_account credentials (no person's login, no key): $(login_paths_line machine)"
    (( ${#empty[@]} )) && note "logins: login-named files holding no credential: $(login_paths_line empty)"
    (( ${#unread[@]} )) && fail "logins: login files that could not be read: $(login_paths_line unread)"
    if (( ${#person[@]} )); then
        fail "logins: a person's login or a key in $(login_paths_line person)${users:+; gcloud user rows: ${users[*]:0:3}}"
    elif (( walked && ${#unread[@]} == 0 )); then
        ok "logins: no ${LOGIN_FILES[*]}, gcloud credentials.db or .config/gh/hosts.yml holding a person's login on ${LOGIN_MOUNTS[*]}, past package, build, git-object and container trees"
    fi
    # Azure: a profile whose subscriptions name a user is a person's login.
    local -a found=()
    for f in "${profiles[@]}"; do
        sudo -n cat "$f" 2>/dev/null | jq -e '[.subscriptions[]?.user.type] | any(. == "user")' >/dev/null 2>&1 && found+=("$f")
    done
    if (( ${#found[@]} )); then fail "logins: Azure user login in ${found[*]}"
    elif (( walked )); then ok "logins: no azureProfile.json names a user"; fi
    host_omp_logins
}

