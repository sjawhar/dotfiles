[Unit]
Description=Hold Docker's build cache under 50 GB and remove unusable Docker data when Docker's disk is over 80% used
# INFRA-586 (Disk 5): Docker storage has a size bound. On sami-rocqperf, Docker's data root
# (/var/lib/docker) is on /mnt/nvme, which every lane shares. Its build cache held 61 GB on
# 2026-10-30 and 15.6 GB again at 12:33Z on 2026-10-31, when /mnt/nvme was under its floor and a
# person pruned it by hand. 48 anonymous volumes of removed containers (4.6 GB) had piled up by
# 14:20Z the same day. Nothing removed either.
#
# The 80% threshold and the 50 GB cap are the spec's. /mnt/nvme on sami-rocqperf is always over
# 80%, so there the unit acts every hour; on a box with room it does nothing. BuildKit counts
# only the cache's own bytes against the cap, not the layers it shares with images, so the cap
# binds only on a pile of old records that no image holds.
# Tagged images and containers are never removed: an eval image can take hours to rebuild, and
# Docker's age filter dates an image by when it was built, not by when it was last pulled or used.
ConditionPathExists=/var/run/docker.sock

[Service]
Type=oneshot
Nice=19
IOSchedulingClass=idle
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.dotfiles/devbox/docker-cap
