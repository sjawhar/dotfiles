[Unit]
Description=Hold Docker's build cache under 50 GB and remove unusable Docker data when Docker's disk is over 80% used
# INFRA-586 (Disk 5): Docker storage has a size bound. On sami-rocqperf, Docker's data root
# (/var/lib/docker) is on /mnt/nvme, which every lane shares. Its build cache held 61 GB on
# 2026-10-30 and 15.6 GB again at 12:33Z on 2026-10-31, when /mnt/nvme was under its floor and a
# person pruned it by hand. 48 anonymous volumes of removed containers (4.6 GB) had piled up by
# 14:20Z the same day. Nothing removed either.
#
# The 80% threshold and the 50 GB cap are the spec's. /mnt/nvme on sami-rocqperf is always over
# 80%, so there the unit acts every hour; on a box with room it does nothing.
#
# Age comes first, because BuildKit's --max-used-space alone is a weak cap: without --all it
# counts only the PRIVATE bytes of the cache, so on 2026-11-01 it compared 16.3 GB of 65.1 GB
# against the cap and removed nothing in four hourly runs while the disk stood at 97% used
# (INFRA-586, /mnt/nvme/sami/scratch/eng-ops-sysbox/buildkit/report.md).
# The script removes the records no build has used for 48h, then 24h, 12h and 6h, stopping
# as soon as the cache is under the cap. 6 h is the floor: a lane building now keeps every record
# its build touches, and the records under it, since BuildKit frees a parent only after its
# children. On a box that builds all day those four ages free almost nothing, because most of the
# cache is younger than 6 h: at 13:03Z on 2026-11-02 they freed 0.3 GB of a 147 GB cache that had
# grown 66 GB in that hour. So a last pass asks BuildKit for the cap itself with --all, which
# does remove shared records: 61.3 GB at 13:52Z, then 30.5 GB more at 13:58Z. It stops at the
# records a running build holds, so the line it logs says how much of the rest could still go.
# Tagged images and containers are never removed: an eval image can take hours to rebuild, and
# Docker's age filter dates an image by when it was built, not by when it was last pulled or used.
ConditionPathExists=/var/run/docker.sock

[Service]
Type=oneshot
Nice=19
IOSchedulingClass=idle
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.dotfiles/devbox/docker-cap
