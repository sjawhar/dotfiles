#!/bin/bash
# docker-cap: hold Docker's build cache under a size cap, and remove the Docker data that no
# build or run can ask for again. devbox/docker-cap.service runs it every hour; the unit's
# comment says why each bound is what it is.
#
# It acts only when the filesystem of Docker's data root is more than DOCKER_CAP_HIGH_PCT
# (default 80) per cent used. Then it:
#   - build cache: while the cache is bigger than DOCKER_CAP_BUILD_CACHE (default 50GB), removes
#     every record that no build has used for DOCKER_CAP_CACHE_AGES, each threshold in turn
#     (default 48h 24h 12h 6h). It stops at the first threshold that brings the cache under the
#     cap, and never removes a record used inside the last threshold, so a build running now
#     keeps its cache;
#   - untagged images, while the reclaimable image total is over DOCKER_CAP_IMAGES (default
#     100GB), by the same ladder: each age in DOCKER_CAP_IMAGE_AGES (default 24h 12h 6h 2h) in
#     turn, stopping at the first that brings the total under the cap. With the total already
#     under it, only the 24 h pass runs, as it always did;
#   - anonymous volumes that no container, running or stopped, uses. Docker 23 and later prune
#     only anonymous volumes, so named volumes stay.
# It never removes a tagged image or a container. A tagged image can be an eval image that takes
# hours to rebuild, so its owner decides when it goes.
#
# Why age comes before BuildKit's own --max-used-space cap: without --all, BuildKit compares
# that cap against the sum of the *private* bytes of its records only. A record whose layer
# digest chain also exists in the image store is "shared" and counts zero
# (moby/buildkit v0.26.2 cache/manager.go, prune(): the `if ui.Shared { continue }` in the
# totalSize loop, and pruneOnce()'s `if opt.keepBytes != 0 && opt.totalSize < opt.keepBytes`).
# The same `shared` flag also removes such a record from the candidate list unless --all is
# given. On sami-rocqperf on 2026-11-01 that made the cap a no-op: 65.1 GB of cache, 48.8 GB of
# it shared, so BuildKit compared 16.3 GB against the 50 GB cap and deleted nothing, hour after
# hour, while /mnt/nvme stood at 97% used. A shared record is not free disk: it holds a
# containerd snapshot of its own.
#
# Why the cache can still stand above the cap after a run: BuildKit removes a record only when
# no other record holds it, and a child record holds its parent. `docker builder du` says
# "reclaimable" anyway, because its own count subtracts the holds that children have
# (cache/manager.go, DiskUsage(): the `m[p].refs--` rescan loop) while prune() asks the raw
# `len(cr.refs) == 0`. So a 3-day-old record under a child that a build used an hour ago stays
# until that child ages past the threshold, and the next hourly run takes the pair together.
#
# DOCKER_CAP_BUILD_CACHE is read in Docker's own SI units, as `docker builder du` prints them:
# 50GB is 50,000,000,000 bytes. Docker's --max-used-space flag reads the same string as binary
# (50GB = 53.7e9), so the last pass gives BuildKit a slightly larger cap than the age passes use.
#
# Why images need the ladder and not just the 24 h pass: an image pulled BY DIGEST carries a
# RepoDigest and no tag, so it is untagged and the pass is allowed to take it -- but only once it
# is a day old. On 2026-11-05 a lane pulled twelve images by digest to read each one's engine
# commit and Rocq pin, and by 16:30Z Docker held 388.4 GB of images, 332.2 GB of it reclaimable,
# while /mnt/nvme fell 727.7 GB/h with 1 h 37 min to full. Its build cache was 4 KB. Every age
# pass over the cache freed nothing because there was nothing there, and the single 24 h image
# pass freed 502 bytes because the pulls were hours old. A cap that bounds the thing that was 4 KB
# and not the thing that was 388 GB is a cap in name only.
#
# Why untagged only, still: a tagged image can be an eval image that takes hours to rebuild, and
# an image pulled by digest is re-pullable from the registry it came from. Shortening the age does
# not widen what may go; it only stops a day-long floor from outliving the disk.
#
# DOCKER_CAP_HIGH_PCT, DOCKER_CAP_BUILD_CACHE, DOCKER_CAP_CACHE_AGES, DOCKER_CAP_IMAGES and
# DOCKER_CAP_IMAGE_AGES override the defaults.
set -euo pipefail

# ONE docker-cap at a time. Two ran unlocked against one daemon at 00:1xZ on 2026-11-12 — one
# under box-cleanup's `timeout 30m`, one from somewhere else with no wrapper — and this file's own
# note records what concurrent pruning costs: "a prune racing a lane's pull is how four digest
# pulls died that afternoon." The daemon is shared by every agent box on the machine, so a second
# run is never useful: it contends with the first and makes both slower, which is how a step that
# needs more than its timeout never finishes and never records a success. A non-blocking flock,
# because the caller is a timer step that will run again within the hour: waiting would just hold a
# second slot open for the same work.
# The path must NOT come from the environment: TMPDIR is /mnt/scratch/<user>/tmp in one caller and
# /tmp in another, so an inherited path gives two locks and excludes nothing — which is the exact
# case this exists for. XDG_RUNTIME_DIR is per-user and per-boot, and every caller on this box is
# the same user, so it is the one place both a timer step and a hand-run agree on.
_lock="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/docker-cap.lock"
exec 9>"$_lock"
if ! flock -n 9; then
    echo "docker-cap: another run holds $_lock; this one exits without pruning" >&2
    exit 0
fi

high="${DOCKER_CAP_HIGH_PCT:-80}"
cache_cap="${DOCKER_CAP_BUILD_CACHE:-50GB}"
cache_ages="${DOCKER_CAP_CACHE_AGES:-48h 24h 12h 6h}"
images_cap="${DOCKER_CAP_IMAGES:-100GB}"
image_ages="${DOCKER_CAP_IMAGE_AGES:-24h 12h 6h 2h}"

# A BUDGET THE SCRIPT KEEPS ITSELF, so a long run ends as a success with what it freed rather
# than as a SIGKILL with nothing. Measured 2026-11-12: this job took 3460s (57.7 min) on its
# first completed run, after seven consecutive runs died at box-cleanup's 1800s step timeout
# with `exit 124, reclaimed nothing`. A kill records no success, and docker-cap's hourly gate
# measures from the last SUCCESS, so the step restarted every tick and never finished: the
# budget breaks that loop even when the job outgrows its bound again. 75 min, not 58: a budget
# equal to the last measurement turns the next slightly-worse run straight back into a kill,
# and the figure grows with the backlog. The caller's own timeout stays above it (2h).
budget_seconds="${DOCKER_CAP_BUDGET_SECONDS:-4500}"
_start_epoch="$(date -u +%s)"
over_budget() { (( $(date -u +%s) - _start_epoch >= budget_seconds )); }

# What this run gave back, summed from each prune's own "Total reclaimed space:" line. Docker's
# figure, not the filesystem's: other writers share this disk, so a df difference across an hour
# measures the box and not this script (it fell 36.6 GiB across the successful run above while
# the pass freed 13.6). box-cleanup reads the `reclaimed-bytes:` line below; without it this
# cleaner is counted as unmeasured, which is why the only step that can free hundreds of
# gigabytes was the one whose contribution nobody could see.
reclaimed_total=0
note_reclaimed() {
    local amount
    amount="$(printf '%s' "$1" | sed -n 's/.*Total reclaimed space:[[:space:]]*\([0-9.]*[A-Za-z]*\).*/\1/p')"
    [[ -n "$amount" ]] || return 0
    reclaimed_total=$((reclaimed_total + $(to_bytes "$amount")))
}

# Docker prints sizes in SI units ("65.1GB"), so 1 GB is 1000^3 bytes here.
to_bytes() {
    local size="${1//[[:space:]]/}" num unit mult
    num="${size%%[!0-9.]*}"
    unit="${size#"$num"}"
    case "${unit^^}" in
    "" | B) mult=1 ;;
    KB) mult=1000 ;;
    MB) mult=1000000 ;;
    GB) mult=1000000000 ;;
    TB) mult=1000000000000 ;;
    KIB) mult=1024 ;;
    MIB) mult=1048576 ;;
    GIB) mult=1073741824 ;;
    TIB) mult=1099511627776 ;;
    *)
        echo "docker-cap: cannot read the size '$1'" >&2
        return 1
        ;;
    esac
    awk -v n="$num" -v m="$mult" 'BEGIN { printf "%.0f\n", n * m }'
}

cache_bytes() {
    local total
    total="$(docker builder du | awk -F'\t' '$1 == "Total:" { print $NF }')"
    [[ -n "$total" ]] || return 1
    to_bytes "$total"
}

if ! root="$(docker info --format '{{.DockerRootDir}}' 2>/dev/null)" || [[ -z "$root" ]]; then
    echo "docker-cap: the Docker daemon does not answer; nothing to do"
    exit 0
fi

used_pct() { df --output=pcent "$root" | tail -1 | tr -dc '0-9'; }
free_bytes() { df -B1 --output=avail "$root" | tail -1 | tr -dc '0-9'; }

pct="$(used_pct)"
if ((pct <= high)); then
    echo "docker-cap: $root is ${pct}% used, at or under ${high}%; nothing to do"
    exit 0
fi

before="$(free_bytes)"
echo "docker-cap: $root is ${pct}% used, over ${high}%"

cap_bytes="$(to_bytes "$cache_cap")"
cache="$(cache_bytes)"
for age in $cache_ages; do
    if ((cache <= cap_bytes)); then
        break
    fi
    if over_budget; then
        echo "docker-cap: budget of ${budget_seconds}s reached during the cache passes; stopping here and keeping what was freed"
        break
    fi
    _out="$(docker builder prune --force --all --filter "until=$age" | tail -1)"
    note_reclaimed "$_out"
    echo "build cache is $((cache / 1000000000)) GB, over $cache_cap: records unused for $age: $_out"
    cache="$(cache_bytes)"
done
# A record no build has used inside the shortest age still counts against the cap, and on a box
# that builds all day most of the cache is that young: on 2026-11-02 at 13:03Z the four ages
# together removed 0.3 GB of a 147 GB cache, and the cache had grown 66 GB in the hour. So when
# the ages leave the cache over the cap, ask BuildKit for the cap itself. With --all that pass
# does remove shared records: the same cache went 197.8 GB -> 136.8 GB (61.3 GB freed) at 13:52Z.
# It stops at the records a running build holds, so the cache can stay above the cap; the line
# below says how much of what is left could still go.
if ((cache > cap_bytes)) && ! over_budget; then
    _out="$(docker builder prune --force --all --max-used-space "$cache_cap" | tail -1)"
    note_reclaimed "$_out"
    echo "build cache is $((cache / 1000000000)) GB after the age passes: asking BuildKit for $cache_cap: $_out"
    cache="$(cache_bytes)"
fi
left=""
if ((cache > cap_bytes)); then
    left=", of which $(docker builder du 2> /dev/null | awk '/^Reclaimable:/{print $2}') could still go once its builds end"
fi
echo "build cache is now $((cache / 1000000000)) GB, cap $cache_cap$left"

# `docker system df` prints the Images row as "TOTAL ACTIVE SIZE RECLAIMABLE", the last as
# "332.2GB (85%)"; take the size and drop the share.
images_reclaimable() {
    local r
    r="$(docker system df | awk '$1 == "Images" { print $(NF-1) }')"
    [[ -n "$r" ]] || return 1
    to_bytes "$r"
}

# An image's CreatedAt is when it was BUILT, not when this host pulled it: `docker images` prints
# 2026-02-13 for a pgvector pulled today, and epoch 0 for ubuntu:26.04. So no age floor protects a
# pull in flight -- an image built in April is eligible the second its digest lands, however
# recently the pull began. On 2026-11-05 a lane ran `docker image prune -af` by hand while its own
# audit was pulling by digest, and four of those pulls died with containerd missing-lease and
# missing-extraction-path errors (dispatch://INFRA-6). That was the blunt form, which also takes
# tagged images and which this script never does; but an image pulled BY DIGEST carries no tag, so
# it is untagged from the moment it lands and this script's own pass could race one the same way.
# Hence: no image pass at all while a pull is running.
#
# `docker pull` only, deliberately. `docker run` pulls an image it does not have, so matching it
# looks more careful -- and makes this check useless here: every agent box IS a long-lived
# `docker run`, 74 of them on this host, so the guard would be true forever and nothing would ever
# be pruned. Tested before this line was written. The hole that leaves is a `docker run` pulling
# a missing image, which is seconds to minutes, against the certainty of a cap that never acts.
# A pull issued straight to the daemon's API by some other tool is invisible here too.
pull_in_flight() {
    pgrep -f '^(/[^ ]*/)?docker( .*)? pull( |$)' >/dev/null 2>&1
}
if pull_in_flight; then
    echo "a docker pull is in flight: skipping every image pass this run, since an image pulled by digest is untagged the moment it lands and pruning one mid-pull breaks it"
    _out="$(docker volume prune --force | tail -1)"
    note_reclaimed "$_out"
    echo "unused anonymous volumes: $_out"
    after="$(free_bytes)"
    echo "docker-cap: free space on $root went from $((before / 1000000000)) GB to $((after / 1000000000)) GB; now $(used_pct)% used"
    echo "docker-cap: reclaimed-bytes: $reclaimed_total"
    exit 0
fi
images_cap_bytes="$(to_bytes "$images_cap")"
if over_budget; then
    echo "docker-cap: budget of ${budget_seconds}s reached before the image passes; skipping them and keeping what was freed"
elif ! reclaimable="$(images_reclaimable)"; then
    _out="$(docker image prune --force --filter until=24h | tail -1)"
    note_reclaimed "$_out"
    echo "untagged images: cannot read the reclaimable image total; running the 24 h pass only: $_out"
elif ((reclaimable <= images_cap_bytes)); then
    _out="$(docker image prune --force --filter until=24h | tail -1)"
    note_reclaimed "$_out"
    echo "reclaimable images are $((reclaimable / 1000000000)) GB, at or under $images_cap: untagged images older than 24 h: $_out"
else
    for age in $image_ages; do
        if ((reclaimable <= images_cap_bytes)); then
            break
        fi
        if over_budget; then
            echo "docker-cap: budget of ${budget_seconds}s reached during the image passes; stopping here and keeping what was freed"
            break
        fi
        _out="$(docker image prune --force --filter "until=$age" | tail -1)"
        note_reclaimed "$_out"
        echo "reclaimable images are $((reclaimable / 1000000000)) GB, over $images_cap: untagged images older than $age: $_out"
        reclaimable="$(images_reclaimable)" || break
    done
    # What is left is held by a running container, or is younger than the shortest age. Both are
    # in use by somebody; the next hourly run takes whatever has aged past it since.
    echo "reclaimable images are now $((reclaimable / 1000000000)) GB, cap $images_cap"
fi
_out="$(docker volume prune --force | tail -1)"
note_reclaimed "$_out"
echo "unused anonymous volumes: $_out"
after="$(free_bytes)"
# Other writers share this filesystem, so the change in free space is not only these prunes.
echo "docker-cap: free space on $root went from $((before / 1000000000)) GB to $((after / 1000000000)) GB; now $(used_pct)% used"
# box-cleanup reads this line. Docker's own figure for what these prunes returned, which is a
# different instrument from the df line above: the filesystem moves with every other writer on
# the box, and across the 57.7-minute run of 2026-11-12 it FELL 36.6 GiB while the pass freed
# 13.6. Without this line the step is recorded as unmeasured and its contribution is invisible.
echo "docker-cap: reclaimed-bytes: $reclaimed_total"
