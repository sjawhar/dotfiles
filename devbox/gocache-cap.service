[Unit]
Description=Clean the box's Go build cache (/mnt/nvme/<user>/gocache) when it passes 80 GB
# The Go build cache grew about 4.8 GB an hour on sami-rocqperf on 2026-10-25 (dispatch://INFRA-6),
# and Go trims only entries unused for 5 days, so nothing bounded it. Go has no size-based trim,
# so over the cap this runs a full `go clean -cache`, and each lane's next build is a cold one.
#
# Why 80 GB: the caches every lane used together on 2026-10-25 held about 70 GB (INFRA 62 GB,
# LINUX 8.5 GB), so 80 GB keeps every lane's working set warm, and a clean happens only when
# entries that no lane uses pile up. 80 GB is also small next to the 35 GB free-space floor on
# /mnt/nvme: with 529 GB free on 2026-10-25, a full cache uses 15 % of that space, and a
# cache over the cap is at most one hour's growth (about 5 GB) past it.
ConditionPathIsDirectory=/mnt/nvme/%u/gocache

[Service]
Type=oneshot
Nice=19
IOSchedulingClass=idle
# A user unit's PATH holds neither the dotfiles nor mise's shims, where `go` is.
Environment=PATH=%h/.dotfiles/shims:%h/.dotfiles/bin:%h/.mise/shims:/usr/local/bin:/usr/bin:/bin
Environment=MISE_DATA_DIR=%h/.mise
ExecStart=%h/.dotfiles/devbox/gocache-cap
